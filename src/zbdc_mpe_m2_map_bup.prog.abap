CLASS lcl_recording_events IMPLEMENTATION.
  METHOD on_toolbar.
    DATA ls_btn    TYPE stb_button.

 "0800 toolbar owns onboarding navigation.
 "Existing GUI status buttons remain, while ALV adds:
 " Start Recording / My Import / All Import
 "This mirrors Preview Files 0300: My Uploads / All Uploads.

    DELETE e_object->mt_toolbar WHERE function = 'ZRECSTART'.
    DELETE e_object->mt_toolbar WHERE function = 'ZMYIMP'.
    DELETE e_object->mt_toolbar WHERE function = 'ZALLIMP'.
    DELETE e_object->mt_toolbar WHERE function = 'ZRECIMPORT'.
    DELETE e_object->mt_toolbar WHERE function = 'ZRECMAP'.
    DELETE e_object->mt_toolbar WHERE function = 'ZRECREF'.
    DELETE e_object->mt_toolbar WHERE function = 'ZVISREPL'.

    CLEAR ls_btn.
    ls_btn-function  = 'ZRECSTART'.
    ls_btn-text      = 'Start Recording'.
    ls_btn-quickinfo = 'Record one sample transaction and onboard the captured BDC contract'.
    ls_btn-butn_type = 0.
    APPEND ls_btn TO e_object->mt_toolbar.

    CLEAR ls_btn.
    ls_btn-function  = 'ZMYIMP'.
    ls_btn-text      = 'My Import'.
    ls_btn-quickinfo = 'Select a contract referenced by my Import/Guided evidence without leaving 0800'.
    ls_btn-butn_type = 0.
    APPEND ls_btn TO e_object->mt_toolbar.

    CLEAR ls_btn.
    ls_btn-function  = 'ZALLIMP'.
    ls_btn-text      = 'All Import'.
    ls_btn-quickinfo = 'Select any recent contract referenced by Import/Guided evidence'.
    ls_btn-butn_type = 0.
    APPEND ls_btn TO e_object->mt_toolbar.

    "Import screen analysis is automatic when Mapping Profile is opened.
    "No manual Visual Replay step is exposed to the user. Exact technical
    "PROGRAM/DYNPRO + Screen Painter/DDIC evidence is collected first;
    "OpenAI only names unresolved deterministic candidates afterwards.
  ENDMETHOD.

  METHOD on_user_command.
    CASE e_ucomm.
      WHEN 'ZRECSTART'.
        PERFORM start_guided_recording.
        PERFORM display_script_editor.

      WHEN 'ZMYIMP'.
        PERFORM pick_import_history USING gc_file_scope_my.
        PERFORM display_script_editor.

      WHEN 'ZALLIMP'.
        PERFORM pick_import_history USING gc_file_scope_all.
        PERFORM display_script_editor.

    ENDCASE.
  ENDMETHOD.

ENDCLASS.

