*& LOAD_SCRIPT_DEFINITION - doc script va tach PRE / ITEM / POST
*& Quy uoc:
*& ROW_TYPE = 'I' la item block, duoc lap theo tung item
*& Header truoc item = PRE
*& Header sau item = POST

*& Immutable versioned script contract helpers

FORM contract_hash_from_script
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
           it_script  TYPE ty_t_script
  CHANGING cv_hash    TYPE zbdc_script_bup-contract_hash
           cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_script  TYPE ty_t_script,
        lt_map     TYPE STANDARD TABLE OF zbdc_mapping_bup,
        ls_script  TYPE ty_script_def_compat,
        ls_map     TYPE zbdc_mapping_bup,
        lv_payload TYPE string,
        lv_hash64  TYPE string,
        lv_rule_value_kind TYPE string,
        lv_rule_format_policy TYPE string,
        lv_rule_pad_length TYPE string,
        lv_rule_pad_char TYPE string,
        lv_rule_conv_exit TYPE string,
        lv_rule_push_policy TYPE string.

  CLEAR: cv_hash, cv_ok, cv_message.
  lt_script = it_script.
  SORT lt_script BY step_seq.

  SELECT *
    FROM zbdc_mapping_bup
    INTO TABLE @lt_map
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.
  SORT lt_map BY source_column staging_field bdc_field mandatory.

  lv_payload =
    |TCODE={ iv_tcode };PROFILE={ iv_profile };VERSION={ iv_ver }|.

  LOOP AT lt_script INTO ls_script.
    lv_payload = lv_payload &&
      cl_abap_char_utilities=>newline &&
      |S| && |{ ls_script-step_seq }| && '|' &&
      |{ ls_script-is_new_screen }| && '|' &&
      |{ ls_script-program_name }| && '|' &&
      |{ ls_script-dynpro_no }| && '|' &&
      |{ ls_script-field_name }| && '|' &&
      |{ ls_script-value_type }| && '|' &&
      |{ ls_script-static_value }| && '|' &&
      |{ ls_script-source_column }| && '|' &&
      |{ ls_script-row_type }|.
  ENDLOOP.

  LOOP AT lt_map INTO ls_map.
    lv_payload = lv_payload &&
      cl_abap_char_utilities=>newline &&
      |M| && |{ ls_map-source_column }| && '|' &&
      |{ ls_map-staging_field }| && '|' &&
      |{ ls_map-bdc_field }| && '|' &&
      |{ ls_map-mandatory }|.

 "semantic/format policy is part of the immutable contract when
 "the optional DDIC columns exist. Dynamic readers keep legacy systems
 "compatible while preventing silent contract drift after upgrade.
    CLEAR: lv_rule_value_kind, lv_rule_format_policy,
           lv_rule_pad_length, lv_rule_pad_char,
           lv_rule_conv_exit, lv_rule_push_policy.
    PERFORM get_optional_comp USING ls_map 'VALUE_KIND' CHANGING lv_rule_value_kind.
    IF lv_rule_value_kind IS INITIAL.
      PERFORM get_optional_comp USING ls_map 'SEMANTIC_KIND' CHANGING lv_rule_value_kind.
    ENDIF.
    PERFORM get_optional_comp USING ls_map 'FORMAT_POLICY' CHANGING lv_rule_format_policy.
    IF lv_rule_format_policy IS INITIAL.
      PERFORM get_optional_comp USING ls_map 'FORMAT_KIND' CHANGING lv_rule_format_policy.
    ENDIF.
    PERFORM get_optional_comp USING ls_map 'PAD_LENGTH' CHANGING lv_rule_pad_length.
    IF lv_rule_pad_length IS INITIAL.
      PERFORM get_optional_comp USING ls_map 'TARGET_LENGTH' CHANGING lv_rule_pad_length.
    ENDIF.
    PERFORM get_optional_comp USING ls_map 'PAD_CHAR' CHANGING lv_rule_pad_char.
    PERFORM get_optional_comp USING ls_map 'CONVERSION_EXIT' CHANGING lv_rule_conv_exit.
    IF lv_rule_conv_exit IS INITIAL.
      PERFORM get_optional_comp USING ls_map 'CONV_EXIT' CHANGING lv_rule_conv_exit.
    ENDIF.
    PERFORM get_optional_comp USING ls_map 'PUSH_POLICY' CHANGING lv_rule_push_policy.

    TRANSLATE: lv_rule_value_kind TO UPPER CASE,
               lv_rule_format_policy TO UPPER CASE,
               lv_rule_conv_exit TO UPPER CASE,
               lv_rule_push_policy TO UPPER CASE.
    CONDENSE: lv_rule_value_kind NO-GAPS,
              lv_rule_format_policy NO-GAPS,
              lv_rule_pad_length NO-GAPS,
              lv_rule_pad_char NO-GAPS,
              lv_rule_conv_exit NO-GAPS,
              lv_rule_push_policy NO-GAPS.

    lv_payload = lv_payload && '|' &&
      |VK={ lv_rule_value_kind }| && '|' &&
      |FP={ lv_rule_format_policy }| && '|' &&
      |PL={ lv_rule_pad_length }| && '|' &&
      |PC={ lv_rule_pad_char }| && '|' &&
      |CE={ lv_rule_conv_exit }| && '|' &&
      |PP={ lv_rule_push_policy }|.
  ENDLOOP.

  TRY.
      cl_abap_message_digest=>calculate_hash_for_char(
        EXPORTING
          if_algorithm     = 'SHA-256'
          if_data          = lv_payload
        IMPORTING
          ef_hashb64string = lv_hash64 ).
    CATCH cx_abap_message_digest INTO DATA(lx_digest).
      cv_message = lx_digest->get_text( ).
      RETURN.
  ENDTRY.

  IF lv_hash64 IS INITIAL.
    cv_message = 'SHA-256 contract hash could not be calculated.'.
    RETURN.
  ENDIF.

  cv_hash = lv_hash64.
  cv_ok = abap_true.
ENDFORM.

*& Load one immutable script snapshot by its complete registry identity.
*& This helper is pure with respect to runtime globals and is therefore safe
*& for contract comparison, duplicate detection and audit scans.

FORM load_script_id
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_ver       TYPE zbdc_prof_bup-profile_ver
           iv_script_id TYPE zbdc_script_bup-script_id
  CHANGING ct_script    TYPE ty_t_script
           cv_hash      TYPE zbdc_script_bup-contract_hash
           cv_found     TYPE abap_bool.

  DATA: ls_header TYPE zbdc_script_bup,
        lt_steps  TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        ls_step   TYPE zbdc_sct_ver_bup,
        ls_script TYPE ty_script_def_compat.

  CLEAR: cv_hash, cv_found.
  REFRESH ct_script.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_ver IS INITIAL
     OR iv_script_id IS INITIAL.
    RETURN.
  ENDIF.

  SELECT SINGLE *
    FROM zbdc_script_bup
    INTO @ls_header
    WHERE script_id    = @iv_script_id
      AND tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.
  IF sy-subrc <> 0 OR ls_header-contract_hash IS INITIAL
     OR ls_header-status = 'RESERVED'
     OR ( ls_header-status = 'INACTIVE'
          AND ls_header-recording_name = 'BLOCKED_IMPORT' ).
    RETURN.
  ENDIF.

  SELECT *
    FROM zbdc_sct_ver_bup
    INTO TABLE @lt_steps
    WHERE script_id = @iv_script_id
    ORDER BY step_seq.
  IF lt_steps IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_steps INTO ls_step.
    CLEAR ls_script.
    ls_script-tcode         = iv_tcode.
    ls_script-step_seq      = ls_step-step_seq.
    ls_script-is_new_screen = ls_step-is_new_screen.
    ls_script-field_name    = ls_step-field_name.
    ls_script-value_type    = ls_step-value_type.
    ls_script-static_value  = ls_step-static_value.
    ls_script-source_column = ls_step-source_column.
    ls_script-row_type      = ls_step-row_type.
    ls_script-program_name  = ls_step-program_name.
    ls_script-dynpro_no     = ls_step-dynpro_no.
    APPEND ls_script TO ct_script.
  ENDLOOP.

  cv_hash  = ls_header-contract_hash.
  cv_found = abap_true.
ENDFORM.

*& Resolve one immutable script for an exact TCODE/Profile/Version tuple.
*& No runtime global, acquisition origin, latest version or SELECT SINGLE
*& ordering participates in the decision.

FORM resolve_tuple_script
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_ver       TYPE zbdc_prof_bup-profile_ver
  CHANGING ct_script    TYPE ty_t_script
           cv_script_id TYPE zbdc_script_bup-script_id
           cv_hash      TYPE zbdc_script_bup-contract_hash
           cv_found     TYPE abap_bool
           cv_message   TYPE string.

  DATA: lt_headers TYPE STANDARD TABLE OF zbdc_script_bup,
        ls_header  TYPE zbdc_script_bup,
        lt_certs   TYPE STANDARD TABLE OF zbdc_cert_bup,
        ls_cert    TYPE zbdc_cert_bup,
        lv_loaded  TYPE abap_bool.

  CLEAR: cv_script_id, cv_hash, cv_found, cv_message.
  REFRESH ct_script.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_ver IS INITIAL.
    cv_message = 'Exact TCODE/Profile/Version is required to resolve a script.'.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_script_bup
    INTO TABLE @lt_headers
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.
  DELETE lt_headers WHERE status = 'RESERVED'.
  DELETE lt_headers WHERE status = 'INACTIVE'
                      AND recording_name = 'BLOCKED_IMPORT'.

  IF lt_headers IS INITIAL.
    cv_message = |No executable script header exists for { iv_tcode }/{ iv_profile } v{ iv_ver }.|.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_cert_bup
    INTO TABLE @lt_certs
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver
      AND script_id    <> @space
      AND contract_hash <> @space.
  DELETE lt_certs WHERE cert_status <> 'CERTIFIED'
                    AND cert_status <> 'PENDING_TEST'.
  SORT lt_certs BY script_id contract_hash.
  DELETE ADJACENT DUPLICATES FROM lt_certs COMPARING script_id contract_hash.

 "Import/Guided Mapping must not fail because historical
 "duplicate headers exist for one exact tuple. Resolve deterministically:
 "certified manifest first, otherwise newest executable header. No TCODE,
 "profile name, rule id, or acquisition origin participates in this choice.
  IF lt_certs IS NOT INITIAL.
    SORT lt_certs BY cert_status DESCENDING
                     last_test_status DESCENDING
                     script_id DESCENDING
                     contract_hash DESCENDING.
    LOOP AT lt_certs INTO ls_cert.
      READ TABLE lt_headers INTO ls_header
        WITH KEY script_id     = ls_cert-script_id
                 contract_hash = ls_cert-contract_hash.
      IF sy-subrc = 0.
        EXIT.
      ENDIF.
      CLEAR ls_header.
    ENDLOOP.
    IF ls_header-script_id IS INITIAL.
      cv_message = 'Certification manifest does not match any executable script header.'.
      RETURN.
    ENDIF.
  ELSE.
    SORT lt_headers BY changed_at DESCENDING
                       script_id DESCENDING
                       contract_hash DESCENDING.
    READ TABLE lt_headers INTO ls_header INDEX 1.
  ENDIF.

  PERFORM load_script_id
    USING    iv_tcode iv_profile iv_ver ls_header-script_id
    CHANGING ct_script cv_hash lv_loaded.
  IF lv_loaded <> abap_true OR cv_hash <> ls_header-contract_hash.
    REFRESH ct_script.
    CLEAR cv_hash.
    cv_message = 'Resolved script header has no matching immutable step snapshot.'.
    RETURN.
  ENDIF.

  cv_script_id = ls_header-script_id.
  cv_found = abap_true.
  cv_message = |Resolved exact script { cv_script_id } for { iv_tcode }/{ iv_profile } v{ iv_ver }.|.
ENDFORM.

*& Draft-safe pinned Mapping script resolver
*& Purpose:
*& A newly recorded/imported candidate is already pinned by exact
*& TCODE/Profile/Version/Script ID. Mapping must load that immutable
*& Script ID first instead of resolving the tuple through certification or
*& historical duplicate headers. This is profile-driven and applies to any
*& onboarded TCODE; no table, object field, or transaction branch is encoded.

FORM resolve_map_tuple_script
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_ver       TYPE zbdc_prof_bup-profile_ver
  CHANGING ct_script    TYPE ty_t_script
           cv_script_id TYPE zbdc_script_bup-script_id
           cv_hash      TYPE zbdc_script_bup-contract_hash
           cv_found     TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_loaded TYPE abap_bool,
        lv_status TYPE zbdc_prof_bup-status.

  CLEAR: cv_script_id, cv_hash, cv_found, cv_message.
  REFRESH ct_script.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_ver IS INITIAL.
    cv_message = 'Exact TCODE/Profile/Version is required to resolve Mapping script.'.
    RETURN.
  ENDIF.

  IF gv_runtime_script_id IS NOT INITIAL.
    PERFORM load_script_id
      USING    iv_tcode iv_profile iv_ver gv_runtime_script_id
      CHANGING ct_script cv_hash lv_loaded.

    IF lv_loaded = abap_true AND ct_script IS NOT INITIAL
       AND cv_hash IS NOT INITIAL.
      cv_script_id = gv_runtime_script_id.

      IF gv_runtime_contract_hash IS INITIAL.
        gv_runtime_contract_hash = cv_hash.
      ELSEIF gv_runtime_contract_hash <> cv_hash.
        CLEAR lv_status.
        SELECT SINGLE status
          FROM zbdc_prof_bup
          INTO @lv_status
          WHERE tcode        = @iv_tcode
            AND profile_name = @iv_profile
            AND profile_ver  = @iv_ver.

 "A DRAFT/MAPPED candidate may have been persisted after the screen
 "context was reserved. The exact pinned Script ID is the authority;
 "repin the hash to the stored immutable header instead of comparing it
 "with stale screen state. ACTIVE contracts remain immutable.
        IF lv_status = gc_m2_prof_draft OR lv_status = gc_m2_prof_mapped.
          gv_runtime_contract_hash = cv_hash.
        ELSE.
          cv_message = 'Selected Mapping context conflicts with the pinned immutable contract hash.'.
          REFRESH ct_script.
          CLEAR: cv_script_id, cv_hash.
          RETURN.
        ENDIF.
      ENDIF.

      cv_found = abap_true.
      cv_message = |Resolved pinned Mapping script { cv_script_id } for { iv_tcode }/{ iv_profile } v{ iv_ver }.|.
      RETURN.
    ENDIF.
  ENDIF.

  PERFORM resolve_tuple_script
    USING    iv_tcode iv_profile iv_ver
    CHANGING ct_script cv_script_id cv_hash cv_found cv_message.
ENDFORM.

FORM load_profile_script
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_ver       TYPE zbdc_prof_bup-profile_ver
  CHANGING ct_script    TYPE ty_t_script
           cv_script_id TYPE zbdc_script_bup-script_id
           cv_hash      TYPE zbdc_script_bup-contract_hash
           cv_found     TYPE abap_bool.

  DATA: lt_headers TYPE STANDARD TABLE OF zbdc_script_bup,
        ls_header  TYPE zbdc_script_bup,
        lt_certs   TYPE STANDARD TABLE OF zbdc_cert_bup,
        ls_cert    TYPE zbdc_cert_bup,
        lt_steps   TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        ls_step    TYPE zbdc_sct_ver_bup,
        ls_script  TYPE ty_script_def_compat,
        lv_count   TYPE i.

  CLEAR: cv_script_id, cv_hash, cv_found.
  REFRESH ct_script.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_ver IS INITIAL.
    RETURN.
  ENDIF.

  SELECT *
    FROM zbdc_script_bup
    INTO TABLE @lt_headers
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.

  DELETE lt_headers WHERE status = 'RESERVED'.
  DELETE lt_headers WHERE status = 'INACTIVE'
                      AND recording_name = 'BLOCKED_IMPORT'.

 "An immutable tuple supplied by onboarding/session context has priority.
  IF gv_runtime_script_id IS NOT INITIAL.
    READ TABLE lt_headers INTO ls_header
      WITH KEY script_id = gv_runtime_script_id.
    IF sy-subrc = 0.
      IF gv_runtime_contract_hash IS NOT INITIAL
         AND ls_header-contract_hash <> gv_runtime_contract_hash.
        RETURN.
      ENDIF.
    ELSE.
      CLEAR ls_header.
    ENDIF.
  ENDIF.

 "Otherwise resolve through one unambiguous certification manifest.
  IF ls_header-script_id IS INITIAL.
    SELECT *
      FROM zbdc_cert_bup
      INTO TABLE @lt_certs
      WHERE tcode        = @iv_tcode
        AND profile_name = @iv_profile
        AND profile_ver  = @iv_ver
        AND script_id    <> @space
        AND contract_hash <> @space.

    DELETE lt_certs WHERE cert_status <> 'CERTIFIED'
                      AND cert_status <> 'PENDING_TEST'.

    lv_count = lines( lt_certs ).
    IF lv_count = 1.
      READ TABLE lt_certs INTO ls_cert INDEX 1.
      READ TABLE lt_headers INTO ls_header
        WITH KEY script_id = ls_cert-script_id
                 contract_hash = ls_cert-contract_hash.
      IF sy-subrc <> 0.
        CLEAR ls_header.
      ENDIF.
    ENDIF.
  ENDIF.

 "Draft/mapped contracts without a manifest are valid only when one header
 "exists. Multiple headers are ambiguous and therefore fail closed.
  IF ls_header-script_id IS INITIAL.
    lv_count = lines( lt_headers ).
    IF lv_count <> 1.
      RETURN.
    ENDIF.
    READ TABLE lt_headers INTO ls_header INDEX 1.
  ENDIF.

  IF ls_header-script_id IS INITIAL OR ls_header-contract_hash IS INITIAL.
    RETURN.
  ENDIF.

  SELECT *
    FROM zbdc_sct_ver_bup
    INTO TABLE @lt_steps
    WHERE script_id = @ls_header-script_id
    ORDER BY step_seq.

  IF lt_steps IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_steps INTO ls_step.
    CLEAR ls_script.
    ls_script-tcode         = iv_tcode.
    ls_script-step_seq      = ls_step-step_seq.
    ls_script-is_new_screen = ls_step-is_new_screen.
    ls_script-field_name    = ls_step-field_name.
    ls_script-value_type    = ls_step-value_type.
    ls_script-static_value  = ls_step-static_value.
    ls_script-source_column = ls_step-source_column.
    ls_script-row_type      = ls_step-row_type.
    ls_script-program_name  = ls_step-program_name.
    ls_script-dynpro_no     = ls_step-dynpro_no.
    APPEND ls_script TO ct_script.
  ENDLOOP.

  cv_script_id = ls_header-script_id.
  cv_hash      = ls_header-contract_hash.
  cv_found     = abap_true.
ENDFORM.

FORM persist_profile_script
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_ver       TYPE zbdc_prof_bup-profile_ver
           iv_recording TYPE any
           iv_status    TYPE any
           it_script    TYPE ty_t_script
  CHANGING cv_script_id TYPE zbdc_script_bup-script_id
           cv_hash      TYPE zbdc_script_bup-contract_hash
           cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: ls_header TYPE zbdc_script_bup,
        lt_steps  TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        ls_step   TYPE zbdc_sct_ver_bup,
        ls_script TYPE ty_script_def_compat,
        lv_ts     TYPE timestampl,
        lv_hash_ok TYPE abap_bool,
        lv_hash_msg TYPE string,
        lv_new_header TYPE abap_bool,
        lv_cert_status TYPE zbdc_cert_bup-cert_status,
        lv_snapshot_owned TYPE abap_bool,
        lv_owned_reservation TYPE abap_bool.

  CLEAR: cv_script_id, cv_hash, cv_ok, cv_message.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_ver IS INITIAL.
    cv_message = 'TCODE/Profile/Version is required before saving a script.'.
    RETURN.
  ENDIF.

  IF it_script IS INITIAL.
    cv_message = 'The script has no steps and was not saved.'.
    RETURN.
  ENDIF.

 "a certified exact version is immutable for every user/session.
  SELECT SINGLE cert_status
    FROM zbdc_cert_bup
    INTO @lv_cert_status
    WHERE tcode            = @iv_tcode
      AND profile_name     = @iv_profile
      AND profile_ver      = @iv_ver
      AND cert_status      = 'CERTIFIED'
      AND last_test_status = 'CERTIFIED'.
  IF sy-subrc = 0.
    cv_message = |Certified contract { iv_profile } v{ iv_ver } is immutable. Reuse it as evidence or create a new candidate version.|.
    RETURN.
  ENDIF.

 "Calculate the incoming contract before touching an existing exact version.
 "This prevents two users from silently overwriting the same version with
 "different contracts. Same-user DRAFT/MAPPED edits remain allowed.
  PERFORM contract_hash_from_script
    USING    iv_tcode iv_profile iv_ver it_script
    CHANGING cv_hash lv_hash_ok lv_hash_msg.
  IF lv_hash_ok <> abap_true.
    cv_message = lv_hash_msg.
    RETURN.
  ENDIF.

  SELECT SINGLE *
    FROM zbdc_script_bup
    INTO @ls_header
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.

  GET TIME STAMP FIELD lv_ts.

  CLEAR lv_owned_reservation.
  IF sy-subrc = 0 AND ls_header-status = 'RESERVED'
     AND ls_header-script_id = gv_z133_reservation_id.
    lv_owned_reservation = abap_true.
  ENDIF.

  IF sy-subrc = 0 AND ls_header-status = 'RESERVED'
     AND lv_owned_reservation <> abap_true.
    cv_message = |Candidate { iv_profile } v{ iv_ver } is reserved by another onboarding attempt; no data was overwritten.|.
    RETURN.
  ENDIF.

  CLEAR lv_snapshot_owned.
  IF ls_header-script_id = gv_z133_loaded_script_id
     AND ls_header-contract_hash = gv_z133_loaded_hash.
    lv_snapshot_owned = abap_true.
  ENDIF.

  IF sy-subrc = 0 AND ls_header-script_id IS NOT INITIAL
     AND ls_header-contract_hash IS NOT INITIAL
     AND ls_header-contract_hash <> cv_hash
     AND lv_snapshot_owned <> abap_true
     AND lv_owned_reservation <> abap_true.
    cv_message =
      |Version collision: { iv_tcode } / { iv_profile } v{ iv_ver } changed after this session loaded it. Refresh first; no evidence was overwritten.|.
    RETURN.
  ENDIF.

  IF sy-subrc <> 0 OR ls_header-script_id IS INITIAL.
    lv_new_header = abap_true.
    CLEAR ls_header.
    TRY.
        ls_header-script_id =
          cl_system_uuid=>create_uuid_c32_static( ).
      CATCH cx_uuid_error INTO DATA(lx_uuid).
        cv_message = lx_uuid->get_text( ).
        RETURN.
    ENDTRY.
    ls_header-created_by = sy-uname.
    ls_header-created_at = lv_ts.
  ENDIF.

  ls_header-tcode          = iv_tcode.
  ls_header-profile_name   = iv_profile.
  ls_header-profile_ver    = iv_ver.
  ls_header-recording_name = iv_recording.
  ls_header-status         = iv_status.
  ls_header-changed_by     = sy-uname.
  ls_header-changed_at     = lv_ts.

  IF lv_new_header = abap_true.
    INSERT zbdc_script_bup FROM @ls_header.
    IF sy-subrc <> 0.
      ROLLBACK WORK.
      cv_message = |Import/version lock: { iv_tcode } / { iv_profile } v{ iv_ver } was reserved by another user. Refresh and import again; no evidence was overwritten.|.
      RETURN.
    ENDIF.
  ELSE.
    MODIFY zbdc_script_bup FROM @ls_header.
    IF sy-subrc <> 0.
      ROLLBACK WORK.
      cv_message = |Script header could not be saved; SY-SUBRC={ sy-subrc }.|.
      RETURN.
    ENDIF.
  ENDIF.

  LOOP AT it_script INTO ls_script.
    CLEAR ls_step.
    ls_step-script_id     = ls_header-script_id.
    ls_step-step_seq      = ls_script-step_seq.
    ls_step-is_new_screen = ls_script-is_new_screen.
    ls_step-field_name    = ls_script-field_name.
    ls_step-value_type    = ls_script-value_type.
    ls_step-static_value  = ls_script-static_value.
    ls_step-source_column = ls_script-source_column.
    ls_step-row_type      = ls_script-row_type.
    ls_step-program_name  = ls_script-program_name.
    ls_step-dynpro_no     = ls_script-dynpro_no.
    APPEND ls_step TO lt_steps.
  ENDLOOP.

  DELETE FROM zbdc_sct_ver_bup
    WHERE script_id = @ls_header-script_id.

  INSERT zbdc_sct_ver_bup FROM TABLE @lt_steps.
  IF sy-subrc <> 0.
    ROLLBACK WORK.
    cv_message =
      |Versioned script steps could not be saved; SY-SUBRC={ sy-subrc }.|.
    RETURN.
  ENDIF.

  UPDATE zbdc_script_bup
    SET contract_hash = @cv_hash,
        status        = @iv_status,
        changed_by    = @sy-uname,
        changed_at    = @lv_ts
    WHERE script_id = @ls_header-script_id.

  IF sy-subrc <> 0.
    ROLLBACK WORK.
    cv_message = 'Contract hash could not be stored in Script Header.'.
    RETURN.
  ENDIF.

 "Any script/mapping change invalidates the previous certification.
  DELETE FROM zbdc_cert_bup
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.

  cv_script_id = ls_header-script_id.
  gv_z133_loaded_script_id = ls_header-script_id.
  gv_z133_loaded_hash      = cv_hash.
  gv_z133_loaded_changed_at = lv_ts.
  cv_ok = abap_true.
ENDFORM.

*& Generic Object Proof Contract gate for onboarding/profile
*& Purpose:
*& Start Recording and SHDB Import remain valid DRAFT creation steps.
*& A profile may move from MAPPED to TESTING only after a TCODE-independent
*& object-proof contract exists for the immutable contract hash and the
*& executable script contains the hidden trace token. Runtime still reads
*& the same contract generically for CT and BISM; no business TCODE, table
*& or object field is hardcoded here.

*& Repair non-certified frozen Mapping -> Script projection

*& Purpose:
*& A published S1 profile can have the correct Mapping schema while older
*& frozen Script Steps still classify one or more mapped business fields as
*& STATIC/IGNORE. In that state CALL TRANSACTION reaches the later dynpro,
*& but the uploaded value is never emitted because the exact Script row is
*& not DYNAMIC.

*& Rules:
*& No TCODE, dynpro, field, table or business-name hardcode.
*& Mapping is authoritative only for fields already present in the exact
*& persisted Script. Missing Script evidence is never invented.
*& CERTIFIED contracts remain immutable and fail closed.
*& TESTING/non-certified tuples may be repaired in place, their exact hash
*& is changed, and PENDING_TEST proof is reset. The caller must re-upload
*& so staging pins the new hash before CALL TRANSACTION can continue.

FORM repair_map_projection
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_ver       TYPE zbdc_prof_bup-profile_ver
           iv_script_id TYPE zbdc_script_bup-script_id
  CHANGING ct_script    TYPE ty_t_script
           cv_hash      TYPE zbdc_script_bup-contract_hash
           cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lt_map          TYPE ty_t_map,
        lt_before       TYPE ty_t_script,
        lv_valid        TYPE abap_bool,
        lv_valid_msg    TYPE string,
        lv_hash_new     TYPE zbdc_script_bup-contract_hash,
        lv_hash_ok      TYPE abap_bool,
        lv_hash_msg     TYPE string,
        lv_cert         TYPE zbdc_cert_bup-cert_status,
        lv_prof_status  TYPE zbdc_prof_bup-status,
        lv_ts           TYPE zbdc_script_bup-changed_at,
        lt_steps        TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        ls_step         TYPE zbdc_sct_ver_bup,
        ls_script       TYPE ty_script_def_compat,
        ls_pending      TYPE zbdc_cert_bup.

  CLEAR: cv_ok, cv_message.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_ver IS INITIAL
     OR iv_script_id IS INITIAL OR ct_script IS INITIAL.
    cv_message =
      'Mapping projection repair requires an exact TCODE/Profile/Version/Script tuple.'.
    RETURN.
  ENDIF.

  REFRESH lt_map.
  PERFORM load_mapping_profile_ctx
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_map.
  IF lt_map IS INITIAL.
    cv_message = 'Mapping projection repair found no exact Mapping rows.'.
    RETURN.
  ENDIF.

  lt_before[] = ct_script[].

 "Re-project only exact Mapping bindings onto rows that already exist in the
 "persisted Script. Z336 never creates a new dynpro/field row.
  PERFORM apply_map_to_script
    USING    lt_map
    CHANGING ct_script.
  PERFORM canon_item_prototypes CHANGING ct_script.
  PERFORM classify_script_item_block CHANGING ct_script.

  CLEAR: lv_valid, lv_valid_msg.
  PERFORM validate_map_script_1to1
    USING    lt_map ct_script
    CHANGING lv_valid lv_valid_msg.
  IF lv_valid <> abap_true.
    ct_script[] = lt_before[].
    cv_message = lv_valid_msg.
    IF cv_message IS INITIAL.
      cv_message =
        'Mapping projection repair could not prove exact Mapping-to-Script binding.'.
    ENDIF.
    RETURN.
  ENDIF.

  CLEAR: lv_hash_new, lv_hash_ok, lv_hash_msg.
  PERFORM contract_hash_from_script
    USING    iv_tcode iv_profile iv_ver ct_script
    CHANGING lv_hash_new lv_hash_ok lv_hash_msg.
  IF lv_hash_ok <> abap_true OR lv_hash_new IS INITIAL.
    ct_script[] = lt_before[].
    cv_message = lv_hash_msg.
    IF cv_message IS INITIAL.
      cv_message = 'Mapping projection repair could not calculate the exact contract hash.'.
    ENDIF.
    RETURN.
  ENDIF.

 "Nothing to repair: current frozen Script already matches Mapping exactly.
  IF cv_hash = lv_hash_new.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

 "Never rewrite an actually certified tuple.
  CLEAR lv_cert.
  SELECT SINGLE cert_status
    FROM zbdc_cert_bup
    INTO @lv_cert
    WHERE tcode            = @iv_tcode
      AND profile_name     = @iv_profile
      AND profile_ver      = @iv_ver
      AND cert_status      = 'CERTIFIED'
      AND last_test_status = 'CERTIFIED'.
  IF sy-subrc = 0.
    ct_script[] = lt_before[].
    cv_message =
      |Certified contract { iv_profile } v{ iv_ver } has stale Mapping projection and is immutable. Create a new candidate version.|.
    RETURN.
  ENDIF.

  CLEAR: lv_prof_status, ls_pending.
  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_prof_status
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.

  SELECT SINGLE *
    FROM zbdc_cert_bup
    INTO @ls_pending
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver
      AND cert_status  = 'PENDING_TEST'.

  REFRESH lt_steps.
  LOOP AT ct_script INTO ls_script.
    CLEAR ls_step.
    ls_step-script_id     = iv_script_id.
    ls_step-step_seq      = ls_script-step_seq.
    ls_step-is_new_screen = ls_script-is_new_screen.
    ls_step-field_name    = ls_script-field_name.
    ls_step-value_type    = ls_script-value_type.
    ls_step-static_value  = ls_script-static_value.
    ls_step-source_column = ls_script-source_column.
    ls_step-row_type      = ls_script-row_type.
    ls_step-program_name  = ls_script-program_name.
    ls_step-dynpro_no     = ls_script-dynpro_no.
    APPEND ls_step TO lt_steps.
  ENDLOOP.

  GET TIME STAMP FIELD lv_ts.

  DELETE FROM zbdc_sct_ver_bup
    WHERE script_id = @iv_script_id.
  INSERT zbdc_sct_ver_bup FROM TABLE @lt_steps.
  IF sy-subrc <> 0.
    ROLLBACK WORK.
    ct_script[] = lt_before[].
    cv_message = 'Mapping projection repair could not rewrite exact Script Steps.'.
    RETURN.
  ENDIF.

  IF cv_hash IS INITIAL.
    UPDATE zbdc_script_bup
      SET contract_hash = @lv_hash_new,
          changed_by    = @sy-uname,
          changed_at    = @lv_ts
      WHERE script_id   = @iv_script_id
        AND tcode        = @iv_tcode
        AND profile_name = @iv_profile
        AND profile_ver  = @iv_ver.
  ELSE.
    UPDATE zbdc_script_bup
      SET contract_hash = @lv_hash_new,
          changed_by    = @sy-uname,
          changed_at    = @lv_ts
      WHERE script_id     = @iv_script_id
        AND tcode          = @iv_tcode
        AND profile_name   = @iv_profile
        AND profile_ver    = @iv_ver
        AND contract_hash  = @cv_hash.
  ENDIF.

  IF sy-subrc <> 0.
    ROLLBACK WORK.
    ct_script[] = lt_before[].
    cv_message =
      'Mapping projection repair detected a concurrent Script change. Refresh and retry; nothing was overwritten.'.
    RETURN.
  ENDIF.

 "The exact executable hash changed, therefore old live-certification proof
 "cannot survive. Preserve only neutral setup fields from the pending row.
  DELETE FROM zbdc_cert_bup
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.

  IF lv_prof_status = 'TESTING'.
    IF ls_pending-script_id IS INITIAL.
      CLEAR ls_pending.
      ls_pending-tcode        = iv_tcode.
      ls_pending-profile_name = iv_profile.
      ls_pending-profile_ver  = iv_ver.
    ENDIF.
    ls_pending-script_id         = iv_script_id.
    ls_pending-contract_hash     = lv_hash_new.
    ls_pending-cert_status       = 'PENDING_TEST'.
    ls_pending-last_test_status  = 'PENDING_TEST'.
    ls_pending-last_test_message =
      'Exact Mapping-to-Script projection was repaired; live CT certification must run again.'.
    CLEAR: ls_pending-success_msgid, ls_pending-success_msgnr,
           ls_pending-object_msgv, ls_pending-cap_call_n,
           ls_pending-cap_call_a, ls_pending-cap_update_a,
           ls_pending-cap_sm35.
    ls_pending-cap_call_e   = 'X'.
    ls_pending-cap_update_s = 'X'.
    ls_pending-certified_by = sy-uname.
    ls_pending-certified_at = lv_ts.
    MODIFY zbdc_cert_bup FROM @ls_pending.
    IF sy-subrc <> 0.
      ROLLBACK WORK.
      ct_script[] = lt_before[].
      cv_message =
        'Mapping projection repair could not recreate the PENDING_TEST manifest.'.
      RETURN.
    ENDIF.
  ENDIF.

  COMMIT WORK AND WAIT.

  cv_hash = lv_hash_new.
 "Do not change GV_RUNTIME_CONTRACT_HASH here. The current ingestion session
 "must remain pinned to its old hash and be rejected by the caller so the
 "same template is uploaded once again under the repaired exact hash.
  IF gv_z133_loaded_script_id = iv_script_id.
    gv_z133_loaded_hash       = lv_hash_new.
    gv_z133_loaded_changed_at = lv_ts.
  ENDIF.

  cv_ok = abap_true.
  cv_message =
    'Exact Mapping-to-Script projection repaired without inventing any BDC field; re-upload the same template once to pin the new hash.'.
ENDFORM.

FORM prepare_test_contract
  USING    iv_tcode TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver TYPE zbdc_prof_bup-profile_ver
  CHANGING cv_ok TYPE abap_bool cv_message TYPE string.
  DATA: lt_script TYPE ty_t_script,
        lv_script_id TYPE zbdc_script_bup-script_id,
        lv_header_hash TYPE zbdc_script_bup-contract_hash,
        lv_calc_hash TYPE zbdc_script_bup-contract_hash,
        lv_found TYPE abap_bool,
        lv_hash_ok TYPE abap_bool,
        lv_hash_msg TYPE string,
        lv_ready TYPE abap_bool,
        lv_unresolved TYPE i,
        lv_ready_msg TYPE string,
        lv_semantic_ok TYPE abap_bool,
        lv_semantic_msg TYPE string,
        lv_proof_ok TYPE abap_bool,
        lv_proof_msg TYPE string,
        ls_cert TYPE zbdc_cert_bup,
        lv_ts TYPE timestampl,
        lv_certmode_ok TYPE abap_bool,
        lv_certmode_msg TYPE string,
        lv_z516_ok TYPE abap_bool,
        lv_z516_msg TYPE string,
        lv_z585_ctu_cfg TYPE zbdc_config_bup-config_value,
        lv_z585_ctu_ok TYPE abap_bool,
        lv_z585_ctu_msg TYPE string,
        lv_z586_bin_cfg TYPE zbdc_config_bup-config_value,
        lv_z586_bin_ok TYPE abap_bool,
        lv_z586_bin_msg TYPE string.
  CLEAR: cv_ok, cv_message.
  PERFORM load_profile_script USING iv_tcode iv_profile iv_ver
    CHANGING lt_script lv_script_id lv_header_hash lv_found.
  IF lv_found <> abap_true. cv_message = 'Versioned Script Header/Steps are missing.'. RETURN. ENDIF.
  DATA: lv_z367_ok TYPE abap_bool, lv_z367_msg TYPE string.
  PERFORM repair_tech_contract
    USING    iv_tcode iv_profile iv_ver lv_script_id
    CHANGING lt_script lv_header_hash lv_z367_ok lv_z367_msg.
  IF lv_z367_ok <> abap_true. cv_message = lv_z367_msg. RETURN. ENDIF.

 "before a MAPPED tuple becomes TESTING, make the frozen Script
 "projection agree with its exact Mapping. This is still pre-execution, so a
 "changed hash can continue directly into a freshly written PENDING_TEST
 "manifest; no staging session exists yet and no re-upload is required here.
  CLEAR: lv_z516_ok, lv_z516_msg.
  PERFORM repair_map_projection
    USING    iv_tcode iv_profile iv_ver lv_script_id
    CHANGING lt_script lv_header_hash lv_z516_ok lv_z516_msg.
  IF lv_z516_ok <> abap_true. cv_message = lv_z516_msg. RETURN. ENDIF.

  PERFORM check_contract USING lt_script CHANGING lv_ready lv_unresolved lv_ready_msg.
  IF lv_ready <> abap_true. cv_message = lv_ready_msg. RETURN. ENDIF.
  PERFORM semantic_contract_gate USING lt_script CHANGING lv_semantic_ok lv_semantic_msg.
  IF lv_semantic_ok <> abap_true. cv_message = lv_semantic_msg. RETURN. ENDIF.
  PERFORM contract_hash_from_script USING iv_tcode iv_profile iv_ver lt_script
    CHANGING lv_calc_hash lv_hash_ok lv_hash_msg.
  IF lv_hash_ok <> abap_true. cv_message = lv_hash_msg. RETURN. ENDIF.
  IF lv_header_hash IS INITIAL OR lv_header_hash <> lv_calc_hash.
    cv_message = 'Script Header hash does not match Script Steps + Mapping.'. RETURN.
  ENDIF.

 "CTU semantics are part of onboarding, never runtime discovery.
 "SAP SHDB/BDC_RECORD_TRANSACTION standard replay uses normal batch-input
 "SY-BINPT semantics unless NOBINPT was explicitly captured. Our acquisition
 "path never sets NOBINPT, so a missing/AUTO contract freezes BATCH, not ONLINE.
 "An explicit historical ONLINE value remains accepted for non-SAP_APQI data.
  CLEAR: lv_z585_ctu_cfg, lv_z585_ctu_ok, lv_z585_ctu_msg.
  PERFORM get_script_cfg
    USING    lv_script_id 'CTURACOM'
    CHANGING lv_z585_ctu_cfg.
  TRANSLATE lv_z585_ctu_cfg TO UPPER CASE.
  CONDENSE lv_z585_ctu_cfg NO-GAPS.
  IF lv_z585_ctu_cfg IS INITIAL.
    PERFORM set_script_cfg
      USING    lv_script_id 'CTURACOM' 'TERMINATE'
      CHANGING lv_z585_ctu_ok lv_z585_ctu_msg.
    IF lv_z585_ctu_ok <> abap_true.
      cv_message = lv_z585_ctu_msg.
      RETURN.
    ENDIF.
  ELSEIF lv_z585_ctu_cfg <> 'CONTINUE' AND
         lv_z585_ctu_cfg <> 'TERMINATE'.
    cv_message = |Unsupported CTURACOM contract value { lv_z585_ctu_cfg }. Re-prepare the profile before SAP replay.|.
    RETURN.
  ENDIF.

  CLEAR: lv_z586_bin_cfg, lv_z586_bin_ok, lv_z586_bin_msg.
  PERFORM get_script_cfg
    USING    lv_script_id 'CTUNOBIN'
    CHANGING lv_z586_bin_cfg.
  TRANSLATE lv_z586_bin_cfg TO UPPER CASE.
  CONDENSE lv_z586_bin_cfg NO-GAPS.
  IF lv_z586_bin_cfg IS INITIAL OR lv_z586_bin_cfg = 'AUTO'.
    PERFORM set_script_cfg
      USING    lv_script_id 'CTUNOBIN' 'BATCH'
      CHANGING lv_z586_bin_ok lv_z586_bin_msg.
    IF lv_z586_bin_ok <> abap_true.
      cv_message = lv_z586_bin_msg.
      RETURN.
    ENDIF.
    lv_z586_bin_cfg = 'BATCH'.
  ELSEIF lv_z586_bin_cfg <> 'ONLINE' AND
         lv_z586_bin_cfg <> 'BATCH'.
    cv_message = |Unsupported CTUNOBIN contract value { lv_z586_bin_cfg }. Re-prepare the profile before SAP replay.|.
    RETURN.
  ENDIF.

 "SAP Object proof is not part of profile preparation.
  lv_proof_ok = abap_true.
  CLEAR lv_proof_msg.

  SELECT SINGLE * FROM zbdc_cert_bup INTO @ls_cert
    WHERE tcode = @iv_tcode AND profile_name = @iv_profile AND profile_ver = @iv_ver.
  IF sy-subrc <> 0 OR ls_cert-script_id <> lv_script_id OR ls_cert-contract_hash <> lv_calc_hash.
    CLEAR ls_cert.
    ls_cert-tcode = iv_tcode. ls_cert-profile_name = iv_profile. ls_cert-profile_ver = iv_ver.
    ls_cert-script_id = lv_script_id. ls_cert-contract_hash = lv_calc_hash.
 "ARCH_RESET: an exact candidate contract never inherits Object/Review
 "metadata from another version. Certification must prove its own verifier,
 "complete key schema and review route from this exact frozen script/hash.
    CLEAR: ls_cert-verify_table, ls_cert-verify_field,
           ls_cert-display_tcode, ls_cert-param_id.
  ENDIF.
  ls_cert-cert_status = 'PENDING_TEST'.
  CLEAR: ls_cert-success_msgid, ls_cert-success_msgnr, ls_cert-object_msgv,
         ls_cert-cap_call_n, ls_cert-cap_call_a, ls_cert-cap_update_a, ls_cert-cap_sm35.
  ls_cert-cap_call_e = 'X'. ls_cert-cap_update_s = 'X'.
  GET TIME STAMP FIELD lv_ts.
  ls_cert-certified_by = sy-uname. ls_cert-certified_at = lv_ts.
  ls_cert-last_test_status = 'PENDING_TEST'.
  ls_cert-last_test_message = 'Profile setup is complete; direct replay must pass the exact executable contract and SAP terminal protocol.' .
  MODIFY zbdc_cert_bup FROM @ls_cert.
  IF sy-subrc <> 0. cv_message = 'Pending live-certification contract could not be saved.'. RETURN. ENDIF.

 "/ SAP CALL TRANSACTION rule:
 "PENDING_TEST is a legacy database status name only. CALL TRANSACTION has no
 "generic rollback/test mode when the called transaction commits. Therefore
 "this first replay is explicitly marked LIVE_CT and may create a real object.
  CLEAR: lv_certmode_ok, lv_certmode_msg.
  PERFORM set_script_cfg
    USING    lv_script_id 'CERTMODE' 'LIVE_CT'
    CHANGING lv_certmode_ok lv_certmode_msg.
  IF lv_certmode_ok <> abap_true.
    cv_message = lv_certmode_msg.
    RETURN.
  ENDIF.

  UPDATE zbdc_script_bup SET status = 'TEST_READY', changed_by = @sy-uname, changed_at = @lv_ts
    WHERE script_id = @lv_script_id.
  IF sy-subrc <> 0. cv_message = 'Script could not be moved to TEST_READY.'. RETURN. ENDIF.
  cv_ok = abap_true.
  cv_message = |Live CT certification { lv_script_id } prepared; CALL TRANSACTION may commit. ACTIVE requires the exact executable contract and terminal SAP protocol. This is not a rollback/dry-run mode.|.
ENDFORM.

"Compatibility entry point retained for callers from older includes.
"Semantics are fail-closed: configuration approval prepares PENDING_TEST,
"never a fake CERTIFIED profile.

FORM load_script_definition
  USING    pv_tcode TYPE sy-tcode
  CHANGING ct_pre   TYPE ty_t_script
           ct_item  TYPE ty_t_script
           ct_post  TYPE ty_t_script.

  DATA: lt_script TYPE ty_t_script,
        ls_scr    TYPE ty_script_def_compat,
        lv_profile TYPE zbdc_prof_bup-profile_name,
        lv_ver TYPE zbdc_prof_bup-profile_ver,
        lv_script_id TYPE zbdc_script_bup-script_id,
        lv_hash TYPE zbdc_script_bup-contract_hash,
        lv_found TYPE abap_bool,
        lv_comp TYPE zbdc_config_bup-config_value,
        lv_item_tok TYPE string,
        lv_has_repeat TYPE abap_bool.

  REFRESH: ct_pre, ct_item, ct_post.

  lv_profile = txtp_profile_name.
  lv_ver     = gv_profile_ver.

  IF gv_runtime_script_id IS NOT INITIAL.
    SELECT SINGLE profile_name, profile_ver
      FROM zbdc_script_bup
      INTO (@lv_profile, @lv_ver)
      WHERE script_id = @gv_runtime_script_id
        AND tcode     = @pv_tcode.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.
  ENDIF.

  PERFORM load_profile_script
    USING    pv_tcode lv_profile lv_ver
    CHANGING lt_script lv_script_id lv_hash lv_found.
  IF lv_found <> abap_true.
    RETURN.
  ENDIF.

  IF gv_runtime_script_id IS NOT INITIAL AND
     lv_script_id <> gv_runtime_script_id.
    REFRESH lt_script.
    RETURN.
  ENDIF.

  gv_runtime_script_id     = lv_script_id.
  gv_runtime_contract_hash = lv_hash.

 "S1 EXACT replay is an ordered RAW stream, not PRE/POST business
 "semantics. Older metadata may still carry stale ROW_TYPE values even when
 "the current S1 plan has no proven repeat placeholder. In that case runtime
 "must ignore ROW_TYPE completely and feed the exact persisted STEP_SEQ order
 "through one stream. This preserves every PROGRAM/DYNPRO boundary before its
 "recorded fields without any TCODE/screen/field special case.
  CLEAR: lv_comp, lv_has_repeat.
  PERFORM get_script_cfg
    USING    lv_script_id 'COMPILER'
    CHANGING lv_comp.
  TRANSLATE lv_comp TO UPPER CASE.
  CONDENSE lv_comp NO-GAPS.
  lv_item_tok = '(' && gc_ph_index && ')'.

  LOOP AT lt_script INTO ls_scr
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    IF ls_scr-field_name CS lv_item_tok.
      lv_has_repeat = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF lv_comp = 'S1' AND lv_has_repeat <> abap_true.
    SORT lt_script BY step_seq.
    ct_pre[] = lt_script[].
    RETURN.
  ENDIF.

 "repeat-capable runtime consumes the frozen compiler plan exactly as
 "persisted. ROW_TYPE is used only when a proven repeat placeholder exists.
  LOOP AT lt_script INTO ls_scr.
    CASE ls_scr-row_type.
      WHEN gc_rt_item.
        APPEND ls_scr TO ct_item.
      WHEN gc_m2_rt_post.
        APPEND ls_scr TO ct_post.
      WHEN OTHERS.
        APPEND ls_scr TO ct_pre.
    ENDCASE.
  ENDLOOP.
ENDFORM.

*& LOAD_MAPPING_PROFILE - mapping theo transaction

FORM load_mapping_profile_ctx
  USING    pv_tcode   TYPE sy-tcode
           pv_profile TYPE zbdc_prof_bup-profile_name
           pv_ver     TYPE zbdc_prof_bup-profile_ver
  CHANGING ct_map     TYPE ty_t_map.

  REFRESH ct_map.
  IF pv_tcode IS INITIAL OR pv_profile IS INITIAL OR pv_ver IS INITIAL.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_mapping_bup
    INTO TABLE @ct_map
    WHERE tcode        = @pv_tcode
      AND profile_name = @pv_profile
      AND profile_ver  = @pv_ver.
ENDFORM.

*& Managed Batch Input profile: A/E/N x S/A

*& Managed Batch Input profile: display mode N/E/A x update A/S

*& .5 - Generic typed value conversion for dynamic BDC fields
*& Uses DDIC datatype resolved from the recorded screen field.
*& No TCODE, profile, worksheet or business-field literals.
*& Optional blank values remain omitted from BDCDATA.

FORM date_to_external
  USING    iv_value   TYPE any
           iv_field   TYPE any
  CHANGING cv_value   TYPE bdcdata-fval
           cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_input    TYPE string,
        lv_work     TYPE string,
        lv_norm     TYPE string,
        lv_token    TYPE string,
        lv_date     TYPE sy-datum,
        lv_external TYPE char10,
        lv_year     TYPE c LENGTH 4,
        lv_month    TYPE c LENGTH 2,
        lv_day      TYPE c LENGTH 2,
        lv_p1       TYPE c LENGTH 2,
        lv_p2       TYPE c LENGTH 2,
        lv_p3       TYPE c LENGTH 4,
        lv_days     TYPE i,
        lv_len      TYPE i.

  lv_input = iv_value.
  CONDENSE lv_input.
  CLEAR: cv_value, cv_ok, cv_message.

  IF lv_input IS INITIAL.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  lv_work = lv_input.
  lv_len = strlen( lv_work ).

 "Excel/XLSX sometimes provides a timestamp-like string. Keep only the date
 "part before semantic DATE parsing. This is generic and not TCODE-specific.
  IF lv_len > 10.
    IF lv_work+10(1) = space OR lv_work+10(1) = 'T'.
      lv_work = lv_work+0(10).
    ENDIF.
  ENDIF.

 "1) Respect the SAP user's configured external date format first.
  CALL FUNCTION 'CONVERT_DATE_TO_INTERNAL'
    EXPORTING
      date_external            = lv_work
    IMPORTING
      date_internal            = lv_date
    EXCEPTIONS
      date_external_is_invalid = 1
      OTHERS                   = 2.
  IF sy-subrc <> 0.
    CLEAR lv_date.
  ENDIF.

 "2) Stable ISO / technical formats, independent of user date format.
  IF lv_date IS INITIAL.
    lv_token = lv_work.
    CONDENSE lv_token NO-GAPS.

    IF strlen( lv_token ) = 8
       AND lv_token CO '0123456789'.
      lv_date = lv_token.
    ELSE.
      lv_norm = lv_token.
      REPLACE ALL OCCURRENCES OF SUBSTRING '/' IN lv_norm WITH '-'.
      REPLACE ALL OCCURRENCES OF SUBSTRING '.' IN lv_norm WITH '-'.

      IF strlen( lv_norm ) = 10.
 "YYYY-MM-DD / YYYY/MM/DD / YYYY.MM.DD
        IF lv_norm+4(1) = '-'
           AND lv_norm+7(1) = '-'.
          lv_year  = lv_norm+0(4).
          lv_month = lv_norm+5(2).
          lv_day   = lv_norm+8(2).
          IF lv_year  CO '0123456789'
             AND lv_month CO '0123456789'
             AND lv_day   CO '0123456789'.
            lv_date = lv_year && lv_month && lv_day.
          ENDIF.

 "DD-MM-YYYY or MM-DD-YYYY. Prefer DMY for ambiguous cases because
 "Vietnam/SAP demos normally use day-month-year; when the second token
 "is > 12 the value is clearly MDY.
        ELSEIF lv_norm+2(1) = '-'
           AND lv_norm+5(1) = '-'.
          lv_p1 = lv_norm+0(2).
          lv_p2 = lv_norm+3(2).
          lv_p3 = lv_norm+6(4).
          IF lv_p1 CO '0123456789'
             AND lv_p2 CO '0123456789'
             AND lv_p3 CO '0123456789'.
            IF lv_p2 > '12' AND lv_p1 <= '12'.
 "MM-DD-YYYY
              lv_year  = lv_p3.
              lv_month = lv_p1.
              lv_day   = lv_p2.
            ELSE.
 "DD-MM-YYYY, including ambiguous DD/MM values.
              lv_year  = lv_p3.
              lv_month = lv_p2.
              lv_day   = lv_p1.
            ENDIF.
            lv_date = lv_year && lv_month && lv_day.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

 "3) Excel serial date support for XLSX/CSV values such as 45123. Only DATE
 "semantic fields come here, so this remains generic and metadata-driven.
  IF lv_date IS INITIAL.
    lv_token = lv_work.
    CONDENSE lv_token NO-GAPS.
    IF strlen( lv_token ) >= 5
       AND strlen( lv_token ) <= 7
       AND lv_token CO '0123456789'.
      lv_days = lv_token.
      IF lv_days >= 20000 AND lv_days <= 80000.
        lv_date = '18991230'.
        lv_date = lv_date + lv_days.
      ENDIF.
    ENDIF.
  ENDIF.

  IF lv_date IS NOT INITIAL.
    CALL FUNCTION 'DATE_CHECK_PLAUSIBILITY'
      EXPORTING
        date                      = lv_date
      EXCEPTIONS
        plausibility_check_failed = 1
        OTHERS                    = 2.
    IF sy-subrc <> 0.
      CLEAR lv_date.
    ENDIF.
  ENDIF.

  IF lv_date IS INITIAL.
    cv_message =
      |Invalid date value "{ lv_input }" for { iv_field }. Use YYYYMMDD, YYYY-MM-DD, DD/MM/YYYY, DD.MM.YYYY or SAP user date format.|.
    RETURN.
  ENDIF.

  CLEAR lv_external.
  CALL FUNCTION 'CONVERT_DATE_TO_EXTERNAL'
    EXPORTING
      date_internal            = lv_date
    IMPORTING
      date_external            = lv_external
    EXCEPTIONS
      date_internal_is_invalid = 1
      OTHERS                   = 2.

  IF sy-subrc <> 0 OR lv_external IS INITIAL.
    WRITE lv_date TO lv_external.
  ENDIF.

  CONDENSE lv_external.
  IF lv_external IS INITIAL.
    cv_message =
      |Cannot convert internal date { lv_date } to SAP external date for { iv_field }.|.
    RETURN.
  ENDIF.

  cv_value = lv_external.
  cv_ok = abap_true.
ENDFORM.

*& Runtime semantic resolver

*& Runtime rule resolver: contract/DDIC driven, no header guess.

FORM read_map_runtime_rule
  USING    is_map           TYPE zbdc_mapping_bup
           iv_bdc_field     TYPE any
  CHANGING cv_value_kind    TYPE string
           cv_push_policy   TYPE string
           cv_format_policy TYPE string
           cv_pad_length    TYPE i
           cv_pad_char      TYPE string
           cv_conv_exit     TYPE string
           cv_ddic_length   TYPE i.

  DATA: lv_text        TYPE string,
        lv_datatype    TYPE string,
        lv_ddic_len    TYPE i,
        lv_ddic_conv   TYPE string,
        lv_ddic_found  TYPE abap_bool,
        lv_code_pf     TYPE abap_bool.

  CLEAR: cv_value_kind, cv_push_policy, cv_format_policy,
         cv_pad_length, cv_pad_char, cv_conv_exit, cv_ddic_length.

 "1) Authoritative rule from CONFIG/mapping snapshot. All reads are dynamic
 "so systems without the optional columns still compile.
  PERFORM get_optional_comp USING is_map 'VALUE_KIND' CHANGING lv_text.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'SEMANTIC_KIND' CHANGING lv_text. ENDIF.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'FIELD_KIND' CHANGING lv_text. ENDIF.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'DATA_KIND' CHANGING lv_text. ENDIF.
  cv_value_kind = lv_text.
  TRANSLATE cv_value_kind TO UPPER CASE.
  CONDENSE cv_value_kind NO-GAPS.

  CLEAR lv_text.
  PERFORM get_optional_comp USING is_map 'PUSH_POLICY' CHANGING lv_text.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'ACTION' CHANGING lv_text. ENDIF.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'BDC_ACTION' CHANGING lv_text. ENDIF.
  cv_push_policy = lv_text.
  TRANSLATE cv_push_policy TO UPPER CASE.
  CONDENSE cv_push_policy NO-GAPS.
  IF cv_push_policy IS INITIAL.
    cv_push_policy = gc_push_push.
  ENDIF.

  CLEAR lv_text.
  PERFORM get_optional_comp USING is_map 'FORMAT_POLICY' CHANGING lv_text.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'FORMAT_KIND' CHANGING lv_text. ENDIF.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'FORMAT_RULE' CHANGING lv_text. ENDIF.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'OUTPUT_POLICY' CHANGING lv_text. ENDIF.
  cv_format_policy = lv_text.
  TRANSLATE cv_format_policy TO UPPER CASE.
  CONDENSE cv_format_policy NO-GAPS.

  CLEAR lv_text.
  PERFORM get_optional_comp USING is_map 'PAD_LENGTH' CHANGING lv_text.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'TARGET_LENGTH' CHANGING lv_text. ENDIF.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'OUTPUT_LENGTH' CHANGING lv_text. ENDIF.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'DDIC_LENGTH' CHANGING lv_text. ENDIF.
  CONDENSE lv_text NO-GAPS.
  IF lv_text IS NOT INITIAL AND lv_text CO '0123456789'.
    cv_pad_length = lv_text.
  ENDIF.

  CLEAR lv_text.
  PERFORM get_optional_comp USING is_map 'PAD_CHAR' CHANGING lv_text.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'FILL_CHAR' CHANGING lv_text. ENDIF.
  CONDENSE lv_text NO-GAPS.
  IF lv_text IS INITIAL.
    cv_pad_char = '0'.
  ELSE.
    cv_pad_char = lv_text+0(1).
  ENDIF.

  CLEAR lv_text.
  PERFORM get_optional_comp USING is_map 'CONVERSION_EXIT' CHANGING lv_text.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'CONV_EXIT' CHANGING lv_text. ENDIF.
  IF lv_text IS INITIAL. PERFORM get_optional_comp USING is_map 'DDIC_CONVEXIT' CHANGING lv_text. ENDIF.
  cv_conv_exit = lv_text.
  TRANSLATE cv_conv_exit TO UPPER CASE.
  CONDENSE cv_conv_exit NO-GAPS.

 "2) Technical DDIC derivation. This is allowed because it is screen-field
 "metadata, not TCODE/header/business-name guessing.
  PERFORM get_ddic_runtime_traits
    USING    iv_bdc_field
    CHANGING lv_datatype lv_ddic_len lv_ddic_conv lv_ddic_found.
  PERFORM ddic_code_proof
    USING    iv_bdc_field
    CHANGING lv_code_pf.
  cv_ddic_length = lv_ddic_len.
  IF cv_conv_exit IS INITIAL AND lv_ddic_conv IS NOT INITIAL.
    cv_conv_exit = lv_ddic_conv.
  ENDIF.

  IF cv_value_kind IS INITIAL.
    CASE lv_datatype.
      WHEN 'DATS'. cv_value_kind = gc_sem_date.
      WHEN 'QUAN'. cv_value_kind = gc_sem_quantity.
      WHEN 'CURR'. cv_value_kind = gc_sem_amount.
      WHEN 'CUKY'. cv_value_kind = gc_sem_currency.
      WHEN 'UNIT'. cv_value_kind = gc_sem_unit.
      WHEN 'NUMC'. cv_value_kind = gc_sem_category.
      WHEN OTHERS. cv_value_kind = gc_sem_raw.
    ENDCASE.
  ENDIF.

  IF cv_push_policy = 'SKIP'
     OR cv_push_policy = 'NO_BDC'
     OR cv_push_policy = 'NOBDC'
     OR cv_push_policy = 'IGNORE'
     OR cv_push_policy = gc_push_skip.
    cv_push_policy = gc_push_skip.
    cv_value_kind  = gc_sem_skip_bdc.
    RETURN.
  ENDIF.

  IF cv_value_kind = 'SKIP'
     OR cv_value_kind = 'NO_BDC'
     OR cv_value_kind = 'NOBDC'
     OR cv_value_kind = 'IGNORE'.
    cv_value_kind  = gc_sem_skip_bdc.
    cv_push_policy = gc_push_skip.
    RETURN.
  ENDIF.

  IF cv_format_policy IS INITIAL.
 "Generic DDIC contract fallback for systems where the mapping
 "table has not yet been enhanced with persisted FORMAT_POLICY columns.
 "The decision uses only SAP DDIC metadata of the BDC field. No TCODE,
 "source-column/header or business-field name is inspected.
    IF cv_conv_exit = 'ALPHA'.
      cv_value_kind    = gc_sem_category.
      cv_format_policy = gc_fmt_alpha.
    ELSE.
      CASE lv_datatype.
        WHEN 'DATS'.
          cv_value_kind    = gc_sem_date.
          cv_format_policy = gc_fmt_date.
        WHEN 'QUAN'.
          cv_value_kind    = gc_sem_quantity.
          cv_format_policy = gc_fmt_number.
        WHEN 'CURR'.
          cv_value_kind    = gc_sem_amount.
          cv_format_policy = gc_fmt_number.
        WHEN 'NUMC'.
          cv_value_kind    = gc_sem_category.
          cv_format_policy = gc_fmt_pad_left.
        WHEN 'CHAR'.
          IF lv_code_pf = abap_true AND lv_ddic_len > 0.
            cv_value_kind    = gc_sem_category.
            cv_format_policy = gc_fmt_ddic_code.
          ELSE.
            cv_format_policy = gc_fmt_none.
          ENDIF.
        WHEN OTHERS.
          CASE cv_value_kind.
            WHEN gc_sem_date.
              cv_format_policy = gc_fmt_date.
            WHEN gc_sem_quantity OR gc_sem_amount.
              cv_format_policy = gc_fmt_number.
            WHEN OTHERS.
              cv_format_policy = gc_fmt_none.
          ENDCASE.
      ENDCASE.
    ENDIF.
  ENDIF.

  IF ( cv_format_policy = gc_fmt_pad_left
       OR cv_format_policy = gc_fmt_alpha
       OR cv_format_policy = gc_fmt_ddic_code )
     AND cv_pad_length IS INITIAL
     AND lv_ddic_len > 0.
    cv_pad_length = lv_ddic_len.
  ENDIF.

  IF cv_value_kind IS INITIAL.
    cv_value_kind = gc_sem_raw.
  ENDIF.
  IF cv_format_policy IS INITIAL.
    cv_format_policy = gc_fmt_none.
  ENDIF.
ENDFORM.

FORM get_ddic_runtime_traits
  USING    iv_bdc_field   TYPE any
  CHANGING cv_datatype    TYPE string
           cv_length      TYPE i
           cv_conv_exit   TYPE string
           cv_found       TYPE abap_bool.

  DATA: lv_bdc      TYPE zbdc_mapping_bup-bdc_field,
        lv_left     TYPE string,
        lv_right    TYPE string,
        lv_dummy    TYPE string,
        lv_tab      TYPE tabname,
        lv_field    TYPE fieldname,
        lv_dom      TYPE dd01l-domname,
        lv_conv     TYPE dd01l-convexit,
        ls_dd04     TYPE dd04l,
        lt_dfies    TYPE STANDARD TABLE OF dfies,
        ls_dfies    TYPE dfies.

  CLEAR: cv_datatype, cv_length, cv_conv_exit, cv_found.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_bdc.
  IF lv_bdc IS INITIAL OR lv_bdc NS '-'.
    RETURN.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '(*)' IN lv_bdc WITH ''.
  IF lv_bdc CS '('.
    SPLIT lv_bdc AT '(' INTO lv_bdc lv_dummy.
  ENDIF.
  SPLIT lv_bdc AT '-' INTO lv_left lv_right.
  lv_tab   = lv_left.
  lv_field = lv_right.
  IF lv_tab IS INITIAL OR lv_field IS INITIAL.
    RETURN.
  ENDIF.

  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_tab
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_dfies
    EXCEPTIONS
      not_found      = 1
      internal_error = 2
      OTHERS         = 3.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  READ TABLE lt_dfies INTO ls_dfies WITH KEY fieldname = lv_field.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  cv_found     = abap_true.
  cv_datatype  = ls_dfies-datatype.
  cv_length    = ls_dfies-leng.
  cv_conv_exit = ls_dfies-convexit.

 "Some SHDB screen structures expose only a screen field
 "descriptor and leave DFIES-CONVEXIT empty. Use the SAP DDIC domain/data
 "element behind the field as technical metadata. This is generic DDIC
 "resolution; it does not inspect TCODE, SOURCE_COLUMN or business text.
  IF cv_conv_exit IS INITIAL AND ls_dfies-domname IS NOT INITIAL.
    SELECT SINGLE convexit
      FROM dd01l
      INTO lv_conv
      WHERE domname  = ls_dfies-domname
        AND as4local = 'A'
        AND as4vers  = '0000'.
    IF sy-subrc = 0 AND lv_conv IS NOT INITIAL.
      cv_conv_exit = lv_conv.
    ENDIF.
  ENDIF.

  IF ( cv_conv_exit IS INITIAL OR cv_datatype IS INITIAL OR cv_length IS INITIAL )
     AND lv_field IS NOT INITIAL.
    SELECT SINGLE *
      FROM dd04l
      INTO ls_dd04
      WHERE rollname = lv_field
        AND as4local = 'A'
        AND as4vers  = '0000'.
    IF sy-subrc = 0.
      cv_found = abap_true.
      IF cv_datatype IS INITIAL.
        cv_datatype = ls_dd04-datatype.
      ENDIF.
      IF cv_length IS INITIAL.
        cv_length = ls_dd04-leng.
      ENDIF.
      lv_dom = ls_dd04-domname.
      IF cv_conv_exit IS INITIAL AND lv_dom IS NOT INITIAL.
        CLEAR lv_conv.
        SELECT SINGLE convexit
          FROM dd01l
          INTO lv_conv
          WHERE domname  = lv_dom
            AND as4local = 'A'
            AND as4vers  = '0000'.
        IF sy-subrc = 0 AND lv_conv IS NOT INITIAL.
          cv_conv_exit = lv_conv.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

  TRANSLATE: cv_datatype TO UPPER CASE, cv_conv_exit TO UPPER CASE.
  CONDENSE: cv_datatype NO-GAPS, cv_conv_exit NO-GAPS.
ENDFORM.

*& Generic proof that a DDIC CHAR field is a fixed SAP code

FORM ddic_code_proof
  USING    iv_bdc_field TYPE any
  CHANGING cv_is_code   TYPE abap_bool.

  DATA: lv_bdc    TYPE zbdc_mapping_bup-bdc_field,
        lv_left   TYPE string,
        lv_right  TYPE string,
        lv_dummy  TYPE string,
        lv_tab    TYPE tabname,
        lv_field  TYPE fieldname,
        lv_dom    TYPE dd01l-domname,
        lv_domval TYPE dd07l-domvalue_l,
        lv_conv   TYPE dd01l-convexit,
        ls_dd04   TYPE dd04l,
        lt_dfies  TYPE STANDARD TABLE OF dfies,
        ls_dfies  TYPE dfies.

  CLEAR cv_is_code.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_bdc.
  IF lv_bdc IS INITIAL OR lv_bdc NS '-'.
    RETURN.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '(*)' IN lv_bdc WITH ''.
  IF lv_bdc CS '('.
    SPLIT lv_bdc AT '(' INTO lv_bdc lv_dummy.
  ENDIF.
  SPLIT lv_bdc AT '-' INTO lv_left lv_right.
  lv_tab   = lv_left.
  lv_field = lv_right.
  IF lv_tab IS INITIAL OR lv_field IS INITIAL.
    RETURN.
  ENDIF.

  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_tab
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_dfies
    EXCEPTIONS
      not_found      = 1
      internal_error = 2
      OTHERS         = 3.
  IF sy-subrc = 0.
    READ TABLE lt_dfies INTO ls_dfies WITH KEY fieldname = lv_field.
    IF sy-subrc = 0.
      IF ls_dfies-datatype = 'NUMC'
         OR ls_dfies-convexit IS NOT INITIAL
         OR ls_dfies-checktable IS NOT INITIAL.
        cv_is_code = abap_true.
        RETURN.
      ENDIF.

      lv_dom = ls_dfies-domname.
      IF lv_dom IS NOT INITIAL.
        CLEAR lv_domval.
        SELECT SINGLE domvalue_l
          FROM dd07l
          INTO lv_domval
          WHERE domname    = lv_dom
            AND as4local   = 'A'
            AND as4vers    = '0000'
            AND domvalue_l <> ''.
        IF sy-subrc = 0.
          cv_is_code = abap_true.
          RETURN.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

 "Fallback by data element name only. This is still DDIC metadata and is
 "needed for generated screen structures where DFIES lacks conversion data.
  SELECT SINGLE *
    FROM dd04l
    INTO ls_dd04
    WHERE rollname = lv_field
      AND as4local = 'A'
      AND as4vers  = '0000'.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  lv_dom = ls_dd04-domname.
  IF ls_dd04-datatype = 'NUMC'.
    cv_is_code = abap_true.
    RETURN.
  ENDIF.

  IF lv_dom IS NOT INITIAL.
    CLEAR lv_conv.
    SELECT SINGLE convexit
      FROM dd01l
      INTO lv_conv
      WHERE domname  = lv_dom
        AND as4local = 'A'
        AND as4vers  = '0000'.
    IF sy-subrc = 0 AND lv_conv IS NOT INITIAL.
      cv_is_code = abap_true.
      RETURN.
    ENDIF.

    CLEAR lv_domval.
    SELECT SINGLE domvalue_l
      FROM dd07l
      INTO lv_domval
      WHERE domname    = lv_dom
        AND as4local   = 'A'
        AND as4vers    = '0000'
        AND domvalue_l <> ''.
    IF sy-subrc = 0.
      cv_is_code = abap_true.
      RETURN.
    ENDIF.
  ENDIF.
ENDFORM.

*& Generic contract formatter

*& Infer one DDIC check table from equivalent repository fields

*& Screen structures do not always carry the foreign-key/check-table metadata
*& of the underlying application table. When direct DFIES metadata is blank,
*& search DDIC fields with the exact same technical FIELDNAME + ROLLNAME and
*& accept a check table only when the repository evidence is unique.
*& No TCODE, application table, business field or business value is hardcoded.

FORM infer_checktable
  USING    iv_field      TYPE fieldname
           iv_rollname   TYPE dfies-rollname
  CHANGING cv_checktable TYPE tabname
           cv_ok         TYPE abap_bool.

  TYPES: BEGIN OF ty_z496_cache,
           fieldname  TYPE fieldname,
           rollname   TYPE dfies-rollname,
           checktable TYPE tabname,
           found      TYPE abap_bool,
         END OF ty_z496_cache.

  STATICS gt_cache TYPE SORTED TABLE OF ty_z496_cache
                   WITH UNIQUE KEY fieldname rollname.

  DATA: lt_dd03      TYPE STANDARD TABLE OF dd03l,
        ls_dd03      TYPE dd03l,
        lt_dfies     TYPE STANDARD TABLE OF dfies,
        ls_dfies     TYPE dfies,
        ls_cache     TYPE ty_z496_cache,
        lv_field     TYPE fieldname,
        lv_rollname  TYPE dfies-rollname,
        lv_check     TYPE tabname.
  DATA lt_check TYPE SORTED TABLE OF tabname WITH UNIQUE KEY table_line.

  CLEAR: cv_checktable, cv_ok.
  lv_field    = iv_field.
  lv_rollname = iv_rollname.
  TRANSLATE: lv_field TO UPPER CASE, lv_rollname TO UPPER CASE.
  CONDENSE: lv_field NO-GAPS, lv_rollname NO-GAPS.
  IF lv_field IS INITIAL OR lv_rollname IS INITIAL.
    RETURN.
  ENDIF.

  READ TABLE gt_cache INTO ls_cache
    WITH TABLE KEY fieldname = lv_field rollname = lv_rollname.
  IF sy-subrc = 0.
    cv_checktable = ls_cache-checktable.
    cv_ok         = ls_cache-found.
    RETURN.
  ENDIF.

  SELECT * FROM dd03l
    INTO TABLE lt_dd03
    UP TO 100 ROWS
    WHERE fieldname = lv_field
      AND rollname  = lv_rollname
      AND as4local  = 'A'
      AND as4vers   = '0000'.

  LOOP AT lt_dd03 INTO ls_dd03.
    IF ls_dd03-tabname IS INITIAL.
      CONTINUE.
    ENDIF.

    REFRESH lt_dfies.
    CALL FUNCTION 'DDIF_FIELDINFO_GET'
      EXPORTING
        tabname        = ls_dd03-tabname
        langu          = sy-langu
        all_types      = abap_true
      TABLES
        dfies_tab      = lt_dfies
      EXCEPTIONS
        OTHERS         = 1.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    CLEAR ls_dfies.
    READ TABLE lt_dfies INTO ls_dfies WITH KEY fieldname = lv_field.
    IF sy-subrc <> 0 OR ls_dfies-checktable IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_check = ls_dfies-checktable.
    TRANSLATE lv_check TO UPPER CASE.
    CONDENSE lv_check NO-GAPS.
    IF lv_check IS NOT INITIAL.
      INSERT lv_check INTO TABLE lt_check.
    ENDIF.
  ENDLOOP.

  CLEAR ls_cache.
  ls_cache-fieldname = lv_field.
  ls_cache-rollname  = lv_rollname.
  IF lines( lt_check ) = 1.
    READ TABLE lt_check INTO cv_checktable INDEX 1.
    IF sy-subrc = 0 AND cv_checktable IS NOT INITIAL.
      cv_ok = abap_true.
      ls_cache-checktable = cv_checktable.
      ls_cache-found      = abap_true.
    ENDIF.
  ENDIF.
  INSERT ls_cache INTO TABLE gt_cache.
ENDFORM.

*& Repository text -> technical key fallback

*& Some generated/classic screen structures expose the correct data element
*& but no foreign-key/check-table metadata on the screen field itself. In
*& that case search DDIC key fields with the same ROLLNAME/data element, follow
*& each candidate's SAP text table and accept only one unique technical key.
*& This is TCODE-neutral and business-field-neutral; ambiguity fails closed.
*& The caller-level Z488 cache bounds the cost per field/value/language.

FORM resolve_text_key
  USING    iv_field    TYPE fieldname
           iv_rollname TYPE dfies-rollname
           iv_input    TYPE any
  CHANGING cv_value    TYPE string
           cv_found    TYPE abap_bool
           cv_ok       TYPE abap_bool
           cv_message  TYPE string.

  DATA: lv_field      TYPE fieldname,
        lv_rollname   TYPE dfies-rollname,
        lv_input      TYPE string,
        lv_sql_value  TYPE string,
        lt_dd03       TYPE STANDARD TABLE OF dd03l,
        ls_dd03       TYPE dd03l,
        lv_texttable  TYPE tabname,
        lv_checkfield TYPE fieldname,
        lt_text_dfies TYPE STANDARD TABLE OF dfies,
        ls_text_dfies TYPE dfies,
        lv_text_key   TYPE fieldname,
        lv_lang_field TYPE fieldname,
        lv_where      TYPE string,
        lr_rows       TYPE REF TO data,
        lv_key_value  TYPE string.

  DATA lt_match TYPE SORTED TABLE OF string WITH UNIQUE KEY table_line.

  FIELD-SYMBOLS: <lt_rows> TYPE STANDARD TABLE,
                 <ls_row>  TYPE any,
                 <lv_key>  TYPE any.

  CLEAR: cv_value, cv_found, cv_message.
  cv_ok = abap_true.

  lv_field    = iv_field.
  lv_rollname = iv_rollname.
  lv_input    = iv_input.
  TRANSLATE: lv_field TO UPPER CASE, lv_rollname TO UPPER CASE.
  CONDENSE: lv_field NO-GAPS, lv_rollname NO-GAPS, lv_input.

  IF lv_field IS INITIAL OR lv_rollname IS INITIAL OR lv_input IS INITIAL.
    RETURN.
  ENDIF.

 "Only repository key fields with the exact same data-element identity are
 "candidates. Structures/views without an SAP text-table are skipped.
  SELECT * FROM dd03l
    INTO TABLE lt_dd03
    UP TO 100 ROWS
    WHERE rollname = lv_rollname
      AND keyflag  = 'X'
      AND as4local  = 'A'
      AND as4vers   = '0000'.

  IF lt_dd03 IS INITIAL.
    RETURN.
  ENDIF.

  lv_sql_value = lv_input.
  REPLACE ALL OCCURRENCES OF '''' IN lv_sql_value WITH ''''''.

  LOOP AT lt_dd03 INTO ls_dd03.
    IF ls_dd03-tabname IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_texttable, lv_checkfield.
    CALL FUNCTION 'DDUT_TEXTTABLE_GET'
      EXPORTING
        tabname    = ls_dd03-tabname
      IMPORTING
        texttable  = lv_texttable
        checkfield = lv_checkfield.
    IF lv_texttable IS INITIAL.
      CONTINUE.
    ENDIF.

    REFRESH lt_text_dfies.
    CALL FUNCTION 'DDIF_FIELDINFO_GET'
      EXPORTING
        tabname        = lv_texttable
        langu          = sy-langu
        all_types      = abap_true
      TABLES
        dfies_tab      = lt_text_dfies
      EXCEPTIONS
        OTHERS         = 1.
    IF sy-subrc <> 0 OR lt_text_dfies IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_text_key, lv_lang_field.
    READ TABLE lt_text_dfies INTO ls_text_dfies
      WITH KEY fieldname = ls_dd03-fieldname.
    IF sy-subrc = 0.
      lv_text_key = ls_dd03-fieldname.
    ELSEIF lv_checkfield IS NOT INITIAL.
      READ TABLE lt_text_dfies INTO ls_text_dfies
        WITH KEY fieldname = lv_checkfield.
      IF sy-subrc = 0.
        lv_text_key = lv_checkfield.
      ENDIF.
    ENDIF.
    IF lv_text_key IS INITIAL.
      CONTINUE.
    ENDIF.

    LOOP AT lt_text_dfies INTO ls_text_dfies.
      IF ls_text_dfies-datatype = 'LANG'.
        lv_lang_field = ls_text_dfies-fieldname.
        EXIT.
      ENDIF.
    ENDLOOP.

    LOOP AT lt_text_dfies INTO ls_text_dfies
      WHERE keyflag IS INITIAL.
      IF ls_text_dfies-fieldname = lv_lang_field
         OR ( ls_text_dfies-datatype <> 'CHAR'
              AND ls_text_dfies-datatype <> 'STRING'
              AND ls_text_dfies-datatype <> 'SSTRING' ).
        CONTINUE.
      ENDIF.

      lv_where = |{ ls_text_dfies-fieldname } = '{ lv_sql_value }'|.
      IF lv_lang_field IS NOT INITIAL.
        lv_where = lv_where &&
          | AND { lv_lang_field } = '{ sy-langu }'|.
      ENDIF.

      TRY.
          CREATE DATA lr_rows TYPE STANDARD TABLE OF (lv_texttable).
          ASSIGN lr_rows->* TO <lt_rows>.
          IF <lt_rows> IS NOT ASSIGNED.
            CONTINUE.
          ENDIF.
          REFRESH <lt_rows>.

          SELECT * FROM (lv_texttable)
            INTO TABLE <lt_rows>
            UP TO 20 ROWS
            WHERE (lv_where).

          LOOP AT <lt_rows> ASSIGNING <ls_row>.
            UNASSIGN <lv_key>.
            ASSIGN COMPONENT lv_text_key OF STRUCTURE <ls_row> TO <lv_key>.
            IF sy-subrc <> 0 OR <lv_key> IS NOT ASSIGNED.
              CONTINUE.
            ENDIF.
            lv_key_value = <lv_key>.
            CONDENSE lv_key_value.
            IF lv_key_value IS NOT INITIAL.
              INSERT lv_key_value INTO TABLE lt_match.
            ENDIF.
          ENDLOOP.
        CATCH cx_sy_create_data_error
              cx_sy_dynamic_osql_semantics
              cx_sy_dynamic_osql_syntax
              cx_sy_open_sql_db.
          CONTINUE.
      ENDTRY.
    ENDLOOP.
  ENDLOOP.

  IF lines( lt_match ) = 1.
    READ TABLE lt_match INTO cv_value INDEX 1.
    IF sy-subrc = 0 AND cv_value IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
  ELSEIF lines( lt_match ) > 1.
    cv_ok = abap_false.
    cv_message =
      |SAP display value "{ lv_input }" maps to more than one DDIC technical key for { lv_field }. Use the technical key or a unique displayed value.|.
  ENDIF.
ENDFORM.

*& SAP GUI display value -> BDC technical key resolver

*& End users may enter the value they see/select in SAP GUI instead of knowing
*& the hidden key. Resolution is allowed only when DDIC proves a code field.
*& Already-valid keys are preserved; otherwise domain fixed-value text and the
*& DDIC check-table text table are resolved in SY-LANGU. Ambiguity fails closed.
*& No TCODE, table, business field or business value is hardcoded.

FORM gui_value_to_bdc_key
  USING    iv_bdc_field TYPE any
           iv_value     TYPE any
  CHANGING cv_value     TYPE string
           cv_applied   TYPE abap_bool
           cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_input       TYPE string,
        lv_input_cmp   TYPE string,
        lv_bdc         TYPE zbdc_mapping_bup-bdc_field,
        lv_left        TYPE string,
        lv_right       TYPE string,
        lv_dummy       TYPE string,
        lv_tab         TYPE tabname,
        lv_field       TYPE fieldname,
        lt_dfies       TYPE STANDARD TABLE OF dfies,
        ls_dfies       TYPE dfies,
        lt_check_dfies TYPE STANDARD TABLE OF dfies,
        ls_check_dfies TYPE dfies,
        lv_checktable  TYPE tabname,
        lv_keyfield    TYPE fieldname,
        lv_code        TYPE abap_bool,
        lv_exists      TYPE abap_bool,
        lv_upper_key   TYPE string,
        lt_dom         TYPE STANDARD TABLE OF dd07v,
        ls_dom         TYPE dd07v,
        lv_dom_key     TYPE string,
        lv_dom_text    TYPE string,
        lv_cmp         TYPE string,
        lt_match       TYPE SORTED TABLE OF string WITH UNIQUE KEY table_line,
        lv_match       TYPE string,
        lv_texttable   TYPE tabname,
        lv_checkfield  TYPE fieldname,
        lt_text_dfies  TYPE STANDARD TABLE OF dfies,
        ls_text_dfies  TYPE dfies,
        lv_text_key    TYPE fieldname,
        lv_lang_field  TYPE fieldname,
        lv_sql_value   TYPE string,
        lv_where       TYPE string,
        lr_rows        TYPE REF TO data,
        lv_z497_value  TYPE string,
        lv_z497_found  TYPE abap_bool,
        lv_z497_ok     TYPE abap_bool,
        lv_z497_msg    TYPE string.

  FIELD-SYMBOLS: <lt_rows> TYPE STANDARD TABLE,
                 <ls_row>  TYPE any,
                 <lv_key>  TYPE any.

  CLEAR: cv_applied, cv_message.
  cv_ok    = abap_true.
  cv_value = iv_value.
  lv_input = iv_value.
  CONDENSE lv_input.
  IF lv_input IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_bdc.
  IF lv_bdc IS INITIAL OR lv_bdc NS '-'.
    RETURN.
  ENDIF.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_bdc WITH ''.
  IF lv_bdc CS '('.
    SPLIT lv_bdc AT '(' INTO lv_bdc lv_dummy.
  ENDIF.
  SPLIT lv_bdc AT '-' INTO lv_left lv_right.
  lv_tab   = lv_left.
  lv_field = lv_right.
  TRANSLATE: lv_tab TO UPPER CASE, lv_field TO UPPER CASE.
  CONDENSE: lv_tab NO-GAPS, lv_field NO-GAPS.
  IF lv_tab IS INITIAL OR lv_field IS INITIAL.
    RETURN.
  ENDIF.

  REFRESH lt_dfies.
  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_tab
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_dfies
    EXCEPTIONS
      OTHERS         = 1.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.
  READ TABLE lt_dfies INTO ls_dfies WITH KEY fieldname = lv_field.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

 "do not require the screen structure itself to carry complete
 "foreign-key metadata. Establish code evidence from DDIC, then allow a
 "unique equivalent-field check-table fallback below when DFIES is blank.
  CLEAR lv_code.
  PERFORM ddic_code_proof
    USING    iv_bdc_field
    CHANGING lv_code.
  IF ls_dfies-checktable IS NOT INITIAL.
    lv_code = abap_true.
  ENDIF.

  lv_input_cmp = lv_input.
  TRANSLATE lv_input_cmp TO UPPER CASE.
  CONDENSE lv_input_cmp.

 "Domain fixed values: accept the key or the current-language displayed text.
  IF ls_dfies-domname IS NOT INITIAL.
    REFRESH: lt_dom, lt_match.
    SELECT * FROM dd07v
      INTO TABLE lt_dom
      WHERE domname    = ls_dfies-domname
        AND ddlanguage = sy-langu.
    IF lt_dom IS NOT INITIAL.
      lv_code = abap_true.
    ENDIF.
    LOOP AT lt_dom INTO ls_dom.
      lv_dom_key  = ls_dom-domvalue_l.
      lv_dom_text = ls_dom-ddtext.
      CONDENSE: lv_dom_key, lv_dom_text.

      lv_cmp = lv_dom_key.
      TRANSLATE lv_cmp TO UPPER CASE.
      CONDENSE lv_cmp.
      IF lv_cmp = lv_input_cmp AND lv_dom_key IS NOT INITIAL.
        cv_value = lv_dom_key.
        IF cv_value <> lv_input.
          cv_applied = abap_true.
        ENDIF.
        RETURN.
      ENDIF.

      lv_cmp = lv_dom_text.
      TRANSLATE lv_cmp TO UPPER CASE.
      CONDENSE lv_cmp.
      IF lv_cmp = lv_input_cmp AND lv_dom_key IS NOT INITIAL.
        INSERT lv_dom_key INTO TABLE lt_match.
      ENDIF.
    ENDLOOP.
    IF lines( lt_match ) = 1.
      READ TABLE lt_match INTO lv_match INDEX 1.
      cv_value   = lv_match.
      cv_applied = abap_true.
      RETURN.
    ELSEIF lines( lt_match ) > 1.
      cv_ok = abap_false.
      cv_message = |SAP GUI display value "{ lv_input }" is ambiguous for { iv_bdc_field }. Use its technical key or one unique displayed value.|.
      RETURN.
    ENDIF.
  ENDIF.

 "Screen structures may omit the foreign-key relation even though
 "their data element is the same as a repository code table. Resolve the
 "display text through DDIC text tables before any raw-length formatter runs.
  CLEAR: lv_z497_value, lv_z497_found, lv_z497_ok, lv_z497_msg.
  PERFORM resolve_text_key
    USING    lv_field ls_dfies-rollname lv_input
    CHANGING lv_z497_value lv_z497_found lv_z497_ok lv_z497_msg.
  IF lv_z497_ok <> abap_true.
    cv_ok = abap_false.
    cv_message = lv_z497_msg.
    RETURN.
  ENDIF.
  IF lv_z497_found = abap_true.
    cv_value = lv_z497_value.
    IF cv_value <> lv_input.
      cv_applied = abap_true.
    ENDIF.
    RETURN.
  ENDIF.

 "Check-table technical key. Prefer the same field name; otherwise accept one
 "unique key field with the same data element/domain.
  lv_checktable = ls_dfies-checktable.
  IF lv_checktable IS INITIAL.
    DATA(lv_z496_check_ok) = abap_false.
    PERFORM infer_checktable
      USING    lv_field ls_dfies-rollname
      CHANGING lv_checktable lv_z496_check_ok.
    IF lv_z496_check_ok = abap_true.
      lv_code = abap_true.
    ENDIF.
  ENDIF.
  IF lv_checktable IS INITIAL.
 "No repository proof of a coded field: leave ordinary free text untouched.
    IF lv_code <> abap_true.
      RETURN.
    ENDIF.
    IF ls_dfies-leng > 0 AND strlen( lv_input ) > ls_dfies-leng.
      cv_ok = abap_false.
      cv_message = |Value "{ lv_input }" could not be resolved through SAP DDIC/value-help for { iv_bdc_field }. Enter the SAP technical key or one exact displayed value.|.
    ENDIF.
    RETURN.
  ENDIF.

  REFRESH lt_check_dfies.
  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_checktable
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_check_dfies
    EXCEPTIONS
      OTHERS         = 1.
  IF sy-subrc <> 0 OR lt_check_dfies IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR lv_keyfield.
  READ TABLE lt_check_dfies INTO ls_check_dfies WITH KEY fieldname = lv_field.
  IF sy-subrc = 0.
    lv_keyfield = ls_check_dfies-fieldname.
  ELSE.
    LOOP AT lt_check_dfies INTO ls_check_dfies WHERE keyflag = 'X'.
      IF ls_check_dfies-fieldname = 'MANDT'
         OR ls_check_dfies-datatype = 'CLNT'
         OR ls_check_dfies-datatype = 'LANG'.
        CONTINUE.
      ENDIF.
      IF ( ls_dfies-rollname IS NOT INITIAL
           AND ls_check_dfies-rollname = ls_dfies-rollname )
         OR ( ls_dfies-domname IS NOT INITIAL
              AND ls_check_dfies-domname = ls_dfies-domname ).
        IF lv_keyfield IS INITIAL.
          lv_keyfield = ls_check_dfies-fieldname.
        ELSEIF lv_keyfield <> ls_check_dfies-fieldname.
          CLEAR lv_keyfield.
          EXIT.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.
  IF lv_keyfield IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR lv_exists.
  PERFORM dynamic_key_exists
    USING    lv_checktable lv_keyfield lv_input
    CHANGING lv_exists.
  IF lv_exists = abap_true.
    cv_value = lv_input.
    RETURN.
  ENDIF.

  lv_upper_key = lv_input.
  TRANSLATE lv_upper_key TO UPPER CASE.
  IF lv_upper_key <> lv_input.
    CLEAR lv_exists.
    PERFORM dynamic_key_exists
      USING    lv_checktable lv_keyfield lv_upper_key
      CHANGING lv_exists.
    IF lv_exists = abap_true.
      cv_value   = lv_upper_key.
      cv_applied = abap_true.
      RETURN.
    ENDIF.
  ENDIF.

 "Resolve current-language displayed text from the DDIC text table.
  CLEAR: lv_texttable, lv_checkfield.
  CALL FUNCTION 'DDUT_TEXTTABLE_GET'
    EXPORTING
      tabname    = lv_checktable
    IMPORTING
      texttable  = lv_texttable
      checkfield = lv_checkfield.
  IF lv_texttable IS INITIAL.
    RETURN.
  ENDIF.

  REFRESH lt_text_dfies.
  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_texttable
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_text_dfies
    EXCEPTIONS
      OTHERS         = 1.
  IF sy-subrc <> 0 OR lt_text_dfies IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_text_key, lv_lang_field.
  READ TABLE lt_text_dfies INTO ls_text_dfies WITH KEY fieldname = lv_keyfield.
  IF sy-subrc = 0.
    lv_text_key = lv_keyfield.
  ELSEIF lv_checkfield IS NOT INITIAL.
    READ TABLE lt_text_dfies INTO ls_text_dfies WITH KEY fieldname = lv_checkfield.
    IF sy-subrc = 0.
      lv_text_key = lv_checkfield.
    ENDIF.
  ENDIF.
  IF lv_text_key IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_text_dfies INTO ls_text_dfies.
    IF ls_text_dfies-datatype = 'LANG'.
      lv_lang_field = ls_text_dfies-fieldname.
      EXIT.
    ENDIF.
  ENDLOOP.

  lv_sql_value = lv_input.
  REPLACE ALL OCCURRENCES OF '''' IN lv_sql_value WITH ''''''.
  REFRESH lt_match.

  LOOP AT lt_text_dfies INTO ls_text_dfies WHERE keyflag IS INITIAL.
    IF ls_text_dfies-fieldname = lv_lang_field
       OR ( ls_text_dfies-datatype <> 'CHAR'
            AND ls_text_dfies-datatype <> 'STRING'
            AND ls_text_dfies-datatype <> 'SSTRING' ).
      CONTINUE.
    ENDIF.

    lv_where = |{ ls_text_dfies-fieldname } = '{ lv_sql_value }'|.
    IF lv_lang_field IS NOT INITIAL.
      lv_where = lv_where && | AND { lv_lang_field } = '{ sy-langu }'|.
    ENDIF.

    TRY.
        CREATE DATA lr_rows TYPE STANDARD TABLE OF (lv_texttable).
        ASSIGN lr_rows->* TO <lt_rows>.
        IF <lt_rows> IS NOT ASSIGNED.
          CONTINUE.
        ENDIF.
        REFRESH <lt_rows>.
        SELECT * FROM (lv_texttable)
          INTO TABLE <lt_rows>
          UP TO 20 ROWS
          WHERE (lv_where).
        LOOP AT <lt_rows> ASSIGNING <ls_row>.
          UNASSIGN <lv_key>.
          ASSIGN COMPONENT lv_text_key OF STRUCTURE <ls_row> TO <lv_key>.
          IF sy-subrc = 0 AND <lv_key> IS ASSIGNED.
            lv_match = <lv_key>.
            CONDENSE lv_match.
            IF lv_match IS NOT INITIAL.
              INSERT lv_match INTO TABLE lt_match.
            ENDIF.
          ENDIF.
        ENDLOOP.
      CATCH cx_sy_create_data_error
            cx_sy_dynamic_osql_semantics
            cx_sy_dynamic_osql_syntax
            cx_sy_open_sql_db.
        CONTINUE.
    ENDTRY.
  ENDLOOP.

  IF lines( lt_match ) = 1.
    READ TABLE lt_match INTO lv_match INDEX 1.
    cv_value   = lv_match.
    cv_applied = abap_true.
    RETURN.
  ELSEIF lines( lt_match ) > 1.
    cv_ok = abap_false.
    cv_message = |SAP GUI display value "{ lv_input }" matches more than one technical key for { iv_bdc_field }. Use the SAP key or a unique displayed value.|.
    RETURN.
  ENDIF.

  IF lv_code = abap_true
     AND ls_dfies-leng > 0
     AND strlen( lv_input ) > ls_dfies-leng.
    cv_ok = abap_false.
    cv_message = |Value "{ lv_input }" could not be resolved through SAP DDIC/value-help for { iv_bdc_field }. Enter the SAP technical key or one exact displayed value.|.
  ENDIF.
ENDFORM.

*& Bounded cache for SAP GUI display -> technical key resolution

*& Validation and execution may resolve the same DDIC field/value hundreds
*& of times in one mass run. Keep a bounded, language-aware cache so SAP DDIC
*& and text tables are not re-read per record. The cache stores only the
*& deterministic outcome of Z487; it never invents a key or bypasses a failed
*& ambiguity check.

FORM gui_bdc_key_cached
  USING    iv_bdc_field TYPE any
           iv_value     TYPE any
  CHANGING cv_value     TYPE string
           cv_applied   TYPE abap_bool
           cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  TYPES: BEGIN OF ty_z488_cache,
           bdc_field TYPE zbdc_mapping_bup-bdc_field,
           input     TYPE string,
           langu     TYPE sylangu,
           output    TYPE string,
           applied   TYPE abap_bool,
           ok        TYPE abap_bool,
           message   TYPE string,
         END OF ty_z488_cache.

  STATICS gt_cache TYPE STANDARD TABLE OF ty_z488_cache WITH DEFAULT KEY.

  DATA: ls_cache TYPE ty_z488_cache,
        lv_field TYPE zbdc_mapping_bup-bdc_field,
        lv_input TYPE string.

  CLEAR: cv_value, cv_applied, cv_message.
  cv_ok = abap_true.
  cv_value = iv_value.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_field.
  lv_input = iv_value.
  CONDENSE lv_input.
  IF lv_field IS INITIAL OR lv_input IS INITIAL.
    RETURN.
  ENDIF.

  READ TABLE gt_cache INTO ls_cache
    WITH KEY bdc_field = lv_field
             input     = lv_input
             langu     = sy-langu.
  IF sy-subrc = 0.
    cv_value   = ls_cache-output.
    cv_applied = ls_cache-applied.
    cv_ok      = ls_cache-ok.
    cv_message = ls_cache-message.
    RETURN.
  ENDIF.

  PERFORM gui_value_to_bdc_key
    USING    lv_field lv_input
    CHANGING cv_value cv_applied cv_ok cv_message.

  CLEAR ls_cache.
  ls_cache-bdc_field = lv_field.
  ls_cache-input     = lv_input.
  ls_cache-langu     = sy-langu.
  ls_cache-output    = cv_value.
  ls_cache-applied   = cv_applied.
  ls_cache-ok        = cv_ok.
  ls_cache-message   = cv_message.
  APPEND ls_cache TO gt_cache.

 "Bound the cache per ABAP internal session. Clearing is safer than allowing
 "unbounded growth during very large multi-profile runs.
  IF lines( gt_cache ) > 5000.
    REFRESH gt_cache.
    APPEND ls_cache TO gt_cache.
  ENDIF.
ENDFORM.

FORM dynamic_key_exists
  USING    iv_tabname TYPE tabname
           iv_field   TYPE fieldname
           iv_value   TYPE any
  CHANGING cv_exists  TYPE abap_bool.

  DATA: lv_tab    TYPE tabname,
        lv_field  TYPE fieldname,
        lv_value  TYPE string,
        lv_where  TYPE string,
        lv_count  TYPE i.

  CLEAR cv_exists.
  lv_tab   = iv_tabname.
  lv_field = iv_field.
  lv_value = iv_value.
  TRANSLATE: lv_tab TO UPPER CASE, lv_field TO UPPER CASE.
  CONDENSE: lv_tab NO-GAPS, lv_field NO-GAPS, lv_value.
  IF lv_tab IS INITIAL OR lv_field IS INITIAL OR lv_value IS INITIAL.
    RETURN.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '''' IN lv_value WITH ''''''.
  lv_where = |{ lv_field } = '{ lv_value }'|.
  TRY.
      SELECT COUNT( * ) FROM (lv_tab)
        INTO lv_count
        WHERE (lv_where).
      IF lv_count > 0.
        cv_exists = abap_true.
      ENDIF.
    CATCH cx_sy_dynamic_osql_semantics
          cx_sy_dynamic_osql_syntax
          cx_sy_open_sql_db.
      CLEAR cv_exists.
  ENDTRY.
ENDFORM.

FORM format_contract_value
  USING    iv_bdc_field     TYPE any
           iv_value         TYPE any
           iv_value_kind    TYPE any
           iv_source_column TYPE any
           iv_format_policy TYPE any
           iv_pad_length    TYPE any
           iv_pad_char      TYPE any
           iv_conv_exit     TYPE any
  CHANGING cv_value         TYPE bdcdata-fval
           cv_ok            TYPE abap_bool
           cv_message       TYPE string.

  DATA: lv_input    TYPE string,
        lv_kind     TYPE string,
        lv_policy   TYPE string,
        lv_source   TYPE string,
        lv_pad_char TYPE string,
        lv_pad_len  TYPE i,
        lv_conv     TYPE string.

  lv_input = iv_value.
  CONDENSE lv_input.

  CLEAR: cv_value, cv_ok, cv_message.
  cv_value = lv_input.
  cv_ok    = abap_true.

  IF lv_input IS INITIAL.
    RETURN.
  ENDIF.

  lv_kind = iv_value_kind.
  TRANSLATE lv_kind TO UPPER CASE.
  CONDENSE lv_kind NO-GAPS.
  IF lv_kind IS INITIAL.
    lv_kind = gc_sem_raw.
  ENDIF.

  lv_policy = iv_format_policy.
  TRANSLATE lv_policy TO UPPER CASE.
  CONDENSE lv_policy NO-GAPS.
  IF lv_policy IS INITIAL.
    lv_policy = gc_fmt_none.
  ENDIF.

  lv_source = iv_source_column.
  IF lv_source IS INITIAL.
    lv_source = iv_bdc_field.
  ENDIF.

  lv_pad_char = iv_pad_char.
  CONDENSE lv_pad_char NO-GAPS.
  IF lv_pad_char IS INITIAL.
    lv_pad_char = '0'.
  ELSE.
    lv_pad_char = lv_pad_char+0(1).
  ENDIF.

  lv_conv = iv_conv_exit.
  TRANSLATE lv_conv TO UPPER CASE.
  CONDENSE lv_conv NO-GAPS.

  lv_pad_len = iv_pad_length.

  CASE lv_kind.
    WHEN gc_sem_skip_bdc.
      CLEAR cv_value.
      cv_ok = abap_true.
      RETURN.
    WHEN gc_sem_date.
      PERFORM date_to_external
        USING    lv_input iv_bdc_field
        CHANGING cv_value cv_ok cv_message.
      RETURN.
    WHEN gc_sem_quantity OR gc_sem_amount.
      PERFORM validate_numeric_external
        USING    lv_input lv_kind lv_source
        CHANGING cv_value cv_ok cv_message.
      RETURN.
    WHEN gc_sem_boolean.
      PERFORM format_boolean_external
        USING    lv_input lv_source
        CHANGING cv_value cv_ok cv_message.
      RETURN.
  ENDCASE.

  IF lv_policy = gc_fmt_none.
    DATA(lv_proof_value) = lv_input.
    DATA(lv_proof_ok)    = abap_false.
    PERFORM proof_based_code_candidate
      USING    iv_bdc_field lv_input
      CHANGING lv_proof_value lv_proof_ok.
    IF lv_proof_ok = abap_true.
      cv_value = lv_proof_value.
      cv_ok    = abap_true.
      RETURN.
    ENDIF.
  ENDIF.

  CASE lv_policy.
    WHEN gc_fmt_date.
      PERFORM date_to_external
        USING    lv_input iv_bdc_field
        CHANGING cv_value cv_ok cv_message.
    WHEN gc_fmt_number.
      PERFORM validate_numeric_external
        USING    lv_input lv_kind lv_source
        CHANGING cv_value cv_ok cv_message.
    WHEN gc_fmt_pad_left OR gc_fmt_alpha OR gc_fmt_ddic_code.
      PERFORM apply_left_pad_policy
        USING    lv_input lv_source lv_policy lv_pad_len lv_pad_char
        CHANGING cv_value cv_ok cv_message.
    WHEN gc_fmt_upper.
      cv_value = lv_input.
      TRANSLATE cv_value TO UPPER CASE.
      cv_ok = abap_true.
    WHEN OTHERS.
      cv_value = lv_input.
      cv_ok = abap_true.
  ENDCASE.
ENDFORM.

*& Proof-based DDIC code candidate formatter
*& Uses explicit SAP technical evidence only. It never checks TCODE,
*& source-column/header text or hardcoded business field names.

FORM proof_based_code_candidate
  USING    iv_bdc_field TYPE any
           iv_value     TYPE any
  CHANGING cv_value     TYPE string
           cv_applied   TYPE abap_bool.

  DATA: lv_input      TYPE string,
        lv_check      TYPE string,
        lv_bdc        TYPE zbdc_mapping_bup-bdc_field,
        lv_left       TYPE string,
        lv_right      TYPE string,
        lv_dummy      TYPE string,
        lv_tab        TYPE tabname,
        lv_field      TYPE fieldname,
        lv_datatype   TYPE string,
        lv_ddic_len   TYPE i,
        lv_conv_exit  TYPE string,
        lv_ddic_found TYPE abap_bool,
        lv_candidate  TYPE string,
        lv_exists     TYPE abap_bool.

  CLEAR cv_applied.
  cv_value = iv_value.
  lv_input = iv_value.
  CONDENSE lv_input NO-GAPS.
  IF lv_input IS INITIAL.
    RETURN.
  ENDIF.

  lv_check = lv_input.
  IF lv_check CN '0123456789'.
    RETURN.
  ENDIF.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_bdc.
  IF lv_bdc IS INITIAL OR lv_bdc NS '-'.
    RETURN.
  ENDIF.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_bdc WITH ''.
  IF lv_bdc CS '('.
    SPLIT lv_bdc AT '(' INTO lv_bdc lv_dummy.
  ENDIF.
  SPLIT lv_bdc AT '-' INTO lv_left lv_right.
  lv_tab   = lv_left.
  lv_field = lv_right.
  TRANSLATE: lv_tab TO UPPER CASE, lv_field TO UPPER CASE.
  CONDENSE: lv_tab NO-GAPS, lv_field NO-GAPS.

  PERFORM get_ddic_runtime_traits
    USING    iv_bdc_field
    CHANGING lv_datatype lv_ddic_len lv_conv_exit lv_ddic_found.
  IF lv_ddic_found <> abap_true.
    RETURN.
  ENDIF.

  TRANSLATE: lv_datatype TO UPPER CASE, lv_conv_exit TO UPPER CASE.
  CONDENSE: lv_datatype NO-GAPS, lv_conv_exit NO-GAPS.

  IF lv_conv_exit IS NOT INITIAL OR lv_datatype = 'NUMC'.
    RETURN. "Handled by explicit formatter paths.
  ENDIF.

  IF lv_datatype <> 'CHAR' OR lv_ddic_len <= 1 OR lv_ddic_len > 10.
    RETURN. "Composite/search/super fields and free text stay raw.
  ENDIF.

  IF strlen( lv_input ) >= lv_ddic_len.
    RETURN.
  ENDIF.

  lv_candidate = lv_input.
  WHILE strlen( lv_candidate ) < lv_ddic_len.
    CONCATENATE '0' lv_candidate INTO lv_candidate.
  ENDWHILE.

  PERFORM ddic_value_exists
    USING    lv_tab lv_field lv_candidate
    CHANGING lv_exists.

  IF lv_exists = abap_true.
    cv_value   = lv_candidate.
    cv_applied = abap_true.
  ENDIF.

ENDFORM.

FORM ddic_value_exists
  USING    iv_tabname TYPE tabname
           iv_field   TYPE fieldname
           iv_value   TYPE any
  CHANGING cv_exists  TYPE abap_bool.

  DATA: lv_value      TYPE string,
        lv_tab        TYPE tabname,
        lv_field      TYPE fieldname,
        lv_dom        TYPE dd01l-domname,
        lv_checktable TYPE tabname,
        lt_dfies      TYPE STANDARD TABLE OF dfies,
        ls_dfies      TYPE dfies,
        lt_dd03       TYPE STANDARD TABLE OF dd03l,
        ls_dd03       TYPE dd03l,
        lv_found      TYPE abap_bool,
        lv_domvalue   TYPE dd07l-domvalue_l.

  CLEAR cv_exists.
  lv_tab   = iv_tabname.
  lv_field = iv_field.
  lv_value = iv_value.
  TRANSLATE: lv_tab TO UPPER CASE, lv_field TO UPPER CASE.
  CONDENSE: lv_tab NO-GAPS, lv_field NO-GAPS, lv_value NO-GAPS.

  IF lv_tab IS INITIAL OR lv_field IS INITIAL OR lv_value IS INITIAL.
    RETURN.
  ENDIF.
  IF lv_value CN '0123456789'.
    RETURN.
  ENDIF.

  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_tab
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_dfies
    EXCEPTIONS
      OTHERS         = 1.
  IF sy-subrc = 0.
    READ TABLE lt_dfies INTO ls_dfies WITH KEY fieldname = lv_field.
    IF sy-subrc = 0.
      lv_dom        = ls_dfies-domname.
      lv_checktable = ls_dfies-checktable.
    ENDIF.
  ENDIF.

  IF lv_dom IS NOT INITIAL.
    SELECT SINGLE domvalue_l
      FROM dd07l
      INTO lv_domvalue
      WHERE domname    = lv_dom
        AND as4local   = 'A'
        AND as4vers    = '0000'
        AND domvalue_l = lv_value.
    IF sy-subrc = 0.
      cv_exists = abap_true.
      RETURN.
    ENDIF.
  ENDIF.

  IF lv_checktable IS NOT INITIAL.
    PERFORM table_field_value_exists
      USING    lv_checktable lv_field lv_value
      CHANGING lv_found.
    IF lv_found = abap_true.
      cv_exists = abap_true.
      RETURN.
    ENDIF.
  ENDIF.

  REFRESH lt_dd03.
  SELECT *
    FROM dd03l
    INTO TABLE lt_dd03
    UP TO 20 ROWS
    WHERE fieldname = lv_field
      AND as4local  = 'A'
      AND as4vers   = '0000'
      AND keyflag   = 'X'.

  LOOP AT lt_dd03 INTO ls_dd03.
    IF ls_dd03-tabname IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM table_field_value_exists
      USING    ls_dd03-tabname ls_dd03-fieldname lv_value
      CHANGING lv_found.
    IF lv_found = abap_true.
      cv_exists = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.

ENDFORM.

FORM table_field_value_exists
  USING    iv_tabname TYPE tabname
           iv_field   TYPE fieldname
           iv_value   TYPE any
  CHANGING cv_exists  TYPE abap_bool.

  DATA: lv_tab    TYPE tabname,
        lv_field  TYPE fieldname,
        lv_value  TYPE string,
        lv_where  TYPE string,
        lv_count  TYPE i.

  CLEAR cv_exists.
  lv_tab   = iv_tabname.
  lv_field = iv_field.
  lv_value = iv_value.
  TRANSLATE: lv_tab TO UPPER CASE, lv_field TO UPPER CASE.
  CONDENSE: lv_tab NO-GAPS, lv_field NO-GAPS, lv_value NO-GAPS.

  IF lv_tab IS INITIAL OR lv_field IS INITIAL OR lv_value IS INITIAL.
    RETURN.
  ENDIF.
  IF lv_value CN '0123456789'.
    RETURN.
  ENDIF.

  lv_where = |{ lv_field } = '{ lv_value }'|.

  TRY.
      SELECT COUNT( * )
        FROM (lv_tab)
        INTO lv_count
        WHERE (lv_where).
      IF sy-subrc = 0 AND lv_count > 0.
        cv_exists = abap_true.
      ENDIF.
    CATCH cx_sy_dynamic_osql_semantics cx_sy_dynamic_osql_syntax cx_sy_open_sql_db.
      CLEAR cv_exists.
  ENDTRY.

ENDFORM.

FORM apply_left_pad_policy
  USING    iv_value         TYPE any
           iv_field_label   TYPE any
           iv_policy        TYPE any
           iv_pad_length    TYPE any
           iv_pad_char      TYPE any
  CHANGING cv_value         TYPE bdcdata-fval
           cv_ok            TYPE abap_bool
           cv_message       TYPE string.

  DATA: lv_value    TYPE string,
        lv_check    TYPE string,
        lv_label    TYPE string,
        lv_policy   TYPE string,
        lv_pad_char TYPE string,
        lv_pad_len  TYPE i.

  CLEAR: cv_value, cv_ok, cv_message.
  lv_value = iv_value.
  CONDENSE lv_value.
  cv_value = lv_value.

  IF lv_value IS INITIAL.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  lv_policy = iv_policy.
  TRANSLATE lv_policy TO UPPER CASE.
  CONDENSE lv_policy NO-GAPS.
  lv_label = iv_field_label.
  lv_pad_len = iv_pad_length.
  lv_pad_char = iv_pad_char.
  CONDENSE lv_pad_char NO-GAPS.
  IF lv_pad_char IS INITIAL.
    lv_pad_char = '0'.
  ELSE.
    lv_pad_char = lv_pad_char+0(1).
  ENDIF.

  IF lv_pad_len <= 0.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  IF strlen( lv_value ) > lv_pad_len.
    cv_message =
      |Value "{ lv_value }" for { lv_label } is longer than configured length { lv_pad_len }.|.
    RETURN.
  ENDIF.

  lv_check = lv_value.
  CONDENSE lv_check NO-GAPS.

  IF lv_check CO '0123456789'.
    WHILE strlen( lv_value ) < lv_pad_len.
      CONCATENATE lv_pad_char lv_value INTO lv_value.
    ENDWHILE.
    cv_value = lv_value.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  cv_value = lv_value.
  cv_ok = abap_true.
ENDFORM.

FORM validate_numeric_external
  USING    iv_value       TYPE any
           iv_value_kind  TYPE any
           iv_field_label TYPE any
  CHANGING cv_value       TYPE bdcdata-fval
           cv_ok          TYPE abap_bool
           cv_message     TYPE string.

  DATA: lv_value TYPE string,
        lv_check TYPE string,
        lv_kind  TYPE string,
        lv_label TYPE string.

  lv_value = iv_value.
  CONDENSE lv_value.
  CLEAR: cv_value, cv_ok, cv_message.
  cv_value = lv_value.

  IF lv_value IS INITIAL.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  lv_check = lv_value.
  REPLACE ALL OCCURRENCES OF '.' IN lv_check WITH ''.
  REPLACE ALL OCCURRENCES OF ',' IN lv_check WITH ''.
  REPLACE ALL OCCURRENCES OF '-' IN lv_check WITH ''.
  REPLACE ALL OCCURRENCES OF '+' IN lv_check WITH ''.
 "Do not use REPLACE ... OF space against STRING; SAP can treat it
 "as a zero-length pattern and dump with REPLACE_INFINITE_LOOP.
 "CONDENSE NO-GAPS safely removes blanks before numeric validation.
  CONDENSE lv_check NO-GAPS.

  IF lv_check IS INITIAL OR lv_check CO '0123456789'.
    cv_ok = abap_true.
  ELSE.
    lv_kind  = iv_value_kind.
    lv_label = iv_field_label.
    cv_message =
      |Invalid { lv_kind } value "{ lv_value }" for { lv_label }.|.
  ENDIF.
ENDFORM.

FORM format_boolean_external
  USING    iv_value       TYPE any
           iv_field_label TYPE any
  CHANGING cv_value       TYPE bdcdata-fval
           cv_ok          TYPE abap_bool
           cv_message     TYPE string.

  DATA: lv_value TYPE string,
        lv_upper TYPE string,
        lv_label TYPE string.

  lv_value = iv_value.
  CONDENSE lv_value.
  CLEAR: cv_value, cv_ok, cv_message.
  lv_upper = lv_value.
  TRANSLATE lv_upper TO UPPER CASE.
  CONDENSE lv_upper NO-GAPS.

  CASE lv_upper.
    WHEN 'X' OR '1' OR 'TRUE' OR 'YES' OR 'Y'.
      cv_value = 'X'.
      cv_ok    = abap_true.
    WHEN '0' OR 'FALSE' OR 'NO' OR 'N'.
      CLEAR cv_value.
      cv_ok = abap_true.
    WHEN OTHERS.
      lv_label = iv_field_label.
      cv_message =
        |Invalid BOOLEAN value "{ lv_value }" for { lv_label }. Use X/blank, true/false or yes/no.|.
  ENDCASE.
ENDFORM.

*& Generic Trace token helper shared by builder/verifier

*& Strong screen-date literal evidence

*& Some dynpro helper structures expose a formatted date as CHAR rather than
*& DDIC DATS (for example a screen-only display/input helper). A DDIC-only
*& transient classifier therefore misses a real SAP-generated date default
*& and an old IGNORE contract can omit the field completely. Detect only
*& strong, separator-based calendar literals here; no field/table/TCODE name
*& or business vocabulary is inspected.

*& Re-emit a runtime date in the exact recorded screen shape

*& /Generic transient SAP-default guard

*& DATS/TIMS remains the strongest proof. additionally accepts a
*& nontechnical unmapped screen value only when the recorded literal itself
*& is an unambiguous formatted calendar date. This covers CHAR-based dynpro
*& helper dates without hardcoding application fields.

*& /Runtime rebase for SAP-derived date defaults

*& The recorded screen literal remains immutable evidence. At runtime, move
*& a transient date to the current SAP date while preserving a trustworthy
*& positive relative offset. Negative offsets caused by importing/publishing
*& old evidence later are NOT preserved. Re-emit using the exact recorded
*& screen date shape before falling back to the SAP user's external format.

*& EXEC FIDELITY - exact SHDB row -> BDCDATA

*& Runtime rule:
*& SHDB row order/program/dynpro/field/value is authoritative.
*& Technical BDC controls are always replayed exactly as recorded.
*& A nontechnical row is replaced only when an exact Mapping binding exists.
*& VALUE_TYPE/IGNORE/UNRESOLVED compiler metadata never deletes a recorded row.
*& No DDIC/date/code formatting, no GUI value-help conversion, no fallback
*& to another runtime value. Uploaded value is passed to SAP exactly as read.
*& Only explicit generic table-index tokens &IDX& and (*) are substituted.

FORM exec_apply_idx_token
  USING    iv_value TYPE any
           iv_idx   TYPE any
  CHANGING cv_value TYPE any.

  DATA: lv_text TYPE string,
        lv_idx  TYPE string,
        lv_rep  TYPE string.

  lv_text = iv_value.
  lv_idx  = iv_idx.
  CONDENSE lv_idx NO-GAPS.
  IF lv_idx IS INITIAL.
    lv_idx = '01'.
  ELSEIF strlen( lv_idx ) = 1.
    lv_idx = '0' && lv_idx.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '&IDX&' IN lv_text WITH lv_idx.
  lv_rep = '(' && lv_idx && ')'.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_text WITH lv_rep.

  cv_value = lv_text.
ENDFORM.

*& SAP-GENERATED SEMANTICS - mapping-driven physical index substitution

FORM indexed_from_map
  USING    iv_recorded TYPE any
           pt_map      TYPE ty_t_map
           pv_idx      TYPE any
  CHANGING cv_value    TYPE any
           cv_changed  TYPE abap_bool.

  DATA: lv_rec        TYPE zbdc_mapping_bup-bdc_field,
        lv_rec_log    TYPE zbdc_mapping_bup-bdc_field,
        lv_map        TYPE zbdc_mapping_bup-bdc_field,
        lv_map_log    TYPE zbdc_mapping_bup-bdc_field,
        lv_pattern    TYPE string,
        ls_map        TYPE zbdc_mapping_bup.

  CLEAR cv_changed.
  cv_value = iv_recorded.

  lv_rec = iv_recorded.
  PERFORM normalize_mapping_bdc_field
    USING    lv_rec
    CHANGING lv_rec.
  PERFORM logical_bdc_key
    USING    lv_rec
    CHANGING lv_rec_log.
  IF lv_rec_log IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_map INTO ls_map WHERE bdc_field IS NOT INITIAL.
    lv_pattern = ls_map-bdc_field.
    IF lv_pattern NS '(*)' AND lv_pattern NS '&IDX&'.
      CONTINUE.
    ENDIF.

    lv_map = ls_map-bdc_field.
    PERFORM normalize_mapping_bdc_field
      USING    lv_map
      CHANGING lv_map.
    PERFORM logical_bdc_key
      USING    lv_map
      CHANGING lv_map_log.

    IF lv_map_log = lv_rec_log.
      lv_pattern = ls_map-bdc_field.
      PERFORM exec_apply_idx_token
        USING    lv_pattern pv_idx
        CHANGING lv_pattern.
      cv_value = lv_pattern.
      cv_changed = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Exact Mapping occurrence binding

*& Mapping identifies a business field, but a raw SHDB recording may contain
*& the same FNAM more than once. Runtime must never replace every logical
*& occurrence just because the FNAM matches. Resolve one exact STEP_SEQ:
*& 1) persisted Mapping-STEP_SEQ when that optional DDIC column exists,
*& 2) one unique RAW SOURCE_COLUMN occurrence,
*& 3) one unique RAW occurrence whose recorded FVAL equals current staging,
*& 4) the only RAW occurrence of that logical field.
*& Anything still ambiguous is blocked instead of guessed.

FORM get_map_step
  USING    ps_map  TYPE zbdc_mapping_bup
  CHANGING cv_step TYPE zbdc_sct_ver_bup-step_seq
           cv_has  TYPE abap_bool.

  DATA lv_text TYPE string.
  FIELD-SYMBOLS <lv_step> TYPE any.

  CLEAR: cv_step, cv_has.
  ASSIGN COMPONENT 'STEP_SEQ' OF STRUCTURE ps_map TO <lv_step>.
  IF sy-subrc <> 0 OR <lv_step> IS NOT ASSIGNED.
    RETURN.
  ENDIF.

  lv_text = <lv_step>.
  CONDENSE lv_text NO-GAPS.
  IF lv_text IS INITIAL OR lv_text CN '0123456789'.
    RETURN.
  ENDIF.

  cv_step = lv_text.
  IF cv_step IS NOT INITIAL.
    cv_has = abap_true.
  ENDIF.
ENDFORM.

*& Strict runtime guard for fixed-length DDIC code values

*& EXTRACT_DOCUMENT_NUMBER - resolve object id from normalized result data

*& Generic unique source-column resolver

*& Stable professional neutral headers
*& A friendly SOURCE_COLUMN is taken only from approved metadata or DDIC.
*& When SAP exposes only an internal screen component, the template uses
*& INPUT_<normalized BDC field>. This is deterministic, collision-safe and
*& honest: the engine never invents business meaning from a TCODE/value.

*& Persist/annotate mapping row with derived rule when DDIC columns
*& exist. No-op on older DDIC because set_optional_comp is component-safe.

FORM der_fmt_contract
  USING    iv_bdc_field     TYPE any
  CHANGING cv_value_kind    TYPE string
           cv_push_policy   TYPE string
           cv_format_policy TYPE string
           cv_pad_length    TYPE i
           cv_pad_char      TYPE string
           cv_conv_exit     TYPE string
           cv_ddic_length   TYPE i.

  DATA: lv_datatype   TYPE string,
        lv_ddic_len   TYPE i,
        lv_ddic_conv  TYPE string,
        lv_ddic_found TYPE abap_bool,
        lv_code_pf    TYPE abap_bool.

  CLEAR: cv_value_kind, cv_push_policy, cv_format_policy,
         cv_pad_length, cv_pad_char, cv_conv_exit, cv_ddic_length.

  cv_push_policy = gc_push_push.
  cv_pad_char    = '0'.

  PERFORM get_ddic_runtime_traits
    USING    iv_bdc_field
    CHANGING lv_datatype lv_ddic_len lv_ddic_conv lv_ddic_found.
  PERFORM ddic_code_proof
    USING    iv_bdc_field
    CHANGING lv_code_pf.

  cv_ddic_length = lv_ddic_len.
  cv_conv_exit   = lv_ddic_conv.
  TRANSLATE: lv_datatype TO UPPER CASE, cv_conv_exit TO UPPER CASE.
  CONDENSE: lv_datatype NO-GAPS, cv_conv_exit NO-GAPS.

  CASE lv_datatype.
    WHEN 'DATS'.
      cv_value_kind    = gc_sem_date.
      cv_format_policy = gc_fmt_date.
    WHEN 'QUAN'.
      cv_value_kind    = gc_sem_quantity.
      cv_format_policy = gc_fmt_number.
    WHEN 'CURR'.
      cv_value_kind    = gc_sem_amount.
      cv_format_policy = gc_fmt_number.
    WHEN 'CUKY'.
      cv_value_kind    = gc_sem_currency.
      cv_format_policy = gc_fmt_none.
    WHEN 'UNIT'.
      cv_value_kind    = gc_sem_unit.
      cv_format_policy = gc_fmt_none.
    WHEN 'NUMC'.
      cv_value_kind    = gc_sem_category.
      cv_format_policy = gc_fmt_pad_left.
      cv_pad_length    = lv_ddic_len.
    WHEN OTHERS.
      cv_value_kind    = gc_sem_raw.
      cv_format_policy = gc_fmt_none.
  ENDCASE.

  IF cv_conv_exit = 'ALPHA'.
    cv_value_kind    = gc_sem_category.
    cv_format_policy = gc_fmt_alpha.
    cv_pad_length    = lv_ddic_len.
  ENDIF.

 "CONFIG may suggest a fixed-code rule only when SAP DDIC proves the
 "field is a code by conversion exit, NUMC, check table or fixed domain
 "values. No TCODE/source-column/header text is used.
  IF cv_format_policy = gc_fmt_none
     AND lv_datatype = 'CHAR'
     AND lv_ddic_len > 0
     AND lv_code_pf = abap_true.
    cv_value_kind    = gc_sem_category.
    cv_format_policy = gc_fmt_ddic_code.
    cv_pad_length    = lv_ddic_len.
  ENDIF.
ENDFORM.

FORM apply_fmt_contract
  CHANGING cs_map TYPE zbdc_mapping_bup.

  DATA: lv_value_kind    TYPE string,
        lv_push_policy   TYPE string,
        lv_format_policy TYPE string,
        lv_pad_length    TYPE i,
        lv_pad_char      TYPE string,
        lv_conv_exit     TYPE string,
        lv_ddic_length   TYPE i,
        lv_len_text      TYPE string.

  PERFORM der_fmt_contract
    USING    cs_map-bdc_field
    CHANGING lv_value_kind lv_push_policy
             lv_format_policy lv_pad_length lv_pad_char
             lv_conv_exit lv_ddic_length.

  IF lv_value_kind IS NOT INITIAL.
    PERFORM set_optional_comp USING 'VALUE_KIND' lv_value_kind CHANGING cs_map.
  ENDIF.
  IF lv_push_policy IS NOT INITIAL.
    PERFORM set_optional_comp USING 'PUSH_POLICY' lv_push_policy CHANGING cs_map.
  ENDIF.
  IF lv_format_policy IS NOT INITIAL.
    PERFORM set_optional_comp USING 'FORMAT_POLICY' lv_format_policy CHANGING cs_map.
  ENDIF.
  IF lv_pad_length > 0.
    lv_len_text = lv_pad_length.
    CONDENSE lv_len_text NO-GAPS.
    PERFORM set_optional_comp USING 'PAD_LENGTH' lv_len_text CHANGING cs_map.
    PERFORM set_optional_comp USING 'TARGET_LENGTH' lv_len_text CHANGING cs_map.
  ENDIF.
  IF lv_pad_char IS NOT INITIAL.
    PERFORM set_optional_comp USING 'PAD_CHAR' lv_pad_char CHANGING cs_map.
  ENDIF.
  IF lv_conv_exit IS NOT INITIAL.
    PERFORM set_optional_comp USING 'CONVERSION_EXIT' lv_conv_exit CHANGING cs_map.
    PERFORM set_optional_comp USING 'CONV_EXIT' lv_conv_exit CHANGING cs_map.
  ENDIF.
ENDFORM.

FORM unique_source
  USING    iv_bdc      TYPE zbdc_mapping_bup-bdc_field
           iv_example  TYPE any
           pt_meta     TYPE ty_t_map_meta
           pt_used     TYPE ty_t_source_used
  CHANGING cv_source   TYPE zbdc_mapping_bup-source_column
           cv_ok       TYPE abap_bool.

  DATA: ls_meta       TYPE ty_map_meta,
        lv_meta_found TYPE abap_bool,
        lv_label      TYPE string,
        lv_rule       TYPE string,
        lv_datatype   TYPE dfies-datatype,
        lv_length     TYPE dfies-leng,
        lv_ddic_found TYPE abap_bool,
        lv_technical  TYPE abap_bool.

  FIELD-SYMBOLS <lv_used> TYPE any.

  CLEAR: cv_source, cv_ok.

 "1. Exact approved/registry metadata is authoritative.
  PERFORM find_mapping_metadata
    USING    pt_meta iv_bdc space space
    CHANGING ls_meta lv_meta_found.
  IF lv_meta_found = abap_true
     AND ls_meta-source_column IS NOT INITIAL.
    cv_source = ls_meta-source_column.
  ENDIF.

 "2. Otherwise use a genuine DDIC label. Do not use the leaf name as if
 "it were a proven business label when DDIC lookup did not succeed.
  IF cv_source IS INITIAL.
    PERFORM get_ddic_field_traits
      USING    iv_bdc iv_example
      CHANGING cv_source lv_label lv_rule lv_datatype lv_length lv_ddic_found.
    IF lv_ddic_found <> abap_true OR lv_label IS INITIAL.
      CLEAR cv_source.
    ENDIF.
  ENDIF.

  PERFORM normalize_mapping_source
    USING    cv_source
    CHANGING cv_source.
  PERFORM mapping_source_is_technical
    USING    cv_source iv_bdc
    CHANGING lv_technical.

 "3. Unknown, technical-looking or colliding names are not promoted
 "to INPUT_<SAP_FIELD>. makes this fail-closed: the field stays
 "unresolved/candidate until a generated-program record name, Field Guide,
 "or locked Mapping Contract gives it a stable business source.
  READ TABLE pt_used ASSIGNING <lv_used>
    WITH KEY table_line = cv_source.
  IF cv_source IS INITIAL OR lv_technical = abap_true OR sy-subrc = 0.
    CLEAR cv_source.
    RETURN.
  ENDIF.

  IF cv_source IS INITIAL.
    RETURN.
  ENDIF.

  READ TABLE pt_used ASSIGNING <lv_used>
    WITH KEY table_line = cv_source.
  IF sy-subrc = 0.
 "A hash-stable neutral name should not collide. Fail closed if table
 "length/custom DDIC changes still produce a duplicate.
    CLEAR cv_source.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

*& Generic temporal-value evidence
*& Detects common external date/time representations without referencing
*& a TCODE or business field name. This supplements incomplete screen-DDIC
*& metadata for indexed date/time inputs.

*& Generic SHDB helper/transient-screen classification

*& Principle:
*& A recorded physical BDC field is NOT automatically a business input.
*& Search-help/calendar/system-dialog helper values must never leak into
*& Mapping/Template merely because SHDB recorded a value.
*& Helper rows remain STATIC so the original replay path is preserved.
*& Value-carrying helper interactions are fail-closed for automatic
*& onboarding unless a future certified provenance contract resolves them.

*& No transaction code or application business field is hardcoded here.

FORM helper_program_role
  USING    iv_program TYPE any
  CHANGING cv_helper  TYPE abap_bool
           cv_sensitive TYPE abap_bool.

  DATA lv_program TYPE string.

  CLEAR: cv_helper, cv_sensitive.
  lv_program = iv_program.
  TRANSLATE lv_program TO UPPER CASE.
  CONDENSE lv_program NO-GAPS.
  IF lv_program IS INITIAL.
    RETURN.
  ENDIF.

 "SAP generic search-help / calendar infrastructure.
  IF lv_program CP 'SAPLSH*'
     OR lv_program CP 'SAPLSDH*'.
    cv_helper = abap_true.
    cv_sensitive = abap_true.
    RETURN.
  ENDIF.

 "Generic system/menu/confirmation dialogs are transient controls. Their
 "non-BDC values must not become upload columns, but replay may still need
 "the recorded constants.
  IF lv_program CP 'SAPMSSY*'
     OR lv_program CP 'SAPLSPO*'.
    cv_helper = abap_true.
    CLEAR cv_sensitive.
  ENDIF.
ENDFORM.

FORM field_helper_role
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_helper TYPE abap_bool
           cv_unsafe TYPE abap_bool
           cv_reason TYPE string.

  DATA: ls_script       TYPE ty_script_def_compat,
        lv_target       TYPE zbdc_mapping_bup-bdc_field,
        lv_norm         TYPE zbdc_mapping_bup-bdc_field,
        lv_program      TYPE sy-repid,
        lv_prog_helper  TYPE abap_bool,
        lv_prog_sensitive TYPE abap_bool,
        lv_seen_helper  TYPE abap_bool,
        lv_seen_main    TYPE abap_bool,
        lv_value        TYPE string.

  CLEAR: cv_helper, cv_unsafe, cv_reason.
  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

 "Helper role is derived from the owning dynpro program family, not from
 "application field names. This keeps the classifier independent of any
 "previously seen transaction or recorded business field.

  CLEAR lv_program.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_program = ls_script-program_name.
      CONTINUE.
    ENDIF.
    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm <> lv_target.
      CONTINUE.
    ENDIF.

    CLEAR: lv_prog_helper, lv_prog_sensitive.
    PERFORM helper_program_role
      USING    lv_program
      CHANGING lv_prog_helper lv_prog_sensitive.

    IF lv_prog_helper = abap_true.
      lv_seen_helper = abap_true.
      lv_value = ls_script-static_value.
      CONDENSE lv_value.
      IF lv_value IS NOT INITIAL
         AND lv_prog_sensitive = abap_true.
        cv_unsafe = abap_true.
      ENDIF.
    ELSE.
      lv_seen_main = abap_true.
    ENDIF.
  ENDLOOP.

 "A field that also exists on a normal transaction screen is not hidden
 "only because one occurrence was echoed by a helper dialog.
  IF lv_seen_helper = abap_true AND lv_seen_main IS INITIAL.
    cv_helper = abap_true.
    IF cv_unsafe = abap_true.
      cv_reason = 'VALUE_CARRYING_TRANSIENT_HELPER'.
    ELSE.
      cv_reason = 'TRANSIENT_HELPER_CONTROL'.
    ENDIF.
  ELSE.
    CLEAR: cv_helper, cv_unsafe, cv_reason.
  ENDIF.
ENDFORM.

*& Direct business-input evidence

*& A new un-certified field is eligible for automatic DYNAMIC exposure only
*& when SHDB proves direct edit context. Strong evidence is a cursor target or
*& table-control input. DDIC fields on the same normal screen as a non-helper
*& cursor target are accepted as contextual peers. Everything else stays
*& UNRESOLVED instead of becoming an invented INPUT_* column.

FORM field_business_evidence
  USING    pt_script    TYPE ty_t_script
           iv_field     TYPE any
           iv_ddic_found TYPE abap_bool
  CHANGING cv_evidence  TYPE abap_bool
           cv_reason    TYPE string.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor      TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_screen_seq  TYPE i,
        lv_helper      TYPE abap_bool,
        lv_unsafe      TYPE abap_bool,
        lv_helper_reason TYPE string.

  DATA lt_target_screens TYPE SORTED TABLE OF i WITH UNIQUE KEY table_line.

  CLEAR: cv_evidence, cv_reason.
  PERFORM normalize_mapping_bdc_field USING iv_field CHANGING lv_target.
  PERFORM logical_bdc_key USING lv_target CHANGING lv_target_key.
  IF lv_target IS INITIAL OR lv_target_key IS INITIAL.
    RETURN.
  ENDIF.

 "Pass 1: locate screens containing this logical field and detect indexed
 "table-control evidence.
  CLEAR lv_screen_seq.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_screen_seq = ls_script-step_seq.
      CONTINUE.
    ENDIF.
    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_bdc_field USING ls_script-field_name CHANGING lv_norm.
    PERFORM logical_bdc_key USING lv_norm CHANGING lv_cursor_key.
    IF lv_cursor_key <> lv_target_key.
      CONTINUE.
    ENDIF.
    IF lv_screen_seq > 0.
      INSERT lv_screen_seq INTO TABLE lt_target_screens.
    ENDIF.
    IF ls_script-field_name CS '(' AND ls_script-field_name CS ')'.
      cv_evidence = abap_true.
      cv_reason = 'INDEXED_DIRECT_INPUT'.
      RETURN.
    ENDIF.
  ENDLOOP.

 "Pass 2: exact BDC_CURSOR target is strong direct evidence. For other DDIC
 "fields, a normal screen with a non-helper cursor target is contextual input
 "evidence because SHDB submitted the fields together at that PAI boundary.
  CLEAR lv_screen_seq.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_screen_seq = ls_script-step_seq.
      CONTINUE.
    ENDIF.
    IF ls_script-field_name <> 'BDC_CURSOR'.
      CONTINUE.
    ENDIF.
    READ TABLE lt_target_screens WITH TABLE KEY table_line = lv_screen_seq
      TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field USING ls_script-static_value CHANGING lv_cursor.
    IF lv_cursor IS INITIAL.
      CONTINUE.
    ENDIF.
    CLEAR: lv_helper, lv_unsafe, lv_helper_reason.
    PERFORM field_helper_role
      USING    pt_script lv_cursor
      CHANGING lv_helper lv_unsafe lv_helper_reason.
    IF lv_helper = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key USING lv_cursor CHANGING lv_cursor_key.
    IF lv_cursor_key = lv_target_key.
      cv_evidence = abap_true.
      cv_reason = 'DIRECT_CURSOR_INPUT'.
      RETURN.
    ENDIF.

    IF iv_ddic_found = abap_true.
      cv_evidence = abap_true.
      cv_reason = 'DDIC_SCREEN_INPUT_PEER'.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Proof-based boolean/flag classification

*& A recorded literal X/0/1 is not enough to decide that a field is a
*& disposable UI flag. SAP uses boolean-like fields both for business
*& decisions and for transient screen selections.

*& Generic proof hierarchy:
*& Direct cursor on the same logical field -> DYNAMIC
*& Same normal screen has a non-helper cursor AND at least
*& two valued non-boolean DDIC peers -> DYNAMIC
*& Indexed boolean on an otherwise selection/control-only
*& screen -> STATIC
*& Anything else -> UNRESOLVED

*& STATIC preserves exact replay but never exposes the field to Template.
*& UNRESOLVED blocks onboarding instead of silently guessing.
*& No TCODE or application field is hardcoded.

FORM flag_field_role
  USING    pt_script      TYPE ty_t_script
           iv_field       TYPE any
           iv_ddic_found  TYPE abap_bool
  CHANGING cv_dynamic     TYPE abap_bool
           cv_static      TYPE abap_bool
           cv_reason      TYPE string.

  DATA: ls_script        TYPE ty_script_def_compat,
        lv_target        TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_norm          TYPE zbdc_mapping_bup-bdc_field,
        lv_key           TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor        TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_screen_seq    TYPE i,
        lv_on_target_scr TYPE abap_bool,
        lv_indexed       TYPE abap_bool,
        lv_nonhelper_cursor TYPE abap_bool,
        lv_business_peer_count TYPE i,
        lv_cursor_indexed TYPE abap_bool,
        lv_same_struct_cursor TYPE abap_bool,
        lv_target_struct TYPE string,
        lv_cursor_struct TYPE string,
        lv_helper        TYPE abap_bool,
        lv_unsafe        TYPE abap_bool,
        lv_helper_reason TYPE string,
        lv_peer_source   TYPE zbdc_mapping_bup-source_column,
        lv_peer_label    TYPE string,
        lv_peer_rule     TYPE string,
        lv_peer_datatype TYPE dfies-datatype,
        lv_peer_length   TYPE dfies-leng,
        lv_peer_ddic     TYPE abap_bool,
        lv_value         TYPE string.

  DATA: lt_target_screens TYPE SORTED TABLE OF i WITH UNIQUE KEY table_line,
        lt_business_peers TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                            WITH UNIQUE KEY table_line.

  CLEAR: cv_dynamic, cv_static, cv_reason.
  IF iv_ddic_found <> abap_true.
    cv_reason = 'BOOLEAN_WITHOUT_DDIC_PROOF'.
    RETURN.
  ENDIF.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target IS INITIAL OR lv_target_key IS INITIAL.
    cv_reason = 'BOOLEAN_WITHOUT_LOGICAL_KEY'.
    RETURN.
  ENDIF.

  lv_target_struct = lv_target.
  IF lv_target_struct CS '-'.
    SPLIT lv_target_struct AT '-' INTO lv_target_struct lv_value.
  ENDIF.

 "Pass 1: identify every screen carrying this logical field.
  CLEAR lv_screen_seq.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_screen_seq = ls_script-step_seq.
      CONTINUE.
    ENDIF.
    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key <> lv_target_key.
      CONTINUE.
    ENDIF.
    IF lv_screen_seq > 0.
      INSERT lv_screen_seq INTO TABLE lt_target_screens.
    ENDIF.
    IF ls_script-field_name CS '(' AND ls_script-field_name CS ')'.
      lv_indexed = abap_true.
    ENDIF.
  ENDLOOP.

 "Pass 2: prove whether the boolean belongs to a business-entry screen.
  CLEAR lv_screen_seq.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_screen_seq = ls_script-step_seq.
      CLEAR lv_on_target_scr.
      READ TABLE lt_target_screens
        WITH TABLE KEY table_line = lv_screen_seq
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        lv_on_target_scr = abap_true.
      ENDIF.
      CONTINUE.
    ENDIF.
    IF lv_on_target_scr <> abap_true
       OR ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name = 'BDC_CURSOR'.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-static_value
        CHANGING lv_cursor.
      IF lv_cursor IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR: lv_helper, lv_unsafe, lv_helper_reason.
      PERFORM field_helper_role
        USING    pt_script lv_cursor
        CHANGING lv_helper lv_unsafe lv_helper_reason.
      IF lv_helper = abap_true.
        CONTINUE.
      ENDIF.

      lv_nonhelper_cursor = abap_true.
      CLEAR: lv_cursor_indexed, lv_same_struct_cursor, lv_cursor_struct.
      IF ls_script-static_value CS '(' AND ls_script-static_value CS ')'.
        lv_cursor_indexed = abap_true.
      ENDIF.
      lv_cursor_struct = lv_cursor.
      IF lv_cursor_struct CS '-'.
        SPLIT lv_cursor_struct AT '-' INTO lv_cursor_struct lv_value.
      ENDIF.
      IF lv_target_struct IS NOT INITIAL
         AND lv_cursor_struct = lv_target_struct.
        lv_same_struct_cursor = abap_true.
      ENDIF.

      PERFORM logical_bdc_key
        USING    lv_cursor
        CHANGING lv_cursor_key.
      IF lv_cursor_key = lv_target_key.
        cv_dynamic = abap_true.
        cv_reason = 'BOOLEAN_DIRECT_CURSOR_INPUT'.
        RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name CP 'BDC_*'
       OR ls_script-field_name CP 'DYN_*'.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key = lv_target_key.
      CONTINUE.
    ENDIF.

    lv_value = ls_script-static_value.
    CONDENSE lv_value.
    IF lv_value IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_helper, lv_unsafe, lv_helper_reason.
    PERFORM field_helper_role
      USING    pt_script lv_norm
      CHANGING lv_helper lv_unsafe lv_helper_reason.
    IF lv_helper = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR: lv_peer_source, lv_peer_label, lv_peer_rule,
           lv_peer_datatype, lv_peer_length, lv_peer_ddic.
    PERFORM get_ddic_field_traits
      USING    lv_norm lv_value
      CHANGING lv_peer_source
               lv_peer_label
               lv_peer_rule
               lv_peer_datatype
               lv_peer_length
               lv_peer_ddic.
    IF lv_peer_ddic <> abap_true.
      CONTINUE.
    ENDIF.

    TRANSLATE lv_value TO UPPER CASE.
    CONDENSE lv_value NO-GAPS.
    IF lv_value <> 'X'
       AND lv_value <> '0'
       AND lv_value <> '1'.
      INSERT lv_key INTO TABLE lt_business_peers.
    ENDIF.
  ENDLOOP.

  DESCRIBE TABLE lt_business_peers LINES lv_business_peer_count.

 "Require a business-rich screen, not just one arbitrary text/display peer.
 "Two valued non-boolean DDIC peers plus a normal cursor is conservative
 "evidence that the checkbox belongs to the business-entry payload.
  IF lv_nonhelper_cursor = abap_true
     AND lv_business_peer_count >= 2.
    cv_dynamic = abap_true.
    cv_reason = 'BOOLEAN_BUSINESS_SCREEN_PEER'.
    RETURN.
  ENDIF.

 "Indexed checkbox/radio on an otherwise control-only screen is replay
 "state. Keep STATIC rather than IGNORE so the SHDB path remains lossless.
  IF lv_indexed = abap_true
     AND lv_business_peer_count = 0
     AND lv_nonhelper_cursor = abap_true
     AND lv_cursor_indexed = abap_true
     AND lv_same_struct_cursor = abap_true.
    cv_static = abap_true.
    cv_reason = 'BOOLEAN_SELECTION_CONTROL_STATIC'.
    RETURN.
  ENDIF.

  cv_reason = 'BOOLEAN_AMBIGUOUS'.
ENDFORM.

*& Generic execution-first structural field classifier

*& This classifier never branches by TCODE or application field name.
*& It uses only evidence contained in the imported SHDB script plus DDIC:
*& exact/direct cursor or indexed edit evidence;
*& LOW/HIGH pair structure on the same submitted flow;
*& repeated non-DDIC carried state with one immutable recorded value;
*& otherwise any non-helper value-bearing BDC field remains safely
*& parameterizable through an honest neutral INPUT_<technical field> name.

*& The exact physical BDC path is always preserved. Semantic uncertainty is
*& not treated as execution ambiguity: unknown business meaning gets a neutral
*& source column instead of blocking a previously replayable SHDB recording.

FORM structural_field_role
  USING    pt_script     TYPE ty_t_script
           iv_field      TYPE any
           is_stats      TYPE ty_shdb_field_stats
  CHANGING cv_dynamic    TYPE abap_bool
           cv_static     TYPE abap_bool
           cv_reason     TYPE string.

  DATA: ls_script        TYPE ty_script_def_compat,
        lv_target        TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_norm          TYPE zbdc_mapping_bup-bdc_field,
        lv_key           TYPE zbdc_mapping_bup-bdc_field,
        lv_screen_seq    TYPE i,
        lv_cursor        TYPE zbdc_mapping_bup-bdc_field,
        lv_helper        TYPE abap_bool,
        lv_unsafe        TYPE abap_bool,
        lv_helper_reason TYPE string,
        lv_direct        TYPE abap_bool,
        lv_direct_reason TYPE string,
        lv_context_cursor TYPE abap_bool,
        lv_pair_found    TYPE abap_bool,
        lv_prefix        TYPE string,
        lv_leaf          TYPE string,
        lv_peer          TYPE string,
        lv_peer_norm     TYPE zbdc_mapping_bup-bdc_field.

  DATA lt_target_screens TYPE SORTED TABLE OF i WITH UNIQUE KEY table_line.

  CLEAR: cv_dynamic, cv_static, cv_reason.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target IS INITIAL OR lv_target_key IS INITIAL.
    cv_reason = 'NO_LOGICAL_FIELD'.
    RETURN.
  ENDIF.

 "Strong edit evidence from the generic SHDB flow remains authoritative.
  CLEAR: lv_direct, lv_direct_reason.
  PERFORM field_business_evidence
    USING    pt_script lv_target abap_false
    CHANGING lv_direct lv_direct_reason.
  IF lv_direct = abap_true.
    cv_dynamic = abap_true.
    cv_reason = lv_direct_reason.
    RETURN.
  ENDIF.

 "Collect every screen that physically submits this logical field.
  CLEAR lv_screen_seq.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_screen_seq = ls_script-step_seq.
      CONTINUE.
    ENDIF.
    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key = lv_target_key AND lv_screen_seq > 0.
      INSERT lv_screen_seq INTO TABLE lt_target_screens.
    ENDIF.
  ENDLOOP.

 "Generic select-option/range evidence: STRUCT-LOW and STRUCT-HIGH are a
 "pair only when the counterpart is physically submitted in the recording.
  lv_peer = lv_target_key.
  IF lv_peer CS '-'.
    SPLIT lv_peer AT '-' INTO lv_prefix lv_leaf.
    CLEAR lv_peer.
    TRANSLATE lv_leaf TO UPPER CASE.
    IF lv_leaf = 'LOW'.
      lv_peer = lv_prefix && '-HIGH'.
    ELSEIF lv_leaf = 'HIGH'.
      lv_peer = lv_prefix && '-LOW'.
    ENDIF.
  ENDIF.

  IF lv_peer IS NOT INITIAL.
    LOOP AT pt_script INTO ls_script
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-field_name
        CHANGING lv_peer_norm.
      PERFORM logical_bdc_key
        USING    lv_peer_norm
        CHANGING lv_key.
      IF lv_key = lv_peer.
        lv_pair_found = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.
    IF lv_pair_found = abap_true.
      cv_dynamic = abap_true.
      cv_reason = 'STRUCTURAL_RANGE_PAIR'.
      RETURN.
    ENDIF.
  ENDIF.

 "A non-helper cursor anywhere on a target screen proves a submitted PAI
 "context. DDIC lookup is not required: generated/custom screen structures
 "are valid BDC inputs and receive neutral headers when semantics are unknown.
  CLEAR lv_screen_seq.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_screen_seq = ls_script-step_seq.
      CONTINUE.
    ENDIF.
    IF ls_script-field_name <> 'BDC_CURSOR'.
      CONTINUE.
    ENDIF.
    READ TABLE lt_target_screens
      WITH TABLE KEY table_line = lv_screen_seq
      TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-static_value
      CHANGING lv_cursor.
    IF lv_cursor IS INITIAL.
      CONTINUE.
    ENDIF.
    CLEAR: lv_helper, lv_unsafe, lv_helper_reason.
    PERFORM field_helper_role
      USING    pt_script lv_cursor
      CHANGING lv_helper lv_unsafe lv_helper_reason.
    IF lv_helper <> abap_true.
      lv_context_cursor = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

 "Stable carried-state proof. Structural only, never application-specific:
 "a non-DDIC, non-indexed, never-cursor field echoed at least three times
 "with one immutable value is preserved STATIC.
  IF is_stats-occurrences >= 3
     AND is_stats-distinct_values = 1
     AND is_stats-cursor_target <> abap_true
     AND is_stats-indexed_field <> abap_true
     AND is_stats-ddic_found <> abap_true.
    cv_static = abap_true.
    cv_reason = 'STABLE_CARRIED_STATE'.
    RETURN.
  ENDIF.

 "fields merely submitted by the dynpro are not proven user
 "inputs. Preserve them as STATIC replay values, but do not let them
 "become template headers or scenario identity. Direct cursor/index and
 "LOW/HIGH evidence were already handled above.
  IF lv_context_cursor = abap_true.
    cv_static = abap_true.
    cv_reason = 'SUBMITTED_SCREEN_VALUE_STATIC'.
    RETURN.
  ENDIF.

  IF is_stats-ddic_found = abap_true OR is_stats-indexed_field = abap_true.
    cv_static = abap_true.
    cv_reason = 'RECORDED_PARAMETERIZABLE_STATIC'.
    RETURN.
  ENDIF.

  IF is_stats-distinct_values > 0.
    cv_static = abap_true.
    cv_reason = 'NEUTRAL_RECORDED_INPUT_STATIC'.
    RETURN.
  ENDIF.

  cv_static = abap_true.
  cv_reason = 'NO_OVERRIDABLE_VALUE'.
ENDFORM.

*& Generic helper provenance / recording-completeness gate

*& Goal:
*& Keep execution-first classification for every TCODE.
*& Never hardcode a transaction code or application business field.
*& A sensitive helper/search/calendar episode may keep its exact replay
*& values STATIC, but automatic Template generation is allowed only when
*& the episode has stable evidence of a non-helper DYNAMIC binding.
*& This prevents an incomplete recording from becoming a seemingly valid
*& one-column/two-column template merely because one unrelated field (for
*& example a document type) was parameterizable.

*& Generic provenance evidence accepted:
*& 1) helper value correlates with a DYNAMIC value on the normal screen
*& immediately before/after the helper episode; OR
*& 2) a DYNAMIC field is newly submitted / changed on the return screen.

*& Generic helper-payload evidence:
*& helper cursor targets the valued field; OR
*& indexed helper input / LOW-HIGH range input; OR
*& two or more distinct valued fields exist in the sensitive helper
*& episode (calendar/search structures commonly behave this way); OR
*& a single valued helper field contains non-numeric text.

*& Pure technical BDC_* / DYN_* controls remain excluded by the existing
*& technical-field classifier. No semantic meaning is invented here.

FORM helper_provenance_gate
  USING    pt_script    TYPE ty_t_script
  CHANGING cv_ok        TYPE abap_bool
           cv_gap_count TYPE i
           cv_message   TYPE string.

  TYPES: BEGIN OF ty_z65_screen,
           screen_seq TYPE i,
           program    TYPE sy-repid,
           dynpro     TYPE c LENGTH 4,
           helper     TYPE abap_bool,
           sensitive  TYPE abap_bool,
         END OF ty_z65_screen.

  TYPES: BEGIN OF ty_z65_value,
           screen_seq TYPE i,
           bdc_field  TYPE zbdc_mapping_bup-bdc_field,
           logical_key TYPE zbdc_mapping_bup-bdc_field,
           value      TYPE string,
           value_type TYPE zbdc_sct_ver_bup-value_type,
         END OF ty_z65_value.

  TYPES: BEGIN OF ty_z65_cursor,
           screen_seq TYPE i,
           logical_key TYPE zbdc_mapping_bup-bdc_field,
         END OF ty_z65_cursor.

  DATA: lt_screens TYPE STANDARD TABLE OF ty_z65_screen WITH DEFAULT KEY,
        lt_helper_values TYPE STANDARD TABLE OF ty_z65_value WITH DEFAULT KEY,
        lt_normal_values TYPE STANDARD TABLE OF ty_z65_value WITH DEFAULT KEY,
        lt_helper_cursors TYPE STANDARD TABLE OF ty_z65_cursor WITH DEFAULT KEY.

  DATA: ls_script TYPE ty_script_def_compat,
        ls_screen TYPE ty_z65_screen,
        ls_hval   TYPE ty_z65_value,
        ls_nval   TYPE ty_z65_value,
        ls_prev   TYPE ty_z65_value,
        ls_cur    TYPE ty_z65_value,
        ls_cursor TYPE ty_z65_cursor.

  DATA: lv_screen_seq TYPE i,
        lv_program    TYPE sy-repid,
        lv_dynpro     TYPE c LENGTH 4,
        lv_helper     TYPE abap_bool,
        lv_sensitive  TYPE abap_bool,
        lv_technical  TYPE abap_bool,
        lv_norm       TYPE zbdc_mapping_bup-bdc_field,
        lv_key        TYPE zbdc_mapping_bup-bdc_field,
        lv_value      TYPE string,
        lv_cursor     TYPE zbdc_mapping_bup-bdc_field,
        lv_in_episode TYPE abap_bool,
        lv_ep_first   TYPE i,
        lv_ep_last    TYPE i,
        lv_ep_prev    TYPE i,
        lv_ep_next    TYPE i,
        lv_last_normal TYPE i,
        lv_payload    TYPE abap_bool,
        lv_resolved   TYPE abap_bool,
        lv_distinct_fields TYPE i,
        lv_text_value TYPE string,
        lv_first_field TYPE zbdc_mapping_bup-bdc_field,
        lv_first_program TYPE sy-repid,
        lv_first_dynpro TYPE c LENGTH 4,
        lv_gap_list   TYPE string.

  DATA: lt_ep_fields TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                       WITH UNIQUE KEY table_line.

  CLEAR: cv_ok, cv_gap_count, cv_message.

 " Pass 1 - materialize a generic screen/value model from the
 " already parsed SHDB contract. No TCODE/application literal.

  CLEAR: lv_screen_seq, lv_program, lv_dynpro, lv_helper, lv_sensitive.

  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = abap_true.
      lv_screen_seq = ls_script-step_seq.
      lv_program    = ls_script-program_name.
      lv_dynpro     = ls_script-dynpro_no.

      CLEAR: lv_helper, lv_sensitive.
      PERFORM helper_program_role
        USING    lv_program
        CHANGING lv_helper lv_sensitive.

      CLEAR ls_screen.
      ls_screen-screen_seq = lv_screen_seq.
      ls_screen-program    = lv_program.
      ls_screen-dynpro     = lv_dynpro.
      ls_screen-helper     = lv_helper.
      ls_screen-sensitive  = lv_sensitive.
      APPEND ls_screen TO lt_screens.
      CONTINUE.
    ENDIF.

    IF lv_screen_seq IS INITIAL OR ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name = 'BDC_CURSOR'.
      IF lv_sensitive = abap_true.
        CLEAR: lv_cursor, lv_key.
        PERFORM normalize_mapping_bdc_field
          USING    ls_script-static_value
          CHANGING lv_cursor.
        PERFORM logical_bdc_key
          USING    lv_cursor
          CHANGING lv_key.
        IF lv_key IS NOT INITIAL.
          CLEAR ls_cursor.
          ls_cursor-screen_seq  = lv_screen_seq.
          ls_cursor-logical_key = lv_key.
          APPEND ls_cursor TO lt_helper_cursors.
        ENDIF.
      ENDIF.
      CONTINUE.
    ENDIF.

    CLEAR lv_technical.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    lv_value = ls_script-static_value.
    CONDENSE lv_value.
    IF lv_value IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_norm, lv_key.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_norm IS INITIAL OR lv_key IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_nval.
    ls_nval-screen_seq  = lv_screen_seq.
    ls_nval-bdc_field   = lv_norm.
    ls_nval-logical_key = lv_key.
    ls_nval-value       = lv_value.
    ls_nval-value_type  = ls_script-value_type.

    IF lv_sensitive = abap_true.
      APPEND ls_nval TO lt_helper_values.
    ELSEIF lv_helper <> abap_true.
      APPEND ls_nval TO lt_normal_values.
    ENDIF.
  ENDLOOP.

 " Pass 2 - evaluate each sensitive helper episode between two
 " normal transaction screens.

  CLEAR: lv_in_episode, lv_ep_first, lv_ep_last,
         lv_ep_prev, lv_ep_next, lv_last_normal.

  LOOP AT lt_screens INTO ls_screen.

    IF ls_screen-helper = abap_true.
      IF ls_screen-sensitive = abap_true.
        IF lv_in_episode <> abap_true.
          lv_in_episode = abap_true.
          lv_ep_first   = ls_screen-screen_seq.
          lv_ep_prev    = lv_last_normal.
        ENDIF.
        lv_ep_last = ls_screen-screen_seq.
      ELSEIF lv_in_episode = abap_true.
 "System/menu helper screens belong to the same helper episode.
        lv_ep_last = ls_screen-screen_seq.
      ENDIF.
      CONTINUE.
    ENDIF.

 "A normal transaction screen closes the preceding helper episode.
    IF lv_in_episode = abap_true.
      lv_ep_next = ls_screen-screen_seq.

      CLEAR: lv_payload, lv_resolved, lv_distinct_fields,
             lv_first_field, lv_first_program, lv_first_dynpro.
      REFRESH lt_ep_fields.

 " 2A - Is this helper episode carrying probable user input?

      LOOP AT lt_helper_values INTO ls_hval
        WHERE screen_seq >= lv_ep_first
          AND screen_seq <= lv_ep_last.

        INSERT ls_hval-bdc_field INTO TABLE lt_ep_fields.

        IF lv_first_field IS INITIAL.
          lv_first_field = ls_hval-bdc_field.
        ENDIF.

 "Indexed/range structures are generic input evidence.
        IF ls_hval-bdc_field CS '(*)'
           OR ls_hval-logical_key CP '*-LOW'
           OR ls_hval-logical_key CP '*-HIGH'.
          lv_payload = abap_true.
        ENDIF.

 "A valued helper field targeted by the helper cursor is direct
 "interaction evidence without knowing its business meaning.
        LOOP AT lt_helper_cursors INTO ls_cursor
          WHERE screen_seq >= lv_ep_first
            AND screen_seq <= lv_ep_last.
          IF ls_cursor-logical_key = ls_hval-logical_key.
            lv_payload = abap_true.
            EXIT.
          ENDIF.
        ENDLOOP.

 "Single free-text helper values are likely entered search/input
 "payload. Numeric-only singleton values are not enough by themselves
 "because helper infrastructure often carries limits/counters.
        lv_text_value = ls_hval-value.
        TRANSLATE lv_text_value TO UPPER CASE.
        IF lv_text_value CA 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.
          lv_payload = abap_true.
        ENDIF.
      ENDLOOP.

      DESCRIBE TABLE lt_ep_fields LINES lv_distinct_fields.
      IF lv_distinct_fields >= 2.
        lv_payload = abap_true.
      ENDIF.

 "Get one helper screen identity for a useful generic error message.
      LOOP AT lt_screens INTO DATA(ls_ep_screen)
        WHERE screen_seq >= lv_ep_first
          AND screen_seq <= lv_ep_last
          AND sensitive = abap_true.
        lv_first_program = ls_ep_screen-program.
        lv_first_dynpro  = ls_ep_screen-dynpro.
        EXIT.
      ENDLOOP.

 " 2B - Provenance correlation against surrounding normal
 " screens. Only DYNAMIC non-helper values can prove a stable
 " business/template binding.

      IF lv_payload = abap_true.

 "Direct value correlation on the screen before/after the helper.
        LOOP AT lt_helper_values INTO ls_hval
          WHERE screen_seq >= lv_ep_first
            AND screen_seq <= lv_ep_last.

          LOOP AT lt_normal_values INTO ls_nval
            WHERE value_type = gc_vt_dynamic.
            IF ls_nval-screen_seq <> lv_ep_prev
               AND ls_nval-screen_seq <> lv_ep_next.
              CONTINUE.
            ENDIF.

            IF ls_hval-value = ls_nval-value.
              lv_resolved = abap_true.
              EXIT.
            ENDIF.

            IF strlen( ls_hval-value ) >= 6
               AND ls_nval-value CS ls_hval-value.
              lv_resolved = abap_true.
              EXIT.
            ENDIF.

            IF strlen( ls_nval-value ) >= 6
               AND ls_hval-value CS ls_nval-value.
              lv_resolved = abap_true.
              EXIT.
            ENDIF.
          ENDLOOP.

          IF lv_resolved = abap_true.
            EXIT.
          ENDIF.
        ENDLOOP.

 "A newly submitted or changed DYNAMIC value on the return screen
 "is also generic proof that the helper episode resolved into a
 "stable non-helper binding, even when search text != returned key.
        IF lv_resolved <> abap_true AND lv_ep_next > 0.
          LOOP AT lt_normal_values INTO ls_cur
            WHERE screen_seq = lv_ep_next
              AND value_type = gc_vt_dynamic.

            CLEAR ls_prev.
            READ TABLE lt_normal_values INTO ls_prev
              WITH KEY screen_seq  = lv_ep_prev
                       logical_key = ls_cur-logical_key.

            IF sy-subrc <> 0 OR ls_prev-value <> ls_cur-value.
              lv_resolved = abap_true.
              EXIT.
            ENDIF.
          ENDLOOP.
        ENDIF.

        IF lv_resolved <> abap_true.
          cv_gap_count = cv_gap_count + 1.
          IF lv_gap_list IS INITIAL.
            lv_gap_list = |{ lv_first_program }/{ lv_first_dynpro } { lv_first_field }|.
          ELSEIF cv_gap_count <= 3.
            lv_gap_list = lv_gap_list &&
              |; { lv_first_program }/{ lv_first_dynpro } { lv_first_field }|.
          ENDIF.
        ENDIF.
      ENDIF.

      CLEAR: lv_in_episode, lv_ep_first, lv_ep_last,
             lv_ep_prev, lv_ep_next.
    ENDIF.

    lv_last_normal = ls_screen-screen_seq.
  ENDLOOP.

 "A sensitive helper episode at end-of-recording has no return binding.
  IF lv_in_episode = abap_true.
    CLEAR: lv_payload, lv_distinct_fields, lv_first_field,
           lv_first_program, lv_first_dynpro.
    REFRESH lt_ep_fields.

    LOOP AT lt_helper_values INTO ls_hval
      WHERE screen_seq >= lv_ep_first
        AND screen_seq <= lv_ep_last.
      INSERT ls_hval-bdc_field INTO TABLE lt_ep_fields.
      IF lv_first_field IS INITIAL.
        lv_first_field = ls_hval-bdc_field.
      ENDIF.
      lv_text_value = ls_hval-value.
      TRANSLATE lv_text_value TO UPPER CASE.
      IF ls_hval-bdc_field CS '(*)'
         OR ls_hval-logical_key CP '*-LOW'
         OR ls_hval-logical_key CP '*-HIGH'
         OR lv_text_value CA 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.
        lv_payload = abap_true.
      ENDIF.
    ENDLOOP.

    DESCRIBE TABLE lt_ep_fields LINES lv_distinct_fields.
    IF lv_distinct_fields >= 2.
      lv_payload = abap_true.
    ENDIF.

    IF lv_payload = abap_true.
      LOOP AT lt_screens INTO DATA(ls_last_ep_screen)
        WHERE screen_seq >= lv_ep_first
          AND screen_seq <= lv_ep_last
          AND sensitive = abap_true.
        lv_first_program = ls_last_ep_screen-program.
        lv_first_dynpro  = ls_last_ep_screen-dynpro.
        EXIT.
      ENDLOOP.
      cv_gap_count = cv_gap_count + 1.
      IF lv_gap_list IS INITIAL.
        lv_gap_list = |{ lv_first_program }/{ lv_first_dynpro } { lv_first_field }|.
      ENDIF.
    ENDIF.
  ENDIF.

  IF cv_gap_count > 0.
    cv_message =
      |Automatic onboarding blocked: { cv_gap_count } sensitive helper episode(s) carry probable input but no stable non-helper DYNAMIC binding was captured.|.
    IF lv_gap_list IS NOT INITIAL.
      cv_message = cv_message && | Evidence: { lv_gap_list }.|.
    ENDIF.
    cv_message = cv_message &&
      ' Re-record with direct business-field entry; automatic Template generation was stopped safely.'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message = 'Helper provenance/completeness check passed.'.
ENDFORM.

*& Execution-safety + recording-completeness gate

*& Keeps generic execution-first behavior, but restores one missing
*& safety property: helper-only user input must not silently disappear from
*& Mapping/Template just because another unrelated field is DYNAMIC.

FORM semantic_contract_gate
  USING    pt_script TYPE ty_t_script
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_script        TYPE ty_script_def_compat,
        lv_norm          TYPE zbdc_mapping_bup-bdc_field,
        lv_key           TYPE zbdc_mapping_bup-bdc_field,
        lv_type          TYPE zbdc_sct_ver_bup-value_type,
        lv_helper        TYPE abap_bool,
        lv_unsafe        TYPE abap_bool,
        lv_reason        TYPE string,
        lv_dynamic       TYPE i,
        lv_helper_static TYPE i,
        lv_prov_ok       TYPE abap_bool,
        lv_prov_gaps     TYPE i,
        lv_prov_message  TYPE string.

  DATA: lt_dynamic TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                     WITH UNIQUE KEY table_line,
        lt_checked TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                     WITH UNIQUE KEY table_line.

  CLEAR: cv_ok, cv_message.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    IF ls_script-field_name CP 'BDC_*'
       OR ls_script-field_name CP 'DYN_*'.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_type = ls_script-value_type.
    TRANSLATE lv_type TO UPPER CASE.
    CONDENSE lv_type NO-GAPS.

    CLEAR: lv_helper, lv_unsafe, lv_reason.
    PERFORM field_helper_role
      USING    pt_script lv_norm
      CHANGING lv_helper lv_unsafe lv_reason.

 "Invariant 1: transient/helper infrastructure is never an upload column.
    IF lv_helper = abap_true AND lv_type = gc_vt_dynamic.
      cv_message =
        |Unsafe contract: transient helper { lv_norm } is exposed as a DYNAMIC upload field.|.
      RETURN.
    ENDIF.

    READ TABLE lt_checked
      WITH TABLE KEY table_line = lv_norm
      TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      INSERT lv_norm INTO TABLE lt_checked.
      IF lv_helper = abap_true
         AND lv_type = gc_vt_static
         AND ls_script-static_value IS NOT INITIAL.
        lv_helper_static = lv_helper_static + 1.
      ENDIF.
    ENDIF.

    IF lv_type <> gc_vt_dynamic.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key IS NOT INITIAL.
      INSERT lv_key INTO TABLE lt_dynamic.
    ENDIF.
  ENDLOOP.

  DESCRIBE TABLE lt_dynamic LINES lv_dynamic.
  IF lv_dynamic = 0.
    cv_message =
      'Automatic onboarding blocked: the recording contains no overridable non-technical BDC input.'.
    RETURN.
  ENDIF.

 "Invariant 2: sensitive helper input must have stable provenance into a
 "non-helper DYNAMIC binding. This is generic recording-completeness proof.
  CLEAR: lv_prov_ok, lv_prov_gaps, lv_prov_message.
  PERFORM helper_provenance_gate
    USING    pt_script
    CHANGING lv_prov_ok lv_prov_gaps lv_prov_message.
  IF lv_prov_ok <> abap_true.
    cv_message = lv_prov_message.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  IF lv_helper_static > 0.
    cv_message =
      |Execution-safe complete contract accepted: { lv_dynamic } overridable logical input(s); { lv_helper_static } transient/helper value(s) preserved STATIC.|.
  ELSE.
    cv_message =
      |Execution-safe complete contract accepted: { lv_dynamic } overridable logical input(s).|.
  ENDIF.
ENDFORM.

*& Single-recording automatic onboarding
*& One SHDB TXT is compiled into a generic execution-safe contract.
*& Exact certified/metadata decisions remain authoritative. Remaining
*& fields are classified from generic SHDB evidence only; no TCODE or
*& business-field literal is used. Runtime certification remains the
*& final gate before ACTIVE/CERTIFIED.

FORM single_class
  CHANGING ct_script     TYPE ty_t_script
           cv_complete   TYPE abap_bool
           cv_dynamic    TYPE i
           cv_static     TYPE i
           cv_unresolved TYPE i
           cv_ignored    TYPE i
           cv_message    TYPE string.

  DATA: lt_meta        TYPE ty_t_map_meta,
        lt_empty       TYPE ty_t_script,
        ls_script      TYPE ty_script_def_compat,
        ls_stats       TYPE ty_shdb_field_stats,
        lv_bdc         TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_type        TYPE zbdc_sct_ver_bup-value_type,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_source_ok   TYPE abap_bool,
        lv_technical   TYPE abap_bool,
        lv_helper      TYPE abap_bool,
        lv_helper_unsafe TYPE abap_bool,
        lv_helper_reason TYPE string,
        lv_flag_dynamic TYPE abap_bool,
        lv_flag_static TYPE abap_bool,
        lv_flag_reason TYPE string,
        lv_struct_dynamic TYPE abap_bool,
        lv_struct_static TYPE abap_bool,
        lv_struct_reason TYPE string,
        lv_semantic_ok TYPE abap_bool,
        lv_semantic_msg TYPE string,
        lv_ready       TYPE abap_bool,
        lv_ready_unres TYPE i,
        lv_ready_msg   TYPE string.

  DATA: lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                  WITH UNIQUE KEY table_line,
        lt_used TYPE ty_t_source_used.

  FIELD-SYMBOLS <ls_current> TYPE ty_script_def_compat.

  CLEAR: cv_complete, cv_dynamic, cv_static,
         cv_unresolved, cv_ignored, cv_message.

  IF gv_z133_origin = 'SHDB_TXT'
     OR gv_z133_origin = 'GUIDED_RECORD'.
    cv_message =
      'TXT_ONLY/GUIDED_ONLY evidence was saved for audit only. Official Mapping/Template/Execute requires SHDB Program/Transfer-from-Recording source or an already locked Mapping Contract.'.
    RETURN.
  ENDIF.

  PERFORM read_mapping_metadata
    USING    p_rec_tcode txtp_profile_name gv_profile_ver
    CHANGING lt_meta.

 "Certified/registry decisions remain authoritative. Reserve their
 "source columns before generating neutral names for a new scenario.
  LOOP AT ct_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    lv_type = ls_script-value_type.
    TRANSLATE lv_type TO UPPER CASE.
    CONDENSE lv_type NO-GAPS.
    IF lv_type = gc_vt_dynamic
       AND ls_script-source_column IS NOT INITIAL.
      lv_source = ls_script-source_column.
      PERFORM normalize_mapping_source
        USING    lv_source
        CHANGING lv_source.
      IF lv_source IS NOT INITIAL.
        INSERT lv_source INTO TABLE lt_used.
      ENDIF.
    ENDIF.
  ENDLOOP.

  LOOP AT ct_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    IF ls_script-field_name = 'BDC_CURSOR'.
      CONTINUE.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_bdc.
    IF lv_bdc IS INITIAL.
      CONTINUE.
    ENDIF.

    READ TABLE lt_seen WITH TABLE KEY table_line = lv_bdc
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT lv_bdc INTO TABLE lt_seen.

 "A decision inherited from an exact certified contract or explicit
 "registry metadata is never overwritten by automatic onboarding.
    lv_type = ls_script-value_type.
    TRANSLATE lv_type TO UPPER CASE.
    CONDENSE lv_type NO-GAPS.
    IF lv_type = gc_vt_dynamic
       OR lv_type = gc_vt_static
       OR lv_type = gc_m2_vt_ignore.
      CONTINUE.
    ENDIF.

    CLEAR: ls_stats, lv_source, lv_source_ok,
           lv_helper, lv_helper_unsafe, lv_helper_reason.
    PERFORM collect_shdb_field_stats
      USING    ct_script lt_empty lv_bdc
      CHANGING ls_stats.

 "execution-first classification. Exact certified metadata remains
 "authoritative above. New fields use generic SHDB structure/DDIC evidence;
 "no TCODE or application-field literal participates in the decision.
    PERFORM field_helper_role
      USING    ct_script lv_bdc
      CHANGING lv_helper lv_helper_unsafe lv_helper_reason.

    IF lv_helper = abap_true.
 "Transient/helper values remain exact replay state and never become
 "business-template columns. Empty infrastructure artifacts are IGNORE.
      IF ls_stats-distinct_values = 0.
        lv_type = gc_m2_vt_ignore.
      ELSE.
        lv_type = gc_vt_static.
      ENDIF.
      CLEAR lv_source.

    ELSEIF ls_stats-distinct_values = 0.
      lv_type = gc_m2_vt_ignore.
      CLEAR lv_source.

    ELSE.
      CLEAR: lv_struct_dynamic, lv_struct_static, lv_struct_reason,
             lv_flag_dynamic, lv_flag_static, lv_flag_reason.

 "Boolean-looking values use stricter proof first. If inconclusive they
 "fall through to the same structural classifier as every other field.
      IF ls_stats-flag_like = abap_true.
        PERFORM flag_field_role
          USING    ct_script lv_bdc ls_stats-ddic_found
          CHANGING lv_flag_dynamic lv_flag_static lv_flag_reason.
      ENDIF.

      IF lv_flag_dynamic = abap_true.
        lv_struct_dynamic = abap_true.
        lv_struct_reason = lv_flag_reason.
      ELSEIF lv_flag_static = abap_true.
        lv_struct_static = abap_true.
        lv_struct_reason = lv_flag_reason.
      ELSE.
        PERFORM structural_field_role
          USING    ct_script lv_bdc ls_stats
          CHANGING lv_struct_dynamic lv_struct_static lv_struct_reason.
      ENDIF.

      IF lv_struct_dynamic = abap_true.
        lv_type = gc_vt_dynamic.
        PERFORM unique_source
          USING    lv_bdc ls_stats-example_value lt_meta lt_used
          CHANGING lv_source lv_source_ok.
        IF lv_source_ok = abap_true.
          INSERT lv_source INTO TABLE lt_used.
        ELSE.
 "Source collision is a real contract ambiguity. This remains the
 "only automatic UNRESOLVED path; semantic uncertainty alone is not.
          lv_type = gc_m2_vt_unresolved.
          CLEAR lv_source.
        ENDIF.
      ELSE.
        lv_type = gc_vt_static.
        CLEAR lv_source.
      ENDIF.
    ENDIF.

    LOOP AT ct_script ASSIGNING <ls_current>
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    <ls_current>-field_name
        CHANGING lv_norm.
      IF lv_norm <> lv_bdc.
        CONTINUE.
      ENDIF.

      <ls_current>-value_type = lv_type.
      IF lv_type = gc_vt_dynamic.
        <ls_current>-source_column = lv_source.
      ELSE.
        CLEAR <ls_current>-source_column.
      ENDIF.
    ENDLOOP.
  ENDLOOP.

  PERFORM normalize_editor
    CHANGING ct_script lv_ready lv_ready_unres lv_ready_msg.
  IF lv_ready <> abap_true.
    cv_message = lv_ready_msg.
    RETURN.
  ENDIF.

  PERFORM count_states
    USING    ct_script
    CHANGING cv_dynamic cv_static cv_unresolved cv_ignored.
  IF cv_unresolved > 0.
    cv_message =
      |Automatic self-service compilation left { cv_unresolved } unresolved field(s).|.
    RETURN.
  ENDIF.

  PERFORM check_contract
    USING    ct_script
    CHANGING lv_ready lv_ready_unres lv_ready_msg.
  IF lv_ready <> abap_true.
    cv_message = lv_ready_msg.
    RETURN.
  ENDIF.

 "execution-safety gate. Semantic uncertainty no longer blocks an
 "exact physical BDC binding; only an unsafe DYNAMIC helper binding or a
 "contract with no overridable input is rejected.
  PERFORM semantic_contract_gate
    USING    ct_script
    CHANGING lv_semantic_ok lv_semantic_msg.
  IF lv_semantic_ok <> abap_true.
    cv_message = lv_semantic_msg.
    RETURN.
  ENDIF.

  cv_complete = abap_true.
  cv_message =
    |Self-service contract compiled: { cv_dynamic } overridable input(s), { cv_static } fixed control(s), { cv_ignored } ignored artifact(s).|.
ENDFORM.

*& Recorded default lookup for optional Excel overrides

FORM field_default_info
  USING    pt_script    TYPE ty_t_script
           iv_bdc_field TYPE any
  CHANGING cv_has_default TYPE abap_bool
           cv_default     TYPE string.

  DATA: ls_script TYPE ty_script_def_compat,
        lv_target TYPE zbdc_mapping_bup-bdc_field,
        lv_norm   TYPE zbdc_mapping_bup-bdc_field.

  CLEAR: cv_has_default, cv_default.
  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

 "SHDB sample values on DYNAMIC rows are examples entered
 "during recording; they are not SAP/system defaults. Treat only
 "STATIC/IGNORE evidence as default-like. This prevents the default
 "guard from hiding real end-user business inputs merely because the
 "recording contains a sample value.
    IF ls_script-value_type = gc_vt_dynamic.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm <> lv_target OR ls_script-static_value IS INITIAL.
      CONTINUE.
    ENDIF.

    cv_has_default = abap_true.
    IF cv_default IS INITIAL.
      cv_default = ls_script-static_value.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& /Automatic canonical profile resolution
*& Self-service rule:
*& The end user never chooses PROFILE_NAME or PROFILE_VER.
*& Import and Guided Recording share one normalized business identity.
*& Same TCODE may still have many independent, non-overlapping scenarios.
*& Exact executable steps remain immutable per Profile Version.

*& Canonical scenario identity

*& Scenario identity and executable contract identity are intentionally
*& separated:
*& Scenario identity: TCODE + normalized logical business-field set.
*& Executable contract identity: exact Program/Dynpro/OKCODE/step order,
*& already protected by contract_hash_from_script.

*& This keeps SHDB TXT Import and Guided Recording on the same profile when
*& they represent the same business inputs but SAP returns different recorder
*& screen noise, repeated dynpros or OKCODE paths.

FORM collect_scenario_fields
  USING    it_script TYPE ty_t_script
  CHANGING ct_fields TYPE ty_t_missing_bdc.

  DATA: ls_script        TYPE ty_script_def_compat,
        ls_peer_script   TYPE ty_script_def_compat,
        lv_technical     TYPE abap_bool,
        lv_peer_technical TYPE abap_bool,
        lv_helper        TYPE abap_bool,
        lv_helper_unsafe TYPE abap_bool,
        lv_helper_reason TYPE string,
        lv_norm          TYPE zbdc_mapping_bup-bdc_field,
        lv_peer_norm     TYPE zbdc_mapping_bup-bdc_field,
        lv_logical       TYPE zbdc_mapping_bup-bdc_field,
        lv_peer          TYPE zbdc_mapping_bup-bdc_field,
        lv_prefix        TYPE string,
        lv_leaf          TYPE string,
        lv_direct        TYPE abap_bool,
        lv_reason        TYPE string.

  REFRESH ct_fields.

  LOOP AT it_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR lv_norm.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_helper, lv_helper_unsafe, lv_helper_reason.
    PERFORM field_helper_role
      USING    it_script lv_norm
      CHANGING lv_helper lv_helper_unsafe lv_helper_reason.
    IF lv_helper = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR lv_logical.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      lv_logical = lv_norm.
    ENDIF.

 "scenario identity must not be every submitted dynpro value.
 "Use only strong structural evidence: direct cursor/index input or a
 "generic LOW/HIGH range pair. Screen-default noise therefore cannot
 "split Start Recording and SHDB TXT Import into different AUTO profiles.
    CLEAR: lv_direct, lv_reason.
    PERFORM field_business_evidence
      USING    it_script lv_norm abap_false
      CHANGING lv_direct lv_reason.
    IF lv_direct = abap_true.
      INSERT lv_logical INTO TABLE ct_fields.
      CONTINUE.
    ENDIF.

    CLEAR: lv_peer, lv_prefix, lv_leaf.
    IF lv_logical CS '-'.
      SPLIT lv_logical AT '-' INTO lv_prefix lv_leaf.
      TRANSLATE lv_leaf TO UPPER CASE.
      IF lv_leaf = 'LOW'.
        lv_peer = lv_prefix && '-HIGH'.
      ELSEIF lv_leaf = 'HIGH'.
        lv_peer = lv_prefix && '-LOW'.
      ENDIF.
    ENDIF.

    IF lv_peer IS INITIAL.
      CONTINUE.
    ENDIF.

    LOOP AT it_script INTO ls_peer_script
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.
      CLEAR lv_peer_technical.
      PERFORM mapping_field_is_technical
        USING    ls_peer_script-field_name
        CHANGING lv_peer_technical.
      IF lv_peer_technical = abap_true.
        CONTINUE.
      ENDIF.

      CLEAR lv_peer_norm.
      PERFORM normalize_mapping_bdc_field
        USING    ls_peer_script-field_name
        CHANGING lv_peer_norm.
      PERFORM logical_bdc_key
        USING    lv_peer_norm
        CHANGING lv_peer_norm.
      IF lv_peer_norm = lv_peer.
        INSERT lv_logical INTO TABLE ct_fields.
        EXIT.
      ENDIF.
    ENDLOOP.
  ENDLOOP.
ENDFORM.

FORM check_ref_completeness
  USING    it_incoming  TYPE ty_t_script
           it_reference TYPE ty_t_script
  CHANGING cv_complete  TYPE abap_bool
           cv_missing   TYPE i
           cv_list      TYPE string.

  DATA: lt_incoming  TYPE ty_t_missing_bdc,
        lt_required  TYPE ty_t_missing_bdc,
        lt_ref_all   TYPE ty_t_missing_bdc,
        ls_script    TYPE ty_script_def_compat,
        lv_type      TYPE zbdc_sct_ver_bup-value_type,
        lv_technical TYPE abap_bool,
        lv_norm      TYPE zbdc_mapping_bup-bdc_field,
        lv_logical   TYPE zbdc_mapping_bup-bdc_field,
        lv_field     TYPE zbdc_mapping_bup-bdc_field.

  CLEAR: cv_complete, cv_missing, cv_list.

  PERFORM collect_scenario_fields
    USING    it_incoming
    CHANGING lt_incoming.

  PERFORM collect_scenario_fields
    USING    it_reference
    CHANGING lt_ref_all.

 "completeness is a safety gate, not a template-field clone.
 "If the new evidence has enough canonical business fields to resolve the
 "same scenario, a missing reference-only field is treated as an optional
 "contract delta. This keeps TCODE onboarding generic: fields that are not
 "captured in the current SHDB/Guided recording are not forced into the
 "Business Input Contract merely because an older reference version had
 "them. Very small captures remain blocked below because they do not provide
 "enough evidence to create a safe changed contract.
  IF lines( lt_incoming ) >= gc_m2_scn_min_fields.
    cv_complete = abap_true.
    RETURN.
  ENDIF.

 "A previous executable contract is authoritative only for its overridable
 "logical inputs when the current capture is too small to stand alone.
 "Static navigation/helper evidence remains exact-version evidence and must
 "not be fabricated into a new capture.
  LOOP AT it_reference INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    lv_type = ls_script-value_type.
    TRANSLATE lv_type TO UPPER CASE.
    CONDENSE lv_type NO-GAPS.
    IF lv_type <> gc_vt_dynamic.
      CONTINUE.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR lv_norm.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR lv_logical.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      lv_logical = lv_norm.
    ENDIF.

    INSERT lv_logical INTO TABLE lt_required.
  ENDLOOP.

 "Legacy pre-classified versions may not yet contain DYNAMIC decisions.
 "if no explicit dynamic user-input requirement can be derived,
 "do not block the current recording by cloning the whole old field set.
 "The current SHDB evidence will build/review its own Business Input
 "Contract; runtime certification remains the separate execution gate.
  IF lt_required IS INITIAL.
    cv_complete = abap_true.
    RETURN.
  ENDIF.

  LOOP AT lt_required INTO lv_field.
    READ TABLE lt_incoming
      WITH TABLE KEY table_line = lv_field
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.

    cv_missing = cv_missing + 1.
    IF cv_missing <= 8.
      IF cv_list IS INITIAL.
        cv_list = lv_field.
      ELSE.
        cv_list = cv_list && ', ' && lv_field.
      ENDIF.
    ENDIF.
  ENDLOOP.

  IF cv_missing = 0.
    cv_complete = abap_true.
  ENDIF.
ENDFORM.

FORM script_fingerprint
  USING    iv_tcode  TYPE zbdc_prof_bup-tcode
           it_script TYPE ty_t_script
  CHANGING cv_fp     TYPE zbdc_script_bup-contract_hash
           cv_ok     TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_fields  TYPE ty_t_missing_bdc,
        lv_field   TYPE zbdc_mapping_bup-bdc_field,
        lv_payload TYPE string,
        lv_hash64  TYPE string.

  CLEAR: cv_fp, cv_ok, cv_message.

  IF iv_tcode IS INITIAL OR it_script IS INITIAL.
    cv_message = 'TCODE and parsed SHDB steps are required for scenario detection.'.
    RETURN.
  ENDIF.

  PERFORM collect_scenario_fields
    USING    it_script
    CHANGING lt_fields.

  IF lt_fields IS INITIAL.
    cv_message = 'No normalized business input was found for scenario detection.'.
    RETURN.
  ENDIF.

  lv_payload = |TCODE={ iv_tcode }|.
  LOOP AT lt_fields INTO lv_field.
    lv_payload = lv_payload &&
      cl_abap_char_utilities=>newline &&
      |F| && '|' && lv_field.
  ENDLOOP.

  TRY.
      cl_abap_message_digest=>calculate_hash_for_char(
        EXPORTING
          if_algorithm     = 'SHA-256'
          if_data          = lv_payload
        IMPORTING
          ef_hashb64string = lv_hash64 ).
    CATCH cx_abap_message_digest INTO DATA(lx_digest).
      cv_message = lx_digest->get_text( ).
      RETURN.
  ENDTRY.

  IF lv_hash64 IS INITIAL.
    cv_message = 'Scenario fingerprint could not be calculated.'.
    RETURN.
  ENDIF.

  cv_fp = lv_hash64.
  cv_ok = abap_true.
ENDFORM.

*& Version-neutral contract fingerprint
*& Purpose: compare recording evidence with an existing contract without
*& including PROFILE_VER. This prevents duplicate v0044/v0045
*& creation when multiple users import the same contract.

FORM script_contract_fp
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           it_script  TYPE ty_t_script
  CHANGING cv_fp      TYPE zbdc_script_bup-contract_hash
           cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_script TYPE ty_t_script,
        ls_script TYPE ty_script_def_compat,
        lv_payload TYPE string,
        lv_hash64 TYPE string,
        lv_field TYPE zbdc_mapping_bup-bdc_field,
        lv_program TYPE zbdc_sct_ver_bup-program_name,
        lv_dynpro TYPE zbdc_sct_ver_bup-dynpro_no,
        lv_ordinal TYPE i,
        lv_technical TYPE abap_bool,
        lv_sensitive TYPE abap_bool,
        lv_screen_helper TYPE abap_bool.

  CLEAR: cv_fp, cv_ok, cv_message.
  IF iv_tcode IS INITIAL OR it_script IS INITIAL.
    cv_message = 'TCODE and recording steps are required for contract fingerprinting.'.
    RETURN.
  ENDIF.

  lt_script = it_script.
  SORT lt_script BY step_seq program_name dynpro_no field_name.
  lv_payload = |TCODE={ iv_tcode }|.

  LOOP AT lt_script INTO ls_script.

    lv_program = ls_script-program_name.
    TRANSLATE lv_program TO UPPER CASE.
    CONDENSE lv_program NO-GAPS.

    lv_dynpro = ls_script-dynpro_no.
    CONDENSE lv_dynpro NO-GAPS.

    IF ls_script-is_new_screen = 'X'.
      CLEAR: lv_screen_helper, lv_sensitive.
      PERFORM helper_program_role
        USING    lv_program
        CHANGING lv_screen_helper lv_sensitive.
      IF lv_screen_helper = abap_true.
        CONTINUE.
      ENDIF.
    ELSEIF lv_screen_helper = abap_true.
      CONTINUE.
    ENDIF.

    lv_field = ls_script-field_name.
    IF lv_field IS NOT INITIAL.
      PERFORM mapping_field_is_technical
        USING    lv_field
        CHANGING lv_technical.
      IF lv_technical = abap_true.
        CONTINUE.
      ENDIF.
      PERFORM normalize_mapping_bdc_field USING lv_field CHANGING lv_field.
    ENDIF.

 "canonical technical contract fingerprint is idempotent across
 "Start Recording / SHDB TXT adapter noise. Helper screens and technical
 "BDC controls are filtered before ordinal assignment.
    lv_ordinal = lv_ordinal + 1.
    lv_payload = lv_payload && cl_abap_char_utilities=>newline &&
      |{ lv_ordinal }| && '|' &&
      |{ ls_script-is_new_screen }| && '|' &&
      |{ lv_program }| && '|' &&
      |{ lv_dynpro }| && '|' &&
      |{ lv_field }| && '|' &&
      |{ ls_script-static_value }|.
  ENDLOOP.

  TRY.
      cl_abap_message_digest=>calculate_hash_for_char(
        EXPORTING
          if_algorithm     = 'SHA-256'
          if_data          = lv_payload
        IMPORTING
          ef_hashb64string = lv_hash64 ).
    CATCH cx_abap_message_digest INTO DATA(lx_digest).
      cv_message = lx_digest->get_text( ).
      RETURN.
  ENDTRY.

  IF lv_hash64 IS INITIAL.
    cv_message = 'Version-neutral contract fingerprint could not be calculated.'.
    RETURN.
  ENDIF.

  cv_fp = lv_hash64.
  cv_ok = abap_true.
ENDFORM.

*& Optional evidence audit writer
*& ZBDC_EVID_BUP is optional and accessed dynamically so compiles
*& before the DDIC table is created. Contract processing never depends on
*& the audit table; if installed, every Import/Guided attempt is traceable.

FORM log_evidence
  USING    iv_tcode    TYPE zbdc_prof_bup-tcode
           iv_profile  TYPE zbdc_prof_bup-profile_name
           iv_ver      TYPE zbdc_prof_bup-profile_ver
           iv_origin   TYPE csequence
           iv_outcome  TYPE csequence
           iv_fp       TYPE zbdc_script_bup-contract_hash
           iv_missing  TYPE i
           iv_message  TYPE string.

  DATA: lv_exists TYPE abap_bool,
        lv_tabname TYPE tabname VALUE 'ZBDC_EVID_BUP',
        lv_uuid TYPE c LENGTH 32,
        lv_ts TYPE timestampl,
        lv_demo_date_836 TYPE sy-datum,
        lv_demo_time_836 TYPE sy-uzeit,
        lv_status TYPE c LENGTH 12,
        lr_evid TYPE REF TO data.
  FIELD-SYMBOLS <ls_evid> TYPE any.

  PERFORM table_exists USING lv_tabname CHANGING lv_exists.
  IF lv_exists <> abap_true.
    RETURN.
  ENDIF.

  TRY.
      lv_uuid = cl_system_uuid=>create_uuid_c32_static( ).
      CREATE DATA lr_evid TYPE (lv_tabname).
      ASSIGN lr_evid->* TO <ls_evid>.
    CATCH cx_root.
      RETURN.
  ENDTRY.

  GET TIME STAMP FIELD lv_ts.
  PERFORM get_demo_now CHANGING lv_demo_date_836 lv_demo_time_836.
  lv_status = 'ACCEPTED'.
  IF iv_outcome = gc_m2_z133_blocked OR iv_outcome = gc_m2_z133_cancelled.
    lv_status = iv_outcome.
  ENDIF.

  PERFORM set_optional_comp USING 'MANDT' sy-mandt CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'EVIDENCE_ID' lv_uuid CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'TCODE' iv_tcode CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'PROFILE_NAME' iv_profile CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'PROFILE_VER' iv_ver CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'ORIGIN' iv_origin CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'RAW_HASH' iv_fp CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'CONTRACT_FP' iv_fp CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'OUTCOME' iv_outcome CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'MISSING_COUNT' iv_missing CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'STATUS' lv_status CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'CREATED_BY' sy-uname CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'CREATED_ON' lv_demo_date_836 CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'CREATED_AT' lv_demo_time_836 CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'CREATED_TS' lv_ts CHANGING <ls_evid>.
  PERFORM set_optional_comp USING 'MESSAGE' iv_message CHANGING <ls_evid>.

  TRY.
      INSERT (lv_tabname) FROM <ls_evid>.
    CATCH cx_sy_open_sql_db.
      RETURN.
  ENDTRY.
  IF sy-subrc = 0.
 "Evidence participates in the onboarding LUW. It must never commit a
 "partially-persisted profile/script before the domain command succeeds.
    gv_z133_evidence_id = lv_uuid.
  ENDIF.
ENDFORM.

*& Commit optional onboarding evidence only at a terminal command boundary.
*& The writer itself never owns COMMIT so it cannot publish partial domain
*& state. Callers use this helper only when no uncommitted domain mutation
*& remains.

FORM commit_evidence.
  IF gv_z133_evidence_id IS NOT INITIAL.
    COMMIT WORK AND WAIT.
  ENDIF.
ENDFORM.

*& /Published Template Schema identity / idempotent reuse

*& PROFILE_VER is user-facing. A new number is allocated only when the
*& strict canonical business-input schema is new for the resolved profile.
*& Start Recording, SHDB Import, Generate Template and delivery-channel
*& retries never increment the version by themselves.

FORM script_schema_fp
  USING    iv_tcode  TYPE zbdc_prof_bup-tcode
           it_script TYPE ty_t_script
  CHANGING cv_fp     TYPE zbdc_script_bup-contract_hash
           cv_ok     TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_bdc         TYPE zbdc_mapping_bup-bdc_field,
        lv_logical     TYPE zbdc_mapping_bup-bdc_field,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_full_source TYPE zbdc_mapping_bup-source_column,
        lv_technical   TYPE abap_bool,
        lv_capture_ok  TYPE abap_bool,
        lv_role        TYPE string,
        lv_reason      TYPE string,
        lv_origin      TYPE c LENGTH 20,
        lv_token       TYPE string,
        lv_payload     TYPE string,
        lv_hash64      TYPE string,
        lv_confirmed_name TYPE abap_bool,
        lv_trait_suffix TYPE string,
        lv_tcode_norm TYPE zbdc_prof_bup-tcode.

  DATA: lt_seen_logical TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                         WITH UNIQUE KEY table_line,
        lt_seen_source TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                        WITH UNIQUE KEY table_line,
        lt_tokens TYPE SORTED TABLE OF string WITH UNIQUE KEY table_line.

  CLEAR: cv_fp, cv_ok, cv_message, lv_origin, lv_tcode_norm.
  lv_tcode_norm = iv_tcode.
  TRANSLATE lv_tcode_norm TO UPPER CASE.
  CONDENSE lv_tcode_norm NO-GAPS.
  PERFORM get_projection_origin CHANGING lv_origin.

  IF lv_origin = 'GUIDED_RECORD'
     AND gt_z360_rec_field_vals IS INITIAL.
    cv_message =
      'RECORDER_NATIVE_PROVENANCE_MISSING: Guided schema fingerprint is blocked; legacy/cursor projection is not permitted.'.
    RETURN.
  ENDIF.

  IF iv_tcode IS INITIAL OR it_script IS INITIAL.
    cv_message = 'TCODE and recording evidence are required for Template Schema identity.'.
    RETURN.
  ENDIF.

  lv_token = '#BUSINESS_KEY|BUSINESS_KEY'.
  INSERT lv_token INTO TABLE lt_tokens.

  LOOP AT it_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    IF ls_script-value_type = gc_m2_vt_ignore.
      CONTINUE.
    ENDIF.

    CLEAR: lv_bdc, lv_logical, lv_source, lv_full_source,
           lv_technical, lv_capture_ok, lv_reason.

    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_bdc.
    IF lv_bdc IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_role, lv_reason.
    PERFORM projection_role
      USING    it_script lv_bdc
      CHANGING lv_role lv_reason.
    IF lv_role <> 'DYNAMIC_PROVEN'.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key
      USING    lv_bdc
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      lv_logical = lv_bdc.
    ENDIF.

    READ TABLE lt_seen_logical
      WITH TABLE KEY table_line = lv_logical
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.

 "for fresh Guided/SHDB-TXT/SHDB-Program acquisitions, the name that the
 "user confirmed is the ONLY Template-schema naming authority. Do not
 "re-derive a second name from DDIC, action tokens, index shape or AI after
 "confirmation; that would make the schema fingerprint differ from the
 "actual Mapping that will be published.
    CLEAR lv_confirmed_name.
    IF ( lv_origin = 'GUIDED_RECORD'
         OR lv_origin = 'SHDB_TXT'
         OR lv_origin = 'SHDB_PROGRAM' )
       AND gv_z659_action_ready = abap_true
       AND gv_z684_name_ready = abap_true.
      PERFORM confirmed_name
        USING    lv_bdc
        CHANGING lv_source lv_confirmed_name.
      IF lv_confirmed_name <> abap_true OR lv_source IS INITIAL.
        cv_message =
          |NAME_CERT_MISSING: confirmed logical field { lv_logical } has no exact certified Template name.|.
        RETURN.
      ENDIF.
    ELSE.
      PERFORM normalize_mapping_source
        USING    ls_script-source_column
        CHANGING lv_source.
      IF lv_source IS INITIAL OR lv_source CP 'INPUT_*'.
        CLEAR lv_source.
        PERFORM source_from_bdc
          USING    lv_bdc
          CHANGING lv_source.
      ENDIF.
      IF lv_source IS INITIAL.
        CONTINUE.
      ENDIF.

      PERFORM shape_auto_source
        USING    it_script lv_source lv_bdc lv_origin
        CHANGING lv_source.
      IF lv_source IS INITIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    READ TABLE lt_seen_source
      WITH TABLE KEY table_line = lv_source
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      IF lv_confirmed_name = abap_true.
        cv_message =
          |CERTIFIED_NAME_COLLISION: more than one confirmed logical field uses Template name { lv_source }. Nothing was guessed or published.|.
        RETURN.
      ENDIF.

 "Legacy/non-confirmed origins retain their historical disambiguation
 "contract. The fresh Guided/TXT path above never enters this branch.
      PERFORM safe_disambig
        USING    it_script lv_bdc lv_source
        CHANGING lv_source.
      READ TABLE lt_seen_source
        WITH TABLE KEY table_line = lv_source
        TRANSPORTING NO FIELDS.
    ENDIF.
    IF sy-subrc = 0.
      IF lv_confirmed_name = abap_true.
        cv_message =
          |CERTIFIED_NAME_COLLISION: exact confirmed Template name { lv_source } is not unique.|.
        RETURN.
      ENDIF.
      lv_full_source = lv_bdc.
      REPLACE ALL OCCURRENCES OF '(*)' IN lv_full_source WITH ''.
      REPLACE ALL OCCURRENCES OF '-' IN lv_full_source WITH '_'.
      REPLACE ALL OCCURRENCES OF '.' IN lv_full_source WITH '_'.
      REPLACE ALL OCCURRENCES OF '/' IN lv_full_source WITH '_'.
      PERFORM normalize_mapping_source
        USING    lv_full_source
        CHANGING lv_source.
      READ TABLE lt_seen_source
        WITH TABLE KEY table_line = lv_source
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0 OR lv_source IS INITIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    INSERT lv_logical INTO TABLE lt_seen_logical.
    INSERT lv_source INTO TABLE lt_seen_source.

 "public Template identity also freezes technical compatibility
 "traits that are provable from DDIC. Sample values, screen flow and
 "executor choice remain excluded, so Import and Start Recording converge.
    CLEAR lv_trait_suffix.
    PERFORM schema_trait_suffix
      USING    lv_bdc
      CHANGING lv_trait_suffix.

    lv_token = |{ lv_logical }| && '|' && |{ lv_source }| && lv_trait_suffix.
    INSERT lv_token INTO TABLE lt_tokens.
  ENDLOOP.

  IF lines( lt_tokens ) <= 1.
    cv_message = 'Canonical recording projection produced no business Template field.'.
    RETURN.
  ENDIF.

  lv_payload = |TCODE={ lv_tcode_norm };TEMPLATE_SCHEMA_V2|.
  LOOP AT lt_tokens INTO lv_token.
    lv_payload = lv_payload && cl_abap_char_utilities=>newline && lv_token.
  ENDLOOP.

  TRY.
      cl_abap_message_digest=>calculate_hash_for_char(
        EXPORTING
          if_algorithm     = 'SHA-256'
          if_data          = lv_payload
        IMPORTING
          ef_hashb64string = lv_hash64 ).
    CATCH cx_abap_message_digest INTO DATA(lx_schema_digest).
      cv_message = lx_schema_digest->get_text( ).
      RETURN.
  ENDTRY.

  IF lv_hash64 IS INITIAL.
    cv_message = 'Template Schema fingerprint could not be calculated.'.
    RETURN.
  ENDIF.

  cv_fp = lv_hash64.
  cv_ok = abap_true.
ENDFORM.

*& Stable business-schema technical compatibility traits

*& Only DDIC facts attached to the canonical SAP field participate here.
*& Business/sample values, dynpro flow, BDC_OKCODE and CT/BISM are excluded.
*& This keeps Import and Start Recording source-neutral while allowing a true
*& incompatible DDIC type/length/conversion change to create a new Version.

FORM schema_trait_suffix
  USING    iv_bdc_field TYPE any
  CHANGING cv_suffix    TYPE string.

  DATA: lv_datatype TYPE string,
        lv_length   TYPE i,
        lv_len_txt  TYPE string,
        lv_conv     TYPE string,
        lv_found    TYPE abap_bool.

  CLEAR cv_suffix.
  PERFORM get_ddic_runtime_traits
    USING    iv_bdc_field
    CHANGING lv_datatype lv_length lv_conv lv_found.

  IF lv_found <> abap_true.
    cv_suffix = '|DT=?|LEN=?|CONV=?'.
    RETURN.
  ENDIF.

  TRANSLATE lv_datatype TO UPPER CASE.
  CONDENSE lv_datatype NO-GAPS.
  TRANSLATE lv_conv TO UPPER CASE.
  CONDENSE lv_conv NO-GAPS.
  lv_len_txt = lv_length.
  CONDENSE lv_len_txt NO-GAPS.

  CONCATENATE '|DT=' lv_datatype '|LEN=' lv_len_txt
              '|CONV=' lv_conv INTO cv_suffix.
ENDFORM.

*& Version-decision identity (V17.9)
*& PROFILE_VER changes only when selected logical field membership or exact
*& technical BDC choreography changes. Sample/master-data values and friendly
*& Template names are deliberately excluded from this decision.

FORM selection_fp_actions
  USING    iv_tcode  TYPE zbdc_prof_bup-tcode
           it_script TYPE ty_t_script
  CHANGING cv_fp     TYPE zbdc_script_bup-contract_hash
           cv_ok     TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_action   TYPE zbdc_mapping_bup-bdc_field,
        lv_action_l TYPE zbdc_mapping_bup-bdc_field,
        lv_actual   TYPE zbdc_mapping_bup-bdc_field,
        lv_actual_l TYPE zbdc_mapping_bup-bdc_field,
        lv_trait    TYPE string,
        lv_token    TYPE string,
        lv_payload  TYPE string,
        lv_hash64   TYPE string,
        lv_tcode_n  TYPE zbdc_prof_bup-tcode,
        ls_scr      TYPE ty_script_def_compat.
  DATA lt_tokens TYPE SORTED TABLE OF string WITH UNIQUE KEY table_line.

  CLEAR: cv_fp, cv_ok, cv_message.
  lv_tcode_n = iv_tcode.
  TRANSLATE lv_tcode_n TO UPPER CASE.
  CONDENSE lv_tcode_n NO-GAPS.

  IF lv_tcode_n IS INITIAL OR it_script IS INITIAL.
    cv_message = 'TCODE and recording evidence are required for selected-field identity.'.
    RETURN.
  ENDIF.
  IF gv_z659_action_ready <> abap_true OR gt_z659_user_actions IS INITIAL.
    cv_message = 'Exact selected user-field membership is not confirmed yet.'.
    RETURN.
  ENDIF.

  lv_token = '#BUSINESS_KEY'.
  INSERT lv_token INTO TABLE lt_tokens.
  LOOP AT gt_z659_user_actions INTO lv_action.
    CLEAR: lv_action_l, lv_actual, lv_actual_l, lv_trait.
    PERFORM logical_bdc_key USING lv_action CHANGING lv_action_l.
    IF lv_action_l IS INITIAL.
      lv_action_l = lv_action.
    ENDIF.

    LOOP AT it_script INTO ls_scr
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.
      CLEAR: lv_actual, lv_actual_l.
      PERFORM normalize_mapping_bdc_field USING ls_scr-field_name CHANGING lv_actual.
      IF lv_actual IS INITIAL.
        CONTINUE.
      ENDIF.
      PERFORM logical_bdc_key USING lv_actual CHANGING lv_actual_l.
      IF lv_actual_l IS INITIAL.
        lv_actual_l = lv_actual.
      ENDIF.
      IF lv_actual_l = lv_action_l.
        EXIT.
      ENDIF.
      CLEAR lv_actual.
    ENDLOOP.

    IF lv_actual IS INITIAL.
      cv_message = |Selected field { lv_action_l } is not present in the current recording.|.
      RETURN.
    ENDIF.

    PERFORM schema_trait_suffix USING lv_actual CHANGING lv_trait.
    lv_token = |{ lv_action_l }{ lv_trait }|.
    INSERT lv_token INTO TABLE lt_tokens.
  ENDLOOP.

  IF lines( lt_tokens ) <= 1.
    cv_message = 'Selected-field identity contains no business field.'.
    RETURN.
  ENDIF.

  lv_payload = |TCODE={ lv_tcode_n };SELECTED_FIELD_SET_V1|.
  LOOP AT lt_tokens INTO lv_token.
    lv_payload = lv_payload && cl_abap_char_utilities=>newline && lv_token.
  ENDLOOP.

  TRY.
      cl_abap_message_digest=>calculate_hash_for_char(
        EXPORTING if_algorithm = 'SHA-256' if_data = lv_payload
        IMPORTING ef_hashb64string = lv_hash64 ).
    CATCH cx_abap_message_digest INTO DATA(lx_sel_digest).
      cv_message = lx_sel_digest->get_text( ).
      RETURN.
  ENDTRY.

  IF lv_hash64 IS INITIAL.
    cv_message = 'Selected-field identity could not be calculated.'.
    RETURN.
  ENDIF.
  cv_fp = lv_hash64.
  cv_ok = abap_true.
ENDFORM.

FORM selection_fp_map
  USING    iv_tcode TYPE zbdc_prof_bup-tcode
           it_map   TYPE ty_t_mapping_db
  CHANGING cv_fp    TYPE zbdc_script_bup-contract_hash
           cv_ok    TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_map     TYPE zbdc_mapping_bup,
        lv_bdc     TYPE zbdc_mapping_bup-bdc_field,
        lv_logical TYPE zbdc_mapping_bup-bdc_field,
        lv_trait   TYPE string,
        lv_token   TYPE string,
        lv_payload TYPE string,
        lv_hash64  TYPE string,
        lv_tcode_n TYPE zbdc_prof_bup-tcode.
  DATA lt_tokens TYPE SORTED TABLE OF string WITH UNIQUE KEY table_line.

  CLEAR: cv_fp, cv_ok, cv_message.
  lv_tcode_n = iv_tcode.
  TRANSLATE lv_tcode_n TO UPPER CASE.
  CONDENSE lv_tcode_n NO-GAPS.
  IF lv_tcode_n IS INITIAL OR it_map IS INITIAL.
    cv_message = 'TCODE and Mapping rows are required for selected-field identity.'.
    RETURN.
  ENDIF.

  lv_token = '#BUSINESS_KEY'.
  INSERT lv_token INTO TABLE lt_tokens.
  LOOP AT it_map INTO ls_map.
    IF ls_map-mandatory = gc_m2_map_review OR ls_map-bdc_field IS INITIAL.
      CONTINUE.
    ENDIF.
    CLEAR: lv_bdc, lv_logical, lv_trait.
    PERFORM normalize_mapping_bdc_field USING ls_map-bdc_field CHANGING lv_bdc.
    IF lv_bdc IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key USING lv_bdc CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      lv_logical = lv_bdc.
    ENDIF.
    PERFORM schema_trait_suffix USING lv_bdc CHANGING lv_trait.
    lv_token = |{ lv_logical }{ lv_trait }|.
    INSERT lv_token INTO TABLE lt_tokens.
  ENDLOOP.

  IF lines( lt_tokens ) <= 1.
    cv_message = 'Mapping selected-field identity contains no business field.'.
    RETURN.
  ENDIF.

  lv_payload = |TCODE={ lv_tcode_n };SELECTED_FIELD_SET_V1|.
  LOOP AT lt_tokens INTO lv_token.
    lv_payload = lv_payload && cl_abap_char_utilities=>newline && lv_token.
  ENDLOOP.

  TRY.
      cl_abap_message_digest=>calculate_hash_for_char(
        EXPORTING if_algorithm = 'SHA-256' if_data = lv_payload
        IMPORTING ef_hashb64string = lv_hash64 ).
    CATCH cx_abap_message_digest INTO DATA(lx_map_sel_digest).
      cv_message = lx_map_sel_digest->get_text( ).
      RETURN.
  ENDTRY.

  IF lv_hash64 IS INITIAL.
    cv_message = 'Mapping selected-field identity could not be calculated.'.
    RETURN.
  ENDIF.
  cv_fp = lv_hash64.
  cv_ok = abap_true.
ENDFORM.

FORM version_identity_fp
  USING    iv_tcode        TYPE zbdc_prof_bup-tcode
           it_raw          TYPE ty_t_script
           iv_selection_fp TYPE zbdc_script_bup-contract_hash
  CHANGING cv_fp           TYPE zbdc_script_bup-contract_hash
           cv_ok           TYPE abap_bool
           cv_message      TYPE string.

  DATA: lv_exec_fp TYPE zbdc_script_bup-contract_hash,
        lv_exec_ok TYPE abap_bool,
        lv_exec_msg TYPE string,
        lv_payload TYPE string,
        lv_hash64 TYPE string,
        lv_tcode_n TYPE zbdc_prof_bup-tcode.

  CLEAR: cv_fp, cv_ok, cv_message.
  IF iv_selection_fp IS INITIAL OR it_raw IS INITIAL.
    cv_message = 'Selected-field identity and raw recording are required for Version identity.'.
    RETURN.
  ENDIF.

  PERFORM exec_recording_fp USING it_raw
    CHANGING lv_exec_fp lv_exec_ok lv_exec_msg.
  IF lv_exec_ok <> abap_true OR lv_exec_fp IS INITIAL.
    cv_message = lv_exec_msg.
    RETURN.
  ENDIF.

  lv_tcode_n = iv_tcode.
  TRANSLATE lv_tcode_n TO UPPER CASE.
  CONDENSE lv_tcode_n NO-GAPS.
  lv_payload = |TCODE={ lv_tcode_n };VERSION_ID_V1;SEL={ iv_selection_fp };EXEC={ lv_exec_fp }|.
  TRY.
      cl_abap_message_digest=>calculate_hash_for_char(
        EXPORTING if_algorithm = 'SHA-256' if_data = lv_payload
        IMPORTING ef_hashb64string = lv_hash64 ).
    CATCH cx_abap_message_digest INTO DATA(lx_ver_digest).
      cv_message = lx_ver_digest->get_text( ).
      RETURN.
  ENDTRY.

  IF lv_hash64 IS INITIAL.
    cv_message = 'Version identity could not be calculated.'.
    RETURN.
  ENDIF.
  cv_fp = lv_hash64.
  cv_ok = abap_true.
ENDFORM.

FORM ensure_version_fp
  USING    iv_script_id  TYPE zbdc_script_bup-script_id
           iv_version_fp TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ok         TYPE abap_bool
           cv_message    TYPE string.

  DATA: lv_existing TYPE zbdc_config_bup-config_value,
        lv_set_ok   TYPE abap_bool,
        lv_set_msg  TYPE string.

  CLEAR: cv_ok, cv_message, lv_existing.
  IF iv_script_id IS INITIAL OR iv_version_fp IS INITIAL.
    cv_message = 'Script ID and Version identity are required.'.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg USING iv_script_id 'VERSIONFP' CHANGING lv_existing.
  IF lv_existing IS NOT INITIAL.
    IF lv_existing <> iv_version_fp.
      cv_message = 'VERSION_IDENTITY_CONFLICT: existing Version belongs to a different selected-field/technical recording identity.'.
      RETURN.
    ENDIF.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  PERFORM set_script_cfg USING iv_script_id 'VERSIONFP' iv_version_fp
    CHANGING lv_set_ok lv_set_msg.
  IF lv_set_ok <> abap_true.
    cv_message = lv_set_msg.
    RETURN.
  ENDIF.
  cv_ok = abap_true.
ENDFORM.

*& Freeze/reuse exact public schema identity

FORM ensure_schema_fp
  USING    iv_script_id TYPE zbdc_script_bup-script_id
           iv_schema_fp TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_existing TYPE zbdc_config_bup-config_value,
        lv_set_ok   TYPE abap_bool,
        lv_set_msg  TYPE string.

  CLEAR: cv_ok, cv_message, lv_existing.
  IF iv_script_id IS INITIAL OR iv_schema_fp IS INITIAL.
    cv_message = 'Script ID and normalized Template Schema identity are required.'.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'SCHEMAFP'
    CHANGING lv_existing.

  IF lv_existing IS NOT INITIAL.
    "V17.9.2: SCHEMAFP is derivative/friendly Template metadata, not
    "PROFILE_VER authority. VERSIONFP already decides reuse/new-version from
    "selected SAP fields + technical choreography. A legacy/friendly-name
    "difference must therefore never block Mapping or allocate a version.
    "Keep the previously stored schema fingerprint as history; Generate
    "Template will align/repair only its derivative manifest when possible.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  CLEAR: lv_set_ok, lv_set_msg.
  PERFORM set_script_cfg
    USING    iv_script_id 'SCHEMAFP' iv_schema_fp
    CHANGING lv_set_ok lv_set_msg.
  IF lv_set_ok <> abap_true.
    cv_message = lv_set_msg.
    IF cv_message IS INITIAL.
      cv_message = 'Normalized Template Schema identity could not be frozen.'.
    ENDIF.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.
*& Raw recording snapshot + compile certificate

*& The Script Header/Steps table stores the COMPILED executable contract.
*& The exact pre-compiler recording is stored separately under an anonymous
*& raw SCRIPT_ID in ZBDC_SCT_VER_BUP and linked by ZBDC_CONFIG_BUP.
*& Runtime never reclassifies a frozen script. A reusable/executable contract
*& must carry the current compiler certificate tied to its immutable SCRIPT_ID.

FORM save_raw_snapshot
  USING    iv_script_id TYPE zbdc_script_bup-script_id
           it_raw       TYPE ty_t_script
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_cert_ok TYPE abap_bool,
        lv_cert_msg TYPE string,
        lv_raw_id  TYPE zbdc_script_bup-script_id,
        lv_cfg_raw TYPE zbdc_config_bup-config_value,
        lt_steps   TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        ls_step    TYPE zbdc_sct_ver_bup,
        ls_scr      TYPE ty_script_def_compat,
        lv_set_ok   TYPE abap_bool,
        lv_set_msg  TYPE string,
        lv_comp_ver TYPE zbdc_config_bup-config_value,
        lv_map_ver  TYPE zbdc_config_bup-config_value.

  CLEAR: cv_ok, cv_message.
  IF iv_script_id IS INITIAL OR it_raw IS INITIAL.
    cv_message = 'Raw compiler snapshot requires Script ID and recording steps.'.
    RETURN.
  ENDIF.

 "Idempotent: an already-certified Script ID keeps its immutable raw source.
  CLEAR: lv_cert_ok, lv_cert_msg.
  PERFORM compiler_cert_ok
    USING    iv_script_id
    CHANGING lv_cert_ok lv_cert_msg.
  IF lv_cert_ok = abap_true.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'RAW'
    CHANGING lv_cfg_raw.
  IF lv_cfg_raw IS NOT INITIAL.
    lv_raw_id = lv_cfg_raw.
  ELSE.
    TRY.
        lv_raw_id = cl_system_uuid=>create_uuid_c32_static( ).
      CATCH cx_uuid_error INTO DATA(lx_uuid).
        cv_message = lx_uuid->get_text( ).
        RETURN.
    ENDTRY.
  ENDIF.

  REFRESH lt_steps.
  LOOP AT it_raw INTO ls_scr.
    CLEAR ls_step.
    ls_step-script_id     = lv_raw_id.
    ls_step-step_seq      = ls_scr-step_seq.
    ls_step-is_new_screen = ls_scr-is_new_screen.
    ls_step-field_name    = ls_scr-field_name.
    ls_step-value_type    = ls_scr-value_type.
    ls_step-static_value  = ls_scr-static_value.
    ls_step-source_column = ls_scr-source_column.
    ls_step-row_type      = ls_scr-row_type.
    ls_step-program_name  = ls_scr-program_name.
    ls_step-dynpro_no     = ls_scr-dynpro_no.
    APPEND ls_step TO lt_steps.
  ENDLOOP.

  IF lt_steps IS INITIAL.
    cv_message = 'Raw compiler snapshot contains no steps.'.
    RETURN.
  ENDIF.

 "A raw snapshot is immutable. For a new link the UUID is unique; if a
 "partially-written link exists, replace only that anonymous raw snapshot.
  DELETE FROM zbdc_sct_ver_bup WHERE script_id = @lv_raw_id.
  INSERT zbdc_sct_ver_bup FROM TABLE @lt_steps.
  IF sy-subrc <> 0.
    cv_message = 'Immutable raw recording snapshot could not be persisted.'.
    RETURN.
  ENDIF.

  CLEAR: lv_set_ok, lv_set_msg.
  PERFORM set_script_cfg
    USING    iv_script_id 'RAW' lv_raw_id
    CHANGING lv_set_ok lv_set_msg.
  IF lv_set_ok <> abap_true.
    cv_message = lv_set_msg.
    RETURN.
  ENDIF.

  CLEAR lv_comp_ver.
  PERFORM current_compiler CHANGING lv_comp_ver.

  CLEAR: lv_set_ok, lv_set_msg.
  PERFORM set_script_cfg
    USING    iv_script_id 'COMPILER' lv_comp_ver
    CHANGING lv_set_ok lv_set_msg.
  IF lv_set_ok <> abap_true.
    cv_message = lv_set_msg.
    RETURN.
  ENDIF.

 "persist the Mapping-projection compiler independently from S1.
 "Old S1 scripts without this marker remain valid history/runtime evidence
 "but cannot be silently reused as current Template-Mapping authority.
  CLEAR lv_map_ver.
  PERFORM current_mapclass CHANGING lv_map_ver.
  CLEAR: lv_set_ok, lv_set_msg.
  PERFORM set_script_cfg
    USING    iv_script_id 'MAPCLASS' lv_map_ver
    CHANGING lv_set_ok lv_set_msg.
  IF lv_set_ok <> abap_true.
    cv_message = lv_set_msg.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

*& Immutable execution-recording identity

*& PROFILE_VER represents the public business-input schema. Reusing that
*& version must therefore be idempotent: the already-bound CT/BISM recording
*& may be reused when structurally identical, but a different technical SHDB
*& choreography must never silently replace it. Dynamic business values are
*& intentionally excluded from the technical fingerprint so different sample
*& data does not create a false recording conflict.

FORM exec_recording_fp
  USING    it_raw       TYPE ty_t_script
  CHANGING cv_fp        TYPE zbdc_script_bup-contract_hash
           cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lt_raw       TYPE ty_t_script,
        ls_scr       TYPE ty_script_def_compat,
        lv_payload   TYPE string,
        lv_hash64    TYPE string,
        lv_part      TYPE string,
        lv_value     TYPE string,
        lv_len       TYPE i,
        lv_prev_seq  TYPE i,
        lv_have_prev TYPE abap_bool.

  CLEAR: cv_fp, cv_ok, cv_message.
  IF it_raw IS INITIAL.
    cv_message = 'Execution recording fingerprint requires canonical SHDB rows.'.
    RETURN.
  ENDIF.

  lt_raw = it_raw.
  SORT lt_raw BY step_seq.
  lv_payload = 'EXEC_RECORDING_V1'.

  LOOP AT lt_raw INTO ls_scr.
    IF lv_have_prev = abap_true AND ls_scr-step_seq = lv_prev_seq.
      cv_message =
        |Execution recording contains duplicate STEP_SEQ { ls_scr-step_seq }; ownership is ambiguous.|.
      RETURN.
    ENDIF.
    lv_prev_seq = ls_scr-step_seq.
    lv_have_prev = abap_true.

 "Exact technical identity. Each component is length-prefixed so values
 "containing separators cannot collide with another recording payload.
    lv_part = ls_scr-step_seq.
    lv_len = strlen( lv_part ).
    lv_payload = lv_payload && |#S{ lv_len }:{ lv_part }|.

    lv_part = ls_scr-is_new_screen.
    lv_len = strlen( lv_part ).
    lv_payload = lv_payload && |#N{ lv_len }:{ lv_part }|.

    lv_part = ls_scr-program_name.
    lv_len = strlen( lv_part ).
    lv_payload = lv_payload && |#P{ lv_len }:{ lv_part }|.

    lv_part = ls_scr-dynpro_no.
    lv_len = strlen( lv_part ).
    lv_payload = lv_payload && |#D{ lv_len }:{ lv_part }|.

    lv_part = ls_scr-field_name.
    lv_len = strlen( lv_part ).
    lv_payload = lv_payload && |#F{ lv_len }:{ lv_part }|.

 "VALUE_TYPE, SOURCE_COLUMN and ROW_TYPE are projection/classifier metadata,
 "not physical BDC choreography. Import and Start Recording may populate
 "those adapters differently, so they are deliberately excluded here.

 "Sample/master-data values must not make a technical recording look new.
 "Only universal BDC control values participate in execution identity; the
 "screen/program/field sequence above already proves the generic technical
 "choreography without hardcoding any business TCODE or business field.
    CLEAR lv_value.
    IF ls_scr-field_name CP 'BDC_*'.
      lv_value = ls_scr-static_value.
    ENDIF.
    lv_len = strlen( lv_value ).
    lv_payload = lv_payload && |#V{ lv_len }:{ lv_value }|.
  ENDLOOP.

  TRY.
      cl_abap_message_digest=>calculate_hash_for_char(
        EXPORTING
          if_algorithm     = 'SHA-256'
          if_data          = lv_payload
        IMPORTING
          ef_hashb64string = lv_hash64 ).
    CATCH cx_abap_message_digest INTO DATA(lx_digest).
      cv_message = lx_digest->get_text( ).
      RETURN.
  ENDTRY.

  IF lv_hash64 IS INITIAL.
    cv_message = 'Execution recording fingerprint could not be calculated.'.
    RETURN.
  ENDIF.

  cv_fp = lv_hash64.
  cv_ok = abap_true.
ENDFORM.

*& CT_BISM_CANONICAL - Current execution recording snapshot

*& Import TXT and Start Recording are acquisition adapters for the same
*& canonical SHDB stream. A published business-schema Version owns one
*& immutable EXEC_RAW technical recording. Repeated Import/Start Recording
*& may reuse that Version only when the incoming technical choreography is
*& structurally identical; a different recording is blocked, never silently
*& substituted. Dynamic sample values do not change technical identity.
*& Runtime prefers EXEC_RAW, then RAW, then legacy compiled steps.

FORM save_exec_recording
  USING    iv_script_id TYPE zbdc_script_bup-script_id
           it_raw       TYPE ty_t_script
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_exec_id      TYPE zbdc_script_bup-script_id,
        lt_steps        TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        lt_existing     TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        lt_existing_raw TYPE ty_t_script,
        ls_step         TYPE zbdc_sct_ver_bup,
        ls_scr          TYPE ty_script_def_compat,
        lv_set_ok       TYPE abap_bool,
        lv_set_msg      TYPE string,
        lv_existing_cfg TYPE zbdc_config_bup-config_value,
        lv_existing_id  TYPE zbdc_script_bup-script_id,
        lv_old_fp       TYPE zbdc_script_bup-contract_hash,
        lv_new_fp       TYPE zbdc_script_bup-contract_hash,
        lv_old_fp_ok    TYPE abap_bool,
        lv_new_fp_ok    TYPE abap_bool,
        lv_old_fp_msg   TYPE string,
        lv_new_fp_msg   TYPE string.

  CLEAR: cv_ok, cv_message.
  IF iv_script_id IS INITIAL OR it_raw IS INITIAL.
    cv_message = 'Execution recording snapshot requires Script ID and canonical SHDB rows.'.
    RETURN.
  ENDIF.

 "EXEC_RAW becomes immutable after the first successful bind for a
 "given business-schema Version. Repeated Import/Start Recording may reuse
 "that Version only when the technical recording is structurally identical.
  CLEAR lv_existing_cfg.
  PERFORM get_script_cfg
    USING    iv_script_id 'EXEC_RAW'
    CHANGING lv_existing_cfg.
  lv_existing_id = lv_existing_cfg.

  IF lv_existing_id IS NOT INITIAL.
    SELECT * FROM zbdc_sct_ver_bup
      INTO TABLE @lt_existing
      WHERE script_id = @lv_existing_id
      ORDER BY step_seq.

    IF lt_existing IS INITIAL.
      cv_message =
        |EXEC_RECORDING_CONFLICT: Script { iv_script_id } points to missing EXEC_RAW { lv_existing_id }. Existing Version was not modified.|.
      RETURN.
    ENDIF.

    REFRESH lt_existing_raw.
    LOOP AT lt_existing INTO ls_step.
      CLEAR ls_scr.
      ls_scr-step_seq      = ls_step-step_seq.
      ls_scr-is_new_screen = ls_step-is_new_screen.
      ls_scr-field_name    = ls_step-field_name.
      ls_scr-value_type    = ls_step-value_type.
      ls_scr-static_value  = ls_step-static_value.
      ls_scr-source_column = ls_step-source_column.
      ls_scr-row_type      = ls_step-row_type.
      ls_scr-program_name  = ls_step-program_name.
      ls_scr-dynpro_no     = ls_step-dynpro_no.
      APPEND ls_scr TO lt_existing_raw.
    ENDLOOP.

    CLEAR: lv_old_fp, lv_new_fp, lv_old_fp_ok, lv_new_fp_ok,
           lv_old_fp_msg, lv_new_fp_msg.
    PERFORM exec_recording_fp
      USING    lt_existing_raw
      CHANGING lv_old_fp lv_old_fp_ok lv_old_fp_msg.
    PERFORM exec_recording_fp
      USING    it_raw
      CHANGING lv_new_fp lv_new_fp_ok lv_new_fp_msg.

    IF lv_old_fp_ok <> abap_true OR lv_new_fp_ok <> abap_true.
      cv_message = lv_old_fp_msg.
      IF cv_message IS INITIAL.
        cv_message = lv_new_fp_msg.
      ENDIF.
      IF cv_message IS INITIAL.
        cv_message = 'Execution recording identity could not be verified; existing Version was preserved.'.
      ENDIF.
      RETURN.
    ENDIF.

    IF lv_old_fp = lv_new_fp.
      cv_ok = abap_true.
      cv_message =
        |Execution recording is identical to existing EXEC_RAW { lv_existing_id }; existing Version/recording preserved.|.
      RETURN.
    ENDIF.

    cv_message =
      |EXEC_RECORDING_CONFLICT: this business-schema Version already owns a different technical recording ({ lv_existing_id }). Existing recording was preserved; no silent overwrite occurred.|.
    RETURN.
  ENDIF.

  TRY.
      lv_exec_id = cl_system_uuid=>create_uuid_c32_static( ).
    CATCH cx_uuid_error INTO DATA(lx_uuid).
      cv_message = lx_uuid->get_text( ).
      RETURN.
  ENDTRY.

  LOOP AT it_raw INTO ls_scr.
    CLEAR ls_step.
    ls_step-script_id     = lv_exec_id.
    ls_step-step_seq      = ls_scr-step_seq.
    ls_step-is_new_screen = ls_scr-is_new_screen.
    ls_step-field_name    = ls_scr-field_name.
    ls_step-value_type    = ls_scr-value_type.
    ls_step-static_value  = ls_scr-static_value.
    ls_step-source_column = ls_scr-source_column.
    ls_step-row_type      = ls_scr-row_type.
    ls_step-program_name  = ls_scr-program_name.
    ls_step-dynpro_no     = ls_scr-dynpro_no.
    APPEND ls_step TO lt_steps.
  ENDLOOP.

  IF lt_steps IS INITIAL.
    cv_message = 'Canonical SHDB acquisition contains no rows.'.
    RETURN.
  ENDIF.

  INSERT zbdc_sct_ver_bup FROM TABLE @lt_steps.
  IF sy-subrc <> 0.
    cv_message = 'Current execution recording snapshot could not be persisted.'.
    RETURN.
  ENDIF.

  CLEAR: lv_set_ok, lv_set_msg.
  PERFORM set_script_cfg
    USING    iv_script_id 'EXEC_RAW' lv_exec_id
    CHANGING lv_set_ok lv_set_msg.
  IF lv_set_ok <> abap_true.
    DELETE FROM zbdc_sct_ver_bup WHERE script_id = @lv_exec_id.
    cv_message = lv_set_msg.
    RETURN.
  ENDIF.

 "when EXEC_RAW came from Guided Start Recording, bind the recorder
 "provenance and the actual CTU environment to the reused Script as well.
 "Earlier code refreshed EXEC_RAW on schema reuse but left stale/missing CTU
 "metadata from the older profile, so identical BDCDATA could execute under a
 "different CALL TRANSACTION environment.
  IF gv_z500_raw_qid IS NOT INITIAL.
    CLEAR: lv_set_ok, lv_set_msg.
    PERFORM set_script_cfg
      USING    iv_script_id 'RAWQID' gv_z500_raw_qid
      CHANGING lv_set_ok lv_set_msg.
    IF lv_set_ok <> abap_true.
      cv_message = lv_set_msg.
      RETURN.
    ENDIF.

    IF gv_z500_raw_group IS NOT INITIAL.
      CLEAR: lv_set_ok, lv_set_msg.
      PERFORM set_script_cfg
        USING    iv_script_id 'RAWGROUP' gv_z500_raw_group
        CHANGING lv_set_ok lv_set_msg.
      IF lv_set_ok <> abap_true.
        cv_message = lv_set_msg.
        RETURN.
      ENDIF.
    ENDIF.

    CLEAR: lv_set_ok, lv_set_msg.
    PERFORM set_script_cfg
      USING    iv_script_id 'RAWSOURCE' 'SAP_APQI'
      CHANGING lv_set_ok lv_set_msg.
    IF lv_set_ok <> abap_true.
      cv_message = lv_set_msg.
      RETURN.
    ENDIF.

    CLEAR: lv_set_ok, lv_set_msg.
    PERFORM set_script_cfg
      USING    iv_script_id 'CTURACOM' 'TERMINATE'
      CHANGING lv_set_ok lv_set_msg.
    IF lv_set_ok <> abap_true.
      cv_message = lv_set_msg.
      RETURN.
    ENDIF.

    CLEAR: lv_set_ok, lv_set_msg.
    PERFORM set_script_cfg
      USING    iv_script_id 'CTUNOBIN' 'BATCH'
      CHANGING lv_set_ok lv_set_msg.
    IF lv_set_ok <> abap_true.
      cv_message = lv_set_msg.
      RETURN.
    ENDIF.

    CLEAR: lv_set_ok, lv_set_msg.
    PERFORM set_script_cfg
      USING    iv_script_id 'CTUDEFSZ' 'X'
      CHANGING lv_set_ok lv_set_msg.
    IF lv_set_ok <> abap_true.
      cv_message = lv_set_msg.
      RETURN.
    ENDIF.
  ENDIF.

  cv_ok = abap_true.
  cv_message = |Canonical execution recording { lv_exec_id } bound to Script { iv_script_id }.|.
ENDFORM.

FORM load_raw_snapshot
  USING    iv_tcode     TYPE sy-tcode
           iv_script_id TYPE zbdc_script_bup-script_id
  CHANGING ct_raw       TYPE ty_t_script
           cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_cert_ok TYPE abap_bool,
        lv_cert_msg TYPE string,
        lv_cfg_raw TYPE zbdc_config_bup-config_value,
        lv_raw_id  TYPE zbdc_script_bup-script_id,
        lt_steps   TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        ls_step    TYPE zbdc_sct_ver_bup,
        ls_scr     TYPE ty_script_def_compat.

  REFRESH ct_raw.
  CLEAR: cv_ok, cv_message.

  PERFORM compiler_cert_ok
    USING    iv_script_id
    CHANGING lv_cert_ok lv_cert_msg.
  IF lv_cert_ok <> abap_true.
    cv_message = lv_cert_msg.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'RAW'
    CHANGING lv_cfg_raw.
  lv_raw_id = lv_cfg_raw.
  IF lv_raw_id IS INITIAL.
    cv_message = 'Immutable raw recording link is empty.'.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_sct_ver_bup
    INTO TABLE @lt_steps
    WHERE script_id = @lv_raw_id
    ORDER BY step_seq.
  IF lt_steps IS INITIAL.
    cv_message = 'Immutable raw recording snapshot is missing.'.
    RETURN.
  ENDIF.

  LOOP AT lt_steps INTO ls_step.
    CLEAR ls_scr.
    ls_scr-tcode         = iv_tcode.
    ls_scr-step_seq      = ls_step-step_seq.
    ls_scr-is_new_screen = ls_step-is_new_screen.
    ls_scr-field_name    = ls_step-field_name.
    ls_scr-value_type    = ls_step-value_type.
    ls_scr-static_value  = ls_step-static_value.
    ls_scr-source_column = ls_step-source_column.
    ls_scr-row_type      = ls_step-row_type.
    ls_scr-program_name  = ls_step-program_name.
    ls_scr-dynpro_no     = ls_step-dynpro_no.
    APPEND ls_scr TO ct_raw.
  ENDLOOP.

  cv_ok = abap_true.
ENDFORM.

*& Current acquisition + user-action evidence Mapping authority

*& A persisted Mapping/Field Guide may enrich labels and staging slots, but
*& it must never add a BDC field that is absent from the latest explicit
*& Import/Guided acquisition bound to this exact Script. Prefer the in-memory
*& raw evidence while the acquisition is active; otherwise use EXEC_RAW.
*& binds it once per business Version and preserves it on later reuse.

FORM load_member_source
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_script_id TYPE zbdc_script_bup-script_id
  CHANGING ct_script    TYPE ty_t_script
           cv_found     TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_origin  TYPE c LENGTH 20,
        lv_cfg_exec TYPE zbdc_config_bup-config_value,
        lv_exec_id TYPE zbdc_script_bup-script_id,
        lt_steps   TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        ls_step    TYPE zbdc_sct_ver_bup,
        ls_scr     TYPE ty_script_def_compat,
        ls_first   TYPE ty_script_def_compat.

  REFRESH ct_script.
  CLEAR: cv_found, cv_message.

  PERFORM get_projection_origin CHANGING lv_origin.

  IF gt_z333_rec_evidence IS NOT INITIAL
     AND ( lv_origin = 'GUIDED_RECORD'
        OR lv_origin = 'SHDB_TXT'
        OR lv_origin = 'SHDB_PROGRAM' ).
    READ TABLE gt_z333_rec_evidence INTO ls_first INDEX 1.
    IF sy-subrc = 0.
      IF ls_first-tcode IS INITIAL OR ls_first-tcode = iv_tcode.
        ct_script = gt_z333_rec_evidence.
        cv_found = abap_true.
        cv_message = 'Current in-memory acquisition is the Mapping membership authority.'.
        RETURN.
      ENDIF.
    ENDIF.
  ENDIF.

  IF iv_script_id IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR lv_cfg_exec.
  PERFORM get_script_cfg
    USING    iv_script_id 'EXEC_RAW'
    CHANGING lv_cfg_exec.
  lv_exec_id = lv_cfg_exec.
  IF lv_exec_id IS INITIAL.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_sct_ver_bup
    INTO TABLE @lt_steps
    WHERE script_id = @lv_exec_id
    ORDER BY step_seq.
  IF lt_steps IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_steps INTO ls_step.
    CLEAR ls_scr.
    ls_scr-tcode         = iv_tcode.
    ls_scr-step_seq      = ls_step-step_seq.
    ls_scr-is_new_screen = ls_step-is_new_screen.
    ls_scr-field_name    = ls_step-field_name.
    ls_scr-value_type    = ls_step-value_type.
    ls_scr-static_value  = ls_step-static_value.
    ls_scr-source_column = ls_step-source_column.
    ls_scr-row_type      = ls_step-row_type.
    ls_scr-program_name  = ls_step-program_name.
    ls_scr-dynpro_no     = ls_step-dynpro_no.
    APPEND ls_scr TO ct_script.
  ENDLOOP.

  IF ct_script IS NOT INITIAL.
    cv_found = abap_true.
    cv_message = |EXEC_RAW { lv_exec_id } is the Mapping membership authority.|.
  ENDIF.
ENDFORM.

FORM filter_map_members
  USING    iv_tcode   TYPE any
           iv_profile TYPE any
           iv_ver     TYPE any
  CHANGING ct_map     TYPE ty_t_mapping_db.

  DATA: lv_tcode     TYPE zbdc_prof_bup-tcode,
        lv_profile   TYPE zbdc_prof_bup-profile_name,
        lv_ver       TYPE zbdc_prof_bup-profile_ver,
        lt_contract  TYPE ty_t_script,
        lt_member    TYPE ty_t_script,
        lt_keep      TYPE ty_t_mapping_db,
        ls_map       TYPE zbdc_mapping_bup,
        lv_script_id TYPE zbdc_script_bup-script_id,
        lv_hash      TYPE zbdc_script_bup-contract_hash,
        lv_script_ok TYPE abap_bool,
        lv_member_ok TYPE abap_bool,
        lv_member_msg TYPE string,
        lv_role      TYPE string,
        lv_reason    TYPE string,
        lv_curr_action_n TYPE i,
        lv_curr_name_n   TYPE i,
        lv_curr_tcode    TYPE sy-tcode.

  IF ct_map IS INITIAL.
    RETURN.
  ENDIF.

  lv_tcode   = iv_tcode.
  lv_profile = iv_profile.
  lv_ver     = iv_ver.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.
  CONDENSE lv_profile.

  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL OR lv_ver IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM load_profile_script
    USING    lv_tcode lv_profile lv_ver
    CHANGING lt_contract lv_script_id lv_hash lv_script_ok.
  IF lv_script_ok <> abap_true OR lv_script_id IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM load_member_source
    USING    lv_tcode lv_script_id
    CHANGING lt_member lv_member_ok lv_member_msg.
  IF lv_member_ok <> abap_true OR lt_member IS INITIAL.
    RETURN.
  ENDIF.

 "membership filtering has two exact authorities, depending on the
 "lifecycle boundary. During a FRESH current Import/Start acquisition, the
 "user has just confirmed the exact action/name set before the Candidate
 "Mapping is promoted to its final immutable Script ID/Hash. That in-memory
 "set is the only exact authority at this moment and MUST NOT be destroyed by
 "probing an older persisted Script certificate. After promotion/history
 "review, the immutable Script certificate remains the authority.
  DATA: lv_z659_origin TYPE c LENGTH 20,
        lv_z659_cert   TYPE abap_bool,
        lv_z696_fresh_confirm TYPE abap_bool.
  PERFORM get_projection_origin CHANGING lv_z659_origin.
  IF lv_z659_origin = 'GUIDED_RECORD'
     OR lv_z659_origin = 'SHDB_TXT'
     OR lv_z659_origin = 'SHDB_PROGRAM'.
    CLEAR: lv_z659_cert, lv_z696_fresh_confirm,
           lv_curr_action_n, lv_curr_name_n, lv_curr_tcode.

    lv_curr_tcode = p_rec_tcode.
    TRANSLATE lv_curr_tcode TO UPPER CASE.
    CONDENSE lv_curr_tcode NO-GAPS.
    DESCRIBE TABLE gt_z659_user_actions LINES lv_curr_action_n.
    DESCRIBE TABLE gt_z684_names LINES lv_curr_name_n.

    IF gt_z333_rec_evidence IS NOT INITIAL
       AND lv_curr_tcode = lv_tcode
       AND gv_z659_action_ready = abap_true
       AND gv_z684_name_ready = abap_true
       AND lv_curr_action_n > 0
       AND lv_curr_name_n = lv_curr_action_n.
      lv_z696_fresh_confirm = abap_true.
      lv_z659_cert = abap_true.
    ENDIF.

    IF lv_z696_fresh_confirm <> abap_true.
      PERFORM load_action_cert
        USING    lv_script_id lv_hash
        CHANGING lv_z659_cert.
    ENDIF.

    IF lv_z659_cert <> abap_true.
      REFRESH ct_map.
      RETURN.
    ENDIF.
  ENDIF.

  PERFORM project_user_members CHANGING lt_member.

  REFRESH lt_keep.
  LOOP AT ct_map INTO ls_map.
    IF ls_map-bdc_field IS INITIAL.
      APPEND ls_map TO lt_keep.
      CONTINUE.
    ENDIF.

    CLEAR: lv_role, lv_reason.
    PERFORM projection_role
      USING    lt_member ls_map-bdc_field
      CHANGING lv_role lv_reason.
    IF lv_role = 'DYNAMIC_PROVEN'.
      APPEND ls_map TO lt_keep.
    ENDIF.
  ENDLOOP.

  ct_map = lt_keep.
ENDFORM.

*& Simple RAW-first executable compiler

*& The SHDB recording is the source of screen truth. The compiler does not
*& interpret business meaning, transaction type, view-selection semantics or
*& field names. It preserves the recorded PROGRAM/DYNPRO/FIELD order and
*& recorded physical indices exactly. The only optional transformation is
*& repeat expansion, and that is delegated to Z16 which may parameterize an
*& index only after generic mapped multi-row proof. If no repeat is proven,
*& CLASSIFY_SCRIPT_ITEM_BLOCK marks the whole stream HEADER/EXACT.

FORM compile_raw_simple
  CHANGING ct_script TYPE ty_t_script.

  FIELD-SYMBOLS <ls_scr> TYPE ty_script_def_compat.

  IF ct_script IS INITIAL.
    RETURN.
  ENDIF.

  SORT ct_script BY step_seq.

 "Never inherit PRE/ITEM/POST classification from an older compiled plan.
 "RAW acquisition order is authoritative at every publication boundary.
  LOOP AT ct_script ASSIGNING <ls_scr>.
    <ls_scr>-row_type = gc_rt_header.
  ENDLOOP.

 "Optional capability only: Z16 leaves every unproven FIELD(01)/(02)/...
 "unchanged and emits (&IDX&) solely for a proven repeatable business row.
  PERFORM canon_item_prototypes CHANGING ct_script.
  PERFORM classify_script_item_block CHANGING ct_script.
ENDFORM.

FORM compiled_plan_ok
  USING    it_script TYPE ty_t_script
  CHANGING cv_ok     TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_scr TYPE ty_script_def_compat,
        lv_tok TYPE string,
        lv_has_item TYPE abap_bool.

  CLEAR: cv_ok, cv_message, lv_has_item.
  IF it_script IS INITIAL.
    cv_message = 'Compiled executable contract is empty.'.
    RETURN.
  ENDIF.

  lv_tok = '(' && gc_ph_index && ')'.
  LOOP AT it_script INTO ls_scr.
    IF ls_scr-field_name CS lv_tok.
      IF ls_scr-row_type <> gc_rt_item.
        cv_message =
          'Compiler invariant failed: indexed placeholder exists outside a proven repeatable segment.'.
        RETURN.
      ENDIF.
      lv_has_item = abap_true.
    ENDIF.
  ENDLOOP.

 "A contract with no repeatable segment is valid: its raw indexed controls
 "remain exact FIELD(01)/(02)/... and are never parameterized.
  cv_ok = abap_true.
ENDFORM.

*& Legacy APQI reconstruction removed

*& Runtime does not reverse-engineer old compiled contracts. Legacy profiles
*& remain audit/history. A real SHDB acquisition is onboarded once to create
*& an immutable RAW + S1 executable contract; execution then consumes it as-is.

FORM find_schema_contract
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_schema_fp TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ver       TYPE zbdc_prof_bup-profile_ver
           cv_script_id TYPE zbdc_script_bup-script_id
           cv_hash      TYPE zbdc_script_bup-contract_hash
           cv_found     TYPE abap_bool.

  DATA: lt_headers      TYPE STANDARD TABLE OF zbdc_script_bup,
        ls_header       TYPE zbdc_script_bup,
        lt_map          TYPE ty_t_mapping_db,
        lt_raw          TYPE ty_t_script,
        lv_status       TYPE zbdc_prof_bup-status,
        lv_map_rows     TYPE i,
        lv_compile_ok   TYPE abap_bool,
        lv_compile_msg  TYPE string,
        lv_mapclass_ok  TYPE abap_bool,
        lv_mapclass_msg TYPE string,
        lv_version_cfg  TYPE zbdc_config_bup-config_value,
        lv_selection_fp TYPE zbdc_script_bup-contract_hash,
        lv_selection_ok TYPE abap_bool,
        lv_selection_msg TYPE string,
        lv_identity_fp  TYPE zbdc_script_bup-contract_hash,
        lv_identity_ok  TYPE abap_bool,
        lv_identity_msg TYPE string,
        lv_raw_ok       TYPE abap_bool,
        lv_raw_msg      TYPE string.

  CLEAR: cv_ver, cv_script_id, cv_hash, cv_found.
  "Historical parameter name retained; V17.9 passes VERSION_ID_V1 here.
  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_schema_fp IS INITIAL.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_script_bup
    INTO TABLE @lt_headers
    WHERE tcode = @iv_tcode AND profile_name = @iv_profile.
  SORT lt_headers BY profile_ver DESCENDING changed_at DESCENDING.

  LOOP AT lt_headers INTO ls_header.
    IF ls_header-status = 'RESERVED'
       OR ( ls_header-status = 'INACTIVE'
            AND ls_header-recording_name = 'BLOCKED_IMPORT' ).
      CONTINUE.
    ENDIF.

    CLEAR: lv_status, lv_map_rows.
    SELECT SINGLE status FROM zbdc_prof_bup INTO @lv_status
      WHERE tcode = @ls_header-tcode
        AND profile_name = @ls_header-profile_name
        AND profile_ver = @ls_header-profile_ver.
    IF sy-subrc <> 0 OR lv_status = 'INACTIVE'.
      CONTINUE.
    ENDIF.

    SELECT COUNT(*) FROM zbdc_mapping_bup INTO @lv_map_rows
      WHERE tcode = @ls_header-tcode
        AND profile_name = @ls_header-profile_name
        AND profile_ver = @ls_header-profile_ver.
    IF lv_status <> gc_m2_prof_draft AND lv_map_rows <= 1.
      CONTINUE.
    ENDIF.

    PERFORM compiler_cert_ok USING ls_header-script_id
      CHANGING lv_compile_ok lv_compile_msg.
    IF lv_compile_ok <> abap_true.
      CONTINUE.
    ENDIF.
    PERFORM mapclass_cert_ok USING ls_header-script_id
      CHANGING lv_mapclass_ok lv_mapclass_msg.
    IF lv_mapclass_ok <> abap_true.
      CONTINUE.
    ENDIF.

    CLEAR: lv_version_cfg, lv_identity_fp, lv_identity_ok.
    PERFORM get_script_cfg USING ls_header-script_id 'VERSIONFP'
      CHANGING lv_version_cfg.
    IF lv_version_cfg IS NOT INITIAL.
      lv_identity_fp = lv_version_cfg.
      lv_identity_ok = abap_true.
    ELSE.
      REFRESH lt_map.
      SELECT * FROM zbdc_mapping_bup INTO TABLE @lt_map
        WHERE tcode = @ls_header-tcode
          AND profile_name = @ls_header-profile_name
          AND profile_ver = @ls_header-profile_ver.
      IF lt_map IS INITIAL.
        CONTINUE.
      ENDIF.

      PERFORM selection_fp_map USING ls_header-tcode lt_map
        CHANGING lv_selection_fp lv_selection_ok lv_selection_msg.
      IF lv_selection_ok <> abap_true.
        CONTINUE.
      ENDIF.

      REFRESH lt_raw.
      PERFORM load_raw_snapshot USING ls_header-tcode ls_header-script_id
        CHANGING lt_raw lv_raw_ok lv_raw_msg.
      IF lv_raw_ok <> abap_true OR lt_raw IS INITIAL.
        CONTINUE.
      ENDIF.

      PERFORM version_identity_fp USING ls_header-tcode lt_raw lv_selection_fp
        CHANGING lv_identity_fp lv_identity_ok lv_identity_msg.
      IF lv_identity_ok <> abap_true.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF lv_identity_fp <> iv_schema_fp.
      CONTINUE.
    ENDIF.

    cv_ver       = ls_header-profile_ver.
    cv_script_id = ls_header-script_id.
    cv_hash      = ls_header-contract_hash.
    cv_found     = abap_true.
    RETURN.
  ENDLOOP.
ENDFORM.

FORM mark_schema_reuse.
 "Preserve raw recording/import evidence for audit, but do not let it
 "replace the already-published Mapping/Template for the same schema.
  CLEAR gv_z240_map_locked.
  gv_z340_lock_done    = abap_true.
  gv_z133_origin       = 'SCHEMA_REUSE'.
  gv_z359_input_origin = 'SCHEMA_REUSE'.
ENDFORM.

*& Atomic schema-version reservation

*& The RESERVED header temporarily carries the semantic schema fingerprint
*& in CONTRACT_HASH. This prevents two users onboarding the same new schema
*& at the same time from consuming vN and vN+1. The owner replaces it with
*& the immutable executable contract hash when Z31 persists the script.

*& Multi-user atomic Profile/Version allocator

*& Import and Start Recording share one allocator. Serialize only the exact
*& TCODE + PROFILE decision boundary, then re-run the existing schema/version
*& checks while the mutex is owned. Different profiles remain fully parallel.

*& This lock is intentionally narrow: it protects only reuse/new-version
*& allocation. It does not lock Mapping review or execution. The existing
*& RESERVED row remains the durable ownership token after this short mutex is
*& released. Therefore a concurrent same-schema acquisition reuses or waits,
*& while a different schema receives the next version without depending on a
*& DDIC uniqueness assumption for PROFILE_VER.

FORM reserve_next_version
  USING    iv_tcode      TYPE zbdc_prof_bup-tcode
           iv_profile    TYPE zbdc_prof_bup-profile_name
           iv_origin     TYPE csequence
           iv_schema_fp  TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ver        TYPE zbdc_prof_bup-profile_ver
           cv_res_id     TYPE zbdc_script_bup-script_id
           cv_reused     TYPE abap_bool
           cv_reuse_id   TYPE zbdc_script_bup-script_id
           cv_reuse_hash TYPE zbdc_script_bup-contract_hash
           cv_ok         TYPE abap_bool
           cv_message    TYPE string.

  DATA: lv_varkey TYPE rstable-varkey,
        lv_holder TYPE syuname.

  CLEAR: cv_ver, cv_res_id, cv_reused, cv_reuse_id, cv_reuse_hash,
         cv_ok, cv_message.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_schema_fp IS INITIAL.
    cv_message =
      'TCODE, Profile and selected-field/technical Version identity is required before reserving a version.'.
    RETURN.
  ENDIF.

 "The E_TABLE key is a private mutex namespace used only by this allocator.
 "It is deliberately Profile-level, not table-wide, so unrelated Profiles
 "continue onboarding in parallel.
  CONCATENATE 'PVER' sy-mandt iv_tcode iv_profile
    INTO lv_varkey SEPARATED BY '|'.

  CALL FUNCTION 'ENQUEUE_E_TABLE'
    EXPORTING
      mode_rstable   = 'E'
      tabname        = 'ZBDC_SCRIPT_BUP'
      varkey         = lv_varkey
      _scope         = '1'
      _wait          = 'X'
    EXCEPTIONS
      foreign_lock   = 1
      system_failure = 2
      OTHERS         = 3.

  IF sy-subrc <> 0.
    lv_holder = sy-msgv1.
    IF lv_holder IS INITIAL.
      lv_holder = 'ANOTHER USER'.
    ENDIF.
    IF sy-subrc = 1.
      cv_message =
        |Profile/version allocation for { iv_tcode } / { iv_profile } is busy with { lv_holder }. No version was allocated; retry after the other onboarding step finishes.|.
    ELSE.
      cv_message =
        |Profile/version lock failed for { iv_tcode } / { iv_profile } (SY-SUBRC={ sy-subrc }). No version was allocated.|.
    ENDIF.
    RETURN.
  ENDIF.

 "Critical section: the core RECHECKS published schema, RESERVED schema and
 "MAX version after the lock is owned. Never trust a decision made before
 "the mutex was acquired.
  PERFORM reserve_ver_core
    USING    iv_tcode iv_profile iv_origin iv_schema_fp
    CHANGING cv_ver cv_res_id cv_reused cv_reuse_id cv_reuse_hash
             cv_ok cv_message.

  CALL FUNCTION 'DEQUEUE_E_TABLE'
    EXPORTING
      mode_rstable = 'E'
      tabname      = 'ZBDC_SCRIPT_BUP'
      varkey       = lv_varkey
      _scope       = '1'.
ENDFORM.

FORM reserve_ver_core
  USING    iv_tcode      TYPE zbdc_prof_bup-tcode
           iv_profile    TYPE zbdc_prof_bup-profile_name
           iv_origin     TYPE csequence
           iv_schema_fp  TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ver        TYPE zbdc_prof_bup-profile_ver
           cv_res_id     TYPE zbdc_script_bup-script_id
           cv_reused     TYPE abap_bool
           cv_reuse_id   TYPE zbdc_script_bup-script_id
           cv_reuse_hash TYPE zbdc_script_bup-contract_hash
           cv_ok         TYPE abap_bool
           cv_message    TYPE string.

  DATA: lv_prof_max   TYPE zbdc_prof_bup-profile_ver,
        lv_script_max TYPE zbdc_script_bup-profile_ver,
        lv_max        TYPE i,
        lv_ts         TYPE timestampl,
        ls_header     TYPE zbdc_script_bup,
        lv_origin     TYPE zbdc_script_bup-recording_name,
        lv_same_ver   TYPE zbdc_prof_bup-profile_ver,
        lv_same_id    TYPE zbdc_script_bup-script_id,
        lv_same_hash  TYPE zbdc_script_bup-contract_hash,
        lv_same_found TYPE abap_bool,
        lv_busy_id    TYPE zbdc_script_bup-script_id,
        lv_ver_rows   TYPE i.

  CLEAR: cv_ver, cv_res_id, cv_reused, cv_reuse_id, cv_reuse_hash,
         cv_ok, cv_message.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_schema_fp IS INITIAL.
    cv_message =
      'TCODE, Profile and selected-field/technical Version identity is required before reserving a version.'.
    RETURN.
  ENDIF.

  PERFORM find_schema_contract
    USING    iv_tcode iv_profile iv_schema_fp
    CHANGING lv_same_ver lv_same_id lv_same_hash lv_same_found.
  IF lv_same_found = abap_true.
    cv_ver        = lv_same_ver.
    cv_reused     = abap_true.
    cv_reuse_id   = lv_same_id.
    cv_reuse_hash = lv_same_hash.
    cv_ok         = abap_true.
    cv_message =
      |Version identity already exists as { iv_profile } v{ cv_ver }; version reused.|.
    RETURN.
  ENDIF.

 "Short concurrency wait for an identical schema already being published.
  DO 5 TIMES.
    CLEAR lv_busy_id.
    SELECT SINGLE script_id
      FROM zbdc_script_bup
      INTO @lv_busy_id
      WHERE tcode         = @iv_tcode
        AND profile_name  = @iv_profile
        AND status        = 'RESERVED'
        AND contract_hash = @iv_schema_fp.

    IF sy-subrc <> 0 OR lv_busy_id IS INITIAL.
      EXIT.
    ENDIF.

    WAIT UP TO 1 SECONDS.

    CLEAR: lv_same_ver, lv_same_id, lv_same_hash, lv_same_found.
    PERFORM find_schema_contract
      USING    iv_tcode iv_profile iv_schema_fp
      CHANGING lv_same_ver lv_same_id lv_same_hash lv_same_found.
    IF lv_same_found = abap_true.
      cv_ver        = lv_same_ver.
      cv_reused     = abap_true.
      cv_reuse_id   = lv_same_id.
      cv_reuse_hash = lv_same_hash.
      cv_ok         = abap_true.
      cv_message =
        |Concurrent onboarding published the same Version identity as v{ cv_ver }; version reused.|.
      RETURN.
    ENDIF.
  ENDDO.

  IF lv_busy_id IS NOT INITIAL.
    cv_message =
      'The same Version identity is currently being published by another user. Wait a few seconds and refresh; no duplicate version was created.'.
    RETURN.
  ENDIF.

  DO 20 TIMES.
    CLEAR: lv_same_ver, lv_same_id, lv_same_hash, lv_same_found.
    PERFORM find_schema_contract
      USING    iv_tcode iv_profile iv_schema_fp
      CHANGING lv_same_ver lv_same_id lv_same_hash lv_same_found.
    IF lv_same_found = abap_true.
      cv_ver        = lv_same_ver.
      cv_reused     = abap_true.
      cv_reuse_id   = lv_same_id.
      cv_reuse_hash = lv_same_hash.
      cv_ok         = abap_true.
      cv_message = |Version identity already exists as v{ cv_ver }; version reused.|.
      RETURN.
    ENDIF.

    CLEAR: lv_prof_max, lv_script_max, lv_max, ls_header, cv_res_id.

    SELECT MAX( profile_ver ) FROM zbdc_prof_bup
      INTO @lv_prof_max
      WHERE tcode = @iv_tcode AND profile_name = @iv_profile.
    SELECT MAX( profile_ver ) FROM zbdc_script_bup
      INTO @lv_script_max
      WHERE tcode = @iv_tcode AND profile_name = @iv_profile.

    lv_max = lv_prof_max.
    IF lv_script_max > lv_max.
      lv_max = lv_script_max.
    ENDIF.
    cv_ver = lv_max + 1.

    TRY.
        cv_res_id = cl_system_uuid=>create_uuid_c32_static( ).
      CATCH cx_uuid_error INTO DATA(lx_uuid).
        cv_message = lx_uuid->get_text( ).
        RETURN.
    ENDTRY.

    GET TIME STAMP FIELD lv_ts.
    lv_origin = iv_origin.
    IF lv_origin IS INITIAL.
      lv_origin = 'RESERVED'.
    ENDIF.

    ls_header-script_id      = cv_res_id.
    ls_header-tcode          = iv_tcode.
    ls_header-profile_name   = iv_profile.
    ls_header-profile_ver    = cv_ver.
    ls_header-recording_name = lv_origin.
    ls_header-status         = 'RESERVED'.
    ls_header-contract_hash  = iv_schema_fp.
    ls_header-created_by     = sy-uname.
    ls_header-created_at     = lv_ts.
    ls_header-changed_by     = sy-uname.
    ls_header-changed_at     = lv_ts.

    INSERT zbdc_script_bup FROM @ls_header.
    IF sy-subrc = 0.
 "invariant: do not depend on the unknown DDIC primary-key shape.
 "After our insert, exactly one Script Header may own this Profile Version.
 "If legacy/concurrent code created another row with the same tuple, roll
 "back our reservation and retry from the new MAX instead of publishing a
 "duplicate user-facing version number.
      CLEAR lv_ver_rows.
      SELECT COUNT(*)
        FROM zbdc_script_bup
        INTO @lv_ver_rows
        WHERE tcode        = @iv_tcode
          AND profile_name = @iv_profile
          AND profile_ver  = @cv_ver.

      IF lv_ver_rows = 1.
        COMMIT WORK AND WAIT.
        gv_z133_reservation_id = cv_res_id.
        cv_ok = abap_true.
        cv_message =
          |New contract version v{ cv_ver } reserved atomically for { iv_tcode } / { iv_profile }.|.
        RETURN.
      ENDIF.

      ROLLBACK WORK.
      CLEAR: cv_ver, cv_res_id.
      CONTINUE.
    ENDIF.

    ROLLBACK WORK.
  ENDDO.

  cv_message =
    |A new contract version could not be reserved for { iv_tcode } / { iv_profile } after concurrent retries.|.
ENDFORM.

FORM release_reservation
  USING iv_res_id TYPE zbdc_script_bup-script_id.
  IF iv_res_id IS INITIAL.
    RETURN.
  ENDIF.

  DELETE FROM zbdc_script_bup
    WHERE script_id = @iv_res_id
      AND status = 'RESERVED'
      AND changed_by = @sy-uname.
  IF sy-subrc = 0.
    COMMIT WORK AND WAIT.
  ENDIF.
  IF gv_z133_reservation_id = iv_res_id.
    CLEAR gv_z133_reservation_id.
  ENDIF.
ENDFORM.

FORM auto_profile_name
  USING    iv_tcode TYPE zbdc_prof_bup-tcode
           iv_fp    TYPE zbdc_script_bup-contract_hash
  CHANGING cv_profile TYPE zbdc_prof_bup-profile_name.

  DATA: lv_base  TYPE string,
        lv_fp    TYPE string,
        lv_short TYPE string,
        lv_char  TYPE c LENGTH 1,
        lv_off   TYPE i.

  CLEAR cv_profile.
  lv_base = iv_tcode.
  TRANSLATE lv_base TO UPPER CASE.
  CONDENSE lv_base NO-GAPS.
  IF strlen( lv_base ) > 16.
    lv_base = lv_base(16).
  ENDIF.

  lv_fp = iv_fp.
  DO strlen( lv_fp ) TIMES.
    lv_off = sy-index - 1.
    lv_char = lv_fp+lv_off(1).
    IF lv_char CO 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'.
      lv_short = lv_short && lv_char.
      IF strlen( lv_short ) >= 8.
        EXIT.
      ENDIF.
    ENDIF.
  ENDDO.

  WHILE strlen( lv_short ) < 8.
    lv_short = lv_short && '0'.
  ENDWHILE.
  TRANSLATE lv_short TO UPPER CASE.

  cv_profile = |{ lv_base }_AUTO_{ lv_short }|.
ENDFORM.

FORM resolve_profile_fp
  USING    iv_tcode  TYPE zbdc_prof_bup-tcode
           it_script TYPE ty_t_script
  CHANGING cv_profile TYPE zbdc_prof_bup-profile_name
           cv_ver     TYPE zbdc_prof_bup-profile_ver
           cv_ref_ver TYPE zbdc_prof_bup-profile_ver
           cv_is_new  TYPE abap_bool
           cv_fp      TYPE zbdc_script_bup-contract_hash
           cv_ok      TYPE abap_bool
           cv_message TYPE string.

  TYPES: BEGIN OF ty_candidate,
           profile_name   TYPE zbdc_prof_bup-profile_name,
           ref_ver        TYPE zbdc_prof_bup-profile_ver,
           match_rank     TYPE i,
           match_pct      TYPE i,
           field_gap      TYPE i,
           lifecycle_score TYPE i,
         END OF ty_candidate.

  DATA: lt_headers       TYPE STANDARD TABLE OF zbdc_script_bup,
        ls_header        TYPE zbdc_script_bup,
        lt_profiles      TYPE STANDARD TABLE OF zbdc_prof_bup,
        ls_profile       TYPE zbdc_prof_bup,
        lt_certs         TYPE STANDARD TABLE OF zbdc_cert_bup,
        ls_cert          TYPE zbdc_cert_bup,
        lt_loaded        TYPE ty_t_script,
        lv_script_id     TYPE zbdc_script_bup-script_id,
        lv_header_hash   TYPE zbdc_script_bup-contract_hash,
        lv_loaded        TYPE abap_bool,
        lv_candidate_fp  TYPE zbdc_script_bup-contract_hash,
        lv_fp_ok         TYPE abap_bool,
        lv_fp_msg        TYPE string,
        lt_candidates    TYPE STANDARD TABLE OF ty_candidate,
        ls_candidate     TYPE ty_candidate,
        ls_second        TYPE ty_candidate,
        lv_lifecycle     TYPE i,
        lv_status_score  TYPE i,
        lt_input_fields  TYPE ty_t_missing_bdc,
        lt_cand_fields   TYPE ty_t_missing_bdc,
        lv_input_count   TYPE i,
        lv_cand_count    TYPE i,
        lv_intersection  TYPE i,
        lv_union         TYPE i,
        lv_min_count     TYPE i,
        lv_max_count     TYPE i,
        lv_similarity    TYPE i,
        lv_match_rank    TYPE i,
        lv_field_gap     TYPE i,
        lv_field         TYPE zbdc_mapping_bup-bdc_field,
        lv_better        TYPE abap_bool,
        lv_profile_found TYPE abap_bool,
        lv_tie_resolved  TYPE abap_bool.

  FIELD-SYMBOLS <ls_candidate> TYPE ty_candidate.

  CLEAR: cv_profile, cv_ver, cv_ref_ver, cv_is_new,
         cv_fp, cv_ok, cv_message.

  PERFORM script_fingerprint
    USING    iv_tcode it_script
    CHANGING cv_fp lv_fp_ok lv_fp_msg.
  IF lv_fp_ok <> abap_true.
    cv_message = lv_fp_msg.
    RETURN.
  ENDIF.

  PERFORM collect_scenario_fields
    USING    it_script
    CHANGING lt_input_fields.
  lv_input_count = lines( lt_input_fields ).

  SELECT * FROM zbdc_script_bup
    INTO TABLE @lt_headers
    WHERE tcode = @iv_tcode.
  SELECT * FROM zbdc_prof_bup
    INTO TABLE @lt_profiles
    WHERE tcode = @iv_tcode.
  SELECT * FROM zbdc_cert_bup
    INTO TABLE @lt_certs
    WHERE tcode = @iv_tcode.

  LOOP AT lt_headers INTO ls_header.
    CLEAR: lt_loaded, lv_script_id, lv_header_hash, lv_loaded,
           lv_candidate_fp, lv_fp_ok, lv_fp_msg,
           lt_cand_fields, lv_cand_count, lv_intersection,
           lv_union, lv_min_count, lv_max_count,
           lv_similarity, lv_match_rank, lv_field_gap,
           lv_lifecycle, lv_status_score, ls_profile.

    CLEAR lv_profile_found.
    READ TABLE lt_profiles INTO ls_profile
      WITH KEY profile_name = ls_header-profile_name
               profile_ver  = ls_header-profile_ver.
    IF sy-subrc = 0.
      lv_profile_found = abap_true.
    ENDIF.

 "Blocked audit versions are not executable scenario references.
    IF ( ls_header-status = 'INACTIVE'
         AND ls_header-recording_name = 'BLOCKED_IMPORT' )
       OR ( lv_profile_found = abap_true
            AND ls_profile-status = 'INACTIVE'
            AND ls_profile-description CP 'BLOCKED:*' ).
      CONTINUE.
    ENDIF.

    PERFORM load_profile_script
      USING    ls_header-tcode ls_header-profile_name ls_header-profile_ver
      CHANGING lt_loaded lv_script_id lv_header_hash lv_loaded.
    IF lv_loaded <> abap_true.
      CONTINUE.
    ENDIF.

    PERFORM script_fingerprint
      USING    iv_tcode lt_loaded
      CHANGING lv_candidate_fp lv_fp_ok lv_fp_msg.
    IF lv_fp_ok <> abap_true.
      CONTINUE.
    ENDIF.

    IF lv_candidate_fp = cv_fp.
 "Exact canonical business-field identity.
      lv_match_rank = 2.
      lv_similarity = 100.
      CLEAR lv_field_gap.
    ELSE.
 "Generic fuzzy reconciliation for recorder-source differences:
 "one logical field set must fully contain the other and the union must
 "still share at least 75 percent. This accepts a small capture omission
 "such as 11/13, but never guesses across partially overlapping scenarios.
      PERFORM collect_scenario_fields
        USING    lt_loaded
        CHANGING lt_cand_fields.
      lv_cand_count = lines( lt_cand_fields ).

      IF lv_input_count < gc_m2_scn_min_fields OR lv_cand_count < gc_m2_scn_min_fields.
        CONTINUE.
      ENDIF.

      LOOP AT lt_input_fields INTO lv_field.
        READ TABLE lt_cand_fields
          WITH TABLE KEY table_line = lv_field
          TRANSPORTING NO FIELDS.
        IF sy-subrc = 0.
          lv_intersection = lv_intersection + 1.
        ENDIF.
      ENDLOOP.

      IF lv_input_count <= lv_cand_count.
        lv_min_count = lv_input_count.
        lv_max_count = lv_cand_count.
      ELSE.
        lv_min_count = lv_cand_count.
        lv_max_count = lv_input_count.
      ENDIF.

 "Require strict subset/superset containment. A partial overlap is
 "ambiguous and must not merge two business scenarios.
      IF lv_intersection <> lv_min_count.
        CONTINUE.
      ENDIF.

      lv_union = lv_input_count + lv_cand_count - lv_intersection.
      IF lv_union <= 0.
        CONTINUE.
      ENDIF.

      lv_similarity = ( lv_intersection * 100 ) / lv_union.
      IF lv_similarity < gc_m2_scn_min_overlap.
        CONTINUE.
      ENDIF.

      lv_match_rank = 1.
      lv_field_gap  = lv_max_count - lv_min_count.
    ENDIF.

 "Rank lifecycle evidence for this exact candidate version.
    LOOP AT lt_certs INTO ls_cert
      WHERE profile_name   = ls_header-profile_name
        AND profile_ver    = ls_header-profile_ver
        AND script_id      = ls_header-script_id
        AND contract_hash  = ls_header-contract_hash
        AND cert_status    = 'CERTIFIED'
        AND last_test_status = 'CERTIFIED'.
      lv_lifecycle = 500.
      EXIT.
    ENDLOOP.

    IF lv_lifecycle = 0 AND lv_profile_found = abap_true.
      CASE ls_profile-status.
        WHEN gc_m2_prof_active.
          lv_status_score = 400.
        WHEN 'TESTING'.
          lv_status_score = 300.
        WHEN gc_m2_prof_mapped.
          lv_status_score = 200.
        WHEN gc_m2_prof_draft.
          lv_status_score = 100.
        WHEN 'INACTIVE'.
          lv_status_score = 50.
        WHEN OTHERS.
          lv_status_score = 10.
      ENDCASE.
      lv_lifecycle = lv_status_score.
    ENDIF.

    READ TABLE lt_candidates ASSIGNING <ls_candidate>
      WITH KEY profile_name = ls_header-profile_name.
    IF sy-subrc <> 0.
      CLEAR ls_candidate.
      ls_candidate-profile_name    = ls_header-profile_name.
      ls_candidate-ref_ver         = ls_header-profile_ver.
      ls_candidate-match_rank      = lv_match_rank.
      ls_candidate-match_pct       = lv_similarity.
      ls_candidate-field_gap       = lv_field_gap.
      ls_candidate-lifecycle_score = lv_lifecycle.
      APPEND ls_candidate TO lt_candidates.
      CONTINUE.
    ENDIF.

    CLEAR lv_better.
    IF lv_match_rank > <ls_candidate>-match_rank.
      lv_better = abap_true.
    ELSEIF lv_match_rank = <ls_candidate>-match_rank.
      IF lv_similarity > <ls_candidate>-match_pct.
        lv_better = abap_true.
      ELSEIF lv_similarity = <ls_candidate>-match_pct.
        IF lv_field_gap < <ls_candidate>-field_gap.
          lv_better = abap_true.
        ELSEIF lv_field_gap = <ls_candidate>-field_gap.
          IF lv_lifecycle > <ls_candidate>-lifecycle_score.
            lv_better = abap_true.
          ELSEIF lv_lifecycle = <ls_candidate>-lifecycle_score
             AND ls_header-profile_ver > <ls_candidate>-ref_ver.
            lv_better = abap_true.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lv_better = abap_true.
      <ls_candidate>-ref_ver         = ls_header-profile_ver.
      <ls_candidate>-match_rank      = lv_match_rank.
      <ls_candidate>-match_pct       = lv_similarity.
      <ls_candidate>-field_gap       = lv_field_gap.
      <ls_candidate>-lifecycle_score = lv_lifecycle.
    ENDIF.
  ENDLOOP.

  IF lt_candidates IS NOT INITIAL.
    SORT lt_candidates BY match_rank DESCENDING
                          match_pct DESCENDING
                          field_gap ASCENDING
                          lifecycle_score DESCENDING
                          ref_ver DESCENDING
                          profile_name ASCENDING.

    READ TABLE lt_candidates INTO ls_candidate INDEX 1.

 "this resolver is used by Recording Manager / SHDB Import,
 "where the current import/recording already provides the acquisition
 "context. Ambiguous auto-detect must only block end-user upload routing,
 "not onboarding. If historical draft/profile versions have identical
 "canonical coverage, choose the deterministic top-ranked tuple after the
 "sort above and let the caller pin that exact profile/version/hash. This
 "is data-driven and does not use any TCODE, table or field hardcode.
    CLEAR lv_tie_resolved.
    READ TABLE lt_candidates INTO ls_second INDEX 2.
    IF sy-subrc = 0
       AND ls_second-match_rank = ls_candidate-match_rank
       AND ls_second-match_pct  = ls_candidate-match_pct
       AND ls_second-field_gap  = ls_candidate-field_gap.
      lv_tie_resolved = abap_true.
    ENDIF.

    cv_profile = ls_candidate-profile_name.
    cv_ref_ver = ls_candidate-ref_ver.
    CLEAR cv_ver. "reserve only after duplicate/reconcile decision.

    cv_is_new = abap_false.
    cv_ok = abap_true.
    IF lv_tie_resolved = abap_true.
      cv_message =
        |Multiple matching onboarding candidates existed; deterministic pinned contract { cv_profile } v{ cv_ref_ver } was selected.|.
    ELSEIF ls_candidate-match_rank = 2.
      cv_message = 'Existing scenario configuration detected by canonical business-field identity.'.
    ELSE.
      cv_message =
        |Existing scenario configuration reconciled by complete subset coverage ({ ls_candidate-match_pct }%).|.
    ENDIF.
    RETURN.
  ENDIF.

  PERFORM auto_profile_name
    USING    iv_tcode cv_fp
    CHANGING cv_profile.
  IF cv_profile IS INITIAL.
    cv_message = 'A safe automatic profile name could not be generated.'.
    RETURN.
  ENDIF.

  CLEAR cv_ver. "new scenario receives an atomic reservation in z70.

  CLEAR cv_ref_ver.
  cv_is_new = abap_true.
  cv_ok = abap_true.
  cv_message = 'New scenario configuration detected automatically.'.
ENDFORM.

*& Blocked import persistence + exact-version UI isolation

FORM get_mapping_ui_state
  CHANGING cv_readonly TYPE abap_bool
           cv_message  TYPE string.

  DATA: lv_tcode   TYPE zbdc_prof_bup-tcode,
        lv_profile TYPE zbdc_prof_bup-profile_name,
        lv_ver     TYPE zbdc_prof_bup-profile_ver,
        lv_ok      TYPE abap_bool,
        lv_status  TYPE zbdc_prof_bup-status,
        lv_desc    TYPE zbdc_prof_bup-description,
        lv_fresh_acq TYPE abap_bool,
        lv_origin    TYPE c LENGTH 20.

  CLEAR: cv_readonly, cv_message, lv_fresh_acq.

 "a fresh Import/Start Recording owns the Mapping candidate even
 "when its raw script fingerprint resolves to an already MAPPED/TESTING/
 "ACTIVE profile version. The existing stable tuple may contain an older
 "Field Guide produced by the previous classifier. Do not let PBO reload
 "that historical Mapping and overwrite the newly rebuilt candidate.
 "Both acquisition paths preserve their raw evidence in the same globals.
  PERFORM get_projection_origin CHANGING lv_origin.
  IF gt_z333_rec_evidence IS NOT INITIAL
     AND ( lv_origin = 'GUIDED_RECORD'
        OR lv_origin = 'SHDB_TXT'
        OR lv_origin = 'SHDB_PROGRAM' ).
    lv_fresh_acq = abap_true.
  ENDIF.

 "once a Candidate Review was locked during this dialog, no later
 "PBO/guard may treat the same screen as evidence-only again.
  IF gv_z340_lock_done = abap_true.
    CLEAR gv_z240_map_locked.
    gv_z133_origin = 'LOCKED_CONTRACT'.
  ENDIF.

 "after the user confirms Lock Candidate Mapping Contract, stale
 "candidate-mode flags must not keep the screen/readiness guard in
 "evidence-only mode. Promote/lock writes the exact tuple as MAPPED; if the
 "current Mapping rows already point to a stable tuple, clear the in-memory
 "candidate flag before applying the normal guard.
  IF gv_z240_map_locked = abap_true
     AND gt_mapping_screen IS NOT INITIAL
     AND lv_fresh_acq <> abap_true.
    READ TABLE gt_mapping_screen INTO DATA(ls_z339_map_ctx) INDEX 1.
    IF sy-subrc = 0
       AND ls_z339_map_ctx-tcode IS NOT INITIAL
       AND ls_z339_map_ctx-profile_name IS NOT INITIAL
       AND ls_z339_map_ctx-profile_ver IS NOT INITIAL.
      SELECT SINGLE status
        FROM zbdc_prof_bup
        INTO @DATA(lv_z339_status)
        WHERE tcode        = @ls_z339_map_ctx-tcode
          AND profile_name = @ls_z339_map_ctx-profile_name
          AND profile_ver  = @ls_z339_map_ctx-profile_ver.
      IF sy-subrc = 0
         AND ( lv_z339_status = gc_m2_prof_mapped
            OR lv_z339_status = 'TESTING'
            OR lv_z339_status = gc_m2_prof_active ).
        CLEAR gv_z240_map_locked.
        gv_z133_origin = 'LOCKED_CONTRACT'.
      ENDIF.
    ENDIF.
  ENDIF.

 "Candidate Mapping Review is evidence-only. When Mapping was
 "opened from TXT_ONLY/GUIDED_ONLY rows, gv_z240_map_locked stays true and
 "gt_mapping_screen is only a preview projection. Any mutating or official
 "artifact action must stop here with a user-level message instead of falling
 "through to the exact-contract resolver and showing low-level errors such as
 "'No executable script header exists ...'.
  IF gv_z240_map_locked = abap_true
     AND gt_mapping_screen IS NOT INITIAL.
 "this includes fresh Import/Start candidates that happen to match
 "an existing stable version. Keep the in-memory rebuilt field set visible
 "until Generate Template explicitly promotes it; LOAD_MAPPING_SCREEN must
 "not replace it with the old repository rows during PBO.
    cv_readonly = abap_true.
    cv_message =
      'Mapping is ready. Review the fields, then press Generate Template.'.
    RETURN.
  ENDIF.

  PERFORM resolve_mapping_config_context
    CHANGING lv_tcode lv_profile lv_ver lv_ok.
  IF lv_ok <> abap_true.
    RETURN.
  ENDIF.

  SELECT SINGLE status, description
    FROM zbdc_prof_bup
    INTO (@lv_status, @lv_desc)
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  IF lv_status = 'INACTIVE'.
    cv_readonly = abap_true.
    IF lv_desc CP 'BLOCKED:*'.
      cv_message = |{ lv_desc } Profile { lv_profile } v{ lv_ver } is read-only; no executable mapping/template is available.|.
      IF cv_message IS INITIAL.
        cv_message = 'Blocked onboarding version: no executable mapping exists.'.
      ENDIF.
    ELSE.
      cv_message =
        |Historical INACTIVE profile { lv_profile } v{ lv_ver } is read-only; Activate/Generate/Save are blocked.|.
    ENDIF.
  ENDIF.
ENDFORM.

FORM guard_mapping_action
  USING    iv_action  TYPE any
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA lv_readonly TYPE abap_bool.

  CLEAR: cv_ok, cv_message.
  PERFORM get_mapping_ui_state
    CHANGING lv_readonly cv_message.

  IF lv_readonly = abap_true.
    IF cv_message IS INITIAL.
      cv_message = |Action { iv_action } is blocked for this read-only profile version.|.
    ENDIF.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

*& Mapping context boundary for Import and Guided Recording

*& One place owns the exact UI/runtime Mapping tuple. Import TXT, Guided
*& Recording, My Import and All Import all pin context through this routine.
*& Stale Upload/Preview globals are cleared before onboarding and never used
*& as profile/version evidence.

FORM clear_map_context.
  CLEAR: txtp_profile_name,
         gv_profile_ver,
         gv_runtime_script_id,
         gv_runtime_contract_hash.
  gv_z240_map_locked = abap_true.
  CLEAR gv_z340_lock_done.
  REFRESH: gt_script_def,
           gt_mapping_screen.
ENDFORM.

FORM apply_map_context
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_ver       TYPE zbdc_prof_bup-profile_ver
           iv_script_id TYPE zbdc_script_bup-script_id
           iv_hash      TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lt_script    TYPE ty_t_script,
        lv_script_id TYPE zbdc_script_bup-script_id,
        lv_hash      TYPE zbdc_script_bup-contract_hash,
        lv_found     TYPE abap_bool.

  CLEAR: cv_ok, cv_message.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_ver IS INITIAL
     OR iv_script_id IS INITIAL OR iv_hash IS INITIAL.
    cv_message = 'Exact TCODE/Profile/Version/Script/Hash context is required.'.
    RETURN.
  ENDIF.

  PERFORM load_script_id
    USING    iv_tcode iv_profile iv_ver iv_script_id
    CHANGING lt_script lv_hash lv_found.
  IF lv_found <> abap_true OR lt_script IS INITIAL.
    cv_message = 'Exact Mapping script snapshot could not be loaded by Script ID.'.
    RETURN.
  ENDIF.

  lv_script_id = iv_script_id.

  IF lv_hash <> iv_hash.
    cv_message = 'Resolved contract hash differs from the onboarding contract hash.'.
    RETURN.
  ENDIF.

  p_rec_tcode              = iv_tcode.
  p_transaction            = iv_tcode.
  txtp_profile_name        = iv_profile.
  gv_profile_ver           = iv_ver.
  gv_runtime_script_id     = lv_script_id.
  gv_runtime_contract_hash = lv_hash.
  gt_script_def            = lt_script.

 "the exact Mapping-context boundary must also own the optimistic
 "lock baseline. Fresh Import/Start Recording can resolve an existing
 "exact tuple and then rebuild an in-memory user-entry candidate.
 "correctly keeps that candidate on 0350, so LOAD_MAPPING_SCREEN no longer
 "runs and therefore cannot refresh GV_Z133_LOADED_*. Without this pin,
 "Generate Template compares the current repository header with a stale
 "snapshot from an older context and reports a self-created version
 "collision. Read the baseline from the same exact Script ID/Hash that
 "was just verified above. A later external change still changes the DB
 "ID/hash and remains fail-closed in persist_profile_script.
  CLEAR: gv_z133_loaded_script_id, gv_z133_loaded_hash,
         gv_z133_loaded_changed_at.
  SELECT SINGLE script_id, contract_hash, changed_at
    FROM zbdc_script_bup
    INTO (@gv_z133_loaded_script_id, @gv_z133_loaded_hash,
          @gv_z133_loaded_changed_at)
    WHERE tcode         = @iv_tcode
      AND profile_name  = @iv_profile
      AND profile_ver   = @iv_ver
      AND script_id     = @lv_script_id
      AND contract_hash = @lv_hash.

  IF sy-subrc <> 0.
    CLEAR: gv_z133_loaded_script_id, gv_z133_loaded_hash,
           gv_z133_loaded_changed_at.
    cv_message =
      'Exact Mapping concurrency baseline could not be pinned; refresh the contract and try again.'.
    RETURN.
  ENDIF.

  CLEAR gv_z240_map_locked.
  cv_ok = abap_true.
ENDFORM.

*& Exact contract identity lookup

*& Searches persisted contracts by canonical technical fingerprint only.
*& No acquisition origin is accepted. Lifecycle evidence is used solely as a
*& deterministic tie-breaker when historical duplicate versions already exist.

FORM find_exact_contract_ref
  USING    iv_tcode          TYPE zbdc_prof_bup-tcode
           iv_in_contract_fp TYPE zbdc_script_bup-contract_hash
  CHANGING cv_profile        TYPE zbdc_prof_bup-profile_name
           cv_ver            TYPE zbdc_prof_bup-profile_ver
           ct_reference      TYPE ty_t_script
           cv_script_id      TYPE zbdc_script_bup-script_id
           cv_hash           TYPE zbdc_script_bup-contract_hash
           cv_found          TYPE abap_bool
           cv_ambiguous      TYPE abap_bool.

  DATA: lt_headers      TYPE STANDARD TABLE OF zbdc_script_bup,
        ls_header       TYPE zbdc_script_bup,
        lt_profiles     TYPE STANDARD TABLE OF zbdc_prof_bup,
        ls_profile      TYPE zbdc_prof_bup,
        lt_certs        TYPE STANDARD TABLE OF zbdc_cert_bup,
        ls_cert         TYPE zbdc_cert_bup,
        lt_loaded       TYPE ty_t_script,
        lv_loaded_id    TYPE zbdc_script_bup-script_id,
        lv_loaded_hash  TYPE zbdc_script_bup-contract_hash,
        lv_loaded       TYPE abap_bool,
        lv_candidate_fp TYPE zbdc_script_bup-contract_hash,
        lv_fp_ok        TYPE abap_bool,
        lv_fp_msg       TYPE string,
        lv_score        TYPE i,
        lv_best_score   TYPE i,
        lv_best_ver     TYPE zbdc_prof_bup-profile_ver,
        lv_best_profile TYPE zbdc_prof_bup-profile_name,
        lv_best_script_id TYPE zbdc_script_bup-script_id,
        lv_best_hash      TYPE zbdc_script_bup-contract_hash,
        lv_best_changed   TYPE zbdc_script_bup-changed_at,
        lv_take           TYPE abap_bool.

  CLEAR: cv_profile, cv_ver, cv_script_id, cv_hash, cv_found, cv_ambiguous.
  REFRESH ct_reference.

  IF iv_tcode IS INITIAL OR iv_in_contract_fp IS INITIAL.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_script_bup
    INTO TABLE @lt_headers
    WHERE tcode = @iv_tcode.
  IF lt_headers IS INITIAL.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_prof_bup
    INTO TABLE @lt_profiles
    WHERE tcode = @iv_tcode.
  SELECT * FROM zbdc_cert_bup
    INTO TABLE @lt_certs
    WHERE tcode = @iv_tcode.

  LOOP AT lt_headers INTO ls_header.
    IF ls_header-status = 'RESERVED'
       OR ( ls_header-status = 'INACTIVE'
            AND ls_header-recording_name = 'BLOCKED_IMPORT' ).
      CONTINUE.
    ENDIF.

    REFRESH lt_loaded.
    CLEAR: lv_loaded_id, lv_loaded_hash, lv_loaded,
           lv_candidate_fp, lv_fp_ok, lv_fp_msg, lv_score,
           ls_profile, lv_take.

    PERFORM load_script_id
      USING    ls_header-tcode ls_header-profile_name ls_header-profile_ver
               ls_header-script_id
      CHANGING lt_loaded lv_loaded_hash lv_loaded.
    IF lv_loaded <> abap_true OR lv_loaded_hash <> ls_header-contract_hash.
      CONTINUE.
    ENDIF.
    lv_loaded_id = ls_header-script_id.

    PERFORM script_contract_fp
      USING    iv_tcode lt_loaded
      CHANGING lv_candidate_fp lv_fp_ok lv_fp_msg.
    IF lv_fp_ok <> abap_true OR lv_candidate_fp <> iv_in_contract_fp.
      CONTINUE.
    ENDIF.

 "Exact duplicate contracts can exist after repeated onboarding attempts.
 "That is a registry hygiene issue, not a reason to block Start/Import.
 "Resolve deterministically by evidence strength, then lifecycle, then the
 "newest changed tuple and version. No TCODE/rule/profile name is hardcoded.
    LOOP AT lt_certs INTO ls_cert
      WHERE profile_name     = ls_header-profile_name
        AND profile_ver      = ls_header-profile_ver
        AND script_id        = ls_header-script_id
        AND contract_hash    = ls_header-contract_hash
        AND cert_status      = 'CERTIFIED'
        AND last_test_status = 'CERTIFIED'.
      lv_score = 500.
      EXIT.
    ENDLOOP.

    IF lv_score = 0.
      READ TABLE lt_profiles INTO ls_profile
        WITH KEY profile_name = ls_header-profile_name
                 profile_ver  = ls_header-profile_ver.
      IF sy-subrc = 0.
        CASE ls_profile-status.
          WHEN gc_m2_prof_active.
            lv_score = 400.
          WHEN 'TESTING'.
            lv_score = 300.
          WHEN gc_m2_prof_mapped.
            lv_score = 200.
          WHEN gc_m2_prof_draft.
            lv_score = 100.
          WHEN OTHERS.
            lv_score = 10.
        ENDCASE.
      ELSE.
        lv_score = 1.
      ENDIF.
    ENDIF.

    IF lv_best_profile IS INITIAL.
      lv_take = abap_true.
    ELSEIF lv_score > lv_best_score.
      lv_take = abap_true.
    ELSEIF lv_score = lv_best_score.
      IF ls_header-changed_at > lv_best_changed.
        lv_take = abap_true.
      ELSEIF ls_header-changed_at = lv_best_changed.
        IF ls_header-profile_ver > lv_best_ver.
          lv_take = abap_true.
        ELSEIF ls_header-profile_ver = lv_best_ver AND
               ls_header-script_id > lv_best_script_id.
          lv_take = abap_true.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lv_take = abap_true.
      lv_best_profile   = ls_header-profile_name.
      lv_best_ver       = ls_header-profile_ver.
      lv_best_script_id = ls_header-script_id.
      lv_best_hash      = ls_header-contract_hash.
      lv_best_changed   = ls_header-changed_at.
      lv_best_score     = lv_score.
    ENDIF.
  ENDLOOP.

  IF lv_best_profile IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM load_script_id
    USING    iv_tcode lv_best_profile lv_best_ver lv_best_script_id
    CHANGING ct_reference cv_hash cv_found.
  IF cv_found = abap_true AND cv_hash = lv_best_hash.
    cv_profile   = lv_best_profile.
    cv_ver       = lv_best_ver.
    cv_script_id = lv_best_script_id.
  ELSE.
    CLEAR: cv_found, cv_profile, cv_ver, cv_script_id, cv_hash.
    REFRESH ct_reference.
  ENDIF.
ENDFORM.

*& Source-neutral canonical contract resolver

*& Acquisition adapters remain independent:
*& Guided Recording supplies captured BDC steps.
*& SHDB TXT supplies parsed export steps.
*& This resolver receives only a canonical recording contract. It has no
*& origin parameter, so acquisition source cannot influence Profile/Version,
*& completeness, duplicate detection, or the Mapping context.
FORM resolve_contract
  USING    iv_tcode    TYPE zbdc_prof_bup-tcode
           it_incoming TYPE ty_t_script
  CHANGING cs_result   TYPE ty_contract_resolution.

  DATA: lv_candidate_ver TYPE zbdc_prof_bup-profile_ver,
        lv_match_ref_ver TYPE zbdc_prof_bup-profile_ver,
        lv_resolve_ok    TYPE abap_bool,
        lv_resolve_msg   TYPE string,
        lv_loaded        TYPE abap_bool,
        lv_ref_contract_fp TYPE zbdc_script_bup-contract_hash,
        lv_fp_ok         TYPE abap_bool,
        lv_fp_msg        TYPE string,
        lv_exact_ambiguous TYPE abap_bool,
        lv_msg_ref_ver TYPE string,
        lv_msg_missing TYPE string.

  CLEAR: cs_result-profile, cs_result-ref_ver, cs_result-is_new,
         cs_result-semantic_fp, cs_result-in_contract_fp,
         cs_result-ref_script_id, cs_result-ref_hash,
         cs_result-complete, cs_result-missing, cs_result-missing_list,
         cs_result-exact, cs_result-ok, cs_result-message.
  REFRESH cs_result-reference.

  IF iv_tcode IS INITIAL OR it_incoming IS INITIAL.
    cs_result-message = 'TCODE and canonical recording steps are required.'.
    RETURN.
  ENDIF.

 "Both identities are calculated before registry resolution and neither
 "receives acquisition origin.
  PERFORM script_fingerprint
    USING    iv_tcode it_incoming
    CHANGING cs_result-semantic_fp lv_fp_ok lv_fp_msg.
  IF lv_fp_ok <> abap_true.
    cs_result-message = lv_fp_msg.
    RETURN.
  ENDIF.

  PERFORM script_contract_fp
    USING    iv_tcode it_incoming
    CHANGING cs_result-in_contract_fp lv_fp_ok lv_fp_msg.
  IF lv_fp_ok <> abap_true.
    cs_result-message = lv_fp_msg.
    RETURN.
  ENDIF.

 "Exact technical identity has priority over semantic reconciliation. This
 "makes repeated evidence idempotent even if historical duplicate versions
 "already exist.
  PERFORM find_exact_contract_ref
    USING    iv_tcode cs_result-in_contract_fp
    CHANGING cs_result-profile cs_result-ref_ver cs_result-reference
             cs_result-ref_script_id cs_result-ref_hash cs_result-exact lv_exact_ambiguous.
  IF lv_exact_ambiguous = abap_true.
 "Duplicate exact contracts are not a business ambiguity; the resolver
 "must choose a deterministic canonical tuple or return no match. This
 "branch remains for backward compatibility with older helper versions.
    CLEAR lv_exact_ambiguous.
  ENDIF.
  IF cs_result-exact = abap_true.
    cs_result-complete = abap_true.
    cs_result-ok = abap_true.
    cs_result-message =
      |Exact canonical contract { cs_result-profile } v{ cs_result-ref_ver } was found.|.
    RETURN.
  ENDIF.

 "No exact contract exists: resolve the business scenario generically.
  PERFORM resolve_profile_fp
    USING    iv_tcode it_incoming
    CHANGING cs_result-profile lv_candidate_ver lv_match_ref_ver
             cs_result-is_new cs_result-semantic_fp lv_resolve_ok lv_resolve_msg.
  IF lv_resolve_ok <> abap_true.
    cs_result-message = lv_resolve_msg.
    RETURN.
  ENDIF.

  IF cs_result-is_new = abap_true.
    cs_result-complete = abap_true.
    cs_result-ok = abap_true.
    cs_result-message = 'New canonical scenario configuration detected.'.
    RETURN.
  ENDIF.

  IF lv_match_ref_ver IS INITIAL.
    cs_result-message = 'Canonical scenario resolution did not return an exact reference version.'.
    RETURN.
  ENDIF.

  PERFORM load_profile_script
    USING    iv_tcode cs_result-profile lv_match_ref_ver
    CHANGING cs_result-reference cs_result-ref_script_id cs_result-ref_hash lv_loaded.
  IF lv_loaded <> abap_true OR cs_result-reference IS INITIAL.
    cs_result-message =
      |Reference contract { cs_result-profile } v{ lv_match_ref_ver } could not be loaded.|.
    RETURN.
  ENDIF.
  cs_result-ref_ver = lv_match_ref_ver.

 "A smaller capture is invalid evidence. Never merge missing fields from the
 "reference and never turn an incomplete recording into a successful result.
  PERFORM check_ref_completeness
    USING    it_incoming cs_result-reference
    CHANGING cs_result-complete cs_result-missing cs_result-missing_list.
  IF cs_result-complete <> abap_true.
 "a partial acquisition is not publishable evidence, but when a
 "stable reference contract exists it should not trap the user in 0800.
 "Keep the persisted mapping/version immutable and let the caller reopen
 "that exact reference context. No field, rule, profile, TCODE, or origin
 "is hardcoded here; the decision depends only on the resolved contract.
    lv_msg_ref_ver = cs_result-ref_ver.
    lv_msg_missing = cs_result-missing.

    cs_result-ok = abap_true.
    cs_result-exact = abap_false.
    CONCATENATE
      'Captured recording is incomplete for resolved profile'
      cs_result-profile
      'v' lv_msg_ref_ver '.'
      'Missing' lv_msg_missing 'logical field(s):'
      cs_result-missing_list
      'No Mapping/version was created or overwritten;'
      'select My Import or All Import to open an existing contract.'
      INTO cs_result-message SEPARATED BY space.
    RETURN.
  ENDIF.

  PERFORM script_contract_fp
    USING    iv_tcode cs_result-reference
    CHANGING lv_ref_contract_fp lv_fp_ok lv_fp_msg.
  IF lv_fp_ok <> abap_true.
    cs_result-message = lv_fp_msg.
    RETURN.
  ENDIF.

  IF cs_result-in_contract_fp = lv_ref_contract_fp.
    cs_result-exact = abap_true.
  ENDIF.

  cs_result-ok = abap_true.
  IF cs_result-exact = abap_true.
    cs_result-message =
      |Exact canonical contract { cs_result-profile } v{ cs_result-ref_ver } was found.|.
  ELSE.
    cs_result-message =
      |A complete technical contract change was detected for { cs_result-profile }.|.
  ENDIF.
ENDFORM.

*& Shared onboarding pipeline for SHDB TXT and Guided Recording

*& Program Authority / Fail-Closed Template Provenance

*& Official user templates are not inferred from raw SHDB TXT fields.
*& A new/changed scenario may become a template authority only when the
*& SHDB generated ABAP transfer program proves the file-input fields via
*& DATA record / PERFORM bdc_field ... record-xxx, or when the Mapping
*& Contract has already been explicitly saved/locked. Raw TXT / Guided
*& Recording stays replay evidence only. No TCODE or SAP field name is
*& hardcoded.

FORM collect_quotes
  USING    iv_line   TYPE string
  CHANGING ct_values TYPE string_table.

  DATA: lv_work  TYPE string,
        lv_start TYPE i,
        lv_end   TYPE i,
        lv_next  TYPE i,
        lv_value TYPE string,
        lv_len   TYPE i.

  REFRESH ct_values.
  lv_work = iv_line.

  DO.
    FIND FIRST OCCURRENCE OF '''' IN lv_work MATCH OFFSET lv_start.
    IF sy-subrc <> 0.
      EXIT.
    ENDIF.

    lv_next = lv_start + 1.
    lv_len = strlen( lv_work ).
    IF lv_next >= lv_len.
      EXIT.
    ENDIF.
    lv_work = lv_work+lv_next.

    FIND FIRST OCCURRENCE OF '''' IN lv_work MATCH OFFSET lv_end.
    IF sy-subrc <> 0.
      EXIT.
    ENDIF.

    lv_value = lv_work(lv_end).
    APPEND lv_value TO ct_values.

    lv_next = lv_end + 1.
    lv_len = strlen( lv_work ).
    IF lv_next >= lv_len.
      EXIT.
    ENDIF.
    lv_work = lv_work+lv_next.
  ENDDO.
ENDFORM.

FORM record_source_from_line
  USING    iv_line   TYPE string
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column.

  DATA: lv_upper TYPE string,
        lv_tail  TYPE string,
        lv_token TYPE string,
        lv_dummy TYPE string,
        lv_off   TYPE i,
        lv_start TYPE i,
        lv_len   TYPE i.

  CLEAR cv_source.
  lv_upper = iv_line.
  TRANSLATE lv_upper TO UPPER CASE.

  FIND FIRST OCCURRENCE OF 'RECORD-' IN lv_upper MATCH OFFSET lv_off.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  lv_start = lv_off + 7.
  lv_len = strlen( iv_line ).
  IF lv_start >= lv_len.
    RETURN.
  ENDIF.

  lv_tail = iv_line+lv_start.
  CONDENSE lv_tail.
  SPLIT lv_tail AT space INTO lv_token lv_dummy.
  TRANSLATE lv_token TO UPPER CASE.
  REPLACE ALL OCCURRENCES OF '.' IN lv_token WITH ''.
  REPLACE ALL OCCURRENCES OF ',' IN lv_token WITH ''.
  REPLACE ALL OCCURRENCES OF ')' IN lv_token WITH ''.
  REPLACE ALL OCCURRENCES OF '(' IN lv_token WITH '_'.
  REPLACE ALL OCCURRENCES OF '-' IN lv_token WITH '_'.
  CONDENSE lv_token NO-GAPS.

  PERFORM normalize_mapping_source
    USING    lv_token
    CHANGING cv_source.
ENDFORM.

FORM parse_shdb_program
  USING    it_raw     TYPE string_table
  CHANGING cv_tcode   TYPE sy-tcode
           ct_scr     TYPE ty_t_script
           cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_line       TYPE string,
        lv_upper      TYPE string,
        lt_quotes     TYPE string_table,
        lv_q1         TYPE string,
        lv_q2         TYPE string,
        lv_source     TYPE zbdc_mapping_bup-source_column,
        ls_scr        TYPE ty_script_def_compat,
        lv_seq        TYPE n LENGTH 4 VALUE '0000',
        lv_seen_prog  TYPE abap_bool,
        lv_dyn_count  TYPE i.

  FIELD-SYMBOLS <ls_scr> TYPE ty_script_def_compat.

  CLEAR: cv_tcode, cv_ok, cv_message.
  REFRESH ct_scr.

  LOOP AT it_raw INTO lv_line.
    lv_upper = lv_line.
    TRANSLATE lv_upper TO UPPER CASE.

    IF lv_upper CS 'PERFORM BDC_DYNPRO'
       OR lv_upper CS 'PERFORM BDC_FIELD'
       OR lv_upper CS 'PERFORM BDC_TRANSACTION'
       OR lv_upper CS 'CALL TRANSACTION'.
      lv_seen_prog = abap_true.
    ENDIF.

    REFRESH lt_quotes.
    PERFORM collect_quotes
      USING    lv_line
      CHANGING lt_quotes.

    IF lv_upper CS 'PERFORM BDC_TRANSACTION'
       OR lv_upper CS 'CALL TRANSACTION'.
      READ TABLE lt_quotes INTO lv_q1 INDEX 1.
      IF sy-subrc = 0 AND lv_q1 IS NOT INITIAL.
        cv_tcode = lv_q1.
        TRANSLATE cv_tcode TO UPPER CASE.
        CONDENSE cv_tcode NO-GAPS.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF lv_upper CS 'PERFORM BDC_DYNPRO'.
      READ TABLE lt_quotes INTO lv_q1 INDEX 1.
      READ TABLE lt_quotes INTO lv_q2 INDEX 2.
      IF lv_q1 IS INITIAL OR lv_q2 IS INITIAL.
        CONTINUE.
      ENDIF.
      CLEAR ls_scr.
      lv_seq = lv_seq + 10.
      ls_scr-step_seq      = lv_seq.
      ls_scr-row_type      = gc_rt_header.
      ls_scr-program_name  = lv_q1.
      ls_scr-dynpro_no     = lv_q2.
      ls_scr-is_new_screen = 'X'.
      APPEND ls_scr TO ct_scr.
      CONTINUE.
    ENDIF.

    IF lv_upper CS 'PERFORM BDC_FIELD'.
      READ TABLE lt_quotes INTO lv_q1 INDEX 1.
      IF lv_q1 IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_scr.
      lv_seq = lv_seq + 10.
      ls_scr-step_seq   = lv_seq.
      ls_scr-row_type   = gc_rt_header.
      ls_scr-field_name = lv_q1.

      CLEAR lv_source.
      PERFORM record_source_from_line
        USING    lv_line
        CHANGING lv_source.
      IF lv_source IS NOT INITIAL.
        ls_scr-value_type    = gc_vt_dynamic.
        ls_scr-source_column = lv_source.
        lv_dyn_count = lv_dyn_count + 1.
      ELSE.
        READ TABLE lt_quotes INTO lv_q2 INDEX 2.
        IF sy-subrc = 0.
          ls_scr-value_type   = gc_vt_static.
          ls_scr-static_value = lv_q2.
        ELSE.
          ls_scr-value_type = gc_m2_vt_unresolved.
        ENDIF.
      ENDIF.

      APPEND ls_scr TO ct_scr.
      CONTINUE.
    ENDIF.
  ENDLOOP.

  IF lv_seen_prog <> abap_true.
    RETURN.
  ENDIF.

  IF cv_tcode IS INITIAL.
    cv_message = 'Generated ABAP program was detected, but TCODE could not be read from BDC_TRANSACTION/CALL TRANSACTION.'.
    RETURN.
  ENDIF.

  IF ct_scr IS INITIAL OR lv_dyn_count <= 0.
    cv_message = 'Generated ABAP program has no PERFORM bdc_field ... record-xxx input fields; official template authority is missing.'.
    RETURN.
  ENDIF.

  LOOP AT ct_scr ASSIGNING <ls_scr>.
    <ls_scr>-tcode = cv_tcode.
  ENDLOOP.

  cv_ok = abap_true.
  cv_message = |SHDB generated program parsed: { lv_dyn_count } record input field(s) became template-authority candidates.|.
ENDFORM.

FORM prog_auth_script_ok
  USING    it_script TYPE ty_t_script
  CHANGING cv_ok     TYPE abap_bool
           cv_count  TYPE i.

  DATA: ls_script TYPE ty_script_def_compat,
        lv_source TYPE zbdc_mapping_bup-source_column.

  CLEAR: cv_ok, cv_count.
  LOOP AT it_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL
      AND value_type = gc_vt_dynamic.

    CLEAR lv_source.
    PERFORM normalize_mapping_source
      USING    ls_script-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      CONTINUE.
    ENDIF.
    IF lv_source CP 'INPUT_*'.
      CONTINUE.
    ENDIF.
    cv_count = cv_count + 1.
  ENDLOOP.

  IF cv_count > 0.
    cv_ok = abap_true.
  ENDIF.
ENDFORM.

FORM template_authority_ok
  USING    iv_tcode   TYPE any
           iv_profile TYPE any
           iv_ver     TYPE any
           iv_status  TYPE any
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_script  TYPE ty_t_script,
        lv_script  TYPE zbdc_script_bup-script_id,
        lv_hash    TYPE zbdc_script_bup-contract_hash,
        lv_loaded  TYPE abap_bool,
        lv_prog_ok TYPE abap_bool,
        lv_count   TYPE i,
        lt_guide   TYPE ty_t_map_meta,
        ls_guide   TYPE ty_map_meta.

  CLEAR: cv_ok, cv_message.

 "A saved Mapping contract is the user-confirmed authority. Runtime is
 "still gated separately by TESTING/ACTIVE certification.
  IF iv_status = gc_m2_prof_mapped
     OR iv_status = 'TESTING'
     OR iv_status = gc_m2_prof_active.
    cv_ok = abap_true.
    cv_message = 'Template authority: locked Mapping Contract.'.
    RETURN.
  ENDIF.

  IF iv_status <> gc_m2_prof_draft.
    cv_message = |Profile status { iv_status } is not a template authority.|.
    RETURN.
  ENDIF.

  PERFORM load_profile_script
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_script lv_script lv_hash lv_loaded.
  IF lv_loaded <> abap_true.
    cv_message = 'Draft profile has no immutable script evidence.'.
    RETURN.
  ENDIF.

 "an internally saved Field Guide is a valid template authority
 "for the end-user-only flow. DRAFT remains non-runtime until the normal
 "testing/certification gates promote it, but Generate Template must not
 "fall back to raw SHDB nor fail after the Field Guide has been persisted.
  REFRESH lt_guide.
  PERFORM read_mapping_metadata
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_guide.
  LOOP AT lt_guide INTO ls_guide
    WHERE metadata_origin = 'FIELD_GUIDE'.
    cv_ok = abap_true.
    cv_message = 'Template authority: internal Field Guide.'.
    RETURN.
  ENDLOOP.

  CLEAR: lv_prog_ok, lv_count.
  PERFORM prog_auth_script_ok
    USING    lt_script
    CHANGING lv_prog_ok lv_count.

  IF lv_prog_ok = abap_true.
    cv_ok = abap_true.
    cv_message = |Template authority: SHDB generated program record contract ({ lv_count } input field(s)).|.
    RETURN.
  ENDIF.

  cv_message =
    'TXT_ONLY/GUIDED_ONLY evidence cannot generate an official template. Upload SHDB Program/Transfer-from-Recording source or save a reviewed Mapping Contract first.'.
ENDFORM.

*& Standard-SAP TCODE guard + recordability-safe classification

*& Rules:
*& TSTC existence proves only that SAP knows the transaction code.
*& Repository ownership is checked generically in TADIR (R3TR TRAN).
*& Only SAP-owned standard transactions may enter this project pipeline.
*& PGMNA/DYPNO are diagnostic entry-shape hints only; they NEVER decide
*& SHDB/BDC recordability. BDC_RECORD_TRANSACTION remains the runtime truth.
*& Therefore recorder failure is never relabeled as "fake TCODE".
*& No TCODE name, application, business field or create/display pair is
*& hardcoded here.

FORM check_standard_tcode
  USING    iv_tcode   TYPE sy-tcode
  CHANGING cv_ok      TYPE abap_bool
           cv_kind    TYPE char20
           cv_message TYPE string.

  DATA: lv_tcode  TYPE sy-tcode,
        ls_tstc   TYPE tstc,
        ls_tadir  TYPE tadir,
        lv_src    TYPE tadir-srcsystem,
        lv_author TYPE tadir-author.

  CLEAR: cv_ok, cv_kind, cv_message, ls_tstc, ls_tadir.

  lv_tcode = iv_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.

  IF lv_tcode IS INITIAL.
    cv_kind = 'INVALID'.
    cv_message = 'STANDARD_ONLY: transaction code is empty.'.
    RETURN.
  ENDIF.

  SELECT SINGLE *
    FROM tstc
    INTO @ls_tstc
    WHERE tcode = @lv_tcode.
  IF sy-subrc <> 0.
    cv_kind = 'NOT_IN_TSTC'.
    cv_message = |STANDARD_ONLY: { lv_tcode } does not exist in TSTC.|.
    RETURN.
  ENDIF.

 "Do not infer custom/standard from Z/Y prefixes. Repository ownership is
 "the authority, so customer objects created in SAP-like namespaces are
 "still rejected and SAP objects are not rejected merely by their spelling.
  SELECT SINGLE *
    FROM tadir
    INTO @ls_tadir
    WHERE pgmid    = 'R3TR'
      AND object   = 'TRAN'
      AND obj_name = @lv_tcode.
  IF sy-subrc <> 0.
    cv_kind = 'OWNER_UNKNOWN'.
    cv_message = |STANDARD_ONLY: { lv_tcode } exists in TSTC but no R3TR/TRAN owner can be proven in TADIR; onboarding is blocked fail-closed.|.
    RETURN.
  ENDIF.

  lv_src    = ls_tadir-srcsystem.
  lv_author = ls_tadir-author.
  TRANSLATE lv_src TO UPPER CASE.
  TRANSLATE lv_author TO UPPER CASE.

 "Primary proof is SRCSYSTEM=SAP. AUTHOR=SAP is accepted only as a legacy
 "fallback when SRCSYSTEM is blank; a non-SAP source system always blocks.
  IF lv_src <> 'SAP' AND NOT ( lv_src IS INITIAL AND lv_author = 'SAP' ).
    cv_kind = 'CUSTOM_OWNER'.
    cv_message = |STANDARD_ONLY: { lv_tcode } is not proven SAP-standard by TADIR ownership (SRCSYSTEM={ lv_src }, AUTHOR={ lv_author }); onboarding is blocked.|.
    RETURN.
  ENDIF.

 "Entry shape is informational only. Parameter/variant/OO/report wrappers
 "can legitimately differ, so do not use this hint as a BDC eligibility gate.
  IF ls_tstc-pgmna IS NOT INITIAL AND ls_tstc-dypno IS NOT INITIAL.
    cv_kind = 'DIRECT_DYNPRO'.
  ELSEIF ls_tstc-pgmna IS NOT INITIAL.
    cv_kind = 'PROGRAM_ENTRY'.
  ELSE.
    cv_kind = 'INDIRECT_ENTRY'.
  ENDIF.

  cv_ok = abap_true.
  cv_message = |STANDARD_SAP/{ cv_kind }: { lv_tcode } is repository-proven SAP standard; actual SHDB/BDC recordability will be decided only by the SAP recorder.|.
ENDFORM.

*& Generic live-capture proof (no TCODE whitelist / no CASE)

*& Purpose:
*& Start Recording must prove a real, structurally useful SAP recorder
*& capture before any %BDC persistence/profile publication.
*& Import must pass the same parsed-script structural gate before DRAFT.
*& The gate never knows a business TCODE, field, program or dynpro name.
*& Repository checks are evidence only for imported/generated screen
*& families; controlled replay/certification remains the ACTIVE gate.

FORM check_bdc_capture
  USING    iv_tcode   TYPE sy-tcode
           it_bdc     TYPE ty_bdcdata_tab
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_bdc          TYPE bdcdata,
        lv_seen_screen  TYPE abap_bool,
        lv_screen_count TYPE i,
        lv_input_count  TYPE i,
        lv_okcode_count TYPE i,
        lv_bad_screen   TYPE abap_bool,
        lv_bad_order    TYPE abap_bool,
        lv_prog         TYPE trdir-name,
        lv_prog_hit     TYPE trdir-name,
        lv_prog_missing TYPE i,
        lv_dyn_prog     TYPE d020s-prog,
        lv_dyn_num      TYPE d020s-dnum,
        lv_dyn_hit      TYPE d020s-prog,
        lv_dyn_missing  TYPE i.

  CLEAR: cv_ok, cv_message, lv_seen_screen, lv_screen_count,
         lv_input_count, lv_okcode_count, lv_bad_screen, lv_bad_order,
         lv_prog_missing, lv_dyn_missing.

  IF iv_tcode IS INITIAL OR it_bdc IS INITIAL.
    cv_message = 'LIVE_CAPTURE_BLOCKED: TCODE and recorder BDCDATA are required.'.
    RETURN.
  ENDIF.

  LOOP AT it_bdc INTO ls_bdc.
    IF ls_bdc-dynbegin = 'T'.
      CONTINUE.
    ENDIF.

    IF ls_bdc-dynbegin = 'X'.
      lv_seen_screen  = abap_true.
      lv_screen_count = lv_screen_count + 1.

      IF ls_bdc-program IS INITIAL OR ls_bdc-dynpro IS INITIAL.
        lv_bad_screen = abap_true.
        CONTINUE.
      ENDIF.

 "gate 3A: captured program must exist in the current system.
      CLEAR: lv_prog, lv_prog_hit.
      lv_prog = ls_bdc-program.
      SELECT SINGLE name
        FROM trdir
        INTO @lv_prog_hit
        WHERE name = @lv_prog.
      IF sy-subrc <> 0.
        lv_prog_missing = lv_prog_missing + 1.
        CONTINUE.
      ENDIF.

 "gate 3B: strict PROGRAM/DYNPRO proof in current repository.
 "Unlike , an unproven screen may not enter onboarding.
      CLEAR: lv_dyn_prog, lv_dyn_num, lv_dyn_hit.
      lv_dyn_prog = ls_bdc-program.
      lv_dyn_num  = ls_bdc-dynpro.
      SELECT SINGLE prog
        FROM d020s
        INTO @lv_dyn_hit
        WHERE prog = @lv_dyn_prog
          AND dnum = @lv_dyn_num.
      IF sy-subrc <> 0.
        lv_dyn_missing = lv_dyn_missing + 1.
      ENDIF.
      CONTINUE.
    ENDIF.

 "Ignore only a completely empty recorder separator/wrapper.
    IF ls_bdc-fnam IS INITIAL
       AND ls_bdc-program IS INITIAL
       AND ls_bdc-dynpro IS INITIAL
       AND ls_bdc-fval IS INITIAL.
      CONTINUE.
    ENDIF.

    IF lv_seen_screen <> abap_true.
      lv_bad_order = abap_true.
      CONTINUE.
    ENDIF.

    IF ls_bdc-fnam IS INITIAL.
      CONTINUE.
    ENDIF.

 "A usable flow must contain at least one recorded user/action command.
    IF ls_bdc-fnam = 'BDC_OKCODE' AND ls_bdc-fval IS NOT INITIAL.
      lv_okcode_count = lv_okcode_count + 1.
    ENDIF.

 "BDC_* rows are recorder/navigation control, not user-input proof.
    IF ls_bdc-fnam NP 'BDC_*'.
      lv_input_count = lv_input_count + 1.
    ENDIF.
  ENDLOOP.

  IF lv_screen_count = 0.
    cv_message =
      |LIVE_CAPTURE_BLOCKED: SAP recorder returned no executable DYNBEGIN screen for { iv_tcode }.|.
    RETURN.
  ENDIF.

  IF lv_bad_screen = abap_true.
    cv_message =
      |LIVE_CAPTURE_BLOCKED: { iv_tcode } contains a captured screen without PROGRAM/DYNPRO.|.
    RETURN.
  ENDIF.

  IF lv_bad_order = abap_true.
    cv_message =
      |LIVE_CAPTURE_BLOCKED: { iv_tcode } contains recorder data before the first real screen.|.
    RETURN.
  ENDIF.

  IF lv_prog_missing > 0.
    cv_message =
      |LIVE_CAPTURE_BLOCKED: { lv_prog_missing } captured screen program(s) are not present in current TRDIR for { iv_tcode }.|.
    RETURN.
  ENDIF.

  IF lv_dyn_missing > 0.
    cv_message =
      |LIVE_CAPTURE_BLOCKED: { lv_dyn_missing } captured PROGRAM/DYNPRO screen pair(s) are not present in current D020S for { iv_tcode }.|.
    RETURN.
  ENDIF.

  IF lv_input_count = 0.
    cv_message =
      |LIVE_CAPTURE_BLOCKED: { iv_tcode } captured only technical BDC_* control rows and no parameterizable screen input.|.
    RETURN.
  ENDIF.

  IF lv_okcode_count = 0.
    cv_message =
      |LIVE_CAPTURE_BLOCKED: { iv_tcode } has input rows but no recorded BDC_OKCODE action; passive wrapper/error-only capture is not accepted.|.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message =
    |LIVE_CAPTURE_OK: { lv_screen_count } live screen(s), { lv_input_count } non-technical input row(s), { lv_okcode_count } action row(s) captured for { iv_tcode }.|.
ENDFORM.

FORM check_script_capture
  USING    iv_tcode   TYPE sy-tcode
           iv_origin  TYPE csequence
           it_script  TYPE ty_t_script
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_scr          TYPE ty_script_def_compat,
        lv_seen_screen  TYPE abap_bool,
        lv_screen_count TYPE i,
        lv_input_count  TYPE i,
        lv_okcode_count TYPE i,
        lv_bad_screen   TYPE abap_bool,
        lv_bad_order    TYPE abap_bool,
        lv_bad_tcode    TYPE abap_bool,
        lv_prog         TYPE trdir-name,
        lv_prog_hit     TYPE trdir-name,
        lv_prog_missing TYPE i,
        lv_dyn_prog     TYPE d020s-prog,
        lv_dyn_num      TYPE d020s-dnum,
        lv_dyn_hit      TYPE d020s-prog,
        lv_dyn_missing  TYPE i,
        lv_origin       TYPE string.

  CLEAR: cv_ok, cv_message, lv_seen_screen, lv_screen_count,
         lv_input_count, lv_okcode_count, lv_bad_screen, lv_bad_order,
         lv_bad_tcode, lv_prog_missing, lv_dyn_missing.

  IF iv_tcode IS INITIAL OR it_script IS INITIAL.
    cv_message = 'CAPTURE_CONTRACT_BLOCKED: TCODE and parsed recording rows are required.'.
    RETURN.
  ENDIF.

  lv_origin = iv_origin.
  TRANSLATE lv_origin TO UPPER CASE.
  CONDENSE lv_origin NO-GAPS.

  LOOP AT it_script INTO ls_scr.
    IF ls_scr-tcode IS NOT INITIAL AND ls_scr-tcode <> iv_tcode.
      lv_bad_tcode = abap_true.
      EXIT.
    ENDIF.

    IF ls_scr-is_new_screen = 'X'.
      lv_seen_screen  = abap_true.
      lv_screen_count = lv_screen_count + 1.

      IF ls_scr-program_name IS INITIAL OR ls_scr-dynpro_no IS INITIAL.
        lv_bad_screen = abap_true.
        CONTINUE.
      ENDIF.

      CLEAR: lv_prog, lv_prog_hit.
      lv_prog = ls_scr-program_name.
      SELECT SINGLE name
        FROM trdir
        INTO @lv_prog_hit
        WHERE name = @lv_prog.
      IF sy-subrc <> 0.
        lv_prog_missing = lv_prog_missing + 1.
        CONTINUE.
      ENDIF.

 "Start Recording and Import share the same strict current-
 "system PROGRAM/DYNPRO proof; stale imported screens are blocked.
      CLEAR: lv_dyn_prog, lv_dyn_num, lv_dyn_hit.
      lv_dyn_prog = ls_scr-program_name.
      lv_dyn_num  = ls_scr-dynpro_no.
      SELECT SINGLE prog
        FROM d020s
        INTO @lv_dyn_hit
        WHERE prog = @lv_dyn_prog
          AND dnum = @lv_dyn_num.
      IF sy-subrc <> 0.
        lv_dyn_missing = lv_dyn_missing + 1.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_scr-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    IF lv_seen_screen <> abap_true.
      lv_bad_order = abap_true.
      CONTINUE.
    ENDIF.

    IF ls_scr-field_name = 'BDC_OKCODE'
       AND ls_scr-static_value IS NOT INITIAL.
      lv_okcode_count = lv_okcode_count + 1.
    ENDIF.

    IF ls_scr-field_name NP 'BDC_*'.
      lv_input_count = lv_input_count + 1.
    ENDIF.
  ENDLOOP.

  IF lv_bad_tcode = abap_true.
    cv_message =
      |CAPTURE_CONTRACT_BLOCKED: parsed recording contains a TCODE different from { iv_tcode }.|.
    RETURN.
  ENDIF.

  IF lv_screen_count = 0.
    cv_message =
      |CAPTURE_CONTRACT_BLOCKED: parsed recording for { iv_tcode } has no executable screen.|.
    RETURN.
  ENDIF.

  IF lv_bad_screen = abap_true.
    cv_message =
      |CAPTURE_CONTRACT_BLOCKED: parsed recording for { iv_tcode } has a screen without PROGRAM/DYNPRO.|.
    RETURN.
  ENDIF.

  IF lv_bad_order = abap_true.
    cv_message =
      |CAPTURE_CONTRACT_BLOCKED: parsed recording for { iv_tcode } contains a field before its screen declaration.|.
    RETURN.
  ENDIF.

  IF lv_prog_missing > 0.
    cv_message =
      |CAPTURE_CONTRACT_BLOCKED: { lv_prog_missing } recorded program(s) are not present in current TRDIR for { iv_tcode }. Import is stale or incompatible with this SAP system.|.
    RETURN.
  ENDIF.

  IF lv_dyn_missing > 0.
    cv_message =
      |CAPTURE_CONTRACT_BLOCKED: { lv_dyn_missing } recorded PROGRAM/DYNPRO screen pair(s) are not present in current D020S for { iv_tcode }.|.
    RETURN.
  ENDIF.

  IF lv_input_count = 0.
    cv_message =
      |CAPTURE_CONTRACT_BLOCKED: recording for { iv_tcode } has no non-technical input row; wrapper/error-only evidence is not a mass-data contract.|.
    RETURN.
  ENDIF.

  IF lv_okcode_count = 0.
    cv_message =
      |CAPTURE_CONTRACT_BLOCKED: recording for { iv_tcode } has no BDC_OKCODE action; passive wrapper/error-only evidence is not accepted.|.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message =
    |CAPTURE_CONTRACT_OK/{ lv_origin }: { lv_screen_count } live screen(s), { lv_input_count } input row(s), { lv_okcode_count } action row(s); strict current-system screen proof complete.|.
ENDFORM.

*& RAW first, confirmation only from Mapping Profile

*& Import/Guided acquisition must be inspectable before the user is asked
*& which controls belong to the business Template. This routine stages only
*& exact RAW evidence for Screen 0800. It does NOT calculate schema identity,
*& allocate a version, call AI, classify a business field, or open the
*& confirmation popup. auto_prep_map_on_open resumes the existing strict
*& onboarding pipeline only after the user explicitly chooses Mapping Profile.

FORM stage_acquisition_review
  USING    iv_tcode  TYPE sy-tcode
           iv_origin TYPE csequence
           it_script TYPE ty_t_script.

  DATA: lv_tcode  TYPE sy-tcode,
        lv_origin TYPE c LENGTH 20.

  lv_tcode = iv_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.

  lv_origin = iv_origin.
  TRANSLATE lv_origin TO UPPER CASE.
  CONDENSE lv_origin NO-GAPS.

  IF lv_tcode IS INITIAL OR lv_origin IS INITIAL OR it_script IS INITIAL.
    RETURN.
  ENDIF.

 "A fresh acquisition owns the editor. Old profile/runtime context must not
 "make LOAD_SCRIPT_EDITOR replace these rows with a persisted contract.
  PERFORM clear_map_context.

  p_rec_tcode              = lv_tcode.
  p_transaction            = lv_tcode.
  gv_z133_origin           = lv_origin.
  gv_z359_input_origin     = lv_origin.
  gv_z652_acq_origin       = lv_origin.
  gv_z689_review_pending   = abap_true.
  gv_z689_review_tcode     = lv_tcode.
  gv_z689_review_origin    = lv_origin.

  gt_z333_rec_evidence = it_script.
  gt_script_def        = it_script.
  REFRESH gt_mapping_screen.

 "A previous recording/import confirmation must never leak into the new RAW
 "review. The new confirmation is created only after Mapping Profile.
  REFRESH: gt_z659_user_actions, gt_z684_names.
  CLEAR: gv_z659_action_script, gv_z659_action_hash,
         gv_z659_action_ready, gv_z684_name_script,
         gv_z684_name_hash, gv_z684_name_ready.

 "Source isolation: native CommandArray/screenshots belong only to the
 "Guided Recording that created them. A fresh SHDB import must never inherit
 "those transient buffers, otherwise Mapping Profile can accidentally run
 "Guided preflight against an unrelated older transaction.
  IF lv_origin <> 'GUIDED_RECORD'.
    REFRESH: gt_z360_rec_field_vals,
             gt_z866_screen_caps,
             gt_z865_gui_labels.
    CLEAR: gv_z866_vision_required,
           gv_z866_vision_analyzed,
           gv_z877_cap_diag.
  ENDIF.
ENDFORM.

FORM onboard_parsed_script
  USING    iv_tcode   TYPE sy-tcode
           iv_origin  TYPE csequence
  CHANGING ct_scr     TYPE ty_t_script
           cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_ver            TYPE zbdc_prof_bup-profile_ver,
        lv_question       TYPE string,
        lv_ans            TYPE c,
        lv_dynamic        TYPE i,
        lv_static         TYPE i,
        lv_unresolved     TYPE i,
        lv_ignored        TYPE i,
        lv_script_id      TYPE zbdc_script_bup-script_id,
        lv_hash           TYPE zbdc_script_bup-contract_hash,
        lv_save_ok        TYPE abap_bool,
        lv_save_msg       TYPE string,
        lv_desc           TYPE zbdc_prof_bup-description,
        lv_recording      TYPE zbdc_script_bup-recording_name,
        lv_pipeline_ok    TYPE abap_bool,
        lv_pipeline_msg   TYPE string,
        lv_compile_ok     TYPE abap_bool,
        lv_template_schema_fp TYPE zbdc_script_bup-contract_hash,
        lv_selection_fp      TYPE zbdc_script_bup-contract_hash,
        lv_selection_ok      TYPE abap_bool,
        lv_selection_msg     TYPE string,
        lv_version_fp        TYPE zbdc_script_bup-contract_hash,
        lv_version_ok        TYPE abap_bool,
        lv_version_msg       TYPE string,
        lv_schema_fp_ok       TYPE abap_bool,
        lv_schema_fp_msg      TYPE string,
        lv_reservation_id TYPE zbdc_script_bup-script_id,
        lv_reserve_ok     TYPE abap_bool,
        lv_reserve_msg    TYPE string,
        lv_reserve_reused TYPE abap_bool,
        lv_reuse_id       TYPE zbdc_script_bup-script_id,
        lv_reuse_hash     TYPE zbdc_script_bup-contract_hash,
        lv_schema_ver     TYPE zbdc_prof_bup-profile_ver,
        lv_schema_id      TYPE zbdc_script_bup-script_id,
        lv_schema_hash    TYPE zbdc_script_bup-contract_hash,
        lv_schema_found   TYPE abap_bool,
        lt_z499_raw       TYPE ty_t_script,
        lv_ref_compile_ok TYPE abap_bool,
        lv_ref_compile_msg TYPE string,
        lv_ref_mapclass_ok TYPE abap_bool,
        lv_ref_mapclass_msg TYPE string,
        lv_legacy_ref     TYPE abap_bool,
        lv_plan_ok        TYPE abap_bool,
        lv_plan_msg       TYPE string,
        lv_raw_save_ok    TYPE abap_bool,
        lv_raw_save_msg   TYPE string,
        lv_exec_save_ok   TYPE abap_bool,
        lv_exec_save_msg  TYPE string,
        lv_tcode_ok      TYPE abap_bool,
        lv_tcode_kind    TYPE char20,
        lv_tcode_msg     TYPE string,
        lv_capture_ok    TYPE abap_bool,
        lv_capture_msg   TYPE string,
        lv_confirm_ok    TYPE abap_bool,
        lv_confirm_msg   TYPE string,
        lv_cert_ok       TYPE abap_bool,
        lv_cert_msg      TYPE string,
        lv_schema_cfg_ok TYPE abap_bool,
        lv_schema_cfg_msg TYPE string,
        lv_expected_auto_profile TYPE zbdc_prof_bup-profile_name.

  DATA ls_contract TYPE ty_contract_resolution.

  CLEAR: cv_ok, cv_message.
  CLEAR: gv_z133_outcome, gv_z133_evidence_id,
         gv_z133_reservation_id.
  gv_z133_origin       = iv_origin.
  gv_z359_input_origin = iv_origin.
  gv_z652_acq_origin   = iv_origin.
  TRANSLATE gv_z359_input_origin TO UPPER CASE.
  CONDENSE gv_z359_input_origin NO-GAPS.
  TRANSLATE gv_z652_acq_origin TO UPPER CASE.
  CONDENSE gv_z652_acq_origin NO-GAPS.

  IF iv_tcode IS INITIAL OR ct_scr IS INITIAL.
    cv_message = 'TCODE and captured recording steps are required for onboarding.'.
    RETURN.
  ENDIF.

 "preserve acquisition truth before any Mapping/classification/compiler
 "step can change VALUE_TYPE, SOURCE_COLUMN, ROW_TYPE or indexed field names.
  lt_z499_raw = ct_scr.

 "one central standard-SAP guard for Guided Recording, SHDB
 "Program import and SHDB TXT import. This is repository ownership only;
 "actual recordability remains a recorder/runtime result.
  PERFORM check_standard_tcode
    USING    iv_tcode
    CHANGING lv_tcode_ok lv_tcode_kind lv_tcode_msg.
  IF lv_tcode_ok <> abap_true.
    cv_message = lv_tcode_msg.
    RETURN.
  ENDIF.

 "acquisition evidence, not an offline candidate list, decides
 "whether this exact recording is structurally useful on the current SAP
 "system. Guided Recording and both Import formats enter the same gate.
  CLEAR: lv_capture_ok, lv_capture_msg.
  PERFORM check_script_capture
    USING    iv_tcode iv_origin ct_scr
    CHANGING lv_capture_ok lv_capture_msg.
  IF lv_capture_ok <> abap_true.
    cv_message = lv_capture_msg.
    RETURN.
  ENDIF.

 "defense-in-depth: a Guided Recording without the native recorder
 "provenance buffer is never allowed to enter schema/mapping certification.
 "Import origins are unaffected because SHDB TXT/Program has no FIELD_VALS.
  IF gv_z359_input_origin = 'GUIDED_RECORD'
     AND gt_z360_rec_field_vals IS INITIAL.
    cv_message =
      'RECORDER_NATIVE_PROVENANCE_MISSING: Guided Recording has BDCDATA but no native FIELD_VALS; onboarding blocked before Mapping/Template classification.'.
    RETURN.
  ENDIF.

  p_rec_tcode   = iv_tcode.
  p_transaction = iv_tcode.

 "a new Import/Guided attempt starts with no profile/version
 "assumption. Upload/Preview or previous 0800 state must not leak into
 "the canonical resolver. Success paths below pin a fresh exact tuple.
  PERFORM clear_map_context.

 "one domain resolver for every acquisition adapter.
 "IV_ORIGIN is intentionally absent from the resolver signature.
  PERFORM resolve_contract
    USING    iv_tcode ct_scr
    CHANGING ls_contract.

  IF ls_contract-ok <> abap_true.
    cv_message = ls_contract-message.
    gv_z133_outcome = gc_m2_z133_blocked.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile ls_contract-ref_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    RETURN.
  ENDIF.

 "profiles generated by Z44 have a deterministic TCODE+fingerprint
 "identity. If historical state contains an AUTO profile name that does not
 "equal the name deterministically generated for THIS TCODE/fingerprint, it
 "is stale cross-context evidence and must not be reused. Manual profile
 "names (without _AUTO_) remain untouched.
  CLEAR lv_expected_auto_profile.
  PERFORM auto_profile_name
    USING    iv_tcode ls_contract-semantic_fp
    CHANGING lv_expected_auto_profile.
  IF ls_contract-profile CS '_AUTO_'
     AND lv_expected_auto_profile IS NOT INITIAL
     AND ls_contract-profile <> lv_expected_auto_profile.
    ls_contract-profile = lv_expected_auto_profile.
    CLEAR: ls_contract-ref_ver, ls_contract-ref_script_id, ls_contract-ref_hash, ls_contract-exact,
           ls_contract-missing, ls_contract-missing_list.
    REFRESH ls_contract-reference.
    ls_contract-is_new = abap_true.
    ls_contract-complete    = abap_true.
  ENDIF.

  txtp_profile_name = ls_contract-profile.

 "ROOT ORDERING: raw SHDB/recorder data does not contain a universal
 "USER_CHANGED bit. Therefore business-input membership must be confirmed
 "BEFORE Z447 calculates Template Schema identity. The popup receives only
 "the exact current recording/native evidence; no Script ID exists yet, so
 "this call creates an in-memory membership + exact-name certificate only.
 "Guided Recording uses deterministic capture/action membership; both paths use SAP DDIC naming. No AI, TCODE CASE or technical-name promotion.
  IF gv_z652_acq_origin = 'GUIDED_RECORD'
     OR gv_z652_acq_origin = 'SHDB_TXT'
     OR gv_z652_acq_origin = 'SHDB_PROGRAM'.
    CLEAR: lv_confirm_ok, lv_confirm_msg.
    PERFORM confirm_actions
      USING    ct_scr space space iv_origin
      CHANGING lv_confirm_ok lv_confirm_msg.
    IF lv_confirm_ok <> abap_true.
      cv_message = lv_confirm_msg.
      IF cv_message IS INITIAL.
        cv_message =
          'Exact user confirmation is required before Template Schema identity can be calculated.'.
      ENDIF.
      gv_z133_outcome = gc_m2_z133_blocked.
      PERFORM log_evidence
        USING iv_tcode ls_contract-profile ls_contract-ref_ver iv_origin gv_z133_outcome
              ls_contract-in_contract_fp ls_contract-missing cv_message.
      PERFORM commit_evidence.
      RETURN.
    ENDIF.
  ENDIF.

 "/Template Version identity is calculated only AFTER the
 "confirmed business-input set and exact Template names exist.
  CLEAR: lv_template_schema_fp, lv_schema_fp_ok, lv_schema_fp_msg.
  PERFORM script_schema_fp
    USING    iv_tcode ct_scr
    CHANGING lv_template_schema_fp lv_schema_fp_ok lv_schema_fp_msg.
  IF lv_schema_fp_ok <> abap_true.
    cv_message = lv_schema_fp_msg.
    gv_z133_outcome = gc_m2_z133_blocked.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile ls_contract-ref_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    RETURN.
  ENDIF.

 "V17.9 version decision: selected field set + technical choreography.
  PERFORM selection_fp_actions USING iv_tcode lt_z499_raw
    CHANGING lv_selection_fp lv_selection_ok lv_selection_msg.
  IF lv_selection_ok <> abap_true.
    cv_message = lv_selection_msg.
    RETURN.
  ENDIF.
  PERFORM version_identity_fp USING iv_tcode lt_z499_raw lv_selection_fp
    CHANGING lv_version_fp lv_version_ok lv_version_msg.
  IF lv_version_ok <> abap_true.
    cv_message = lv_version_msg.
    RETURN.
  ENDIF.

 "old executable contracts may remain audit/reference evidence, but
 "only contracts published from an immutable RAW snapshot through the current compiler
 "may be reused as Template/Execute authority. No runtime field/index guess.
  CLEAR: lv_ref_compile_ok, lv_ref_compile_msg, lv_legacy_ref.
  IF ls_contract-ref_script_id IS NOT INITIAL.
    PERFORM compiler_cert_ok
      USING    ls_contract-ref_script_id
      CHANGING lv_ref_compile_ok lv_ref_compile_msg.
    IF lv_ref_compile_ok = abap_true.
      CLEAR: lv_ref_mapclass_ok, lv_ref_mapclass_msg.
      PERFORM mapclass_cert_ok
        USING    ls_contract-ref_script_id
        CHANGING lv_ref_mapclass_ok lv_ref_mapclass_msg.
      IF lv_ref_mapclass_ok <> abap_true.
        CLEAR lv_ref_compile_ok.
      ENDIF.
    ENDIF.
    IF lv_ref_compile_ok <> abap_true.
      CLEAR ls_contract-exact.
      lv_legacy_ref = abap_true.
    ENDIF.
  ENDIF.

 "V17.9 Version identity is authoritative before historical-reference hints.
 "Reuse occurs only when selected SAP field membership AND technical BDC
 "choreography are identical. Data-only differences are ignored.
 "The current raw acquisition remains in GT_Z333_REC_EVIDENCE for audit.
 "If its strict schema matches a published version, converts the UI
 "to official SCHEMA_REUSE so Mapping/Template read the persisted immutable
 "contract instead of trying to promote evidence over that same version.
  CLEAR: lv_schema_ver, lv_schema_id, lv_schema_hash, lv_schema_found,
         lv_pipeline_ok, lv_pipeline_msg.
  PERFORM find_schema_contract
    USING    iv_tcode ls_contract-profile lv_version_fp
    CHANGING lv_schema_ver lv_schema_id lv_schema_hash lv_schema_found.

 "same CSV/template schema does NOT authorize reuse of an older
 "compiler contract. A fresh SHDB acquisition must publish an S1 contract
 "from its own immutable RAW instead of reopening a legacy technical plan.
  IF lv_schema_found = abap_true.
    CLEAR: lv_ref_compile_ok, lv_ref_compile_msg.
    PERFORM compiler_cert_ok
      USING    lv_schema_id
      CHANGING lv_ref_compile_ok lv_ref_compile_msg.
    IF lv_ref_compile_ok <> abap_true.
      CLEAR: lv_schema_ver, lv_schema_id, lv_schema_hash, lv_schema_found.
    ENDIF.
  ENDIF.

  IF lv_schema_found = abap_true.
    PERFORM apply_map_context
      USING    iv_tcode ls_contract-profile lv_schema_ver lv_schema_id lv_schema_hash
      CHANGING lv_pipeline_ok lv_pipeline_msg.

    IF lv_pipeline_ok <> abap_true.
      PERFORM clear_map_context.
      p_rec_tcode       = iv_tcode.
      p_transaction     = iv_tcode.
      txtp_profile_name = ls_contract-profile.
      cv_message = lv_pipeline_msg.
      IF cv_message IS INITIAL.
        cv_message =
          'Published Template Schema was found, but its exact Mapping context could not be pinned.'.
      ENDIF.
      gv_z133_outcome = gc_m2_z133_blocked.
      PERFORM log_evidence
        USING iv_tcode ls_contract-profile lv_schema_ver iv_origin gv_z133_outcome
              ls_contract-in_contract_fp ls_contract-missing cv_message.
      PERFORM commit_evidence.
      RETURN.
    ENDIF.

 "An exact VERSION_ID_V1 match is official contract reuse, not a Candidate
 "Mapping that may be promoted over the existing version. Raw Start/Import evidence remains in GT_Z333_REC_EVIDENCE for
 "audit, but 0350 must load the immutable persisted Mapping and Generate
 "Template must export that same version without calling Z31 persistence.
 "This also prevents the false "Certified contract ... is immutable"
 "error when an old TXT/recording is imported again.
 "Mapping/Version may be reused only when the bound execution
 "recording is identical. Z590 preserves existing EXEC_RAW and blocks a
 "different technical choreography instead of silently replacing it.
    CLEAR: lv_schema_cfg_ok, lv_schema_cfg_msg.
    PERFORM ensure_schema_fp
      USING    lv_schema_id lv_template_schema_fp
      CHANGING lv_schema_cfg_ok lv_schema_cfg_msg.
    IF lv_schema_cfg_ok <> abap_true.
      cv_message = lv_schema_cfg_msg.
      RETURN.
    ENDIF.

    CLEAR: lv_schema_cfg_ok, lv_schema_cfg_msg.
    PERFORM ensure_version_fp
      USING    lv_schema_id lv_version_fp
      CHANGING lv_schema_cfg_ok lv_schema_cfg_msg.
    IF lv_schema_cfg_ok <> abap_true.
      cv_message = lv_schema_cfg_msg.
      RETURN.
    ENDIF.

    CLEAR: lv_exec_save_ok, lv_exec_save_msg.
    PERFORM save_exec_recording
      USING    lv_schema_id lt_z499_raw
      CHANGING lv_exec_save_ok lv_exec_save_msg.
    IF lv_exec_save_ok <> abap_true.
      cv_message = lv_exec_save_msg.
      RETURN.
    ENDIF.

    PERFORM mark_schema_reuse.
    gv_z133_outcome = gc_m2_z447_reused_schema.
    cv_message =
      |Selected fields + technical flow match { ls_contract-profile } v{ lv_schema_ver }; Version and Mapping reused. Sample data did not affect Version identity.|.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile lv_schema_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp 0 cv_message.
    PERFORM commit_evidence.
    COMMIT WORK AND WAIT.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

 "V17.9: do not block Mapping merely because the incoming recording has a
 "different field count from a historical reference. CHECK_SCRIPT_CAPTURE and
 "the compiler still reject malformed/non-recordable evidence, but a valid
 "different recording proceeds to Mapping and receives a new Version identity.

 "Import TXT and Guided Recording must converge to the same
 "canonical Mapping/Profile context. If the incoming SHDB/GUIDED evidence
 "matches an existing immutable contract exactly, open that exact contract
 "immediately instead of forcing a separate My Import / All Import path.
 "This is source-neutral and TCODE-neutral: the resolver decides by the
 "canonical technical contract only, not by origin, profile name or field list.
  IF ls_contract-exact = abap_true.
 "Exact technical flow still reuses a Version only when the selected SAP
 "field membership is identical. Friendly Template names are not Version
 "identity; the manifest keeps the established public names on reuse.
    DATA: lt_z917_ref_map TYPE ty_t_mapping_db,
          lv_z917_sel_fp TYPE zbdc_script_bup-contract_hash,
          lv_z917_sel_ok TYPE abap_bool,
          lv_z917_sel_msg TYPE string.
    SELECT * FROM zbdc_mapping_bup
      INTO TABLE @lt_z917_ref_map
      WHERE tcode = @iv_tcode
        AND profile_name = @ls_contract-profile
        AND profile_ver = @ls_contract-ref_ver.
    CLEAR: lv_z917_sel_fp, lv_z917_sel_ok, lv_z917_sel_msg.
    PERFORM selection_fp_map
      USING iv_tcode lt_z917_ref_map
      CHANGING lv_z917_sel_fp lv_z917_sel_ok lv_z917_sel_msg.
    IF lv_z917_sel_ok <> abap_true OR lv_z917_sel_fp <> lv_selection_fp.
      CLEAR ls_contract-exact.
    ENDIF.
  ENDIF.

  IF ls_contract-exact = abap_true.
 "REAL proof rule: exact resolution may reuse the persisted Mapping
 "context, but it must never replace the current raw acquisition rows.
 "CT_SCR remains the script captured/imported in this run.
    CLEAR: lv_pipeline_ok, lv_pipeline_msg.
    PERFORM apply_map_context
      USING    iv_tcode ls_contract-profile ls_contract-ref_ver ls_contract-ref_script_id ls_contract-ref_hash
      CHANGING lv_pipeline_ok lv_pipeline_msg.

    IF lv_pipeline_ok <> abap_true.
      PERFORM clear_map_context.
      p_rec_tcode   = iv_tcode.
      p_transaction = iv_tcode.
      cv_message = lv_pipeline_msg.
      IF cv_message IS INITIAL.
        cv_message = 'Exact canonical contract was found, but its Mapping context could not be loaded.'.
      ENDIF.
      gv_z133_outcome = gc_m2_z133_blocked.
      PERFORM log_evidence
        USING iv_tcode ls_contract-profile ls_contract-ref_ver iv_origin gv_z133_outcome
              ls_contract-in_contract_fp 0 cv_message.
      PERFORM commit_evidence.
      RETURN.
    ENDIF.

    CLEAR: lv_schema_cfg_ok, lv_schema_cfg_msg.
    PERFORM ensure_schema_fp
      USING    ls_contract-ref_script_id lv_template_schema_fp
      CHANGING lv_schema_cfg_ok lv_schema_cfg_msg.
    IF lv_schema_cfg_ok <> abap_true.
      cv_message = lv_schema_cfg_msg.
      RETURN.
    ENDIF.

    CLEAR: lv_schema_cfg_ok, lv_schema_cfg_msg.
    PERFORM ensure_version_fp
      USING    ls_contract-ref_script_id lv_version_fp
      CHANGING lv_schema_cfg_ok lv_schema_cfg_msg.
    IF lv_schema_cfg_ok <> abap_true.
      cv_message = lv_schema_cfg_msg.
      RETURN.
    ENDIF.

    CLEAR: lv_exec_save_ok, lv_exec_save_msg.
    PERFORM save_exec_recording
      USING    ls_contract-ref_script_id lt_z499_raw
      CHANGING lv_exec_save_ok lv_exec_save_msg.
    IF lv_exec_save_ok <> abap_true.
      cv_message = lv_exec_save_msg.
      RETURN.
    ENDIF.

    PERFORM mark_schema_reuse.
    gv_z133_outcome = gc_m2_z447_reused_schema.
    cv_message =
      |Current recording matches { ls_contract-profile } v{ ls_contract-ref_ver }; Mapping and immutable CT/BISM execution recording were reused.|.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile ls_contract-ref_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp 0 cv_message.
    PERFORM commit_evidence.
    COMMIT WORK AND WAIT.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

 "V17.9: schema equality alone never reuses or blocks a Version.
 "A changed technical choreography continues to new-Version allocation;
 "a changed selected field set does the same. Data-only changes are already
 "removed from both identities and therefore keep the existing Version.

 "Compile before allocating a version. Failed/partial attempts are evidence,
 "not published Template Versions.
  PERFORM auto_classify_shdb_script
    USING ls_contract-reference
    CHANGING ct_scr lv_dynamic lv_static.

  PERFORM single_class
    CHANGING ct_scr lv_compile_ok lv_dynamic lv_static
             lv_unresolved lv_ignored lv_save_msg.

  IF lv_compile_ok <> abap_true.
    PERFORM clear_map_context.
    p_rec_tcode       = iv_tcode.
    p_transaction     = iv_tcode.
    txtp_profile_name = ls_contract-profile.
    gt_script_def     = ct_scr.
    gv_z133_outcome   = gc_m2_z133_blocked.
    cv_message = lv_save_msg.
    IF cv_message IS INITIAL.
      cv_message =
        'Recording/import evidence is not publishable; no Template Version was allocated.'.
    ELSE.
      cv_message = cv_message &&
        ' No Template Version was allocated; the failed attempt remains evidence only.'.
    ENDIF.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile ls_contract-ref_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

 "compiler boundary: repeatable screen segments are compiled ONCE
 "from the classified acquisition snapshot. Runtime never calls these forms.
  PERFORM compile_raw_simple CHANGING ct_scr.

  CLEAR: lv_plan_ok, lv_plan_msg.
  PERFORM compiled_plan_ok
    USING    ct_scr
    CHANGING lv_plan_ok lv_plan_msg.
  IF lv_plan_ok <> abap_true.
    cv_message = lv_plan_msg.
    gv_z133_outcome = gc_m2_z133_blocked.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile ls_contract-ref_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    RETURN.
  ENDIF.

  IF lv_legacy_ref = abap_true.
    lv_question =
      |Existing { ls_contract-profile } version predates the current compiler. Publish a new DRAFT from the current immutable raw recording?|.
  ELSEIF ls_contract-is_new = abap_true.
    lv_question =
      |New { iv_tcode } business-input schema detected. Create its first DRAFT Template Version?|.
  ELSE.
    lv_question =
      |The business-input schema changed for { ls_contract-profile }. Create the next DRAFT Template Version? Existing versions remain unchanged.|.
  ENDIF.

  CALL FUNCTION 'POPUP_TO_CONFIRM'
    EXPORTING
      titlebar              = 'Automatic Onboarding'
      text_question         = lv_question
      text_button_1         = 'Continue'
      text_button_2         = 'Cancel'
      default_button        = '1'
      display_cancel_button = space
    IMPORTING
      answer                = lv_ans
    EXCEPTIONS
      OTHERS                = 1.

  IF sy-subrc <> 0 OR lv_ans <> '1'.
    gv_z133_outcome = gc_m2_z133_cancelled.
    cv_message = 'Onboarding cancelled; no Template Version was allocated or published.'.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile lv_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    RETURN.
  ENDIF.

 "Allocate only after a complete new schema is confirmed. Recheck semantic
 "identity here so concurrent users cannot create duplicate schema versions.
  CLEAR: lv_ver, lv_reservation_id, lv_reserve_ok, lv_reserve_msg,
         lv_reserve_reused, lv_reuse_id, lv_reuse_hash.
  PERFORM reserve_next_version
    USING    iv_tcode ls_contract-profile iv_origin lv_version_fp
    CHANGING lv_ver lv_reservation_id lv_reserve_reused
             lv_reuse_id lv_reuse_hash lv_reserve_ok lv_reserve_msg.

  IF lv_reserve_ok <> abap_true.
    cv_message = lv_reserve_msg.
    gv_z133_outcome = gc_m2_z133_blocked.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile ls_contract-ref_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    RETURN.
  ENDIF.

  IF lv_reserve_reused = abap_true.
    CLEAR: lv_pipeline_ok, lv_pipeline_msg.
    PERFORM apply_map_context
      USING    iv_tcode ls_contract-profile lv_ver lv_reuse_id lv_reuse_hash
      CHANGING lv_pipeline_ok lv_pipeline_msg.
    IF lv_pipeline_ok <> abap_true.
      cv_message = lv_pipeline_msg.
      IF cv_message IS INITIAL.
        cv_message =
          'Concurrent schema reuse succeeded, but the exact Mapping context could not be loaded.'.
      ENDIF.
      RETURN.
    ENDIF.

    CLEAR: lv_schema_cfg_ok, lv_schema_cfg_msg.
    PERFORM ensure_schema_fp
      USING    lv_reuse_id lv_template_schema_fp
      CHANGING lv_schema_cfg_ok lv_schema_cfg_msg.
    IF lv_schema_cfg_ok <> abap_true.
      cv_message = lv_schema_cfg_msg.
      RETURN.
    ENDIF.

    CLEAR: lv_exec_save_ok, lv_exec_save_msg.
    PERFORM save_exec_recording
      USING    lv_reuse_id lt_z499_raw
      CHANGING lv_exec_save_ok lv_exec_save_msg.
    IF lv_exec_save_ok <> abap_true.
      cv_message = lv_exec_save_msg.
      RETURN.
    ENDIF.

    PERFORM mark_schema_reuse.
    gv_z133_outcome = gc_m2_z447_reused_schema.
    cv_message =
      |Another user already published this business-input schema as { ls_contract-profile } v{ lv_ver }; Mapping and immutable CT/BISM execution recording were reused.|.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile lv_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp 0 cv_message.
    PERFORM commit_evidence.
    COMMIT WORK AND WAIT.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  txtp_profile_name = ls_contract-profile.
  gv_profile_ver     = lv_ver.
  gv_z133_outcome    = gc_m2_z133_candidate.

  CLEAR: lv_save_ok, lv_pipeline_msg, lv_desc.
  lv_desc = |Mapping Profile { ls_contract-profile } for { iv_tcode }|.
  PERFORM register_profile_tuple
    USING    iv_tcode ls_contract-profile lv_ver gc_m2_prof_draft lv_desc
    CHANGING lv_save_ok lv_pipeline_msg.
  IF lv_save_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM release_reservation USING lv_reservation_id.
    cv_message = lv_pipeline_msg.
    IF cv_message IS INITIAL.
      cv_message = 'Profile Registry could not create the reserved candidate tuple. No Mapping/version was published.'.
    ENDIF.
    gv_z133_outcome = gc_m2_z133_blocked.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile lv_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    RETURN.
  ENDIF.

 "Origin is persisted only as evidence metadata. It does not participate in
 "canonical resolution, completeness, idempotency, or Mapping selection.
  lv_recording = iv_origin.
  IF lv_recording IS INITIAL.
    lv_recording = 'CANONICAL'.
  ENDIF.

  PERFORM persist_profile_script
    USING    iv_tcode ls_contract-profile lv_ver lv_recording gc_m2_prof_draft ct_scr
    CHANGING lv_script_id lv_hash lv_save_ok lv_save_msg.
  IF lv_save_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM release_reservation USING lv_reservation_id.
    cv_message = lv_save_msg.
    gv_z133_outcome = gc_m2_z133_blocked.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile lv_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    RETURN.
  ENDIF.

 "freeze the normalized business-input schema on the immutable
 "Script ID. This makes repeated Import/Start Recording idempotent and
 "prevents a later DDIC compatibility change from being mistaken for the
 "old Version merely because the Mapping rows are re-read under new DDIC.
  CLEAR: lv_schema_cfg_ok, lv_schema_cfg_msg.
  PERFORM ensure_schema_fp
    USING    lv_script_id lv_template_schema_fp
    CHANGING lv_schema_cfg_ok lv_schema_cfg_msg.
  IF lv_schema_cfg_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM release_reservation USING lv_reservation_id.
    cv_message = lv_schema_cfg_msg.
    IF cv_message IS INITIAL.
      cv_message =
        'Normalized Template Schema identity could not be frozen for the new Version.'.
    ENDIF.
    RETURN.
  ENDIF.

  CLEAR: lv_schema_cfg_ok, lv_schema_cfg_msg.
  PERFORM ensure_version_fp
    USING    lv_script_id lv_version_fp
    CHANGING lv_schema_cfg_ok lv_schema_cfg_msg.
  IF lv_schema_cfg_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM release_reservation USING lv_reservation_id.
    cv_message = lv_schema_cfg_msg.
    RETURN.
  ENDIF.

 "the pre-schema confirmation used no Script ID by design. Once a
 "new immutable DRAFT Script/Hash exists, bind the same in-memory membership
 "+ exact names to that exact identity. Reuse paths return earlier and never
 "rewrite a previously certified immutable contract.
  IF ( gv_z652_acq_origin = 'GUIDED_RECORD'
       OR gv_z652_acq_origin = 'SHDB_TXT'
       OR gv_z652_acq_origin = 'SHDB_PROGRAM' )
     AND gv_z659_action_ready = abap_true
     AND gv_z684_name_ready = abap_true.
    CLEAR: lv_cert_ok, lv_cert_msg.
    PERFORM save_action_cert
      USING    lv_script_id lv_hash
      CHANGING lv_cert_ok lv_cert_msg.
    IF lv_cert_ok <> abap_true.
      ROLLBACK WORK.
      PERFORM release_reservation USING lv_reservation_id.
      cv_message = lv_cert_msg.
      IF cv_message IS INITIAL.
        cv_message = 'Exact user-action/name certificate could not be bound to the new Script/Hash.'.
      ENDIF.
      RETURN.
    ENDIF.
  ENDIF.

 "Persist acquisition truth separately and certify this Script ID with the current compiler version.
  CLEAR: lv_raw_save_ok, lv_raw_save_msg.
  PERFORM save_raw_snapshot
    USING    lv_script_id lt_z499_raw
    CHANGING lv_raw_save_ok lv_raw_save_msg.
  IF lv_raw_save_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM release_reservation USING lv_reservation_id.
    cv_message = lv_raw_save_msg.
    gv_z133_outcome = gc_m2_z133_blocked.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile lv_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    RETURN.
  ENDIF.

  CLEAR: lv_exec_save_ok, lv_exec_save_msg.
  PERFORM save_exec_recording
    USING    lv_script_id lt_z499_raw
    CHANGING lv_exec_save_ok lv_exec_save_msg.
  IF lv_exec_save_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM release_reservation USING lv_reservation_id.
    cv_message = lv_exec_save_msg.
    RETURN.
  ENDIF.

 "a Guided Recording already owns a unique SAP %BDC QID. Persist
 "that provenance beside the immutable RAW snapshot. Imports without an SAP
 "queue remain fully valid because their RAW truth is the imported payload.
  IF gv_z500_raw_qid IS NOT INITIAL.
    DATA: lv_z500_cfg_ok TYPE abap_bool,
          lv_z500_cfg_msg TYPE string.
    CLEAR: lv_z500_cfg_ok, lv_z500_cfg_msg.
    PERFORM set_script_cfg
      USING    lv_script_id 'RAWQID' gv_z500_raw_qid
      CHANGING lv_z500_cfg_ok lv_z500_cfg_msg.
    IF lv_z500_cfg_ok <> abap_true.
      ROLLBACK WORK.
      PERFORM release_reservation USING lv_reservation_id.
      cv_message = lv_z500_cfg_msg.
      RETURN.
    ENDIF.

    IF gv_z500_raw_group IS NOT INITIAL.
      CLEAR: lv_z500_cfg_ok, lv_z500_cfg_msg.
      PERFORM set_script_cfg
        USING    lv_script_id 'RAWGROUP' gv_z500_raw_group
        CHANGING lv_z500_cfg_ok lv_z500_cfg_msg.
      IF lv_z500_cfg_ok <> abap_true.
        ROLLBACK WORK.
        PERFORM release_reservation USING lv_reservation_id.
        cv_message = lv_z500_cfg_msg.
        RETURN.
      ENDIF.
    ENDIF.

    CLEAR: lv_z500_cfg_ok, lv_z500_cfg_msg.
    PERFORM set_script_cfg
      USING    lv_script_id 'RAWSOURCE' 'SAP_APQI'
      CHANGING lv_z500_cfg_ok lv_z500_cfg_msg.
    IF lv_z500_cfg_ok <> abap_true.
      ROLLBACK WORK.
      PERFORM release_reservation USING lv_reservation_id.
      cv_message = lv_z500_cfg_msg.
      RETURN.
    ENDIF.

 "ARCH_RESET: Guided Recording uses the standard batch-input CTU boundary.
 "Persist the acquisition policy so runtime consumes exactly what onboarding
 "captured and never switches environment after a failure.
    CLEAR: lv_z500_cfg_ok, lv_z500_cfg_msg.
    PERFORM set_script_cfg
      USING    lv_script_id 'CTURACOM' 'TERMINATE'
      CHANGING lv_z500_cfg_ok lv_z500_cfg_msg.
    IF lv_z500_cfg_ok <> abap_true.
      ROLLBACK WORK.
      PERFORM release_reservation USING lv_reservation_id.
      cv_message = lv_z500_cfg_msg.
      RETURN.
    ENDIF.

 "Persist the CTU environment that Start Recording ACTUALLY used.
 "record_tcode_bdc calls BDC_RECORD_TRANSACTION with NOBINPT initial,
 "RACOMMIT initial and DEFSIZE = X. The previous ONLINE marker claimed
 "NOBINPT = X even though the recorder did not use it, so runtime could
 "replay the same BDCDATA under a different SAP batch-input environment.
    CLEAR: lv_z500_cfg_ok, lv_z500_cfg_msg.
    PERFORM set_script_cfg
      USING    lv_script_id 'CTUNOBIN' 'BATCH'
      CHANGING lv_z500_cfg_ok lv_z500_cfg_msg.
    IF lv_z500_cfg_ok <> abap_true.
      ROLLBACK WORK.
      PERFORM release_reservation USING lv_reservation_id.
      cv_message = lv_z500_cfg_msg.
      RETURN.
    ENDIF.

    CLEAR: lv_z500_cfg_ok, lv_z500_cfg_msg.
    PERFORM set_script_cfg
      USING    lv_script_id 'CTUDEFSZ' 'X'
      CHANGING lv_z500_cfg_ok lv_z500_cfg_msg.
    IF lv_z500_cfg_ok <> abap_true.
      ROLLBACK WORK.
      PERFORM release_reservation USING lv_reservation_id.
      cv_message = lv_z500_cfg_msg.
      RETURN.
    ENDIF.
  ENDIF.

  PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  UPDATE zbdc_prof_bup
    SET status     = @gc_m2_prof_draft,
        changed_by = @sy-uname,
        changed_on = @gv_demo_date_837,
        changed_at = @gv_demo_time_837
    WHERE tcode        = @iv_tcode
      AND profile_name = @ls_contract-profile
      AND profile_ver  = @lv_ver.

  IF sy-subrc <> 0.
    ROLLBACK WORK.
    PERFORM release_reservation USING lv_reservation_id.
    CONCATENATE
      'Captured recording was not published.'
      'The reserved Profile Registry tuple could not be finalized;'
      'the onboarding candidate was rolled back without publishing a Mapping version.'
      'No existing profile or script was overwritten.'
      'Refresh and start/import the recording again.'
      INTO cv_message SEPARATED BY space.
    gv_z133_outcome = gc_m2_z133_blocked.
    PERFORM log_evidence
      USING iv_tcode ls_contract-profile lv_ver iv_origin gv_z133_outcome
            ls_contract-in_contract_fp ls_contract-missing cv_message.
    PERFORM commit_evidence.
    RETURN.
  ENDIF.

 "Onboarding publishes only the immutable DRAFT tuple. Mapping creation,
 "review/save and TESTING transition are separate explicit commands.
  cv_message =
    |New Template Schema { ls_contract-profile } v{ lv_ver } was created in DRAFT. Repeated Start/Import/Generate actions reuse this version until the business-input schema changes.|.
  PERFORM log_evidence
    USING iv_tcode ls_contract-profile lv_ver iv_origin gc_m2_z133_candidate
          ls_contract-in_contract_fp 0 cv_message.

 "Profile, script, steps and optional evidence are committed together.
  COMMIT WORK AND WAIT.

 "Immutable result tuple used by the Mapping screen.
  CLEAR: lv_pipeline_ok, lv_pipeline_msg.
  PERFORM apply_map_context
    USING    iv_tcode ls_contract-profile lv_ver lv_script_id lv_hash
    CHANGING lv_pipeline_ok lv_pipeline_msg.
  IF lv_pipeline_ok <> abap_true.
    cv_message = lv_pipeline_msg.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  CLEAR gv_z133_reservation_id.
ENDFORM.

*& Guided Recording using SAP transaction-recording mechanism
*& Captures BDC data directly from the sample transaction, then passes the
*& exact captured script through the same classifier/mapping/certification
*& pipeline as SHDB TXT import. No TCODE-specific branch is used.

FORM record_tcode_bdc
  USING    iv_tcode TYPE sy-tcode
  CHANGING ct_bdc   TYPE ty_bdcdata_tab
           cv_ok    TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_bdc_local TYPE ty_bdcdata_tab,
        lt_msg       TYPE STANDARD TABLE OF bdcmsgcoll,
        ls_opt       TYPE ctu_params,
        ls_first_bdc TYPE bdcdata,
        lv_call_subrc TYPE sy-subrc,
        lv_import_subrc TYPE sy-subrc,
        lv_capture_ok  TYPE abap_bool,
        lv_capture_msg TYPE string,
        ls_rec_msg     TYPE bdcmsgcoll,
        lv_last_type   TYPE c LENGTH 1,
        lv_last_id     TYPE symsgid,
        lv_last_nr     TYPE symsgno,
        lv_last_v1     TYPE symsgv,
        lv_abort_msg   TYPE abap_bool,
        lv_flag_batch_input TYPE flag,
        lv_nr_batch_input   TYPE field_vals-nr_dynpro.

  DATA lt_z651_field_values TYPE STANDARD TABLE OF field_vals.

  CLEAR: cv_ok, cv_message.
  REFRESH: ct_bdc, lt_bdc_local, lt_msg, gt_z360_rec_field_vals,
           lt_z651_field_values.

 "ROOT FIX:
 "Guided Recording has TWO independent authorities:
 " 1) FIELD_VALS captured at the live recorder boundary = input provenance.
 " 2) BDCDATA produced from exactly those FIELD_VALS = replay truth.
 "Do not call BDC_RECORD_TRANSACTION first and try to recover FIELD_VALS
 "after flattening. Activate the SBDR recording boundary, import
 "%_HD_NEW_VARIANT immediately when the transaction returns, then flatten
 "that exact native table with FVAL_TO_BDC. If native provenance is missing,
 "onboarding fails closed. There is no cursor/repeat/cross-scope fallback for
 "GUIDED_RECORD.

  CLEAR ls_opt.
  ls_opt-dismode  = 'A'.
  ls_opt-updmode  = 'S'.
  CLEAR ls_opt-cattmode.
  ls_opt-defsize  = 'X'.
  CLEAR: ls_opt-racommit, ls_opt-nobiend, ls_opt-nobinpt.

 "Start with a clean recorder memory boundary so no previous transaction can
 "contribute provenance to this acquisition.
  FREE MEMORY ID '%_HD_NEW_VARIANT'.
  FREE MEMORY ID '%_HD_TCVARIANT'.
  FREE MEMORY ID '%_HD_VARIANT_NAME'.
  FREE MEMORY ID '%_HD_LAST_SCREEN'.
  FREE MEMORY ID '%_HD_PROCESS'.
  FREE MEMORY ID '%_HD_BATCH_INPUT'.

  CALL 'SET_TRANS_VAR' ID 'RECORDING' FIELD 'X'.
  EXPORT flag_process_function_pai = 'X'
    TO MEMORY ID '%_HD_PROCESS'.

  lv_flag_batch_input = 'X'.
  lv_nr_batch_input   = 0.
  EXPORT flag_batch_input = lv_flag_batch_input
         nr_batch_input   = lv_nr_batch_input
    TO MEMORY ID '%_HD_BATCH_INPUT'.

  CALL 'SET_TRANS_VAR' ID 'ACTIV' FIELD 'X'.

 "LT_BDC_LOCAL is intentionally initial on entry. While RECORDING is active
 "SAP writes native FIELD_VALS into %_HD_NEW_VARIANT. Import that table
 "BEFORE any FVAL_TO_BDC conversion.
  CALL TRANSACTION iv_tcode
    USING lt_bdc_local
    OPTIONS FROM ls_opt
    MESSAGES INTO lt_msg.

  lv_call_subrc = sy-subrc.

  REFRESH lt_z651_field_values.
  IMPORT field_values = lt_z651_field_values
    FROM MEMORY ID '%_HD_NEW_VARIANT'.
  lv_import_subrc = sy-subrc.

 "End/clean recorder state immediately after native evidence is copied.
  FREE MEMORY ID '%_HD_NEW_VARIANT'.
  FREE MEMORY ID '%_HD_TCVARIANT'.
  FREE MEMORY ID '%_HD_VARIANT_NAME'.
  FREE MEMORY ID '%_HD_LAST_SCREEN'.
  FREE MEMORY ID '%_HD_PROCESS'.
  FREE MEMORY ID '%_HD_BATCH_INPUT'.
  CALL 'SET_TRANS_VAR' ID 'RECORDING' FIELD ' '.

  IF lv_call_subrc <> 0.
    cv_message =
      |RECORDER_TECHNICAL_ERROR: live recorder returned SY-SUBRC={ lv_call_subrc } for { iv_tcode }. Nothing was onboarded.|.
    RETURN.
  ENDIF.

 "The real recorder outcome must not terminate in error. Correctable E
 "messages are tolerated only if a later non-error message finishes the
 "recording. A/X is always fatal. No message ID is hardcoded.
  CLEAR: lv_last_type, lv_last_id, lv_last_nr, lv_last_v1, lv_abort_msg.
  LOOP AT lt_msg INTO ls_rec_msg.
    IF ls_rec_msg-msgtyp IS INITIAL.
      CONTINUE.
    ENDIF.
    lv_last_type = ls_rec_msg-msgtyp.
    lv_last_id   = ls_rec_msg-msgid.
    lv_last_nr   = ls_rec_msg-msgnr.
    lv_last_v1   = ls_rec_msg-msgv1.
    IF ls_rec_msg-msgtyp = 'A' OR ls_rec_msg-msgtyp = 'X'.
      lv_abort_msg = abap_true.
    ENDIF.
  ENDLOOP.

  IF lv_abort_msg = abap_true OR lv_last_type = 'E'.
    cv_message =
      |LIVE_CAPTURE_BLOCKED: recorder ended with SAP message { lv_last_type } { lv_last_id }-{ lv_last_nr } { lv_last_v1 }; error-only/incomplete transaction flow is not onboarded.|.
    RETURN.
  ENDIF.

 "Native provenance is mandatory for Guided Recording. Do not silently
 "degrade to BDCDATA/cursor heuristics when the recorder boundary is absent.
  IF lv_import_subrc <> 0 OR lt_z651_field_values IS INITIAL.
    cv_message =
      |RECORDER_NATIVE_PROVENANCE_MISSING: { iv_tcode } returned no FIELD_VALS from the live SBDR recorder boundary. Guided onboarding is blocked; no heuristic fallback was used.|.
    RETURN.
  ENDIF.

  gt_z360_rec_field_vals = lt_z651_field_values.

 "Flatten the SAME native FIELD_VALS into replay BDCDATA only after the
 "provenance copy has been preserved. Mapping membership and execution replay
 "therefore come from one concrete recording.
  REFRESH lt_bdc_local.
  PERFORM fval_to_bdc IN PROGRAM saplsbdr
    TABLES lt_z651_field_values lt_bdc_local
    USING ''.

 "FVAL_TO_BDC may prepend a technical transaction header or empty wrapper.
 "Remove only those structural wrappers; never delete a real first dynpro.
  READ TABLE lt_bdc_local INTO ls_first_bdc INDEX 1.
  IF sy-subrc = 0 AND ls_first_bdc-dynbegin = 'T'.
    DELETE lt_bdc_local INDEX 1.
  ELSEIF sy-subrc = 0
     AND ls_first_bdc-dynbegin IS INITIAL
     AND ls_first_bdc-program  IS INITIAL
     AND ls_first_bdc-dynpro   IS INITIAL
     AND ls_first_bdc-fnam     IS INITIAL
     AND ls_first_bdc-fval     IS INITIAL.
    DELETE lt_bdc_local INDEX 1.
  ENDIF.

  IF lt_bdc_local IS INITIAL.
    REFRESH gt_z360_rec_field_vals.
    cv_message =
      |RECORDER_NO_BDCDATA: native FIELD_VALS were captured for { iv_tcode } but SAP FVAL_TO_BDC produced no executable BDCDATA. Nothing was onboarded.|.
    RETURN.
  ENDIF.

 "Reject launcher/error-only captures before BDC_OBJECT_CREATE. This remains
 "a structural/repository gate only; no TCODE or business field is hardcoded.
  CLEAR: lv_capture_ok, lv_capture_msg.
  PERFORM check_bdc_capture
    USING    iv_tcode lt_bdc_local
    CHANGING lv_capture_ok lv_capture_msg.
  IF lv_capture_ok <> abap_true.
    REFRESH gt_z360_rec_field_vals.
    cv_message = lv_capture_msg.
    RETURN.
  ENDIF.

  ct_bdc[] = lt_bdc_local[].
  cv_ok = abap_true.
  cv_message =
    |SAP recorder captured one native FIELD_VALS provenance set and matching real BDCDATA for { iv_tcode }.|.
ENDFORM.

*& persist Guided BDCDATA in SAP SBDR storage and READ IT BACK

*& Truth rule:
*& The current Start Recording capture is the only input.
*& No Import/Profile/Mapping/history row is allowed to add or replace a
*& business field.
*& Persist via standard BDC_OBJECT_CREATE (%BDC), commit, then read the
*& persisted SAP object back via BDC_OBJECT_READ. The read-back BDCDATA
*& becomes the sole authority for the following TXT serialization/parser.
*& The saved %BDC object is retained as audit evidence, so the exact Start
*& Recording can be inspected/exported later by recording name/QID.

FORM persist_readback_bdc
  USING    iv_tcode TYPE sy-tcode
           it_bdc   TYPE ty_bdcdata_tab
  CHANGING ct_bdc   TYPE ty_bdcdata_tab
           cv_ok    TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_save        TYPE ty_bdcdata_tab,
        lt_read        TYPE ty_bdcdata_tab,
        lt_input_exec  TYPE ty_bdcdata_tab,
        lt_read_exec   TYPE ty_bdcdata_tab,
        ls_key         TYPE apqi,
        ls_first       TYPE bdcdata,
        ls_trans_hdr   TYPE bdcdata,
        ls_cmp         TYPE bdcdata,
        ls_in          TYPE bdcdata,
        ls_out         TYPE bdcdata,
        lv_name        TYPE apqi-groupid,
        lv_qid         TYPE apqd-qid,
        lv_create_rc   TYPE sy-subrc,
        lv_read_rc     TYPE sy-subrc,
        lv_rows_in     TYPE i,
        lv_rows_out    TYPE i,
        lv_exec_in     TYPE i,
        lv_exec_out    TYPE i,
        lv_cmp_idx     TYPE i.

  CLEAR: cv_ok, cv_message, ls_key, ls_first, ls_trans_hdr, ls_cmp,
         ls_in, ls_out, lv_qid, lv_create_rc, lv_read_rc,
         lv_rows_in, lv_rows_out, lv_exec_in, lv_exec_out, lv_cmp_idx.
  REFRESH: ct_bdc, lt_save, lt_read, lt_input_exec, lt_read_exec.

  IF iv_tcode IS INITIAL OR it_bdc IS INITIAL.
    cv_message = 'TCODE and current Guided BDCDATA are required for SAP recording persistence.'.
    RETURN.
  ENDIF.

 "A persisted SHDB-style %BDC recording contains a technical transaction
 "header (DYNBEGIN = 'T', FNAM = TCODE) before the first screen. This is
 "recording metadata only; it does not invent or alter any business field.
  READ TABLE it_bdc INTO ls_first INDEX 1.
  IF sy-subrc = 0 AND ls_first-dynbegin = 'T'.
    lt_save[] = it_bdc[].
  ELSE.
    CLEAR ls_trans_hdr.
    ls_trans_hdr-dynbegin = 'T'.
    ls_trans_hdr-fnam     = iv_tcode.
    APPEND ls_trans_hdr TO lt_save.
    APPEND LINES OF it_bdc TO lt_save.
  ENDIF.

  DESCRIBE TABLE lt_save LINES lv_rows_in.

 "12-char technical recording name: ZR + MMDD + HHMMSS.
 "It contains no business rule and is never used to resolve Mapping.
  PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  lv_name = |ZR{ gv_demo_date_837+4(4) }{ gv_demo_time_837 }|.

  CALL FUNCTION 'BDC_OBJECT_CREATE'
    EXPORTING
      name           = lv_name
      client         = sy-mandt
      datatype       = '%BDC'
      user           = sy-uname
      keep           = 'X'
    IMPORTING
      key            = ls_key
    TABLES
      dynprotab      = lt_save
    EXCEPTIONS
      system_failure = 1
      OTHERS         = 2.

  lv_create_rc = sy-subrc.
  IF lv_create_rc <> 0 OR ls_key-qid IS INITIAL.
    cv_message = |SAP %BDC recording save failed; SY-SUBRC={ lv_create_rc }.|.
    RETURN.
  ENDIF.

  lv_qid = ls_key-qid.
  gv_z500_raw_qid   = lv_qid.
  gv_z500_raw_group = lv_name.
  COMMIT WORK AND WAIT.

 "Important: Mapping is NOT built from LT_SAVE. Read the object back from
 "SAP recording storage and make that persisted copy authoritative.
  CALL FUNCTION 'BDC_OBJECT_READ'
    EXPORTING
      queue_id         = lv_qid
      datatype         = '%BDC'
      trans            = 0
    TABLES
      dynprotab        = lt_read
    EXCEPTIONS
      not_found        = 1
      system_failure   = 2
      invalid_datatype = 3
      OTHERS           = 4.

  lv_read_rc = sy-subrc.
  IF lv_read_rc <> 0.
    cv_message = |Saved SAP recording { lv_name } (QID { lv_qid }) could not be read back; SY-SUBRC={ lv_read_rc }.|.
    RETURN.
  ENDIF.

  IF lt_read IS INITIAL.
    cv_message = |Saved SAP recording { lv_name } (QID { lv_qid }) returned no BDCDATA.|.
    RETURN.
  ENDIF.

  DESCRIBE TABLE lt_read LINES lv_rows_out.

 "SBDR persistence is audit storage, not a transformation boundary.
 "Compare executable rows from the direct BDC_RECORD_TRANSACTION return with
 "the SAP read-back copy. Ignore only the technical transaction header and
 "provably empty wrappers. Any PROGRAM/DYNPRO/FNAM/FVAL/order drift blocks
 "Start Recording instead of silently publishing a different replay stream.
  LOOP AT it_bdc INTO ls_cmp.
    IF ls_cmp-dynbegin = 'T'.
      CONTINUE.
    ENDIF.
    IF ls_cmp-dynbegin IS INITIAL
       AND ls_cmp-program IS INITIAL
       AND ls_cmp-dynpro IS INITIAL
       AND ls_cmp-fnam IS INITIAL
       AND ls_cmp-fval IS INITIAL.
      CONTINUE.
    ENDIF.
    APPEND ls_cmp TO lt_input_exec.
  ENDLOOP.

  LOOP AT lt_read INTO ls_cmp.
    IF ls_cmp-dynbegin = 'T'.
      CONTINUE.
    ENDIF.
    IF ls_cmp-dynbegin IS INITIAL
       AND ls_cmp-program IS INITIAL
       AND ls_cmp-dynpro IS INITIAL
       AND ls_cmp-fnam IS INITIAL
       AND ls_cmp-fval IS INITIAL.
      CONTINUE.
    ENDIF.
    APPEND ls_cmp TO lt_read_exec.
  ENDLOOP.

  DESCRIBE TABLE lt_input_exec LINES lv_exec_in.
  DESCRIBE TABLE lt_read_exec  LINES lv_exec_out.
  IF lv_exec_in <> lv_exec_out.
    cv_message =
      |START_RECORD_SBDR_DRIFT: recorder returned { lv_exec_in } executable row(s), SAP read-back returned { lv_exec_out }. Nothing was published.|.
    RETURN.
  ENDIF.

  DO lv_exec_in TIMES.
    lv_cmp_idx = sy-index.
    READ TABLE lt_input_exec INTO ls_in INDEX lv_cmp_idx.
    READ TABLE lt_read_exec  INTO ls_out INDEX lv_cmp_idx.
    IF sy-subrc <> 0
       OR ls_in-program  <> ls_out-program
       OR ls_in-dynpro   <> ls_out-dynpro
       OR ls_in-dynbegin <> ls_out-dynbegin
       OR ls_in-fnam     <> ls_out-fnam
       OR ls_in-fval     <> ls_out-fval.
      cv_message =
        |START_RECORD_SBDR_DRIFT at row { lv_cmp_idx }: SAP persistence changed PROGRAM/DYNPRO/DYNBEGIN/FNAM/FVAL/order. Nothing was published.|.
      RETURN.
    ENDIF.
  ENDDO.

 "The direct SAP recorder return remains canonical execution truth. The
 "read-back object is retained only as independently verified audit evidence.
  ct_bdc[] = lt_input_exec[].
  cv_ok = abap_true.
  cv_message =
    |Start Recording fidelity verified: { lv_exec_in } executable BDCDATA row(s) persisted/read back without change; QID { lv_qid }.|.
ENDFORM.

*& serialize real Guided BDCDATA to SHDB-compatible TXT lines
*& The format is the same five-column tab layout consumed by the existing
*& SHDB TXT Import path: PROGRAM / DYNPRO / FLAG / FNAM / FVAL.
*& Nothing is read from Mapping/Profile/history and no business field is
*& added, removed or renamed here.

FORM bdc_to_shdb_txt
  USING    iv_tcode TYPE sy-tcode
           it_bdc   TYPE ty_bdcdata_tab
  CHANGING ct_raw   TYPE string_table
           cv_ok    TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_bdc         TYPE bdcdata,
        lv_line        TYPE string,
        lv_tab         TYPE c LENGTH 1,
        lv_have_screen TYPE abap_bool,
        lv_rows        TYPE i.

  CLEAR: cv_ok, cv_message, lv_have_screen, lv_rows.
  REFRESH ct_raw.
  lv_tab = cl_abap_char_utilities=>horizontal_tab.

  IF iv_tcode IS INITIAL OR it_bdc IS INITIAL.
    cv_message = 'TCODE and real BDCDATA are required for SHDB-TXT serialization.'.
    RETURN.
  ENDIF.

  lv_line = lv_tab && '0000' && lv_tab && 'T' && lv_tab && iv_tcode && lv_tab.
  APPEND lv_line TO ct_raw.

  LOOP AT it_bdc INTO ls_bdc.
    CLEAR lv_line.

    IF ls_bdc-dynbegin = 'X'.
      lv_have_screen = abap_true.
      lv_line = ls_bdc-program && lv_tab
             && ls_bdc-dynpro  && lv_tab
             && 'X'            && lv_tab
             && lv_tab.
      APPEND lv_line TO ct_raw.
      lv_rows = lv_rows + 1.
      CONTINUE.
    ENDIF.

    IF ls_bdc-fnam IS INITIAL.
      CONTINUE.
    ENDIF.

    IF lv_have_screen <> abap_true.
      CONTINUE.
    ENDIF.

    lv_line = lv_tab && '0000' && lv_tab && space && lv_tab
           && ls_bdc-fnam && lv_tab && ls_bdc-fval.
    APPEND lv_line TO ct_raw.
    lv_rows = lv_rows + 1.
  ENDLOOP.

  IF lv_rows = 0.
    REFRESH ct_raw.
    cv_message = |No SHDB-compatible rows could be serialized for { iv_tcode }.|.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message = |Serialized { lv_rows } real BDCDATA row(s) to SHDB-compatible TXT in memory.|.
ENDFORM.

*& one parser for user-imported SHDB TXT and Guided TXT
*& ORIGIN is intentionally absent. Provenance is attached later by the
*& onboarding caller; parsing cannot branch by acquisition source.

FORM parse_shdb_txt_lines
  USING    it_raw       TYPE string_table
  CHANGING cv_tcode     TYPE sy-tcode
           ct_scr       TYPE ty_t_script
           cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lt_tok        TYPE string_table,
        lv_line       TYPE string,
        lv_prog       TYPE string,
        lv_dynp       TYPE string,
        lv_flag       TYPE string,
        lv_fnam       TYPE string,
        lv_fval       TYPE string,
        lv_next_tcode TYPE sy-tcode,
        lv_seen_t     TYPE abap_bool,
        lv_have_scr   TYPE abap_bool,
        lv_seq        TYPE n LENGTH 4 VALUE '0000',
        ls_scr        TYPE ty_script_def_compat.

  CLEAR: cv_tcode, cv_ok, cv_message, lv_seen_t, lv_have_scr.
  REFRESH ct_scr.

  LOOP AT it_raw INTO lv_line.
    REFRESH lt_tok.
    SPLIT lv_line AT cl_abap_char_utilities=>horizontal_tab INTO TABLE lt_tok.
    CLEAR: lv_prog, lv_dynp, lv_flag, lv_fnam, lv_fval.

    READ TABLE lt_tok INTO lv_prog INDEX 1.
    READ TABLE lt_tok INTO lv_dynp INDEX 2.
    READ TABLE lt_tok INTO lv_flag INDEX 3.
    READ TABLE lt_tok INTO lv_fnam INDEX 4.
    READ TABLE lt_tok INTO lv_fval INDEX 5.

    CONDENSE: lv_prog, lv_dynp, lv_flag, lv_fnam.

    IF lv_flag = 'T'.
      IF lv_fnam IS INITIAL.
        cv_message = 'SHDB TXT contains an empty transaction header.'.
        REFRESH ct_scr.
        CLEAR cv_tcode.
        RETURN.
      ENDIF.

      CLEAR lv_next_tcode.
      lv_next_tcode = lv_fnam.
      TRANSLATE lv_next_tcode TO UPPER CASE.
      CONDENSE lv_next_tcode NO-GAPS.

      IF lv_seen_t = abap_true.
 "a second T header starts a new recorded transaction block.
 "Even when the TCODE is the same, merging both blocks creates a fake
 "hybrid Template (values from different user runs). One Mapping
 "contract is therefore bound to exactly one recorded transaction.
        cv_message =
          |SHDB TXT contains more than one recorded transaction block ({ cv_tcode }). Import/export one recorded transaction per file; blocks were not merged.|.
        REFRESH ct_scr.
        CLEAR cv_tcode.
        RETURN.
      ELSE.
        cv_tcode = lv_next_tcode.
        lv_seen_t = abap_true.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF lv_seen_t <> abap_true OR cv_tcode IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_scr.
    ls_scr-tcode = cv_tcode.

    IF lv_flag = 'X'.
      IF lv_prog IS INITIAL OR lv_dynp IS INITIAL.
        CONTINUE.
      ENDIF.
      lv_have_scr = abap_true.
      lv_seq = lv_seq + 10.
      ls_scr-step_seq      = lv_seq.
      ls_scr-row_type      = gc_rt_header.
      ls_scr-program_name  = lv_prog.
      ls_scr-dynpro_no     = lv_dynp.
      ls_scr-is_new_screen = 'X'.
      APPEND ls_scr TO ct_scr.
      CONTINUE.
    ENDIF.

    IF lv_fnam IS INITIAL.
      CONTINUE.
    ENDIF.

    IF lv_have_scr <> abap_true.
      CONTINUE.
    ENDIF.

    lv_seq = lv_seq + 10.
    ls_scr-step_seq     = lv_seq.
    ls_scr-row_type     = gc_rt_header.
    ls_scr-field_name   = lv_fnam.
    ls_scr-value_type   = gc_m2_vt_unresolved.
    ls_scr-static_value = lv_fval.
    APPEND ls_scr TO ct_scr.
  ENDLOOP.

  IF cv_tcode IS INITIAL OR ct_scr IS INITIAL.
    REFRESH ct_scr.
    CLEAR cv_tcode.
    cv_message = 'The data is not a valid tab-separated SHDB recording.'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message = |Parsed SHDB recording for { cv_tcode } through the shared TXT parser.|.
ENDFORM.

*& Z600 - Prove Start Recording save/read-back -> parser is lossless

FORM verify_saved_bdc_rt
  USING    it_bdc       TYPE ty_bdcdata_tab
           it_script    TYPE ty_t_script
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lt_source   TYPE ty_bdcdata_tab,
        lt_rebuilt  TYPE ty_bdcdata_tab,
        ls_bdc      TYPE bdcdata,
        ls_src      TYPE bdcdata,
        ls_reb      TYPE bdcdata,
        ls_scr      TYPE ty_script_def_compat,
        lv_index    TYPE i,
        lv_src_n    TYPE i,
        lv_reb_n    TYPE i.

  CLEAR: cv_ok, cv_message, lv_index.
  REFRESH: lt_source, lt_rebuilt.

  LOOP AT it_bdc INTO ls_bdc.
    IF ls_bdc-dynbegin = 'T'.
      CONTINUE.
    ENDIF.

    IF ls_bdc-dynbegin IS INITIAL
       AND ls_bdc-program IS INITIAL
       AND ls_bdc-dynpro IS INITIAL
       AND ls_bdc-fnam IS INITIAL
       AND ls_bdc-fval IS INITIAL.
      CONTINUE.
    ENDIF.

    APPEND ls_bdc TO lt_source.
  ENDLOOP.

  LOOP AT it_script INTO ls_scr.
    CLEAR ls_bdc.
    IF ls_scr-is_new_screen = 'X'.
      ls_bdc-program  = ls_scr-program_name.
      ls_bdc-dynpro   = ls_scr-dynpro_no.
      ls_bdc-dynbegin = 'X'.
    ELSE.
      ls_bdc-fnam = ls_scr-field_name.
      ls_bdc-fval = ls_scr-static_value.
    ENDIF.
    APPEND ls_bdc TO lt_rebuilt.
  ENDLOOP.

  DESCRIBE TABLE lt_source  LINES lv_src_n.
  DESCRIBE TABLE lt_rebuilt LINES lv_reb_n.
  IF lv_src_n <> lv_reb_n.
    cv_message =
      |START_RECORD_PARSE_LOSS: saved %BDC has { lv_src_n } replay row(s), parser produced { lv_reb_n }.|.
    RETURN.
  ENDIF.

  DO lv_src_n TIMES.
    lv_index = sy-index.
    READ TABLE lt_source  INTO ls_src INDEX lv_index.
    READ TABLE lt_rebuilt INTO ls_reb INDEX lv_index.
    IF sy-subrc <> 0 OR ls_src <> ls_reb.
      cv_message =
        |START_RECORD_PARSE_LOSS at replay row { lv_index }: PROGRAM/DYNPRO/DYNBEGIN/FNAM/FVAL changed.|.
      RETURN.
    ENDIF.
  ENDDO.

  cv_ok = abap_true.
  cv_message =
    |Start Recording round-trip proof OK: { lv_src_n } saved %BDC replay row(s) parsed without loss.|.
ENDFORM.

*& Consolidated Guided Recording visual-evidence architecture
*& Recording, screen capture and AI analysis are separate phases.
*& During transaction entry one hidden WScript-launched helper captures only a foreground
*& window whose native Windows class is SAP_FRONTEND_SESSION. It never binds to the PID
*& that happened to be foreground during helper startup, eliminating the V3 startup race.
*& It never calls SAP GUI Scripting COM, so no field/focus polling runs per keystroke.
*& After Back, one atomic manifest is uploaded; no per-PNG probes or OpenAI HTTP call run here.
*& Mapping Profile later sends one multi-image OpenAI Responses request. The model sees
*& opaque candidate IDs and exact recorded values, never SAP technical field names.
*& ABAP accepts a label only when the matched recorded value resolves uniquely to one
*& logical SHDB field. HTTP 429/auth/transient failures keep evidence for retry and
*& never force the user to record the transaction again.

FORM start_gui_label_capture
  USING    iv_tcode   TYPE sy-tcode
  CHANGING cv_started TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_token         TYPE string,
        lv_call_subrc    TYPE sy-subrc,
        lv_flush_subrc   TYPE sy-subrc,
        lv_system_dir    TYPE string,
        lv_wscript_host  TYPE string,
        lv_ps_host       TYPE string,
        lv_prefix        TYPE string,
        lv_launcher      TYPE string,
        lv_ps_script     TYPE string,
        lv_req_log       TYPE string,
        lv_shot_log      TYPE string,
        lv_shot_ready    TYPE string,
        lv_ps_cmd        TYPE string,
        lv_vbs_cmd       TYPE string.

  IF gt_z866_screen_caps IS NOT INITIAL
     OR gv_z865_cap_script IS NOT INITIAL
     OR gv_z865_cap_log IS NOT INITIAL
     OR gv_z865_cap_stop IS NOT INITIAL
     OR gv_z865_cap_ready IS NOT INITIAL
     OR gv_z865_cap_done IS NOT INITIAL.
    PERFORM cleanup_screen_capture_files.
  ENDIF.

  CLEAR: cv_started, cv_message, gv_z865_cap_on,
         gv_z865_cap_script, gv_z865_cap_log, gv_z865_cap_stop,
         gv_z865_cap_ready, gv_z865_cap_done,
         gv_z866_vision_analyzed, gv_z877_cap_diag.
  REFRESH: gt_z865_gui_labels, gt_z866_screen_caps.

  IF iv_tcode IS INITIAL.
    cv_message =
      'GUI_COMMAND_CAPTURE_TCODE_MISSING: Guided Recording requires a TCODE.'.
    RETURN.
  ENDIF.

  CLEAR gv_z875_fe_temp.
  CALL METHOD cl_gui_frontend_services=>get_temp_directory
    CHANGING
      temp_dir = gv_z875_fe_temp
    EXCEPTIONS
      OTHERS   = 1.
  lv_call_subrc = sy-subrc.
  CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
  lv_flush_subrc = sy-subrc.
  IF lv_call_subrc <> 0
     OR lv_flush_subrc <> 0
     OR gv_z875_fe_temp IS INITIAL.
    cv_message =
      'GUI_COMMAND_CAPTURE_BOOTSTRAP_FAILED: frontend TEMP cannot be resolved.'.
    RETURN.
  ENDIF.

  CLEAR lv_system_dir.
  CALL METHOD cl_gui_frontend_services=>get_system_directory
    CHANGING
      system_directory = lv_system_dir
    EXCEPTIONS
      OTHERS           = 1.
  lv_call_subrc = sy-subrc.
  CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
  lv_flush_subrc = sy-subrc.
  IF lv_call_subrc <> 0
     OR lv_flush_subrc <> 0
     OR lv_system_dir IS INITIAL.
    cv_message =
      'GUI_COMMAND_CAPTURE_BOOTSTRAP_FAILED: Windows system directory cannot be resolved.'.
    RETURN.
  ENDIF.

  lv_wscript_host = lv_system_dir && '\wscript.exe'.
  lv_ps_host =
    lv_system_dir && '\WindowsPowerShell\v1.0\powershell.exe'.

  lv_token = |{ sy-datum }{ sy-uzeit }|.
  lv_prefix = gv_z875_fe_temp && '\zbdc_cmd_' && lv_token.
  gv_z865_cap_script = lv_prefix && '.vbs'.
  gv_z865_cap_log    = lv_prefix && '.tsv'.
  gv_z865_cap_stop   = lv_prefix && '.stop'.
  gv_z865_cap_ready  = lv_prefix && '.ready'.
  gv_z865_cap_done   = lv_prefix && '.done'.
  lv_ps_script       = gv_z865_cap_script && '.capture.ps1'.
  lv_req_log         = gv_z865_cap_script && '.capture.req'.
  lv_shot_log        = gv_z865_cap_script && '.capture.shots'.
  lv_shot_ready      = gv_z865_cap_script && '.capture.ready'.
  lv_launcher        = gv_z865_cap_ready && '.launch.vbs'.

  "V14 keeps raw CommandArray for audit and samples only the currently
  "focused input control every 150 ms. No AI runs while the user is typing.
  REFRESH gt_z875_fe_text.
  APPEND 'Option Explicit' TO gt_z875_fe_text.
  APPEND 'Dim fso, SapGuiAuto, app, sess, targetTcode, logFile, stopFile' TO gt_z875_fe_text.
  APPEND 'Dim readyFile, doneFile, requestFile, eventSeq, attached' TO gt_z875_fe_text.
  APPEND 'Dim logHandle, logOpen' TO gt_z875_fe_text.
  APPEND 'Dim boundaryMode, boundarySeq' TO gt_z875_fe_text.
  APPEND 'Dim regSh, regBase, oldWarnAttach, oldWarnConnection, hadWarnAttach, hadWarnConnection, warnMuted' TO gt_z875_fe_text.
  APPEND 'Dim lastMainName, lastMainType, lastMainId, lastMainText, lastMainKey, lastMainValue, lastMainSelected' TO gt_z875_fe_text.
  APPEND 'Dim helpPending, helpReturned, helpName, helpType, helpId' TO gt_z875_fe_text.
  APPEND 'Dim helpPreText, helpPreKey, helpPreValue, helpPreSelected' TO gt_z875_fe_text.
  APPEND 'Dim helpPostText, helpPostKey, helpPostValue, helpPostSelected' TO gt_z875_fe_text.
  APPEND 'Dim fdObj, fdName, fdType, fdId, fdProgram, fdDynpro' TO gt_z875_fe_text.
  APPEND 'Dim fdBeforeText, fdBeforeKey, fdBeforeValue, fdBeforeSelected, fdOn' TO gt_z875_fe_text.
  APPEND 'Dim rtArmed, rtSawModal, rtName, rtType, rtId, rtProgram, rtDynpro' TO gt_z875_fe_text.
  APPEND 'Dim rtBeforeText, rtBeforeKey, rtBeforeValue, rtBeforeSelected' TO gt_z875_fe_text.
  APPEND |targetTcode = "{ iv_tcode }"| TO gt_z875_fe_text.
  APPEND |boundaryMode = "{ gv_z940_import_capture }"| TO gt_z875_fe_text.
  APPEND 'boundarySeq = 0' TO gt_z875_fe_text.
  APPEND |logFile = "{ gv_z865_cap_log }"| TO gt_z875_fe_text.
  APPEND |stopFile = "{ gv_z865_cap_stop }"| TO gt_z875_fe_text.
  APPEND |readyFile = "{ gv_z865_cap_ready }"| TO gt_z875_fe_text.
  APPEND |doneFile = "{ gv_z865_cap_done }"| TO gt_z875_fe_text.
  APPEND |requestFile = "{ lv_req_log }"| TO gt_z875_fe_text.
  APPEND 'Set fso = CreateObject("Scripting.FileSystemObject")' TO gt_z875_fe_text.
  APPEND 'Set regSh = CreateObject("WScript.Shell")' TO gt_z875_fe_text.
  APPEND 'regBase = "HKCU\Software\SAP\SAPGUI Front\SAP Frontend Server\Security\"' TO gt_z875_fe_text.
  APPEND 'eventSeq = 0 : attached = False : warnMuted = False : logOpen = False : Set logHandle = Nothing' TO gt_z875_fe_text.
  APPEND 'lastMainName = "" : lastMainType = "" : lastMainId = ""' TO gt_z875_fe_text.
  APPEND 'lastMainText = "" : lastMainKey = "" : lastMainValue = "" : lastMainSelected = ""' TO gt_z875_fe_text.
  APPEND 'helpPending = False : helpReturned = False : helpName = "" : helpType = "" : helpId = ""' TO gt_z875_fe_text.
  APPEND 'helpPreText = "" : helpPreKey = "" : helpPreValue = "" : helpPreSelected = ""' TO gt_z875_fe_text.
  APPEND 'helpPostText = "" : helpPostKey = "" : helpPostValue = "" : helpPostSelected = ""' TO gt_z875_fe_text.
  APPEND 'Set fdObj = Nothing : fdName = "" : fdType = "" : fdId = ""' TO gt_z875_fe_text.
  APPEND 'fdProgram = "" : fdDynpro = "" : fdOn = False' TO gt_z875_fe_text.
  APPEND 'fdBeforeText = "" : fdBeforeKey = "" : fdBeforeValue = "" : fdBeforeSelected = ""' TO gt_z875_fe_text.
  APPEND 'rtArmed = False : rtSawModal = False : rtName = "" : rtType = "" : rtId = ""' TO gt_z875_fe_text.
  APPEND 'rtProgram = "" : rtDynpro = ""' TO gt_z875_fe_text.
  APPEND 'rtBeforeText = "" : rtBeforeKey = "" : rtBeforeValue = "" : rtBeforeSelected = ""' TO gt_z875_fe_text.
  APPEND 'On Error Resume Next' TO gt_z875_fe_text.
  APPEND 'If fso.FileExists(logFile) Then fso.DeleteFile logFile, True' TO gt_z875_fe_text.
  APPEND 'If fso.FileExists(stopFile) Then fso.DeleteFile stopFile, True' TO gt_z875_fe_text.
  APPEND 'If fso.FileExists(readyFile) Then fso.DeleteFile readyFile, True' TO gt_z875_fe_text.
  APPEND 'If fso.FileExists(doneFile) Then fso.DeleteFile doneFile, True' TO gt_z875_fe_text.
  APPEND 'If fso.FileExists(requestFile) Then fso.DeleteFile requestFile, True' TO gt_z875_fe_text.
  APPEND 'InitLog' TO gt_z875_fe_text.
  APPEND 'MuteSapGuiWarnings' TO gt_z875_fe_text.
  APPEND 'Err.Clear : Set SapGuiAuto = GetObject("SAPGUI")' TO gt_z875_fe_text.
  APPEND 'If Err.Number <> 0 Then Fail "GETOBJECT_SAPGUI", Err.Number' TO gt_z875_fe_text.
  APPEND 'Err.Clear : Set app = SapGuiAuto.GetScriptingEngine' TO gt_z875_fe_text.
  APPEND 'If Err.Number <> 0 Then Fail "GET_SCRIPTING_ENGINE", Err.Number' TO gt_z875_fe_text.
  APPEND 'WriteMarker readyFile, "READY"' TO gt_z875_fe_text.
  APPEND 'Do' TO gt_z875_fe_text.
  APPEND '  If fso.FileExists(stopFile) Then Exit Do' TO gt_z875_fe_text.
  APPEND '  If Not attached Then TryAttachSession' TO gt_z875_fe_text.
  APPEND '  If attached Then PollFocusedInput "POLL"' TO gt_z875_fe_text.
  APPEND '  If UCase(CStr(boundaryMode)) = "X" Then WScript.Sleep 20 Else WScript.Sleep 250' TO gt_z875_fe_text.
  APPEND 'Loop' TO gt_z875_fe_text.
  APPEND 'If attached Then' TO gt_z875_fe_text.
  APPEND '  PollFocusedInput "STOP"' TO gt_z875_fe_text.
  APPEND '  CaptureModifiedAll "STOP"' TO gt_z875_fe_text.
  APPEND '  TryModalReturn "STOP"' TO gt_z875_fe_text.
  APPEND '  Err.Clear : sess.Record = False : Err.Clear' TO gt_z875_fe_text.
  APPEND '  WScript.Sleep 150' TO gt_z875_fe_text.
  APPEND '  On Error Resume Next : WScript.DisconnectObject sess' TO gt_z875_fe_text.
  APPEND 'End If' TO gt_z875_fe_text.
  APPEND 'RestoreSapGuiWarnings' TO gt_z875_fe_text.
  APPEND 'CloseLog' TO gt_z875_fe_text.
  APPEND 'WriteMarker doneFile, "DONE"' TO gt_z875_fe_text.
  APPEND 'WScript.Quit 0' TO gt_z875_fe_text.
  APPEND '' TO gt_z875_fe_text.

  APPEND 'Sub InitLog()' TO gt_z875_fe_text.
  APPEND '  Dim head : Set logHandle = fso.CreateTextFile(logFile, True, True)' TO gt_z875_fe_text.
  APPEND '  If Err.Number <> 0 Then WScript.Quit 91' TO gt_z875_fe_text.
  APPEND '  logOpen = True' TO gt_z875_fe_text.
  APPEND '  head = "EVENT_SEQ" & vbTab & "EVENT_MS" & vbTab & "CMD_SEQ" & vbTab & "TCODE" & vbTab & "PROGRAM" & vbTab & "DYNPRO"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "COMP_NAME" & vbTab & "COMP_TYPE" & vbTab & "COMP_ID" & vbTab & "CMD_TYPE"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "CMD_NAME" & vbTab & "PARAMS" & vbTab & "MUTATION" & vbTab & "TARGET_HINT"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "INPUT_VALUE" & vbTab & "COMP_TEXT" & vbTab & "COMP_KEY"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "COMP_VALUE" & vbTab & "COMP_SELECTED"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "ACTIVE_NAME" & vbTab & "ACTIVE_TYPE" & vbTab & "ACTIVE_ID"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "ACTIVE_TEXT" & vbTab & "ACTIVE_KEY" & vbTab & "ACTIVE_VALUE"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "ACTIVE_SELECTED" & vbTab & "HELP_RT"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "HELP_NAME" & vbTab & "HELP_TYPE" & vbTab & "HELP_ID"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "HELP_PRE_TEXT" & vbTab & "HELP_PRE_KEY" & vbTab & "HELP_PRE_VALUE"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "HELP_PRE_SELECTED" & vbTab & "HELP_POST_TEXT" & vbTab & "HELP_POST_KEY"' TO gt_z875_fe_text.
  APPEND '  head = head & vbTab & "HELP_POST_VALUE" & vbTab & "HELP_POST_SELECTED" & vbTab & "IMAGE"' TO gt_z875_fe_text.
  APPEND '  logHandle.WriteLine head' TO gt_z875_fe_text.
  APPEND 'End Sub' TO gt_z875_fe_text.
  APPEND '' TO gt_z875_fe_text.
  APPEND 'Sub CloseLog()' TO gt_z875_fe_text.
  APPEND '  On Error Resume Next' TO gt_z875_fe_text.
  APPEND '  If logOpen Then logHandle.Close : logOpen = False' TO gt_z875_fe_text.
  APPEND '  Set logHandle = Nothing : Err.Clear' TO gt_z875_fe_text.
  APPEND 'End Sub' TO gt_z875_fe_text.
  APPEND '' TO gt_z875_fe_text.

  APPEND 'Sub WriteMarker(ByVal p, ByVal t)' TO gt_z875_fe_text.
  APPEND '  On Error Resume Next' TO gt_z875_fe_text.
  APPEND '  Dim h : Set h = fso.CreateTextFile(p, True, False)' TO gt_z875_fe_text.
  APPEND '  If Err.Number = 0 Then h.WriteLine t : h.Close' TO gt_z875_fe_text.
  APPEND '  Err.Clear' TO gt_z875_fe_text.
  APPEND 'End Sub' TO gt_z875_fe_text.
  APPEND '' TO gt_z875_fe_text.

  APPEND 'Sub Fail(ByVal reason, ByVal eno)' TO gt_z875_fe_text.
  APPEND '  On Error Resume Next' TO gt_z875_fe_text.
  APPEND '  AppendLog "#ERROR" & vbTab & CleanCell(reason) & vbTab & CStr(eno)' TO gt_z875_fe_text.
  APPEND '  CloseLog' TO gt_z875_fe_text.
  APPEND '  RestoreSapGuiWarnings' TO gt_z875_fe_text.
  APPEND '  WriteMarker doneFile, "DONE ERROR"' TO gt_z875_fe_text.
  APPEND '  WScript.Quit 92' TO gt_z875_fe_text.
  APPEND 'End Sub' TO gt_z875_fe_text.
  APPEND '' TO gt_z875_fe_text.
  APPEND 'Sub MuteSapGuiWarnings()' TO gt_z875_fe_text.
  APPEND '  On Error Resume Next' TO gt_z875_fe_text.
  APPEND '  hadWarnAttach = False : hadWarnConnection = False' TO gt_z875_fe_text.
  APPEND '  Err.Clear : oldWarnAttach = regSh.RegRead(regBase & "WarnOnAttach")' TO gt_z875_fe_text.
  APPEND '  If Err.Number = 0 Then hadWarnAttach = True Else Err.Clear' TO gt_z875_fe_text.
  APPEND '  Err.Clear : oldWarnConnection = regSh.RegRead(regBase & "WarnOnConnection")' TO gt_z875_fe_text.
  APPEND '  If Err.Number = 0 Then hadWarnConnection = True Else Err.Clear' TO gt_z875_fe_text.
  APPEND '  Err.Clear : regSh.RegWrite regBase & "WarnOnAttach", 0, "REG_DWORD"' TO gt_z875_fe_text.
  APPEND '  If Err.Number <> 0 Then Err.Clear : Exit Sub' TO gt_z875_fe_text.
  APPEND '  Err.Clear : regSh.RegWrite regBase & "WarnOnConnection", 0, "REG_DWORD"' TO gt_z875_fe_text.
  APPEND '  If Err.Number <> 0 Then Err.Clear : RestoreSapGuiWarnings : Exit Sub' TO gt_z875_fe_text.
  APPEND '  warnMuted = True' TO gt_z875_fe_text.
  APPEND 'End Sub' TO gt_z875_fe_text.
  APPEND '' TO gt_z875_fe_text.
  APPEND 'Sub RestoreSapGuiWarnings()' TO gt_z875_fe_text.
  APPEND '  On Error Resume Next' TO gt_z875_fe_text.
  APPEND '  If Not warnMuted Then Exit Sub' TO gt_z875_fe_text.
  APPEND '  If hadWarnAttach Then' TO gt_z875_fe_text.
