  APPEND '        AppendLog line' TO gt_z875_fe_text.
  APPEND '      Else' TO gt_z875_fe_text.
  APPEND '        Err.Clear' TO gt_z875_fe_text.
  APPEND '      End If' TO gt_z875_fe_text.
  APPEND '    End If' TO gt_z875_fe_text.
  APPEND '  Next' TO gt_z875_fe_text.
  APPEND '  If hRt = "Y" Then ResetModalRoundTrip' TO gt_z875_fe_text.
  APPEND 'End Sub' TO gt_z875_fe_text.


  cl_gui_frontend_services=>gui_download(
    EXPORTING
      filename = gv_z865_cap_script
      filetype = 'ASC'
    CHANGING
      data_tab = gt_z875_fe_text
    EXCEPTIONS
      OTHERS   = 1 ).
  lv_call_subrc = sy-subrc.
  CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
  lv_flush_subrc = sy-subrc.
  IF lv_call_subrc <> 0 OR lv_flush_subrc <> 0.
    cv_message =
      'GUI_COMMAND_CAPTURE_SCRIPT_WRITE_FAILED: event recorder could not be written.'.
    RETURN.
  ENDIF.

  "Low-overhead continuous visual recorder.
  "It runs independently at 1 FPS and never blocks Session.Change callbacks.
  "Frames are JPEG-compressed/downscaled to limit CPU, disk I/O and SAP GUI lag.
  REFRESH gt_z875_fe_text.
  APPEND
    'param([string]$Shots,[string]$Stop,[string]$Ready,[string]$Prefix,[int]$IntervalMs=1000,[int]$ScalePct=50,[long]$JpegQuality=40)'
    TO gt_z875_fe_text.
  APPEND '$ErrorActionPreference = "SilentlyContinue"' TO gt_z875_fe_text.
  APPEND 'Add-Type -AssemblyName System.Drawing' TO gt_z875_fe_text.
  APPEND
    '$m=''[System.Runtime.InteropServices.StructLayout(System.Runtime.InteropServices.LayoutKind.Sequential)] public struct RECT { public int Left; public int Top; public int Right; public int Bottom; }'''
    TO gt_z875_fe_text.
  APPEND
    '$m+=''[System.Runtime.InteropServices.DllImport("user32.dll")] public static extern System.IntPtr GetForegroundWindow();'''
    TO gt_z875_fe_text.
  APPEND
    '$m+=''[System.Runtime.InteropServices.DllImport("user32.dll")] public static extern bool GetWindowRect(System.IntPtr hWnd, out RECT lpRect);'''
    TO gt_z875_fe_text.
  APPEND
    '$m+=''[System.Runtime.InteropServices.DllImport("user32.dll", CharSet=System.Runtime.InteropServices.CharSet.Auto)] public static extern int GetClassName(System.IntPtr hWnd, System.Text.StringBuilder lpClassName, int nMaxCount);'''
    TO gt_z875_fe_text.
  APPEND 'Add-Type -Namespace ZBdcShot -Name Native -MemberDefinition $m' TO gt_z875_fe_text.
  APPEND '$head="FRAME_MS`tIMAGE"' TO gt_z875_fe_text.
  APPEND '$head | Set-Content -LiteralPath $Shots -Encoding Unicode' TO gt_z875_fe_text.
  APPEND '"READY" | Set-Content -LiteralPath $Ready -Encoding ASCII' TO gt_z875_fe_text.
  APPEND '$procSelf=[System.Diagnostics.Process]::GetCurrentProcess(); $procSelf.PriorityClass="BelowNormal"' TO gt_z875_fe_text.
  APPEND '$codec=[System.Drawing.Imaging.ImageCodecInfo]::GetImageEncoders() | Where-Object { $_.MimeType -eq "image/jpeg" } | Select-Object -First 1' TO gt_z875_fe_text.
  APPEND '$ep=New-Object System.Drawing.Imaging.EncoderParameters -ArgumentList 1' TO gt_z875_fe_text.
  APPEND '$ep.Param[0]=New-Object System.Drawing.Imaging.EncoderParameter -ArgumentList ([System.Drawing.Imaging.Encoder]::Quality),([long]$JpegQuality)' TO gt_z875_fe_text.
  APPEND 'function Window-Class([IntPtr]$h) {' TO gt_z875_fe_text.
  APPEND '  $sb=New-Object System.Text.StringBuilder 256' TO gt_z875_fe_text.
  APPEND '  [void][ZBdcShot.Native]::GetClassName($h,$sb,$sb.Capacity)' TO gt_z875_fe_text.
  APPEND '  return $sb.ToString()' TO gt_z875_fe_text.
  APPEND '}' TO gt_z875_fe_text.
  APPEND 'function Capture-Frame() {' TO gt_z875_fe_text.
  APPEND '  $h=[ZBdcShot.Native]::GetForegroundWindow()' TO gt_z875_fe_text.
  APPEND '  if($h -eq [IntPtr]::Zero) { return }' TO gt_z875_fe_text.
  APPEND '  if((Window-Class $h) -ne "SAP_FRONTEND_SESSION") { return }' TO gt_z875_fe_text.
  APPEND '  $r=New-Object "ZBdcShot.Native+RECT"' TO gt_z875_fe_text.
  APPEND '  if(-not [ZBdcShot.Native]::GetWindowRect($h,[ref]$r)) { return }' TO gt_z875_fe_text.
  APPEND '  $w=$r.Right-$r.Left; $hh=$r.Bottom-$r.Top' TO gt_z875_fe_text.
  APPEND '  if($w -le 400 -or $hh -le 250) { return }' TO gt_z875_fe_text.
  APPEND '  $tw=[Math]::Max(320,[int]($w*$ScalePct/100)); $th=[Math]::Max(200,[int]($hh*$ScalePct/100))' TO gt_z875_fe_text.
  APPEND '  $src=New-Object System.Drawing.Bitmap -ArgumentList $w,$hh' TO gt_z875_fe_text.
  APPEND '  $g=[System.Drawing.Graphics]::FromImage($src)' TO gt_z875_fe_text.
  APPEND '  try {' TO gt_z875_fe_text.
  APPEND '    $g.CopyFromScreen($r.Left,$r.Top,0,0,$src.Size)' TO gt_z875_fe_text.
  APPEND '    $dst=New-Object System.Drawing.Bitmap -ArgumentList $tw,$th' TO gt_z875_fe_text.
  APPEND '    $gd=[System.Drawing.Graphics]::FromImage($dst)' TO gt_z875_fe_text.
  APPEND '    try {' TO gt_z875_fe_text.
  APPEND '      $gd.CompositingQuality=[System.Drawing.Drawing2D.CompositingQuality]::HighSpeed' TO gt_z875_fe_text.
  APPEND '      $gd.SmoothingMode=[System.Drawing.Drawing2D.SmoothingMode]::None' TO gt_z875_fe_text.
  APPEND '      $gd.InterpolationMode=[System.Drawing.Drawing2D.InterpolationMode]::Low' TO gt_z875_fe_text.
  APPEND '      $gd.PixelOffsetMode=[System.Drawing.Drawing2D.PixelOffsetMode]::HighSpeed' TO gt_z875_fe_text.
  APPEND '      $gd.DrawImage($src,0,0,$tw,$th)' TO gt_z875_fe_text.
  APPEND '      $ms=[int][DateTime]::Now.TimeOfDay.TotalMilliseconds' TO gt_z875_fe_text.
  APPEND '      $img=("{0}_F{1}.jpg" -f $Prefix,$ms.ToString("D8"))' TO gt_z875_fe_text.
  APPEND '      $dst.Save($img,$codec,$ep)' TO gt_z875_fe_text.
  APPEND '      ($ms.ToString()+"`t"+$img) | Add-Content -LiteralPath $Shots -Encoding Unicode' TO gt_z875_fe_text.
  APPEND '    } finally { $gd.Dispose(); $dst.Dispose() }' TO gt_z875_fe_text.
  APPEND '  } finally { $g.Dispose(); $src.Dispose() }' TO gt_z875_fe_text.
  APPEND '}' TO gt_z875_fe_text.
  APPEND 'while(-not (Test-Path -LiteralPath $Stop)) {' TO gt_z875_fe_text.
  APPEND '  $t0=[Environment]::TickCount64' TO gt_z875_fe_text.
  APPEND '  Capture-Frame' TO gt_z875_fe_text.
  APPEND '  $elapsed=[int]([Environment]::TickCount64-$t0)' TO gt_z875_fe_text.
  APPEND '  $sleep=[Math]::Max(50,$IntervalMs-$elapsed)' TO gt_z875_fe_text.
  APPEND '  Start-Sleep -Milliseconds $sleep' TO gt_z875_fe_text.
  APPEND '}' TO gt_z875_fe_text.
  APPEND 'Capture-Frame' TO gt_z875_fe_text.

  cl_gui_frontend_services=>gui_download(
    EXPORTING
      filename = lv_ps_script
      filetype = 'ASC'
    CHANGING
      data_tab = gt_z875_fe_text
    EXCEPTIONS
      OTHERS   = 1 ).
  lv_call_subrc = sy-subrc.
  CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
  lv_flush_subrc = sy-subrc.
  IF lv_call_subrc <> 0 OR lv_flush_subrc <> 0.
    cv_message =
      'GUI_COMMAND_OS_CAPTURE_SCRIPT_WRITE_FAILED: OS screenshot helper could not be written.'.
    RETURN.
  ENDIF.

  lv_ps_cmd =
    |"{ lv_ps_host }" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass | &&
    |-WindowStyle Hidden -File "{ lv_ps_script }" | &&
    |-Shots "{ lv_shot_log }" -Stop "{ gv_z865_cap_stop }" | &&
    |-Ready "{ lv_shot_ready }" -Prefix "{ lv_prefix }" | &&
    |-IntervalMs 1000 -ScalePct 50 -JpegQuality 40|.

  REFRESH gt_z875_fe_text.
  APPEND 'Option Explicit' TO gt_z875_fe_text.
  APPEND 'Dim sh, ps, ev, svc, startup, proc, pid, rc' TO gt_z875_fe_text.
  APPEND 'Set sh = CreateObject("WScript.Shell")' TO gt_z875_fe_text.
  lv_vbs_cmd = lv_ps_cmd.
  REPLACE ALL OCCURRENCES OF '"' IN lv_vbs_cmd WITH '""'.
  APPEND |ps = "{ lv_vbs_cmd }"| TO gt_z875_fe_text.
  lv_vbs_cmd = |//B //Nologo "{ gv_z865_cap_script }"|.
  REPLACE ALL OCCURRENCES OF '"' IN lv_vbs_cmd WITH '""'.
  APPEND |ev = "{ lv_vbs_cmd }"| TO gt_z875_fe_text.
  APPEND 'On Error Resume Next' TO gt_z875_fe_text.
  APPEND 'Set svc = GetObject("winmgmts:\\.\root\cimv2")' TO gt_z875_fe_text.
  APPEND 'Set startup = svc.Get("Win32_ProcessStartup").SpawnInstance_' TO gt_z875_fe_text.
  APPEND 'startup.ShowWindow = 0 : startup.CreateFlags = 134217728' TO gt_z875_fe_text.
  APPEND 'Set proc = svc.Get("Win32_Process")' TO gt_z875_fe_text.
  APPEND 'Err.Clear : rc = proc.Create(ps, Null, startup, pid)' TO gt_z875_fe_text.
  APPEND 'If Err.Number <> 0 Or rc <> 0 Then Err.Clear : sh.Run ps, 0, False' TO gt_z875_fe_text.
  APPEND 'sh.Run Chr(34) & WScript.FullName & Chr(34) & " " & ev, 0, False' TO gt_z875_fe_text.

  cl_gui_frontend_services=>gui_download(
    EXPORTING
      filename = lv_launcher
      filetype = 'ASC'
    CHANGING
      data_tab = gt_z875_fe_text
    EXCEPTIONS
      OTHERS   = 1 ).
  lv_call_subrc = sy-subrc.
  CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
  lv_flush_subrc = sy-subrc.
  IF lv_call_subrc <> 0 OR lv_flush_subrc <> 0.
    cv_message =
      'GUI_COMMAND_CAPTURE_LAUNCHER_WRITE_FAILED: hidden launcher could not be written.'.
    RETURN.
  ENDIF.

  cl_gui_frontend_services=>execute(
    EXPORTING
      application = lv_wscript_host
      parameter   = |//B //Nologo "{ lv_launcher }"|
      synchronous = space
    EXCEPTIONS
      cntl_error             = 1
      error_no_gui           = 2
      bad_parameter          = 3
      file_not_found         = 4
      path_not_found         = 5
      file_extension_unknown = 6
      error_execute_failed   = 7
      synchronous_failed     = 8
      not_supported_by_gui   = 9
      OTHERS                 = 10 ).
  lv_call_subrc = sy-subrc.
  CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
  lv_flush_subrc = sy-subrc.
  IF lv_call_subrc <> 0 OR lv_flush_subrc <> 0.
    cv_message =
      |GUI_COMMAND_CAPTURE_LAUNCH_FAILED: execute rc={ lv_call_subrc }, flush rc={ lv_flush_subrc }.|.
    RETURN.
  ENDIF.

  gv_z865_cap_on = abap_true.
  cv_started = abap_true.
  cv_message =
    'Low-lag event capture + persistent audit log + 1 FPS SAP frame stream launched. No OpenAI request runs during recording.'.
ENDFORM.

FORM stop_gui_label_capture
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  TYPES: BEGIN OF ty_z930_shot,
           frame_ms TYPE i,
           path     TYPE string,
         END OF ty_z930_shot.
  TYPES ty_t_z930_shot TYPE SORTED TABLE OF ty_z930_shot
                       WITH UNIQUE KEY frame_ms.

  DATA: lt_os_shots      TYPE ty_t_z930_shot,
        lt_shot_lines    TYPE string_table,
        ls_shot          TYPE ty_z930_shot,
        lv_shot_ms_s     TYPE string,
        lv_shot_path     TYPE string,
        lv_shot_log      TYPE string,
        lv_line          TYPE string,
        lv_event_s       TYPE string,
        lv_event_ms_s    TYPE string,
        lv_cmd_s         TYPE string,
        lv_tcode         TYPE string,
        lv_prog          TYPE string,
        lv_dyn           TYPE string,
        lv_comp_name     TYPE string,
        lv_comp_type     TYPE string,
        lv_comp_id       TYPE string,
        lv_cmd_type      TYPE string,
        lv_cmd_name      TYPE string,
        lv_params        TYPE string,
        lv_mutation      TYPE string,
        lv_target        TYPE string,
        lv_input         TYPE string,
        lv_comp_text      TYPE string,
        lv_comp_key       TYPE string,
        lv_comp_value     TYPE string,
        lv_comp_selected  TYPE string,
        lv_active_name    TYPE string,
        lv_active_type    TYPE string,
        lv_active_id      TYPE string,
        lv_active_text     TYPE string,
        lv_active_key      TYPE string,
        lv_active_value    TYPE string,
        lv_active_selected TYPE string,
        lv_help_rt         TYPE string,
        lv_help_name       TYPE string,
        lv_help_type       TYPE string,
        lv_help_id         TYPE string,
        lv_help_pre_text   TYPE string,
        lv_help_pre_key    TYPE string,
        lv_help_pre_value  TYPE string,
        lv_help_pre_selected TYPE string,
        lv_help_post_text  TYPE string,
        lv_help_post_key   TYPE string,
        lv_help_post_value TYPE string,
        lv_help_post_selected TYPE string,
        lv_path            TYPE string,
        lv_tag           TYPE string,
        lv_err_code      TYPE string,
        lv_err_reason    TYPE string,
        lv_err_detail    TYPE string,
        ls_cap           TYPE ty_z866_screen_cap,
        lv_count         TYPE i,
        lv_mut_count     TYPE i,
        lv_attached_count TYPE i,
        lv_record_on_count TYPE i,
        lv_shot_count    TYPE i,
        lv_shot_error_count TYPE i,
        lv_raw_line_count TYPE i,
        lv_best_diff     TYPE i,
        lv_diff          TYPE i,
        lv_day_diff      TYPE i,
        lv_best_path     TYPE string,
        lv_call_subrc    TYPE sy-subrc,
        lv_flush_subrc   TYPE sy-subrc.

  CLEAR: cv_ok, cv_message.
  lv_shot_log = gv_z865_cap_script && '.capture.shots'.
  IF gv_z865_cap_on <> abap_true.
    cv_message =
      'GUI_COMMAND_CAPTURE_NOT_RUNNING: recorder was not launched.'.
    gv_z877_cap_diag = cv_message.
    RETURN.
  ENDIF.

  REFRESH gt_z875_fe_text.
  APPEND 'STOP' TO gt_z875_fe_text.
  cl_gui_frontend_services=>gui_download(
    EXPORTING
      filename = gv_z865_cap_stop
      filetype = 'ASC'
    CHANGING
      data_tab = gt_z875_fe_text
    EXCEPTIONS
      OTHERS   = 1 ).
  lv_call_subrc = sy-subrc.
  CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
  lv_flush_subrc = sy-subrc.
  CLEAR gv_z865_cap_on.
  IF lv_call_subrc <> 0 OR lv_flush_subrc <> 0.
    cv_message =
      'GUI_COMMAND_CAPTURE_STOP_FAILED: stop marker could not be written.'.
    gv_z877_cap_diag = cv_message.
    RETURN.
  ENDIF.

  "Record=False flushes queued Change events; WScript then closes the append log.
  WAIT UP TO 1 SECONDS.

  REFRESH gt_z875_fe_text.
  cl_gui_frontend_services=>gui_upload(
    EXPORTING
      filename = gv_z865_cap_log
      filetype = 'ASC'
    CHANGING
      data_tab = gt_z875_fe_text
    EXCEPTIONS
      OTHERS   = 1 ).
  lv_call_subrc = sy-subrc.
  CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
  lv_flush_subrc = sy-subrc.
  IF lv_call_subrc <> 0
     OR lv_flush_subrc <> 0
     OR gt_z875_fe_text IS INITIAL.
    cv_message =
      'GUI_COMMAND_CAPTURE_LOG_MISSING: native CommandArray manifest is unavailable.'.
    gv_z877_cap_diag = cv_message.
    RETURN.
  ENDIF.

  CLEAR: lv_err_code, lv_err_reason, lv_err_detail.
  LOOP AT gt_z875_fe_text INTO lv_line.
    lv_raw_line_count = lv_raw_line_count + 1.
    IF lv_line CP '#ATTACHED*'.
      lv_attached_count = lv_attached_count + 1.
    ELSEIF lv_line CP '#RECORD_ON*'.
      lv_record_on_count = lv_record_on_count + 1.
    ENDIF.
    IF lv_line CP '#ERROR*'.
      SPLIT lv_line AT cl_abap_char_utilities=>horizontal_tab
        INTO lv_err_code lv_err_reason lv_err_detail.
      EXIT.
    ENDIF.
  ENDLOOP.
  IF lv_err_reason IS NOT INITIAL.
    cv_message =
      |GUI_COMMAND_CAPTURE_FAILED: { lv_err_reason } ({ lv_err_detail }).|.
    gv_z877_cap_diag = cv_message.
    RETURN.
  ENDIF.

  REFRESH: gt_z866_screen_caps, gt_z865_gui_labels.

  "Upload the continuous FRAME_MS -> JPEG manifest produced independently
  "of SAP GUI Scripting callbacks.
  REFRESH lt_shot_lines.
  cl_gui_frontend_services=>gui_upload(
    EXPORTING
      filename = lv_shot_log
      filetype = 'ASC'
    CHANGING
      data_tab = lt_shot_lines
    EXCEPTIONS
      OTHERS   = 1 ).
  lv_call_subrc = sy-subrc.
  CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
  lv_flush_subrc = sy-subrc.
  IF lv_call_subrc <> 0 OR lv_flush_subrc <> 0.
    cv_message =
      'GUI_COMMAND_FRAME_STREAM_LOG_MISSING: continuous frame manifest is unavailable. No API request was sent.'.
    gv_z877_cap_diag = cv_message.
    RETURN.
  ENDIF.

  LOOP AT lt_shot_lines INTO lv_line.
    IF lv_line IS INITIAL OR lv_line CP 'FRAME_MS*'.
      CONTINUE.
    ENDIF.
    CLEAR: lv_shot_ms_s, lv_shot_path, ls_shot.
    SPLIT lv_line AT cl_abap_char_utilities=>horizontal_tab
      INTO lv_shot_ms_s lv_shot_path.
    TRY.
        ls_shot-frame_ms = CONV i( lv_shot_ms_s ).
      CATCH cx_root.
        CONTINUE.
    ENDTRY.
    IF lv_shot_path IS INITIAL.
      CONTINUE.
    ENDIF.
    ls_shot-path = lv_shot_path.
    INSERT ls_shot INTO TABLE lt_os_shots.
    lv_shot_count = lv_shot_count + 1.
  ENDLOOP.

  LOOP AT gt_z875_fe_text INTO lv_line.
    IF lv_line CP '#SCREEN_BOUNDARY*'.
      CLEAR: lv_tag, lv_event_s, lv_event_ms_s, lv_tcode, lv_prog, lv_dyn,
             lv_path, ls_cap.
      SPLIT lv_line AT cl_abap_char_utilities=>horizontal_tab
        INTO lv_tag lv_event_s lv_event_ms_s lv_tcode lv_prog lv_dyn lv_path.
      TRY.
          ls_cap-seq      = CONV i( lv_event_s ).
          ls_cap-event_ms = CONV i( lv_event_ms_s ).
        CATCH cx_root.
          CONTINUE.
      ENDTRY.
      ls_cap-program    = lv_prog.
      ls_cap-dynpro     = lv_dyn.
      ls_cap-trigger    = 'SCREEN_BOUNDARY'.
      ls_cap-image_path = lv_path.
      APPEND ls_cap TO gt_z866_screen_caps.
      CONTINUE.
    ENDIF.

    IF lv_line IS INITIAL
       OR lv_line CP '#*'
       OR lv_line CP 'EVENT_SEQ*'.
      CONTINUE.
    ENDIF.

    CLEAR: lv_event_s, lv_event_ms_s, lv_cmd_s, lv_tcode, lv_prog, lv_dyn,
           lv_comp_name, lv_comp_type, lv_comp_id,
           lv_cmd_type, lv_cmd_name, lv_params,
           lv_mutation, lv_target, lv_input,
           lv_comp_text, lv_comp_key, lv_comp_value, lv_comp_selected,
           lv_active_name, lv_active_type, lv_active_id,
           lv_active_text, lv_active_key, lv_active_value, lv_active_selected,
           lv_help_rt, lv_help_name, lv_help_type, lv_help_id,
           lv_help_pre_text, lv_help_pre_key, lv_help_pre_value, lv_help_pre_selected,
           lv_help_post_text, lv_help_post_key, lv_help_post_value, lv_help_post_selected,
           lv_path, ls_cap.
    SPLIT lv_line AT cl_abap_char_utilities=>horizontal_tab
      INTO lv_event_s lv_event_ms_s lv_cmd_s lv_tcode lv_prog lv_dyn
           lv_comp_name lv_comp_type lv_comp_id
           lv_cmd_type lv_cmd_name lv_params lv_mutation
           lv_target lv_input
           lv_comp_text lv_comp_key lv_comp_value lv_comp_selected
           lv_active_name lv_active_type lv_active_id
           lv_active_text lv_active_key lv_active_value lv_active_selected
           lv_help_rt lv_help_name lv_help_type lv_help_id
           lv_help_pre_text lv_help_pre_key lv_help_pre_value lv_help_pre_selected
           lv_help_post_text lv_help_post_key lv_help_post_value lv_help_post_selected
           lv_path.

    TRY.
        ls_cap-seq = CONV i( lv_event_s ).
        ls_cap-event_ms = CONV i( lv_event_ms_s ).
        ls_cap-command_index = CONV i( lv_cmd_s ).
      CATCH cx_root.
        CONTINUE.
    ENDTRY.

    "Join the technical timeline to the nearest continuously recorded SAP frame.
    "Both clocks are local milliseconds since midnight; handle midnight wrap.
    CLEAR: lv_best_path.
    lv_best_diff = 2000000000.
    LOOP AT lt_os_shots INTO ls_shot.
      lv_diff = abs( ls_shot-frame_ms - ls_cap-event_ms ).
      lv_day_diff = 86400000 - lv_diff.
      IF lv_day_diff < lv_diff.
        lv_diff = lv_day_diff.
      ENDIF.
      IF lv_diff < lv_best_diff.
        lv_best_diff = lv_diff.
        lv_best_path = ls_shot-path.
      ENDIF.
    ENDLOOP.
    IF lv_best_diff <= 1250.
      lv_path = lv_best_path.
    ENDIF.

    ls_cap-program        = lv_prog.
    ls_cap-dynpro         = lv_dyn.
    ls_cap-trigger        = 'TIMELINE'.
    ls_cap-focus_name     = lv_comp_name.
    ls_cap-focus_type     = lv_comp_type.
    ls_cap-focus_id       = lv_comp_id.
    ls_cap-command_type   = lv_cmd_type.
    ls_cap-command_name   = lv_cmd_name.
    ls_cap-command_params = lv_params.
    ls_cap-target_hint    = lv_target.
    ls_cap-input_value    = lv_input.
    ls_cap-comp_text       = lv_comp_text.
    ls_cap-comp_key        = lv_comp_key.
    ls_cap-comp_value      = lv_comp_value.
    ls_cap-comp_selected   = lv_comp_selected.
    ls_cap-active_name     = lv_active_name.
    ls_cap-active_type     = lv_active_type.
    ls_cap-active_id       = lv_active_id.
    ls_cap-active_text      = lv_active_text.
    ls_cap-active_key       = lv_active_key.
    ls_cap-active_value     = lv_active_value.
    ls_cap-active_selected  = lv_active_selected.
    IF lv_help_rt = 'Y'.
      ls_cap-help_roundtrip = abap_true.
    ENDIF.
    ls_cap-help_name          = lv_help_name.
    ls_cap-help_type          = lv_help_type.
    ls_cap-help_id            = lv_help_id.
    ls_cap-help_pre_text      = lv_help_pre_text.
    ls_cap-help_pre_key       = lv_help_pre_key.
    ls_cap-help_pre_value     = lv_help_pre_value.
    ls_cap-help_pre_selected  = lv_help_pre_selected.
    ls_cap-help_post_text     = lv_help_post_text.
    ls_cap-help_post_key      = lv_help_post_key.
    ls_cap-help_post_value    = lv_help_post_value.
    ls_cap-help_post_selected = lv_help_post_selected.
    ls_cap-image_path         = lv_path.
    IF lv_mutation = 'Y'.
      ls_cap-mutation = abap_true.
      lv_mut_count = lv_mut_count + 1.
    ENDIF.

    "V12 keeps every raw Change row even when one OS screenshot missed its
    "event. Technical action capture and pixel evidence are separate channels.
    "Mapping will still fail closed later if a proven action lacks its image.
    APPEND ls_cap TO gt_z866_screen_caps.
  ENDLOOP.

  SORT gt_z866_screen_caps BY seq command_index.
  DESCRIBE TABLE gt_z866_screen_caps LINES lv_count.
  IF lv_count = 0.
    cv_message =
      |GUI_COMMAND_CAPTURE_EMPTY: command_rows=0, attached={ lv_attached_count }, record_on={ lv_record_on_count }, | &&
      |os_shots={ lv_shot_count }, shot_errors={ lv_shot_error_count }, raw_log_lines={ lv_raw_line_count }. No API request was sent.|.
    gv_z877_cap_diag = cv_message.
    RETURN.
  ENDIF.

  "Do not require the legacy mutation whitelist. Every raw Session.Change row
  "will be reconciled deterministically against immutable SHDB afterwards.
  cv_ok = abap_true.
  cv_message =
    |GUI_COMMAND_CAPTURE_READY: { lv_count } technical timeline row(s), { lv_mut_count } legacy-classified mutation row(s), { lv_shot_count } continuous JPEG frame(s); nearest-frame join is timestamp based.|.
  gv_z877_cap_diag = cv_message.
ENDFORM.
FORM cleanup_screen_capture_files.
  DATA: lv_prefix      TYPE string,
        lv_system_dir  TYPE string,
        lv_cmd_host    TYPE string,
        lv_parameter   TYPE string,
        lv_len         TYPE i,
        lv_off         TYPE i,
        lv_call_subrc  TYPE sy-subrc,
        lv_flush_subrc TYPE sy-subrc.

 "All artifacts created by START_GUI_LABEL_CAPTURE share one internally
 "generated prefix:
 "  zbdc_cmd_<timestamp>.vbs / .tsv / .stop / .ready / .done
 "  zbdc_cmd_<timestamp>.vbs.capture.*
 "  zbdc_cmd_<timestamp>_B*.jpg / _F*.jpg
 "
 "Do not delete each artifact with a separate frontend API call. SAP GUI
 "Security can ask for each delete and steal focus repeatedly.
 "
 "Cleanup remains delayed until the next Start Recording so Mapping has
 "already consumed the retained screenshot evidence.

  IF gv_z865_cap_script IS NOT INITIAL.
    lv_prefix = gv_z865_cap_script.

   "GV_Z865_CAP_SCRIPT is generated as <prefix>.vbs.
    lv_len = strlen( lv_prefix ).
    IF lv_len > 4.
      lv_off = lv_len - 4.
      IF lv_prefix+lv_off(4) = '.vbs'.
        lv_prefix = lv_prefix(lv_off).
      ENDIF.
    ENDIF.

    IF lv_prefix IS NOT INITIAL.
      CLEAR lv_system_dir.
      cl_gui_frontend_services=>get_system_directory(
        CHANGING
          system_directory = lv_system_dir
        EXCEPTIONS
          OTHERS           = 1 ).
      lv_call_subrc = sy-subrc.
      CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
      lv_flush_subrc = sy-subrc.

      IF lv_call_subrc = 0
         AND lv_flush_subrc = 0
         AND lv_system_dir IS NOT INITIAL.
        lv_cmd_host = lv_system_dir && '\cmd.exe'.

       "One execute decision removes the complete generated capture family.
        lv_parameter =
          |/D /Q /C DEL /F /Q "{ lv_prefix }*" >NUL 2>&1|.

        cl_gui_frontend_services=>execute(
          EXPORTING
            application = lv_cmd_host
            parameter   = lv_parameter
            synchronous = 'X'
          EXCEPTIONS
            cntl_error             = 1
            error_no_gui           = 2
            bad_parameter          = 3
            file_not_found         = 4
            path_not_found         = 5
            file_extension_unknown = 6
            error_execute_failed   = 7
            synchronous_failed     = 8
            not_supported_by_gui   = 9
            OTHERS                 = 10 ).
        lv_call_subrc = sy-subrc.
        CALL METHOD cl_gui_cfw=>flush EXCEPTIONS OTHERS = 1.
      ENDIF.
    ENDIF.
  ENDIF.

 "Cleanup is best-effort. A stale TEMP family has a unique timestamp prefix,
 "so a workstation denial must not block the next recording.
  REFRESH: gt_z866_screen_caps, gt_z875_fe_text, gt_z875_fe_bin.
  CLEAR: gv_z875_fe_temp, gv_z875_fe_exists,
         gv_z875_fe_length, gv_z875_fe_rc,
         gv_z865_cap_on,
         gv_z865_cap_script,
         gv_z865_cap_log,
         gv_z865_cap_stop,
         gv_z865_cap_ready,
         gv_z865_cap_done,
         gv_z877_cap_diag.
ENDFORM.

FORM resolve_gui_command_target
  USING    pt_script   TYPE ty_t_script
           iv_program  TYPE any
           iv_dynpro   TYPE any
           iv_hint     TYPE any
           iv_comp_id  TYPE any
  CHANGING cv_logical  TYPE zbdc_mapping_bup-bdc_field
           cv_raw      TYPE zbdc_mapping_bup-bdc_field
           cv_ok       TYPE abap_bool
           cv_message  TYPE string.

  TYPES: BEGIN OF ty_z921_hit,
           logical TYPE zbdc_mapping_bup-bdc_field,
           raw     TYPE zbdc_mapping_bup-bdc_field,
           tier    TYPE i,
         END OF ty_z921_hit.
  DATA: lt_hits       TYPE STANDARD TABLE OF ty_z921_hit,
        ls_hit        TYPE ty_z921_hit,
        ls_script     TYPE ty_script_def_compat,
        lv_cur_prog   TYPE char40,
        lv_cur_dyn    TYPE char4,
        lv_prog       TYPE string,
        lv_dyn        TYPE string,
        lv_hint       TYPE string,
        lv_hint_norm  TYPE zbdc_mapping_bup-bdc_field,
        lv_hint_key   TYPE zbdc_mapping_bup-bdc_field,
        lv_hint_leaf  TYPE string,
        lv_id         TYPE string,
        lv_id_upper   TYPE string,
        lv_raw        TYPE zbdc_mapping_bup-bdc_field,
        lv_logical    TYPE zbdc_mapping_bup-bdc_field,
        lv_leaf       TYPE string,
        lv_left       TYPE string,
        lv_tail       TYPE string,
        lv_technical  TYPE abap_bool,
        lv_tier       TYPE i,
        lv_best       TYPE i,
        lv_best_count TYPE i.

  CLEAR: cv_logical, cv_raw, cv_ok, cv_message.
  lv_prog = iv_program.
  lv_dyn  = iv_dynpro.
  lv_hint = iv_hint.
  lv_id   = iv_comp_id.
  TRANSLATE: lv_prog TO UPPER CASE,
             lv_dyn TO UPPER CASE,
             lv_hint TO UPPER CASE,
             lv_id TO UPPER CASE.
  CONDENSE: lv_prog NO-GAPS,
            lv_dyn NO-GAPS,
            lv_hint NO-GAPS,
            lv_id NO-GAPS.
  lv_id_upper = lv_id.

  PERFORM normalize_mapping_bdc_field
    USING    lv_hint
    CHANGING lv_hint_norm.
  PERFORM logical_bdc_key
    USING    lv_hint_norm
    CHANGING lv_hint_key.

  lv_hint_leaf = lv_hint_key.
  IF lv_hint_leaf CS '-'.
    SPLIT lv_hint_leaf AT '-' INTO lv_left lv_tail.
    lv_hint_leaf = lv_tail.
  ENDIF.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_hint_leaf WITH ''.

  CLEAR: lv_cur_prog, lv_cur_dyn.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = abap_true.
      lv_cur_prog = ls_script-program_name.
      lv_cur_dyn  = ls_script-dynpro_no.
      TRANSLATE: lv_cur_prog TO UPPER CASE,
                 lv_cur_dyn TO UPPER CASE.
      CONDENSE: lv_cur_prog NO-GAPS,
                lv_cur_dyn NO-GAPS.
      CONTINUE.
    ENDIF.
    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_raw, lv_logical, lv_technical, lv_tier.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_raw.
    PERFORM field_choreo_only
      USING    lv_raw
      CHANGING lv_technical.
    IF lv_raw IS INITIAL OR lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    lv_raw
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      CONTINUE.
    ENDIF.

    "Tier 4: exact logical technical identity from Component.Name/column key.
    IF lv_hint_key IS NOT INITIAL AND lv_logical = lv_hint_key.
      lv_tier = 4.
    ENDIF.

    "Tier 3: exact technical field is present in the component path.
    IF lv_tier = 0
       AND lv_id_upper IS NOT INITIAL
       AND ( lv_id_upper CS lv_raw OR lv_id_upper CS lv_logical ).
      lv_tier = 3.
    ENDIF.

    "Tier 2: unique technical leaf on the exact program/dynpro.
    lv_leaf = lv_logical.
    IF lv_leaf CS '-'.
      CLEAR: lv_left, lv_tail.
      SPLIT lv_leaf AT '-' INTO lv_left lv_tail.
      lv_leaf = lv_tail.
    ENDIF.
    REPLACE ALL OCCURRENCES OF '(*)' IN lv_leaf WITH ''.
    IF lv_tier = 0
       AND lv_hint_leaf IS NOT INITIAL
       AND lv_leaf = lv_hint_leaf
       AND lv_cur_prog = lv_prog
       AND lv_cur_dyn = lv_dyn.
      lv_tier = 2.
    ENDIF.

    "Tier 1: global unique leaf fallback for generic grid column keys.
    IF lv_tier = 0
       AND lv_hint_leaf IS NOT INITIAL
       AND lv_leaf = lv_hint_leaf.
      lv_tier = 1.
    ENDIF.

    IF lv_tier > 0.
      CLEAR ls_hit.
      ls_hit-logical = lv_logical.
      ls_hit-raw     = lv_raw.
      ls_hit-tier    = lv_tier.
      APPEND ls_hit TO lt_hits.
    ENDIF.
  ENDLOOP.

  LOOP AT lt_hits INTO ls_hit.
    IF ls_hit-tier > lv_best.
      lv_best = ls_hit-tier.
      lv_best_count = 1.
      cv_logical = ls_hit-logical.
      cv_raw     = ls_hit-raw.
    ELSEIF ls_hit-tier = lv_best.
      IF ls_hit-logical <> cv_logical.
        lv_best_count = lv_best_count + 1.
      ENDIF.
    ENDIF.
  ENDLOOP.

  IF lv_best = 0.
    cv_message =
      |NO_TECH_BIND: hint={ lv_hint } id={ lv_id } program={ lv_prog } dynpro={ lv_dyn }.|.
    CLEAR: cv_logical, cv_raw.
    RETURN.
  ENDIF.

  IF lv_best_count > 1.
    cv_message =
      |AMBIGUOUS_TECH_BIND: hint={ lv_hint } resolves to more than one SHDB logical field at proof tier { lv_best }.|.
    CLEAR: cv_logical, cv_raw.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

FORM z114_last_replay_value
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_raw    TYPE zbdc_mapping_bup-bdc_field
           cv_value  TYPE string
           cv_found  TYPE abap_bool.

  DATA: ls_script  TYPE ty_script_def_compat,
        lv_target  TYPE zbdc_mapping_bup-bdc_field,
        lv_raw     TYPE zbdc_mapping_bup-bdc_field,
        lv_key     TYPE zbdc_mapping_bup-bdc_field,
        lv_tech    TYPE abap_bool.

  CLEAR: cv_raw, cv_value, cv_found.

  PERFORM logical_bdc_key
    USING    iv_field
    CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    CLEAR: lv_raw, lv_key, lv_tech.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_raw.
    IF lv_raw IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM field_choreo_only
      USING    lv_raw
      CHANGING lv_tech.
    IF lv_tech = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key
      USING    lv_raw
      CHANGING lv_key.
    IF lv_key <> lv_target.
      CONTINUE.
    ENDIF.

    "Last replay occurrence is the exact value SAP will receive.
    cv_raw   = lv_raw.
    cv_value = ls_script-static_value.
    cv_found = abap_true.
  ENDLOOP.
ENDFORM.

FORM z114_native_value_match
  USING    iv_field TYPE any
           iv_value TYPE string
  CHANGING cv_ok    TYPE abap_bool.

  DATA: ls_fv       TYPE field_vals,
        lv_target   TYPE zbdc_mapping_bup-bdc_field,
        lv_raw      TYPE zbdc_mapping_bup-bdc_field,
        lv_key      TYPE zbdc_mapping_bup-bdc_field,
        lv_expected TYPE string,
        lv_actual   TYPE string,
        lv_tech     TYPE abap_bool.

  CLEAR cv_ok.

  PERFORM logical_bdc_key
    USING    iv_field
    CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  lv_expected = iv_value.
  CONDENSE lv_expected.
  IF lv_expected IS INITIAL.
    "A blank value is not enough to recover a missed user edit safely.
    RETURN.
  ENDIF.

  LOOP AT gt_z360_rec_field_vals INTO ls_fv
    WHERE fieldname IS NOT INITIAL.

    IF ls_fv-input_off = 'X'
       OR ls_fv-active = 'X'
       OR ls_fv-suppress = 'X'.
      CONTINUE.
    ENDIF.

    CLEAR: lv_raw, lv_key, lv_tech.
    PERFORM exact_field_key
      USING    ls_fv-fieldname
      CHANGING lv_raw.
    IF lv_raw IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM field_choreo_only
      USING    lv_raw
      CHANGING lv_tech.
    IF lv_tech = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key
      USING    lv_raw
      CHANGING lv_key.
    IF lv_key <> lv_target.
      CONTINUE.
    ENDIF.

    lv_actual = ls_fv-fieldvalue.
    CONDENSE lv_actual.
    IF lv_actual = lv_expected.
      cv_ok = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

FORM z114_command_param_match
  USING    iv_params TYPE string
           iv_value  TYPE string
  CHANGING cv_ok     TYPE abap_bool.

  DATA: lt_parts    TYPE string_table,
        lv_part     TYPE string,
        lv_expected TYPE string,
        lv_whole    TYPE string.

  CLEAR cv_ok.

  lv_expected = iv_value.
  CONDENSE lv_expected.
  IF lv_expected IS INITIAL.
    RETURN.
  ENDIF.

  lv_whole = iv_params.
  CONDENSE lv_whole.
  IF lv_whole = lv_expected.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  SPLIT iv_params AT '|' INTO TABLE lt_parts.
  LOOP AT lt_parts INTO lv_part.
    CONDENSE lv_part.
    IF lv_part = lv_expected.
      cv_ok = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

FORM z115_component_snapshot_match
  USING    is_cap      TYPE ty_z866_screen_cap
           iv_expected TYPE string
  CHANGING cv_ok       TYPE abap_bool
           cv_surface  TYPE string.

  DATA: lv_expected TYPE string,
        lv_actual   TYPE string.

  CLEAR: cv_ok, cv_surface.

  lv_expected = iv_expected.
  CONDENSE lv_expected.
  IF lv_expected IS INITIAL.
    RETURN.
  ENDIF.

  "Key is strongest for GuiComboBox/list controls because SHDB stores the
  "technical key while SAP GUI may display translated text to the user.
  lv_actual = is_cap-comp_key.
  CONDENSE lv_actual.
  IF lv_actual = lv_expected.
    cv_ok = abap_true.
    cv_surface = 'KEY'.
    RETURN.
  ENDIF.

  lv_actual = is_cap-comp_value.
  CONDENSE lv_actual.
  IF lv_actual = lv_expected.
    cv_ok = abap_true.
    cv_surface = 'VALUE'.
    RETURN.
  ENDIF.

  lv_actual = is_cap-comp_text.
  CONDENSE lv_actual.
  IF lv_actual = lv_expected.
    cv_ok = abap_true.
    cv_surface = 'TEXT'.
    RETURN.
  ENDIF.

  lv_actual = is_cap-comp_selected.
  CONDENSE lv_actual.
  IF lv_actual = lv_expected.
    cv_ok = abap_true.
    cv_surface = 'SELECTED'.
    RETURN.
  ENDIF.
ENDFORM.

FORM z120_cap_matches_value
  USING    is_cap      TYPE ty_z866_screen_cap
           iv_expected TYPE any
  CHANGING cv_ok       TYPE abap_bool
           cv_surface  TYPE string.

  DATA: lv_expected TYPE string,
        lv_actual   TYPE string,
        lv_param_ok TYPE abap_bool,
        lv_snap_ok  TYPE abap_bool,
        lv_snap_src TYPE string.

  CLEAR: cv_ok, cv_surface.
  lv_expected = iv_expected.
  CONDENSE lv_expected.
  IF lv_expected IS INITIAL.
    RETURN.
  ENDIF.

  "Exact value from the classifier, when the SAP command shape is known.
  lv_actual = is_cap-input_value.
  CONDENSE lv_actual.
  IF lv_actual = lv_expected.
    cv_ok = abap_true.
    cv_surface = 'INPUT_VALUE'.
    RETURN.
  ENDIF.

  "Exact token anywhere in the raw CommandArray parameters.
  CLEAR lv_param_ok.
  PERFORM z114_command_param_match
    USING    is_cap-command_params lv_expected
    CHANGING lv_param_ok.
  IF lv_param_ok = abap_true.
    cv_ok = abap_true.
    cv_surface = 'RAW_PARAM'.
    RETURN.
  ENDIF.

  "Exact post-change GUI component technical/display surface.
  CLEAR: lv_snap_ok, lv_snap_src.
  PERFORM z115_component_snapshot_match
    USING    is_cap lv_expected
    CHANGING lv_snap_ok lv_snap_src.
  IF lv_snap_ok = abap_true.
    cv_ok = abap_true.
    cv_surface = |COMP_{ lv_snap_src }|.
    RETURN.
  ENDIF.

  "For proxy/container Change events, the true edited control may be the
  "current GUI focus. Use exact focus value surfaces as additional proof.
  lv_actual = is_cap-active_key.
  CONDENSE lv_actual.
  IF lv_actual = lv_expected.
    cv_ok = abap_true.
    cv_surface = 'FOCUS_KEY'.
    RETURN.
  ENDIF.

  lv_actual = is_cap-active_value.
  CONDENSE lv_actual.
  IF lv_actual = lv_expected.
    cv_ok = abap_true.
    cv_surface = 'FOCUS_VALUE'.
    RETURN.
  ENDIF.

  lv_actual = is_cap-active_text.
  CONDENSE lv_actual.
  IF lv_actual = lv_expected.
    cv_ok = abap_true.
    cv_surface = 'FOCUS_TEXT'.
    RETURN.
  ENDIF.

  lv_actual = is_cap-active_selected.
  CONDENSE lv_actual.
  IF lv_actual = lv_expected.
    cv_ok = abap_true.
    cv_surface = 'FOCUS_SELECTED'.
  ENDIF.
ENDFORM.

FORM build_gui_action_ledger
  USING    pt_script TYPE ty_t_script
  CHANGING ct_actions TYPE ty_t_z920_gui_action
           cv_skipped TYPE i
           cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_cap          TYPE ty_z866_screen_cap,
        ls_action       TYPE ty_z920_gui_action,
        ls_existing     TYPE ty_z920_gui_action,
        lv_cmd_type     TYPE string,
        lv_cmd_name     TYPE string,
        lv_logical      TYPE zbdc_mapping_bup-bdc_field,
        lv_raw          TYPE zbdc_mapping_bup-bdc_field,
        lv_bind_ok      TYPE abap_bool,
        lv_bind_msg     TYPE string,
        lv_last_raw     TYPE zbdc_mapping_bup-bdc_field,
        lv_last_value   TYPE string,
        lv_last_found   TYPE abap_bool,
        lv_value_ok     TYPE abap_bool,
        lv_value_src    TYPE string,
        lv_native_ok    TYPE abap_bool,
        lv_is_native    TYPE abap_bool,
        lv_is_focus     TYPE abap_bool,
        lv_is_composite TYPE abap_bool,
        ls_hist         TYPE ty_script_def_compat,
        lv_hist_raw     TYPE zbdc_mapping_bup-bdc_field,
        lv_hist_key     TYPE zbdc_mapping_bup-bdc_field,
        lv_seq_txt      TYPE string,
        lv_trace        TYPE string,
        lv_proved_rows  TYPE i,
        lv_raw_ignored  TYPE i.

  CLEAR: cv_ok, cv_message, cv_skipped.
  REFRESH ct_actions.

  "V15 ordinary-input authority:
  "  MD:MODIFIED    = SAP GuiVComponent.Modified was true before request/stop.
  "  MR:MODAL_RETURN = exact SystemFocus source changed after modal round-trip.
  "SAP documents Modified as state changed by the USER and not yet sent to SAP.
  "Raw SP/TEXT/KEY/SELECTED rows do not decide ordinary-field membership.
  LOOP AT gt_z866_screen_caps INTO ls_cap.

    lv_cmd_type = ls_cap-command_type.
    lv_cmd_name = ls_cap-command_name.
    TRANSLATE: lv_cmd_type TO UPPER CASE,
               lv_cmd_name TO UPPER CASE.
    CONDENSE: lv_cmd_type NO-GAPS,
              lv_cmd_name NO-GAPS.

    CLEAR: lv_is_native, lv_is_focus, lv_is_composite.
    IF ( lv_cmd_type = 'MD' AND lv_cmd_name = 'MODIFIED' )
       OR ( lv_cmd_type = 'MR' AND lv_cmd_name = 'MODAL_RETURN' ).
      lv_is_native = abap_true.
    ELSEIF lv_cmd_type = 'FD' AND lv_cmd_name = 'FOCUS_DELTA'.
      lv_is_focus = abap_true.
    ELSEIF lv_cmd_type = 'M'
       AND ( lv_cmd_name = 'MODIFYCELL'
          OR lv_cmd_name = 'MODIFYCHECKBOX' ).
      lv_is_composite = abap_true.
    ELSE.
      lv_raw_ignored = lv_raw_ignored + 1.
      CONTINUE.
    ENDIF.

    CLEAR: lv_logical, lv_raw, lv_bind_ok, lv_bind_msg.
    PERFORM resolve_gui_command_target
      USING    pt_script
               ls_cap-program
               ls_cap-dynpro
               ls_cap-target_hint
               ls_cap-focus_id
      CHANGING lv_logical lv_raw lv_bind_ok lv_bind_msg.

    IF lv_bind_ok <> abap_true OR lv_logical IS INITIAL.
      IF lv_is_native = abap_true.
        cv_message =
          |NATIVE_INPUT_BIND_BLOCK: event { ls_cap-seq } component={ ls_cap-focus_name } type={ ls_cap-focus_type } source={ lv_cmd_type }:{ lv_cmd_name } could not bind exactly. { lv_bind_msg } No API request was sent.|.
      ELSEIF lv_is_focus = abap_true.
        cv_message =
          |FOCUS_DELTA_BIND_BLOCK: event { ls_cap-seq } component={ ls_cap-focus_name } type={ ls_cap-focus_type } could not bind exactly. { lv_bind_msg } No API request was sent.|.
      ELSE.
        cv_message =
          |COMPOSITE_BIND_BLOCK: event { ls_cap-seq }/{ ls_cap-command_index } { lv_cmd_type }:{ lv_cmd_name } could not bind exactly. { lv_bind_msg } No API request was sent.|.
      ENDIF.
      REFRESH ct_actions.
      RETURN.
    ENDIF.

    CLEAR: lv_last_raw, lv_last_value, lv_last_found.
    PERFORM z114_last_replay_value
      USING    pt_script lv_logical
      CHANGING lv_last_raw lv_last_value lv_last_found.
    IF lv_last_found <> abap_true.
      cv_message =
        |NATIVE_INPUT_REPLAY_BLOCK: { lv_logical } is not present in immutable SHDB replay. No API request was sent.|.
      REFRESH ct_actions.
      RETURN.
    ENDIF.

    CLEAR: lv_value_ok, lv_value_src.
    IF lv_last_value IS NOT INITIAL.
      PERFORM z120_cap_matches_value
        USING    ls_cap lv_last_value
        CHANGING lv_value_ok lv_value_src.

      "Focus-delta can hold the exact user key before SAP enriches/formats the
      "same control after PAI. Accept only an exact value that also exists in
      "the immutable replay history for this same logical field.
      IF lv_value_ok <> abap_true AND lv_is_focus = abap_true.
        LOOP AT pt_script INTO ls_hist
          WHERE is_new_screen IS INITIAL
            AND field_name IS NOT INITIAL.
          CLEAR: lv_hist_raw, lv_hist_key.
          PERFORM exact_field_key
            USING    ls_hist-field_name
            CHANGING lv_hist_raw.
          IF lv_hist_raw IS INITIAL.
            CONTINUE.
          ENDIF.
          PERFORM logical_bdc_key
            USING    lv_hist_raw
            CHANGING lv_hist_key.
          IF lv_hist_key <> lv_logical OR ls_hist-static_value IS INITIAL.
            CONTINUE.
          ENDIF.

          CLEAR lv_value_src.
          PERFORM z120_cap_matches_value
            USING    ls_cap ls_hist-static_value
            CHANGING lv_value_ok lv_value_src.
          IF lv_value_ok = abap_true.
            lv_last_raw   = lv_hist_raw.
            lv_last_value = ls_hist-static_value.
            lv_value_src  = |REPLAY_HISTORY_{ lv_value_src }|.
            EXIT.
          ENDIF.
        ENDLOOP.
      ENDIF.

      IF lv_value_ok <> abap_true.
        cv_skipped = cv_skipped + 1.
        CONTINUE.
      ENDIF.
    ELSE.
      "A user-cleared field can end blank. Exact native evidence OR a real
      "before/after focus delta is enough together with final blank replay.
      IF lv_is_native = abap_true OR lv_is_focus = abap_true.
        lv_value_ok = abap_true.
        IF lv_is_focus = abap_true.
          lv_value_src = 'FOCUS_DELTA_BLANK'.
        ELSE.
          lv_value_src = 'NATIVE_BLANK'.
        ENDIF.
      ELSE.
        cv_skipped = cv_skipped + 1.
        CONTINUE.
      ENDIF.
    ENDIF.

    CLEAR lv_native_ok.
    PERFORM z114_native_value_match
      USING    lv_logical lv_last_value
      CHANGING lv_native_ok.

    CLEAR ls_action.
    ls_action-first_seq      = ls_cap-seq.
    ls_action-last_seq       = ls_cap-seq.
    ls_action-logical_key    = lv_logical.
    IF lv_last_raw IS NOT INITIAL.
      ls_action-raw_name = lv_last_raw.
    ELSE.
      ls_action-raw_name = lv_raw.
    ENDIF.
    ls_action-program_name   = ls_cap-program.
    ls_action-dynpro_no      = ls_cap-dynpro.
    ls_action-command_type   = lv_cmd_type.
    ls_action-command_name   = lv_cmd_name.
    ls_action-component_name = ls_cap-focus_name.
    ls_action-component_type = ls_cap-focus_type.
    ls_action-component_id   = ls_cap-focus_id.
    ls_action-input_value    = lv_last_value.
    ls_action-image_path     = ls_cap-image_path.

    lv_seq_txt = |E{ ls_cap-seq }|.
    IF lv_is_focus = abap_true.
      IF lv_native_ok = abap_true.
        lv_trace =
          |{ lv_seq_txt }={ lv_last_value } [FOCUS_DELTA:{ lv_value_src };FIELD_VALS=Y]|.
      ELSE.
        lv_trace =
          |{ lv_seq_txt }={ lv_last_value } [FOCUS_DELTA:{ lv_value_src };FIELD_VALS=N]|.
      ENDIF.
    ELSEIF lv_native_ok = abap_true.
      lv_trace =
        |{ lv_seq_txt }={ lv_last_value } [NATIVE:{ lv_cmd_type }:{ lv_value_src };FIELD_VALS=Y]|.
    ELSE.
      lv_trace =
        |{ lv_seq_txt }={ lv_last_value } [NATIVE:{ lv_cmd_type }:{ lv_value_src };FIELD_VALS=N]|.
    ENDIF.
    ls_action-value_trace = lv_trace.

    READ TABLE ct_actions INTO ls_existing
      WITH KEY logical_key = lv_logical.
    IF sy-subrc <> 0.
      APPEND ls_action TO ct_actions.
    ELSE.
      IF ls_existing-value_trace IS INITIAL.
        ls_existing-value_trace = lv_trace.
      ELSEIF ls_existing-value_trace NS lv_trace.
        ls_existing-value_trace =
          ls_existing-value_trace && '; ' && lv_trace.
      ENDIF.

      IF ls_cap-seq >= ls_existing-last_seq.
        ls_existing-last_seq       = ls_cap-seq.
        ls_existing-raw_name       = ls_action-raw_name.
        ls_existing-program_name   = ls_cap-program.
        ls_existing-dynpro_no      = ls_cap-dynpro.
        ls_existing-command_type   = lv_cmd_type.
        ls_existing-command_name   = lv_cmd_name.
        ls_existing-component_name = ls_cap-focus_name.
        ls_existing-component_type = ls_cap-focus_type.
        ls_existing-component_id   = ls_cap-focus_id.
        ls_existing-input_value    = lv_last_value.
        ls_existing-image_path     = ls_cap-image_path.
      ENDIF.
      MODIFY ct_actions FROM ls_existing INDEX sy-tabix.
    ENDIF.

    lv_proved_rows = lv_proved_rows + 1.
  ENDLOOP.

  IF ct_actions IS INITIAL.
    cv_message =
      |NATIVE_INPUT_PREFLIGHT_EMPTY: SAP Modified/modal-return/focus-delta evidence produced no exact SHDB-bound business input; raw rows ignored={ lv_raw_ignored }. No API request was sent.|.
    RETURN.
  ENDIF.

  SORT ct_actions BY first_seq logical_key.
  cv_ok = abap_true.
  cv_message =
    |NATIVE_INPUT_PREFLIGHT_OK: { lines( ct_actions ) } exact user-modified logical field(s); { lv_proved_rows } proving action row(s), { cv_skipped } non-replay-matching row(s), { lv_raw_ignored } raw audit row(s) ignored.|.
ENDFORM.

FORM preflight_gui_action_ledger
  USING    pt_script TYPE ty_t_script
  CHANGING cv_ok      TYPE abap_bool
           cv_count   TYPE i
           cv_message TYPE string.

  DATA: lt_actions TYPE ty_t_z920_gui_action,
        lv_skipped TYPE i.

  CLEAR: cv_ok, cv_count, cv_message.
  PERFORM build_gui_action_ledger
    USING    pt_script
    CHANGING lt_actions lv_skipped cv_ok cv_message.
  IF cv_ok = abap_true.
    DESCRIBE TABLE lt_actions LINES cv_count.
  ENDIF.
ENDFORM.
FORM start_guided_recording.
  DATA: lt_fields    TYPE STANDARD TABLE OF sval,
        ls_field     TYPE sval,
        lv_rc        TYPE c LENGTH 1,
        lv_tcode     TYPE sy-tcode,
        lv_tcode_ok  TYPE abap_bool,
        lv_tcode_kind TYPE char20,
        lv_tcode_msg TYPE string,
        lt_bdc       TYPE ty_bdcdata_tab,
        lt_saved_bdc TYPE ty_bdcdata_tab,
        lt_txt       TYPE string_table,
        lt_script    TYPE ty_t_script,
        lv_txt_tcode TYPE sy-tcode,
        lv_rec_ok    TYPE abap_bool,
        lv_rec_msg   TYPE string,
        lv_save_ok   TYPE abap_bool,
        lv_save_msg  TYPE string,
        lv_txt_ok    TYPE abap_bool,
        lv_txt_msg   TYPE string,
        lv_parse_ok  TYPE abap_bool,
        lv_parse_msg TYPE string,
        lv_roundtrip_ok  TYPE abap_bool,
        lv_roundtrip_msg TYPE string,
        lv_cap_started TYPE abap_bool,
        lv_cap_ok      TYPE abap_bool,
        lv_cap_msg     TYPE string,
        lv_action_pre_ok TYPE abap_bool,
        lv_action_pre_n  TYPE i,
        lv_action_pre_msg TYPE string.

  CLEAR ls_field.
  ls_field-tabname   = 'TSTC'.
  ls_field-fieldname = 'TCODE'.
  CLEAR ls_field-value.
  IF p_rec_tcode IS NOT INITIAL
     AND txtp_profile_name IS NOT INITIAL
     AND gv_profile_ver IS NOT INITIAL
     AND gv_runtime_script_id IS NOT INITIAL
     AND gv_runtime_contract_hash IS NOT INITIAL.
    ls_field-value = p_rec_tcode.
  ENDIF.
  APPEND ls_field TO lt_fields.

  CALL FUNCTION 'POPUP_GET_VALUES'
    EXPORTING
      popup_title = 'Start Guided Recording'
    IMPORTING
      returncode  = lv_rc
    TABLES
      fields      = lt_fields
    EXCEPTIONS
      OTHERS      = 1.

  IF sy-subrc <> 0 OR lv_rc = 'A'.
    RETURN.
  ENDIF.

  READ TABLE lt_fields INTO ls_field INDEX 1.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  lv_tcode = ls_field-value.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.

  IF lv_tcode IS INITIAL.
    MESSAGE s200(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "fail closed before opening the recorder if the transaction is not
 "repository-proven SAP standard. Do not use TCODE prefixes as ownership.
  CLEAR: lv_tcode_ok, lv_tcode_kind, lv_tcode_msg.
  PERFORM check_standard_tcode
    USING    lv_tcode
    CHANGING lv_tcode_ok lv_tcode_kind lv_tcode_msg.
  IF lv_tcode_ok <> abap_true.
    PERFORM userize_ui_message USING lv_tcode_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  p_rec_tcode   = lv_tcode.
  p_transaction = lv_tcode.
  CLEAR: gv_z652_acq_origin,
         gv_z689_review_pending,
         gv_z689_review_tcode,
         gv_z689_review_origin,
         gv_z866_vision_required,
         gv_z866_vision_analyzed.
  REFRESH: gt_z333_rec_evidence,
           gt_z360_rec_field_vals,
           gt_z369_guided_txt_lines,
           gt_z865_gui_labels,
           gt_z935_import_live,
           gt_z866_screen_caps,
           gt_z659_user_actions,
           gt_z684_names.
  CLEAR: gv_z500_raw_qid, gv_z500_raw_group,
         gv_z659_action_script, gv_z659_action_hash,
         gv_z659_action_ready, gv_z684_name_script,
         gv_z684_name_hash, gv_z684_name_ready.

  MESSAGE s201(zbdc)
    WITH lv_tcode
    DISPLAY LIKE 'I'.

 "Start the event-driven SAP GUI Change listener before SAP's BDC recorder
 "opens the transaction. It does not poll field text/focus while the user types;
 "SAP GUI itself emits one Change event for each modified UI element.
  CLEAR: lv_cap_started, lv_cap_ok, lv_cap_msg.
  PERFORM start_gui_label_capture
    USING    lv_tcode
    CHANGING lv_cap_started lv_cap_msg.
  IF lv_cap_started <> abap_true.
    IF lv_cap_msg IS INITIAL.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '859' INTO lv_cap_msg.
    ENDIF.
    PERFORM userize_ui_message USING lv_cap_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.
  "Capture remains mandatory for deterministic user-action evidence.
  "It is no longer an AI prerequisite.
  CLEAR: gv_z866_vision_required, gv_z866_vision_analyzed.

  PERFORM record_tcode_bdc
    USING    lv_tcode
    CHANGING lt_bdc lv_rec_ok lv_rec_msg.

 "Always stop the listener, including a cancelled/failed SAP recording.
  IF lv_cap_started = abap_true.
    PERFORM stop_gui_label_capture
      CHANGING lv_cap_ok lv_cap_msg.
  ENDIF.

  IF lv_rec_ok <> abap_true.
    PERFORM userize_ui_message USING lv_rec_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  "Capture is an authoritative prerequisite. Never continue into SHDB
  "preflight with an empty/failed event manifest, and never hide its real error.
  IF lv_cap_ok <> abap_true.
    IF lv_cap_msg IS INITIAL.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '860' INTO lv_cap_msg.
    ENDIF.
    PERFORM userize_ui_message USING lv_cap_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "do not serialize the transient return table directly. Persist it
 "through SAP SBDR storage and make the SAP read-back table authoritative.
  PERFORM persist_readback_bdc
    USING    lv_tcode lt_bdc
    CHANGING lt_saved_bdc lv_save_ok lv_save_msg.

  IF lv_save_ok <> abap_true.
    PERFORM userize_ui_message USING lv_save_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  PERFORM bdc_to_shdb_txt
    USING    lv_tcode lt_saved_bdc
    CHANGING lt_txt lv_txt_ok lv_txt_msg.

  IF lv_txt_ok <> abap_true.
    PERFORM userize_ui_message USING lv_txt_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  gt_z369_guided_txt_lines = lt_txt.

  PERFORM parse_shdb_txt_lines
    USING    lt_txt
    CHANGING lv_txt_tcode lt_script lv_parse_ok lv_parse_msg.

  IF lv_parse_ok <> abap_true.
    PERFORM userize_ui_message USING lv_parse_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF lv_txt_tcode <> lv_tcode.
    MESSAGE s202(zbdc)
      WITH lv_txt_tcode lv_tcode
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF lt_script IS INITIAL.
    MESSAGE s203(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  CLEAR: lv_roundtrip_ok, lv_roundtrip_msg.
  PERFORM verify_saved_bdc_rt
    USING    lt_saved_bdc lt_script
    CHANGING lv_roundtrip_ok lv_roundtrip_msg.
  IF lv_roundtrip_ok <> abap_true.
    PERFORM userize_ui_message USING lv_roundtrip_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  "Deterministic 1-to-1 user-action gate before Mapping Profile; no AI/API is needed.
  CLEAR: lv_action_pre_ok, lv_action_pre_n, lv_action_pre_msg.
  PERFORM preflight_gui_action_ledger
    USING    lt_script
    CHANGING lv_action_pre_ok lv_action_pre_n lv_action_pre_msg.
  IF lv_action_pre_ok <> abap_true.
    PERFORM userize_ui_message USING lv_action_pre_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "Return the exact RAW recording immediately. Retained capture/action evidence
 "identifies exactly which fields the user changed. Mapping Profile resolves
 "those exact BDC fields through SAP DDIC; no AI/API call runs.
  PERFORM stage_acquisition_review
    USING lv_tcode 'GUIDED_RECORD' lt_script.

  CLEAR: gv_z866_vision_required, gv_z866_vision_analyzed.
  DATA(lv_zm738_13460_1) = |{ lv_action_pre_n }|.
  MESSAGE s738(zbdc) WITH lv_zm738_13460_1.
ENDFORM.

*& Select one exact transaction block from multi-block SHDB TXT

*& A single TXT export may contain more than one transaction header (FLAG=T),
*& including repeated headers for the same TCODE. Rejecting the whole file is
*& unnecessarily strict, while concatenating blocks would create a hybrid
*& replay contract. Therefore Import stays generic and lossless by letting
*& the user select exactly ONE raw transaction block when more than one exists.
*& No TCODE/application/field name is hardcoded and no block is auto-selected.
*& The selected raw line range is passed unchanged to the existing strict
*& parser; different TCODE blocks are also supported because the user, not a
*& heuristic, chooses the intended transaction.

FORM select_shdb_tx_block
  USING    it_raw      TYPE string_table
  CHANGING ct_selected TYPE string_table
           cv_ok       TYPE abap_bool
           cv_message  TYPE string.

  TYPES: BEGIN OF ty_z692_block,
           block_no     TYPE i,
           tcode        TYPE sy-tcode,
           start_line   TYPE i,
           end_line     TYPE i,
           screens      TYPE i,
           fields       TYPE i,
           first_screen TYPE c LENGTH 50,
           line_range   TYPE c LENGTH 20,
         END OF ty_z692_block.

  DATA: lt_blocks   TYPE STANDARD TABLE OF ty_z692_block,
        ls_block    TYPE ty_z692_block,
        ls_choice   TYPE ty_z692_block,
        lt_tok      TYPE string_table,
        lv_line     TYPE string,
        lv_prog     TYPE string,
        lv_dynp     TYPE string,
        lv_flag     TYPE string,
        lv_fnam     TYPE string,
        lv_fval     TYPE string,
        lv_line_no  TYPE i,
        lv_block_no TYPE i,
        lv_count    TYPE i,
        lt_fieldcat TYPE slis_t_fieldcat_alv,
        ls_fieldcat TYPE slis_fieldcat_alv,
        ls_selfield TYPE slis_selfield,
        lv_exit     TYPE c.

  CLEAR: cv_ok, cv_message, lv_line_no, lv_block_no, lv_count.
  REFRESH: ct_selected, lt_blocks.

  LOOP AT it_raw INTO lv_line.
    lv_line_no = sy-tabix.
    REFRESH lt_tok.
    SPLIT lv_line AT cl_abap_char_utilities=>horizontal_tab INTO TABLE lt_tok.
    CLEAR: lv_prog, lv_dynp, lv_flag, lv_fnam, lv_fval.

    READ TABLE lt_tok INTO lv_prog INDEX 1.
    READ TABLE lt_tok INTO lv_dynp INDEX 2.
    READ TABLE lt_tok INTO lv_flag INDEX 3.
    READ TABLE lt_tok INTO lv_fnam INDEX 4.
    READ TABLE lt_tok INTO lv_fval INDEX 5.

    CONDENSE: lv_prog, lv_dynp, lv_flag, lv_fnam.

    IF lv_flag = 'T'.
      IF ls_block-start_line > 0.
        ls_block-end_line = lv_line_no - 1.
        ls_block-line_range =
          |{ ls_block-start_line }-{ ls_block-end_line }|.
        APPEND ls_block TO lt_blocks.
      ENDIF.

      CLEAR ls_block.
      lv_block_no = lv_block_no + 1.
      ls_block-block_no   = lv_block_no.
      ls_block-start_line = lv_line_no.
      ls_block-tcode      = lv_fnam.
      TRANSLATE ls_block-tcode TO UPPER CASE.
      CONDENSE ls_block-tcode NO-GAPS.
      CONTINUE.
    ENDIF.

    IF ls_block-start_line <= 0.
      CONTINUE.
    ENDIF.

    IF lv_flag = 'X'.
      ls_block-screens = ls_block-screens + 1.
      IF ls_block-first_screen IS INITIAL
         AND lv_prog IS NOT INITIAL
         AND lv_dynp IS NOT INITIAL.
        ls_block-first_screen = |{ lv_prog }/{ lv_dynp }|.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF lv_fnam IS NOT INITIAL AND lv_fnam NP 'BDC_*'.
      ls_block-fields = ls_block-fields + 1.
    ENDIF.
  ENDLOOP.

  IF ls_block-start_line > 0.
    ls_block-end_line = lv_line_no.
    ls_block-line_range =
      |{ ls_block-start_line }-{ ls_block-end_line }|.
    APPEND ls_block TO lt_blocks.
  ENDIF.

  DESCRIBE TABLE lt_blocks LINES lv_count.

 "No/missing T header is left to the canonical TXT parser so its existing
 "validation/message remains the single authority for malformed TXT.
  IF lv_count <= 1.
    ct_selected[] = it_raw[].
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  DEFINE add_z692_fcat.
    CLEAR ls_fieldcat.
    ls_fieldcat-fieldname = &1.
    ls_fieldcat-seltext_s = &2.
    ls_fieldcat-seltext_m = &3.
    ls_fieldcat-seltext_l = &3.
    ls_fieldcat-outputlen = &4.
    ls_fieldcat-no_out    = &5.
    APPEND ls_fieldcat TO lt_fieldcat.
  END-OF-DEFINITION.

  add_z692_fcat 'BLOCK_NO'     'Block'  'Block'        5  ''.
  add_z692_fcat 'TCODE'        'TCODE'  'TCODE'       20 ''.
  add_z692_fcat 'SCREENS'      'Scr'    'Screens'      7 ''.
  add_z692_fcat 'FIELDS'       'Fld'    'Input rows'   10 ''.
  add_z692_fcat 'FIRST_SCREEN' 'First'  'First screen' 32 ''.
  add_z692_fcat 'LINE_RANGE'   'Lines'  'Raw lines'    14 ''.
  add_z692_fcat 'START_LINE'   'Start'  'Start'         8 'X'.
  add_z692_fcat 'END_LINE'     'End'    'End'           8 'X'.

  CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
    EXPORTING
      i_title               = 'Select one SHDB transaction block'
      i_selection           = 'X'
      i_zebra               = 'X'
      i_tabname             = 'LT_BLOCKS'
      it_fieldcat           = lt_fieldcat
      i_screen_start_column = 5
      i_screen_start_line   = 3
      i_screen_end_column   = 95
      i_screen_end_line     = 18
    IMPORTING
      es_selfield           = ls_selfield
      e_exit                = lv_exit
    TABLES
      t_outtab              = lt_blocks
    EXCEPTIONS
      program_error         = 1
      OTHERS                = 2.

  IF sy-subrc <> 0 OR lv_exit = 'X'.
    cv_message =
      'Multi-block SHDB import cancelled; no transaction block was selected and nothing was loaded.'.
    RETURN.
  ENDIF.

  IF ls_selfield-tabindex <= 0.
    cv_message =
      'Select exactly one SHDB transaction block to import; nothing was auto-selected.'.
    RETURN.
  ENDIF.

  READ TABLE lt_blocks INTO ls_choice INDEX ls_selfield-tabindex.
  IF sy-subrc <> 0
     OR ls_choice-start_line <= 0
     OR ls_choice-end_line < ls_choice-start_line.
    cv_message =
      'Selected SHDB transaction block could not be resolved exactly; nothing was loaded.'.
    RETURN.
  ENDIF.

  LOOP AT it_raw INTO lv_line
    FROM ls_choice-start_line TO ls_choice-end_line.
    APPEND lv_line TO ct_selected.
  ENDLOOP.

  IF ct_selected IS INITIAL.
    cv_message =
      'Selected SHDB transaction block contains no raw lines; nothing was loaded.'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message =
    |Selected block { ls_choice-block_no }/{ lv_count } ({ ls_choice-tcode }), raw lines { ls_choice-line_range }; no blocks were merged.|.
ENDFORM.

FORM upload_shdb_recording.
  CLEAR: gv_z652_acq_origin,
         gv_z866_vision_required,
         gv_z866_vision_analyzed,
         gv_z934_import_screen_proof.
  REFRESH: gt_z333_rec_evidence,
           gt_z360_rec_field_vals,
           gt_z369_guided_txt_lines,
           gt_z865_gui_labels,
           gt_z935_import_live,
           gt_z866_screen_caps,
           gt_z659_user_actions.
  CLEAR: gv_z659_action_script, gv_z659_action_hash,
         gv_z659_action_ready, gv_z684_name_script,
         gv_z684_name_hash, gv_z684_name_ready.
  REFRESH gt_z684_names.

  DATA: lt_raw       TYPE string_table,
        lt_txt_one   TYPE string_table,
        lt_scr       TYPE ty_t_script,
        lv_tcode     TYPE sy-tcode,
        lv_file_f4   TYPE rlgrap-filename,
        lv_file      TYPE string,
        lv_block_ok  TYPE abap_bool,
        lv_block_msg TYPE string,
        lv_parse_ok  TYPE abap_bool,
        lv_parse_msg TYPE string,
        lv_onb_ok    TYPE abap_bool,
        lv_onb_msg   TYPE string.

  "V17.5: restore the legacy Import Recording file chooser UI.
  "Do not use CL_GUI_FRONTEND_SERVICES=>FILE_OPEN_DIALOG here because on
  "this SAP GUI it renders the newer Directory/File Name popup. The former
  "Import Recording flow used the classic F4 filename chooser. Only the
  "presentation of file selection changes; parsing/onboarding stays generic.
  CLEAR lv_file_f4.
  CALL FUNCTION 'F4_FILENAME'
    EXPORTING
      program_name  = sy-repid
      dynpro_number = sy-dynnr
      field_name    = 'P_FILE'
    IMPORTING
      file_name     = lv_file_f4.

  IF lv_file_f4 IS INITIAL.
    RETURN.
  ENDIF.

  lv_file = lv_file_f4.

  cl_gui_frontend_services=>gui_upload(
    EXPORTING
      filename = lv_file
      filetype = 'ASC'
      codepage = '4110'
    CHANGING
      data_tab = lt_raw
    EXCEPTIONS
      OTHERS   = 1 ).

  IF sy-subrc <> 0.
    MESSAGE s204(zbdc)
      WITH sy-subrc
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  CLEAR: lt_scr, lv_tcode, lv_onb_ok, lv_onb_msg.
  PERFORM parse_shdb_program
    USING    lt_raw
    CHANGING lv_tcode lt_scr lv_onb_ok lv_onb_msg.
  IF lv_onb_ok = abap_true.
    gt_z333_rec_evidence = lt_scr.
    PERFORM onboard_parsed_script
      USING    lv_tcode 'SHDB_PROGRAM'
      CHANGING lt_scr lv_onb_ok lv_onb_msg.

    IF lv_onb_ok = abap_true.
      gt_script_def = lt_scr.
      PERFORM userize_ui_message USING lv_onb_msg CHANGING gv_ui_message.
      MESSAGE gv_ui_message TYPE 'S'.
    ELSE.
      IF lv_onb_msg IS INITIAL.
        MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '861' INTO lv_onb_msg.
      ENDIF.
      PERFORM userize_ui_message USING lv_onb_msg CHANGING gv_ui_message.
      MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    ENDIF.
    RETURN.
  ELSEIF lv_onb_msg IS NOT INITIAL.
    PERFORM userize_ui_message USING lv_onb_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "TXT files may contain several transaction blocks. Do not reject
 "the whole file and do not merge blocks. If needed, let the user select one
 "exact raw block, then feed only that unchanged range to the strict parser.
  REFRESH lt_txt_one.
  CLEAR: lv_block_ok, lv_block_msg.
  PERFORM select_shdb_tx_block
    USING    lt_raw
    CHANGING lt_txt_one lv_block_ok lv_block_msg.
  IF lv_block_ok <> abap_true.
    PERFORM userize_ui_message USING lv_block_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  REFRESH lt_scr.
  CLEAR: lv_tcode, lv_parse_ok, lv_parse_msg.
  PERFORM parse_shdb_txt_lines
    USING    lt_txt_one
    CHANGING lv_tcode lt_scr lv_parse_ok lv_parse_msg.

  IF lv_parse_ok <> abap_true.
    PERFORM userize_ui_message USING lv_parse_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "Import Recording finishes by showing the exact parsed RAW rows.
 "The user is not interrupted by Template confirmation during the Import PAI.
  PERFORM stage_acquisition_review
    USING lv_tcode 'SHDB_TXT' lt_scr.

  MESSAGE s739(zbdc).
ENDFORM.

*&=====================================================================*
*& MUC 2 V2 - EXECUTION COCKPIT / DISPLAY FLOW 10-10
*&=====================================================================*

FORM build_cert_map_view
  USING    it_script  TYPE ty_t_script
           iv_tcode   TYPE zbdc_mapping_bup-tcode
           iv_profile TYPE zbdc_mapping_bup-profile_name
           iv_ver     TYPE zbdc_mapping_bup-profile_ver
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_script   TYPE ty_script_def_compat,
        ls_map      TYPE zbdc_mapping_bup,
        lv_action   TYPE zbdc_mapping_bup-bdc_field,
        lv_action_l TYPE zbdc_mapping_bup-bdc_field,
        lv_bdc      TYPE zbdc_mapping_bup-bdc_field,
        lv_bdc_l    TYPE zbdc_mapping_bup-bdc_field,
        lv_name     TYPE zbdc_mapping_bup-source_column,
        lv_name_ok  TYPE abap_bool,
        lv_bound    TYPE abap_bool,
        lv_slot     TYPE zbdc_mapping_bup-staging_field,
        lv_expected TYPE i,
        lv_expected_total TYPE i,
        lv_actual   TYPE i.

  DATA: lt_slots TYPE ty_t_map_staging_slot,
        lt_used  TYPE SORTED TABLE OF zbdc_mapping_bup-staging_field
                 WITH UNIQUE KEY table_line,
        lt_names TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                 WITH UNIQUE KEY table_line.

  CLEAR: cv_ok, cv_message.

  IF gv_z659_action_ready <> abap_true
     OR gv_z684_name_ready <> abap_true
     OR gt_z659_user_actions IS INITIAL
     OR gt_z684_names IS INITIAL.
    cv_message = 'Exact saved Template-field selection is not loaded.'.
    RETURN.
  ENDIF.

  IF it_script IS INITIAL OR iv_tcode IS INITIAL
     OR iv_profile IS INITIAL OR iv_ver IS INITIAL.
    cv_message = 'Exact contract context is incomplete for selected-field restore.'.
    RETURN.
  ENDIF.

  REFRESH: lt_slots, lt_used, lt_names, gt_mapping_screen.
  PERFORM get_mapping_staging_slots CHANGING lt_slots.
  READ TABLE lt_slots WITH TABLE KEY table_line = 'FIELD01'
    TRANSPORTING NO FIELDS.
  IF sy-subrc <> 0.
    cv_message = 'ZBDC_STAGING_BUP has no FIELD01 for BUSINESS_KEY.'.
    RETURN.
  ENDIF.

  CLEAR ls_map.
  ls_map-tcode         = iv_tcode.
  ls_map-profile_name  = iv_profile.
  ls_map-profile_ver   = iv_ver.
  ls_map-source_column = 'BUSINESS_KEY'.
  ls_map-staging_field = 'FIELD01'.
  ls_map-mandatory     = 'X'.
  APPEND ls_map TO gt_mapping_screen.
  lv_slot = 'FIELD01'.
  INSERT lv_slot INTO TABLE lt_used.
  lv_name = 'BUSINESS_KEY'.
  INSERT lv_name INTO TABLE lt_names.
  CLEAR: lv_slot, lv_name.

  LOOP AT gt_z659_user_actions INTO lv_action.
    CLEAR: lv_action_l, lv_bdc, lv_bdc_l, lv_name, lv_name_ok,
           lv_bound, lv_slot.

    PERFORM logical_bdc_key
      USING    lv_action
      CHANGING lv_action_l.
    IF lv_action_l IS INITIAL.
      lv_action_l = lv_action.
    ENDIF.

    LOOP AT it_script INTO ls_script
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.
      CLEAR: lv_bdc, lv_bdc_l.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-field_name
        CHANGING lv_bdc.
      IF lv_bdc IS INITIAL.
        CONTINUE.
      ENDIF.
      PERFORM logical_bdc_key
        USING    lv_bdc
        CHANGING lv_bdc_l.
      IF lv_bdc_l IS INITIAL.
        lv_bdc_l = lv_bdc.
      ENDIF.
      IF lv_bdc_l = lv_action_l.
        EXIT.
      ENDIF.
      CLEAR lv_bdc.
    ENDLOOP.

    IF lv_bdc IS INITIAL.
      REFRESH gt_mapping_screen.
      cv_message = |RESTORE_BIND_BLOCK: saved field { lv_action_l } is not present in the immutable Script.|.
      RETURN.
    ENDIF.

    PERFORM raw_replay_bound
      USING    it_script lv_bdc
      CHANGING lv_bound.
    IF lv_bound <> abap_true.
      REFRESH gt_mapping_screen.
      cv_message = |RESTORE_BIND_BLOCK: saved field { lv_action_l } has no replay binding.|.
      RETURN.
    ENDIF.

    PERFORM confirmed_name
      USING    lv_bdc
      CHANGING lv_name lv_name_ok.
    IF lv_name_ok <> abap_true OR lv_name IS INITIAL.
      REFRESH gt_mapping_screen.
      cv_message = |RESTORE_NAME_BLOCK: saved field { lv_action_l } has no certified Template name.|.
      RETURN.
    ENDIF.

    READ TABLE lt_names WITH TABLE KEY table_line = lv_name
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      REFRESH gt_mapping_screen.
      cv_message = |RESTORE_NAME_COLLISION: certified Template name { lv_name } is not unique.|.
      RETURN.
    ENDIF.

    LOOP AT lt_slots INTO lv_slot.
      IF lv_slot = 'FIELD01'.
        CONTINUE.
      ENDIF.
      READ TABLE lt_used WITH TABLE KEY table_line = lv_slot
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        EXIT.
      ENDIF.
      CLEAR lv_slot.
    ENDLOOP.
    IF lv_slot IS INITIAL.
      REFRESH gt_mapping_screen.
      cv_message = 'Not enough generic staging FIELDnn slots to restore the saved selection.'.
      RETURN.
    ENDIF.

    CLEAR ls_map.
    ls_map-tcode         = iv_tcode.
    ls_map-profile_name  = iv_profile.
    ls_map-profile_ver   = iv_ver.
    ls_map-source_column = lv_name.
    ls_map-staging_field = lv_slot.
    ls_map-bdc_field     = lv_bdc.
    CLEAR ls_map-mandatory.
    PERFORM NORM_MAP_REQUIRED CHANGING ls_map.
    PERFORM apply_fmt_contract CHANGING ls_map.
    APPEND ls_map TO gt_mapping_screen.
    INSERT lv_slot INTO TABLE lt_used.
    INSERT lv_name INTO TABLE lt_names.
  ENDLOOP.

  DESCRIBE TABLE gt_z659_user_actions LINES lv_expected.
  DESCRIBE TABLE gt_mapping_screen LINES lv_actual.
  lv_expected_total = lv_expected + 1.
  IF lv_actual <> lv_expected_total.
    REFRESH gt_mapping_screen.
    cv_message = |RESTORE_SET_BLOCK: saved fields={ lv_expected }, total restored Mapping rows={ lv_actual }.|.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message = |Restored { lv_expected } saved Template field(s) from the exact immutable contract.|.
ENDFORM.

*&---------------------------------------------------------------------*
*& Canonical Required-column semantics
*&---------------------------------------------------------------------*
*& Required is display/contract metadata only; it is not the runtime
*& authority for blank-value validation.
*& FIELD01/BUSINESS_KEY stays Required because it is the engine control key.
*& Business-input rows are not auto-marked Required from SHDB values,
*& defaults, legacy Mapping rows, or inferred DDIC metadata.
*& Runtime blank eligibility is proved separately by M3_VALID and SAP.
*& REVIEW_REQUIRED ('?') is preserved until the candidate is resolved.
FORM NORM_MAP_REQUIRED
  CHANGING cs_map TYPE zbdc_mapping_bup.

  IF cs_map-mandatory = gc_m2_map_review.
    RETURN.
  ENDIF.

  IF cs_map-staging_field = 'FIELD01'
     AND cs_map-bdc_field IS INITIAL.
    cs_map-mandatory = 'X'.
  ELSE.
    CLEAR cs_map-mandatory.
  ENDIF.

ENDFORM.

FORM load_mapping_screen.
  DATA: lv_tcode   TYPE zbdc_mapping_bup-tcode,
        lv_profile TYPE zbdc_mapping_bup-profile_name,
        lv_cert_ok TYPE abap_bool,
        lv_cert_msg TYPE string.

 "Candidate Mapping Review for TXT_ONLY/GUIDED_ONLY evidence is
 "held only in memory. Screen 0350 PBO must not erase it by running the
 "normal exact-contract loader, because no official tuple is pinned yet.
  IF gv_z240_map_locked = abap_true
     AND gt_mapping_screen IS NOT INITIAL
     AND gv_z340_lock_done IS INITIAL.
    RETURN.
  ENDIF.

  IF gv_z340_lock_done = abap_true.
    CLEAR gv_z240_map_locked.
    gv_z133_origin = 'LOCKED_CONTRACT'.
  ENDIF.

  REFRESH gt_mapping_screen.

  lv_tcode = p_rec_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.

  lv_profile = txtp_profile_name.
  CONDENSE lv_profile.

  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL OR gv_profile_ver IS INITIAL.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_mapping_bup
    INTO TABLE @gt_mapping_screen
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @gv_profile_ver
    ORDER BY staging_field, source_column.

 "Mapping Profile and Generate Template use the same generic
 "business-input projection predicate. The screen is not a copy of the
 "Import/Template output: it reads the Mapping repository and projects only
 "rows classified as user business input. Optional technical SHDB rows stay
 "persisted for audit/runtime replay. No TCODE, SAP field, source-column,
 "object table, or object field is hardcoded.
  PERFORM filter_map_bus_view
    USING    lv_tcode lv_profile gv_profile_ver
    CHANGING gt_mapping_screen.

 "Start Recording and SHDB TXT Import must pass through the
 "same end-user template projection. Repository rows such as server
 "defaults (for example a value submitted after ENTER/SAVE with no
 "cursor/user-action evidence) can stay in the replay script, but must not
 "be displayed as template authority. This keeps Import TXT and Guided
 "Recording on the same user-action predicate.
  PERFORM filter_map_user_ev
    CHANGING gt_mapping_screen.

  LOOP AT gt_mapping_screen ASSIGNING FIELD-SYMBOL(<ls_req_view>).
    PERFORM NORM_MAP_REQUIRED CHANGING <ls_req_view>.
  ENDLOOP.

  CLEAR: gv_z133_loaded_script_id, gv_z133_loaded_hash,
         gv_z133_loaded_changed_at.
  SELECT SINGLE script_id, contract_hash, changed_at
    FROM zbdc_script_bup
    INTO (@gv_z133_loaded_script_id, @gv_z133_loaded_hash,
          @gv_z133_loaded_changed_at)
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @gv_profile_ver.

 "For My Import / All Import, the immutable A36 certificate is the exact
 "selection authority. Repository Mapping rows from older versions may be
 "incomplete (for example BUSINESS_KEY only); never make the user choose
 "again just because that historical projection was not persisted. Rebuild
 "the screen deterministically from the saved membership + saved names +
 "immutable Script. This is an in-memory restore, not a repository mutation.
  IF gv_z133_origin = 'LOCKED_CONTRACT'
     AND gv_z659_action_ready = abap_true
     AND gv_z684_name_ready = abap_true
     AND gv_z659_action_script = gv_z133_loaded_script_id
     AND gv_z659_action_hash = gv_z133_loaded_hash.
    CLEAR: lv_cert_ok, lv_cert_msg.
    PERFORM build_cert_map_view
      USING    gt_script_def lv_tcode lv_profile gv_profile_ver
      CHANGING lv_cert_ok lv_cert_msg.
  ENDIF.
ENDFORM.

*& Shared business-field projection predicate

*& One generic predicate is used by both Mapping Profile default view and
*& Generate Template. This is not a layout copy from Import: every caller
*& reads its own repository rows, enriches metadata, then asks the same
*& classifier whether a row is an end-user business input. The classifier
*& never branches by TCODE, SAP field, source-column name, object table, or
*& document type.

FORM bus_proj_ok
  USING    is_map        TYPE zbdc_mapping_bup
           is_meta       TYPE ty_map_meta
           iv_meta_found TYPE abap_bool
  CHANGING cv_visible    TYPE abap_bool.

  DATA lv_source TYPE zbdc_mapping_bup-source_column.

  CLEAR cv_visible.

  IF is_map-mandatory = gc_m2_map_review.
    RETURN.
  ENDIF.

  PERFORM normalize_mapping_source
    USING    is_map-source_column
    CHANGING lv_source.
  IF lv_source IS INITIAL.
    RETURN.
  ENDIF.

 "The business/document key is a system control column exposed to users.
  IF is_map-bdc_field IS INITIAL.
    IF is_map-mandatory = 'X'.
      cv_visible = abap_true.
    ENDIF.
    RETURN.
  ENDIF.

  IF iv_meta_found <> abap_true.
 "A fallback source like INPUT_<SAP_FIELD> is not a stable
 "end-user business name. Without Field Guide/metadata it must not be
 "rendered into Mapping/CSV/XLSX/Gmail/GDrive templates merely because
 "the draft marked it mandatory. The SAP value remains in the technical
 "script/mapping repository and can be promoted only by explicit metadata.
    IF lv_source CP 'INPUT_*'.
      RETURN.
    ENDIF.

 "Do not invent business meaning. A mandatory non-fallback row is kept
 "visible so the profile can be reviewed/fixed instead of being silently
 "lost.
    IF is_map-mandatory = 'X'.
      cv_visible = abap_true.
    ENDIF.
    RETURN.
  ENDIF.

  IF is_meta-metadata_origin <> 'FIELD_GUIDE'
     AND lv_source CP 'INPUT_*'.
    RETURN.
  ENDIF.

  IF is_meta-value_type = gc_vt_static OR
     is_meta-value_type = gc_m2_vt_ignore.
    RETURN.
  ENDIF.

 "default end-user projection is strictly business-input only.
 "A row that is not marked required is not shown unless an explicit
 "Field Guide contract promotes it to user input. This prevents optional
 "SHDB/DDIC evidence rows from leaking into Mapping/Template without
 "checking any TCODE or field name.
  IF is_map-mandatory <> 'X'
     AND is_meta-metadata_origin <> 'FIELD_GUIDE'.
    RETURN.
  ENDIF.

  IF is_map-mandatory <> 'X'
     AND lv_source CP 'INPUT_*'.
    RETURN.
  ENDIF.

  cv_visible = abap_true.
ENDFORM.

*& User-sourced logical field proof

*& A recorded value is only an example, but a non-technical SCRIPT_CONTRACT
*& source column proves that the logical field was intentionally exposed as
*& user input by onboarding. This helper is generic; it compares logical BDC
*& keys and never branches by TCODE, SAP field name, or source column text.

FORM log_has_user_src
  USING    it_script TYPE ty_t_script
           iv_bdc    TYPE any
  CHANGING cv_has    TYPE abap_bool.

  DATA: ls_script TYPE ty_script_def_compat,
        lv_map    TYPE zbdc_mapping_bup-bdc_field,
        lv_map_l  TYPE zbdc_mapping_bup-bdc_field,
        lv_scr    TYPE zbdc_mapping_bup-bdc_field,
        lv_scr_l  TYPE zbdc_mapping_bup-bdc_field,
        lv_source TYPE zbdc_mapping_bup-source_column.

  CLEAR cv_has.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc
    CHANGING lv_map.
  IF lv_map IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM logical_bdc_key
    USING    lv_map
    CHANGING lv_map_l.
  IF lv_map_l IS INITIAL.
    lv_map_l = lv_map.
  ENDIF.

  LOOP AT it_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL
      AND value_type = gc_vt_dynamic.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_scr.
    PERFORM logical_bdc_key
      USING    lv_scr
      CHANGING lv_scr_l.
    IF lv_scr_l IS INITIAL.
      lv_scr_l = lv_scr.
    ENDIF.
    IF lv_scr_l <> lv_map_l.
      CONTINUE.
    ENDIF.

    CLEAR lv_source.
    PERFORM normalize_mapping_source
      USING    ls_script-source_column
      CHANGING lv_source.
    IF lv_source IS NOT INITIAL.
      cv_has = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Authoritative script user-input projection guard

*& This guard decides whether a Mapping row belongs in the default
*& end-user view/template. It does not know any TCODE, source-column,
*& SAP field, table, object or application term.

*& Rule:
*& BUSINESS_KEY/control rows stay visible only when mandatory.
*& Explicit mandatory business rows stay visible.
*& Non-mandatory rows are visible only when the script proves they are
*& user-sourced input and not a recorded/default/system value.
*& Optional SHDB/DDIC rows remain in repository for audit/runtime but are
*& hidden from the end-user projection.

FORM map_user_input_ok
  USING    it_script TYPE ty_t_script
           is_map    TYPE zbdc_mapping_bup
  CHANGING cv_ok     TYPE abap_bool.

  DATA: lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_has_default TYPE abap_bool,
        lv_default     TYPE string,
        lv_user_src    TYPE abap_bool.

  CLEAR cv_ok.

  PERFORM normalize_mapping_source
    USING    is_map-source_column
    CHANGING lv_source.
  IF lv_source IS INITIAL.
    RETURN.
  ENDIF.

  IF is_map-bdc_field IS INITIAL.
    IF is_map-mandatory = 'X'.
      cv_ok = abap_true.
    ENDIF.
    RETURN.
  ENDIF.

  IF it_script IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_has_default, lv_default.
  PERFORM logical_default_info
    USING    it_script is_map-bdc_field
    CHANGING lv_has_default lv_default.
  IF lv_has_default = abap_true.
    RETURN.
  ENDIF.

  IF is_map-mandatory = 'X'.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  CLEAR lv_user_src.
  PERFORM log_has_user_src
    USING    it_script is_map-bdc_field
    CHANGING lv_user_src.
  IF lv_user_src = abap_true.
    cv_ok = abap_true.
  ENDIF.
ENDFORM.

*& Business Input Contract Authority

*& SHDB is technical evidence only. The end-user field list is authorised
*& by a business-input contract: explicit Field Guide rows first, then a
*& previously ACTIVE mapping for the same TCODE/logical BDC field.
*& This never branches by TCODE, source field name, SAP table, object field,
*& or application document type.

FORM bus_input_auth_ok
  USING    iv_tcode   TYPE any
           iv_profile TYPE any
           iv_ver     TYPE any
           iv_bdc     TYPE any
           iv_source  TYPE any
           iv_staging TYPE any
  CHANGING cv_ok      TYPE abap_bool
           cv_origin  TYPE string.

  DATA: lv_tcode       TYPE zbdc_mapping_bup-tcode,
        lv_profile     TYPE zbdc_mapping_bup-profile_name,
        lv_bdc         TYPE zbdc_mapping_bup-bdc_field,
        lv_logical     TYPE zbdc_mapping_bup-bdc_field,
        lv_src         TYPE zbdc_mapping_bup-source_column,
        lv_guide_src   TYPE zbdc_mapping_bup-source_column,
        lv_map_src     TYPE zbdc_mapping_bup-source_column,
        lv_map_bdc     TYPE zbdc_mapping_bup-bdc_field,
        lv_map_log     TYPE zbdc_mapping_bup-bdc_field,
        lv_contract_ok TYPE abap_bool,
        lv_reason      TYPE string,
        lv_tech        TYPE abap_bool,
        lv_curr_status TYPE zbdc_prof_bup-status,
        lt_script      TYPE ty_t_script,
        lv_script_id   TYPE zbdc_script_bup-script_id,
        lv_hash        TYPE zbdc_script_bup-contract_hash,
        lv_script_ok   TYPE abap_bool,
        lv_user_ok     TYPE abap_bool,
        lv_has_guide   TYPE abap_bool,
        lt_guide       TYPE ty_t_map_meta,
        ls_guide       TYPE ty_map_meta,
        lt_prof        TYPE STANDARD TABLE OF zbdc_prof_bup,
        ls_prof        TYPE zbdc_prof_bup,
        lt_map         TYPE STANDARD TABLE OF zbdc_mapping_bup,
        ls_map         TYPE zbdc_mapping_bup.

  CLEAR: cv_ok, cv_origin.

  lv_tcode = iv_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.
  lv_profile = iv_profile.
  CONDENSE lv_profile.

  PERFORM normalize_mapping_source
    USING    iv_source
    CHANGING lv_src.
  IF lv_src IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc
    CHANGING lv_bdc.

  IF lv_bdc IS INITIAL.
    cv_ok = abap_true.
    cv_origin = 'SYSTEM_CONTROL'.
    RETURN.
  ENDIF.

  PERFORM logical_bdc_key
    USING    lv_bdc
    CHANGING lv_logical.
  IF lv_logical IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM read_mapping_metadata
    USING    lv_tcode lv_profile iv_ver
    CHANGING lt_guide.

  CLEAR lv_has_guide.
  LOOP AT lt_guide INTO ls_guide.
    IF ls_guide-metadata_origin = 'FIELD_GUIDE'.
      lv_has_guide = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

  LOOP AT lt_guide INTO ls_guide
    WHERE metadata_origin = 'FIELD_GUIDE'
      AND bdc_field IS NOT INITIAL
      AND source_column IS NOT INITIAL.

    CLEAR: lv_map_bdc, lv_map_log, lv_guide_src,
           lv_contract_ok, lv_reason, lv_tech.
    PERFORM normalize_mapping_bdc_field
      USING    ls_guide-bdc_field
      CHANGING lv_map_bdc.
    PERFORM logical_bdc_key
      USING    lv_map_bdc
      CHANGING lv_map_log.
    IF lv_map_log <> lv_logical.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_source
      USING    ls_guide-source_column
      CHANGING lv_guide_src.
    IF lv_guide_src <> lv_src.
      CONTINUE.
    ENDIF.

    PERFORM mapping_meta_contract_ok
      USING    ls_guide
      CHANGING lv_contract_ok lv_reason.
    IF lv_contract_ok <> abap_true.
      CONTINUE.
    ENDIF.

    PERFORM mapping_source_is_technical
      USING    lv_guide_src lv_map_bdc
      CHANGING lv_tech.
    IF lv_tech = abap_true.
      CONTINUE.
    ENDIF.

    cv_ok = abap_true.
    cv_origin = 'FIELD_GUIDE'.
    RETURN.
  ENDLOOP.

 "when a Field Guide exists it is the absolute template
 "authority. Rows not present in FIELD_GUIDE may still exist in the
 "replay/mapping repository, but they must not be authorised as business
 "template inputs by CURRENT_PROFILE or ACTIVE fallback logic.
  IF lv_has_guide = abap_true.
    cv_origin = 'FIELD_GUIDE_FILTERED'.
    RETURN.
  ENDIF.

 "a newly onboarded profile has no previous ACTIVE contract yet.
 "For Generate Template / Gmail / Google Drive, the current profile rows
 "that were created from the current SHDB script are also a valid
 "business-input authority. This keeps Import Recording and Start
 "Recording aligned for first-time TCODEs and prevents CSV/XLSX templates
 "from falling back to BUSINESS_KEY only. The rule is generic: it compares
 "the current profile, logical BDC key and source column; no TCODE, SAP
 "field, table, object, or business field name is inspected.
  CLEAR lv_curr_status.
  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_curr_status
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @iv_ver.

  IF sy-subrc = 0 AND
     ( lv_curr_status = gc_m2_prof_draft OR
       lv_curr_status = gc_m2_prof_mapped OR
       lv_curr_status = 'TESTING' OR
       lv_curr_status = gc_m2_prof_active ).

    SELECT * FROM zbdc_mapping_bup
      INTO TABLE @lt_map
      WHERE tcode        = @lv_tcode
        AND profile_name = @lv_profile
        AND profile_ver  = @iv_ver.

    IF lt_map IS NOT INITIAL.
      REFRESH lt_script.
      CLEAR: lv_script_id, lv_hash, lv_script_ok.
      PERFORM load_profile_script
        USING    lv_tcode lv_profile iv_ver
        CHANGING lt_script lv_script_id lv_hash lv_script_ok.

      LOOP AT lt_map INTO ls_map.
        IF ls_map-bdc_field IS INITIAL OR
           ls_map-source_column IS INITIAL.
          CONTINUE.
        ENDIF.

        CLEAR: lv_map_bdc, lv_map_log, lv_map_src, lv_tech, lv_user_ok.
        PERFORM normalize_mapping_bdc_field
          USING    ls_map-bdc_field
          CHANGING lv_map_bdc.
        PERFORM logical_bdc_key
          USING    lv_map_bdc
          CHANGING lv_map_log.
        IF lv_map_log <> lv_logical.
          CONTINUE.
        ENDIF.

        PERFORM normalize_mapping_source
          USING    ls_map-source_column
          CHANGING lv_map_src.
        IF lv_map_src <> lv_src.
          CONTINUE.
        ENDIF.

        PERFORM mapping_source_is_technical
          USING    lv_map_src lv_map_bdc
          CHANGING lv_tech.
        IF lv_tech = abap_true.
          CONTINUE.
        ENDIF.

        IF lv_script_ok = abap_true.
          PERFORM map_user_input_ok
            USING    lt_script ls_map
            CHANGING lv_user_ok.
        ENDIF.

        IF lv_user_ok = abap_true OR ls_map-mandatory = 'X'.
          cv_ok = abap_true.
          cv_origin = 'CURRENT_PROFILE_CONTRACT'.
          RETURN.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

  SELECT * FROM zbdc_prof_bup
    INTO TABLE @lt_prof
    WHERE tcode  = @lv_tcode
      AND status = @gc_m2_prof_active.
  IF lt_prof IS INITIAL.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_mapping_bup
    INTO TABLE @lt_map
    WHERE tcode = @lv_tcode.

  LOOP AT lt_map INTO ls_map.
    IF ls_map-bdc_field IS INITIAL
       OR ls_map-source_column IS INITIAL.
      CONTINUE.
    ENDIF.
    READ TABLE lt_prof INTO ls_prof
      WITH KEY profile_name = ls_map-profile_name
               profile_ver  = ls_map-profile_ver.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    CLEAR: lv_map_bdc, lv_map_log, lv_map_src, lv_tech.
    PERFORM normalize_mapping_bdc_field
      USING    ls_map-bdc_field
      CHANGING lv_map_bdc.
    PERFORM logical_bdc_key
      USING    lv_map_bdc
      CHANGING lv_map_log.
    IF lv_map_log <> lv_logical.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_source
      USING    ls_map-source_column
      CHANGING lv_map_src.
    IF lv_map_src <> lv_src.
      CONTINUE.
    ENDIF.

    PERFORM mapping_source_is_technical
      USING    lv_map_src lv_map_bdc
      CHANGING lv_tech.
    IF lv_tech = abap_true.
      CONTINUE.
    ENDIF.

    cv_ok = abap_true.
    cv_origin = 'ACTIVE_BUSINESS_CONTRACT'.
    RETURN.
  ENDLOOP.
ENDFORM.

*& Stable Business Input Contract lock

*& Recording/Import is technical evidence only. It must not replace the
*& end-user template field list of an existing profile. For an already
*& onboarded profile, the newest previous MAPPED/TESTING/ACTIVE Mapping is
*& the template authority. A newer recording may create script evidence,
*& but it is opened as a candidate only after the consultant deliberately
*& reviews it; Generate Template stays pinned to the stable business input
*& contract. No TCODE, SAP field, source label, table or document type is
*& hardcoded.

FORM find_stable_business_map
  USING    iv_tcode       TYPE any
           iv_profile     TYPE any
           iv_current_ver TYPE any
  CHANGING ct_map         TYPE ty_t_mapping_db
           cv_ver         TYPE zbdc_mapping_bup-profile_ver
           cv_found       TYPE abap_bool.

  DATA: lv_tcode   TYPE zbdc_prof_bup-tcode,
        lv_profile TYPE zbdc_prof_bup-profile_name,
        lt_prof    TYPE STANDARD TABLE OF zbdc_prof_bup,
        ls_prof    TYPE zbdc_prof_bup,
        lt_map     TYPE ty_t_mapping_db.

  REFRESH ct_map.
  CLEAR: cv_ver, cv_found.

  lv_tcode = iv_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.
  lv_profile = iv_profile.
  CONDENSE lv_profile.

  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_prof_bup
    INTO TABLE @lt_prof
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND status      <> 'INACTIVE'.

  IF lt_prof IS INITIAL.
    RETURN.
  ENDIF.

  SORT lt_prof BY profile_ver DESCENDING.

 "Prefer an older stable version so a fresh recording cannot silently
 "insert/remove end-user columns such as optional screen noise.
  LOOP AT lt_prof INTO ls_prof.
    IF ls_prof-profile_ver = iv_current_ver.
      CONTINUE.
    ENDIF.
    IF ls_prof-status <> gc_m2_prof_mapped
       AND ls_prof-status <> 'TESTING'
       AND ls_prof-status <> gc_m2_prof_active.
      CONTINUE.
    ENDIF.

    REFRESH lt_map.
    SELECT * FROM zbdc_mapping_bup
      INTO TABLE @lt_map
      WHERE tcode        = @lv_tcode
        AND profile_name = @lv_profile
        AND profile_ver  = @ls_prof-profile_ver
      ORDER BY staging_field, source_column.

    IF lines( lt_map ) > 1.
      ct_map = lt_map.
      cv_ver = ls_prof-profile_ver.
      cv_found = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.

 "If no previous stable version exists, the current version itself may be
 "the first stable contract for a new TCODE/profile.
  LOOP AT lt_prof INTO ls_prof.
    IF ls_prof-profile_ver <> iv_current_ver.
      CONTINUE.
    ENDIF.
    IF ls_prof-status <> gc_m2_prof_mapped
       AND ls_prof-status <> 'TESTING'
       AND ls_prof-status <> gc_m2_prof_active
       AND ls_prof-status <> gc_m2_prof_draft.
      CONTINUE.
    ENDIF.

    REFRESH lt_map.
    SELECT * FROM zbdc_mapping_bup
      INTO TABLE @lt_map
      WHERE tcode        = @lv_tcode
        AND profile_name = @lv_profile
        AND profile_ver  = @ls_prof-profile_ver
      ORDER BY staging_field, source_column.

    IF lines( lt_map ) > 1.
      ct_map = lt_map.
      cv_ver = ls_prof-profile_ver.
      cv_found = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Business-input Mapping view projection

*& The persistent mapping may keep optional recorded fields for audit and
*& runtime-safe replay. The default Mapping/Profile review screen reads that
*& repository but projects only the same business-input rows that template
*& generation would accept. No TCODE, SAP field, source header, table or
*& object name is hardcoded.

FORM filter_map_bus_view
  USING    iv_tcode   TYPE any
           iv_profile TYPE any
           iv_ver     TYPE any
  CHANGING ct_map     TYPE ty_t_mapping_db.

  DATA: lt_meta       TYPE ty_t_map_meta,
        lt_guide      TYPE ty_t_map_meta,
        lt_view       TYPE ty_t_mapping_db,
        lt_original   TYPE ty_t_mapping_db,
        ls_map        TYPE zbdc_mapping_bup,
        ls_meta       TYPE ty_map_meta,
        ls_guide      TYPE ty_map_meta,
        lv_source     TYPE zbdc_mapping_bup-source_column,
        lv_meta_found TYPE abap_bool,
        lv_guide_found TYPE abap_bool,
        lv_visible    TYPE abap_bool,
        lv_has_guide  TYPE abap_bool,
        lv_contract_ok TYPE abap_bool,
        lv_reason     TYPE string,
        lv_view_count TYPE i,
        lv_input_ok   TYPE abap_bool,
        lt_script     TYPE ty_t_script,
        lv_script_id  TYPE zbdc_script_bup-script_id,
        lv_hash       TYPE zbdc_script_bup-contract_hash,
        lv_script_ok  TYPE abap_bool,
        lv_auth_ok   TYPE abap_bool,
        lv_auth_origin TYPE string,
        lv_z444_tcode   TYPE zbdc_prof_bup-tcode,
        lv_z444_profile TYPE zbdc_prof_bup-profile_name,
        lv_z444_ver     TYPE zbdc_prof_bup-profile_ver.

  IF ct_map IS INITIAL.
    RETURN.
  ENDIF.

  lt_original = ct_map.

 "first read only the maintained business-field guide. If a guide
 "exists for this profile, it is the authoritative user-input projection.
 "Recorded SHDB/DDIC rows remain in the repository but are not shown in the
 "default Mapping/Template view unless the guide classifies them as dynamic
 "business input. This is generic metadata gating, not a TCODE/field list.
  PERFORM read_mapping_metadata
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_guide.

  LOOP AT lt_guide INTO ls_guide.
    IF ls_guide-metadata_origin = 'FIELD_GUIDE'.
      lv_has_guide = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

  lt_meta = lt_guide.
  PERFORM enrich_meta_from_approved_map
    USING    iv_tcode iv_profile
    CHANGING lt_meta.
  PERFORM enrich_meta_from_shdb_ddic
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_meta.

 "z283 is intentionally generic (TYPE ANY), while
 "load_profile_script has a strict DDIC FORM interface. Passing the
 "generic parameters directly can dump with PERFORM_CONFLICT_TYPE on
 "older kernels. Normalize through exact DDIC-typed locals first.
  lv_z444_tcode   = iv_tcode.
  lv_z444_profile = iv_profile.
  lv_z444_ver     = iv_ver.
  TRANSLATE lv_z444_tcode TO UPPER CASE.
  CONDENSE lv_z444_tcode NO-GAPS.
  CONDENSE lv_z444_profile.

  PERFORM load_profile_script
    USING    lv_z444_tcode lv_z444_profile lv_z444_ver
    CHANGING lt_script lv_script_id lv_hash lv_script_ok.

  LOOP AT ct_map INTO ls_map.
    CLEAR: lv_source, ls_meta, ls_guide, lv_meta_found,
           lv_guide_found, lv_visible, lv_contract_ok, lv_reason.

    PERFORM normalize_mapping_source
      USING    ls_map-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_auth_ok, lv_auth_origin.
    PERFORM bus_input_auth_ok
      USING    iv_tcode iv_profile iv_ver
               ls_map-bdc_field lv_source ls_map-staging_field
      CHANGING lv_auth_ok lv_auth_origin.
    IF lv_auth_ok = abap_true.
      IF lv_has_guide = abap_true
         AND lv_auth_origin <> 'FIELD_GUIDE'
         AND ls_map-bdc_field IS NOT INITIAL.
        CONTINUE.
      ENDIF.
      APPEND ls_map TO lt_view.
      CONTINUE.
    ENDIF.

    IF lv_has_guide = abap_true.
      IF ls_map-bdc_field IS INITIAL.
        IF ls_map-mandatory = 'X'.
          APPEND ls_map TO lt_view.
        ENDIF.
        CONTINUE.
      ENDIF.

      PERFORM find_mapping_metadata
        USING    lt_guide ls_map-bdc_field lv_source ls_map-staging_field
        CHANGING ls_guide lv_guide_found.
      IF lv_guide_found = abap_true.
        PERFORM mapping_meta_contract_ok
          USING    ls_guide
          CHANGING lv_contract_ok lv_reason.
        IF lv_contract_ok = abap_true.
          APPEND ls_map TO lt_view.
          CONTINUE.
        ENDIF.
      ENDIF.
 "Incomplete Field Guide metadata is not allowed to erase the default
 "business projection. Fall through to the generic script-based guard.
    ENDIF.

    IF ls_map-bdc_field IS NOT INITIAL.
      PERFORM find_mapping_metadata
        USING    lt_meta ls_map-bdc_field lv_source ls_map-staging_field
        CHANGING ls_meta lv_meta_found.
    ENDIF.

    PERFORM bus_proj_ok
      USING    ls_map ls_meta lv_meta_found
      CHANGING lv_visible.

    IF lv_script_ok = abap_true.
      CLEAR lv_input_ok.
      PERFORM map_user_input_ok
        USING    lt_script ls_map
        CHANGING lv_input_ok.
      IF lv_input_ok = abap_true.
        lv_visible = abap_true.
      ELSEIF ls_map-bdc_field IS NOT INITIAL.
 "The script/user-input guard is authoritative when a
 "loaded script exists. This prevents generated/recorded static
 "rows from leaking merely because a previous draft marked them
 "mandatory. BUSINESS_KEY/control rows are handled by the guard.
        lv_visible = abap_false.
      ENDIF.
    ENDIF.

    IF lv_visible = abap_true.
      APPEND ls_map TO lt_view.
    ENDIF.
  ENDLOOP.

 "this is a view/projection only. Do not restore optional
 "technical rows merely because the projection is small; restoring the
 "repository rows is exactly what made SHDB optional fields leak to the
 "user. Persistence still keeps the full repository outside this view.
  DESCRIBE TABLE lt_view LINES lv_view_count.
  IF lv_has_guide = abap_true.
    ct_map = lt_view.
    PERFORM filter_map_members
      USING    iv_tcode iv_profile iv_ver
      CHANGING ct_map.
    RETURN.
  ENDIF.

  IF lv_view_count > 0.
    ct_map = lt_view.
  ELSE.
    ct_map = lt_original.
  ENDIF.

 "repository/history may enrich metadata, never membership.
  PERFORM filter_map_members
    USING    iv_tcode iv_profile iv_ver
    CHANGING ct_map.
ENDFORM.

*& Form CREATE_MAPPING_DRAFT

*& Create Mapping Draft from imported SHDB Script Definition.

*& Rules:
*& Keep only business input fields
*& Exclude BDC_OKCODE / BDC_CURSOR / BDC_SUBSCR
*& Exclude new-screen control rows
*& Normalize table-control indexes to (*)
*& Remove duplicate BDC fields
*& Create friendly SOURCE_COLUMN draft
*& Keep profile status as DRAFT

*& Generic metadata helpers - no TCODE-specific branches

FORM normalize_mapping_bdc_field
  USING    iv_field TYPE any
  CHANGING cv_field TYPE zbdc_mapping_bup-bdc_field.

  DATA: lv_text TYPE string,
        lv_base TYPE string,
        lv_tail TYPE string.

 "Alias-safe: callers may pass the same actual variable to USING and CHANGING.
 "Copy the input before clearing the output parameter.
  lv_text = iv_field.
  CLEAR cv_field.
  TRANSLATE lv_text TO UPPER CASE.
  CONDENSE lv_text NO-GAPS.

  IF lv_text IS INITIAL.
    RETURN.
  ENDIF.

 "Generic table-control normalization without release-dependent regex.
 "Any terminal/index suffix such as (01), (02), (04), (&IDX&) becomes (*).
  IF lv_text CS '(' AND lv_text CS ')'.
    SPLIT lv_text AT '(' INTO lv_base lv_tail.
    IF lv_base IS NOT INITIAL AND lv_tail CS ')'.
      lv_text = lv_base && '(*)'.
    ENDIF.
  ENDIF.

  cv_field = lv_text.
ENDFORM.

*& Generic logical BDC identity
*& Indexed table-control and unindexed detail-screen occurrences of the
*& same technical SAP field are one logical business input.
*& Example: RV45A-KWMENG(*) and RV45A-KWMENG -> RV45A-KWMENG.
*& No TCODE or business-field name is inspected.

FORM logical_bdc_key
  USING    iv_field TYPE any
  CHANGING cv_key   TYPE zbdc_mapping_bup-bdc_field.

  DATA lv_norm TYPE zbdc_mapping_bup-bdc_field.

  CLEAR cv_key.
  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_norm.
  IF lv_norm IS INITIAL.
    RETURN.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '(*)' IN lv_norm WITH ''.
  cv_key = lv_norm.
ENDFORM.

FORM source_quality
  USING    iv_source TYPE any
           iv_origin TYPE any
  CHANGING cv_score  TYPE i.

  DATA: lv_source TYPE zbdc_mapping_bup-source_column,
        lv_origin TYPE string.

  CLEAR cv_score.
  PERFORM normalize_mapping_source
    USING    iv_source
    CHANGING lv_source.
  IF lv_source IS INITIAL.
    RETURN.
  ENDIF.

  lv_origin = iv_origin.
  TRANSLATE lv_origin TO UPPER CASE.
  CONDENSE lv_origin NO-GAPS.

  IF lv_source CP 'INPUT_*'.
    cv_score = 10.
  ELSE.
    cv_score = 50.
  ENDIF.

  CASE lv_origin.
    WHEN 'FIELD_GUIDE'.
      cv_score = cv_score + 50.
    WHEN 'CERTIFIED_HISTORY'.
      cv_score = cv_score + 45.
    WHEN 'APPROVED_PROFILE'.
      cv_score = cv_score + 40.
    WHEN 'SCRIPT_CONTRACT'.
      cv_score = cv_score + 10.
    WHEN 'SHDB_EVIDENCE'.
      cv_score = cv_score + 20.
    WHEN OTHERS.
      cv_score = cv_score + 10.
  ENDCASE.
ENDFORM.

FORM logical_field_is_dynamic
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_dynamic TYPE abap_bool.

  DATA: ls_script TYPE ty_script_def_compat,
        lv_target TYPE zbdc_mapping_bup-bdc_field,
        lv_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_technical TYPE abap_bool.

  CLEAR cv_dynamic.
  PERFORM logical_bdc_key USING iv_field CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    ls_script-field_name
      CHANGING lv_key.
    IF lv_key = lv_target
       AND ls_script-value_type = gc_vt_dynamic.
      cv_dynamic = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

FORM dynamic_representative
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_bdc    TYPE zbdc_mapping_bup-bdc_field
           cv_found  TYPE abap_bool.

  DATA: ls_script TYPE ty_script_def_compat,
        lv_target TYPE zbdc_mapping_bup-bdc_field,
        lv_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_norm   TYPE zbdc_mapping_bup-bdc_field,
        lv_technical TYPE abap_bool.

  CLEAR: cv_bdc, cv_found.
  PERFORM logical_bdc_key USING iv_field CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL
      AND value_type = gc_vt_dynamic.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key USING ls_script-field_name CHANGING lv_key.
    IF lv_key <> lv_target.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm IS NOT INITIAL.
      cv_bdc = lv_norm.
      cv_found = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

FORM logical_can_remain_static
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_static TYPE abap_bool.

  DATA: ls_script TYPE ty_script_def_compat,
        lv_target TYPE zbdc_mapping_bup-bdc_field,
        lv_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_seen   TYPE abap_bool,
        lv_technical TYPE abap_bool.

  CLEAR cv_static.
  PERFORM logical_bdc_key USING iv_field CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key USING ls_script-field_name CHANGING lv_key.
    IF lv_key <> lv_target.
      CONTINUE.
    ENDIF.

    lv_seen = abap_true.
    IF ls_script-value_type = gc_vt_dynamic
       OR ls_script-source_column IS NOT INITIAL
       OR ls_script-static_value IS INITIAL.
      CLEAR cv_static.
      RETURN.
    ENDIF.
  ENDLOOP.

  IF lv_seen = abap_true.
    cv_static = abap_true.
  ENDIF.
ENDFORM.

FORM logical_default_info
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_has_default TYPE abap_bool
           cv_default     TYPE string.

  DATA: ls_script TYPE ty_script_def_compat,
        lv_target TYPE zbdc_mapping_bup-bdc_field,
        lv_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_norm   TYPE zbdc_mapping_bup-bdc_field,
        lv_alias  TYPE zbdc_mapping_bup-bdc_field,
        lv_alias_has TYPE abap_bool,
        lv_alias_default TYPE string,
        lv_seen_alias TYPE abap_bool,
        lv_technical TYPE abap_bool.
  DATA lt_alias TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                  WITH UNIQUE KEY table_line.

  CLEAR: cv_has_default, cv_default.
  PERFORM logical_bdc_key USING iv_field CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key USING ls_script-field_name CHANGING lv_key.
    IF lv_key <> lv_target.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_bdc_field USING ls_script-field_name CHANGING lv_norm.
    IF lv_norm IS NOT INITIAL.
      INSERT lv_norm INTO TABLE lt_alias.
    ENDIF.
  ENDLOOP.

  LOOP AT lt_alias INTO lv_alias.
    lv_seen_alias = abap_true.
    CLEAR: lv_alias_has, lv_alias_default.
    PERFORM field_default_info
      USING    pt_script lv_alias
      CHANGING lv_alias_has lv_alias_default.
    IF lv_alias_has <> abap_true.
      CLEAR: cv_has_default, cv_default.
      RETURN.
    ENDIF.
    IF cv_default IS INITIAL AND lv_alias_default IS NOT INITIAL.
      cv_default = lv_alias_default.
    ENDIF.
  ENDLOOP.

  IF lv_seen_alias = abap_true.
    cv_has_default = abap_true.
  ENDIF.
ENDFORM.

FORM promote_logical_source
  USING    pt_script   TYPE ty_t_script
           pt_meta     TYPE ty_t_map_meta
           iv_tcode    TYPE any
           iv_logical  TYPE any
           iv_origin   TYPE any
  CHANGING cv_source   TYPE zbdc_mapping_bup-source_column
           cv_staging  TYPE zbdc_mapping_bup-staging_field
           cv_bdc      TYPE zbdc_mapping_bup-bdc_field
           cv_ok       TYPE abap_bool
           cv_message  TYPE string.

  DATA: ls_script TYPE ty_script_def_compat,
        ls_meta   TYPE ty_map_meta,
        ls_auto   TYPE ty_map_meta,
        lv_target TYPE zbdc_mapping_bup-bdc_field,
        lv_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_norm   TYPE zbdc_mapping_bup-bdc_field,
        lv_candidate_source TYPE zbdc_mapping_bup-source_column,
        lv_candidate_staging TYPE zbdc_mapping_bup-staging_field,
        lv_candidate_origin TYPE string,
        lv_found TYPE abap_bool,
        lv_auto_found TYPE abap_bool,
        lv_contract_ok TYPE abap_bool,
        lv_reason TYPE string,
        lv_technical TYPE abap_bool,
        lv_best_score TYPE i,
        lv_candidate_score TYPE i,
        lv_source_tech TYPE abap_bool.
  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                 WITH UNIQUE KEY table_line.

  CLEAR: cv_ok, cv_message.
  PERFORM logical_bdc_key USING iv_logical CHANGING lv_target.
  IF lv_target IS INITIAL.
    cv_message = 'Logical BDC key is empty.'.
    RETURN.
  ENDIF.

  PERFORM source_quality
    USING    cv_source iv_origin
    CHANGING lv_best_score.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key USING ls_script-field_name CHANGING lv_key.
    IF lv_key <> lv_target.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_bdc_field USING ls_script-field_name CHANGING lv_norm.
    IF lv_norm IS INITIAL.
      CONTINUE.
    ENDIF.
    READ TABLE lt_seen WITH TABLE KEY table_line = lv_norm TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT lv_norm INTO TABLE lt_seen.

    CLEAR: ls_meta, ls_auto, lv_found, lv_auto_found,
           lv_contract_ok, lv_reason, lv_candidate_source,
           lv_candidate_staging, lv_candidate_origin,
           lv_candidate_score, lv_source_tech.

    PERFORM find_mapping_metadata
      USING    pt_meta lv_norm space space
      CHANGING ls_meta lv_found.
    IF lv_found = abap_true.
      PERFORM mapping_meta_contract_ok
        USING    ls_meta
        CHANGING lv_contract_ok lv_reason.
      IF lv_contract_ok = abap_true.
        lv_candidate_source  = ls_meta-source_column.
        lv_candidate_staging = ls_meta-staging_field.
        lv_candidate_origin  = ls_meta-metadata_origin.
      ENDIF.
    ENDIF.

    IF lv_candidate_source IS INITIAL.
      PERFORM derive_auto_meta_from_script
        USING    pt_script iv_tcode lv_norm
        CHANGING ls_auto lv_auto_found.
      IF lv_auto_found = abap_true.
        lv_candidate_source  = ls_auto-source_column.
        lv_candidate_staging = ls_auto-staging_field.
        lv_candidate_origin  = ls_auto-metadata_origin.
      ENDIF.
    ENDIF.

    PERFORM normalize_mapping_source
      USING    lv_candidate_source
      CHANGING lv_candidate_source.
    IF lv_candidate_source IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM mapping_source_is_technical
      USING    lv_candidate_source lv_norm
      CHANGING lv_source_tech.
    IF lv_source_tech = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM source_quality
      USING    lv_candidate_source lv_candidate_origin
      CHANGING lv_candidate_score.

    IF lv_candidate_score > lv_best_score.
      cv_source  = lv_candidate_source.
      IF lv_candidate_staging IS NOT INITIAL.
        cv_staging = lv_candidate_staging.
      ENDIF.
      cv_bdc     = lv_norm.
      lv_best_score = lv_candidate_score.
    ELSEIF lv_candidate_score = lv_best_score
       AND lv_candidate_score >= 50
       AND lv_candidate_source <> cv_source.
      cv_message = |AMBIGUOUS_LOGICAL_ALIAS { lv_target }: { cv_source } vs { lv_candidate_source }. Maintain one authoritative metadata source.|.
      RETURN.
    ENDIF.
  ENDLOOP.

  IF cv_source IS INITIAL OR cv_bdc IS INITIAL.
    cv_message = |No safe source could be resolved for logical field { lv_target }.|.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

*& Parameterize one terminal table-control index.
*& Examples: FIELD(01) / FIELD(02) / FIELD(&IDX&) -> FIELD(&IDX&).
*& The helper is generic and never branches by TCODE or business field.

FORM param_script_field_idx
  USING    iv_field TYPE any
  CHANGING cv_field TYPE string
           cv_index TYPE string
           cv_found TYPE abap_bool.

  DATA: lv_text  TYPE string,
        lv_base  TYPE string,
        lv_tail  TYPE string,
        lv_index TYPE string,
        lv_rest  TYPE string.

  CLEAR: cv_field, cv_index, cv_found.
  lv_text = iv_field.
  TRANSLATE lv_text TO UPPER CASE.
  CONDENSE lv_text NO-GAPS.

  IF lv_text IS INITIAL OR lv_text NS '(' OR lv_text NS ')'.
    cv_field = lv_text.
    RETURN.
  ENDIF.

  SPLIT lv_text AT '(' INTO lv_base lv_tail.
  SPLIT lv_tail AT ')' INTO lv_index lv_rest.
  CONDENSE lv_index NO-GAPS.

  IF lv_base IS INITIAL OR lv_index IS INITIAL.
    cv_field = lv_text.
    RETURN.
  ENDIF.

  IF lv_index <> gc_ph_index AND lv_index <> '*'
     AND lv_index CN '0123456789'.
    cv_field = lv_text.
    RETURN.
  ENDIF.

  cv_index = lv_index.
  cv_field = lv_base && '(' && gc_ph_index && ')' && lv_rest.
  cv_found = abap_true.
ENDFORM.

*& Proof that one dynpro segment contains repeatable item rows

*& FIELD(nn) is not item evidence by itself: SAP also uses indexed fields for
*& view/radio/checkbox selection sets. A segment is repeatable inside one PAI
*& only when at least two physical indices carry the same set of at least two
*& distinct mapped DYNAMIC logical fields with the same nontechnical sources.
*& STATIC indexed controls never participate. No TCODE/table/field is hardcoded.

FORM segment_repeatable_proof
  USING    pt_script TYPE ty_t_script
           iv_start  TYPE i
           iv_end    TYPE i
  CHANGING cv_repeat TYPE abap_bool.

  TYPES: BEGIN OF ty_pair,
           idx    TYPE string,
           field  TYPE zbdc_mapping_bup-bdc_field,
           source TYPE zbdc_mapping_bup-source_column,
         END OF ty_pair,
         ty_t_pair TYPE SORTED TABLE OF ty_pair
                   WITH UNIQUE KEY idx field source,
         BEGIN OF ty_sig,
           idx       TYPE string,
           field_cnt TYPE i,
           signature TYPE string,
         END OF ty_sig,
         ty_t_sig TYPE STANDARD TABLE OF ty_sig WITH DEFAULT KEY.

  DATA: lt_pair      TYPE ty_t_pair,
        lt_sig       TYPE ty_t_sig,
        ls_row       TYPE ty_script_def_compat,
        ls_pair      TYPE ty_pair,
        ls_sig       TYPE ty_sig,
        ls_peer      TYPE ty_sig,
        lv_param     TYPE string,
        lv_idx       TYPE string,
        lv_found     TYPE abap_bool,
        lv_norm      TYPE zbdc_mapping_bup-bdc_field,
        lv_logical   TYPE zbdc_mapping_bup-bdc_field,
        lv_source    TYPE zbdc_mapping_bup-source_column,
        lv_technical TYPE abap_bool,
        lv_src_tech  TYPE abap_bool.

  FIELD-SYMBOLS <ls_sig> TYPE ty_sig.

  CLEAR cv_repeat.
  IF iv_start <= 0 OR iv_end < iv_start.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_row FROM iv_start TO iv_end.
    IF ls_row-is_new_screen = 'X'
       OR ls_row-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

 "repeatability is business-plan evidence, not raw screen shape.
 "Count only fields already proven DYNAMIC by Mapping. 's comment
 "always required DYNAMIC logical fields, but the old implementation also
 "counted STATIC indexed controls. A screen with one mapped value plus
 "checkbox/view-selection fields could therefore be miscompiled as ITEM.
    IF ls_row-value_type <> gc_vt_dynamic
       OR ls_row-source_column IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR lv_technical.
    PERFORM mapping_field_is_technical
      USING    ls_row-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR: lv_param, lv_idx, lv_found, lv_norm, lv_logical,
           lv_source, lv_src_tech.
    PERFORM param_script_field_idx
      USING    ls_row-field_name
      CHANGING lv_param lv_idx lv_found.
    IF lv_found <> abap_true
       OR lv_idx IS INITIAL
       OR lv_idx = gc_ph_index
       OR lv_idx = '*'
       OR lv_idx CN '0123456789'.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    lv_param
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_logical.
    PERFORM normalize_mapping_source
      USING    ls_row-source_column
      CHANGING lv_source.
    IF lv_logical IS INITIAL OR lv_source IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM mapping_source_is_technical
      USING    lv_source lv_norm
      CHANGING lv_src_tech.
    IF lv_src_tech = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR ls_pair.
    ls_pair-idx    = lv_idx.
    ls_pair-field  = lv_logical.
    ls_pair-source = lv_source.
    INSERT ls_pair INTO TABLE lt_pair.
  ENDLOOP.

  IF lt_pair IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_pair INTO ls_pair.
    READ TABLE lt_sig ASSIGNING <ls_sig> WITH KEY idx = ls_pair-idx.
    IF sy-subrc <> 0.
      CLEAR ls_sig.
      ls_sig-idx = ls_pair-idx.
      APPEND ls_sig TO lt_sig.
      READ TABLE lt_sig ASSIGNING <ls_sig> WITH KEY idx = ls_pair-idx.
    ENDIF.
    IF <ls_sig> IS ASSIGNED.
      <ls_sig>-field_cnt = <ls_sig>-field_cnt + 1.
      CONCATENATE <ls_sig>-signature '|' ls_pair-field '=' ls_pair-source
        INTO <ls_sig>-signature.
    ENDIF.
  ENDLOOP.

  LOOP AT lt_sig INTO ls_sig WHERE field_cnt >= 2.
    LOOP AT lt_sig INTO ls_peer WHERE field_cnt >= 2.
      IF ls_peer-idx = ls_sig-idx.
        CONTINUE.
      ENDIF.
      IF ls_peer-signature = ls_sig-signature.
        cv_repeat = abap_true.
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDLOOP.
ENDFORM.

*& Detect fixed indexed selection sets

*& If one logical field appears at several physical indices in one dynpro PAI
*& but the segment is not proven repeatable, it is profile-owned SAP GUI
*& selection evidence, not one per-record template value. Exact captured
*& FIELD(01)/(02)/... values remain STATIC and are replayed unchanged.

*& Build one canonical ITEM prototype from proven business evidence.

*& SHDB may contain item 01, item 02, ... because the consultant touched
*& several table rows while recording. M3_EXEC already repeats CT_ITEM for
*& every staging row. Keeping every physical SHDB row would therefore replay
*& item 01 + item 02 for every staging item.

*& Generic rule:
*& split the script into dynpro segments;
*& identify segments by dynamic indexed field signature + screen + OKCODE;
*& when the same signature appears with another physical row index, keep
*& the first prototype and remove the later physical-row duplicate;
*& parameterize every indexed field in the retained prototype with &IDX&.

*& Repeated interactions on the SAME physical index are preserved. Different
*& screens, OKCODEs or dynamic signatures are also preserved.

FORM canon_item_prototypes
  CHANGING ct_script TYPE ty_t_script.

  TYPES: BEGIN OF ty_segment,
           seg_no            TYPE i,
           start_index       TYPE i,
           end_index         TYPE i,
           program_name      TYPE ty_script_def_compat-program_name,
           dynpro_no         TYPE ty_script_def_compat-dynpro_no,
           okcode_signature  TYPE string,
           field_signature   TYPE string,
           physical_index    TYPE string,
           has_dynamic_index TYPE abap_bool,
           field_count       TYPE i,
           index_count       TYPE i,
           repeatable_proven TYPE abap_bool,
           drop_segment      TYPE abap_bool,
         END OF ty_segment.
  TYPES ty_t_segment TYPE STANDARD TABLE OF ty_segment WITH DEFAULT KEY.
  TYPES ty_t_field_key TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
        WITH UNIQUE KEY table_line.
  TYPES ty_t_index_key TYPE SORTED TABLE OF string
        WITH UNIQUE KEY table_line.

  DATA: lt_segments TYPE ty_t_segment,
        lt_rebuilt  TYPE ty_t_script,
        lt_fields   TYPE ty_t_field_key,
        lt_indexes  TYPE ty_t_index_key,
        ls_segment  TYPE ty_segment,
        ls_previous TYPE ty_segment,
        ls_row      TYPE ty_script_def_compat,
        lv_seg_no   TYPE i,
        lv_start    TYPE i,
        lv_lines    TYPE i,
        lv_norm     TYPE zbdc_mapping_bup-bdc_field,
        lv_source   TYPE zbdc_mapping_bup-source_column,
        lv_src_tech TYPE abap_bool,
        lv_field    TYPE string,
        lv_index    TYPE string,
        lv_found    TYPE abap_bool,
        lv_token    TYPE string,
        lv_seq      TYPE ty_script_def_compat-step_seq,
        lv_repeat   TYPE abap_bool.

  FIELD-SYMBOLS: <ls_segment> TYPE ty_segment,
                 <ls_peer>    TYPE ty_segment.

  DESCRIBE TABLE ct_script LINES lv_lines.
  IF lv_lines = 0.
    RETURN.
  ENDIF.

 "First pass: exact dynpro segment boundaries.
  CLEAR: lv_seg_no, lv_start.
  LOOP AT ct_script INTO ls_row.
    IF ls_row-is_new_screen = 'X'.
      IF lv_start > 0.
        CLEAR ls_segment.
        ls_segment-seg_no      = lv_seg_no.
        ls_segment-start_index = lv_start.
        ls_segment-end_index   = sy-tabix - 1.
        APPEND ls_segment TO lt_segments.
      ENDIF.
      lv_seg_no = lv_seg_no + 1.
      lv_start  = sy-tabix.
    ENDIF.
  ENDLOOP.
  IF lv_start > 0.
    CLEAR ls_segment.
    ls_segment-seg_no      = lv_seg_no.
    ls_segment-start_index = lv_start.
    ls_segment-end_index   = lv_lines.
    APPEND ls_segment TO lt_segments.
  ENDIF.
  IF lt_segments IS INITIAL.
    RETURN.
  ENDIF.

 "Second pass: collect indexed DYNAMIC evidence without mutating a field.
  LOOP AT lt_segments ASSIGNING <ls_segment>.
    REFRESH: lt_fields, lt_indexes.
    CLEAR: <ls_segment>-okcode_signature,
           <ls_segment>-field_signature,
           <ls_segment>-physical_index,
           <ls_segment>-has_dynamic_index,
           <ls_segment>-field_count,
           <ls_segment>-index_count,
           <ls_segment>-repeatable_proven,
           <ls_segment>-drop_segment.

    LOOP AT ct_script INTO ls_row
      FROM <ls_segment>-start_index TO <ls_segment>-end_index.
      IF sy-tabix = <ls_segment>-start_index.
        <ls_segment>-program_name = ls_row-program_name.
        <ls_segment>-dynpro_no    = ls_row-dynpro_no.
      ENDIF.
      IF ls_row-field_name = 'BDC_OKCODE'.
        lv_token = ls_row-static_value.
        CONDENSE lv_token NO-GAPS.
        CONCATENATE <ls_segment>-okcode_signature '|' lv_token
          INTO <ls_segment>-okcode_signature.
      ENDIF.
      IF ls_row-value_type <> gc_vt_dynamic
         OR ls_row-source_column IS INITIAL.
        CONTINUE.
      ENDIF.

 "compiler evidence must be a mapped business input. Internal
 "aliases/technical sources and already-parameterized placeholders are
 "not allowed to bootstrap repeatability.
      CLEAR: lv_source, lv_src_tech.
      PERFORM normalize_mapping_source
        USING    ls_row-source_column
        CHANGING lv_source.
      IF lv_source IS INITIAL.
        CONTINUE.
      ENDIF.
      PERFORM mapping_source_is_technical
        USING    lv_source ls_row-field_name
        CHANGING lv_src_tech.
      IF lv_src_tech = abap_true.
        CONTINUE.
      ENDIF.

      PERFORM param_script_field_idx
        USING    ls_row-field_name
        CHANGING lv_field lv_index lv_found.
      IF lv_found <> abap_true
         OR lv_index IS INITIAL
         OR lv_index = gc_ph_index
         OR lv_index = '*'
         OR lv_index CN '0123456789'.
        CONTINUE.
      ENDIF.
      PERFORM normalize_mapping_bdc_field
        USING    ls_row-field_name
        CHANGING lv_norm.
      IF lv_norm IS NOT INITIAL.
        INSERT lv_norm INTO TABLE lt_fields.
      ENDIF.
      INSERT lv_index INTO TABLE lt_indexes.
    ENDLOOP.

    IF lt_fields IS INITIAL.
      CONTINUE.
    ENDIF.

    <ls_segment>-has_dynamic_index = abap_true.
    LOOP AT lt_fields INTO lv_norm.
      CONCATENATE <ls_segment>-field_signature '|' lv_norm
        INTO <ls_segment>-field_signature.
    ENDLOOP.
    DESCRIBE TABLE lt_fields  LINES <ls_segment>-field_count.
    DESCRIBE TABLE lt_indexes LINES <ls_segment>-index_count.
    IF <ls_segment>-index_count = 1.
      READ TABLE lt_indexes INTO <ls_segment>-physical_index INDEX 1.
    ELSE.
      <ls_segment>-physical_index = '?'.
    ENDIF.

    CLEAR lv_repeat.
    PERFORM segment_repeatable_proof
      USING    ct_script <ls_segment>-start_index <ls_segment>-end_index
      CHANGING lv_repeat.
    <ls_segment>-repeatable_proven = lv_repeat.
  ENDLOOP.

 "repeated PAI segments are only a secondary structural proof.
 "Each candidate segment already contains >=2 mapped nontechnical DYNAMIC
 "fields because the collection pass above excludes STATIC/control evidence.
 "This prevents SAP selection/view controls from manufacturing an ITEM block.
  LOOP AT lt_segments ASSIGNING <ls_segment>
    WHERE has_dynamic_index = abap_true
      AND repeatable_proven IS INITIAL
      AND index_count = 1
      AND field_count >= 2.
    LOOP AT lt_segments ASSIGNING <ls_peer>
      WHERE has_dynamic_index = abap_true
        AND index_count = 1
        AND field_count >= 2.
      IF <ls_peer>-seg_no = <ls_segment>-seg_no
         OR <ls_peer>-physical_index IS INITIAL
         OR <ls_segment>-physical_index IS INITIAL
         OR <ls_peer>-physical_index = <ls_segment>-physical_index.
        CONTINUE.
      ENDIF.
      IF <ls_peer>-program_name = <ls_segment>-program_name
         AND <ls_peer>-dynpro_no = <ls_segment>-dynpro_no
         AND <ls_peer>-okcode_signature = <ls_segment>-okcode_signature
         AND <ls_peer>-field_signature = <ls_segment>-field_signature.
        <ls_segment>-repeatable_proven = abap_true.
        <ls_peer>-repeatable_proven    = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.
  ENDLOOP.

 "Collapse only later physical rows of a PROVEN repeatable prototype.
  LOOP AT lt_segments ASSIGNING <ls_segment>
    WHERE repeatable_proven = abap_true
      AND index_count = 1.
    LOOP AT lt_segments INTO ls_previous.
      IF ls_previous-seg_no >= <ls_segment>-seg_no.
        EXIT.
      ENDIF.
      IF ls_previous-repeatable_proven <> abap_true
         OR ls_previous-drop_segment = abap_true
         OR ls_previous-index_count <> 1
         OR ls_previous-physical_index IS INITIAL
         OR ls_previous-physical_index = <ls_segment>-physical_index.
        CONTINUE.
      ENDIF.
      IF ls_previous-program_name = <ls_segment>-program_name
         AND ls_previous-dynpro_no = <ls_segment>-dynpro_no
         AND ls_previous-okcode_signature = <ls_segment>-okcode_signature
         AND ls_previous-field_signature = <ls_segment>-field_signature.
        <ls_segment>-drop_segment = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.
  ENDLOOP.

 "Final pass: only proven item fields become FIELD(&IDX&). Unproven raw
 "indices remain exactly as SAP recorded them.
  REFRESH lt_rebuilt.
  CLEAR: lv_seg_no, lv_seq.
  LOOP AT ct_script INTO ls_row.
    IF ls_row-is_new_screen = 'X'.
      lv_seg_no = lv_seg_no + 1.
    ENDIF.
    CLEAR ls_segment.
    READ TABLE lt_segments INTO ls_segment WITH KEY seg_no = lv_seg_no.
    IF sy-subrc = 0 AND ls_segment-drop_segment = abap_true.
      CONTINUE.
    ENDIF.
    IF sy-subrc = 0
       AND ls_segment-repeatable_proven = abap_true
       AND ls_row-field_name IS NOT INITIAL.
      PERFORM param_script_field_idx
        USING    ls_row-field_name
        CHANGING lv_field lv_index lv_found.
      IF lv_found = abap_true.
        ls_row-field_name = lv_field.
      ENDIF.
    ENDIF.
    lv_seq = lv_seq + 10.
    ls_row-step_seq = lv_seq.
    APPEND ls_row TO lt_rebuilt.
  ENDLOOP.
  ct_script = lt_rebuilt.
ENDFORM.

FORM normalize_mapping_source
  USING    iv_source TYPE any
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column.

  DATA: lv_text TYPE string,
        lv_out  TYPE string,
        lv_char TYPE c LENGTH 1,
        lv_prev TYPE c LENGTH 1,
        lv_len  TYPE i,
        lv_off  TYPE i.

 "Alias-safe: CREATE_MAPPING_DRAFT intentionally normalizes in place.
 "Copy the input before clearing the CHANGING parameter, otherwise calls
 "such as USING lv_source CHANGING lv_source erase the source value.
  lv_text = iv_source.
  CLEAR cv_source.
  TRANSLATE lv_text TO UPPER CASE.
  CONDENSE lv_text.

  IF lv_text IS INITIAL.
    RETURN.
  ENDIF.

 "Build a stable CSV/header identifier. Work in STRING so trailing blanks
 "of CHAR DDIC fields never become underscores.
  lv_len = strlen( lv_text ).
  DO lv_len TIMES.
    lv_off  = sy-index - 1.
    lv_char = lv_text+lv_off(1).

    IF lv_char CO 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'.
 "Keep supported identifier characters.
    ELSE.
      lv_char = '_'.
    ENDIF.

    IF lv_char = '_' AND lv_prev = '_'.
      CONTINUE.
    ENDIF.

    lv_out = lv_out && lv_char.
    lv_prev = lv_char.
  ENDDO.

  WHILE lv_out CP '_*'.
    SHIFT lv_out LEFT BY 1 PLACES.
  ENDWHILE.

  WHILE lv_out IS NOT INITIAL.
    lv_len = strlen( lv_out ).
    lv_off = lv_len - 1.
    IF lv_out+lv_off(1) = '_'.
      lv_out = lv_out(lv_off).
    ELSE.
      EXIT.
    ENDIF.
  ENDWHILE.

  cv_source = lv_out.
ENDFORM.

FORM mapping_source_is_technical
  USING    iv_source TYPE any
           iv_bdc    TYPE any
  CHANGING cv_technical TYPE abap_bool.

  DATA: lv_source    TYPE zbdc_mapping_bup-source_column,
        lv_bdc_norm  TYPE zbdc_mapping_bup-bdc_field,
        lv_leaf      TYPE string,
        lv_leaf_norm TYPE zbdc_mapping_bup-source_column,
        lt_parts     TYPE string_table,
        lv_lines     TYPE sy-tabix,
        lv_length    TYPE i.

  CLEAR cv_technical.

  PERFORM normalize_mapping_source
    USING    iv_source
    CHANGING lv_source.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc
    CHANGING lv_bdc_norm.

  IF lv_source IS INITIAL.
    cv_technical = abap_true.
    RETURN.
  ENDIF.

 "INPUT_* is an internal fallback namespace, never an end-user
 "business column. Earlier rescue/history logic could persist INPUT_<BDC>
 "and later classifiers treated it as approved metadata, creating a feedback
 "loop across Import and Start Recording. Classify it as technical at the
 "single shared source predicate so every acquisition adapter behaves alike.
  IF lv_source CP 'INPUT_*'.
    cv_technical = abap_true.
    RETURN.
  ENDIF.

  IF lv_source CP 'FIELD*'
     OR lv_source CP 'BDC_*'
     OR lv_source CP 'DYN_*'
     OR lv_source CP 'CHAR*'
     OR lv_source CP 'COLUMN_*'.
    cv_technical = abap_true.
    RETURN.
  ENDIF.

  lv_leaf = lv_bdc_norm.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_leaf WITH ''.

  REFRESH lt_parts.
  SPLIT lv_leaf AT '-' INTO TABLE lt_parts.
  DESCRIBE TABLE lt_parts LINES lv_lines.
  IF lv_lines > 1.
    READ TABLE lt_parts INTO lv_leaf INDEX lv_lines.
  ENDIF.

  PERFORM normalize_mapping_source
    USING    lv_leaf
    CHANGING lv_leaf_norm.

 "Short raw SAP component names are not suitable end-user headers.
 "Semantic component names such as PO_NUMBER remain valid.
  lv_length = strlen( lv_source ).
  IF lv_source = lv_leaf_norm
     AND lv_length <= 5
     AND lv_source NS '_'.
    cv_technical = abap_true.
  ENDIF.
ENDFORM.

FORM mapping_field_is_technical
  USING    iv_field TYPE any
  CHANGING cv_technical TYPE abap_bool.

  DATA lv_field TYPE zbdc_mapping_bup-bdc_field.

  CLEAR cv_technical.
  PERFORM normalize_mapping_bdc_field USING iv_field CHANGING lv_field.

  IF lv_field IS INITIAL
     OR lv_field CP 'BDC_*'
     OR lv_field CP 'DYN_*'.
    cv_technical = abap_true.
  ENDIF.
ENDFORM.

FORM get_mapping_staging_slots
  CHANGING ct_slots TYPE ty_t_map_staging_slot.

  STATICS gt_slots TYPE ty_t_map_staging_slot.

  DATA: lt_dfies  TYPE STANDARD TABLE OF dfies,
        ls_dfies  TYPE dfies,
        lv_name   TYPE string,
        lv_suffix TYPE string,
        lv_slot   TYPE zbdc_mapping_bup-staging_field.

  REFRESH ct_slots.

  IF gt_slots IS INITIAL.
    CALL FUNCTION 'DDIF_FIELDINFO_GET'
      EXPORTING
        tabname        = 'ZBDC_STAGING_BUP'
        langu          = sy-langu
        all_types      = abap_true
      TABLES
        dfies_tab      = lt_dfies
      EXCEPTIONS
        not_found      = 1
        internal_error = 2
        OTHERS         = 3.

    IF sy-subrc = 0.
      LOOP AT lt_dfies INTO ls_dfies.
        lv_name = ls_dfies-fieldname.
        TRANSLATE lv_name TO UPPER CASE.
        CONDENSE lv_name NO-GAPS.

        IF lv_name NP 'FIELD*'.
          CONTINUE.
        ENDIF.

        IF strlen( lv_name ) <= 5.
          CONTINUE.
        ENDIF.

        lv_suffix = lv_name+5.
        IF lv_suffix IS INITIAL OR lv_suffix CN '0123456789'.
          CONTINUE.
        ENDIF.

        lv_slot = lv_name.
        INSERT lv_slot INTO TABLE gt_slots.
      ENDLOOP.
    ENDIF.
  ENDIF.

  ct_slots = gt_slots.
ENDFORM.

FORM mapping_staging_field_exists
  USING    iv_field TYPE any
  CHANGING cv_exists TYPE abap_bool.

  DATA: lt_slots TYPE ty_t_map_staging_slot,
        lv_field TYPE zbdc_mapping_bup-staging_field.

  CLEAR cv_exists.

  lv_field = iv_field.
  TRANSLATE lv_field TO UPPER CASE.
  CONDENSE lv_field NO-GAPS.
  IF lv_field IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_mapping_staging_slots CHANGING lt_slots.
  READ TABLE lt_slots WITH TABLE KEY table_line = lv_field
    TRANSPORTING NO FIELDS.
  IF sy-subrc = 0.
    cv_exists = abap_true.
  ENDIF.
ENDFORM.

FORM resolve_mapping_config_context
  CHANGING cv_tcode   TYPE zbdc_mapping_bup-tcode
           cv_profile TYPE zbdc_mapping_bup-profile_name
           cv_ver     TYPE zbdc_mapping_bup-profile_ver
           cv_ok      TYPE abap_bool.

  DATA: lv_ctx_ok    TYPE abap_bool,
        lv_ctx_msg   TYPE string,
        lt_script    TYPE ty_t_script,
        lv_script_id TYPE zbdc_script_bup-script_id,
        lv_hash      TYPE zbdc_script_bup-contract_hash,
        lv_loaded    TYPE abap_bool.

  CLEAR: cv_tcode, cv_profile, cv_ver, cv_ok.

 "Navigation never invents a profile/version and never selects an ACTIVE or
 "latest fallback. A partial screen state may resolve only when the registry
 "contains one unambiguous exact tuple.
  PERFORM resolve_exact_map_ctx
    CHANGING lv_ctx_ok lv_ctx_msg.
  IF lv_ctx_ok <> abap_true.
    IF lv_ctx_msg IS INITIAL.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '862' INTO lv_ctx_msg.
    ENDIF.
    PERFORM userize_ui_message USING lv_ctx_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  cv_tcode = p_rec_tcode.
  cv_profile = txtp_profile_name.
  cv_ver     = gv_profile_ver.
  TRANSLATE cv_tcode TO UPPER CASE.
  CONDENSE cv_tcode NO-GAPS.
  CONDENSE cv_profile.

  IF cv_tcode IS INITIAL OR cv_profile IS INITIAL OR cv_ver IS INITIAL.
    MESSAGE s712(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "Resolve and verify one immutable Script ID/Hash for the exact tuple.
  PERFORM resolve_map_tuple_script
    USING    cv_tcode cv_profile cv_ver
    CHANGING lt_script lv_script_id lv_hash lv_loaded lv_ctx_msg.
  IF lv_loaded <> abap_true OR lt_script IS INITIAL
     OR lv_script_id IS INITIAL OR lv_hash IS INITIAL.
    MESSAGE s713(zbdc)
      WITH cv_tcode cv_profile cv_ver
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF gv_runtime_script_id IS NOT INITIAL
     AND gv_runtime_script_id <> lv_script_id.
    MESSAGE s714(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.
  IF gv_runtime_contract_hash IS NOT INITIAL
     AND gv_runtime_contract_hash <> lv_hash.
    MESSAGE s715(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  p_rec_tcode              = cv_tcode.
  p_transaction            = cv_tcode.
  txtp_profile_name        = cv_profile.
  gv_profile_ver           = cv_ver.
  gv_runtime_script_id     = lv_script_id.
  gv_runtime_contract_hash = lv_hash.
  gt_script_def            = lt_script.
  cv_ok = abap_true.
ENDFORM.

*& Exact Mapping context resolver
*& Preserves a valid exact TCODE/Profile/Version. Never selects global MAX.
*& A partial context is resolved only when it has exactly one unambiguous
*& candidate. No database row is created from PBO/navigation.

FORM resolve_exact_map_ctx
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_tcode     TYPE zbdc_prof_bup-tcode,
        lv_profile   TYPE zbdc_prof_bup-profile_name,
        lv_ver       TYPE zbdc_prof_bup-profile_ver,
        lt_prof      TYPE STANDARD TABLE OF zbdc_prof_bup,
        ls_prof      TYPE zbdc_prof_bup,
        lt_script    TYPE ty_t_script,
        lv_script_id TYPE zbdc_script_bup-script_id,
        lv_hash      TYPE zbdc_script_bup-contract_hash,
        lv_found     TYPE abap_bool,
        lv_count     TYPE i,
        lv_origin    TYPE c LENGTH 20,
        ls_cand_ctx  TYPE zbdc_mapping_bup,
        ls_raw_ctx   TYPE ty_script_def_compat.

  CLEAR: cv_ok, cv_message.

 "while a fresh RAW Candidate Mapping is open, that in-memory
 "candidate is the exact screen context. PBO/navigation must not resolve an
 "older persisted tuple and overwrite TCODE/Profile/Version before Generate
 "Template. The candidate is accepted only when its TCODE agrees with the
 "current immutable RAW evidence.
  CLEAR lv_origin.
  PERFORM get_projection_origin CHANGING lv_origin.
  IF gv_z240_map_locked = abap_true
     AND gt_mapping_screen IS NOT INITIAL
     AND gt_z333_rec_evidence IS NOT INITIAL
     AND ( lv_origin = 'GUIDED_RECORD'
        OR lv_origin = 'SHDB_TXT'
        OR lv_origin = 'SHDB_PROGRAM' ).
    CLEAR: ls_cand_ctx, ls_raw_ctx.
    READ TABLE gt_mapping_screen INTO ls_cand_ctx INDEX 1.
    LOOP AT gt_z333_rec_evidence INTO ls_raw_ctx
      WHERE tcode IS NOT INITIAL.
      EXIT.
    ENDLOOP.

    IF ls_cand_ctx-tcode IS INITIAL
       OR ls_cand_ctx-profile_name IS INITIAL
       OR ls_raw_ctx-tcode IS INITIAL
       OR ls_cand_ctx-tcode <> ls_raw_ctx-tcode.
      cv_message =
        'FRESH_MAPPING_CONTEXT_MISMATCH: Candidate Mapping no longer matches the current RAW recording; reopen Mapping Profile from the current import/recording.'.
      RETURN.
    ENDIF.

    p_rec_tcode       = ls_cand_ctx-tcode.
    p_transaction     = ls_cand_ctx-tcode.
    txtp_profile_name = ls_cand_ctx-profile_name.
    gv_profile_ver    = ls_cand_ctx-profile_ver.
    cv_ok = abap_true.
    cv_message = 'Fresh Candidate Mapping context is pinned to the current RAW recording.'.
    RETURN.
  ENDIF.

  lv_tcode = p_rec_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.
  lv_profile = txtp_profile_name.
  CONDENSE lv_profile.
  lv_ver = gv_profile_ver.

  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL OR lv_ver IS INITIAL
     OR gv_runtime_script_id IS INITIAL
     OR gv_runtime_contract_hash IS INITIAL.
    cv_message = 'Select one exact Import/Guided contract before opening Mapping Profile.'.
    RETURN.
  ENDIF.

 "An exact screen context is preserved only when both Profile and immutable
 "Script identities resolve without ordering or latest-version assumptions.
  IF lv_tcode IS NOT INITIAL AND lv_profile IS NOT INITIAL
     AND lv_ver IS NOT INITIAL.
    SELECT SINGLE * FROM zbdc_prof_bup
      INTO @ls_prof
      WHERE tcode        = @lv_tcode
        AND profile_name = @lv_profile
        AND profile_ver  = @lv_ver.
    IF sy-subrc <> 0.
      CONCATENATE 'Exact profile' lv_tcode '/' lv_profile 'v' lv_ver
        'is not registered.'
        INTO cv_message SEPARATED BY space.
      RETURN.
    ENDIF.

    PERFORM resolve_map_tuple_script
      USING    lv_tcode lv_profile lv_ver
      CHANGING lt_script lv_script_id lv_hash lv_found cv_message.
    IF lv_found <> abap_true.
      RETURN.
    ENDIF.

    IF gv_runtime_script_id IS NOT INITIAL
       AND gv_runtime_script_id <> lv_script_id.
      cv_message = 'Mapping context conflicts with the immutable Script ID returned by onboarding.'.
      RETURN.
    ENDIF.
    IF gv_runtime_contract_hash IS NOT INITIAL
       AND gv_runtime_contract_hash <> lv_hash.
      cv_message = 'Mapping context conflicts with the immutable contract hash returned by onboarding.'.
      RETURN.
    ENDIF.

  ELSE.
 "A partial context is resolved only if one non-INACTIVE Profile tuple
 "exists. No ACTIVE preference, maximum version or name invention is used.
    IF lv_tcode IS NOT INITIAL AND lv_profile IS NOT INITIAL.
      SELECT * FROM zbdc_prof_bup INTO TABLE @lt_prof
        WHERE tcode = @lv_tcode AND profile_name = @lv_profile.
    ELSEIF lv_tcode IS NOT INITIAL.
      SELECT * FROM zbdc_prof_bup INTO TABLE @lt_prof
        WHERE tcode = @lv_tcode.
    ELSEIF lv_profile IS NOT INITIAL.
      SELECT * FROM zbdc_prof_bup INTO TABLE @lt_prof
        WHERE profile_name = @lv_profile.
    ELSE.
      cv_message = 'No TCODE/Profile context is selected. Select or record a scenario first.'.
      RETURN.
    ENDIF.

    DELETE lt_prof WHERE status = 'INACTIVE'.
    SORT lt_prof BY tcode profile_name profile_ver.
    DELETE ADJACENT DUPLICATES FROM lt_prof COMPARING tcode profile_name profile_ver.
    lv_count = lines( lt_prof ).
    IF lv_count <> 1.
      IF lv_count = 0.
        cv_message = 'No registered profile matches the selected Mapping context.'.
      ELSE.
        cv_message = 'Select one exact Import/Guided contract before opening Mapping Profile.'.
      ENDIF.
      RETURN.
    ENDIF.

    READ TABLE lt_prof INTO ls_prof INDEX 1.
    lv_tcode   = ls_prof-tcode.
    lv_profile = ls_prof-profile_name.
    lv_ver     = ls_prof-profile_ver.

    PERFORM resolve_map_tuple_script
      USING    lv_tcode lv_profile lv_ver
      CHANGING lt_script lv_script_id lv_hash lv_found cv_message.
    IF lv_found <> abap_true.
      RETURN.
    ENDIF.
  ENDIF.

  p_rec_tcode              = lv_tcode.
  p_transaction            = lv_tcode.
  txtp_profile_name        = lv_profile.
  gv_profile_ver           = lv_ver.
  gv_runtime_script_id     = lv_script_id.
  gv_runtime_contract_hash = lv_hash.
  gt_script_def            = lt_script.
  cv_ok = abap_true.
  CONCATENATE 'Exact Mapping context' lv_tcode '/' lv_profile 'v' lv_ver
    'is ready.'
    INTO cv_message SEPARATED BY space.
ENDFORM.

"Compatibility entry used by existing I01/O01. Despite the historical name,
"does not select a latest/global MAX version.
FORM get_mapping_meta_component
  USING    is_row   TYPE any
           iv_name1 TYPE csequence
           iv_name2 TYPE csequence
           iv_name3 TYPE csequence
  CHANGING cv_value TYPE string
           cv_found TYPE abap_bool.

  FIELD-SYMBOLS <lv_any> TYPE any.

  CLEAR: cv_value, cv_found.

  IF iv_name1 IS NOT INITIAL.
    ASSIGN COMPONENT iv_name1 OF STRUCTURE is_row TO <lv_any>.
    IF sy-subrc = 0.
      cv_value = <lv_any>.
      cv_found = abap_true.
      RETURN.
    ENDIF.
  ENDIF.

  IF iv_name2 IS NOT INITIAL.
    ASSIGN COMPONENT iv_name2 OF STRUCTURE is_row TO <lv_any>.
    IF sy-subrc = 0.
      cv_value = <lv_any>.
      cv_found = abap_true.
      RETURN.
    ENDIF.
  ENDIF.

  IF iv_name3 IS NOT INITIAL.
    ASSIGN COMPONENT iv_name3 OF STRUCTURE is_row TO <lv_any>.
    IF sy-subrc = 0.
      cv_value = <lv_any>.
      cv_found = abap_true.
      RETURN.
    ENDIF.
  ENDIF.
ENDFORM.

FORM mapping_meta_contract_ok
  USING    is_meta TYPE ty_map_meta
  CHANGING cv_ok   TYPE abap_bool
           cv_reason TYPE string.

  CLEAR: cv_ok, cv_reason.

  IF is_meta-source_column IS INITIAL.
    cv_reason = 'SOURCE_COLUMN is missing in Field Guide metadata.'.
    RETURN.
  ENDIF.

  IF is_meta-display_label IS INITIAL.
    cv_reason = 'DISPLAY_LABEL is missing in Field Guide metadata.'.
    RETURN.
  ENDIF.

 "Required is derived automatically from the imported SHDB contract.
 "Field Guide metadata may enrich labels and rules, but it is not a
 "manual prerequisite for end-user template generation.

  IF is_meta-value_type = gc_vt_static.
    cv_reason = 'The Field Guide row is classified as STATIC.'.
    RETURN.
  ENDIF.

  IF is_meta-value_type <> gc_vt_dynamic.
    cv_reason = 'The Field Guide row is not classified as DYNAMIC.'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

FORM read_mapping_metadata
  USING    iv_tcode   TYPE any
           iv_profile TYPE any
           iv_ver     TYPE any
  CHANGING ct_meta    TYPE ty_t_map_meta.

  DATA: lv_exists       TYPE abap_bool,
        lr_tab          TYPE REF TO data,
        lv_text         TYPE string,
        lv_active       TYPE string,
        lv_is_dynamic   TYPE string,
        lv_component_found TYPE abap_bool,
        lv_dynamic_found TYPE abap_bool,
        lv_tcode_found  TYPE abap_bool,
        lv_profile_found TYPE abap_bool,
        lv_ver_found    TYPE abap_bool,
        lv_exact_identity TYPE abap_bool,
        lv_tcode        TYPE zbdc_mapping_bup-tcode,
        lv_profile      TYPE zbdc_mapping_bup-profile_name,
        lv_ver          TYPE zbdc_mapping_bup-profile_ver,
        ls_meta         TYPE ty_map_meta.
  FIELD-SYMBOLS: <lt_any> TYPE STANDARD TABLE,
                 <ls_any> TYPE any.

  REFRESH ct_meta.

  lv_tcode = iv_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.
  lv_profile = iv_profile.
  CONDENSE lv_profile.
  lv_ver = iv_ver.

  PERFORM table_exists
    USING    gc_z16_tab_fguide
    CHANGING lv_exists.
  IF lv_exists IS INITIAL.
    RETURN.
  ENDIF.

  TRY.
      CREATE DATA lr_tab TYPE STANDARD TABLE OF (gc_z16_tab_fguide).
      ASSIGN lr_tab->* TO <lt_any>.
      SELECT * FROM (gc_z16_tab_fguide) INTO TABLE @<lt_any>.
    CATCH cx_root.
      RETURN.
  ENDTRY.

  LOOP AT <lt_any> ASSIGNING <ls_any>.
    CLEAR: ls_meta, lv_text, lv_active, lv_is_dynamic,
           lv_component_found, lv_dynamic_found,
           lv_tcode_found, lv_profile_found, lv_ver_found,
           lv_exact_identity.

    PERFORM get_optional_comp
      USING    <ls_any> 'IS_ACTIVE'
      CHANGING lv_active.
    IF lv_active IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'ACTIVE'
        CHANGING lv_active.
    ENDIF.
    TRANSLATE lv_active TO UPPER CASE.
    IF lv_active IS NOT INITIAL
       AND lv_active <> 'X'
       AND lv_active <> '1'
       AND lv_active <> 'Y'.
      CONTINUE.
    ENDIF.

 "Field Guide has existed in more than one DDIC shape.
 "Read identity fields with FOUND flags so a legacy TCODE-only row can be
 "used as optional enrichment but can never masquerade as exact
 "Profile/Version authority.
    CLEAR: lv_text, lv_component_found.
    PERFORM get_mapping_meta_component
      USING    <ls_any> 'TCODE' 'TRANSACTION' space
      CHANGING lv_text lv_component_found.
    lv_tcode_found = lv_component_found.
    ls_meta-tcode = lv_text.
    TRANSLATE ls_meta-tcode TO UPPER CASE.
    CONDENSE ls_meta-tcode NO-GAPS.
    IF ls_meta-tcode IS NOT INITIAL AND ls_meta-tcode <> lv_tcode.
      CONTINUE.
    ENDIF.

    CLEAR: lv_text, lv_component_found.
    PERFORM get_mapping_meta_component
      USING    <ls_any> 'PROFILE_NAME' 'PROFILE' space
      CHANGING lv_text lv_component_found.
    lv_profile_found = lv_component_found.
    ls_meta-profile_name = lv_text.
    CONDENSE ls_meta-profile_name.
    IF ls_meta-profile_name IS NOT INITIAL
       AND ls_meta-profile_name <> lv_profile.
      CONTINUE.
    ENDIF.

    CLEAR: lv_text, lv_component_found.
    PERFORM get_mapping_meta_component
      USING    <ls_any> 'PROFILE_VER' 'VERSION' space
      CHANGING lv_text lv_component_found.
    lv_ver_found = lv_component_found.
    IF lv_text IS NOT INITIAL.
      ls_meta-profile_ver = lv_text.
      IF ls_meta-profile_ver <> lv_ver.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF lv_tcode_found = abap_true
       AND lv_profile_found = abap_true
       AND lv_ver_found = abap_true
       AND ls_meta-tcode IS NOT INITIAL
       AND ls_meta-profile_name IS NOT INITIAL
       AND ls_meta-profile_ver IS NOT INITIAL.
      lv_exact_identity = abap_true.
    ENDIF.

    CLEAR lv_text.
    PERFORM get_optional_comp
      USING    <ls_any> 'BDC_FIELD'
      CHANGING lv_text.
    IF lv_text IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'NORMALIZED_BDC_FIELD'
        CHANGING lv_text.
    ENDIF.
    IF lv_text IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'SCREEN_FIELD'
        CHANGING lv_text.
    ENDIF.
    PERFORM normalize_mapping_bdc_field
      USING    lv_text
      CHANGING ls_meta-bdc_field.

    CLEAR lv_text.
    PERFORM get_optional_comp
      USING    <ls_any> 'SOURCE_COLUMN'
      CHANGING lv_text.
    IF lv_text IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'EXCEL_HEADER'
        CHANGING lv_text.
    ENDIF.
    IF lv_text IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'HEADER_NAME'
        CHANGING lv_text.
    ENDIF.
    PERFORM normalize_mapping_source
      USING    lv_text
      CHANGING ls_meta-source_column.

    CLEAR: lv_text, lv_component_found.
    PERFORM get_mapping_meta_component
      USING    <ls_any> 'STAGING_FIELD' 'FIELDNAME' 'FIELD_NAME'
      CHANGING lv_text lv_component_found.
    TRANSLATE lv_text TO UPPER CASE.
    CONDENSE lv_text NO-GAPS.
    ls_meta-staging_field = lv_text.

    CLEAR lv_text.
    PERFORM get_optional_comp
      USING    <ls_any> 'DISPLAY_LABEL'
      CHANGING lv_text.
    IF lv_text IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'FIELD_LABEL'
        CHANGING lv_text.
    ENDIF.
    IF lv_text IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'LABEL'
        CHANGING lv_text.
    ENDIF.
    ls_meta-display_label = lv_text.

    CLEAR: lv_text, lv_component_found.
    PERFORM get_mapping_meta_component
      USING    <ls_any> 'MANDATORY' 'IS_REQUIRED' 'REQUIRED'
      CHANGING lv_text lv_component_found.

    IF lv_component_found = abap_true.
      TRANSLATE lv_text TO UPPER CASE.
      CONDENSE lv_text NO-GAPS.

      IF lv_text = 'X'
         OR lv_text = '1'
         OR lv_text = 'Y'
         OR lv_text = 'YES'
         OR lv_text = 'TRUE'
         OR lv_text = 'REQUIRED'.
        ls_meta-mandatory = 'X'.
        ls_meta-mandatory_defined = abap_true.
      ELSEIF lv_text IS INITIAL
         OR lv_text = '0'
         OR lv_text = 'N'
         OR lv_text = 'NO'
         OR lv_text = 'FALSE'
         OR lv_text = 'OPTIONAL'.
        CLEAR ls_meta-mandatory.
        ls_meta-mandatory_defined = abap_true.
      ENDIF.
    ENDIF.

    CLEAR: lv_text, lv_component_found.
    PERFORM get_mapping_meta_component
      USING    <ls_any> 'VALUE_TYPE' 'MAPPING_TYPE' space
      CHANGING lv_text lv_component_found.
    TRANSLATE lv_text TO UPPER CASE.
    CONDENSE lv_text NO-GAPS.

    IF lv_text = gc_vt_dynamic OR lv_text = gc_vt_static.
      ls_meta-value_type = lv_text.
    ENDIF.

    CLEAR: lv_is_dynamic, lv_dynamic_found.
    PERFORM get_mapping_meta_component
      USING    <ls_any> 'IS_DYNAMIC' 'DYNAMIC' space
      CHANGING lv_is_dynamic lv_dynamic_found.
    TRANSLATE lv_is_dynamic TO UPPER CASE.
    CONDENSE lv_is_dynamic NO-GAPS.

    IF lv_dynamic_found = abap_true.
      IF lv_is_dynamic = 'X'
         OR lv_is_dynamic = '1'
         OR lv_is_dynamic = 'Y'
         OR lv_is_dynamic = 'YES'
         OR lv_is_dynamic = 'TRUE'.
        ls_meta-value_type = gc_vt_dynamic.
      ELSEIF lv_is_dynamic IS INITIAL
         OR lv_is_dynamic = '0'
         OR lv_is_dynamic = 'N'
         OR lv_is_dynamic = 'NO'
         OR lv_is_dynamic = 'FALSE'.
        ls_meta-value_type = gc_vt_static.
      ENDIF.
    ENDIF.

    CLEAR lv_text.
    PERFORM get_optional_comp
      USING    <ls_any> 'EXAMPLE_VALUE'
      CHANGING lv_text.
    IF lv_text IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'EXAMPLE'
        CHANGING lv_text.
    ENDIF.
    ls_meta-example_value = lv_text.

    CLEAR lv_text.
    PERFORM get_optional_comp
      USING    <ls_any> 'RULE_TEXT'
      CHANGING lv_text.
    IF lv_text IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'DESCRIPTION'
        CHANGING lv_text.
    ENDIF.
    ls_meta-rule_text = lv_text.

    CLEAR lv_text.
    PERFORM get_optional_comp
      USING    <ls_any> 'SUGGESTED_VALUES'
      CHANGING lv_text.
    IF lv_text IS INITIAL.
      PERFORM get_optional_comp
        USING    <ls_any> 'VALUE_HELP'
        CHANGING lv_text.
    ENDIF.
    ls_meta-suggested_values = lv_text.

    CLEAR lv_text.
    PERFORM get_optional_comp
      USING    <ls_any> 'DISPLAY_ORDER'
      CHANGING lv_text.
    IF lv_text IS NOT INITIAL.
      ls_meta-display_order = lv_text.
    ENDIF.

    IF ls_meta-source_column IS INITIAL
       AND ls_meta-display_label IS NOT INITIAL.
      PERFORM normalize_mapping_source
        USING    ls_meta-display_label
        CHANGING ls_meta-source_column.
    ENDIF.

    IF ls_meta-bdc_field IS NOT INITIAL
       OR ls_meta-staging_field IS NOT INITIAL
       OR ls_meta-source_column IS NOT INITIAL.
      IF lv_exact_identity = abap_true.
        ls_meta-metadata_origin = 'FIELD_GUIDE'.
      ELSE.
        ls_meta-metadata_origin = 'LEGACY_FIELD_GUIDE'.
      ENDIF.
      APPEND ls_meta TO ct_meta.
    ENDIF.
  ENDLOOP.

  SORT ct_meta BY display_order bdc_field staging_field source_column.
ENDFORM.
FORM get_mapping_ddic_help
  USING    iv_bdc_field TYPE any
  CHANGING cv_label     TYPE string
           cv_rule      TYPE string.

  DATA: lv_bdc    TYPE zbdc_mapping_bup-bdc_field,
        lv_left   TYPE string,
        lv_right  TYPE string,
        lv_tab    TYPE tabname,
        lv_field  TYPE fieldname,
        lt_dfies  TYPE STANDARD TABLE OF dfies,
        ls_dfies  TYPE dfies,
        lv_length TYPE string,
        lv_length_i TYPE i.

  CLEAR: cv_label, cv_rule.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_bdc.

  IF lv_bdc IS INITIAL OR lv_bdc NS '-'.
    RETURN.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '(*)' IN lv_bdc WITH ''.
  SPLIT lv_bdc AT '-' INTO lv_left lv_right.
  IF lv_left IS INITIAL OR lv_right IS INITIAL.
    RETURN.
  ENDIF.

  lv_tab   = lv_left.
  lv_field = lv_right.

  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_tab
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_dfies
    EXCEPTIONS
      not_found      = 1
      internal_error = 2
      OTHERS         = 3.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  READ TABLE lt_dfies INTO ls_dfies
    WITH KEY fieldname = lv_field.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  cv_label = ls_dfies-scrtext_l.
  IF cv_label IS INITIAL.
    cv_label = ls_dfies-fieldtext.
  ENDIF.
  IF cv_label IS INITIAL.
    cv_label = ls_dfies-reptext.
  ENDIF.
  IF cv_label IS INITIAL.
    cv_label = ls_dfies-scrtext_m.
  ENDIF.

  DATA(lv_z487_is_code) = abap_false.
  PERFORM ddic_code_proof
    USING    iv_bdc_field
    CHANGING lv_z487_is_code.
  IF lv_z487_is_code = abap_true.
    cv_rule = 'Enter the value shown in SAP GUI or its technical key; DDIC-backed display text is resolved to the BDC key at runtime.'.
    RETURN.
  ENDIF.

  CASE ls_dfies-datatype.
    WHEN 'DATS'.
      cv_rule = 'Accepted date: YYYYMMDD, YYYY-MM-DD or SAP user date format.'.
    WHEN 'TIMS'.
      cv_rule = 'Format HHMMSS.'.
    WHEN 'NUMC'.
      lv_length_i = ls_dfies-leng.
      lv_length = lv_length_i.
      CONDENSE lv_length NO-GAPS.
      cv_rule = |Numeric text, maximum length { lv_length } digits.|.
    WHEN 'DEC' OR 'CURR' OR 'QUAN'
      OR 'INT1' OR 'INT2' OR 'INT4' OR 'INT8'
      OR 'FLTP'.
      cv_rule = 'Enter a numeric value using SAP decimal notation.'.
    WHEN OTHERS.
      IF ls_dfies-leng > 0.
        lv_length_i = ls_dfies-leng.
        lv_length = lv_length_i.
        CONDENSE lv_length NO-GAPS.
        cv_rule = |Maximum length { lv_length } characters.|.
      ENDIF.
  ENDCASE.
ENDFORM.

FORM get_mapping_script_example
  USING    iv_tcode     TYPE any
           iv_profile   TYPE any
           iv_bdc_field TYPE any
  CHANGING cv_example   TYPE string.

  DATA: lt_script    TYPE ty_t_script,
        lt_headers   TYPE STANDARD TABLE OF zbdc_script_bup,
        ls_header    TYPE zbdc_script_bup,
        ls_script    TYPE ty_script_def_compat,
        lv_tcode     TYPE zbdc_prof_bup-tcode,
        lv_profile   TYPE zbdc_prof_bup-profile_name,
        lv_ver       TYPE zbdc_prof_bup-profile_ver,
        lv_script_id TYPE zbdc_script_bup-script_id,
        lv_hash      TYPE zbdc_script_bup-contract_hash,
        lv_found     TYPE abap_bool,
        lv_target    TYPE zbdc_mapping_bup-bdc_field,
        lv_norm      TYPE zbdc_mapping_bup-bdc_field.

  CLEAR cv_example.

  lv_tcode   = iv_tcode.
  lv_profile = iv_profile.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE: lv_tcode NO-GAPS, lv_profile.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_target.
  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL OR lv_target IS INITIAL.
    RETURN.
  ENDIF.

  lv_ver = gv_profile_ver.
  IF lv_ver IS NOT INITIAL.
    PERFORM load_profile_script
      USING    lv_tcode lv_profile lv_ver
      CHANGING lt_script lv_script_id lv_hash lv_found.
  ENDIF.

  IF lv_found <> abap_true.
    SELECT *
      FROM zbdc_script_bup
      INTO TABLE @lt_headers
      WHERE tcode        = @lv_tcode
        AND profile_name = @lv_profile.
    SORT lt_headers BY profile_ver DESCENDING.
    READ TABLE lt_headers INTO ls_header INDEX 1.
    IF sy-subrc = 0.
      lv_ver = ls_header-profile_ver.
      PERFORM load_profile_script
        USING    lv_tcode lv_profile lv_ver
        CHANGING lt_script lv_script_id lv_hash lv_found.
    ENDIF.
  ENDIF.

  IF lv_found <> abap_true.
    RETURN.
  ENDIF.

  LOOP AT lt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm = lv_target AND ls_script-static_value IS NOT INITIAL.
      cv_example = ls_script-static_value.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

FORM enrich_meta_from_approved_map
  USING    iv_tcode   TYPE any
           iv_profile TYPE any
  CHANGING ct_meta    TYPE ty_t_map_meta.

  DATA: lt_profiles TYPE STANDARD TABLE OF zbdc_prof_bup,
        lt_mapping  TYPE STANDARD TABLE OF zbdc_mapping_bup,
        ls_profile  TYPE zbdc_prof_bup,
        ls_mapping  TYPE zbdc_mapping_bup,
        ls_existing TYPE ty_map_meta,
        ls_meta     TYPE ty_map_meta,
        lv_tcode    TYPE zbdc_mapping_bup-tcode,
        lv_profile  TYPE zbdc_mapping_bup-profile_name,
        lv_bdc      TYPE zbdc_mapping_bup-bdc_field,
        lv_source   TYPE zbdc_mapping_bup-source_column,
        lv_found    TYPE abap_bool,
        lv_source_technical TYPE abap_bool,
        lv_ddic_source TYPE zbdc_mapping_bup-source_column,
        lv_ddic_found TYPE abap_bool,
        lv_label    TYPE string,
        lv_rule     TYPE string,
        lv_example  TYPE string,
        lv_order    TYPE i,
        lv_cert_script TYPE zbdc_cert_bup-script_id.

  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
               WITH UNIQUE KEY table_line.

  lv_tcode = iv_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.

  lv_profile = iv_profile.
  CONDENSE lv_profile.

  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL.
    RETURN.
  ENDIF.

  SELECT * FROM zbdc_prof_bup
    INTO TABLE @lt_profiles
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile.

  DELETE lt_profiles
    WHERE status <> gc_m2_prof_active
      AND status <> gc_m2_prof_mapped
      AND status <> 'INACTIVE'.

  IF lt_profiles IS INITIAL.
    RETURN.
  ENDIF.

  SORT lt_profiles BY profile_ver DESCENDING.

  SELECT * FROM zbdc_mapping_bup
    INTO TABLE @lt_mapping
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile.

  IF lt_mapping IS INITIAL.
    RETURN.
  ENDIF.

  SORT lt_mapping BY profile_ver DESCENDING
                     staging_field
                     source_column.

  LOOP AT lt_profiles INTO ls_profile.
    CLEAR lv_cert_script.
    SELECT SINGLE script_id
      FROM zbdc_cert_bup
      INTO @lv_cert_script
      WHERE tcode            = @lv_tcode
        AND profile_name     = @lv_profile
        AND profile_ver      = @ls_profile-profile_ver
        AND cert_status      = 'CERTIFIED'
        AND last_test_status = 'CERTIFIED'.
    IF sy-subrc <> 0 OR lv_cert_script IS INITIAL.
      CONTINUE.
    ENDIF.

    LOOP AT lt_mapping INTO ls_mapping
      WHERE profile_ver = ls_profile-profile_ver
        AND bdc_field IS NOT INITIAL.

      PERFORM normalize_mapping_bdc_field
        USING    ls_mapping-bdc_field
        CHANGING lv_bdc.
      IF lv_bdc IS INITIAL.
        CONTINUE.
      ENDIF.

      READ TABLE lt_seen
        WITH TABLE KEY table_line = lv_bdc
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        CONTINUE.
      ENDIF.
      INSERT lv_bdc INTO TABLE lt_seen.

      CLEAR: ls_existing, lv_found.
      PERFORM find_mapping_metadata
        USING    ct_meta lv_bdc
                 ls_mapping-source_column
                 ls_mapping-staging_field
        CHANGING ls_existing lv_found.
      IF lv_found = abap_true.
        CONTINUE.
      ENDIF.

      PERFORM normalize_mapping_source
        USING    ls_mapping-source_column
        CHANGING lv_source.

      PERFORM mapping_source_is_technical
        USING    lv_source lv_bdc
        CHANGING lv_source_technical.

      IF lv_source IS INITIAL
         OR lv_source_technical = abap_true.
        PERFORM derive_ddic_source_column
          USING    lv_bdc
          CHANGING lv_ddic_source lv_ddic_found.
        IF lv_ddic_found = abap_true.
          lv_source = lv_ddic_source.
        ENDIF.
      ENDIF.

      IF lv_source IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR: lv_label, lv_rule, lv_example.
      PERFORM get_mapping_ddic_help
        USING    lv_bdc
        CHANGING lv_label lv_rule.
      PERFORM get_mapping_script_example
        USING    lv_tcode lv_profile lv_bdc
        CHANGING lv_example.

      IF lv_label IS INITIAL.
        lv_label = lv_source.
        REPLACE ALL OCCURRENCES OF '_' IN lv_label WITH space.
      ENDIF.

      lv_order = lv_order + 1.

      CLEAR ls_meta.
      ls_meta-tcode             = lv_tcode.
      ls_meta-profile_name      = lv_profile.
      ls_meta-profile_ver       = ls_profile-profile_ver.
      ls_meta-bdc_field         = lv_bdc.
      ls_meta-source_column     = lv_source.
      ls_meta-staging_field     = ls_mapping-staging_field.
      ls_meta-display_label     = lv_label.
      ls_meta-mandatory         = ls_mapping-mandatory.
      ls_meta-mandatory_defined = abap_true.
      ls_meta-value_type        = gc_vt_dynamic.
      ls_meta-example_value     = lv_example.
      ls_meta-rule_text         = lv_rule.
      ls_meta-display_order     = lv_order.
      ls_meta-metadata_origin   = 'APPROVED_PROFILE'.
      APPEND ls_meta TO ct_meta.
    ENDLOOP.
  ENDLOOP.

  SORT ct_meta BY display_order bdc_field staging_field source_column.
ENDFORM.

FORM find_mapping_metadata
  USING    pt_meta       TYPE ty_t_map_meta
           iv_bdc_field  TYPE any
           iv_source     TYPE any
           iv_staging    TYPE any
  CHANGING cs_meta       TYPE ty_map_meta
           cv_found      TYPE abap_bool.

  DATA: ls_meta       TYPE ty_map_meta,
        lv_bdc        TYPE zbdc_mapping_bup-bdc_field,
        lv_source     TYPE zbdc_mapping_bup-source_column,
        lv_staging    TYPE zbdc_mapping_bup-staging_field,
        lv_meta_source TYPE zbdc_mapping_bup-source_column.

  CLEAR: cs_meta, cv_found.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_bdc.
  PERFORM normalize_mapping_source
    USING    iv_source
    CHANGING lv_source.
  lv_staging = iv_staging.
  TRANSLATE lv_staging TO UPPER CASE.
  CONDENSE lv_staging NO-GAPS.

  IF lv_bdc IS NOT INITIAL.
    LOOP AT pt_meta INTO ls_meta WHERE bdc_field = lv_bdc.
      cs_meta = ls_meta.
      cv_found = abap_true.
      RETURN.
    ENDLOOP.
  ENDIF.

  IF lv_staging IS NOT INITIAL.
    LOOP AT pt_meta INTO ls_meta WHERE staging_field = lv_staging.
      cs_meta = ls_meta.
      cv_found = abap_true.
      RETURN.
    ENDLOOP.
  ENDIF.

  IF lv_source IS NOT INITIAL.
    LOOP AT pt_meta INTO ls_meta.
      PERFORM normalize_mapping_source
        USING    ls_meta-source_column
        CHANGING lv_meta_source.
      IF lv_meta_source = lv_source.
        cs_meta = ls_meta.
        cv_found = abap_true.
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDIF.
ENDFORM.

*& Runtime Required Contract (generic, no TCODE/field hardcode)

*& MANDATORY in legacy Mapping rows was also used as a projection/visibility
*& marker. It therefore cannot safely mean "blank upload must be blocked".
*& Runtime requiredness is narrower:
*& FIELD01/business key remains required as the engine control key.
*& A mapped SAP field is required only when the exact Field Guide row for
*& the same TCODE/Profile/Version explicitly defines MANDATORY = X.
*& Otherwise the field is an optional override of the immutable SHDB
*& replay value; SAP itself remains the authority for business-required
*& fields during replay.
*& This separates Template membership from validation semantics without any
*& CASE TCODE, SAP field-name rule, or application-specific branch.
FORM derive_ddic_source_column
  USING    iv_bdc_field TYPE any
  CHANGING cv_source    TYPE zbdc_mapping_bup-source_column
           cv_found     TYPE abap_bool.

  DATA: lv_bdc       TYPE zbdc_mapping_bup-bdc_field,
        lv_struct    TYPE tabname,
        lv_leaf      TYPE fieldname,
        lv_left      TYPE string,
        lv_right     TYPE string,
        lv_label     TYPE string,
        lv_leaf_norm TYPE zbdc_mapping_bup-source_column,
        lv_length    TYPE i,
        lt_dfies     TYPE STANDARD TABLE OF dfies,
        ls_dfies     TYPE dfies,
        ls_dtel      TYPE dd04v.

  CLEAR: cv_source, cv_found.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_bdc.
  IF lv_bdc IS INITIAL OR lv_bdc NS '-'.
    RETURN.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '(*)' IN lv_bdc WITH ''.
  SPLIT lv_bdc AT '-' INTO lv_left lv_right.
  IF lv_left IS INITIAL OR lv_right IS INITIAL.
    RETURN.
  ENDIF.

  lv_struct = lv_left.
  lv_leaf   = lv_right.

  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_struct
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_dfies
    EXCEPTIONS
      not_found      = 1
      internal_error = 2
      OTHERS         = 3.

  IF sy-subrc = 0.
    READ TABLE lt_dfies INTO ls_dfies WITH KEY fieldname = lv_leaf.
    IF sy-subrc = 0.
 "generic RANGE structures often label LOW/HIGH only as
 "Lower/Upper limit although DFIES-ROLLNAME still carries the real
 "business data element. Resolve that data element first so a captured
 "RNG_*-LOW/HIGH can become e.g. COMPANY_CODE / ACCOUNT rather than a
 "technical RNG_* header. This is structural DDIC evidence only.
      IF ( lv_leaf = 'LOW' OR lv_leaf = 'HIGH' )
         AND ls_dfies-rollname IS NOT INITIAL.
        CLEAR ls_dtel.
        CALL FUNCTION 'DDIF_DTEL_GET'
          EXPORTING
            name          = ls_dfies-rollname
            state         = 'A'
            langu         = sy-langu
          IMPORTING
            dd04v_wa      = ls_dtel
          EXCEPTIONS
            illegal_input = 1
            OTHERS        = 2.
        IF sy-subrc = 0.
          lv_label = ls_dtel-scrtext_l.
          IF lv_label IS INITIAL.
            lv_label = ls_dtel-ddtext.
          ENDIF.
          IF lv_label IS INITIAL.
            lv_label = ls_dtel-reptext.
          ENDIF.
          IF lv_label IS INITIAL.
            lv_label = ls_dtel-scrtext_m.
          ENDIF.
        ENDIF.
      ENDIF.

      IF lv_label IS INITIAL.
        lv_label = ls_dfies-scrtext_l.
      ENDIF.
      IF lv_label IS INITIAL.
        lv_label = ls_dfies-fieldtext.
      ENDIF.
      IF lv_label IS INITIAL.
        lv_label = ls_dfies-reptext.
      ENDIF.
      IF lv_label IS INITIAL.
        lv_label = ls_dfies-scrtext_m.
      ENDIF.
    ENDIF.
  ENDIF.

  IF lv_label IS NOT INITIAL.
    PERFORM normalize_mapping_source
      USING    lv_label
      CHANGING cv_source.
  ENDIF.

  PERFORM normalize_mapping_source
    USING    lv_leaf
    CHANGING lv_leaf_norm.

 "Screen structures may not expose a useful DDIC label.
 "A semantic component such as PO_NUMBER is still a valid header.
  IF cv_source IS INITIAL.
    lv_length = strlen( lv_leaf_norm ).
    IF lv_leaf_norm CS '_' OR lv_length > 5.
      cv_source = lv_leaf_norm.
    ENDIF.
  ENDIF.

  IF cv_source IS INITIAL.
    RETURN.
  ENDIF.

  cv_found = abap_true.
ENDFORM.

FORM refine_business_source
  USING    iv_source  TYPE any
           iv_leaf    TYPE any
           iv_example TYPE any
  CHANGING cv_source  TYPE zbdc_mapping_bup-source_column.

  DATA lv_source TYPE string.

 "Registry-only contract: do not infer business meaning from recorded
 "values and do not rewrite labels through lexical business rules.
 "SOURCE_COLUMN comes from Field Guide metadata when maintained; otherwise
 "the neutral DDIC/technical source is retained unchanged.
  lv_source = iv_source.
  CONDENSE lv_source.

  IF lv_source IS INITIAL.
    lv_source = iv_leaf.
    CONDENSE lv_source.
  ENDIF.

  PERFORM normalize_mapping_source
    USING    lv_source
    CHANGING cv_source.
ENDFORM.

FORM get_ddic_field_traits
  USING    iv_bdc_field TYPE any
           iv_example   TYPE any
  CHANGING cv_source    TYPE zbdc_mapping_bup-source_column
           cv_label     TYPE string
           cv_rule      TYPE string
           cv_datatype  TYPE dfies-datatype
           cv_length    TYPE dfies-leng
           cv_found     TYPE abap_bool.

  DATA: lv_bdc    TYPE zbdc_mapping_bup-bdc_field,
        lv_left   TYPE string,
        lv_right  TYPE string,
        lv_tab    TYPE tabname,
        lv_field  TYPE fieldname,
        lv_leaf   TYPE zbdc_mapping_bup-source_column,
        lv_source TYPE zbdc_mapping_bup-source_column,
        lt_dfies  TYPE STANDARD TABLE OF dfies,
        ls_dfies  TYPE dfies.

  CLEAR: cv_source, cv_label, cv_rule,
         cv_datatype, cv_length, cv_found.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_bdc.
  IF lv_bdc IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_mapping_leaf_source
    USING    lv_bdc
    CHANGING lv_leaf.

  IF lv_bdc CS '-'.
    REPLACE ALL OCCURRENCES OF '(*)' IN lv_bdc WITH ''.
    SPLIT lv_bdc AT '-' INTO lv_left lv_right.
    lv_tab   = lv_left.
    lv_field = lv_right.

    IF lv_tab IS NOT INITIAL AND lv_field IS NOT INITIAL.
      CALL FUNCTION 'DDIF_FIELDINFO_GET'
        EXPORTING
          tabname        = lv_tab
          langu          = sy-langu
          all_types      = abap_true
        TABLES
          dfies_tab      = lt_dfies
        EXCEPTIONS
          not_found      = 1
          internal_error = 2
          OTHERS         = 3.

      IF sy-subrc = 0.
        READ TABLE lt_dfies INTO ls_dfies
          WITH KEY fieldname = lv_field.
        IF sy-subrc = 0.
          cv_found    = abap_true.
          cv_datatype = ls_dfies-datatype.
          cv_length   = ls_dfies-leng.

          cv_label = ls_dfies-scrtext_l.
          IF cv_label IS INITIAL.
            cv_label = ls_dfies-fieldtext.
          ENDIF.
          IF cv_label IS INITIAL.
            cv_label = ls_dfies-reptext.
          ENDIF.
          IF cv_label IS INITIAL.
            cv_label = ls_dfies-scrtext_m.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

  IF cv_label IS NOT INITIAL.
    PERFORM normalize_mapping_source
      USING    cv_label
      CHANGING lv_source.
  ENDIF.
  IF lv_source IS INITIAL.
    lv_source = lv_leaf.
  ENDIF.

  PERFORM refine_business_source
    USING    lv_source lv_leaf iv_example
    CHANGING cv_source.

  PERFORM get_mapping_ddic_help
    USING    iv_bdc_field
    CHANGING cv_label cv_rule.

  IF cv_label IS INITIAL.
    cv_label = cv_source.
    REPLACE ALL OCCURRENCES OF '_' IN cv_label WITH space.
  ENDIF.
ENDFORM.

FORM collect_shdb_field_stats
  USING    pt_script    TYPE ty_t_script
           pt_previous  TYPE ty_t_script
           iv_bdc_field TYPE any
  CHANGING cs_stats     TYPE ty_shdb_field_stats.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor_norm TYPE zbdc_mapping_bup-bdc_field,
        lv_value       TYPE ty_script_def_compat-static_value,
        lv_label       TYPE string,
        lv_rule        TYPE string,
        lv_all_flags   TYPE abap_bool.

  DATA: lt_current  TYPE ty_t_shdb_value,
        lt_previous TYPE ty_t_shdb_value.

  CLEAR cs_stats.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_target.
  cs_stats-bdc_field = lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script.
    IF ls_script-field_name = 'BDC_CURSOR'.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-static_value
        CHANGING lv_cursor_norm.
      IF lv_cursor_norm = lv_target.
        cs_stats-cursor_target = abap_true.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-is_new_screen = 'X'
       OR ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm <> lv_target.
      CONTINUE.
    ENDIF.

    cs_stats-occurrences = cs_stats-occurrences + 1.
    IF ls_script-field_name CS '('
       AND ls_script-field_name CS ')'.
      cs_stats-indexed_field = abap_true.
    ENDIF.

    lv_value = ls_script-static_value.
    CONDENSE lv_value.
    IF lv_value IS NOT INITIAL.
      INSERT lv_value INTO TABLE lt_current.
      IF cs_stats-example_value IS INITIAL.
        cs_stats-example_value = lv_value.
      ENDIF.
    ENDIF.
  ENDLOOP.

  DESCRIBE TABLE lt_current LINES cs_stats-distinct_values.

  LOOP AT pt_previous INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm <> lv_target.
      CONTINUE.
    ENDIF.

    lv_value = ls_script-static_value.
    CONDENSE lv_value.
    IF lv_value IS NOT INITIAL.
      INSERT lv_value INTO TABLE lt_previous.
    ENDIF.
  ENDLOOP.

  IF lt_current IS NOT INITIAL AND lt_previous IS NOT INITIAL.
    LOOP AT lt_current INTO lv_value.
      READ TABLE lt_previous
        WITH TABLE KEY table_line = lv_value
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        cs_stats-changed_previous = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF cs_stats-changed_previous IS INITIAL.
      LOOP AT lt_previous INTO lv_value.
        READ TABLE lt_current
          WITH TABLE KEY table_line = lv_value
          TRANSPORTING NO FIELDS.
        IF sy-subrc <> 0.
          cs_stats-changed_previous = abap_true.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

  PERFORM get_ddic_field_traits
    USING    lv_target cs_stats-example_value
    CHANGING cs_stats-source_column
             lv_label
             lv_rule
             cs_stats-datatype
             cs_stats-ddic_length
             cs_stats-ddic_found.

  cs_stats-display_label = lv_label.
  cs_stats-rule_text     = lv_rule.

 "/CHAR1 is not automatically a boolean. flag_like means only
 "that recorded non-blank values are X/0/1. performs a second proof
 "step from screen context before choosing DYNAMIC, STATIC, or UNRESOLVED.
 "The literal value alone never authorizes IGNORE.
  IF lt_current IS NOT INITIAL.
    lv_all_flags = abap_true.
    LOOP AT lt_current INTO lv_value.
      TRANSLATE lv_value TO UPPER CASE.
      CONDENSE lv_value NO-GAPS.
      IF lv_value <> 'X'
         AND lv_value <> '0'
         AND lv_value <> '1'.
        CLEAR lv_all_flags.
        EXIT.
      ENDIF.
    ENDLOOP.
    cs_stats-flag_like = lv_all_flags.
  ENDIF.
ENDFORM.

FORM get_mapping_leaf_source
  USING    iv_bdc_field TYPE any
  CHANGING cv_leaf      TYPE zbdc_mapping_bup-source_column.

  DATA: lv_bdc   TYPE zbdc_mapping_bup-bdc_field,
        lv_left  TYPE string,
        lv_right TYPE string.

  CLEAR cv_leaf.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_bdc.

  IF lv_bdc IS INITIAL.
    RETURN.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '(*)' IN lv_bdc WITH ''.

  IF lv_bdc CS '-'.
    SPLIT lv_bdc AT '-' INTO lv_left lv_right.
  ELSE.
    lv_right = lv_bdc.
  ENDIF.

  PERFORM normalize_mapping_source
    USING    lv_right
    CHANGING cv_leaf.
ENDFORM.

FORM derive_auto_meta_from_script
  USING    pt_script    TYPE ty_t_script
           iv_tcode     TYPE any
           iv_bdc_field TYPE any
  CHANGING cs_meta      TYPE ty_map_meta
           cv_found     TYPE abap_bool.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_ddic_source TYPE zbdc_mapping_bup-source_column,
        lv_leaf_source TYPE zbdc_mapping_bup-source_column,
        lv_label       TYPE string,
        lv_rule        TYPE string,
        lv_example     TYPE string,
        lv_datatype    TYPE dfies-datatype,
        lv_length      TYPE dfies-leng,
        lv_ddic_found  TYPE abap_bool,
        lv_source_tech TYPE abap_bool,
        lv_dynamic     TYPE abap_bool.

  CLEAR: cs_meta, cv_found.

  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc_field
    CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm <> lv_target.
      CONTINUE.
    ENDIF.

    IF ls_script-value_type = gc_vt_dynamic.
      lv_dynamic = abap_true.
    ENDIF.
    IF lv_source IS INITIAL AND ls_script-source_column IS NOT INITIAL.
      lv_source = ls_script-source_column.
    ENDIF.
    IF lv_example IS INITIAL AND ls_script-static_value IS NOT INITIAL.
      lv_example = ls_script-static_value.
    ENDIF.
  ENDLOOP.

  IF lv_dynamic <> abap_true.
    RETURN.
  ENDIF.

 "do not invent an end-user template field from DDIC/SHDB
 "evidence alone. Import/Recording parsing must have produced a real
 "logical source column first. DDIC labels may enrich that source, but
 "they must never create a new user-input column by themselves. This is
 "generic and avoids leaking optional captured fields into Mapping/Template.
  PERFORM normalize_mapping_source USING lv_source CHANGING lv_source.
  PERFORM mapping_source_is_technical
    USING lv_source lv_target CHANGING lv_source_tech.
  IF lv_source IS INITIAL OR lv_source_tech = abap_true.
    RETURN.
  ENDIF.

  PERFORM get_ddic_field_traits
    USING    lv_target lv_example
    CHANGING lv_ddic_source lv_label lv_rule
             lv_datatype lv_length lv_ddic_found.

  PERFORM get_mapping_leaf_source
    USING lv_target CHANGING lv_leaf_source.

  PERFORM refine_business_source
    USING lv_source lv_leaf_source lv_example CHANGING lv_source.
  PERFORM normalize_mapping_source USING lv_source CHANGING lv_source.
  PERFORM mapping_source_is_technical
    USING lv_source lv_target CHANGING lv_source_tech.
  IF lv_source IS INITIAL OR lv_source_tech = abap_true.
    RETURN.
  ENDIF.

  IF lv_label IS INITIAL.
    IF lv_source CP 'INPUT_*'.
      lv_label = lv_target.
      REPLACE ALL OCCURRENCES OF '(*)' IN lv_label WITH ''.
      lv_label = |Additional SAP input ({ lv_label })|.
    ELSE.
      lv_label = lv_source.
      REPLACE ALL OCCURRENCES OF '_' IN lv_label WITH space.
    ENDIF.
  ENDIF.

  cs_meta-tcode             = iv_tcode.
  cs_meta-bdc_field         = lv_target.
  cs_meta-source_column     = lv_source.
  cs_meta-display_label     = lv_label.
  IF lv_example IS INITIAL.
    cs_meta-mandatory = 'X'.
  ELSE.
    CLEAR cs_meta-mandatory.
  ENDIF.
  cs_meta-mandatory_defined = abap_true.
  cs_meta-value_type        = gc_vt_dynamic.
  cs_meta-example_value     = lv_example.
  cs_meta-rule_text         = lv_rule.
  cs_meta-metadata_origin   = 'SHDB_EVIDENCE'.

  cv_found = abap_true.
ENDFORM.

FORM enrich_meta_from_shdb_ddic
  USING    iv_tcode   TYPE any
           iv_profile TYPE any
           iv_ver     TYPE any
  CHANGING ct_meta    TYPE ty_t_map_meta.

  DATA: lt_script    TYPE ty_t_script,
        ls_script    TYPE ty_script_def_compat,
        ls_existing  TYPE ty_map_meta,
        ls_auto      TYPE ty_map_meta,
        lv_tcode     TYPE zbdc_mapping_bup-tcode,
        lv_profile   TYPE zbdc_mapping_bup-profile_name,
        lv_ver       TYPE zbdc_mapping_bup-profile_ver,
        lv_bdc       TYPE zbdc_mapping_bup-bdc_field,
        lv_found     TYPE abap_bool,
        lv_auto      TYPE abap_bool,
        lv_technical TYPE abap_bool,
        lv_order     TYPE i.

  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
               WITH UNIQUE KEY table_line.

  lv_tcode = iv_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.
  lv_profile = iv_profile.
  CONDENSE lv_profile.
  lv_ver = iv_ver.

  IF lv_tcode IS INITIAL.
    RETURN.
  ENDIF.

  DATA: lv_script_id TYPE zbdc_script_bup-script_id,
        lv_hash      TYPE zbdc_script_bup-contract_hash,
        lv_script_found TYPE abap_bool.

  PERFORM load_profile_script
    USING    lv_tcode lv_profile lv_ver
    CHANGING lt_script lv_script_id lv_hash lv_script_found.

  IF lv_script_found <> abap_true.
    RETURN.
  ENDIF.

  LOOP AT ct_meta INTO ls_existing.
    IF ls_existing-display_order > lv_order.
      lv_order = ls_existing-display_order.
    ENDIF.
  ENDLOOP.

  LOOP AT lt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_bdc.
    IF lv_bdc IS INITIAL.
      CONTINUE.
    ENDIF.

    READ TABLE lt_seen
      WITH TABLE KEY table_line = lv_bdc
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT lv_bdc INTO TABLE lt_seen.

    CLEAR: ls_existing, lv_found.
    PERFORM find_mapping_metadata
      USING    ct_meta lv_bdc space space
      CHANGING ls_existing lv_found.
    IF lv_found = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR: ls_auto, lv_auto.
    PERFORM derive_auto_meta_from_script
      USING    lt_script lv_tcode lv_bdc
      CHANGING ls_auto lv_auto.
    IF lv_auto <> abap_true.
      CONTINUE.
    ENDIF.

    lv_order = lv_order + 1.
    ls_auto-profile_name  = lv_profile.
    ls_auto-profile_ver   = lv_ver.
    ls_auto-display_order = lv_order.
    APPEND ls_auto TO ct_meta.
  ENDLOOP.

  SORT ct_meta BY display_order bdc_field staging_field source_column.
ENDFORM.

FORM classify_script_item_block
  CHANGING ct_script TYPE ty_t_script.

  DATA: ls_script    TYPE ty_script_def_compat,
        lv_technical TYPE abap_bool,
        lv_first     TYPE ty_script_def_compat-step_seq,
        lv_last      TYPE ty_script_def_compat-step_seq,
        lv_item_tok  TYPE string.

  FIELD-SYMBOLS <ls_script> TYPE ty_script_def_compat.

 "only the placeholder emitted by Z16 after repeatable-row proof can
 "establish ITEM scope. Raw FIELD(01)/(02) remains exact screen identity.
  lv_item_tok = '(' && gc_ph_index && ')'.

  LOOP AT ct_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true
       OR ls_script-field_name NS lv_item_tok.
      CONTINUE.
    ENDIF.
    IF lv_first IS INITIAL OR ls_script-step_seq < lv_first.
      lv_first = ls_script-step_seq.
    ENDIF.
    IF lv_last IS INITIAL OR ls_script-step_seq > lv_last.
      lv_last = ls_script-step_seq.
    ENDIF.
  ENDLOOP.

  IF lv_first IS INITIAL OR lv_last IS INITIAL.
    LOOP AT ct_script ASSIGNING <ls_script>.
      <ls_script>-row_type = gc_rt_header.
    ENDLOOP.
    RETURN.
  ENDIF.

  LOOP AT ct_script ASSIGNING <ls_script>.
    IF <ls_script>-step_seq < lv_first.
      <ls_script>-row_type = gc_rt_header.
    ELSEIF <ls_script>-step_seq <= lv_last.
      <ls_script>-row_type = gc_rt_item.
    ELSE.
      <ls_script>-row_type = gc_m2_rt_post.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Evidence-resolved onboarding contract
*& No business field is inferred from index, cursor, value shape, DDIC date
*& type, or one recording value. Only explicit metadata or a verified prior
*& contract is inherited. Everything else remains UNRESOLVED.

FORM same_static_set
  USING    pt_current  TYPE ty_t_script
           pt_previous TYPE ty_t_script
           iv_field    TYPE zbdc_mapping_bup-bdc_field
  CHANGING cv_same     TYPE abap_bool.
  DATA: lt_current  TYPE ty_t_shdb_value,
        lt_previous TYPE ty_t_shdb_value,
        ls_script   TYPE ty_script_def_compat,
        lv_norm     TYPE zbdc_mapping_bup-bdc_field,
        lv_value    TYPE ty_script_def_compat-static_value.
  CLEAR cv_same.
  LOOP AT pt_current INTO ls_script
    WHERE is_new_screen IS INITIAL AND field_name IS NOT INITIAL.
    PERFORM normalize_mapping_bdc_field USING ls_script-field_name CHANGING lv_norm.
    IF lv_norm <> iv_field. CONTINUE. ENDIF.
    lv_value = ls_script-static_value. CONDENSE lv_value.
    INSERT lv_value INTO TABLE lt_current.
  ENDLOOP.
  LOOP AT pt_previous INTO ls_script
    WHERE is_new_screen IS INITIAL AND field_name IS NOT INITIAL.
    PERFORM normalize_mapping_bdc_field USING ls_script-field_name CHANGING lv_norm.
    IF lv_norm <> iv_field. CONTINUE. ENDIF.
    lv_value = ls_script-static_value. CONDENSE lv_value.
    INSERT lv_value INTO TABLE lt_previous.
  ENDLOOP.
  IF lines( lt_current ) <> lines( lt_previous ). RETURN. ENDIF.
  LOOP AT lt_current INTO lv_value.
    READ TABLE lt_previous WITH TABLE KEY table_line = lv_value TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0. RETURN. ENDIF.
  ENDLOOP.
  cv_same = abap_true.
ENDFORM.

FORM prev_decision
  USING    pt_current  TYPE ty_t_script
           pt_previous TYPE ty_t_script
           iv_field    TYPE zbdc_mapping_bup-bdc_field
  CHANGING cv_type     TYPE zbdc_sct_ver_bup-value_type
           cv_source   TYPE zbdc_mapping_bup-source_column
           cv_found    TYPE abap_bool.
  DATA: ls_script TYPE ty_script_def_compat,
        lv_norm   TYPE zbdc_mapping_bup-bdc_field,
        lv_type   TYPE zbdc_sct_ver_bup-value_type,
        lv_source TYPE zbdc_mapping_bup-source_column,
        lv_same   TYPE abap_bool.
  CLEAR: cv_type, cv_source, cv_found.
  LOOP AT pt_previous INTO ls_script
    WHERE is_new_screen IS INITIAL AND field_name IS NOT INITIAL.
    PERFORM normalize_mapping_bdc_field USING ls_script-field_name CHANGING lv_norm.
    IF lv_norm <> iv_field. CONTINUE. ENDIF.
    lv_type = ls_script-value_type. TRANSLATE lv_type TO UPPER CASE. CONDENSE lv_type NO-GAPS.
    IF lv_type <> gc_vt_dynamic AND lv_type <> gc_vt_static AND lv_type <> gc_m2_vt_ignore.
      CLEAR: cv_type, cv_source. RETURN.
    ENDIF.
    IF cv_type IS INITIAL.
      cv_type = lv_type.
    ELSEIF cv_type <> lv_type.
      CLEAR: cv_type, cv_source. RETURN.
    ENDIF.
    IF lv_type = gc_vt_dynamic.
      lv_source = ls_script-source_column.
      PERFORM normalize_mapping_source USING lv_source CHANGING lv_source.
      IF lv_source IS INITIAL. CLEAR: cv_type, cv_source. RETURN. ENDIF.
      IF cv_source IS INITIAL.
        cv_source = lv_source.
      ELSEIF cv_source <> lv_source.
        CLEAR: cv_type, cv_source. RETURN.
      ENDIF.
    ENDIF.
  ENDLOOP.
  IF cv_type IS INITIAL. RETURN. ENDIF.
  IF cv_type = gc_vt_static.
    PERFORM same_static_set USING pt_current pt_previous iv_field CHANGING lv_same.
    IF lv_same <> abap_true. CLEAR: cv_type, cv_source. RETURN. ENDIF.
  ENDIF.
  cv_found = abap_true.
ENDFORM.

FORM count_states
  USING    pt_script TYPE ty_t_script
  CHANGING cv_dynamic    TYPE i
           cv_static     TYPE i
           cv_unresolved TYPE i
           cv_ignored    TYPE i.
  DATA: ls_script TYPE ty_script_def_compat,
        lv_norm   TYPE zbdc_mapping_bup-bdc_field,
        lv_type   TYPE zbdc_sct_ver_bup-value_type.
  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field WITH UNIQUE KEY table_line.
  CLEAR: cv_dynamic, cv_static, cv_unresolved, cv_ignored.
  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL AND field_name IS NOT INITIAL.
    PERFORM normalize_mapping_bdc_field USING ls_script-field_name CHANGING lv_norm.
    IF lv_norm IS INITIAL. CONTINUE. ENDIF.
    READ TABLE lt_seen WITH TABLE KEY table_line = lv_norm TRANSPORTING NO FIELDS.
    IF sy-subrc = 0. CONTINUE. ENDIF.
    INSERT lv_norm INTO TABLE lt_seen.
    lv_type = ls_script-value_type. TRANSLATE lv_type TO UPPER CASE. CONDENSE lv_type NO-GAPS.
    CASE lv_type.
      WHEN gc_vt_dynamic. cv_dynamic = cv_dynamic + 1.
      WHEN gc_vt_static. cv_static = cv_static + 1.
      WHEN gc_m2_vt_ignore. cv_ignored = cv_ignored + 1.
      WHEN OTHERS. cv_unresolved = cv_unresolved + 1.
    ENDCASE.
  ENDLOOP.
ENDFORM.

*& Canonical technical BDC control state

*& Real evidence rule:
*& Never add/remove a captured BDC row.
*& Never borrow a business field from Mapping/Import/history.
*& Only normalize execution metadata for SAP technical controls:
*& BDC_CURSOR -> STATIC exact recorded target
*& other BDC_*/DYN_* technical fields -> STATIC
*& STATIC_VALUE is preserved exactly as captured/imported.

FORM fix_tech_steps
  CHANGING ct_script  TYPE ty_t_script
           cv_changed TYPE abap_bool.

  DATA lv_technical TYPE abap_bool.
  FIELD-SYMBOLS <ls_scr> TYPE ty_script_def_compat.

  CLEAR cv_changed.

  LOOP AT ct_script ASSIGNING <ls_scr>
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    IF <ls_scr>-field_name = 'BDC_CURSOR'.
 "RAW-exact means cursor navigation is recording evidence too.
 "Do not expose BDC_CURSOR as Mapping, but preserve its recorded target
 "as STATIC. In selection/table-control screens the cursor can determine
 "the visible/active row and therefore the subsequent dynpro sequence.
      IF <ls_scr>-value_type <> gc_vt_static
         OR <ls_scr>-source_column IS NOT INITIAL.
        cv_changed = abap_true.
      ENDIF.
      <ls_scr>-value_type = gc_vt_static.
      CLEAR <ls_scr>-source_column.
      CONTINUE.
    ENDIF.

 "a field carrying &ZBDC_TRACE& is engine-owned proof metadata,
 "even when the same SAP field also exists in the business Mapping. It
 "must never be converted back to DYNAMIC or sourced from an upload row,
 "otherwise the uploaded value silently replaces the runtime trace and
 "the created SAP object can only be proven by protocol.
    IF <ls_scr>-static_value CS gc_trace_token.
      IF <ls_scr>-value_type <> gc_vt_static
         OR <ls_scr>-source_column IS NOT INITIAL.
        cv_changed = abap_true.
      ENDIF.
      <ls_scr>-value_type = gc_vt_static.
      CLEAR <ls_scr>-source_column.
      CONTINUE.
    ENDIF.

    CLEAR lv_technical.
    PERFORM mapping_field_is_technical
      USING    <ls_scr>-field_name
      CHANGING lv_technical.

    IF lv_technical = abap_true.
      IF <ls_scr>-value_type <> gc_vt_static
         OR <ls_scr>-source_column IS NOT INITIAL.
        cv_changed = abap_true.
      ENDIF.
      <ls_scr>-value_type = gc_vt_static.
      CLEAR <ls_scr>-source_column.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Repair non-certified technical metadata only

*& could persist fresh evidence before BDC_OKCODE was canonicalized
*& STATIC. Mapping correctly hid technical rows, but Generate Template then
*& failed in the executable-contract gate. This repair changes no business
*& field, no BDC value, no sequence and no Mapping row. Certified contracts
*& remain immutable and therefore fail closed.

FORM repair_tech_contract
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_ver       TYPE zbdc_prof_bup-profile_ver
           iv_script_id TYPE zbdc_script_bup-script_id
  CHANGING ct_script    TYPE ty_t_script
           cv_hash      TYPE zbdc_script_bup-contract_hash
           cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_changed      TYPE abap_bool,
        lv_hash_new     TYPE zbdc_script_bup-contract_hash,
        lv_hash_ok      TYPE abap_bool,
        lv_hash_msg     TYPE string,
        lv_cert         TYPE zbdc_cert_bup-cert_status,
        lv_prof_status  TYPE zbdc_prof_bup-status,
        lv_ts           TYPE zbdc_script_bup-changed_at,
        lt_steps        TYPE STANDARD TABLE OF zbdc_sct_ver_bup,
        ls_step         TYPE zbdc_sct_ver_bup,
        ls_script       TYPE ty_script_def_compat,
        ls_pending      TYPE zbdc_cert_bup.

  CLEAR: cv_ok, cv_message.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_ver IS INITIAL
     OR iv_script_id IS INITIAL OR ct_script IS INITIAL.
    cv_message = 'Technical contract repair requires an exact TCODE/Profile/Version/Script tuple.'.
    RETURN.
  ENDIF.

  CLEAR: lv_prof_status, ls_pending.
  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_prof_status
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.

  SELECT SINGLE *
    FROM zbdc_cert_bup
    INTO @ls_pending
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver
      AND cert_status  = 'PENDING_TEST'.

  CLEAR lv_changed.
  PERFORM fix_tech_steps
    CHANGING ct_script lv_changed.

  IF lv_changed <> abap_true.
 "a prior technical repair may already have rewritten the exact
 "TEST_READY script/hash while an older build deleted the PENDING_TEST
 "manifest. Recreate only that fail-closed manifest from the exact
 "TESTING tuple. This does not certify success or promote the profile.
    IF lv_prof_status = 'TESTING' AND
       ( ls_pending-script_id IS INITIAL OR
         ls_pending-contract_hash IS INITIAL OR
         ls_pending-script_id <> iv_script_id OR
         ls_pending-contract_hash <> cv_hash ).
      CLEAR ls_pending.
      ls_pending-tcode            = iv_tcode.
      ls_pending-profile_name     = iv_profile.
      ls_pending-profile_ver      = iv_ver.
      ls_pending-script_id        = iv_script_id.
      ls_pending-contract_hash    = cv_hash.
      ls_pending-cert_status      = 'PENDING_TEST'.
      ls_pending-last_test_status = 'PENDING_TEST'.
      ls_pending-last_test_message =
        'Exact S1 technical replay manifest restored; live certification is still required.'.
      ls_pending-cap_call_e       = 'X'.
      ls_pending-cap_update_s     = 'X'.
      GET TIME STAMP FIELD lv_ts.
      ls_pending-certified_by     = sy-uname.
      ls_pending-certified_at     = lv_ts.
      MODIFY zbdc_cert_bup FROM @ls_pending.
      IF sy-subrc <> 0.
        cv_message = 'Pending exact Script/Hash manifest could not be restored after technical replay repair.'.
        RETURN.
      ENDIF.
      COMMIT WORK AND WAIT.
    ENDIF.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  CLEAR lv_cert.
  SELECT SINGLE cert_status
    FROM zbdc_cert_bup
    INTO @lv_cert
    WHERE tcode            = @iv_tcode
      AND profile_name     = @iv_profile
      AND profile_ver      = @iv_ver
      AND cert_status      = 'CERTIFIED'
      AND last_test_status = 'CERTIFIED'.
  IF sy-subrc = 0.
    cv_message =
      |Certified contract { iv_profile } v{ iv_ver } contains legacy technical-step metadata and is immutable. Create a new candidate version.|.
    RETURN.
  ENDIF.

  CLEAR: lv_hash_new, lv_hash_ok, lv_hash_msg.
  PERFORM contract_hash_from_script
    USING    iv_tcode iv_profile iv_ver ct_script
    CHANGING lv_hash_new lv_hash_ok lv_hash_msg.
  IF lv_hash_ok <> abap_true OR lv_hash_new IS INITIAL.
    cv_message = lv_hash_msg.
    IF cv_message IS INITIAL.
      cv_message = 'Technical-step repair could not calculate the corrected contract hash.'.
    ENDIF.
    RETURN.
  ENDIF.

  REFRESH lt_steps.
  LOOP AT ct_script INTO ls_script.
    CLEAR ls_step.
    ls_step-script_id     = iv_script_id.
    ls_step-step_seq      = ls_script-step_seq.
    ls_step-is_new_screen = ls_script-is_new_screen.
    ls_step-field_name    = ls_script-field_name.
    ls_step-value_type    = ls_script-value_type.
    ls_step-static_value  = ls_script-static_value.
    ls_step-source_column = ls_script-source_column.
    ls_step-row_type      = ls_script-row_type.
    ls_step-program_name  = ls_script-program_name.
    ls_step-dynpro_no     = ls_script-dynpro_no.
    APPEND ls_step TO lt_steps.
  ENDLOOP.

  GET TIME STAMP FIELD lv_ts.

  DELETE FROM zbdc_sct_ver_bup
    WHERE script_id = @iv_script_id.
  INSERT zbdc_sct_ver_bup FROM TABLE @lt_steps.
  IF sy-subrc <> 0.
    ROLLBACK WORK.
    cv_message = 'Technical-step repair could not rewrite the exact Script Steps.'.
    RETURN.
  ENDIF.

  IF cv_hash IS INITIAL.
    UPDATE zbdc_script_bup
      SET contract_hash = @lv_hash_new,
          changed_by    = @sy-uname,
          changed_at    = @lv_ts
      WHERE script_id   = @iv_script_id
        AND tcode        = @iv_tcode
        AND profile_name = @iv_profile
        AND profile_ver  = @iv_ver.
  ELSE.
    UPDATE zbdc_script_bup
      SET contract_hash = @lv_hash_new,
          changed_by    = @sy-uname,
          changed_at    = @lv_ts
      WHERE script_id     = @iv_script_id
        AND tcode          = @iv_tcode
        AND profile_name   = @iv_profile
        AND profile_ver    = @iv_ver
        AND contract_hash  = @cv_hash.
  ENDIF.

  IF sy-subrc <> 0.
    ROLLBACK WORK.
    cv_message = 'Technical-step repair detected a concurrent Script change. Refresh and retry; nothing was overwritten.'.
    RETURN.
  ENDIF.

 "changing technical replay metadata invalidates prior runtime proof,
 "but a TESTING profile must retain an exact PENDING_TEST Script/Hash
 "manifest so the corrected template can be uploaded into a new session.
 "Never create CERTIFIED evidence here.
  IF lv_prof_status = 'TESTING'.
    IF ls_pending-script_id IS INITIAL.
      CLEAR ls_pending.
      ls_pending-tcode        = iv_tcode.
      ls_pending-profile_name = iv_profile.
      ls_pending-profile_ver  = iv_ver.
    ENDIF.
    ls_pending-script_id         = iv_script_id.
    ls_pending-contract_hash     = lv_hash_new.
    ls_pending-cert_status       = 'PENDING_TEST'.
    ls_pending-last_test_status  = 'PENDING_TEST'.
    ls_pending-last_test_message =
      'Technical RAW replay changed; exact live certification must run again.'.
    CLEAR: ls_pending-success_msgid, ls_pending-success_msgnr,
           ls_pending-object_msgv, ls_pending-cap_call_n,
           ls_pending-cap_call_a, ls_pending-cap_update_a,
           ls_pending-cap_sm35.
    ls_pending-cap_call_e   = 'X'.
    ls_pending-cap_update_s = 'X'.
    ls_pending-certified_by = sy-uname.
    ls_pending-certified_at = lv_ts.
    MODIFY zbdc_cert_bup FROM @ls_pending.
    IF sy-subrc <> 0.
      ROLLBACK WORK.
      cv_message = 'Corrected Script was not committed because its PENDING_TEST manifest could not be updated atomically.'.
      RETURN.
    ENDIF.
  ELSE.
    DELETE FROM zbdc_cert_bup
      WHERE tcode        = @iv_tcode
        AND profile_name = @iv_profile
        AND profile_ver  = @iv_ver.
  ENDIF.

  COMMIT WORK AND WAIT.

  cv_hash = lv_hash_new.
  IF gv_runtime_script_id = iv_script_id.
    gv_runtime_contract_hash = lv_hash_new.
  ENDIF.
  IF gv_z133_loaded_script_id = iv_script_id.
    gv_z133_loaded_hash       = lv_hash_new.
    gv_z133_loaded_changed_at = lv_ts.
  ENDIF.

  cv_ok = abap_true.
  cv_message = 'Technical BDC control metadata was repaired without changing recording evidence or Mapping fields.'.
ENDFORM.

*& Restore missing fail-closed TESTING manifest

*& A technical S1 replay repair can change only the exact Script hash.
*& The PENDING_TEST manifest is not certification evidence; it is the immutable
*& pointer required so a new upload/session can pin that corrected Script/Hash.
*& Recovery is allowed only for one exact TESTING + TEST_READY + current-S1
*& tuple whose persisted steps recompute to the stored hash. No TCODE/field
*& branch, latest-version lookup, APQI search or success promotion is allowed.

FORM restore_pending_manifest
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_prof_status TYPE zbdc_prof_bup-status,
        lt_script      TYPE ty_t_script,
        lv_script_id   TYPE zbdc_script_bup-script_id,
        lv_hash        TYPE zbdc_script_bup-contract_hash,
        lv_found       TYPE abap_bool,
        lv_calc_hash   TYPE zbdc_script_bup-contract_hash,
        lv_hash_ok     TYPE abap_bool,
        lv_hash_msg    TYPE string,
        lv_comp_ok     TYPE abap_bool,
        lv_comp_msg    TYPE string,
        ls_head        TYPE zbdc_script_bup,
        ls_cert        TYPE zbdc_cert_bup,
        lv_ts          TYPE timestampl.

  CLEAR: cv_ok, cv_message.

  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_prof_status
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver.
  IF sy-subrc <> 0 OR lv_prof_status <> 'TESTING'.
    cv_message = 'Missing manifest can be restored only for the exact TESTING profile version.'.
    RETURN.
  ENDIF.

  CLEAR ls_cert.
  SELECT SINGLE *
    FROM zbdc_cert_bup
    INTO @ls_cert
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver
      AND cert_status  = 'PENDING_TEST'.
  IF sy-subrc = 0 AND
     ls_cert-script_id IS NOT INITIAL AND
     ls_cert-contract_hash IS NOT INITIAL.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  REFRESH lt_script.
  CLEAR: lv_script_id, lv_hash, lv_found.
  PERFORM load_profile_script
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_script lv_script_id lv_hash lv_found.
  IF lv_found <> abap_true OR lt_script IS INITIAL OR
     lv_script_id IS INITIAL OR lv_hash IS INITIAL.
    cv_message = 'No unique exact Script/Hash exists for TESTING manifest recovery.'.
    RETURN.
  ENDIF.

  CLEAR: lv_comp_ok, lv_comp_msg.
  PERFORM compiler_cert_ok
    USING    lv_script_id
    CHANGING lv_comp_ok lv_comp_msg.
  IF lv_comp_ok <> abap_true.
    cv_message = lv_comp_msg.
    RETURN.
  ENDIF.

  CLEAR ls_head.
  SELECT SINGLE *
    FROM zbdc_script_bup
    INTO @ls_head
    WHERE script_id     = @lv_script_id
      AND tcode         = @iv_tcode
      AND profile_name  = @iv_profile
      AND profile_ver   = @iv_ver
      AND contract_hash = @lv_hash
      AND status        = 'TEST_READY'.
  IF sy-subrc <> 0.
    cv_message = 'Exact current-S1 Script is not in TEST_READY state; manifest recovery stopped.'.
    RETURN.
  ENDIF.

  CLEAR: lv_calc_hash, lv_hash_ok, lv_hash_msg.
  PERFORM contract_hash_from_script
    USING    iv_tcode iv_profile iv_ver lt_script
    CHANGING lv_calc_hash lv_hash_ok lv_hash_msg.
  IF lv_hash_ok <> abap_true OR lv_calc_hash IS INITIAL OR lv_calc_hash <> lv_hash.
    cv_message = lv_hash_msg.
    IF cv_message IS INITIAL.
      cv_message = 'Exact TEST_READY Script steps do not reproduce their stored contract hash.'.
    ENDIF.
    RETURN.
  ENDIF.

  CLEAR ls_cert.
  ls_cert-tcode             = iv_tcode.
  ls_cert-profile_name      = iv_profile.
  ls_cert-profile_ver       = iv_ver.
  ls_cert-script_id         = lv_script_id.
  ls_cert-contract_hash     = lv_hash.
  ls_cert-cert_status       = 'PENDING_TEST'.
  ls_cert-last_test_status  = 'PENDING_TEST'.
  ls_cert-last_test_message =
    'Exact S1 Script/Hash manifest restored after technical RAW replay repair; live certification is required.'.
  ls_cert-cap_call_e        = 'X'.
  ls_cert-cap_update_s      = 'X'.
  GET TIME STAMP FIELD lv_ts.
  ls_cert-certified_by      = sy-uname.
  ls_cert-certified_at      = lv_ts.

  MODIFY zbdc_cert_bup FROM @ls_cert.
  IF sy-subrc <> 0.
    cv_message = 'Exact PENDING_TEST Script/Hash manifest could not be restored.'.
    RETURN.
  ENDIF.

  COMMIT WORK AND WAIT.
  cv_ok = abap_true.
  cv_message = 'Exact PENDING_TEST Script/Hash manifest restored from the unique current-S1 TEST_READY contract.'.
ENDFORM.

FORM check_contract
  USING    pt_script TYPE ty_t_script
  CHANGING cv_ok         TYPE abap_bool
           cv_unresolved TYPE i
           cv_message    TYPE string.
  DATA: ls_script    TYPE ty_script_def_compat,
        lv_norm      TYPE zbdc_mapping_bup-bdc_field,
        lv_type      TYPE zbdc_sct_ver_bup-value_type,
        lv_source    TYPE zbdc_mapping_bup-source_column,
        lv_technical TYPE abap_bool,
        lv_helper    TYPE abap_bool,
        lv_helper_unsafe TYPE abap_bool,
        lv_helper_reason TYPE string,
        lv_list      TYPE string.
  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field WITH UNIQUE KEY table_line.
  CLEAR: cv_ok, cv_unresolved, cv_message.
  IF pt_script IS INITIAL. cv_message = 'The versioned script has no steps.'. RETURN. ENDIF.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      IF ls_script-program_name IS INITIAL OR ls_script-dynpro_no IS INITIAL.
        cv_message = |Screen step { ls_script-step_seq } has no Program/Dynpro.|. RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.
    IF ls_script-field_name IS INITIAL.
      cv_message = |Field step { ls_script-step_seq } has no FIELD_NAME.|. RETURN.
    ENDIF.
    lv_type = ls_script-value_type. TRANSLATE lv_type TO UPPER CASE. CONDENSE lv_type NO-GAPS.
    IF ls_script-field_name = 'BDC_CURSOR'.
 "S1/EXACT replays recorder navigation evidence losslessly.
 "BDC_CURSOR is technical (never mapped), but it is executable state,
 "therefore the captured target must remain STATIC instead of IGNORE.
      IF lv_type <> gc_vt_static OR ls_script-source_column IS NOT INITIAL.
        cv_message = 'BDC_CURSOR must remain STATIC and unmapped in an S1 executable contract.'. RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.
    IF ls_script-static_value CS gc_trace_token.
      IF lv_type <> gc_vt_static OR ls_script-source_column IS NOT INITIAL.
        cv_message = |Hidden trace carrier { ls_script-field_name } must remain STATIC and unmapped.|.
        RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.
    PERFORM mapping_field_is_technical USING ls_script-field_name CHANGING lv_technical.
    IF lv_technical = abap_true.
      IF lv_type <> gc_vt_static.
        cv_message = |Technical step { ls_script-field_name } must remain STATIC.|. RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_bdc_field USING ls_script-field_name CHANGING lv_norm.
    IF lv_norm IS INITIAL. cv_message = |Step { ls_script-step_seq } has an invalid BDC field.|. RETURN. ENDIF.

    CLEAR: lv_helper, lv_helper_unsafe, lv_helper_reason.
    PERFORM field_helper_role
      USING    pt_script lv_norm
      CHANGING lv_helper lv_helper_unsafe lv_helper_reason.
    IF lv_helper = abap_true AND lv_type = gc_vt_dynamic.
      cv_message = |Transient helper { lv_norm } cannot be DYNAMIC or exposed to Mapping/Template.|.
      RETURN.
    ENDIF.

    IF lv_type = gc_m2_vt_unresolved OR lv_type IS INITIAL.
      READ TABLE lt_seen WITH TABLE KEY table_line = lv_norm TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        INSERT lv_norm INTO TABLE lt_seen. cv_unresolved = cv_unresolved + 1.
        IF cv_unresolved <= 5.
          IF lv_list IS INITIAL. lv_list = lv_norm. ELSE. lv_list = lv_list && ', ' && lv_norm. ENDIF.
        ENDIF.
      ENDIF.
      CONTINUE.
    ENDIF.
    IF lv_type <> gc_vt_dynamic AND lv_type <> gc_vt_static AND lv_type <> gc_m2_vt_ignore.
      cv_message = |Unsupported VALUE_TYPE { lv_type } at { lv_norm }.|. RETURN.
    ENDIF.
    IF lv_type = gc_vt_dynamic.
      lv_source = ls_script-source_column.
      PERFORM normalize_mapping_source USING lv_source CHANGING lv_source.
      IF lv_source IS INITIAL. cv_message = |Dynamic field { lv_norm } has no SOURCE_COLUMN.|. RETURN. ENDIF.
    ENDIF.
  ENDLOOP.
  IF cv_unresolved > 0.
    cv_message = |Contract has { cv_unresolved } UNRESOLVED field(s): { lv_list }. Resolve them in Script Editor.|.
    RETURN.
  ENDIF.
  cv_ok = abap_true.
ENDFORM.

FORM normalize_editor
  CHANGING ct_script     TYPE ty_t_script
           cv_ok         TYPE abap_bool
           cv_unresolved TYPE i
           cv_message    TYPE string.
  DATA: ls_script    TYPE ty_script_def_compat,
        ls_occ       TYPE ty_script_def_compat,
        lv_norm      TYPE zbdc_mapping_bup-bdc_field,
        lv_row_norm  TYPE zbdc_mapping_bup-bdc_field,
        lv_type      TYPE zbdc_sct_ver_bup-value_type,
        lv_row_type  TYPE zbdc_sct_ver_bup-value_type,
        lv_source    TYPE zbdc_mapping_bup-source_column,
        lv_row_src   TYPE zbdc_mapping_bup-source_column,
        lv_technical TYPE abap_bool.
  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field WITH UNIQUE KEY table_line.
  FIELD-SYMBOLS <ls_script> TYPE ty_script_def_compat.
  CLEAR: cv_ok, cv_unresolved, cv_message.
  LOOP AT ct_script ASSIGNING <ls_script>.
    TRANSLATE <ls_script>-value_type TO UPPER CASE. CONDENSE <ls_script>-value_type NO-GAPS.
    IF <ls_script>-is_new_screen = 'X'.
      <ls_script>-value_type = gc_vt_static. CLEAR <ls_script>-source_column. CONTINUE.
    ENDIF.
    IF <ls_script>-field_name IS INITIAL.
      cv_message = |Step { <ls_script>-step_seq } has no FIELD_NAME.|. RETURN.
    ENDIF.
    IF <ls_script>-field_name = 'BDC_CURSOR'.
 "editor normalization must agree with S1 RAW-exact replay.
      <ls_script>-value_type = gc_vt_static. CLEAR <ls_script>-source_column. CONTINUE.
    ENDIF.
    IF <ls_script>-static_value CS gc_trace_token.
      <ls_script>-value_type = gc_vt_static.
      CLEAR <ls_script>-source_column.
      CONTINUE.
    ENDIF.
    PERFORM mapping_field_is_technical USING <ls_script>-field_name CHANGING lv_technical.
    IF lv_technical = abap_true.
      <ls_script>-value_type = gc_vt_static. CLEAR <ls_script>-source_column. CONTINUE.
    ENDIF.
    IF <ls_script>-value_type IS INITIAL. <ls_script>-value_type = gc_m2_vt_unresolved. ENDIF.
    IF <ls_script>-value_type <> gc_vt_dynamic
       AND <ls_script>-value_type <> gc_vt_static
       AND <ls_script>-value_type <> gc_m2_vt_ignore
       AND <ls_script>-value_type <> gc_m2_vt_unresolved.
      cv_message = |Step { <ls_script>-step_seq }: use DYNAMIC, STATIC, IGNORE, or UNRESOLVED.|. RETURN.
    ENDIF.
  ENDLOOP.
  LOOP AT ct_script INTO ls_script
    WHERE is_new_screen IS INITIAL AND field_name IS NOT INITIAL.
    PERFORM mapping_field_is_technical USING ls_script-field_name CHANGING lv_technical.
    IF lv_technical = abap_true OR ls_script-field_name = 'BDC_CURSOR'. CONTINUE. ENDIF.
    PERFORM normalize_mapping_bdc_field USING ls_script-field_name CHANGING lv_norm.
    READ TABLE lt_seen WITH TABLE KEY table_line = lv_norm TRANSPORTING NO FIELDS.
    IF sy-subrc = 0. CONTINUE. ENDIF.
    INSERT lv_norm INTO TABLE lt_seen.
    CLEAR: lv_type, lv_source.
    LOOP AT ct_script INTO ls_occ
      WHERE is_new_screen IS INITIAL AND field_name IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field USING ls_occ-field_name CHANGING lv_row_norm.
      IF lv_row_norm <> lv_norm. CONTINUE. ENDIF.
      lv_row_type = ls_occ-value_type. TRANSLATE lv_row_type TO UPPER CASE. CONDENSE lv_row_type NO-GAPS.
      IF lv_row_type = gc_m2_vt_unresolved OR lv_row_type IS INITIAL. CONTINUE. ENDIF.
      IF lv_type IS INITIAL. lv_type = lv_row_type.
      ELSEIF lv_type <> lv_row_type. cv_message = |Conflicting VALUE_TYPE decisions for { lv_norm }.|. RETURN.
      ENDIF.
      IF lv_row_type = gc_vt_dynamic.
        lv_row_src = ls_occ-source_column.
        PERFORM normalize_mapping_source USING lv_row_src CHANGING lv_row_src.
        IF lv_row_src IS INITIAL. cv_message = |Dynamic field { lv_norm } has no SOURCE_COLUMN.|. RETURN. ENDIF.
        IF lv_source IS INITIAL. lv_source = lv_row_src.
        ELSEIF lv_source <> lv_row_src. cv_message = |Conflicting SOURCE_COLUMN values for { lv_norm }.|. RETURN.
        ENDIF.
      ENDIF.
    ENDLOOP.
    IF lv_type IS INITIAL. cv_unresolved = cv_unresolved + 1. CONTINUE. ENDIF.
    LOOP AT ct_script ASSIGNING <ls_script>
      WHERE is_new_screen IS INITIAL AND field_name IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field USING <ls_script>-field_name CHANGING lv_row_norm.
      IF lv_row_norm <> lv_norm. CONTINUE. ENDIF.
      <ls_script>-value_type = lv_type.
      IF lv_type = gc_vt_dynamic. <ls_script>-source_column = lv_source.
      ELSE. CLEAR <ls_script>-source_column. ENDIF.
    ENDLOOP.
  ENDLOOP.
  cv_ok = abap_true.
  IF cv_unresolved > 0.
    cv_message = |Draft has { cv_unresolved } unresolved field(s); Mapping, Template, Activate, and Execute remain blocked.|.
  ELSE.
    cv_message = 'All business fields have one explicit consistent resolution.'.
  ENDIF.
ENDFORM.

FORM auto_classify_shdb_script
  USING    pt_previous TYPE ty_t_script
  CHANGING ct_script   TYPE ty_t_script
           cv_dynamic  TYPE i
           cv_static   TYPE i.

  DATA: ls_script      TYPE ty_script_def_compat,
        ls_prog        TYPE ty_script_def_compat,
        ls_meta        TYPE ty_map_meta,
        lt_meta        TYPE ty_t_map_meta,
        lv_bdc         TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_prog_norm   TYPE zbdc_mapping_bup-bdc_field,
        lv_type        TYPE zbdc_sct_ver_bup-value_type,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_found       TYPE abap_bool,
        lv_meta_found  TYPE abap_bool,
        lv_technical   TYPE abap_bool,
        lv_label       TYPE string,
        lv_rule        TYPE string,
        lv_datatype    TYPE dfies-datatype,
        lv_length      TYPE dfies-leng,
        lv_ddic_found  TYPE abap_bool,
        lv_origin      TYPE c LENGTH 20,
        lv_prog_param  TYPE abap_bool.

  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
               WITH UNIQUE KEY table_line.
  FIELD-SYMBOLS <ls_script> TYPE ty_script_def_compat.

  CLEAR: cv_dynamic, cv_static.
  PERFORM get_projection_origin CHANGING lv_origin.

  PERFORM read_mapping_metadata
    USING p_rec_tcode txtp_profile_name gv_profile_ver
    CHANGING lt_meta.

 "never destroy explicit RECORD-* provenance parsed from an SHDB
 "generated program. Guided Recording / TXT does not get this privilege.
  LOOP AT ct_script ASSIGNING <ls_script>.
    IF <ls_script>-is_new_screen = 'X'.
      <ls_script>-value_type = gc_vt_static.
      CLEAR <ls_script>-source_column.
      CONTINUE.
    ENDIF.

    IF <ls_script>-field_name = 'BDC_CURSOR'.
 "fresh SHDB acquisition keeps exact cursor/navigation state.
      <ls_script>-value_type = gc_vt_static.
      CLEAR <ls_script>-source_column.
      CONTINUE.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    <ls_script>-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      <ls_script>-value_type = gc_vt_static.
      CLEAR <ls_script>-source_column.
      CONTINUE.
    ENDIF.

    IF lv_origin = 'SHDB_PROGRAM'
       AND <ls_script>-value_type = gc_vt_dynamic
       AND <ls_script>-source_column IS NOT INITIAL.
      CONTINUE.
    ENDIF.

    <ls_script>-value_type = gc_m2_vt_unresolved.
    CLEAR <ls_script>-source_column.
  ENDLOOP.

  LOOP AT ct_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true OR ls_script-field_name = 'BDC_CURSOR'.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_bdc.
    IF lv_bdc IS INITIAL.
      CONTINUE.
    ENDIF.

    READ TABLE lt_seen WITH TABLE KEY table_line = lv_bdc
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT lv_bdc INTO TABLE lt_seen.

    CLEAR: lv_type, lv_source, lv_found, ls_meta, lv_meta_found,
           lv_prog_param.

 "Strongest automatic authority: exact parameterized RECORD-* field from
 "SHDB Program. Metadata/history is not allowed to broaden this set.
    IF lv_origin = 'SHDB_PROGRAM'.
      LOOP AT ct_script INTO ls_prog
        WHERE is_new_screen IS INITIAL
          AND field_name IS NOT INITIAL
          AND value_type = gc_vt_dynamic
          AND source_column IS NOT INITIAL.
        CLEAR lv_prog_norm.
        PERFORM normalize_mapping_bdc_field
          USING    ls_prog-field_name
          CHANGING lv_prog_norm.
        IF lv_prog_norm = lv_bdc.
          lv_type       = gc_vt_dynamic.
          lv_source     = ls_prog-source_column.
          lv_found      = abap_true.
          lv_prog_param = abap_true.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.

    IF lv_prog_param <> abap_true.
      PERFORM find_mapping_metadata
        USING lt_meta lv_bdc space space
        CHANGING ls_meta lv_meta_found.
      IF lv_meta_found = abap_true
         AND ( ls_meta-value_type = gc_vt_dynamic
               OR ls_meta-value_type = gc_vt_static ).
        lv_type   = ls_meta-value_type.
        lv_source = ls_meta-source_column.
        IF lv_type = gc_vt_dynamic AND lv_source IS INITIAL.
          CLEAR lv_type.
        ELSE.
          lv_found = abap_true.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lv_found <> abap_true.
      PERFORM prev_decision
        USING ct_script pt_previous lv_bdc
        CHANGING lv_type lv_source lv_found.
    ENDIF.

    IF lv_found <> abap_true.
      lv_type = gc_m2_vt_unresolved.
      CLEAR: lv_source, lv_label, lv_rule, lv_datatype, lv_length,
             lv_ddic_found.
      PERFORM get_ddic_field_traits
        USING lv_bdc ls_script-static_value
        CHANGING lv_source lv_label lv_rule lv_datatype lv_length
                 lv_ddic_found.
    ENDIF.

    LOOP AT ct_script ASSIGNING <ls_script>
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    <ls_script>-field_name
        CHANGING lv_norm.
      IF lv_norm <> lv_bdc.
        CONTINUE.
      ENDIF.

      <ls_script>-value_type = lv_type.
      IF lv_type = gc_vt_dynamic OR lv_type = gc_m2_vt_unresolved.
        <ls_script>-source_column = lv_source.
      ELSE.
        CLEAR <ls_script>-source_column.
      ENDIF.
    ENDLOOP.

    IF lv_type = gc_vt_dynamic.
      cv_dynamic = cv_dynamic + 1.
    ELSEIF lv_type = gc_vt_static.
      cv_static = cv_static + 1.
    ENDIF.
  ENDLOOP.

  PERFORM classify_script_item_block CHANGING ct_script.
ENDFORM.

FORM build_missing_metadata_message
  USING    iv_tcode  TYPE any
           it_missing TYPE ty_t_missing_bdc
  CHANGING cv_message TYPE string.

  DATA: lv_field TYPE zbdc_mapping_bup-bdc_field,
        lv_list  TYPE string,
        lv_count TYPE i.

  CLEAR cv_message.

  LOOP AT it_missing INTO lv_field.
    IF lv_count >= 6.
      EXIT.
    ENDIF.
    IF lv_list IS INITIAL.
      lv_list = lv_field.
    ELSE.
      lv_list = lv_list && ', ' && lv_field.
    ENDIF.
    lv_count = lv_count + 1.
  ENDLOOP.

  cv_message = |MISSING_METADATA: { lines( it_missing ) } field(s) for { iv_tcode }.|.
  IF lv_list IS NOT INITIAL.
    cv_message = cv_message && ' ' && lv_list && '.'.
  ENDIF.
  cv_message = cv_message &&
    ' Maintain metadata and rebuild; no draft data was changed.'.
ENDFORM.

FORM mapping_history_is_trusted
  USING    is_map TYPE zbdc_mapping_bup
  CHANGING cv_trusted TYPE abap_bool.

  DATA: lv_raw_source TYPE string,
        lv_exists     TYPE abap_bool,
        lv_technical  TYPE abap_bool,
        lv_script_id  TYPE zbdc_cert_bup-script_id.

  CLEAR cv_trusted.

  IF is_map-tcode IS INITIAL
     OR is_map-profile_name IS INITIAL
     OR is_map-profile_ver IS INITIAL
     OR is_map-source_column IS INITIAL
     OR is_map-staging_field IS INITIAL
     OR is_map-mandatory = gc_m2_map_review.
    RETURN.
  ENDIF.

  lv_raw_source = is_map-source_column.
  CONDENSE lv_raw_source NO-GAPS.
  IF lv_raw_source IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM mapping_staging_field_exists
    USING    is_map-staging_field
    CHANGING lv_exists.
  IF lv_exists <> abap_true.
    RETURN.
  ENDIF.

  IF is_map-bdc_field IS NOT INITIAL.
    PERFORM mapping_field_is_technical
      USING    is_map-bdc_field
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      RETURN.
    ENDIF.
  ENDIF.

 "Never inherit a DRAFT/MAPPED/legacy ACTIVE mapping merely because it
 "exists. Historical mapping is evidence only after exact runtime
 "certification of the same TCODE/Profile/Version.
  SELECT SINGLE script_id
    FROM zbdc_cert_bup
    INTO @lv_script_id
    WHERE tcode            = @is_map-tcode
      AND profile_name     = @is_map-profile_name
      AND profile_ver      = @is_map-profile_ver
      AND cert_status      = 'CERTIFIED'
      AND last_test_status = 'CERTIFIED'.
  IF sy-subrc <> 0 OR lv_script_id IS INITIAL.
    RETURN.
  ENDIF.

  cv_trusted = abap_true.
ENDFORM.

FORM ensure_editable_profile_ver
  CHANGING cv_tcode   TYPE zbdc_mapping_bup-tcode
           cv_profile TYPE zbdc_mapping_bup-profile_name
           cv_ver     TYPE zbdc_mapping_bup-profile_ver
           cv_created TYPE abap_bool.

  DATA: lv_status TYPE zbdc_prof_bup-status,
        lt_prof   TYPE STANDARD TABLE OF zbdc_prof_bup,
        lt_script TYPE STANDARD TABLE OF zbdc_script_bup,
        ls_prof   TYPE zbdc_prof_bup,
        ls_script TYPE zbdc_script_bup,
        lv_num    TYPE i,
        lv_max    TYPE i.

  CLEAR cv_created.

  SELECT SINGLE status FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @cv_tcode
      AND profile_name = @cv_profile
      AND profile_ver  = @cv_ver.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

 "Only immutable or already-testing versions require a new editable version.
  IF lv_status <> gc_m2_prof_active AND
     lv_status <> 'INACTIVE' AND
     lv_status <> 'TESTING'.
    RETURN.
  ENDIF.

 "Allocate against BOTH registries so an orphan Script Header cannot be
 "overwritten by a new mapping draft using the same numeric version.
  SELECT * FROM zbdc_prof_bup
    INTO TABLE @lt_prof
    WHERE tcode        = @cv_tcode
      AND profile_name = @cv_profile.

  LOOP AT lt_prof INTO ls_prof.
    lv_num = ls_prof-profile_ver.
    IF lv_num > lv_max.
      lv_max = lv_num.
    ENDIF.
  ENDLOOP.

  SELECT * FROM zbdc_script_bup
    INTO TABLE @lt_script
    WHERE tcode        = @cv_tcode
      AND profile_name = @cv_profile.

  LOOP AT lt_script INTO ls_script.
    lv_num = ls_script-profile_ver.
    IF lv_num > lv_max.
      lv_max = lv_num.
    ENDIF.
  ENDLOOP.

  lv_max = lv_max + 1.
  cv_ver = lv_max.
  cv_created = abap_true.
ENDFORM.

*& Exact-version Mapping idempotency guard
*& A complete Mapping already bound to the exact Script Version is reused.
*& Pressing Create Mapping Draft again never allocates a duplicate version.

FORM exact_mapping_complete
  USING    pt_script  TYPE ty_t_script
           pt_mapping TYPE ty_t_mapping_db
  CHANGING cv_complete TYPE abap_bool
           cv_message  TYPE string.

  TYPES: BEGIN OF ty_logical_map,
           logical_key TYPE zbdc_mapping_bup-bdc_field,
           source      TYPE zbdc_mapping_bup-source_column,
           staging     TYPE zbdc_mapping_bup-staging_field,
         END OF ty_logical_map.

  DATA: ls_script    TYPE ty_script_def_compat,
        ls_map       TYPE zbdc_mapping_bup,
        lv_logical   TYPE zbdc_mapping_bup-bdc_field,
        lv_technical TYPE abap_bool,
        lv_key_count TYPE i,
        ls_logical   TYPE ty_logical_map.

  DATA: lt_dynamic TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                     WITH UNIQUE KEY table_line,
        lt_mapped  TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                     WITH UNIQUE KEY table_line,
        lt_logical TYPE SORTED TABLE OF ty_logical_map
                     WITH UNIQUE KEY logical_key.

  CLEAR: cv_complete, cv_message.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL
      AND value_type = gc_vt_dynamic.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    ls_script-field_name
      CHANGING lv_logical.
    IF lv_logical IS NOT INITIAL.
      INSERT lv_logical INTO TABLE lt_dynamic.
    ENDIF.
  ENDLOOP.

  LOOP AT pt_mapping INTO ls_map.
    IF ls_map-staging_field = 'FIELD01'.
      IF ls_map-bdc_field IS INITIAL AND
         ls_map-source_column IS NOT INITIAL AND
         ls_map-mandatory = 'X'.
        lv_key_count = lv_key_count + 1.
      ELSE.
        cv_message = 'Existing business-key Mapping row is inconsistent.'.
        RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_map-source_column IS INITIAL OR
       ls_map-staging_field IS INITIAL OR
       ls_map-bdc_field IS INITIAL.
      cv_message = 'Existing Mapping contains an incomplete business row.'.
      RETURN.
    ENDIF.

    PERFORM logical_bdc_key
      USING    ls_map-bdc_field
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      cv_message = 'Existing Mapping contains an invalid BDC field.'.
      RETURN.
    ENDIF.

    READ TABLE lt_logical INTO ls_logical
      WITH TABLE KEY logical_key = lv_logical.
    IF sy-subrc = 0.
 "older drafts with separate indexed/unindexed rows are stale.
      cv_message = |Existing Mapping contains duplicate logical field { lv_logical }; rebuild required.|.
      RETURN.
    ENDIF.

    CLEAR ls_logical.
    ls_logical-logical_key = lv_logical.
    ls_logical-source      = ls_map-source_column.
    ls_logical-staging     = ls_map-staging_field.
    INSERT ls_logical INTO TABLE lt_logical.
    INSERT lv_logical INTO TABLE lt_mapped.
  ENDLOOP.

  IF lv_key_count <> 1.
    cv_message = 'Existing Mapping must contain exactly one business-key row.'.
    RETURN.
  ENDIF.

  IF lines( lt_dynamic ) <> lines( lt_mapped ).
    cv_message = 'Existing Mapping does not cover the logical Dynamic Script contract.'.
    RETURN.
  ENDIF.

  LOOP AT lt_dynamic INTO lv_logical.
    READ TABLE lt_mapped
      WITH TABLE KEY table_line = lv_logical
      TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      cv_message = |Existing Mapping is missing logical field { lv_logical }.|.
      RETURN.
    ENDIF.
  ENDLOOP.

  cv_complete = abap_true.
  cv_message = 'Exact Script Version already has a complete logical Mapping contract.'.
ENDFORM.

FORM create_mapping_draft.
  DATA: lt_script        TYPE STANDARD TABLE OF ty_script_def_compat,
        lt_script_new    TYPE STANDARD TABLE OF ty_script_def_compat,
        lt_history       TYPE STANDARD TABLE OF zbdc_mapping_bup,
        lt_current       TYPE STANDARD TABLE OF zbdc_mapping_bup,
        lt_draft         TYPE STANDARD TABLE OF zbdc_mapping_bup,
