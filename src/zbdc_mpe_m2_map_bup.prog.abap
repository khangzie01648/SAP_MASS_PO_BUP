FORM get_gmail_default_to
  CHANGING cv_email TYPE string.

  CLEAR cv_email.

  PERFORM get_optional_config
    USING    'TEMPLATE_GMAIL_TO'
    CHANGING cv_email.

  CONDENSE cv_email NO-GAPS.
ENDFORM.

FORM validate_single_email
  USING    iv_email TYPE string
  CHANGING cv_ok    TYPE abap_bool.

  DATA: lv_email    TYPE string,
        lv_allowed  TYPE string,
        lv_len      TYPE i,
        lv_at_cnt   TYPE i,
        lv_at_pos   TYPE i,
        lv_dot_pos  TYPE i,
        lv_last_pos TYPE i,
        lv_scan_pos TYPE i.

  CLEAR cv_ok.
  lv_email = iv_email.
  CONDENSE lv_email.

  IF lv_email IS INITIAL.
    RETURN.
  ENDIF.

  lv_allowed =
    'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.!#$%&''*+/=?^_`{|}~-@'.

  IF lv_email CN lv_allowed.
    RETURN.
  ENDIF.

  lv_len      = strlen( lv_email ).
  lv_last_pos = lv_len - 1.

  FIND ALL OCCURRENCES OF '@'
    IN lv_email MATCH COUNT lv_at_cnt.
  FIND FIRST OCCURRENCE OF '@'
    IN lv_email MATCH OFFSET lv_at_pos.

  lv_dot_pos  = -1.
  lv_scan_pos = lv_last_pos.
  WHILE lv_scan_pos >= 0.
    IF lv_email+lv_scan_pos(1) = '.'.
      lv_dot_pos = lv_scan_pos.
      EXIT.
    ENDIF.
    lv_scan_pos = lv_scan_pos - 1.
  ENDWHILE.

  IF lv_at_cnt <> 1
  OR lv_at_pos <= 0
  OR lv_dot_pos <= lv_at_pos + 1
  OR lv_dot_pos >= lv_len - 1
  OR lv_email+0(1) = '.'
  OR lv_email+lv_last_pos(1) = '.'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

FORM ask_gmail_recipient
  CHANGING cv_email TYPE string
           cv_ok    TYPE abap_bool.

  DATA: lt_sval     TYPE STANDARD TABLE OF sval,
        ls_sval     TYPE sval,
        lv_ret      TYPE c,
        lv_email_ok TYPE abap_bool.

  CLEAR: cv_email, cv_ok.

  PERFORM get_gmail_default_to CHANGING cv_email.

  CLEAR ls_sval.
  "Use SAP's standard e-mail address DDIC field for the popup so SAP does not
  "uppercase the address during PAI. Keep the user-entered e-mail text exactly
  "as typed, except for the existing surrounding-space cleanup below.
  ls_sval-tabname   = 'ADR6'.
  ls_sval-fieldname = 'SMTP_ADDR'.
  ls_sval-fieldtext = 'Recipient email'.
  ls_sval-value     = cv_email.
  APPEND ls_sval TO lt_sval.

  CALL FUNCTION 'POPUP_GET_VALUES'
    EXPORTING
      popup_title = 'Gmail Data Entry Request'
    IMPORTING
      returncode  = lv_ret
    TABLES
      fields      = lt_sval.

  IF lv_ret = 'A'.
    MESSAGE s327(zbdc).
    RETURN.
  ENDIF.

  READ TABLE lt_sval INTO ls_sval INDEX 1.
  IF sy-subrc <> 0.
    MESSAGE s328(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  cv_email = ls_sval-value.
  CONDENSE cv_email.

  PERFORM validate_single_email
    USING    cv_email
    CHANGING lv_email_ok.

  IF lv_email_ok <> abap_true.
    MESSAGE s329(zbdc)
      DISPLAY LIKE 'E'.
    CLEAR cv_email.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

FORM create_request_identity
  CHANGING cv_request_id TYPE string
           cv_form_token TYPE string
           cv_ok         TYPE abap_bool.

  DATA: lv_uuid_1 TYPE string,
        lv_uuid_2 TYPE string.

  CLEAR: cv_request_id, cv_form_token, cv_ok.

  TRY.
      lv_uuid_1 = cl_system_uuid=>create_uuid_c32_static( ).
      lv_uuid_2 = cl_system_uuid=>create_uuid_c32_static( ).
    CATCH cx_uuid_error INTO DATA(lx_uuid).
      DATA(lv_zmsg330_text) = lx_uuid->get_text( ).
      MESSAGE s330(zbdc)
        WITH lv_zmsg330_text
        DISPLAY LIKE 'E'.
      RETURN.
  ENDTRY.

  TRANSLATE lv_uuid_1 TO UPPER CASE.
  TRANSLATE lv_uuid_2 TO UPPER CASE.

  cv_request_id = |GMAIL_REQ_{ lv_uuid_1 }|.
  cv_form_token = lv_uuid_1 && lv_uuid_2.

  IF strlen( cv_form_token ) < 32.
    CLEAR: cv_request_id, cv_form_token.
    MESSAGE s729(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

FORM build_expiry
  USING    iv_ttl_hours TYPE i
  CHANGING cv_expires_at TYPE string
           cv_ok         TYPE abap_bool.

  DATA: lv_now         TYPE timestampl,
        lv_expiry      TYPE timestampl,
        lv_seconds     TYPE i,
        lv_expiry_date TYPE sy-datum,
        lv_expiry_time TYPE sy-uzeit,
        lv_date_text   TYPE c LENGTH 8,
        lv_time_text   TYPE c LENGTH 6.

  CLEAR: cv_expires_at, cv_ok.

  IF iv_ttl_hours <= 0.
    RETURN.
  ENDIF.

  GET TIME STAMP FIELD lv_now.
  IF lv_now IS INITIAL.
    MESSAGE s331(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lv_seconds = iv_ttl_hours * 3600.

  TRY.
      lv_expiry = cl_abap_tstmp=>add(
        tstmp = lv_now
        secs  = lv_seconds ).
    CATCH cx_root INTO DATA(lx_tstmp).
      DATA(lv_zmsg332_text) = lx_tstmp->get_text( ).
      MESSAGE s332(zbdc)
        WITH lv_zmsg332_text
        DISPLAY LIKE 'E'.
      RETURN.
  ENDTRY.

  CONVERT TIME STAMP lv_expiry TIME ZONE 'UTC'
    INTO DATE lv_expiry_date TIME lv_expiry_time.
  IF sy-subrc <> 0
  OR lv_expiry_date IS INITIAL
  OR lv_expiry_time IS INITIAL.
    MESSAGE s333(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lv_date_text = lv_expiry_date.
  lv_time_text = lv_expiry_time.

  cv_expires_at =
    |{ lv_date_text+0(4) }-{ lv_date_text+4(2) }-{ lv_date_text+6(2) }T| &&
    |{ lv_time_text+0(2) }:{ lv_time_text+2(2) }:{ lv_time_text+4(2) }Z|.

  cv_ok = abap_true.
ENDFORM.

FORM validate_field_name
  USING    iv_name TYPE string
  CHANGING cv_ok   TYPE abap_bool.

  DATA: lv_len          TYPE i,
        lv_offset       TYPE i,
        lv_char         TYPE c LENGTH 1,
        lv_first_chars  TYPE string,
        lv_other_chars  TYPE string.

  CLEAR cv_ok.

  lv_len = strlen( iv_name ).
  IF lv_len < 1 OR lv_len > 60.
    RETURN.
  ENDIF.

  lv_first_chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.
  lv_other_chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'.

  lv_char = iv_name+0(1).
  IF lv_char CN lv_first_chars.
    RETURN.
  ENDIF.

  lv_offset = 1.
  WHILE lv_offset < lv_len.
    lv_char = iv_name+lv_offset(1).
    IF lv_char CN lv_other_chars.
      RETURN.
    ENDIF.
    lv_offset = lv_offset + 1.
  ENDWHILE.

  cv_ok = abap_true.
ENDFORM.

FORM log_gmail_delivery
  USING iv_request_id TYPE string
        iv_tcode      TYPE zbdc_prof_bup-tcode
        iv_msg_type   TYPE symsgty
        iv_status     TYPE string
        iv_message    TYPE string.

  DATA: ls_result TYPE zbdc_result_bup,
        lv_ts     TYPE tzntstmps,
        lv_msg    TYPE string.

  IF iv_request_id IS INITIAL.
    RETURN.
  ENDIF.

  GET TIME STAMP FIELD lv_ts.
  lv_msg = iv_message.

  CLEAR ls_result.
  ls_result-session_id  = iv_request_id.
  ls_result-row_index   = 0.
  ls_result-record_key  = '__GMAIL_FORM__'.
  ls_result-tcode       = iv_tcode.
  ls_result-msg_type    = iv_msg_type.
  ls_result-message     = lv_msg.
  ls_result-exec_status = iv_status.
  ls_result-created_at  = lv_ts.
  ls_result-step        = 0.

  INSERT zbdc_result_bup FROM ls_result.
  IF sy-subrc <> 0.
    MODIFY zbdc_result_bup FROM ls_result.
  ENDIF.

  COMMIT WORK AND WAIT.
ENDFORM.

FORM send_gmail_form_request
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
           it_fields  TYPE ty_t_xlsx_field
  CHANGING cv_ok      TYPE abap_bool.

  TYPES: BEGIN OF ty_z196_recipient,
           email TYPE string,
         END OF ty_z196_recipient.

  TYPES: BEGIN OF ty_z196_contract,
           tcode         TYPE string,
           profile       TYPE string,
           version       TYPE string,
           template_id   TYPE string,
           script_id     TYPE string,
           contract_hash TYPE string,
         END OF ty_z196_contract.

  TYPES: BEGIN OF ty_z196_schema,
           fields               TYPE ty_t_z196_gmail_field,
           field_count          TYPE i,
           required_field_count TYPE i,
         END OF ty_z196_schema.

  TYPES: BEGIN OF ty_z196_context,
           sap_user     TYPE string,
           sap_client   TYPE string,
           source       TYPE string,
           generated_at TYPE string,
         END OF ty_z196_context.

  TYPES: BEGIN OF ty_z196_request,
           action     TYPE string,
           request_id TYPE string,
           form_token TYPE string,
           expires_at TYPE string,
           recipient  TYPE ty_z196_recipient,
           contract   TYPE ty_z196_contract,
           schema     TYPE ty_z196_schema,
           context    TYPE ty_z196_context,
         END OF ty_z196_request.

  TYPES: BEGIN OF ty_z196_response_schema,
           field_count          TYPE i,
           required_field_count TYPE i,
         END OF ty_z196_response_schema.

  TYPES: BEGIN OF ty_z196_response,
           ok                  TYPE abap_bool,
           action              TYPE string,
           request_id          TYPE string,
           status              TYPE string,
           error_code          TYPE string,
           retryable           TYPE abap_bool,
           recipient           TYPE ty_z196_recipient,
           form_url            TYPE string,
           expires_at          TYPE string,
           provider_message_id TYPE string,
           thread_id           TYPE string,
           contract            TYPE ty_z196_contract,
           schema              TYPE ty_z196_response_schema,
           message             TYPE string,
         END OF ty_z196_response.

  DATA: lo_client          TYPE REF TO if_http_client,
        lv_url             TYPE string,
        lv_header_name     TYPE string,
        lv_header_value    TYPE string,
        lv_header_ok       TYPE abap_bool,
        lv_action          TYPE string,
        lv_recipient       TYPE string,
        lv_recipient_ok    TYPE abap_bool,
        lv_timeout         TYPE i,
        lv_timeout_ok      TYPE abap_bool,
        lv_ttl_hours       TYPE i,
        lv_ttl_ok          TYPE abap_bool,
        lv_request_id      TYPE string,
        lv_form_token      TYPE string,
        lv_identity_ok     TYPE abap_bool,
        lv_expires_at      TYPE string,
        lv_expiry_ok       TYPE abap_bool,
        lv_generated_at    TYPE string,
        lv_contract_hash   TYPE string,
        lv_template_id     TYPE string,
        lv_body            TYPE string,
        lv_response_text   TYPE string,
        lv_http_code       TYPE i,
        lv_send_rc         TYPE sy-subrc,
        lv_receive_rc      TYPE sy-subrc,
        lv_json_error      TYPE string,
        lv_error_message   TYPE string,
        lv_audit_message   TYPE string,
        lv_field_name      TYPE string,
        lv_rule_upper      TYPE string,
        lv_source_upper    TYPE string,
        lv_schema_type     TYPE string,
        lv_field_name_ok   TYPE abap_bool,
        lv_field_count     TYPE i,
        lv_required_count  TYPE i,
        ls_field           TYPE ty_xlsx_field,
        ls_schema_field    TYPE ty_z196_gmail_field,
        ls_request         TYPE ty_z196_request,
        ls_response        TYPE ty_z196_response.

  CLEAR cv_ok.

  IF it_fields IS INITIAL.
    MESSAGE s334(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  PERFORM get_n8n_gmail_webhook CHANGING lv_url.
  IF lv_url IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_gmail_header
    CHANGING lv_header_name lv_header_value lv_header_ok.
  IF lv_header_ok <> abap_true.
    RETURN.
  ENDIF.

  PERFORM get_gmail_action CHANGING lv_action.
  IF lv_action IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_gmail_timeout
    CHANGING lv_timeout lv_timeout_ok.
  IF lv_timeout_ok <> abap_true.
    RETURN.
  ENDIF.

  PERFORM get_form_ttl_hours
    CHANGING lv_ttl_hours lv_ttl_ok.
  IF lv_ttl_ok <> abap_true.
    RETURN.
  ENDIF.

  PERFORM ask_gmail_recipient
    CHANGING lv_recipient lv_recipient_ok.
  IF lv_recipient_ok <> abap_true.
    RETURN.
  ENDIF.

  PERFORM create_request_identity
    CHANGING lv_request_id lv_form_token lv_identity_ok.
  IF lv_identity_ok <> abap_true.
    RETURN.
  ENDIF.

  PERFORM build_expiry
    USING    lv_ttl_hours
    CHANGING lv_expires_at lv_expiry_ok.
  IF lv_expiry_ok <> abap_true.
    RETURN.
  ENDIF.

  CLEAR ls_request-schema-fields.

  LOOP AT it_fields INTO ls_field.
    CLEAR: ls_schema_field, lv_field_name,
           lv_rule_upper, lv_source_upper, lv_schema_type.

    lv_field_name = ls_field-source_column.
    CONDENSE lv_field_name NO-GAPS.
    TRANSLATE lv_field_name TO UPPER CASE.

    PERFORM validate_field_name
      USING    lv_field_name
      CHANGING lv_field_name_ok.
    IF lv_field_name_ok <> abap_true.
      MESSAGE s335(zbdc)
        WITH lv_field_name
        DISPLAY LIKE 'E'.
      CLEAR lv_header_value.
      RETURN.
    ENDIF.

    lv_source_upper = lv_field_name.
    lv_rule_upper   = ls_field-rule_text.
    TRANSLATE lv_rule_upper TO UPPER CASE.

    "14D: Gmail/portal is an ingestion channel, not the business validator.
    "Do not infer HTML input types from friendly names/rule prose (for example
    ""Street and House Number" must never become DECIMAL because it contains
    "NUMBER). Keep transport input permissive; exact format/DDIC/master/runtime
    "validation remains owned by Staging validation after ingestion.
    lv_schema_type = 'TEXT'.

    lv_field_count = lv_field_count + 1.

    ls_schema_field-name                 = lv_field_name.
    ls_schema_field-label                = ls_field-display_label.
    IF ls_schema_field-label IS INITIAL.
      ls_schema_field-label = lv_field_name.
      REPLACE ALL OCCURRENCES OF '_'
        IN ls_schema_field-label WITH space.
    ENDIF.
    ls_schema_field-position             = lv_field_count.
    ls_schema_field-data_type            = lv_schema_type.
    ls_schema_field-max_length           = 0.
    ls_schema_field-normalized_bdc_field = ls_field-bdc_field.

    "The transport/form layer never owns blank eligibility. Investigation
    "+ actual-data contract validation decides it per Business Group/row.
    ls_schema_field-required = abap_false.

    APPEND ls_schema_field TO ls_request-schema-fields.
  ENDLOOP.

  IF lv_field_count <= 0.
    MESSAGE s336(zbdc)
      DISPLAY LIKE 'E'.
    CLEAR lv_header_value.
    RETURN.
  ENDIF.

  lv_contract_hash = gv_runtime_contract_hash.
  PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  lv_generated_at  = |{ gv_demo_date_837 }T{ gv_demo_time_837 }|.

  CLEAR: ls_request-action,
         ls_request-request_id,
         ls_request-form_token,
         ls_request-expires_at,
         ls_request-recipient,
         ls_request-contract,
         ls_request-context.

  ls_request-action     = lv_action.
  ls_request-request_id = lv_request_id.
  ls_request-form_token = lv_form_token.
  ls_request-expires_at = lv_expires_at.

  ls_request-recipient-email = lv_recipient.

  PERFORM template_name
    USING    iv_tcode iv_profile iv_ver space
    CHANGING lv_template_id.

  ls_request-contract-tcode         = iv_tcode.
  ls_request-contract-profile       = iv_profile.
  ls_request-contract-version       = iv_ver.
  ls_request-contract-template_id   = lv_template_id.
  ls_request-contract-script_id     = gv_runtime_script_id.
  ls_request-contract-contract_hash = lv_contract_hash.

  ls_request-schema-field_count          = lv_field_count.
  ls_request-schema-required_field_count = lv_required_count.

  ls_request-context-sap_user     = sy-uname.
  ls_request-context-sap_client   = sy-mandt.
  ls_request-context-source       = 'SAP_ABAP_DYNAMIC_FORM'.
  ls_request-context-generated_at = lv_generated_at.

  TRY.
      lv_body = /ui2/cl_json=>serialize(
        data        = ls_request
        compress    = abap_true
        pretty_name = /ui2/cl_json=>pretty_mode-camel_case ).
    CATCH cx_root INTO DATA(lx_serialize).
      DATA(lv_zmsg337_text) = lx_serialize->get_text( ).
      MESSAGE s337(zbdc)
        WITH lv_zmsg337_text
        DISPLAY LIKE 'E'.
      CLEAR: lv_header_value, lv_form_token.
      RETURN.
  ENDTRY.

  IF lv_body IS INITIAL
  OR lv_body NS '"formToken"'
  OR lv_body NS '"expiresAt"'
  OR lv_body NS '"fields"'
  OR lv_body NS '"requestId"'.
    MESSAGE s338(zbdc)
      DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  cl_http_client=>create_by_url(
    EXPORTING
      url    = lv_url
    IMPORTING
      client = lo_client
    EXCEPTIONS
      OTHERS = 1 ).
  IF sy-subrc <> 0 OR lo_client IS INITIAL.
    MESSAGE s339(zbdc)
      DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  lo_client->propertytype_redirect = lo_client->co_enabled.
  lo_client->request->set_method( 'POST' ).
  lo_client->request->set_header_field(
    name  = 'Content-Type'
    value = 'application/json; charset=utf-8' ).
  lo_client->request->set_header_field(
    name  = 'Accept'
    value = 'application/json' ).
  lo_client->request->set_header_field(
    name  = lv_header_name
    value = lv_header_value ).
  lo_client->request->set_header_field(
    name  = 'X-SAP-BDC-Request-ID'
    value = lv_request_id ).
  lo_client->request->set_cdata( lv_body ).

  lo_client->send(
    EXPORTING
      timeout = lv_timeout
    EXCEPTIONS
      OTHERS = 1 ).
  lv_send_rc = sy-subrc.

  IF lv_send_rc <> 0.
    lo_client->close( ).
    DATA(lv_zm879_36404_1) = |{ lv_send_rc }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '879'
      WITH lv_zm879_36404_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  lo_client->receive( EXCEPTIONS OTHERS = 1 ).
  lv_receive_rc = sy-subrc.

  IF lv_receive_rc <> 0.
    lo_client->close( ).
    DATA(lv_zm880_36418_1) = |{ lv_receive_rc }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '880'
      WITH lv_zm880_36418_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  lo_client->response->get_status(
    IMPORTING code = lv_http_code ).
  lv_response_text = lo_client->response->get_cdata( ).
  lo_client->close( ).

  CLEAR: ls_response, lv_json_error.

  TRY.
      /ui2/cl_json=>deserialize(
        EXPORTING
          json        = lv_response_text
          pretty_name = /ui2/cl_json=>pretty_mode-camel_case
        CHANGING
          data        = ls_response ).
    CATCH cx_root INTO DATA(lx_json).
      lv_json_error = lx_json->get_text( ).
  ENDTRY.

  IF lv_json_error IS INITIAL.
    TRANSLATE ls_response-status TO UPPER CASE.
  ENDIF.

  "16L: a Gmail bounce is an asynchronous delivery result, not a transport
  "failure. n8n returns INVALID_RECIPIENT with a non-2xx HTTP status so that
  "SAP must surface the recipient error immediately instead of reporting the
  "earlier Gmail API acceptance as success.
  IF lv_json_error IS INITIAL
     AND ls_response-status = 'INVALID_RECIPIENT'.
    lv_error_message = ls_response-message.
    IF lv_error_message IS INITIAL.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '881' INTO lv_error_message.
    ENDIF.
    IF strlen( lv_error_message ) > 180.
      lv_error_message = lv_error_message(180).
    ENDIF.

    lv_audit_message =
      |GMAIL_FORM;REQUEST={ lv_request_id };STATUS=INVALID_RECIPIENT;| &&
      |HTTP={ lv_http_code };ERROR={ ls_response-error_code };| &&
      |TO={ lv_recipient };MESSAGE={ lv_error_message }|.

    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E'
            'INVALID_RECIPIENT' lv_audit_message.

    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  IF lv_http_code < 200 OR lv_http_code >= 300.
    lv_error_message = ls_response-message.
    IF lv_error_message IS INITIAL.
      lv_error_message = ls_response-error_code.
    ENDIF.
    IF lv_error_message IS INITIAL.
      lv_error_message = lv_response_text.
    ENDIF.
    IF strlen( lv_error_message ) > 180.
      lv_error_message = lv_error_message(180).
    ENDIF.

    lv_audit_message =
      |GMAIL_FORM;REQUEST={ lv_request_id };HTTP={ lv_http_code };| &&
      |ERROR={ ls_response-error_code };MESSAGE={ lv_error_message }|.

    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_audit_message.

    MESSAGE s340(zbdc)
      WITH lv_http_code lv_error_message
      DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  IF lv_json_error IS NOT INITIAL.
    DATA(lv_zm882_36505_1) = |{ lv_json_error }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '882'
      WITH lv_zm882_36505_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  IF ls_response-ok <> abap_true.
    lv_error_message = ls_response-message.
    IF lv_error_message IS INITIAL.
      lv_error_message = ls_response-error_code.
    ENDIF.
    IF lv_error_message IS INITIAL.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '883' INTO lv_error_message.
    ENDIF.
    IF strlen( lv_error_message ) > 180.
      lv_error_message = lv_error_message(180).
    ENDIF.

    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  IF ls_response-request_id <> lv_request_id.
    DATA(lv_zm884_36535_1) = |{ lv_request_id }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '884'
      WITH lv_zm884_36535_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  IF ls_response-action <> lv_action.
    DATA(lv_zm885_36545_1) = |{ lv_request_id }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '885'
      WITH lv_zm885_36545_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  "The Gmail API accepting a send request is not proof that the mailbox
  "exists. The n8n contract therefore returns DELIVERY_PENDING when no bounce
  "was detected in the verification window. RECIPIENT_CONFIRMED is reserved
  "for a future stronger proof (for example, recipient form interaction).
  IF ls_response-status <> 'DELIVERY_PENDING'
     AND ls_response-status <> 'RECIPIENT_CONFIRMED'.
    DATA(lv_zm886_36560_1) = |{ ls_response-status }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '886'
      WITH lv_zm886_36560_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  IF ls_response-form_url IS INITIAL
  OR ( ls_response-provider_message_id IS INITIAL
       AND ls_response-thread_id IS INITIAL ).
    DATA(lv_zm887_36572_1) = |{ lv_request_id }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '887'
      WITH lv_zm887_36572_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  IF ls_response-recipient-email IS NOT INITIAL
  AND ls_response-recipient-email <> lv_recipient.
    DATA(lv_zm888_36583_1) = |{ lv_request_id }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '888'
      WITH lv_zm888_36583_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  IF ls_response-contract-tcode IS NOT INITIAL
  AND ls_response-contract-tcode <> iv_tcode.
    DATA(lv_zm889_36594_1) = |{ lv_request_id }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '889'
      WITH lv_zm889_36594_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  IF ls_response-schema-field_count > 0
  AND ls_response-schema-field_count <> lv_field_count.
    DATA(lv_zm890_36605_1) = |{ lv_request_id }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '890'
      WITH lv_zm890_36605_1 INTO lv_error_message.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'E' 'ERROR' lv_error_message.
    PERFORM userize_ui_message USING lv_error_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    CLEAR: lv_header_value, lv_form_token.
    RETURN.
  ENDIF.

  lv_audit_message =
    |GMAIL_FORM;REQUEST={ lv_request_id };STATUS={ ls_response-status };| &&
    |MAIL_ID={ ls_response-provider_message_id };| &&
    |THREAD_ID={ ls_response-thread_id };TO={ lv_recipient };| &&
    |FIELDS={ lv_field_count };REQUIRED={ lv_required_count }|.

  IF ls_response-status = 'RECIPIENT_CONFIRMED'.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'S'
            'RECIPIENT_CONFIRMED' lv_audit_message.

    cv_ok = abap_true.

    DATA(lv_zm742_36627_1) = |{ lv_recipient }|.
    DATA(lv_zm742_36627_2) = |{ lv_request_id }|.
    MESSAGE s742(zbdc) WITH lv_zm742_36627_1 lv_zm742_36627_2.
  ELSE.
    "No rejection was found in the verification window. Show the normal SAP
    "success color (green) while keeping DELIVERY_PENDING as the technical
    "status so we do not falsely claim confirmed delivery.
    PERFORM log_gmail_delivery
      USING lv_request_id iv_tcode 'S'
            'DELIVERY_PENDING' lv_audit_message.

    cv_ok = abap_true.

    DATA(lv_zm743_36640_1) = |{ lv_recipient }|.
    MESSAGE s743(zbdc) WITH lv_zm743_36640_1.
  ENDIF.

 "Remove sensitive values from local memory after the HTTP round trip.
  CLEAR: lv_header_value, lv_form_token.
ENDFORM.
