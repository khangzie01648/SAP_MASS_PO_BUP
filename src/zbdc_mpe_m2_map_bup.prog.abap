        ls_script        TYPE ty_script_def_compat,
        ls_map           TYPE zbdc_mapping_bup,
        ls_hist          TYPE zbdc_mapping_bup,
        ls_meta          TYPE ty_map_meta,
        lv_tcode         TYPE zbdc_mapping_bup-tcode,
        lv_profile       TYPE zbdc_mapping_bup-profile_name,
        lv_ver           TYPE zbdc_mapping_bup-profile_ver,
        lv_ok            TYPE abap_bool,
        lv_existing      TYPE i,
        lv_answer        TYPE c LENGTH 1,
        lv_bdc_norm      TYPE zbdc_mapping_bup-bdc_field,
        lv_logical_key   TYPE zbdc_mapping_bup-bdc_field,
        lv_map_bdc       TYPE zbdc_mapping_bup-bdc_field,
        lv_hist_norm     TYPE zbdc_mapping_bup-bdc_field,
        lv_hist_logical  TYPE zbdc_mapping_bup-bdc_field,
        lv_source        TYPE zbdc_mapping_bup-source_column,
        lv_staging       TYPE zbdc_mapping_bup-staging_field,
        lv_business_src  TYPE zbdc_mapping_bup-source_column,
        lv_slot_try      TYPE zbdc_mapping_bup-staging_field,
        lv_slot_exists   TYPE abap_bool,
        lv_technical     TYPE abap_bool,
        lv_trusted       TYPE abap_bool,
        lv_meta_found    TYPE abap_bool,
        lv_contract_ok   TYPE abap_bool,
        lv_contract_reason TYPE string,
        lv_source_tech   TYPE abap_bool,
        lv_ddic_found    TYPE abap_bool,
        lv_example       TYPE string,
        lv_leaf_source   TYPE zbdc_mapping_bup-source_column,
        lv_static_safe   TYPE abap_bool,
        lv_script_dynamic TYPE abap_bool,
        lv_resolved      TYPE abap_bool,
        lv_new_version   TYPE abap_bool,
        lv_source_ver    TYPE zbdc_mapping_bup-profile_ver,
        lv_script_id     TYPE zbdc_script_bup-script_id,
        lv_contract_hash TYPE zbdc_script_bup-contract_hash,
        lv_script_found  TYPE abap_bool,
        lv_persist_ok    TYPE abap_bool,
        lv_persist_msg   TYPE string,
        lv_inherited     TYPE i,
        lv_meta_count    TYPE i,
        lv_static_count  TYPE i,
        lv_message       TYPE string,
        lv_exact_complete TYPE abap_bool,
        lv_exact_message  TYPE string,
        lv_rep_found      TYPE abap_bool,
        lv_promote_ok     TYPE abap_bool,
        lv_promote_msg    TYPE string,
        lv_source_origin  TYPE string,
        lv_user_src       TYPE abap_bool,
        lv_auth_ok        TYPE abap_bool,
        lv_auth_origin    TYPE string,
        ls_active_prof    TYPE zbdc_prof_bup,
        lv_cross_found    TYPE abap_bool,
        lv_cross_ambig    TYPE abap_bool,
        lv_cross_source   TYPE zbdc_mapping_bup-source_column,
        lv_cross_staging  TYPE zbdc_mapping_bup-staging_field,
        lv_cross_bdc      TYPE zbdc_mapping_bup-bdc_field,
        lv_bootstrap_mode TYPE abap_bool,
        lv_bootstrap_ok   TYPE abap_bool,
        lv_locked_found   TYPE abap_bool,
        lv_locked_ver     TYPE zbdc_mapping_bup-profile_ver,
        lt_locked_map     TYPE ty_t_mapping_db,
        lt_raw_source     TYPE ty_t_script,
        lt_member_source  TYPE ty_t_script,
        lt_current_acq    TYPE ty_t_script,
        lv_member_found   TYPE abap_bool,
        lv_member_msg     TYPE string,
        lv_raw_ok         TYPE abap_bool,
        lv_raw_msg        TYPE string,
        lv_plan_ok        TYPE abap_bool,
        lv_plan_msg       TYPE string,
        lv_raw_save_ok    TYPE abap_bool,
        lv_raw_save_msg   TYPE string.

  DATA: lt_staging_slots TYPE ty_t_map_staging_slot,
        lt_seen_bdc TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                      WITH UNIQUE KEY table_line,
        lt_seen_source TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                      WITH UNIQUE KEY table_line,
        lt_used_staging TYPE SORTED TABLE OF zbdc_mapping_bup-staging_field
                      WITH UNIQUE KEY table_line,
        lt_missing TYPE ty_t_missing_bdc,
        lt_reuse_versions TYPE SORTED TABLE OF zbdc_prof_bup-profile_ver
                            WITH UNIQUE KEY table_line,
        lt_active_profiles TYPE STANDARD TABLE OF zbdc_prof_bup.

  DATA: lv_guard_ok  TYPE abap_bool,
        lv_guard_msg TYPE string.

  PERFORM guard_mapping_action
    USING 'CREATE_MAPPING_DRAFT'
    CHANGING lv_guard_ok lv_guard_msg.
  IF lv_guard_ok <> abap_true.
    PERFORM userize_ui_message USING lv_guard_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  PERFORM resolve_mapping_config_context
    CHANGING lv_tcode lv_profile lv_ver lv_ok.
  IF lv_ok <> abap_true.
    RETURN.
  ENDIF.

 "Load the exact source Profile Version before a rebuild can allocate a
 "new version. The script is never resolved by TCODE alone.
  lv_source_ver = lv_ver.
  PERFORM load_profile_script
    USING    lv_tcode lv_profile lv_source_ver
    CHANGING lt_script lv_script_id lv_contract_hash lv_script_found.
  IF lv_script_found <> abap_true.
    MESSAGE s205(zbdc)
      WITH lv_tcode lv_profile lv_source_ver
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  DATA: lv_z36_ready TYPE abap_bool, lv_z36_unres TYPE i, lv_z36_msg TYPE string.
  PERFORM check_contract USING lt_script CHANGING lv_z36_ready lv_z36_unres lv_z36_msg.
  IF lv_z36_ready <> abap_true.
    PERFORM userize_ui_message USING lv_z36_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "any new Mapping version must be compiled again from the immutable
 "raw acquisition snapshot, not cloned from a previously compiled contract.
  CLEAR: lv_raw_ok, lv_raw_msg.
  PERFORM load_raw_snapshot
    USING    lv_tcode lv_script_id
    CHANGING lt_raw_source lv_raw_ok lv_raw_msg.
  IF lv_raw_ok <> abap_true.
    PERFORM userize_ui_message USING lv_raw_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "field membership comes only from the latest explicit acquisition.
 "History/Field Guide may supply names and slots only after this gate. When
 "a current EXEC_RAW exists, a rebuilt version must compile from that same
 "raw acquisition instead of cloning an older RAW membership.
  lt_member_source = lt_raw_source.
  CLEAR: lv_member_found, lv_member_msg.
  REFRESH lt_current_acq.
  PERFORM load_member_source
    USING    lv_tcode lv_script_id
    CHANGING lt_current_acq lv_member_found lv_member_msg.
  IF lv_member_found = abap_true AND lt_current_acq IS NOT INITIAL.
    lt_member_source = lt_current_acq.
    lt_raw_source    = lt_current_acq.
  ENDIF.

 "re-load or obtain exact user-action certification before compiling
 "the persistent Mapping. This is required even if screen 0350 was skipped.
  DATA: lv_z659_origin TYPE c LENGTH 20,
        lv_z659_ok2    TYPE abap_bool,
        lv_z659_msg2   TYPE string.
  PERFORM get_projection_origin CHANGING lv_z659_origin.
  IF lv_z659_origin = 'GUIDED_RECORD'
     OR lv_z659_origin = 'SHDB_TXT'
     OR lv_z659_origin = 'SHDB_PROGRAM'.
    CLEAR: lv_z659_ok2, lv_z659_msg2.
    PERFORM confirm_actions
      USING    lt_member_source lv_script_id lv_contract_hash lv_z659_origin
      CHANGING lv_z659_ok2 lv_z659_msg2.
    IF lv_z659_ok2 <> abap_true.
      PERFORM userize_ui_message USING lv_z659_msg2 CHANGING gv_ui_message.
      MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.
  ENDIF.

 "Promote only confirmed user-action fields in the Mapping working copy.
 "Raw replay evidence remains immutable.
  PERFORM project_user_members CHANGING lt_member_source.

 "Create Mapping Draft is an explicit rebuild action. Once the exact
 "current RAW/EXEC_RAW membership is available, an older stable Mapping may
 "enrich labels/slots later but must not short-circuit the rebuild. 's
 "old early return could remove stale fields yet could never ADD a newly
 "manipulated field from the current recording. Current acquisition wins.
  CLEAR: lv_locked_found, lv_locked_ver.
  REFRESH lt_locked_map.
  IF lt_member_source IS INITIAL.
    PERFORM find_stable_business_map
      USING    lv_tcode lv_profile lv_source_ver
      CHANGING lt_locked_map lv_locked_ver lv_locked_found.
    IF lv_locked_found = abap_true
       AND lv_locked_ver <> lv_source_ver.
      gv_profile_ver = lv_locked_ver.
      gt_mapping_screen = lt_locked_map.
      PERFORM filter_map_bus_view
        USING    lv_tcode lv_profile gv_profile_ver
        CHANGING gt_mapping_screen.
      CLEAR: gv_z133_loaded_script_id, gv_z133_loaded_hash,
             gv_z133_loaded_changed_at.
      SELECT SINGLE script_id, contract_hash, changed_at
        FROM zbdc_script_bup
        INTO (@gv_z133_loaded_script_id, @gv_z133_loaded_hash,
              @gv_z133_loaded_changed_at)
        WHERE tcode        = @lv_tcode
          AND profile_name = @lv_profile
          AND profile_ver  = @gv_profile_ver.
      MESSAGE s254(zbdc)
        WITH gv_profile_ver.
      RETURN.
    ENDIF.
  ENDIF.

 "Idempotency check before version allocation.
  SELECT * FROM zbdc_mapping_bup
    INTO TABLE @lt_current
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_source_ver.

  IF lt_current IS NOT INITIAL.
    PERFORM exact_mapping_complete
      USING    lt_member_source lt_current
      CHANGING lv_exact_complete lv_exact_message.
    IF lv_exact_complete = abap_true.
      gv_profile_ver = lv_source_ver.
      gt_mapping_screen = lt_current.
      MESSAGE s255(zbdc)
        WITH lv_profile lv_source_ver
        DISPLAY LIKE 'I'.
      RETURN.
    ENDIF.
  ENDIF.

 "Calculate the editable version, but do not register it yet. A failed
 "metadata build must not leave empty DRAFT versions in the registry.
  PERFORM ensure_editable_profile_ver
    CHANGING lv_tcode lv_profile lv_ver lv_new_version.

  SELECT * FROM zbdc_mapping_bup
    INTO TABLE @lt_history
    WHERE tcode = @lv_tcode.

 "preserve a real prior Mapping contract for the same canonical
 "profile even before certification. Only non-INACTIVE registry versions are
 "eligible; blocked audit versions never seed a new Mapping/Template.
  SELECT profile_ver
    FROM zbdc_prof_bup
    INTO TABLE @lt_reuse_versions
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND status      <> 'INACTIVE'.

 "An ACTIVE profile for the same TCODE can be used as a
 "business-field guide during onboarding. This is data-driven: it
 "matches by exact logical SAP BDC field only and does not branch by
 "TCODE, profile name, source-column label, object table or document type.
  SELECT * FROM zbdc_prof_bup
    INTO TABLE @lt_active_profiles
    WHERE tcode  = @lv_tcode
      AND status = @gc_m2_prof_active.

  SORT lt_history BY profile_name ASCENDING
                     profile_ver DESCENDING
                     staging_field ASCENDING
                     source_column ASCENDING.

  REFRESH lt_current.
  LOOP AT lt_history INTO ls_hist
    WHERE profile_name = lv_profile
      AND profile_ver  = lv_ver.
    APPEND ls_hist TO lt_current.
  ENDLOOP.

  lv_existing = lines( lt_current ).
  IF lv_existing > 0.
    CALL FUNCTION 'POPUP_TO_CONFIRM'
      EXPORTING
        titlebar              = 'Create Mapping Draft'
        text_question         =
          |Rebuild { lv_existing } row(s) for { lv_tcode } / { lv_profile } v{ lv_ver } from metadata?|
        text_button_1         = 'Rebuild'
        text_button_2         = 'Cancel'
        default_button        = '2'
        display_cancel_button = space
      IMPORTING
        answer                = lv_answer.
    IF lv_answer <> '1'.
      MESSAGE s256(zbdc).
      RETURN.
    ENDIF.
  ENDIF.

  PERFORM read_mapping_metadata
    USING    lv_tcode lv_profile lv_ver
    CHANGING lt_meta.
  PERFORM enrich_meta_from_approved_map
    USING    lv_tcode lv_profile
    CHANGING lt_meta.
  PERFORM enrich_meta_from_shdb_ddic
    USING    lv_tcode lv_profile lv_ver
    CHANGING lt_meta.
  PERFORM get_mapping_staging_slots CHANGING lt_staging_slots.

  IF lt_staging_slots IS INITIAL.
    MESSAGE s257(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  READ TABLE lt_staging_slots
    WITH TABLE KEY table_line = 'FIELD01'
    TRANSPORTING NO FIELDS.
  IF sy-subrc <> 0.
    MESSAGE s258(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  REFRESH: lt_draft, lt_seen_bdc, lt_seen_source,
           lt_used_staging, lt_missing.

* Business key: generic control row, never tied to a document type.

  CLEAR: ls_map, lv_business_src, ls_meta, lv_meta_found.

  LOOP AT lt_current INTO ls_hist
    WHERE bdc_field IS INITIAL
      AND staging_field = 'FIELD01'.
    PERFORM mapping_history_is_trusted
      USING    ls_hist
      CHANGING lv_trusted.
    IF lv_trusted = abap_true.
      lv_business_src = ls_hist-source_column.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF lv_business_src IS INITIAL.
    LOOP AT lt_history INTO ls_hist
      WHERE profile_name  = lv_profile
        AND profile_ver  <> lv_ver
        AND bdc_field IS INITIAL
        AND staging_field = 'FIELD01'
        AND source_column IS NOT INITIAL.
      READ TABLE lt_reuse_versions
        WITH TABLE KEY table_line = ls_hist-profile_ver
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.
      lv_business_src = ls_hist-source_column.
      EXIT.
    ENDLOOP.
  ENDIF.

  IF lv_business_src IS INITIAL.
    PERFORM find_mapping_metadata
      USING    lt_meta space space 'FIELD01'
      CHANGING ls_meta lv_meta_found.
    IF lv_meta_found = abap_true.
      lv_business_src = ls_meta-source_column.
    ENDIF.
  ENDIF.

  IF lv_business_src IS INITIAL.
    lv_business_src = 'BUSINESS_KEY'.
  ENDIF.
  PERFORM normalize_mapping_source
    USING    lv_business_src
    CHANGING lv_business_src.

  ls_map-tcode         = lv_tcode.
  ls_map-profile_name  = lv_profile.
  ls_map-profile_ver   = lv_ver.
  ls_map-source_column = lv_business_src.
  ls_map-staging_field = 'FIELD01'.
  ls_map-mandatory     = 'X'.
  CLEAR ls_map-bdc_field.
  APPEND ls_map TO lt_draft.
  INSERT ls_map-source_column INTO TABLE lt_seen_source.
  INSERT ls_map-staging_field INTO TABLE lt_used_staging.

 "first-time TCODE bootstrap. A brand-new transaction has no
 "ACTIVE/MAPPED business-input contract yet, so generated DYNAMIC SHDB
 "columns are the onboarding seed. Existing TCODEs keep using their
 "Business Input Contract; this prevents old optional technical rows from
 "leaking back into Mapping/Template.
  lv_bootstrap_mode = abap_true.
  LOOP AT lt_history INTO ls_hist
    WHERE source_column IS NOT INITIAL
      AND staging_field IS NOT INITIAL.

    IF ls_hist-profile_name = lv_profile
       AND ls_hist-profile_ver = lv_ver.
      CONTINUE.
    ENDIF.

    IF ls_hist-bdc_field IS INITIAL
       AND ls_hist-staging_field = 'FIELD01'.
      CONTINUE.
    ENDIF.

    CLEAR: lv_hist_norm, lv_source_tech.
    IF ls_hist-bdc_field IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    ls_hist-bdc_field
        CHANGING lv_hist_norm.
    ENDIF.

    PERFORM mapping_source_is_technical
      USING    ls_hist-source_column lv_hist_norm
      CHANGING lv_source_tech.
    IF lv_source_tech <> abap_true.
      lv_bootstrap_mode = abap_false.
      EXIT.
    ENDIF.
  ENDLOOP.

* One Mapping row per LOGICAL business input.

* A table-control occurrence FIELD(*) and an unindexed detail occurrence
* FIELD are aliases only when their normalized technical base is identical.
* The rule is generic: no TCODE, program or business-field name is used.

* Resolution order remains metadata/certification driven. All aliases of
* one logical input receive the same SOURCE_COLUMN in the persisted Script,
* while the Mapping table stores exactly one source/staging row.

  LOOP AT lt_member_source INTO ls_script.
    IF ls_script-is_new_screen = 'X'
       OR ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_bdc_norm.
    IF lv_bdc_norm IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key
      USING    lv_bdc_norm
      CHANGING lv_logical_key.
    IF lv_logical_key IS INITIAL.
      CONTINUE.
    ENDIF.

 "The seen set now stores logical keys, not physical indexed variants.
    READ TABLE lt_seen_bdc
      WITH TABLE KEY table_line = lv_logical_key
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT lv_logical_key INTO TABLE lt_seen_bdc.

    CLEAR lv_script_dynamic.
    PERFORM logical_field_is_dynamic
      USING    lt_member_source lv_logical_key
      CHANGING lv_script_dynamic.

    IF lv_script_dynamic <> abap_true.
      PERFORM logical_can_remain_static
        USING    lt_member_source lv_logical_key
        CHANGING lv_static_safe.
      IF lv_static_safe = abap_true.
        lv_static_count = lv_static_count + 1.
        CONTINUE.
      ENDIF.
      INSERT lv_logical_key INTO TABLE lt_missing.
      CONTINUE.
    ENDIF.

 "Resolve from a real DYNAMIC member of the logical alias group.
    CLEAR: lv_rep_found, lv_map_bdc.
    PERFORM dynamic_representative
      USING    lt_member_source lv_logical_key
      CHANGING lv_map_bdc lv_rep_found.
    IF lv_rep_found <> abap_true OR lv_map_bdc IS INITIAL.
      INSERT lv_logical_key INTO TABLE lt_missing.
      CONTINUE.
    ENDIF.
    lv_bdc_norm = lv_map_bdc.

    CLEAR: lv_source, lv_staging, lv_resolved,
           ls_meta, lv_meta_found, lv_contract_ok, lv_contract_reason,
           lv_source_tech, lv_ddic_found, lv_static_safe,
           lv_source_origin.

 "1) Exact metadata for the representative BDC occurrence.
    PERFORM find_mapping_metadata
      USING    lt_meta lv_bdc_norm space space
      CHANGING ls_meta lv_meta_found.
    IF lv_meta_found = abap_true.
      PERFORM mapping_meta_contract_ok
        USING    ls_meta
        CHANGING lv_contract_ok lv_contract_reason.
      IF lv_contract_ok = abap_true.
        lv_source        = ls_meta-source_column.
        lv_staging       = ls_meta-staging_field.
        lv_resolved      = abap_true.
        lv_source_origin = ls_meta-metadata_origin.
      ENDIF.
    ENDIF.

 "2) Same-profile prior Mapping identity.
 "The scenario resolver has already proved canonical profile identity.
 "Reuse the persisted SOURCE_COLUMN/STAGING_FIELD pair from the newest
 "non-INACTIVE version so Import and Guided Recording generate the same
 "Mapping and Template order without any TCODE/field hardcode.
    IF lv_resolved IS INITIAL.
      LOOP AT lt_history INTO ls_hist
        WHERE profile_name = lv_profile
          AND profile_ver <> lv_ver
          AND bdc_field IS NOT INITIAL
          AND source_column IS NOT INITIAL
          AND staging_field IS NOT INITIAL.

        READ TABLE lt_reuse_versions
          WITH TABLE KEY table_line = ls_hist-profile_ver
          TRANSPORTING NO FIELDS.
        IF sy-subrc <> 0.
          CONTINUE.
        ENDIF.

        CLEAR: lv_hist_norm, lv_hist_logical.
        PERFORM normalize_mapping_bdc_field
          USING    ls_hist-bdc_field
          CHANGING lv_hist_norm.
        PERFORM logical_bdc_key
          USING    lv_hist_norm
          CHANGING lv_hist_logical.
        IF lv_hist_logical IS INITIAL.
          lv_hist_logical = lv_hist_norm.
        ENDIF.
        IF lv_hist_logical <> lv_logical_key.
          CONTINUE.
        ENDIF.

        lv_source        = ls_hist-source_column.
        lv_staging       = ls_hist-staging_field.
        lv_resolved      = abap_true.
        lv_source_origin = 'PROFILE_HISTORY'.
        lv_inherited     = lv_inherited + 1.
        EXIT.
      ENDLOOP.
    ENDIF.

 "2b) Cross-profile ACTIVE business-field guide.
 "A fresh guided recording often has no user-facing SOURCE_COLUMN yet.
 "If an ACTIVE profile already mapped the exact same logical BDC field,
 "inherit only that business label/staging as onboarding metadata.
 "Conflicting active labels are blocked by leaving the field unresolved;
 "no latest-version or application-specific guess is used.
    IF lv_resolved IS INITIAL AND lt_active_profiles IS NOT INITIAL.
      CLEAR: lv_cross_found, lv_cross_ambig, lv_cross_source,
             lv_cross_staging, lv_cross_bdc.

      LOOP AT lt_history INTO ls_hist
        WHERE bdc_field IS NOT INITIAL
          AND source_column IS NOT INITIAL
          AND staging_field IS NOT INITIAL.

        READ TABLE lt_active_profiles INTO ls_active_prof
          WITH KEY profile_name = ls_hist-profile_name
                   profile_ver  = ls_hist-profile_ver.
        IF sy-subrc <> 0.
          CONTINUE.
        ENDIF.

        CLEAR: lv_hist_norm, lv_hist_logical, lv_source_tech.
        PERFORM normalize_mapping_bdc_field
          USING    ls_hist-bdc_field
          CHANGING lv_hist_norm.
        PERFORM logical_bdc_key
          USING    lv_hist_norm
          CHANGING lv_hist_logical.
        IF lv_hist_logical IS INITIAL.
          lv_hist_logical = lv_hist_norm.
        ENDIF.
        IF lv_hist_logical <> lv_logical_key.
          CONTINUE.
        ENDIF.

        PERFORM mapping_source_is_technical
          USING    ls_hist-source_column lv_hist_norm
          CHANGING lv_source_tech.
        IF lv_source_tech = abap_true.
          CONTINUE.
        ENDIF.

        IF lv_cross_found = abap_true
           AND lv_cross_source <> ls_hist-source_column.
          lv_cross_ambig = abap_true.
          EXIT.
        ENDIF.

        lv_cross_found   = abap_true.
        lv_cross_source  = ls_hist-source_column.
        lv_cross_staging = ls_hist-staging_field.
        lv_cross_bdc     = ls_hist-bdc_field.
      ENDLOOP.

      IF lv_cross_found = abap_true AND lv_cross_ambig <> abap_true.
        lv_source        = lv_cross_source.
        lv_staging       = lv_cross_staging.
        IF lv_cross_bdc IS NOT INITIAL.
          lv_bdc_norm = lv_cross_bdc.
        ENDIF.
        lv_resolved      = abap_true.
        lv_source_origin = 'ACTIVE_PROFILE_GUIDE'.
        lv_inherited     = lv_inherited + 1.
      ENDIF.
    ENDIF.

 "3) Exact runtime-CERTIFIED history.
    IF lv_resolved IS INITIAL.
      LOOP AT lt_history INTO ls_hist WHERE bdc_field IS NOT INITIAL.
        CLEAR lv_trusted.
        PERFORM mapping_history_is_trusted
          USING    ls_hist
          CHANGING lv_trusted.
        IF lv_trusted <> abap_true.
          CONTINUE.
        ENDIF.

        PERFORM normalize_mapping_bdc_field
          USING    ls_hist-bdc_field
          CHANGING lv_hist_norm.
        IF lv_hist_norm <> lv_bdc_norm.
          CONTINUE.
        ENDIF.

        lv_source        = ls_hist-source_column.
        lv_staging       = ls_hist-staging_field.
        lv_resolved      = abap_true.
        lv_source_origin = 'CERTIFIED_HISTORY'.
        lv_inherited     = lv_inherited + 1.
        EXIT.
      ENDLOOP.
    ENDIF.

 "4) Exact current Script Definition source for the representative.
    IF lv_resolved IS INITIAL.
      LOOP AT lt_member_source INTO DATA(ls_dyn_script)
        WHERE is_new_screen IS INITIAL
          AND field_name IS NOT INITIAL
          AND value_type = gc_vt_dynamic.
        PERFORM normalize_mapping_bdc_field
          USING    ls_dyn_script-field_name
          CHANGING lv_hist_norm.
        IF lv_hist_norm = lv_bdc_norm
           AND ls_dyn_script-source_column IS NOT INITIAL.
          lv_source        = ls_dyn_script-source_column.
          lv_resolved      = abap_true.
          lv_source_origin = 'SCRIPT_CONTRACT'.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.

 "Metadata may enrich an inherited/script mapping by staging or source.
    PERFORM find_mapping_metadata
      USING    lt_meta lv_bdc_norm lv_source lv_staging
      CHANGING ls_meta lv_meta_found.
    IF lv_meta_found = abap_true.
      PERFORM mapping_meta_contract_ok
        USING    ls_meta
        CHANGING lv_contract_ok lv_contract_reason.

      IF lv_contract_ok = abap_true.
        lv_source = ls_meta-source_column.
        IF ls_meta-staging_field IS NOT INITIAL.
          lv_staging = ls_meta-staging_field.
        ENDIF.
        lv_resolved      = abap_true.
        lv_source_origin = ls_meta-metadata_origin.
        lv_meta_count    = lv_meta_count + 1.
      ELSE.
        CLEAR lv_resolved.
      ENDIF.
    ELSEIF lv_resolved = abap_true.
    ENDIF.

    IF lv_resolved IS INITIAL.
      CLEAR: ls_meta, lv_meta_found.
      PERFORM derive_auto_meta_from_script
        USING    lt_member_source lv_tcode lv_bdc_norm
        CHANGING ls_meta lv_meta_found.
      IF lv_meta_found = abap_true.
        lv_source        = ls_meta-source_column.
        lv_staging       = ls_meta-staging_field.
        lv_resolved      = abap_true.
        lv_source_origin = ls_meta-metadata_origin.
        lv_meta_count    = lv_meta_count + 1.
      ENDIF.
    ENDIF.

    IF lv_resolved = abap_true.
 "Registry metadata remains authoritative; lexical TCODE rules are
 "never used to invent a business meaning.
      CLEAR: lv_example, lv_leaf_source.
      lv_example = ls_meta-example_value.
      IF lv_example IS INITIAL.
        LOOP AT lt_member_source INTO DATA(ls_example_script)
          WHERE is_new_screen IS INITIAL
            AND field_name IS NOT INITIAL
            AND static_value IS NOT INITIAL.
          PERFORM normalize_mapping_bdc_field
            USING    ls_example_script-field_name
            CHANGING lv_hist_norm.
          IF lv_hist_norm = lv_bdc_norm.
            lv_example = ls_example_script-static_value.
            EXIT.
          ENDIF.
        ENDLOOP.
      ENDIF.

      PERFORM get_mapping_leaf_source
        USING    lv_bdc_norm
        CHANGING lv_leaf_source.
      PERFORM refine_business_source
        USING    lv_source lv_leaf_source lv_example
        CHANGING lv_source.
      PERFORM normalize_mapping_source
        USING    lv_source
        CHANGING lv_source.

      PERFORM mapping_source_is_technical
        USING    lv_source lv_bdc_norm
        CHANGING lv_source_tech.
      IF lv_source_tech = abap_true
         AND ls_meta-display_label IS NOT INITIAL.
        PERFORM normalize_mapping_source
          USING    ls_meta-display_label
          CHANGING lv_source.
      ENDIF.

      PERFORM mapping_source_is_technical
        USING    lv_source lv_bdc_norm
        CHANGING lv_source_tech.
      IF lv_source IS INITIAL OR lv_source_tech = abap_true.
        INSERT lv_logical_key INTO TABLE lt_missing.
        CONTINUE.
      ENDIF.

 "Inspect every indexed/unindexed alias and promote the strongest safe
 "source. Friendly metadata wins over neutral INPUT_* fallback. Two
 "different equally-authoritative friendly sources are blocked rather
 "than guessed.
      CLEAR: lv_promote_ok, lv_promote_msg.
      PERFORM promote_logical_source
        USING    lt_member_source lt_meta lv_tcode lv_logical_key lv_source_origin
        CHANGING lv_source lv_staging lv_map_bdc
                 lv_promote_ok lv_promote_msg.
      IF lv_promote_ok <> abap_true.
        IF lv_promote_msg IS INITIAL.
          DATA(lv_zm863_19667_1) = |{ lv_logical_key }|.
          MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '863'
            WITH lv_zm863_19667_1 INTO lv_promote_msg.
        ENDIF.
        PERFORM userize_ui_message USING lv_promote_msg CHANGING gv_ui_message.
        MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
        RETURN.
      ENDIF.

      IF lv_staging IS NOT INITIAL.
        TRANSLATE lv_staging TO UPPER CASE.
        CONDENSE lv_staging NO-GAPS.
        PERFORM mapping_staging_field_exists
          USING    lv_staging
          CHANGING lv_slot_exists.
        IF lv_slot_exists <> abap_true.
          CLEAR lv_staging.
        ELSE.
          READ TABLE lt_used_staging
            WITH TABLE KEY table_line = lv_staging
            TRANSPORTING NO FIELDS.
          IF sy-subrc = 0.
 "Stale/duplicated metadata must never make two logical inputs
 "share one staging slot. Reallocate deterministically.
            CLEAR lv_staging.
          ENDIF.
        ENDIF.
      ENDIF.

      IF lv_staging IS INITIAL.
        LOOP AT lt_staging_slots INTO lv_slot_try.
          IF lv_slot_try = 'FIELD01'.
            CONTINUE.
          ENDIF.
          READ TABLE lt_used_staging
            WITH TABLE KEY table_line = lv_slot_try
            TRANSPORTING NO FIELDS.
          IF sy-subrc <> 0.
            lv_staging = lv_slot_try.
            EXIT.
          ENDIF.
        ENDLOOP.
      ENDIF.

      IF lv_staging IS INITIAL.
        INSERT lv_logical_key INTO TABLE lt_missing.
        CONTINUE.
      ENDIF.

      READ TABLE lt_seen_source
        WITH TABLE KEY table_line = lv_source
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
 "Two different logical fields cannot share one header.
 "Do not invent INPUT_<SAP_FIELD>; fail closed and ask for a
 "generated-program record name, Field Guide, or Mapping review.
        INSERT lv_logical_key INTO TABLE lt_missing.
        CONTINUE.
      ENDIF.

 "Required is no longer inferred from recording/default values.
 "Row presence defines Template membership; blank eligibility is proved
 "later by the exact frozen runtime blank contract.

      CLEAR: lv_auth_ok, lv_auth_origin.
      PERFORM bus_input_auth_ok
        USING    lv_tcode lv_profile lv_ver lv_map_bdc lv_source lv_staging
        CHANGING lv_auth_ok lv_auth_origin.
      IF lv_auth_ok <> abap_true.
        CLEAR: lv_bootstrap_ok, lv_user_src, lv_source_tech.
        PERFORM log_has_user_src
          USING    lt_member_source lv_logical_key
          CHANGING lv_user_src.

        IF lv_bootstrap_mode = abap_true
           AND lv_user_src = abap_true
           AND lv_source IS NOT INITIAL
           AND lv_staging IS NOT INITIAL.
          PERFORM mapping_source_is_technical
            USING    lv_source lv_map_bdc
            CHANGING lv_source_tech.
          IF lv_source_tech <> abap_true.
            lv_bootstrap_ok = abap_true.
            lv_auth_origin = 'FIRST_TCODE_BOOTSTRAP'.
          ENDIF.
        ENDIF.

        IF lv_bootstrap_ok <> abap_true.
          lv_static_count = lv_static_count + 1.
          CONTINUE.
        ENDIF.
      ENDIF.
      lv_source_origin = lv_auth_origin.
      CLEAR ls_map.
      ls_map-tcode         = lv_tcode.
      ls_map-profile_name  = lv_profile.
      ls_map-profile_ver   = lv_ver.
      ls_map-source_column = lv_source.
      ls_map-staging_field = lv_staging.
      ls_map-bdc_field     = lv_map_bdc.
      PERFORM NORM_MAP_REQUIRED CHANGING ls_map.
      PERFORM apply_fmt_contract CHANGING ls_map.
      APPEND ls_map TO lt_draft.

      INSERT lv_source  INTO TABLE lt_seen_source.
      INSERT lv_staging INTO TABLE lt_used_staging.

      CONTINUE.
    ENDIF.

 "logical fields that the recorder/parser did not expose as
 "a source column are repository/audit evidence, not end-user inputs.
 "Do not fail the draft and do not create a template column for them.
    CLEAR lv_user_src.
    PERFORM log_has_user_src
      USING    lt_member_source lv_logical_key
      CHANGING lv_user_src.
    IF lv_user_src <> abap_true.
      lv_static_count = lv_static_count + 1.
      CONTINUE.
    ENDIF.

    PERFORM logical_can_remain_static
      USING    lt_member_source lv_logical_key
      CHANGING lv_static_safe.
    IF lv_static_safe = abap_true.
      lv_static_count = lv_static_count + 1.
      CONTINUE.
    ENDIF.

    INSERT lv_logical_key INTO TABLE lt_missing.
  ENDLOOP.

  IF lt_missing IS NOT INITIAL.
    PERFORM build_missing_metadata_message
      USING    lv_tcode lt_missing
      CHANGING lv_message.
    PERFORM userize_ui_message USING lv_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF lines( lt_draft ) <= 1.
    MESSAGE s259(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "Only now is the version registered and persisted.
  gv_profile_ver = lv_ver.
  PERFORM register_profile_if_missing.

 "Compile the new candidate from RAW + the completed Mapping projection.
  lt_script_new = lt_raw_source.
  PERFORM apply_map_to_script
    USING    lt_draft
    CHANGING lt_script_new.
  PERFORM compile_raw_simple CHANGING lt_script_new.

  CLEAR: lv_plan_ok, lv_plan_msg.
  PERFORM compiled_plan_ok
    USING    lt_script_new
    CHANGING lv_plan_ok lv_plan_msg.
  IF lv_plan_ok <> abap_true.
    PERFORM userize_ui_message USING lv_plan_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  DELETE FROM zbdc_mapping_bup
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  MODIFY zbdc_mapping_bup FROM TABLE lt_draft.
  IF sy-subrc <> 0.
    ROLLBACK WORK.
    MESSAGE s260(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  CLEAR: lv_script_id, lv_contract_hash, lv_persist_ok, lv_persist_msg.
  PERFORM persist_profile_script
    USING    lv_tcode lv_profile lv_ver
             'MAPPING_DRAFT' gc_m2_prof_draft lt_script_new
    CHANGING lv_script_id lv_contract_hash
             lv_persist_ok lv_persist_msg.
  IF lv_persist_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM userize_ui_message USING lv_persist_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  CLEAR: lv_raw_save_ok, lv_raw_save_msg.
  PERFORM save_raw_snapshot
    USING    lv_script_id lt_raw_source
    CHANGING lv_raw_save_ok lv_raw_save_msg.
  IF lv_raw_save_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM userize_ui_message USING lv_raw_save_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  UPDATE zbdc_prof_bup
    SET status     = @gc_m2_prof_draft,
        changed_by = @sy-uname,
        changed_on = @gv_demo_date_837,
        changed_at = @gv_demo_time_837
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.

  COMMIT WORK AND WAIT.
  gt_mapping_screen = lt_draft.

  IF lv_new_version = abap_true.
    IF lv_bootstrap_mode = abap_true.
      DATA(lv_zm864_19880_1) = |{ lv_ver }|.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '864'
        WITH lv_zm864_19880_1 INTO lv_message.
    ELSE.
      DATA(lv_zm865_19882_1) = |{ lv_ver }|.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '865'
        WITH lv_zm865_19882_1 INTO lv_message.
    ENDIF.
  ELSE.
    IF lv_bootstrap_mode = abap_true.
      DATA(lv_zm866_19886_1) = |{ lv_ver }|.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '866'
        WITH lv_zm866_19886_1 INTO lv_message.
    ELSE.
      DATA(lv_zm867_19888_1) = |{ lv_ver }|.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '867'
        WITH lv_zm867_19888_1 INTO lv_message.
    ENDIF.
  ENDIF.
  lv_message = lv_message && ' Review the fields, then press Generate Template.'.

  PERFORM userize_ui_message USING lv_message CHANGING gv_ui_message.
  MESSAGE gv_ui_message TYPE 'S'.
ENDFORM.

FORM display_mapping_screen.
  DATA: lt_fcat            TYPE lvc_t_fcat,
        ls_fcat            TYPE lvc_s_fcat,
        ls_layout          TYPE lvc_s_layo,
        ls_z620_map_probe  TYPE zbdc_mapping_bup.
  FIELD-SYMBOLS <lv_z620_step> TYPE any.

  PERFORM load_mapping_screen.

  IF go_container_0350 IS INITIAL.
    CREATE OBJECT go_container_0350
      EXPORTING container_name = 'CC_GRID_CONTAINER'.
    CREATE OBJECT go_map_grid
      EXPORTING i_parent = go_container_0350.

    DEFINE add_map_col.
      CLEAR ls_fcat.
      ls_fcat-fieldname = &1.
      ls_fcat-coltext   = &2.
      ls_fcat-scrtext_l = &2.
      ls_fcat-scrtext_m = &2.
      ls_fcat-scrtext_s = &3.
      ls_fcat-outputlen = &4.
      ls_fcat-edit      = &5.
      ls_fcat-no_out    = &6.
      APPEND ls_fcat TO lt_fcat.
    END-OF-DEFINITION.

 "make the review screen explicit. SOURCE_COLUMN is the
 "end-user template field name (Fld Name/header). BDC_FIELD is the
 "internal SAP screen field bound to that header. Runtime staging slots
 "remain available through ALV layout but are hidden by default.
    add_map_col 'SOURCE_COLUMN' 'Template Field Name' 'Fld Name' 30 '' ''.
    add_map_col 'BDC_FIELD'     'SAP Technical Field (Internal)' 'SAP Field' 40 '' ''.

 "show exact recording occurrence when ZBDC_MAPPING_BUP has the
 "optional STEP_SEQ DDIC column. The runtime stays source-compatible with
 "older systems because the component is discovered dynamically.
    ASSIGN COMPONENT 'STEP_SEQ' OF STRUCTURE ls_z620_map_probe TO <lv_z620_step>.
    IF sy-subrc = 0.
      add_map_col 'STEP_SEQ' 'Recording Step (Internal)' 'Step' 10 '' ''.
    ENDIF.
    add_map_col 'MANDATORY'     'Required' 'Required' 10 '' ''.
    add_map_col 'TCODE'         'Transaction' 'TCode' 12 '' ''.
    add_map_col 'PROFILE_NAME'  'Profile Name' 'Profile' 24 '' ''.
    add_map_col 'PROFILE_VER'   'Profile Version' 'Version' 10 '' ''.
    add_map_col 'STAGING_FIELD' 'Runtime Slot (Internal)' 'Slot' 16 '' 'X'.

    ls_layout-zebra      = abap_true.
    ls_layout-cwidth_opt = abap_true.
    ls_layout-sel_mode   = 'A'.

 "do not register Field Guide maintenance toolbar on 0350.
 "End users download/use templates only; onboarding promotion is handled
 "internally by Generate Template after canonical candidate projection.

    go_map_grid->set_table_for_first_display(
      EXPORTING is_layout       = ls_layout
      CHANGING  it_outtab       = gt_mapping_screen
                it_fieldcatalog = lt_fcat ).
    go_map_grid->set_ready_for_input( 0 ).
  ELSEIF go_map_grid IS BOUND.
    go_map_grid->set_ready_for_input( 0 ).
    go_map_grid->refresh_table_display( ).
  ENDIF.
ENDFORM.

*& Internal Field Guide helper forms retained for compatibility
FORM validate_mapping_profile
  CHANGING cv_ok TYPE abap_bool
           cv_message TYPE string.

  TYPES: BEGIN OF ty_pair,
           source  TYPE zbdc_mapping_bup-source_column,
           staging TYPE zbdc_mapping_bup-staging_field,
         END OF ty_pair.

  DATA: lt_pair TYPE STANDARD TABLE OF ty_pair,
        ls_pair TYPE ty_pair,
        ls_map  TYPE zbdc_mapping_bup,
        lv_source TYPE zbdc_mapping_bup-source_column,
        lv_bdc    TYPE zbdc_mapping_bup-bdc_field,
        lv_logical TYPE zbdc_mapping_bup-bdc_field,
        lv_technical TYPE abap_bool,
        lv_exists TYPE abap_bool,
        lv_key_count TYPE i,
        lv_business_count TYPE i,
        lt_meta TYPE ty_t_map_meta,
        ls_meta TYPE ty_map_meta,
        lv_meta_found TYPE abap_bool,
        lv_contract_ok TYPE abap_bool,
        lv_contract_reason TYPE string,
        lt_script TYPE ty_t_script,
        lv_script_dynamic TYPE abap_bool,
        ls_context TYPE zbdc_mapping_bup,
        ls_script TYPE ty_script_def_compat.

  DATA: lt_mapped_logical TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                            WITH UNIQUE KEY table_line,
        lt_dynamic_logical TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                            WITH UNIQUE KEY table_line.

  CLEAR: cv_ok, cv_message.

  IF gt_mapping_screen IS INITIAL.
    cv_message = 'Mapping profile is empty.'.
    RETURN.
  ENDIF.

  READ TABLE gt_mapping_screen INTO ls_context INDEX 1.
  IF sy-subrc <> 0.
    cv_message = 'Mapping profile context is missing.'.
    RETURN.
  ENDIF.

  DATA: lv_script_id TYPE zbdc_script_bup-script_id,
        lv_script_hash TYPE zbdc_script_bup-contract_hash,
        lv_script_found TYPE abap_bool.

  PERFORM load_profile_script
    USING    ls_context-tcode ls_context-profile_name ls_context-profile_ver
    CHANGING lt_script lv_script_id lv_script_hash lv_script_found.
  IF lv_script_found <> abap_true.
    cv_message =
      'Versioned Script Definition is missing for the exact mapping profile/version.'.
    RETURN.
  ENDIF.

  DATA: lv_z367_ok TYPE abap_bool, lv_z367_msg TYPE string.
  PERFORM repair_tech_contract
    USING    ls_context-tcode ls_context-profile_name ls_context-profile_ver lv_script_id
    CHANGING lt_script lv_script_hash lv_z367_ok lv_z367_msg.
  IF lv_z367_ok <> abap_true.
    cv_message = lv_z367_msg.
    RETURN.
  ENDIF.

  DATA: lv_z36_ready TYPE abap_bool, lv_z36_unres TYPE i, lv_z36_msg TYPE string.
  PERFORM check_contract USING lt_script CHANGING lv_z36_ready lv_z36_unres lv_z36_msg.
  IF lv_z36_ready <> abap_true.
    cv_message = lv_z36_msg.
    RETURN.
  ENDIF.

  PERFORM read_mapping_metadata
    USING    ls_context-tcode ls_context-profile_name ls_context-profile_ver
    CHANGING lt_meta.
  PERFORM enrich_meta_from_approved_map
    USING    ls_context-tcode ls_context-profile_name
    CHANGING lt_meta.
  PERFORM enrich_meta_from_shdb_ddic
    USING    ls_context-tcode
             ls_context-profile_name
             ls_context-profile_ver
    CHANGING lt_meta.

 "Build the exact logical Dynamic contract expected from the Script.
  LOOP AT lt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL
      AND value_type = gc_vt_dynamic.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    ls_script-field_name
      CHANGING lv_logical.
    IF lv_logical IS NOT INITIAL.
      INSERT lv_logical INTO TABLE lt_dynamic_logical.
    ENDIF.
  ENDLOOP.

  LOOP AT gt_mapping_screen INTO ls_map.
    IF ls_map-mandatory = gc_m2_map_review.
      cv_message =
        |Legacy REVIEW_REQUIRED data exists at row { sy-tabix }. Rebuild the draft from metadata.|.
      RETURN.
    ENDIF.

    PERFORM normalize_mapping_source
      USING    ls_map-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      cv_message = |Row { sy-tabix }: SOURCE_COLUMN is empty.|.
      RETURN.
    ENDIF.

    IF ls_map-staging_field IS INITIAL.
      cv_message = |{ lv_source }: STAGING_FIELD is empty.|.
      RETURN.
    ENDIF.

    TRANSLATE ls_map-staging_field TO UPPER CASE.
    CONDENSE ls_map-staging_field NO-GAPS.
    PERFORM mapping_staging_field_exists
      USING    ls_map-staging_field
      CHANGING lv_exists.
    IF lv_exists <> abap_true.
      cv_message = |{ lv_source }: staging component { ls_map-staging_field } does not exist.|.
      RETURN.
    ENDIF.

    LOOP AT lt_pair INTO ls_pair.
      IF ls_pair-source = lv_source AND ls_pair-staging <> ls_map-staging_field.
        cv_message = |{ lv_source } is assigned to more than one staging field.|.
        RETURN.
      ENDIF.
      IF ls_pair-staging = ls_map-staging_field AND ls_pair-source <> lv_source.
        cv_message = |{ ls_map-staging_field } is assigned to more than one source column.|.
        RETURN.
      ENDIF.
    ENDLOOP.
    CLEAR ls_pair.
    ls_pair-source  = lv_source.
    ls_pair-staging = ls_map-staging_field.
    APPEND ls_pair TO lt_pair.

    IF ls_map-staging_field = 'FIELD01'.
      lv_key_count = lv_key_count + 1.
      IF ls_map-bdc_field IS NOT INITIAL.
        cv_message = 'FIELD01 is reserved for the internal business key and must not have a BDC field.'.
        RETURN.
      ENDIF.
      IF ls_map-mandatory <> 'X'.
        cv_message = 'The business-key row on FIELD01 must be mandatory.'.
        RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_map-bdc_field IS INITIAL.
      cv_message = |{ lv_source }: BDC_FIELD is empty.|.
      RETURN.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    ls_map-bdc_field
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      cv_message = |{ lv_source }: technical field { ls_map-bdc_field } cannot be mapped.|.
      RETURN.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_map-bdc_field
      CHANGING lv_bdc.
    PERFORM logical_bdc_key
      USING    lv_bdc
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      cv_message = |{ lv_source }: logical BDC identity is invalid.|.
      RETURN.
    ENDIF.

    READ TABLE lt_mapped_logical
      WITH TABLE KEY table_line = lv_logical
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      cv_message = |Logical field { lv_logical } has more than one Mapping row. Rebuild the draft.|.
      RETURN.
    ENDIF.
    INSERT lv_logical INTO TABLE lt_mapped_logical.

    CLEAR lv_script_dynamic.
    PERFORM logical_field_is_dynamic
      USING    lt_script lv_logical
      CHANGING lv_script_dynamic.
    IF lv_script_dynamic <> abap_true.
      cv_message = |{ lv_source }: contract drift; logical field { lv_logical } is not DYNAMIC.|.
      RETURN.
    ENDIF.

    CLEAR: ls_meta, lv_meta_found, lv_contract_ok, lv_contract_reason.
    PERFORM find_mapping_metadata
      USING    lt_meta lv_bdc lv_source ls_map-staging_field
      CHANGING ls_meta lv_meta_found.
    IF lv_meta_found <> abap_true.
      cv_message = |{ lv_source }: Field Guide/SHDB metadata is missing.|.
      RETURN.
    ENDIF.

    PERFORM mapping_meta_contract_ok
      USING    ls_meta
      CHANGING lv_contract_ok lv_contract_reason.
    IF lv_contract_ok <> abap_true.
      cv_message = |{ lv_source }: { lv_contract_reason }|.
      RETURN.
    ENDIF.

   "Required/Optional is not a business-input membership or blank gate.
   "Blank eligibility is validated later against the exact frozen contract.

    lv_business_count = lv_business_count + 1.
  ENDLOOP.

  IF lv_key_count <> 1.
    cv_message = 'Exactly one business-key row mapped to FIELD01 is required.'.
    RETURN.
  ENDIF.
  IF lv_business_count = 0.
    cv_message = 'At least one business BDC field is required.'.
    RETURN.
  ENDIF.

 "Template/Mapping UI validates the Business Input Contract only.
 "The imported SHDB script may contain optional/static/internal dynamic
 "evidence that is required by runtime replay but must not be exposed as
 "end-user template columns. Full executable coverage is validated later
 "by the Testing/Execution contract gate, not by Generate Template.
  cv_ok = abap_true.
ENDFORM.

FORM sync_script_from_mapping
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_script       TYPE ty_t_script,
        lv_tcode        TYPE zbdc_mapping_bup-tcode,
        lv_profile      TYPE zbdc_mapping_bup-profile_name,
        lv_ver          TYPE zbdc_mapping_bup-profile_ver,
        lv_ctx_ok       TYPE abap_bool,
        lv_script_id    TYPE zbdc_script_bup-script_id,
        lv_hash         TYPE zbdc_script_bup-contract_hash,
        lv_found        TYPE abap_bool,
        lv_persist_ok   TYPE abap_bool,
        lv_persist_msg  TYPE string,
        lv_recording    TYPE zbdc_script_bup-recording_name,
        lv_raw_ok       TYPE abap_bool,
        lv_raw_msg      TYPE string,
        lv_plan_ok      TYPE abap_bool,
        lv_plan_msg     TYPE string.

  FIELD-SYMBOLS <ls_scr> TYPE ty_script_def_compat.

  CLEAR: cv_ok, cv_message.

  PERFORM resolve_mapping_config_context
    CHANGING lv_tcode lv_profile lv_ver lv_ctx_ok.
  IF lv_ctx_ok <> abap_true.
    cv_message = 'TCODE/Profile/Version context is incomplete.'.
    RETURN.
  ENDIF.

 "Mapping edits always recompile from the immutable RAW snapshot,
 "never from a previously compiled script. The old compiled contract is
 "loaded only to resolve the immutable Script ID/hash.
  PERFORM load_profile_script
    USING    lv_tcode lv_profile lv_ver
    CHANGING lt_script lv_script_id lv_hash lv_found.
  IF lv_found <> abap_true.
    cv_message =
      |Versioned script is missing for { lv_tcode } / { lv_profile } v{ lv_ver }. Re-import the SHDB recording.|.
    RETURN.
  ENDIF.

  CLEAR: lv_raw_ok, lv_raw_msg.
  PERFORM load_raw_snapshot
    USING    lv_tcode lv_script_id
    CHANGING lt_script lv_raw_ok lv_raw_msg.
  IF lv_raw_ok <> abap_true.
    cv_message = lv_raw_msg.
    RETURN.
  ENDIF.

  SELECT SINGLE recording_name
    FROM zbdc_script_bup
    INTO @lv_recording
    WHERE script_id = @lv_script_id.
  IF lv_recording IS INITIAL.
    lv_recording = 'MAPPING_SYNC'.
  ENDIF.

  PERFORM apply_map_to_script
    USING    gt_mapping_screen
    CHANGING lt_script.
  PERFORM compile_raw_simple CHANGING lt_script.

  CLEAR: lv_plan_ok, lv_plan_msg.
  PERFORM compiled_plan_ok
    USING    lt_script
    CHANGING lv_plan_ok lv_plan_msg.
  IF lv_plan_ok <> abap_true.
    cv_message = lv_plan_msg.
    RETURN.
  ENDIF.

  CLEAR: lv_script_id, lv_hash, lv_persist_ok, lv_persist_msg.
  PERFORM persist_profile_script
    USING    lv_tcode lv_profile lv_ver
             lv_recording gc_m2_prof_mapped lt_script
    CHANGING lv_script_id lv_hash lv_persist_ok lv_persist_msg.

  IF lv_persist_ok <> abap_true.
    cv_message = lv_persist_msg.
    RETURN.
  ENDIF.

  gv_runtime_script_id     = lv_script_id.
  gv_runtime_contract_hash = lv_hash.
  cv_ok = abap_true.
  cv_message = |Script { lv_script_id } synchronized with the logical profile mapping.|.
ENDFORM.

FORM save_mapping_screen.
  DATA: lv_tcode       TYPE zbdc_mapping_bup-tcode,
        lv_profile     TYPE zbdc_mapping_bup-profile_name,
        lv_ver         TYPE zbdc_mapping_bup-profile_ver,
        lv_ok          TYPE abap_bool,
        lv_valid       TYPE abap_bool,
        lv_message     TYPE string,
        lv_status      TYPE zbdc_prof_bup-status,
        lv_sync_ok     TYPE abap_bool,
        lv_sync_message TYPE string,
        lv_guard_ok    TYPE abap_bool,
        lv_guard_msg   TYPE string,
        lv_current_script_id TYPE zbdc_script_bup-script_id,
        lv_current_hash TYPE zbdc_script_bup-contract_hash,
        lv_current_changed_at TYPE zbdc_script_bup-changed_at,
        lv_cert_status TYPE zbdc_cert_bup-cert_status,
        lt_z483_script TYPE ty_t_script,
        lv_z483_script_id TYPE zbdc_script_bup-script_id,
        lv_z483_hash TYPE zbdc_script_bup-contract_hash,
        lv_z483_found TYPE abap_bool,
        lv_z483_ok TYPE abap_bool,
        lv_z483_msg TYPE string,
        lt_visible_order TYPE STANDARD TABLE OF zbdc_mapping_bup,
        lv_order_fp_before TYPE zbdc_script_bup-contract_hash,
        lv_order_fp_after  TYPE zbdc_script_bup-contract_hash,
        lv_order_ok_before TYPE abap_bool,
        lv_order_ok_after  TYPE abap_bool,
        lv_order_msg_before TYPE string,
        lv_order_msg_after  TYPE string.

  FIELD-SYMBOLS <ls_map> TYPE zbdc_mapping_bup.

  PERFORM guard_mapping_action
    USING 'SAVE_MAPPING'
    CHANGING lv_guard_ok lv_guard_msg.
  IF lv_guard_ok <> abap_true.
    PERFORM userize_ui_message USING lv_guard_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF go_map_grid IS BOUND.
    go_map_grid->check_changed_data( ).
  ENDIF.

  PERFORM resolve_mapping_config_context
    CHANGING lv_tcode lv_profile lv_ver lv_ok.
  IF lv_ok <> abap_true.
    RETURN.
  ENDIF.

  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  IF sy-subrc = 0 AND
     ( lv_status = gc_m2_prof_active OR lv_status = 'INACTIVE' ).
    MESSAGE s267(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  SELECT SINGLE cert_status
    FROM zbdc_cert_bup
    INTO @lv_cert_status
    WHERE tcode            = @lv_tcode
      AND profile_name     = @lv_profile
      AND profile_ver      = @lv_ver
      AND cert_status      = 'CERTIFIED'
      AND last_test_status = 'CERTIFIED'.
  IF sy-subrc = 0.
    MESSAGE s268(zbdc)
      WITH lv_profile lv_ver
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "optimistic lock protects different users and two SAP sessions of
 "the same username. Save is allowed only from the snapshot that was loaded.
  SELECT SINGLE script_id, contract_hash, changed_at
    FROM zbdc_script_bup
    INTO (@lv_current_script_id, @lv_current_hash, @lv_current_changed_at)
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  IF sy-subrc = 0 AND gv_z133_loaded_script_id IS NOT INITIAL AND
     ( lv_current_script_id <> gv_z133_loaded_script_id
       OR lv_current_hash <> gv_z133_loaded_hash
       OR lv_current_changed_at <> gv_z133_loaded_changed_at ).
    MESSAGE s269(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  LOOP AT gt_mapping_screen ASSIGNING <ls_map>.
    <ls_map>-tcode        = lv_tcode.
    <ls_map>-profile_name = lv_profile.
    <ls_map>-profile_ver  = lv_ver.

    PERFORM normalize_mapping_source
      USING    <ls_map>-source_column
      CHANGING <ls_map>-source_column.

    TRANSLATE <ls_map>-staging_field TO UPPER CASE.
    CONDENSE <ls_map>-staging_field NO-GAPS.

    IF <ls_map>-bdc_field IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    <ls_map>-bdc_field
        CHANGING <ls_map>-bdc_field.
    ENDIF.

    TRANSLATE <ls_map>-mandatory TO UPPER CASE.
    IF <ls_map>-mandatory <> 'X' AND
       <ls_map>-mandatory <> gc_m2_map_review.
      CLEAR <ls_map>-mandatory.
    ENDIF.
  ENDLOOP.

  PERFORM validate_mapping_profile CHANGING lv_valid lv_message.
  IF lv_valid <> abap_true.
    PERFORM userize_ui_message USING lv_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  "V17.9.3.4 mapping-order stability: the exact visible Mapping order is
  "user/template intent. Repository reads may use a deterministic DB sort for
  "history, but SAVE must never silently reorder the current Mapping screen.
  "Keep the normalized validated rows before persistence; after the normal
  "reload we restore this order only when the selected technical field SET is
  "provably identical. No field/value/version identity is changed here.
  lt_visible_order = gt_mapping_screen.

  DELETE FROM zbdc_mapping_bup
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.

  MODIFY zbdc_mapping_bup FROM TABLE gt_mapping_screen.
  IF sy-subrc <> 0.
    ROLLBACK WORK.
    MESSAGE s270(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  PERFORM sync_script_from_mapping
    CHANGING lv_sync_ok lv_sync_message.
  IF lv_sync_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM userize_ui_message USING lv_sync_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "re-read the exact synchronized Script and prove the saved Mapping
 "still points 1:1 to its runtime DYNAMIC bindings before status/COMMIT.
  REFRESH lt_z483_script.
  CLEAR: lv_z483_script_id, lv_z483_hash, lv_z483_found,
         lv_z483_ok, lv_z483_msg.
  PERFORM load_profile_script
    USING    lv_tcode lv_profile lv_ver
    CHANGING lt_z483_script lv_z483_script_id lv_z483_hash lv_z483_found.
  IF lv_z483_found <> abap_true.
    ROLLBACK WORK.
    MESSAGE s271(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.
  PERFORM validate_map_script_1to1
    USING    gt_mapping_screen lt_z483_script
    CHANGING lv_z483_ok lv_z483_msg.
  IF lv_z483_ok <> abap_true.
    ROLLBACK WORK.
    PERFORM userize_ui_message USING lv_z483_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  PERFORM sync_prof_status_save.
  COMMIT WORK AND WAIT.
  PERFORM load_mapping_screen.

  "LOAD_MAPPING_SCREEN intentionally uses repository ordering. Prove that the
  "reloaded rows are still the same selected SAP-field set, then put the exact
  "pre-save visible order back for the user and for subsequent Generate
  "Template. If the set differs for any reason, keep the reloaded projection
  "and fail closed on order restoration rather than masking a data mismatch.
  CLEAR: lv_order_fp_before, lv_order_fp_after,
         lv_order_ok_before, lv_order_ok_after,
         lv_order_msg_before, lv_order_msg_after.
  IF lt_visible_order IS NOT INITIAL AND gt_mapping_screen IS NOT INITIAL.
    PERFORM selection_fp_map
      USING    lv_tcode lt_visible_order
      CHANGING lv_order_fp_before lv_order_ok_before lv_order_msg_before.
    PERFORM selection_fp_map
      USING    lv_tcode gt_mapping_screen
      CHANGING lv_order_fp_after lv_order_ok_after lv_order_msg_after.
    IF lv_order_ok_before = abap_true
       AND lv_order_ok_after = abap_true
       AND lv_order_fp_before = lv_order_fp_after
       AND lines( lt_visible_order ) = lines( gt_mapping_screen ).
      gt_mapping_screen = lt_visible_order.
    ENDIF.
  ENDIF.

  MESSAGE s272(zbdc)
    WITH lv_tcode lv_profile lv_ver.
ENDFORM.

*& Section 2B - Registry / Activate / Generate Template by Mapping Profile

*& Direct tuple registry writer for new onboarding candidates
*& Purpose:
*& Start Recording / Import create a new immutable candidate before an exact
*& Script Hash exists. The normal Mapping resolver intentionally requires an
*& exact Script ID + Hash, so it cannot create the first Profile Registry row
*& for that candidate. This helper writes only the explicit tuple already
*& reserved by the onboarding pipeline. It does not select latest versions,
*& infer profiles, hardcode TCODEs, or activate anything.

FORM register_profile_tuple
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
           iv_status  TYPE any
           iv_desc    TYPE csequence
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_tcode   TYPE zbdc_prof_bup-tcode,
        lv_profile TYPE zbdc_prof_bup-profile_name,
        lv_status  TYPE zbdc_prof_bup-status,
        lv_desc    TYPE zbdc_prof_bup-description,
        lv_dummy   TYPE zbdc_prof_bup-tcode,
        ls_prof    TYPE zbdc_prof_bup.

  CLEAR: cv_ok, cv_message.

  lv_tcode = iv_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.
  lv_profile = iv_profile.
  CONDENSE lv_profile.
  lv_status = iv_status.
  IF lv_status IS INITIAL.
    lv_status = gc_m2_prof_draft.
  ENDIF.
  lv_desc = iv_desc.
  IF lv_desc IS INITIAL.
    lv_desc = |Mapping Profile { lv_profile } for { lv_tcode }|.
  ENDIF.

  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL OR iv_ver IS INITIAL.
    cv_message = 'Profile registry tuple is incomplete; TCODE/Profile/Version is required.'.
    RETURN.
  ENDIF.

  SELECT SINGLE tcode FROM zbdc_prof_bup INTO @lv_dummy
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @iv_ver.
  IF sy-subrc = 0.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  CLEAR ls_prof.
  ls_prof-tcode        = lv_tcode.
  ls_prof-profile_name = lv_profile.
  ls_prof-profile_ver  = iv_ver.
  ls_prof-description  = lv_desc.
  ls_prof-status       = lv_status.
  ls_prof-tmpl_format  = 'CSV'.
  PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  ls_prof-created_by   = sy-uname.
  ls_prof-created_on   = gv_demo_date_837.
  ls_prof-created_at   = gv_demo_time_837.
  ls_prof-changed_by   = sy-uname.
  ls_prof-changed_on   = gv_demo_date_837.
  ls_prof-changed_at   = gv_demo_time_837.

  INSERT zbdc_prof_bup FROM @ls_prof.
  IF sy-subrc = 0.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  CLEAR lv_dummy.
  SELECT SINGLE tcode FROM zbdc_prof_bup INTO @lv_dummy
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @iv_ver.
  IF sy-subrc = 0.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  cv_message = |Profile Registry could not create tuple { lv_tcode } / { lv_profile } v{ iv_ver }.|.
ENDFORM.

FORM register_profile_if_missing.
  DATA: lv_tcode   TYPE zbdc_prof_bup-tcode,
        lv_profile TYPE zbdc_prof_bup-profile_name,
        lv_ver     TYPE zbdc_prof_bup-profile_ver,
        lv_ok      TYPE abap_bool,
        lv_dummy   TYPE zbdc_prof_bup-tcode,
        ls_prof    TYPE zbdc_prof_bup.

  PERFORM resolve_mapping_config_context
    CHANGING lv_tcode lv_profile lv_ver lv_ok.
  IF lv_ok <> abap_true.
    RETURN.
  ENDIF.

  SELECT SINGLE tcode FROM zbdc_prof_bup INTO @lv_dummy
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  IF sy-subrc = 0.
    RETURN.
  ENDIF.

  CLEAR ls_prof.
  ls_prof-tcode        = lv_tcode.
  ls_prof-profile_name = lv_profile.
  ls_prof-profile_ver  = lv_ver.
  ls_prof-description  = |Mapping Profile { lv_profile } for { lv_tcode }|.
  ls_prof-status       = gc_m2_prof_draft.
  ls_prof-tmpl_format  = 'CSV'.
  PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  ls_prof-created_by   = sy-uname.
  ls_prof-created_on   = gv_demo_date_837.
  ls_prof-created_at   = gv_demo_time_837.

  INSERT zbdc_prof_bup FROM @ls_prof.
  IF sy-subrc <> 0.
 "Concurrency-safe outcome: another LUW may have created the same exact
 "version. Never overwrite it here; verify that the registry row now exists.
    CLEAR lv_dummy.
    SELECT SINGLE tcode FROM zbdc_prof_bup INTO @lv_dummy
      WHERE tcode        = @lv_tcode
        AND profile_name = @lv_profile
        AND profile_ver  = @lv_ver.
    IF sy-subrc <> 0.
      MESSAGE s273(zbdc)
        WITH lv_tcode lv_profile lv_ver
        DISPLAY LIKE 'E'.
    ENDIF.
  ENDIF.

 "No COMMIT here. The caller owns the onboarding LUW so Profile + Script +
 "Mapping can be committed or rolled back together.
ENDFORM.

FORM sync_prof_status_save.
  DATA: lv_tcode   TYPE zbdc_prof_bup-tcode,
        lv_profile TYPE zbdc_prof_bup-profile_name,
        lv_ver     TYPE zbdc_prof_bup-profile_ver,
        lv_ok      TYPE abap_bool.

  PERFORM resolve_mapping_config_context
    CHANGING lv_tcode lv_profile lv_ver lv_ok.
  IF lv_ok <> abap_true.
    RETURN.
  ENDIF.

  PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  UPDATE zbdc_prof_bup
    SET status     = @gc_m2_prof_mapped,
        changed_by = @sy-uname,
        changed_on = @gv_demo_date_837,
        changed_at = @gv_demo_time_837
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver
      AND status       <> @gc_m2_prof_active.
ENDFORM.

*& Dynamic upload template - DATA-ONLY contract
*& XLSX contains exactly one worksheet: Data.
*& CSV contains exactly the same upload header contract.
*& No template colors, custom fonts, guide sheets or decorative styling.
*& XLSX keeps only the functional AutoFilter/freeze behavior.
*& No TCODE-specific field list or CASE branch is used.

FORM normalize_xlsx_example
  USING    iv_rule    TYPE any
           iv_example TYPE any
  CHANGING cv_example TYPE string.

  DATA: lv_rule    TYPE string,
        lv_example TYPE string,
        lv_day     TYPE string,
        lv_month   TYPE string,
        lv_year    TYPE string.

  CLEAR cv_example.
  lv_rule = iv_rule.
  lv_example = iv_example.
  CONDENSE lv_example.

  IF lv_example IS INITIAL.
    RETURN.
  ENDIF.

  TRANSLATE lv_rule TO UPPER CASE.

  IF lv_rule CS 'YYYYMMDD'.
    IF strlen( lv_example ) = 10
       AND lv_example+2(1) = '.'
       AND lv_example+5(1) = '.'.
      lv_day   = lv_example+0(2).
      lv_month = lv_example+3(2).
      lv_year  = lv_example+6(4).
      cv_example = lv_year && lv_month && lv_day.
      RETURN.
    ENDIF.

    IF strlen( lv_example ) = 10
       AND lv_example+4(1) = '-'
       AND lv_example+7(1) = '-'.
      cv_example = lv_example.
      REPLACE ALL OCCURRENCES OF '-' IN cv_example WITH ''.
      RETURN.
    ENDIF.
  ENDIF.

  cv_example = lv_example.
ENDFORM.

FORM sanitize_xlsx_rule
  USING    iv_origin TYPE any
           iv_rule   TYPE any
  CHANGING cv_rule   TYPE string.

  DATA: lv_origin     TYPE string,
        lv_rule       TYPE string,
        lv_upper      TYPE string,
        lv_pos        TYPE i,
        lv_char       TYPE c LENGTH 1,
        lv_length_txt TYPE string,
        lv_length_i   TYPE i,
        lv_len        TYPE i.

  CLEAR cv_rule.
  lv_origin = iv_origin.
  lv_rule = iv_rule.
  CONDENSE lv_origin NO-GAPS.
  CONDENSE lv_rule.
  TRANSLATE lv_origin TO UPPER CASE.

  IF lv_rule IS INITIAL.
    RETURN.
  ENDIF.

  lv_upper = lv_rule.
  TRANSLATE lv_upper TO UPPER CASE.

 "A length discovered only from the recorded screen is technical
 "evidence, not an approved business rule. Do not expose it to users.
  IF lv_origin = 'SHDB_EVIDENCE'
     AND lv_upper CS 'MAXIMUM LENGTH'.
    RETURN.
  ENDIF.

 "Normalize DDIC length text so NUMC-style leading zeros never appear
 "in the workbook, regardless of the metadata source.
  IF lv_upper CS 'MAXIMUM LENGTH'.
    CLEAR lv_length_txt.
    lv_len = strlen( lv_rule ).
    DO lv_len TIMES.
      lv_pos = sy-index - 1.
      lv_char = lv_rule+lv_pos(1).
      IF lv_char CA '0123456789'.
        lv_length_txt = lv_length_txt && lv_char.
      ELSEIF lv_length_txt IS NOT INITIAL.
        EXIT.
      ENDIF.
    ENDDO.
    IF lv_length_txt IS NOT INITIAL.
      lv_length_i = lv_length_txt.
      IF lv_upper CS 'NUMERIC TEXT'.
        cv_rule = |Numeric text, maximum length { lv_length_i } digits.|.
      ELSE.
        cv_rule = |Maximum length { lv_length_i } characters.|.
      ENDIF.
      RETURN.
    ENDIF.
  ENDIF.

  cv_rule = lv_rule.
ENDFORM.

FORM infer_xlsx_rule_from_example
  USING    iv_example TYPE any
  CHANGING cv_rule    TYPE string.

  DATA: lv_example TYPE string,
        lv_value   TYPE bdcdata-fval,
        lv_ok      TYPE abap_bool,
        lv_message TYPE string.

  IF cv_rule IS NOT INITIAL.
    RETURN.
  ENDIF.

  lv_example = iv_example.
  CONDENSE lv_example.
  IF lv_example IS INITIAL.
    RETURN.
  ENDIF.

 "Only infer a date rule after SAP's own date conversion and
 "plausibility check succeeds. No field name or TCODE is inspected.
  IF strlen( lv_example ) = 8 OR strlen( lv_example ) = 10.
    PERFORM date_to_external
      USING    lv_example 'XLSX_TEMPLATE'
      CHANGING lv_value lv_ok lv_message.
    IF lv_ok = abap_true.
      cv_rule =
        'Accepted date: YYYYMMDD, YYYY-MM-DD or SAP user date format.'.
    ENDIF.
  ENDIF.
ENDFORM.

FORM build_xlsx_contract
  USING    iv_tcode        TYPE char20
           iv_profile_name TYPE char30
           iv_profile_ver  TYPE numc4
  CHANGING ct_fields       TYPE ty_t_xlsx_field
           cv_used         TYPE abap_bool.

  TYPES: BEGIN OF ty_z483_tmpl_bind,
           source  TYPE zbdc_mapping_bup-source_column,
           staging TYPE zbdc_mapping_bup-staging_field,
           bdc     TYPE zbdc_mapping_bup-bdc_field,
         END OF ty_z483_tmpl_bind.

  DATA: lt_map         TYPE STANDARD TABLE OF zbdc_mapping_bup,
        ls_map         TYPE zbdc_mapping_bup,
        lt_meta        TYPE ty_t_map_meta,
        ls_meta        TYPE ty_map_meta,
        ls_field       TYPE ty_xlsx_field,
        lt_seen        TYPE SORTED TABLE OF
                         zbdc_mapping_bup-source_column
                         WITH UNIQUE KEY table_line,
        lv_meta_found  TYPE abap_bool,
        lv_contract_ok TYPE abap_bool,
        lv_reason      TYPE string,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_status      TYPE zbdc_prof_bup-status,
        lv_example     TYPE string,
        lv_rule        TYPE string,
        lv_projection_visible TYPE abap_bool,
        lt_guide       TYPE ty_t_map_meta,
        ls_guide       TYPE ty_map_meta,
        lv_has_guide   TYPE abap_bool,
        lv_guide_found TYPE abap_bool,
        lt_script      TYPE ty_t_script,
        lv_script_id   TYPE zbdc_script_bup-script_id,
        lv_hash        TYPE zbdc_script_bup-contract_hash,
        lv_script_ok   TYPE abap_bool,
        lv_input_ok    TYPE abap_bool,
        lv_auth_ok     TYPE abap_bool,
        lv_auth_origin TYPE string,
        lv_index       TYPE i,
        lv_effective_ver TYPE zbdc_mapping_bup-profile_ver,
        lt_expected_357 TYPE SORTED TABLE OF ty_z483_tmpl_bind
                        WITH UNIQUE KEY source staging bdc,
        lt_emitted_357  TYPE SORTED TABLE OF ty_z483_tmpl_bind
                        WITH UNIQUE KEY source staging bdc,
        ls_z483_expected TYPE ty_z483_tmpl_bind,
        ls_z483_emitted  TYPE ty_z483_tmpl_bind,
        lv_z483_stage TYPE zbdc_mapping_bup-staging_field,
        lv_z483_bdc   TYPE zbdc_mapping_bup-bdc_field,
        lv_z483_bad_emit TYPE abap_bool.

  CLEAR cv_used.
  REFRESH ct_fields.

  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile_name
      AND profile_ver  = @iv_profile_ver.

  IF sy-subrc <> 0 OR
     ( lv_status <> gc_m2_prof_active
       AND lv_status <> 'TESTING'
       AND lv_status <> gc_m2_prof_mapped
       AND lv_status <> gc_m2_prof_draft ).
    RETURN.
  ENDIF.

  CLEAR: lv_auth_ok, lv_auth_origin.
  PERFORM template_authority_ok
    USING    iv_tcode iv_profile_name iv_profile_ver lv_status
    CHANGING lv_auth_ok lv_auth_origin.
  IF lv_auth_ok <> abap_true.
    RETURN.
  ENDIF.

  SELECT *
    FROM zbdc_mapping_bup
    INTO TABLE @lt_map
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile_name
      AND profile_ver  = @iv_profile_ver
    ORDER BY staging_field, source_column.

  IF lt_map IS INITIAL.
    RETURN.
  ENDIF.

 "Explicit Generate Template is pinned to the exact Mapping tuple
 "currently open on screen 0350. Older MAPPED/TESTING/ACTIVE versions may
 "remain valid runtime/history contracts, but they must never silently replace
 "the Mapping the consultant is reviewing when a new template is generated.
 "This removes the old Z324 previous-stable-version fallback from artifact build.
  lv_effective_ver = iv_profile_ver.

 "Use the exact current 0350 projection when available. DOWNLOAD_CURR_PROF_TMPL
 "has already CHECK_CHANGED_DATA, so this also guarantees that the generated
 "CSV/XLSX/Gmail/GDrive schema is the same column set the user just reviewed.
  DATA lt_screen_map_357 TYPE ty_t_mapping_db.
  LOOP AT gt_mapping_screen INTO DATA(ls_screen_map_357)
    WHERE tcode        = iv_tcode
      AND profile_name = iv_profile_name
      AND profile_ver  = iv_profile_ver.
    APPEND ls_screen_map_357 TO lt_screen_map_357.
  ENDLOOP.

  IF lt_screen_map_357 IS NOT INITIAL.
 "screen 0350 is already the exact visible+filled projection.
 "Generate Template must not classify it again or add/drop columns.
    lt_map = lt_screen_map_357.
  ELSE.
 "Defensive direct-call path: no screen buffer means read only the exact tuple,
 "then apply the same projection that screen 0350 would have applied.
    SELECT *
      FROM zbdc_mapping_bup
      INTO TABLE @lt_map
      WHERE tcode        = @iv_tcode
        AND profile_name = @iv_profile_name
        AND profile_ver  = @iv_profile_ver
      ORDER BY staging_field, source_column.

    IF lt_map IS NOT INITIAL.
      PERFORM filter_map_bus_view
        USING    iv_tcode iv_profile_name iv_profile_ver
        CHANGING lt_map.
      PERFORM filter_map_user_ev
        CHANGING lt_map.
    ENDIF.
  ENDIF.

  IF lt_map IS INITIAL.
    RETURN.
  ENDIF.

 "freeze the exact visible source-column set before metadata enrichment.
 "The template builder may enrich labels/rules/examples, but it may neither add
 "an older column nor silently drop a column that 0350 currently presents.
  LOOP AT lt_map INTO DATA(ls_expected_map_357).
    CLEAR: lv_source, lv_z483_stage, lv_z483_bdc, ls_z483_expected.
    PERFORM normalize_mapping_source
      USING    ls_expected_map_357-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      REFRESH ct_fields.
      RETURN.
    ENDIF.
    lv_z483_stage = ls_expected_map_357-staging_field.
    TRANSLATE lv_z483_stage TO UPPER CASE.
    CONDENSE lv_z483_stage NO-GAPS.
    IF ls_expected_map_357-bdc_field IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    ls_expected_map_357-bdc_field
        CHANGING lv_z483_bdc.
    ENDIF.
    ls_z483_expected-source  = lv_source.
    ls_z483_expected-staging = lv_z483_stage.
    ls_z483_expected-bdc     = lv_z483_bdc.
    INSERT ls_z483_expected INTO TABLE lt_expected_357.
    IF sy-subrc <> 0.
      REFRESH ct_fields.
      RETURN.
    ENDIF.
  ENDLOOP.

  PERFORM read_mapping_metadata
    USING    iv_tcode iv_profile_name lv_effective_ver
    CHANGING lt_guide.

  LOOP AT lt_guide INTO ls_guide.
    IF ls_guide-metadata_origin = 'FIELD_GUIDE'.
      lv_has_guide = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

 "exact locked Mapping is also a valid template authority when the
 "optional ZBDC_FGUID_BUP transport is legacy and cannot carry Profile/Version.
 "DRAFT/raw evidence is still blocked; only persisted MAPPED/TESTING/ACTIVE
 "contracts may use this compatibility path.
  IF lv_has_guide <> abap_true.
    IF lv_status <> gc_m2_prof_mapped
       AND lv_status <> 'TESTING'
       AND lv_status <> gc_m2_prof_active.
      RETURN.
    ENDIF.
  ENDIF.

  lt_meta = lt_guide.
  IF lv_has_guide <> abap_true.
    DELETE lt_meta WHERE metadata_origin = 'LEGACY_FIELD_GUIDE'.
  ENDIF.
  PERFORM enrich_meta_from_approved_map
    USING    iv_tcode iv_profile_name
    CHANGING lt_meta.
  PERFORM enrich_meta_from_shdb_ddic
    USING    iv_tcode iv_profile_name lv_effective_ver
    CHANGING lt_meta.

  PERFORM load_profile_script
    USING    iv_tcode iv_profile_name lv_effective_ver
    CHANGING lt_script lv_script_id lv_hash lv_script_ok.

  LOOP AT lt_map INTO ls_map.
    PERFORM NORM_MAP_REQUIRED CHANGING ls_map.
    IF ls_map-mandatory = gc_m2_map_review.
      REFRESH ct_fields.
      RETURN.
    ENDIF.

    PERFORM normalize_mapping_source
      USING    ls_map-source_column
      CHANGING lv_source.

 "exact Mapping rows may not disappear at artifact build.
    IF lv_source IS INITIAL OR lv_source CP 'INPUT_*'.
      CLEAR lv_source.
      PERFORM source_from_bdc
        USING    ls_map-bdc_field
        CHANGING lv_source.
      IF lv_source IS INITIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    READ TABLE lt_seen
      WITH TABLE KEY table_line = lv_source
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.

 "exact 0350 Mapping is already the visible+filled contract.
 "Artifact generation may enrich metadata but must not reclassify/drop rows.
    CLEAR: lv_auth_ok, lv_auth_origin.
    lv_auth_ok = abap_true.
    IF lv_has_guide = abap_true.
      lv_auth_origin = 'FIELD_GUIDE'.
    ELSE.
      lv_auth_origin = 'CURRENT_PROFILE_CONTRACT'.
    ENDIF.

    INSERT lv_source INTO TABLE lt_seen.

    CLEAR: ls_meta, ls_field, lv_meta_found,
           lv_contract_ok, lv_reason, lv_example, lv_rule.

    PERFORM find_mapping_metadata
      USING    lt_meta ls_map-bdc_field
               lv_source ls_map-staging_field
      CHANGING ls_meta lv_meta_found.

    IF lv_meta_found <> abap_true.
      CLEAR ls_meta.
      ls_meta-source_column   = lv_source.
      ls_meta-staging_field   = ls_map-staging_field.
      ls_meta-bdc_field       = ls_map-bdc_field.
      ls_meta-display_label   = lv_source.
      REPLACE ALL OCCURRENCES OF '_' IN ls_meta-display_label WITH space.
      ls_meta-value_type      = gc_vt_dynamic.
      ls_meta-metadata_origin = lv_auth_origin.
      lv_meta_found = abap_true.
    ENDIF.

    IF ls_map-bdc_field IS NOT INITIAL.
      IF lv_has_guide = abap_true AND lv_auth_origin = 'FIELD_GUIDE'.
        CLEAR: ls_guide, lv_guide_found, lv_contract_ok, lv_reason.
        PERFORM find_mapping_metadata
          USING    lt_guide ls_map-bdc_field
                   lv_source ls_map-staging_field
          CHANGING ls_guide lv_guide_found.
        IF lv_guide_found = abap_true.
          PERFORM mapping_meta_contract_ok
            USING    ls_guide
            CHANGING lv_contract_ok lv_reason.
          IF lv_contract_ok = abap_true.
            ls_meta = ls_guide.
            lv_meta_found = abap_true.
          ENDIF.
        ENDIF.
        IF lv_meta_found <> abap_true.
 "Do not let a partial Field Guide hide user-sourced script input.
          CLEAR lv_projection_visible.
          PERFORM map_user_input_ok
            USING    lt_script ls_map
            CHANGING lv_projection_visible.
          IF lv_projection_visible <> abap_true.
            CONTINUE.
          ENDIF.
          CLEAR ls_meta.
        ENDIF.
      ELSEIF lv_auth_origin = 'CURRENT_PROFILE_CONTRACT'.
 "CSV and XLSX share build_xlsx_contract as the single
 "template authority. For a first-time TCODE/profile, the current
 "Mapping rows created from the current SHDB script are already the
 "business-input contract for template generation. Do not send them
 "back through the older metadata-contract gate; that gate has no
 "ACTIVE/FIELD_GUIDE metadata yet and collapses the file to
 "BUSINESS_KEY only. The check remains generic and source-driven.
        CLEAR lv_projection_visible.
        IF lv_script_ok = abap_true.
          PERFORM map_user_input_ok
            USING    lt_script ls_map
            CHANGING lv_projection_visible.
        ENDIF.
        IF lv_projection_visible <> abap_true
           AND ls_map-mandatory <> 'X'.
          CONTINUE.
        ENDIF.
      ELSE.
        IF lv_meta_found <> abap_true.
          REFRESH ct_fields.
          RETURN.
        ENDIF.

        PERFORM mapping_meta_contract_ok
          USING    ls_meta
          CHANGING lv_contract_ok lv_reason.
        IF lv_contract_ok <> abap_true.
          REFRESH ct_fields.
          RETURN.
        ENDIF.

        CLEAR lv_projection_visible.
        PERFORM bus_proj_ok
          USING    ls_map ls_meta lv_meta_found
          CHANGING lv_projection_visible.
        IF lv_projection_visible <> abap_true
           AND lv_script_ok = abap_true.
          CLEAR lv_input_ok.
          PERFORM map_user_input_ok
            USING    lt_script ls_map
            CHANGING lv_input_ok.
          IF lv_input_ok = abap_true.
            lv_projection_visible = abap_true.
          ENDIF.
        ENDIF.
        IF lv_projection_visible <> abap_true.
          CONTINUE.
        ENDIF.
      ENDIF.
    ENDIF.

    lv_index = lv_index + 1.
    ls_field-source_column = lv_source.
    ls_field-display_order = lv_index.
    ls_field-staging_field = ls_map-staging_field.
    ls_field-bdc_field = ls_map-bdc_field.

    IF ls_map-bdc_field IS INITIAL.
      ls_field-mandatory = ls_map-mandatory.
      ls_field-display_label = 'Business document key'.
      ls_field-example_value = 'DOC001'.
      ls_field-rule_text =
        'Use the same key for every row of one business document.'.
      ls_field-metadata_origin = 'SYSTEM_CONTROL'.
    ELSE.
      ls_field-display_label = ls_meta-display_label.
      IF ls_field-display_label IS INITIAL.
        ls_field-display_label = lv_source.
        REPLACE ALL OCCURRENCES OF '_'
          IN ls_field-display_label WITH space.
      ENDIF.

      ls_field-mandatory = ls_map-mandatory.
      ls_field-suggested_values = ls_meta-suggested_values.
      ls_field-metadata_origin = ls_meta-metadata_origin.

      PERFORM sanitize_xlsx_rule
        USING    ls_meta-metadata_origin ls_meta-rule_text
        CHANGING lv_rule.
      PERFORM infer_xlsx_rule_from_example
        USING    ls_meta-example_value
        CHANGING lv_rule.
      ls_field-rule_text = lv_rule.

      PERFORM normalize_xlsx_example
        USING    lv_rule ls_meta-example_value
        CHANGING lv_example.
      ls_field-example_value = lv_example.

      IF lv_source CP 'INPUT_*'.
        IF ls_field-rule_text IS INITIAL.
          ls_field-rule_text =
            'Additional SAP input captured from SHDB. Fill only to override the recorded value.'.
        ELSE.
          ls_field-rule_text = ls_field-rule_text &&
            ' Additional SAP input captured from SHDB.'.
        ENDIF.
      ENDIF.

      IF ls_field-mandatory <> 'X'
         AND ls_field-example_value IS NOT INITIAL.
        IF ls_field-rule_text IS INITIAL.
          ls_field-rule_text =
            'Optional override. Leave blank to use the recorded default shown in Example.'.
        ELSE.
          ls_field-rule_text = ls_field-rule_text &&
            ' Leave blank to use the recorded default shown in Example.'.
        ENDIF.
      ENDIF.
    ENDIF.

    APPEND ls_field TO ct_fields.
  ENDLOOP.

  IF ct_fields IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR lv_z483_bad_emit.
  LOOP AT ct_fields INTO DATA(ls_emitted_357).
    CLEAR: lv_source, lv_z483_stage, lv_z483_bdc, ls_z483_emitted.
    PERFORM normalize_mapping_source
      USING    ls_emitted_357-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      lv_z483_bad_emit = abap_true.
      EXIT.
    ENDIF.
    lv_z483_stage = ls_emitted_357-staging_field.
    TRANSLATE lv_z483_stage TO UPPER CASE.
    CONDENSE lv_z483_stage NO-GAPS.
    IF ls_emitted_357-bdc_field IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    ls_emitted_357-bdc_field
        CHANGING lv_z483_bdc.
    ENDIF.
    ls_z483_emitted-source  = lv_source.
    ls_z483_emitted-staging = lv_z483_stage.
    ls_z483_emitted-bdc     = lv_z483_bdc.
    INSERT ls_z483_emitted INTO TABLE lt_emitted_357.
    IF sy-subrc <> 0.
      lv_z483_bad_emit = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF lv_z483_bad_emit = abap_true.
    REFRESH ct_fields.
    RETURN.
  ENDIF.

 "fail closed on the complete binding identity, not only the header.
 "A template column is the exact SOURCE + STAGING + BDC binding reviewed on
 "0350. Same header with a different runtime slot/BDC field is contract drift.
  IF lt_expected_357 <> lt_emitted_357.
    REFRESH ct_fields.
    RETURN.
  ENDIF.

  cv_used = abap_true.
ENDFORM.

FORM xlsx_escape_xml
  USING    iv_text TYPE any
  CHANGING cv_text TYPE string.

  cv_text = iv_text.
  REPLACE ALL OCCURRENCES OF '&' IN cv_text WITH '&amp;'.
  REPLACE ALL OCCURRENCES OF '<' IN cv_text WITH '&lt;'.
  REPLACE ALL OCCURRENCES OF '>' IN cv_text WITH '&gt;'.
  REPLACE ALL OCCURRENCES OF '"' IN cv_text WITH '&quot;'.
  REPLACE ALL OCCURRENCES OF '''' IN cv_text WITH '&apos;'.
ENDFORM.

FORM xlsx_col_name
  USING    iv_index TYPE i
  CHANGING cv_name  TYPE string.

  CONSTANTS lc_alpha TYPE string
    VALUE 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.

  DATA: lv_number TYPE i,
        lv_offset TYPE i,
        lv_char   TYPE c LENGTH 1.

  CLEAR cv_name.
  lv_number = iv_index.

  WHILE lv_number > 0.
    lv_offset = ( lv_number - 1 ) MOD 26.
    lv_char = lc_alpha+lv_offset(1).
    cv_name = lv_char && cv_name.
    lv_number = ( lv_number - 1 ) DIV 26.
  ENDWHILE.
ENDFORM.

FORM xlsx_add_text_part
  USING    io_zip  TYPE REF TO cl_abap_zip
           iv_name TYPE string
           iv_text TYPE string.

  DATA lv_content TYPE xstring.

  CALL FUNCTION 'SCMS_STRING_TO_XSTRING'
    EXPORTING
      text     = iv_text
      mimetype = 'application/xml; charset=utf-8'
    IMPORTING
      buffer   = lv_content
    EXCEPTIONS
      failed   = 1
      OTHERS   = 2.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  io_zip->add(
    name    = iv_name
    content = lv_content ).
ENDFORM.

FORM safe_xlsx_cell
  USING    iv_row   TYPE i
           iv_col   TYPE i
           iv_value TYPE any
           iv_style TYPE any
  CHANGING cv_xml   TYPE string.

  DATA: lv_col   TYPE string,
        lv_ref   TYPE string,
        lv_value TYPE string,
        lv_style TYPE string.

  PERFORM xlsx_col_name
    USING    iv_col
    CHANGING lv_col.

  lv_ref = |{ lv_col }{ iv_row }|.
  lv_value = iv_value.
  lv_style = iv_style.
  CONDENSE lv_style NO-GAPS.

  IF lv_style IS NOT INITIAL.
    lv_style = | s="{ lv_style }"|.
  ENDIF.

  IF lv_value IS INITIAL.
    cv_xml = |<c r="{ lv_ref }"{ lv_style }/>|.
    RETURN.
  ENDIF.

  PERFORM xlsx_escape_xml
    USING    lv_value
    CHANGING lv_value.

  cv_xml =
    |<c r="{ lv_ref }"{ lv_style } t="inlineStr">| &&
    |<is><t xml:space="preserve">{ lv_value }</t></is></c>|.
ENDFORM.

FORM safe_xlsx_styled_row
  USING    it_values TYPE string_table
           it_styles TYPE string_table
           iv_row    TYPE i
  CHANGING cv_rows   TYPE string.

  DATA: lv_col   TYPE i,
        lv_cell  TYPE string,
        lv_row   TYPE string,
        lv_val   TYPE string,
        lv_style TYPE string.

  CLEAR: lv_col, lv_row.
  LOOP AT it_values INTO lv_val.
    lv_col = lv_col + 1.
    CLEAR lv_style.
    READ TABLE it_styles INTO lv_style INDEX lv_col.
    PERFORM safe_xlsx_cell
      USING    iv_row lv_col lv_val lv_style
      CHANGING lv_cell.
    lv_row = lv_row && lv_cell.
  ENDLOOP.

  cv_rows = cv_rows && |<row r="{ iv_row }">{ lv_row }</row>|.
ENDFORM.

FORM make_cols
  USING    iv_max_col TYPE i
  CHANGING cv_cols    TYPE string.

  DATA: lv_col TYPE i,
        lv_w   TYPE string.

  CLEAR cv_cols.
  IF iv_max_col <= 0.
    RETURN.
  ENDIF.

  cv_cols = '<cols>'.
  DO iv_max_col TIMES.
    lv_col = sy-index.
    IF lv_col = 1.
      lv_w = '24'.
    ELSEIF lv_col <= 6.
      lv_w = '22'.
    ELSE.
      lv_w = '20'.
    ENDIF.
    cv_cols = cv_cols &&
      |<col min="{ lv_col }" max="{ lv_col }" | &&
      |width="{ lv_w }" customWidth="1"/>|.
  ENDDO.
  cv_cols = cv_cols && '</cols>'.
ENDFORM.

FORM safe_xlsx_sheet
  USING    iv_rows       TYPE string
           iv_max_col    TYPE i
           iv_max_row    TYPE i
           iv_freeze     TYPE c
           iv_autofilter TYPE c
  CHANGING cv_xml        TYPE string.

  DATA: lv_last_col TYPE string,
        lv_dimension TYPE string,
        lv_views     TYPE string,
        lv_filter    TYPE string,
        lv_cols      TYPE string.

  IF iv_max_col <= 0.
    lv_last_col = 'A'.
  ELSE.
    PERFORM xlsx_col_name
      USING    iv_max_col
      CHANGING lv_last_col.
  ENDIF.

  lv_dimension = |A1:{ lv_last_col }{ iv_max_row }|.

  IF iv_freeze = 'X'.
    lv_views =
      |<sheetViews><sheetView workbookViewId="0">| &&
      |<pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" | &&
      |state="frozen"/>| &&
      |<selection pane="bottomLeft" activeCell="A2" sqref="A2"/>| &&
      |</sheetView></sheetViews>|.
  ELSE.
    lv_views = '<sheetViews><sheetView workbookViewId="0"/></sheetViews>'.
  ENDIF.

  IF iv_autofilter = 'X'.
 "Include the prepared input rows in the filter range, not only row 1.
    lv_filter = |<autoFilter ref="A1:{ lv_last_col }{ iv_max_row }"/>|.
  ENDIF.

  PERFORM make_cols
    USING    iv_max_col
    CHANGING lv_cols.

  cv_xml =
    |<?xml version="1.0" encoding="UTF-8" standalone="yes"?>| &&
    |<worksheet xmlns="http://schemas.openxmlformats.org/| &&
    |spreadsheetml/2006/main">| &&
    |<dimension ref="{ lv_dimension }"/>| &&
    lv_views &&
    lv_cols &&
    |<sheetData>{ iv_rows }</sheetData>| &&
    lv_filter &&
    |</worksheet>|.
ENDFORM.

FORM safe_xlsx_plain_row
  USING    it_values TYPE string_table
           iv_row    TYPE i
  CHANGING cv_rows   TYPE string.

  DATA lt_styles TYPE string_table.

  REFRESH lt_styles.
  PERFORM safe_xlsx_styled_row
    USING    it_values lt_styles iv_row
    CHANGING cv_rows.
ENDFORM.

FORM make_safe_data_sheet
  USING    pt_fields TYPE ty_t_xlsx_field
  CHANGING cv_xml    TYPE string.

  DATA: lt_row      TYPE string_table,
        ls_field    TYPE ty_xlsx_field,
        lv_header   TYPE string,
        lv_rows     TYPE string,
        lv_row      TYPE i,
        lv_max_col  TYPE i.

 "DATA-ONLY template. Do not attach style ids to any cell.
 "The XLSX therefore uses the spreadsheet application's default font,
 "default colors and default cell appearance. Headers are neutral business
 "source names; blank eligibility is proven later from the frozen contract.
  REFRESH lt_row.
  LOOP AT pt_fields INTO ls_field.
    lv_header = ls_field-source_column.
    APPEND lv_header TO lt_row.
  ENDLOOP.

  lv_max_col = lines( lt_row ).
  IF lv_max_col <= 0.
    CLEAR cv_xml.
    RETURN.
  ENDIF.

  PERFORM safe_xlsx_plain_row
    USING    lt_row 1
    CHANGING lv_rows.

 "Keep empty entry rows so users can type immediately after opening.
 "They are plain cells: no fill, font, border or number-format styling.
  DO 100 TIMES.
    lv_row = sy-index + 1.
    REFRESH lt_row.
    LOOP AT pt_fields INTO ls_field.
      APPEND '' TO lt_row.
    ENDLOOP.
    PERFORM safe_xlsx_plain_row
      USING    lt_row lv_row
      CHANGING lv_rows.
  ENDDO.

 "Generate XLSX like CSV input template: plain cells only.
 "No AutoFilter/dropdown arrow and no data-validation dropdowns.
  PERFORM safe_xlsx_sheet
    USING    lv_rows lv_max_col 101 'X' space
    CHANGING cv_xml.
ENDFORM.

FORM build_safe_xlsx_package
  USING    pt_fields       TYPE ty_t_xlsx_field
           iv_tcode        TYPE any
           iv_profile_name TYPE any
           iv_profile_ver  TYPE any
  CHANGING cv_xlsx         TYPE xstring
           cv_ok           TYPE abap_bool.

  DATA: lo_zip      TYPE REF TO cl_abap_zip,
        lv_data     TYPE string,
        lv_content  TYPE string,
        lv_rels     TYPE string,
        lv_workbook TYPE string,
        lv_wb_rels  TYPE string,
        lv_core     TYPE string,
        lv_app      TYPE string,
        lv_created  TYPE string.

  CLEAR: cv_xlsx, cv_ok.

 "one workbook, one visible worksheet, no style part.
 "iv_tcode/profile/version stay in the signature for compatibility with
 "existing callers; template content is derived only from pt_fields.
  PERFORM make_safe_data_sheet
    USING    pt_fields
    CHANGING lv_data.

  IF lv_data IS INITIAL.
    RETURN.
  ENDIF.

  lv_content =
    |<?xml version="1.0" encoding="UTF-8" standalone="yes"?>| &&
    |<Types xmlns="http://schemas.openxmlformats.org/package/2006/| &&
    |content-types">| &&
    |<Default Extension="rels" ContentType="application/vnd.openxmlformats-| &&
    |package.relationships+xml"/>| &&
    |<Default Extension="xml" ContentType="application/xml"/>| &&
    |<Override PartName="/xl/workbook.xml" ContentType="application/| &&
    |vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>| &&
    |<Override PartName="/xl/worksheets/sheet1.xml" ContentType="| &&
    |application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>| &&
    |<Override PartName="/docProps/core.xml" ContentType="application/| &&
    |vnd.openxmlformats-package.core-properties+xml"/>| &&
    |<Override PartName="/docProps/app.xml" ContentType="application/| &&
    |vnd.openxmlformats-officedocument.extended-properties+xml"/>| &&
    |</Types>|.

  lv_rels =
    |<?xml version="1.0" encoding="UTF-8" standalone="yes"?>| &&
    |<Relationships xmlns="http://schemas.openxmlformats.org/package/| &&
    |2006/relationships">| &&
    |<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/| &&
    |officeDocument/2006/relationships/officeDocument" | &&
    |Target="xl/workbook.xml"/>| &&
    |<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/| &&
    |package/2006/relationships/metadata/core-properties" | &&
    |Target="docProps/core.xml"/>| &&
    |<Relationship Id="rId3" Type="http://schemas.openxmlformats.org/| &&
    |officeDocument/2006/relationships/extended-properties" | &&
    |Target="docProps/app.xml"/></Relationships>|.

  lv_workbook =
    |<?xml version="1.0" encoding="UTF-8" standalone="yes"?>| &&
    |<workbook xmlns="http://schemas.openxmlformats.org/| &&
    |spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/| &&
    |officeDocument/2006/relationships">| &&
    |<sheets>| &&
    |<sheet name="Data" sheetId="1" r:id="rId1"/>| &&
    |</sheets></workbook>|.

  lv_wb_rels =
    |<?xml version="1.0" encoding="UTF-8" standalone="yes"?>| &&
    |<Relationships xmlns="http://schemas.openxmlformats.org/package/| &&
    |2006/relationships">| &&
    |<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/| &&
    |officeDocument/2006/relationships/worksheet" | &&
    |Target="worksheets/sheet1.xml"/>| &&
    |</Relationships>|.

  PERFORM get_utc_w3cdtf CHANGING lv_created.

  lv_core =
    |<?xml version="1.0" encoding="UTF-8" standalone="yes"?>| &&
    |<cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/| &&
    |package/2006/metadata/core-properties" | &&
    |xmlns:dc="http://purl.org/dc/elements/1.1/" | &&
    |xmlns:dcterms="http://purl.org/dc/terms/" | &&
    |xmlns:dcmitype="http://purl.org/dc/dcmitype/" | &&
    |xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">| &&
    |<dc:creator>SAP BDC Dynamic Engine</dc:creator>| &&
    |<cp:lastModifiedBy>{ sy-uname }</cp:lastModifiedBy>| &&
    |<dcterms:created xsi:type="dcterms:W3CDTF">| &&
    |{ lv_created }</dcterms:created>| &&
    |<dcterms:modified xsi:type="dcterms:W3CDTF">| &&
    |{ lv_created }</dcterms:modified></cp:coreProperties>|.

  lv_app =
    |<?xml version="1.0" encoding="UTF-8" standalone="yes"?>| &&
    |<Properties xmlns="http://schemas.openxmlformats.org/| &&
    |officeDocument/2006/extended-properties" | &&
    |xmlns:vt="http://schemas.openxmlformats.org/officeDocument/| &&
    |2006/docPropsVTypes"><Application>SAP BDC Dynamic Engine| &&
    |</Application><AppVersion>1.0</AppVersion></Properties>|.

  CREATE OBJECT lo_zip.

  PERFORM xlsx_add_text_part USING lo_zip '[Content_Types].xml' lv_content.
  PERFORM xlsx_add_text_part USING lo_zip '_rels/.rels' lv_rels.
  PERFORM xlsx_add_text_part USING lo_zip 'xl/workbook.xml' lv_workbook.
  PERFORM xlsx_add_text_part USING lo_zip 'xl/_rels/workbook.xml.rels' lv_wb_rels.
  PERFORM xlsx_add_text_part USING lo_zip 'xl/worksheets/sheet1.xml' lv_data.
  PERFORM xlsx_add_text_part USING lo_zip 'docProps/core.xml' lv_core.
  PERFORM xlsx_add_text_part USING lo_zip 'docProps/app.xml' lv_app.

  cv_xlsx = lo_zip->save( ).
  IF cv_xlsx IS INITIAL.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

FORM csv_escape_template_cell
  USING    iv_value TYPE any
  CHANGING cv_value TYPE string.

  DATA: lv_text       TYPE string,
        lv_need_quote TYPE abap_bool.

  lv_text = iv_value.
  CLEAR lv_need_quote.

  IF lv_text CS ',' OR lv_text CS '"'
     OR lv_text CS cl_abap_char_utilities=>newline.
    lv_need_quote = abap_true.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '"' IN lv_text WITH '""'.

  IF lv_need_quote = abap_true.
    cv_value = '"' && lv_text && '"'.
  ELSE.
    cv_value = lv_text.
  ENDIF.
ENDFORM.

FORM csv_append_template_cell
  USING    iv_cell TYPE any
  CHANGING cv_line TYPE string.

  DATA lv_cell TYPE string.

  PERFORM csv_escape_template_cell
    USING    iv_cell
    CHANGING lv_cell.

  IF cv_line IS INITIAL.
    cv_line = lv_cell.
  ELSE.
    cv_line = cv_line && ',' && lv_cell.
  ENDIF.
ENDFORM.

FORM build_csv_template_package
  USING    pt_fields TYPE ty_t_xlsx_field
  CHANGING ct_csv    TYPE string_table.

  DATA: ls_field TYPE ty_xlsx_field,
        lv_line  TYPE string,
        lv_head  TYPE string.

  REFRESH ct_csv.

  CLEAR lv_line.
  LOOP AT pt_fields INTO ls_field.
    lv_head = ls_field-source_column.
    PERFORM csv_append_template_cell
      USING    lv_head
      CHANGING lv_line.
  ENDLOOP.
  APPEND lv_line TO ct_csv.
ENDFORM.

FORM choose_template_format
  CHANGING cv_format TYPE c.

  DATA lv_answer TYPE c LENGTH 1.

  CLEAR cv_format.

  CALL FUNCTION 'POPUP_TO_CONFIRM'
    EXPORTING
      titlebar              = 'Generate Template'
      text_question         = 'Choose the output format for this template.'
      text_button_1         = 'XLSX'
      text_button_2         = 'CSV'
      default_button        = '1'
      display_cancel_button = 'X'
      start_column          = 30
      start_row             = 8
    IMPORTING
      answer                = lv_answer
    EXCEPTIONS
      OTHERS                = 1.

  IF sy-subrc <> 0.
    CLEAR cv_format.
    RETURN.
  ENDIF.

  CASE lv_answer.
    WHEN '1'.
      cv_format = 'X'.
    WHEN '2'.
      cv_format = 'C'.
    WHEN OTHERS.
      CLEAR cv_format.
  ENDCASE.
ENDFORM.

*& Dynamic Template Delivery: Local / Gmail / Google Drive
*& Contract owner remains SAP: n8n/Apps Script only transport bytes.

FORM json_escape
  USING    iv_value TYPE string
  CHANGING cv_value TYPE string.

  DATA: lv_crlf TYPE string,
        lv_lf   TYPE string,
        lv_tab  TYPE string.

  cv_value = iv_value.

  IF cv_value IS INITIAL.
    RETURN.
  ENDIF.

  lv_crlf = cl_abap_char_utilities=>cr_lf.
  lv_lf   = cl_abap_char_utilities=>newline.
  lv_tab  = cl_abap_char_utilities=>horizontal_tab.

  REPLACE ALL OCCURRENCES OF '\' IN cv_value WITH '\\'.
  REPLACE ALL OCCURRENCES OF '"' IN cv_value WITH '"'.

 "Guard dynamic REPLACE patterns. Some SAP kernels can dump
 "with CX_SY_REPLACE_INFINITE_LOOP when the search pattern resolves to
 "an empty value.
  IF lv_crlf IS NOT INITIAL.
    REPLACE ALL OCCURRENCES OF lv_crlf IN cv_value WITH '\n'.
  ENDIF.

  IF lv_lf IS NOT INITIAL.
    REPLACE ALL OCCURRENCES OF lv_lf IN cv_value WITH '\n'.
  ENDIF.

  IF lv_tab IS NOT INITIAL.
    REPLACE ALL OCCURRENCES OF lv_tab IN cv_value WITH '\t'.
  ENDIF.
ENDFORM.

FORM get_config_value
  USING    iv_key   TYPE string
  CHANGING cv_value TYPE string.

  DATA lv_key TYPE zbdc_config_bup-config_key.

  CLEAR cv_value.
  lv_key = iv_key.
  SELECT SINGLE config_value
    FROM zbdc_config_bup
    INTO @cv_value
    WHERE config_key = @lv_key.
  CONDENSE cv_value.
ENDFORM.

FORM get_required_config
  USING    iv_key   TYPE string
  CHANGING cv_value TYPE string.

  CLEAR cv_value.

  PERFORM get_config_value
    USING    iv_key
    CHANGING cv_value.

  CONDENSE cv_value.

  IF cv_value IS INITIAL.
    MESSAGE s716(zbdc)
      WITH iv_key
      DISPLAY LIKE 'E'.
  ENDIF.
ENDFORM.

FORM get_optional_config
  USING    iv_key   TYPE string
  CHANGING cv_value TYPE string.

  CLEAR cv_value.

  PERFORM get_config_value
    USING    iv_key
    CHANGING cv_value.

  CONDENSE cv_value.
ENDFORM.
