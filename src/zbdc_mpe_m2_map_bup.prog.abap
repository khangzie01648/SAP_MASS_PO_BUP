*& Projection provenance lifecycle / classifier certificate

*& GV_Z359_INPUT_ORIGIN is older UI/context state and can legitimately be
*& rewritten to SCHEMA_REUSE / SCHEMA_COMPARE / LOCKED_CONTRACT. It must not
*& decide how a CURRENT acquisition is classified. GV_Z652_ACQ_ORIGIN is the
*& immutable acquisition origin for the current raw evidence only.

FORM get_projection_origin
  CHANGING cv_origin TYPE any.

  CLEAR cv_origin.

  IF gv_z652_acq_origin IS NOT INITIAL
     AND gt_z333_rec_evidence IS NOT INITIAL.
    cv_origin = gv_z652_acq_origin.
  ELSE.
    cv_origin = gv_z359_input_origin.
    IF cv_origin IS INITIAL.
      cv_origin = gv_z133_origin.
    ENDIF.
  ENDIF.

  TRANSLATE cv_origin TO UPPER CASE.
  CONDENSE cv_origin NO-GAPS.
ENDFORM.

FORM current_mapclass
  CHANGING cv_version TYPE zbdc_config_bup-config_value.

  CLEAR cv_version.
 "Bump only when the RAW/evidence -> Template-Mapping membership contract
 "changes. This is intentionally independent of the S1 replay compiler.
  cv_version = 'M2P47'.
ENDFORM.

FORM mapclass_cert_ok
  USING    iv_script_id TYPE zbdc_script_bup-script_id
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_have TYPE zbdc_config_bup-config_value,
        lv_need TYPE zbdc_config_bup-config_value.

  CLEAR: cv_ok, cv_message, lv_have, lv_need.
  IF iv_script_id IS INITIAL.
    cv_message = 'Mapping classifier certificate requires Script ID.'.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'MAPCLASS'
    CHANGING lv_have.
  PERFORM current_mapclass CHANGING lv_need.

  TRANSLATE lv_have TO UPPER CASE.
  CONDENSE lv_have NO-GAPS.
  TRANSLATE lv_need TO UPPER CASE.
  CONDENSE lv_need NO-GAPS.

  IF lv_have IS INITIAL OR lv_have <> lv_need.
    cv_message =
      |Mapping classifier certificate mismatch for Script { iv_script_id }: have { lv_have }, require { lv_need }. Fresh acquisition must rebuild the Mapping schema.|.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

FORM download_gdrive_script_csv.
  DATA: lo_client      TYPE REF TO if_http_client,
        lv_code        TYPE i,
        lv_url         TYPE string,
        lv_base_url    TYPE string,
        lv_dummy       TYPE string,
        lv_resp        TYPE string,
        lt_raw         TYPE string_table,
        lv_before      TYPE i,
        lv_after       TYPE i,
        lv_loaded      TYPE i,
        lv_bytes       TYPE i,
        lv_session_id  TYPE zbdc_staging_bup-session_id,
        ls_meta        TYPE ty_files_disp,
        lv_unit_name   TYPE string,
        lv_file_name   TYPE string,
        lv_tcode       TYPE string.

  lv_base_url = txtp_gdrive_url.
  CONDENSE lv_base_url NO-GAPS.

  IF lv_base_url IS INITIAL.
    MESSAGE e707(zbdc).
    RETURN.
  ENDIF.

  IF lv_base_url CS '?'.
    SPLIT lv_base_url AT '?' INTO lv_base_url lv_dummy.
  ENDIF.

  IF p_transaction IS INITIAL.
    MESSAGE e250(zbdc).
    RETURN.
  ENDIF.

  lv_tcode = p_transaction.
  TRANSLATE lv_tcode TO UPPER CASE.
  lv_url = lv_base_url && '?action=csv&tcode=' && lv_tcode.
  IF gv_gdrive_token IS NOT INITIAL.
    lv_url = lv_url && '&code=' && gv_gdrive_token.
  ENDIF.

  cl_http_client=>create_by_url( EXPORTING url = lv_url IMPORTING client = lo_client EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc <> 0.
    MESSAGE e708(zbdc).
    RETURN.
  ENDIF.

  lo_client->request->set_method( 'GET' ).
  lo_client->propertytype_redirect = lo_client->co_enabled.
  lo_client->send( EXCEPTIONS OTHERS = 1 ).
  lo_client->receive( EXCEPTIONS OTHERS = 1 ).
  lo_client->response->get_status( IMPORTING code = lv_code ).
  lv_resp = lo_client->response->get_cdata( ).
  lo_client->close( ).

  IF lv_code <> 200.
    IF lv_code = 403.
      MESSAGE e709(zbdc).
    ELSE.
      MESSAGE e710(zbdc)
        WITH lv_code.
    ENDIF.
    RETURN.
  ENDIF.

  IF lv_resp IS INITIAL.
    MESSAGE e711(zbdc).
    RETURN.
  ENDIF.

  IF lv_resp CS '<html' OR lv_resp CS '<!DOCTYPE' OR lv_resp CS '<body'.
    MESSAGE e251(zbdc).
    RETURN.
  ENDIF.

  REFRESH gt_staging.
  PERFORM start_ingest_batch.
  PERFORM make_batch_session USING 1 CHANGING lv_session_id.

  gv_forced_session_id = lv_session_id.
  lv_file_name = lv_tcode && '_AppsScript.csv'.
  gv_current_file_name  = lv_file_name.
  gv_current_sheet_name = 'DATA'.
  gv_current_unit_src   = 'GDRIVE'.
  txtp_file_path        = 'GoogleDrive://' && lv_file_name.

  REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf
          IN lv_resp WITH cl_abap_char_utilities=>newline.
  REFRESH lt_raw.
  SPLIT lv_resp AT cl_abap_char_utilities=>newline INTO TABLE lt_raw.

  lv_bytes = strlen( lv_resp ).
  PERFORM format_file_size USING lv_bytes CHANGING txtp_file_size.

  lv_before = lines( gt_staging ).
  PERFORM process_csv_rows USING lt_raw.
  lv_after = lines( gt_staging ).
  lv_loaded = lv_after - lv_before.

  CLEAR: gv_forced_session_id, gv_current_file_name, gv_current_sheet_name, gv_current_unit_src.
  PERFORM finish_ingest_batch.

  IF lv_loaded <= 0.
    MESSAGE e252(zbdc).
    RETURN.
  ENDIF.

  MODIFY zbdc_staging_bup FROM TABLE gt_staging.

  PERFORM p1_compose_unit_name USING lv_file_name 'DATA' CHANGING lv_unit_name.
  PERFORM save_ingestion_source_log USING lv_session_id 'GDRIVE' lv_unit_name.
  PERFORM update_session_summary USING lv_session_id.
  PERFORM register_current_session USING lv_session_id.

  CLEAR ls_meta.
  ls_meta-file_name   = lv_unit_name.
  PERFORM p1_split_unit_name USING lv_unit_name CHANGING ls_meta-file_title ls_meta-sheet_name.
  ls_meta-file_size   = txtp_file_size.
  ls_meta-rows_loaded = lv_loaded.
  ls_meta-channel     = 'GDRIVE_INGESTION'.
  PERFORM get_demo_now CHANGING ls_meta-upload_date ls_meta-upload_time.
  ls_meta-username    = sy-uname.
  ls_meta-session_id  = lv_session_id.
  ls_meta-tx_code     = p_transaction.
  APPEND ls_meta TO gt_files_preview.

  COMMIT WORK AND WAIT.
  PERFORM set_row_count_fields USING lv_loaded.
  PERFORM prepare_preview_file.

  MESSAGE s253(zbdc)
    WITH lv_loaded.
ENDFORM.

