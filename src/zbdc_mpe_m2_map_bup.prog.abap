*& One canonical template name for every delivery channel

FORM template_name
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
           iv_ext     TYPE csequence
  CHANGING cv_name    TYPE string.

  DATA: lv_tcode   TYPE string,
        lv_profile TYPE string,
        lv_ver     TYPE string,
        lv_ext     TYPE string.

  CLEAR cv_name.

  lv_tcode = iv_tcode.
  lv_profile = iv_profile.
  lv_ver = iv_ver.
  lv_ext = iv_ext.

  TRANSLATE lv_tcode TO UPPER CASE.
  TRANSLATE lv_profile TO UPPER CASE.
  TRANSLATE lv_ext TO LOWER CASE.
  CONDENSE lv_tcode NO-GAPS.
  CONDENSE lv_profile NO-GAPS.
  CONDENSE lv_ver NO-GAPS.
  CONDENSE lv_ext NO-GAPS.

  WHILE strlen( lv_ver ) < 4.
    lv_ver = '0' && lv_ver.
  ENDWHILE.

  cv_name = |template_{ lv_tcode }_{ lv_profile }_v{ lv_ver }|.
  IF lv_ext IS NOT INITIAL.
    cv_name = cv_name && |.{ lv_ext }|.
  ENDIF.
  TRANSLATE cv_name USING ' _'.
ENDFORM.

FORM choose_template_delivery
  CHANGING cv_delivery TYPE c.

  TYPES: BEGIN OF ty_z138_delivery_choice,
           seq_no   TYPE i,
           delivery TYPE c LENGTH 1,
           method   TYPE c LENGTH 28,
         END OF ty_z138_delivery_choice.

  DATA: lt_choice   TYPE STANDARD TABLE OF ty_z138_delivery_choice,
        ls_choice   TYPE ty_z138_delivery_choice,
        lt_fieldcat TYPE slis_t_fieldcat_alv,
        ls_fieldcat TYPE slis_fieldcat_alv,
        ls_selfield TYPE slis_selfield,
        lv_exit     TYPE c.

  CLEAR cv_delivery.

  APPEND VALUE #( seq_no   = 1
                  delivery = 'L'
                  method   = 'Download Local' ) TO lt_choice.
  APPEND VALUE #( seq_no   = 2
                  delivery = 'M'
                  method   = 'Gmail Data Entry Request' ) TO lt_choice.
  APPEND VALUE #( seq_no   = 3
                  delivery = 'G'
                  method   = 'Upload to Google Drive' ) TO lt_choice.

  DEFINE add_z138_delv_fcat.
    CLEAR ls_fieldcat.
    ls_fieldcat-fieldname = &1.
    ls_fieldcat-seltext_s = &2.
    ls_fieldcat-seltext_m = &3.
    ls_fieldcat-seltext_l = &3.
    ls_fieldcat-outputlen = &4.
    ls_fieldcat-no_out    = &5.
    APPEND ls_fieldcat TO lt_fieldcat.
  END-OF-DEFINITION.

  add_z138_delv_fcat 'SEQ_NO'   'No'       'No'              4  ''.
  add_z138_delv_fcat 'METHOD'   'Method'   'Delivery Method' 28 ''.
  add_z138_delv_fcat 'DELIVERY' 'Code'     'Delivery Code'    1 'X'.

  CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
    EXPORTING
      i_title               = 'Choose Template Delivery'
      i_selection           = 'X'
      i_zebra               = 'X'
      i_tabname             = 'LT_CHOICE'
      it_fieldcat           = lt_fieldcat
      i_screen_start_column = 18
      i_screen_start_line   = 5
      i_screen_end_column   = 78
      i_screen_end_line     = 11
    IMPORTING
      es_selfield           = ls_selfield
      e_exit                = lv_exit
    TABLES
      t_outtab              = lt_choice
    EXCEPTIONS
      program_error         = 1
      OTHERS                = 2.

  IF lv_exit = 'X' OR sy-subrc <> 0.
    CLEAR cv_delivery.
    RETURN.
  ENDIF.

  IF ls_selfield-tabindex <= 0.
    MESSAGE s278(zbdc)
      DISPLAY LIKE 'W'.
    RETURN.
  ENDIF.

  READ TABLE lt_choice INTO ls_choice INDEX ls_selfield-tabindex.
  IF sy-subrc = 0.
    cv_delivery = ls_choice-delivery.
  ENDIF.
ENDFORM.

FORM csv_lines_to_xstring
  USING    pt_csv     TYPE string_table
  CHANGING cv_xstring TYPE xstring
           cv_size    TYPE i
           cv_ok      TYPE abap_bool.

  DATA: lv_csv TYPE string,
        lv_line TYPE string.

  CLEAR: cv_xstring, cv_size, cv_ok.

  LOOP AT pt_csv INTO lv_line.
    IF lv_csv IS INITIAL.
      lv_csv = lv_line.
    ELSE.
      lv_csv = lv_csv && cl_abap_char_utilities=>cr_lf && lv_line.
    ENDIF.
  ENDLOOP.

  CALL FUNCTION 'SCMS_STRING_TO_XSTRING'
    EXPORTING
      text     = lv_csv
      mimetype = 'text/csv; charset=utf-8'
    IMPORTING
      buffer   = cv_xstring
    EXCEPTIONS
      failed   = 1
      OTHERS   = 2.

  IF sy-subrc = 0 AND cv_xstring IS NOT INITIAL.
    cv_size = xstrlen( cv_xstring ).
    cv_ok = abap_true.
  ENDIF.
ENDFORM.

FORM ensure_gdrive_token
  CHANGING cv_ok TYPE abap_bool.

  DATA: lo_client       TYPE REF TO if_http_client,
        lv_resp         TYPE string,
        lv_code         TYPE i,
        lv_qcode        TYPE string,
        lv_ret          TYPE c,
        lt_sval         TYPE STANDARD TABLE OF sval,
        ls_sval         TYPE sval,
        lv_gas_base_url TYPE string,
        lv_token_url    TYPE string,
        lv_token_action TYPE string,
        lv_gas_pattern  TYPE string,
        lv_ready        TYPE c LENGTH 1,
        lv_dummy        TYPE string,
        lv_send_rc      TYPE sy-subrc,
        lv_receive_rc   TYPE sy-subrc.

  CLEAR cv_ok.

  IF gv_gdrive_token IS NOT INITIAL.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  PERFORM get_required_config
    USING    'GDRIVE_SCRIPT_URL'
    CHANGING lv_gas_base_url.
  IF lv_gas_base_url IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_required_config
    USING    'GDRIVE_TOKEN_ACTION'
    CHANGING lv_token_action.
  IF lv_token_action IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_required_config
    USING    'GAS_EXEC_URL_PATTERN'
    CHANGING lv_gas_pattern.
  IF lv_gas_pattern IS INITIAL.
    RETURN.
  ENDIF.

  CONDENSE lv_gas_base_url NO-GAPS.
  CONDENSE lv_token_action NO-GAPS.
  CONDENSE lv_gas_pattern NO-GAPS.

  IF lv_gas_base_url NP lv_gas_pattern.
    MESSAGE s717(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF lv_gas_base_url CS '?'.
    SPLIT lv_gas_base_url AT '?' INTO lv_gas_base_url lv_dummy.
  ENDIF.

  cl_gui_frontend_services=>execute(
    EXPORTING document = lv_gas_base_url
    EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc <> 0.
    MESSAGE s718(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.
  cl_gui_cfw=>flush( ).

  CALL FUNCTION 'POPUP_TO_CONFIRM'
    EXPORTING
      titlebar              = 'Google Drive Authorization'
      text_question         = 'Copy the 6-digit code from the Apps Script page, then continue.'
      text_button_1         = 'Continue'
      text_button_2         = 'Cancel'
      icon_button_2         = 'ICON_CANCEL'
      default_button        = '1'
      display_cancel_button = space
    IMPORTING
      answer                = lv_ready.
  IF lv_ready <> '1'.
    MESSAGE s719(zbdc).
    RETURN.
  ENDIF.

  CLEAR ls_sval.
  ls_sval-tabname   = 'ZBDC_CONFIG_BUP'.
  ls_sval-fieldname = 'CONFIG_VALUE'.
  ls_sval-fieldtext = '6-digit authorization code'.
  APPEND ls_sval TO lt_sval.

  CALL FUNCTION 'POPUP_GET_VALUES'
    EXPORTING
      popup_title = 'Google Drive authorization'
    IMPORTING
      returncode  = lv_ret
    TABLES
      fields      = lt_sval.

  IF lv_ret = 'A'.
    MESSAGE s720(zbdc).
    RETURN.
  ENDIF.

  READ TABLE lt_sval INTO ls_sval INDEX 1.
  lv_qcode = ls_sval-value.
  CONDENSE lv_qcode NO-GAPS.
  IF lv_qcode IS INITIAL.
    MESSAGE s721(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lv_token_url = lv_gas_base_url && '?action=' &&
    cl_http_utility=>escape_url( lv_token_action ) &&
    '&code=' && cl_http_utility=>escape_url( lv_qcode ).

  cl_http_client=>create_by_url(
    EXPORTING url = lv_token_url
    IMPORTING client = lo_client
    EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc <> 0 OR lo_client IS INITIAL.
    MESSAGE s722(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lo_client->request->set_method( 'GET' ).
  lo_client->propertytype_redirect = lo_client->co_enabled.

  lo_client->send( EXCEPTIONS OTHERS = 1 ).
  lv_send_rc = sy-subrc.
  IF lv_send_rc <> 0.
    lo_client->close( ).
    MESSAGE s723(zbdc)
      WITH lv_send_rc
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lo_client->receive( EXCEPTIONS OTHERS = 1 ).
  lv_receive_rc = sy-subrc.
  IF lv_receive_rc <> 0.
    lo_client->close( ).
    MESSAGE s724(zbdc)
      WITH lv_receive_rc
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lo_client->response->get_status( IMPORTING code = lv_code ).
  lv_resp = lo_client->response->get_cdata( ).
  lo_client->close( ).
  CONDENSE lv_resp NO-GAPS.

  IF lv_code <> 200 OR lv_resp IS INITIAL OR lv_resp CP 'ERROR:*'.
    MESSAGE s725(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF strlen( lv_resp ) < 20.
    MESSAGE s726(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  gv_gdrive_token = lv_resp.
  cv_ok = abap_true.
ENDFORM.


*&---------------------------------------------------------------------*
*& Verify exact Google Drive upload side effect
*&---------------------------------------------------------------------*
*& This is a transport-reconciliation proof only. It never turns an
*& unverified n8n/App Script error into success.
*& Success requires one Drive file whose exact metadata matches THIS
*& requestId + contentHash + contract identity + filename/mime/size.
FORM verify_gdrive_upload_effect
  USING    iv_filename      TYPE string
           iv_mimetype      TYPE string
           iv_folder_id     TYPE string
           iv_request_id    TYPE string
           iv_content_hash  TYPE string
           iv_contract_hash TYPE string
           iv_tcode         TYPE zbdc_prof_bup-tcode
           iv_profile       TYPE zbdc_prof_bup-profile_name
           iv_ver           TYPE zbdc_prof_bup-profile_ver
           iv_size          TYPE i
  CHANGING cv_ok            TYPE abap_bool
           cv_file_id       TYPE string
           cv_url           TYPE string.

  TYPES: BEGIN OF ty_drive_file,
           id            TYPE string,
           name          TYPE string,
           mime_type     TYPE string,
           size          TYPE string,
           web_view_link TYPE string,
           description   TYPE string,
         END OF ty_drive_file.
  TYPES ty_t_drive_file TYPE STANDARD TABLE OF ty_drive_file WITH DEFAULT KEY.
  TYPES: BEGIN OF ty_drive_resp,
           files TYPE ty_t_drive_file,
         END OF ty_drive_resp.
  TYPES: BEGIN OF ty_drive_desc,
           tcode         TYPE string,
           profile       TYPE string,
           version       TYPE string,
           script_id     TYPE string,
           contract_hash TYPE string,
           request_id    TYPE string,
           content_hash  TYPE string,
           generated_at  TYPE string,
         END OF ty_drive_desc.

  DATA: lo_client    TYPE REF TO if_http_client,
        lv_api_url   TYPE string,
        lv_url       TYPE string,
        lv_query     TYPE string,
        lv_fields    TYPE string,
        lv_parent    TYPE string,
        lv_code      TYPE i,
        lv_resp      TYPE string,
        lv_size_text TYPE string,
        lv_ver_text  TYPE string,
        ls_resp      TYPE ty_drive_resp,
        ls_file      TYPE ty_drive_file,
        ls_desc      TYPE ty_drive_desc.

  CLEAR: cv_ok, cv_file_id, cv_url.

  IF gv_gdrive_token IS INITIAL
     OR iv_filename IS INITIAL
     OR iv_mimetype IS INITIAL
     OR iv_request_id IS INITIAL
     OR iv_content_hash IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_drv_api_base CHANGING lv_api_url.
  IF lv_api_url IS INITIAL.
    RETURN.
  ENDIF.

  lv_parent = iv_folder_id.
  CONDENSE lv_parent NO-GAPS.
  IF lv_parent IS INITIAL.
    lv_parent = 'root'.
  ENDIF.

  lv_size_text = iv_size.
  CONDENSE lv_size_text NO-GAPS.
  lv_ver_text = iv_ver.
  CONDENSE lv_ver_text NO-GAPS.

 "Generated template names/profile ids are system-owned and do not contain
 "Drive-query quote syntax. Keep the query exact so we never accept a
 "different file merely because the transport failed.
  lv_query =
      |name = '{ iv_filename }' and | &&
      |mimeType = '{ iv_mimetype }' and | &&
      |trashed = false and '{ lv_parent }' in parents|.

  lv_fields =
    'files(id,name,mimeType,size,webViewLink,description)'.

  lv_url = lv_api_url &&
    '?q=' && cl_http_utility=>escape_url( lv_query ) &&
    '&pageSize=10&orderBy=modifiedTime%20desc&fields=' &&
    cl_http_utility=>escape_url( lv_fields ).

  cl_http_client=>create_by_url(
    EXPORTING
      url    = lv_url
    IMPORTING
      client = lo_client
    EXCEPTIONS
      OTHERS = 1 ).
  IF sy-subrc <> 0 OR lo_client IS INITIAL.
    RETURN.
  ENDIF.

  lo_client->request->set_method( 'GET' ).
  lo_client->request->set_header_field(
    name  = 'Authorization'
    value = |Bearer { gv_gdrive_token }| ).
  lo_client->request->set_header_field(
    name  = 'Accept'
    value = 'application/json' ).

  lo_client->send( EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc <> 0.
    lo_client->close( ).
    RETURN.
  ENDIF.

  lo_client->receive( EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc <> 0.
    lo_client->close( ).
    RETURN.
  ENDIF.

  lo_client->response->get_status( IMPORTING code = lv_code ).
  lv_resp = lo_client->response->get_cdata( ).
  lo_client->close( ).

  IF lv_code = 401 OR lv_code = 403.
    CLEAR gv_gdrive_token.
    RETURN.
  ENDIF.
  IF lv_code <> 200 OR lv_resp IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR ls_resp.
  TRY.
      /ui2/cl_json=>deserialize(
        EXPORTING
          json        = lv_resp
          pretty_name = /ui2/cl_json=>pretty_mode-camel_case
        CHANGING
          data        = ls_resp ).
    CATCH cx_root.
      RETURN.
  ENDTRY.

  LOOP AT ls_resp-files INTO ls_file.
    IF ls_file-id IS INITIAL
       OR ls_file-name <> iv_filename
       OR ls_file-mime_type <> iv_mimetype
       OR ls_file-size <> lv_size_text
       OR ls_file-description IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_desc.
    TRY.
        /ui2/cl_json=>deserialize(
          EXPORTING
            json        = ls_file-description
            pretty_name = /ui2/cl_json=>pretty_mode-camel_case
          CHANGING
            data        = ls_desc ).
      CATCH cx_root.
        CONTINUE.
    ENDTRY.

    IF ls_desc-request_id <> iv_request_id
       OR ls_desc-content_hash <> iv_content_hash
       OR ls_desc-tcode <> iv_tcode
       OR ls_desc-profile <> iv_profile
       OR ls_desc-version <> lv_ver_text.
      CONTINUE.
    ENDIF.

    IF iv_contract_hash IS NOT INITIAL
       AND ls_desc-contract_hash <> iv_contract_hash.
      CONTINUE.
    ENDIF.

    cv_file_id = ls_file-id.
    cv_url     = ls_file-web_view_link.
    cv_ok      = abap_true.
    RETURN.
  ENDLOOP.

ENDFORM.

FORM upload_template_to_gdrive
  USING    iv_tcode    TYPE zbdc_prof_bup-tcode
           iv_profile  TYPE zbdc_prof_bup-profile_name
           iv_ver      TYPE zbdc_prof_bup-profile_ver
           iv_filename TYPE string
           iv_mimetype TYPE string
           iv_content  TYPE xstring
  CHANGING cv_ok       TYPE abap_bool.

  TYPES: BEGIN OF ty_gdrive_response,
           ok              TYPE abap_bool,
           action          TYPE string,
           request_id      TYPE string,
           operation       TYPE string,
           file_id         TYPE string,
           file_name       TYPE string,
           url             TYPE string,
           mime_type       TYPE string,
           size            TYPE string,
           content_hash    TYPE string,
           contract_hash   TYPE string,
           error           TYPE string,
           error_code      TYPE string,
           retryable       TYPE abap_bool,
           message         TYPE string,
         END OF ty_gdrive_response.

  DATA: lo_client        TYPE REF TO if_http_client,
        lv_url           TYPE string,
        lv_script_url    TYPE string,
        lv_action        TYPE string,
        lv_folder_id     TYPE string,
        lv_code          TYPE i,
        lv_resp          TYPE string,
        lv_b64           TYPE string,
        lv_body          TYPE string,
        lv_msg           TYPE string,
        lv_access_e      TYPE string,
        lv_api_e         TYPE string,
        lv_action_e      TYPE string,
        lv_script_e      TYPE string,
        lv_folder_e      TYPE string,
        lv_tcode_e       TYPE string,
        lv_profile_e     TYPE string,
        lv_ver_e         TYPE string,
        lv_file_e        TYPE string,
        lv_mime_e        TYPE string,
        lv_request_e     TYPE string,
        lv_script_id_e   TYPE string,
        lv_contract_e    TYPE string,
        lv_hash_e        TYPE string,
        lv_user_e        TYPE string,
        lv_client_e      TYPE string,
        lv_generated_e   TYPE string,
        lv_request_id    TYPE string,
        lv_content_hash  TYPE string,
        lv_script_id     TYPE string,
        lv_contract_hash TYPE string,
        lv_generated_at  TYPE string,
        lv_ok_token      TYPE abap_bool,
        lv_opened        TYPE abap_bool,
        lv_size          TYPE i,
        lv_size_text     TYPE string,
        lv_send_rc       TYPE sy-subrc,
        lv_receive_rc    TYPE sy-subrc,
        lv_json_error    TYPE string,
        lv_gas_pattern   TYPE string,
        lv_verify_ok     TYPE abap_bool,
        lv_verify_id     TYPE string,
        lv_verify_url    TYPE string,
        ls_response      TYPE ty_gdrive_response.

  CLEAR cv_ok.

  IF iv_content IS INITIAL.
    MESSAGE s279(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "validate all configuration before opening the OAuth page.
  PERFORM get_n8n_gdrive_webhook CHANGING lv_url.
  IF lv_url IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_required_config
    USING    'GDRIVE_SCRIPT_URL'
    CHANGING lv_script_url.
  IF lv_script_url IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_required_config
    USING    'GDRIVE_UPLOAD_ACTION'
    CHANGING lv_action.
  IF lv_action IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_gdrive_adapter_secret CHANGING lv_api_e.
  IF lv_api_e IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_required_config
    USING    'GAS_EXEC_URL_PATTERN'
    CHANGING lv_gas_pattern.
  IF lv_gas_pattern IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_optional_config
    USING    'GDRIVE_TEMPLATE_FOLDER_ID'
    CHANGING lv_folder_id.

  CONDENSE lv_url NO-GAPS.
  CONDENSE lv_script_url NO-GAPS.
  CONDENSE lv_action NO-GAPS.
  CONDENSE lv_gas_pattern NO-GAPS.

  IF lv_url NP 'https://*'.
    MESSAGE s280(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF lv_script_url NP lv_gas_pattern.
    MESSAGE s717(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  PERFORM ensure_gdrive_token CHANGING lv_ok_token.
  IF lv_ok_token <> abap_true.
    RETURN.
  ENDIF.

  lv_access_e = gv_gdrive_token.
  CONDENSE lv_access_e NO-GAPS.
  IF lv_access_e IS INITIAL OR lv_access_e CP 'ERROR:*'
  OR strlen( lv_access_e ) < 20.
    MESSAGE s727(zbdc)
      DISPLAY LIKE 'E'.
    CLEAR gv_gdrive_token.
    RETURN.
  ENDIF.

  CALL FUNCTION 'SCMS_BASE64_ENCODE_STR'
    EXPORTING
      input  = iv_content
    IMPORTING
      output = lv_b64
    EXCEPTIONS
      failed = 1
      OTHERS = 2.
  IF sy-subrc <> 0 OR lv_b64 IS INITIAL.
    MESSAGE s281(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  TRY.
      lv_request_id = cl_system_uuid=>create_uuid_c32_static( ).
    CATCH cx_uuid_error INTO DATA(lx_uuid).
      DATA(lv_zmsg282_text) = lx_uuid->get_text( ).
      MESSAGE s282(zbdc)
        WITH lv_zmsg282_text
        DISPLAY LIKE 'E'.
      RETURN.
  ENDTRY.

  TRY.
      cl_abap_message_digest=>calculate_hash_for_char(
        EXPORTING
          if_algorithm     = 'SHA-256'
          if_data          = lv_b64
        IMPORTING
          ef_hashb64string = lv_content_hash ).
    CATCH cx_abap_message_digest INTO DATA(lx_digest).
      DATA(lv_zmsg283_text) = lx_digest->get_text( ).
      MESSAGE s283(zbdc)
        WITH lv_zmsg283_text
        DISPLAY LIKE 'E'.
      RETURN.
  ENDTRY.
  IF lv_content_hash IS INITIAL.
    MESSAGE s284(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lv_size          = xstrlen( iv_content ).
  lv_size_text     = lv_size.
  CONDENSE lv_size_text NO-GAPS.
  lv_script_id     = gv_runtime_script_id.
  lv_contract_hash = gv_runtime_contract_hash.
  PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  lv_generated_at  = |{ gv_demo_date_837 }{ gv_demo_time_837 }|.

  lv_tcode_e     = iv_tcode.
  lv_profile_e   = iv_profile.
  lv_ver_e       = iv_ver.
  lv_file_e      = iv_filename.
  lv_mime_e      = iv_mimetype.
  lv_action_e    = lv_action.
  lv_script_e    = lv_script_url.
  lv_folder_e    = lv_folder_id.
  lv_request_e   = lv_request_id.
  lv_script_id_e = lv_script_id.
  lv_contract_e  = lv_contract_hash.
  lv_hash_e      = lv_content_hash.
  lv_user_e      = sy-uname.
  lv_client_e    = sy-mandt.
  lv_generated_e = lv_generated_at.

  PERFORM json_escape USING lv_access_e    CHANGING lv_access_e.
  PERFORM json_escape USING lv_api_e       CHANGING lv_api_e.
  PERFORM json_escape USING lv_action_e    CHANGING lv_action_e.
  PERFORM json_escape USING lv_script_e    CHANGING lv_script_e.
  PERFORM json_escape USING lv_folder_e    CHANGING lv_folder_e.
  PERFORM json_escape USING lv_tcode_e     CHANGING lv_tcode_e.
  PERFORM json_escape USING lv_profile_e   CHANGING lv_profile_e.
  PERFORM json_escape USING lv_ver_e       CHANGING lv_ver_e.
  PERFORM json_escape USING lv_file_e      CHANGING lv_file_e.
  PERFORM json_escape USING lv_mime_e      CHANGING lv_mime_e.
  PERFORM json_escape USING lv_request_e   CHANGING lv_request_e.
  PERFORM json_escape USING lv_script_id_e CHANGING lv_script_id_e.
  PERFORM json_escape USING lv_contract_e  CHANGING lv_contract_e.
  PERFORM json_escape USING lv_hash_e      CHANGING lv_hash_e.
  PERFORM json_escape USING lv_user_e      CHANGING lv_user_e.
  PERFORM json_escape USING lv_client_e    CHANGING lv_client_e.
  PERFORM json_escape USING lv_generated_e CHANGING lv_generated_e.

  lv_body =
    |\{"apiKey":"{ lv_api_e }",| &&
    |"action":"{ lv_action_e }",| &&
    |"requestId":"{ lv_request_e }",| &&
    |"accessToken":"{ lv_access_e }",| &&
    |"adapter":\{"scriptUrl":"{ lv_script_e }"\},|.

  IF lv_folder_e IS NOT INITIAL.
    lv_body = lv_body && |"folderId":"{ lv_folder_e }",|.
  ENDIF.

  lv_body = lv_body &&
    |"contract":\{"tcode":"{ lv_tcode_e }",| &&
    |"profile":"{ lv_profile_e }",| &&
    |"version":"{ lv_ver_e }",| &&
    |"scriptId":"{ lv_script_id_e }",| &&
    |"contractHash":"{ lv_contract_e }"\},| &&
    |"file":\{"fileName":"{ lv_file_e }",| &&
    |"mimeType":"{ lv_mime_e }",| &&
    |"sizeBytes":{ lv_size },| &&
    |"contentHash":"{ lv_hash_e }",| &&
    |"contentBase64":"{ lv_b64 }"\},| &&
    |"context":\{"sapUser":"{ lv_user_e }",| &&
    |"sapClient":"{ lv_client_e }",| &&
    |"generatedAt":"{ lv_generated_e }"\}\}|.

  IF lv_body NS '"accessToken":"' OR lv_body CS '"accessToken":""'.
    MESSAGE s728(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  cl_http_client=>create_by_url(
    EXPORTING url = lv_url
    IMPORTING client = lo_client
    EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc <> 0 OR lo_client IS INITIAL.
    MESSAGE s285(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lo_client->request->set_method( 'POST' ).
  lo_client->propertytype_redirect = lo_client->co_enabled.
  lo_client->request->set_header_field(
    name = 'Content-Type' value = 'application/json; charset=utf-8' ).
  lo_client->request->set_header_field(
    name = 'Accept' value = 'application/json' ).
  lo_client->request->set_header_field(
    name = 'X-SAP-BDC-Request-ID' value = lv_request_id ).
  lo_client->request->set_cdata( lv_body ).

  lo_client->send( EXCEPTIONS OTHERS = 1 ).
  lv_send_rc = sy-subrc.
  IF lv_send_rc <> 0.
    lo_client->close( ).
    MESSAGE s286(zbdc)
      WITH lv_send_rc lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lo_client->receive( EXCEPTIONS OTHERS = 1 ).
  lv_receive_rc = sy-subrc.
  IF lv_receive_rc <> 0.
    lo_client->close( ).
    MESSAGE s287(zbdc)
      WITH lv_receive_rc lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lo_client->response->get_status( IMPORTING code = lv_code ).
  lv_resp = lo_client->response->get_cdata( ).
  lo_client->close( ).

  CLEAR: ls_response, lv_json_error.
  TRY.
      /ui2/cl_json=>deserialize(
        EXPORTING
          json        = lv_resp
          pretty_name = /ui2/cl_json=>pretty_mode-camel_case
        CHANGING
          data        = ls_response ).
    CATCH cx_root INTO DATA(lx_json).
      lv_json_error = lx_json->get_text( ).
  ENDTRY.

  IF lv_code = 401 OR lv_code = 403.
    CLEAR gv_gdrive_token.
  ENDIF.

  IF lv_code < 200 OR lv_code >= 300.
    lv_msg = ls_response-message.
    IF lv_msg IS INITIAL.
      lv_msg = lv_resp.
    ENDIF.
    IF strlen( lv_msg ) > 180.
      lv_msg = lv_msg(180).
    ENDIF.
    MESSAGE s288(zbdc)
      WITH lv_code lv_request_id lv_msg
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF lv_json_error IS NOT INITIAL.
    CLEAR: lv_verify_ok, lv_verify_id, lv_verify_url.
    PERFORM verify_gdrive_upload_effect
      USING    iv_filename iv_mimetype lv_folder_id
               lv_request_id lv_content_hash lv_contract_hash
               iv_tcode iv_profile iv_ver lv_size
      CHANGING lv_verify_ok lv_verify_id lv_verify_url.

    IF lv_verify_ok = abap_true.
      cv_ok = abap_true.
      IF lv_verify_url IS NOT INITIAL.
        PERFORM open_drive_template_url
          USING    lv_verify_url iv_filename
          CHANGING lv_opened.
      ENDIF.
      MESSAGE s301(zbdc)
        WITH 'VERIFIED' lv_verify_id lv_request_id.
      RETURN.
    ENDIF.

    MESSAGE s289(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF ls_response-ok <> abap_true.
    IF ls_response-error_code = 'INVALID_ACCESS_TOKEN'
    OR ls_response-error_code = 'TOKEN_EXPIRED'
    OR ls_response-error = 'UNAUTHORIZED'.
      CLEAR gv_gdrive_token.
    ENDIF.

   "The adapter can complete the Drive side effect but lose the JSON body
   "during the Apps Script ContentService redirect. Do not report false
   "failure: verify the exact current request from Drive metadata first.
    IF ls_response-error_code = 'INVALID_ADAPTER_RESPONSE'
       OR ls_response-error = 'INVALID_ADAPTER_RESPONSE'
       OR ls_response-message CS 'non-JSON response'.
      CLEAR: lv_verify_ok, lv_verify_id, lv_verify_url.
      PERFORM verify_gdrive_upload_effect
        USING    iv_filename iv_mimetype lv_folder_id
                 lv_request_id lv_content_hash lv_contract_hash
                 iv_tcode iv_profile iv_ver lv_size
        CHANGING lv_verify_ok lv_verify_id lv_verify_url.

      IF lv_verify_ok = abap_true.
        cv_ok = abap_true.
        IF lv_verify_url IS NOT INITIAL.
          PERFORM open_drive_template_url
            USING    lv_verify_url iv_filename
            CHANGING lv_opened.
        ENDIF.
        MESSAGE s301(zbdc)
          WITH 'VERIFIED' lv_verify_id lv_request_id.
        RETURN.
      ENDIF.
    ENDIF.

    lv_msg = ls_response-message.
    IF lv_msg IS INITIAL.
      lv_msg = ls_response-error_code.
    ENDIF.
    IF lv_msg IS INITIAL.
      lv_msg = ls_response-error.
    ENDIF.
    IF lv_msg IS INITIAL.
      lv_msg = 'Adapter returned ok=false without a message'.
    ENDIF.

    MESSAGE s290(zbdc)
      WITH lv_request_id lv_msg
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF ls_response-request_id <> lv_request_id.
    MESSAGE s291(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF ls_response-action <> lv_action.
    MESSAGE s292(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  TRANSLATE ls_response-operation TO UPPER CASE.
  IF ls_response-operation <> 'CREATED'
  AND ls_response-operation <> 'UPDATED'.
    MESSAGE s293(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF ls_response-file_id IS INITIAL.
    MESSAGE s294(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF ls_response-file_name IS INITIAL
  OR ls_response-file_name <> iv_filename.
    MESSAGE s295(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF ls_response-content_hash IS INITIAL
  OR ls_response-content_hash <> lv_content_hash.
    MESSAGE s296(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF ls_response-mime_type IS INITIAL
  OR ls_response-mime_type <> iv_mimetype.
    MESSAGE s297(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF ls_response-size IS INITIAL
  OR ls_response-size <> lv_size_text.
    MESSAGE s298(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF lv_contract_hash IS NOT INITIAL
  AND ls_response-contract_hash <> lv_contract_hash.
    MESSAGE s299(zbdc)
      WITH lv_request_id
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.

  IF ls_response-url IS NOT INITIAL.
    PERFORM open_drive_template_url
      USING    ls_response-url
               iv_filename
      CHANGING lv_opened.

    IF lv_opened = abap_true.
      MESSAGE s300(zbdc)
        WITH ls_response-operation lv_request_id.
    ELSE.
      MESSAGE s301(zbdc)
        WITH ls_response-operation ls_response-file_id lv_request_id.
    ENDIF.
  ELSE.
    MESSAGE s301(zbdc)
      WITH ls_response-operation ls_response-file_id lv_request_id.
  ENDIF.
ENDFORM.

FORM open_drive_template_url
  USING    iv_url      TYPE string
           iv_filename TYPE string
  CHANGING cv_opened   TYPE abap_bool.

  DATA: lv_url       TYPE string,
        lv_url_lower TYPE string,
        lv_drive_pat TYPE string,
        lv_docs_pat  TYPE string.

  CLEAR cv_opened.
  lv_url = iv_url.
  CONDENSE lv_url NO-GAPS.

  IF lv_url IS INITIAL.
    RETURN.
  ENDIF.

  lv_url_lower = lv_url.
  TRANSLATE lv_url_lower TO LOWER CASE.

  PERFORM get_required_config
    USING    'GDRIVE_OPEN_URL_PATTERN'
    CHANGING lv_drive_pat.
  IF lv_drive_pat IS INITIAL.
    RETURN.
  ENDIF.
  PERFORM get_required_config
    USING    'GDOCS_OPEN_URL_PATTERN'
    CHANGING lv_docs_pat.
  IF lv_docs_pat IS INITIAL.
    RETURN.
  ENDIF.
  TRANSLATE lv_drive_pat TO LOWER CASE.
  TRANSLATE lv_docs_pat TO LOWER CASE.

 "validate the URL prefix, not a substring hidden in a query.
  IF lv_url_lower NP lv_drive_pat
  AND lv_url_lower NP lv_docs_pat.
    RETURN.
  ENDIF.

  cl_gui_frontend_services=>execute(
    EXPORTING
      document = lv_url
    EXCEPTIONS
      OTHERS   = 1 ).

  IF sy-subrc = 0.
    cl_gui_cfw=>flush( ).
    cv_opened = abap_true.
  ENDIF.
ENDFORM.

*& Explicit lifecycle preparation for Generate Template.
*& Opening/PBO never saves or activates Mapping. The user command GENERATE
*& is the only convenience boundary allowed to validate/save and prepare
*& a DRAFT/MAPPED candidate for TESTING.

*& Candidate Review Promote/Lock Contract Flow

*& Start Recording / TXT evidence may open a Candidate Mapping Review. It
*& must not generate an official template silently from raw evidence, but the
*& user still needs a deterministic way forward. This flow promotes the
*& currently reviewed candidate into an explicit MAPPED contract only after a
*& confirmation and generic validation. No TCODE, SAP table, object field, or
*& business field is hardcoded.

FORM validate_cand_map
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  TYPES: BEGIN OF ty_z336_pair,
           source  TYPE zbdc_mapping_bup-source_column,
           staging TYPE zbdc_mapping_bup-staging_field,
         END OF ty_z336_pair.

  DATA: lt_pair       TYPE STANDARD TABLE OF ty_z336_pair,
        ls_pair       TYPE ty_z336_pair,
        ls_map        TYPE zbdc_mapping_bup,
        lv_source     TYPE zbdc_mapping_bup-source_column,
        lv_bdc        TYPE zbdc_mapping_bup-bdc_field,
        lv_technical  TYPE abap_bool,
        lv_src_tech   TYPE abap_bool,
        lv_exists     TYPE abap_bool,
        lv_key_count  TYPE i,
        lv_bus_count  TYPE i.

  CLEAR: cv_ok, cv_message.

  IF gt_mapping_screen IS INITIAL.
    cv_message = 'Candidate Mapping Review is empty; Start Recording or Import evidence first.'.
    RETURN.
  ENDIF.

  LOOP AT gt_mapping_screen INTO ls_map.
    CLEAR: lv_source, lv_bdc, lv_technical, lv_src_tech, lv_exists.

 "presence in the Candidate Review grid means Business Input
 "candidate; MANDATORY keeps only its original Required/Optional meaning.
 "Do not skip optional rows. Consultants remove non-input rows with the
 "internal business-input projection before Field Guide promotion.
    lv_source = ls_map-source_column.
    PERFORM normalize_mapping_source
      USING    lv_source
      CHANGING lv_source.

    IF lv_source IS INITIAL.
      cv_message = |Candidate row { sy-tabix }: Template Field Name is empty.|.
      RETURN.
    ENDIF.

    IF ls_map-mandatory = gc_m2_map_review.
      cv_message = |{ lv_source }: review-required field cannot be locked. Resolve the candidate first.|.
      RETURN.
    ENDIF.

    IF ls_map-staging_field IS INITIAL.
      cv_message = |{ lv_source }: Runtime Slot is empty.|.
      RETURN.
    ENDIF.

    TRANSLATE ls_map-staging_field TO UPPER CASE.
    CONDENSE ls_map-staging_field NO-GAPS.
    PERFORM mapping_staging_field_exists
      USING    ls_map-staging_field
      CHANGING lv_exists.
    IF lv_exists <> abap_true.
      cv_message = |{ lv_source }: staging component { ls_map-staging_field } does not exist.|.
      RETURN.
    ENDIF.

    LOOP AT lt_pair INTO ls_pair.
      IF ls_pair-source = lv_source AND ls_pair-staging <> ls_map-staging_field.
        cv_message = |{ lv_source } is assigned to more than one staging field.|.
        RETURN.
      ENDIF.
      IF ls_pair-staging = ls_map-staging_field AND ls_pair-source <> lv_source.
        cv_message = |{ ls_map-staging_field } is assigned to more than one source column.|.
        RETURN.
      ENDIF.
    ENDLOOP.

    CLEAR ls_pair.
    ls_pair-source  = lv_source.
    ls_pair-staging = ls_map-staging_field.
    APPEND ls_pair TO lt_pair.

    IF ls_map-staging_field = 'FIELD01'.
      lv_key_count = lv_key_count + 1.
      IF ls_map-bdc_field IS NOT INITIAL.
        cv_message = 'BUSINESS_KEY/FIELD01 must not point to a SAP BDC field.'.
        RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.

    lv_bdc = ls_map-bdc_field.
    PERFORM normalize_mapping_bdc_field
      USING    lv_bdc
      CHANGING lv_bdc.
    IF lv_bdc IS INITIAL.
      cv_message = |{ lv_source }: SAP Technical Field is empty.|.
      RETURN.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    lv_bdc
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      cv_message = |{ lv_source }: technical/control BDC field { lv_bdc } cannot be locked as business input.|.
      RETURN.
    ENDIF.

    lv_bus_count = lv_bus_count + 1.
  ENDLOOP.

  IF lv_key_count <> 1.
    cv_message = 'Exactly one BUSINESS_KEY/FIELD01 row is required before locking the candidate.'.
    RETURN.
  ENDIF.

  IF lv_bus_count <= 0.
    cv_message = 'Candidate has no business input fields to lock.'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

*& Resolve excluded current-evidence rows without fake backfill

*& Mapping rows become DYNAMIC. Every other nontechnical row remains real
*& replay evidence: STATIC with its own captured literal, or IGNORE if empty.
*& This closes the UNRESOLVED leak left by without importing/history
*& fields into Start Recording and without changing Mapping/Template schema.

FORM apply_map_to_script
  USING    it_map    TYPE ty_t_mapping_db
  CHANGING ct_script TYPE ty_t_script.

  DATA: ls_map        TYPE zbdc_mapping_bup,
        lv_logical    TYPE zbdc_mapping_bup-bdc_field,
        lv_map_log    TYPE zbdc_mapping_bup-bdc_field,
        lv_technical  TYPE abap_bool,
        lv_found      TYPE abap_bool,
        lv_map_step   TYPE zbdc_sct_ver_bup-step_seq,
        lv_map_has_step TYPE abap_bool.

  FIELD-SYMBOLS <ls_scr> TYPE ty_script_def_compat.

  DATA lv_z367_changed TYPE abap_bool.
  PERFORM fix_tech_steps
    CHANGING ct_script lv_z367_changed.

  LOOP AT ct_script ASSIGNING <ls_scr>
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

 "mapping projection must not reclaim the hidden trace carrier as
 "a business input just because the same BDC field has a Mapping row.
    IF <ls_scr>-static_value CS gc_trace_token.
      <ls_scr>-value_type = gc_vt_static.
      CLEAR <ls_scr>-source_column.
      CONTINUE.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    <ls_scr>-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR lv_logical.
    PERFORM logical_bdc_key
      USING    <ls_scr>-field_name
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_found, ls_map.
    LOOP AT it_map INTO ls_map
      WHERE bdc_field IS NOT INITIAL
        AND staging_field <> 'FIELD01'.
      CLEAR lv_map_log.
      PERFORM logical_bdc_key
        USING    ls_map-bdc_field
        CHANGING lv_map_log.
      IF lv_map_log = lv_logical.
        CLEAR: lv_map_step, lv_map_has_step.
        PERFORM get_map_step
          USING    ls_map
          CHANGING lv_map_step lv_map_has_step.
        IF lv_map_has_step = abap_true
           AND lv_map_step <> <ls_scr>-step_seq.
          CONTINUE.
        ENDIF.
        lv_found = abap_true.
        EXIT.
      ENDIF.
      CLEAR ls_map.
    ENDLOOP.

    IF lv_found = abap_true AND ls_map-source_column IS NOT INITIAL.
      <ls_scr>-value_type    = gc_vt_dynamic.
      <ls_scr>-source_column = ls_map-source_column.
 "do not infer ITEM from a raw terminal index. The canonical
 "repeatable-index proof/classifier owns ROW_TYPE.
    ELSE.
 "every current acquisition field that is not part of the exact
 "0350 Mapping projection must still receive an executable decision.
 "Preserve its CURRENT recorded literal as STATIC, or IGNORE when empty.
 "Never backfill from Import/history and never invent a source column.
      CLEAR <ls_scr>-source_column.
      IF <ls_scr>-static_value IS NOT INITIAL.
 "non-mapped nontechnical values captured by SHDB remain exact
 "STATIC replay evidence. Mapping controls which values users may
 "override; execution does not synthesize replacements for captured
 "screen defaults. No business-field semantic is inferred.
        <ls_scr>-value_type = gc_vt_static.
      ELSE.
        <ls_scr>-value_type = gc_m2_vt_ignore.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Exact Mapping -> Script -> Template binding contract

*& One business Mapping row must own exactly one SOURCE_COLUMN, one generic
*& staging slot and one logical BDC field. The corresponding frozen Script
*& row(s) must be DYNAMIC and must carry the same SOURCE_COLUMN. Repeated
*& table-control occurrences of one logical field are allowed; ambiguous
*& bindings are not.
*& BUSINESS_KEY/FIELD01 is the one system-control exception: it is emitted to
*& the data template but intentionally has no BDC field.

FORM validate_map_script_1to1
  USING    it_map     TYPE ty_t_mapping_db
           it_script  TYPE ty_t_script
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_source TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                    WITH UNIQUE KEY table_line,
        lt_stage  TYPE SORTED TABLE OF zbdc_mapping_bup-staging_field
                    WITH UNIQUE KEY table_line,
        lt_logic  TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                    WITH UNIQUE KEY table_line,
        ls_map    TYPE zbdc_mapping_bup,
        ls_scr    TYPE ty_script_def_compat,
        lv_source TYPE zbdc_mapping_bup-source_column,
        lv_scr_source TYPE zbdc_mapping_bup-source_column,
        lv_stage  TYPE zbdc_mapping_bup-staging_field,
        lv_bdc    TYPE zbdc_mapping_bup-bdc_field,
        lv_logical TYPE zbdc_mapping_bup-bdc_field,
        lv_scr_logical TYPE zbdc_mapping_bup-bdc_field,
        lv_technical TYPE abap_bool,
        lv_match   TYPE abap_bool,
        lv_conflict TYPE abap_bool,
        lv_key_count TYPE i,
        lv_bus_count TYPE i.

  CLEAR: cv_ok, cv_message.

  IF it_map IS INITIAL.
    cv_message = 'Mapping projection is empty.'.
    RETURN.
  ENDIF.
  IF it_script IS INITIAL.
    cv_message = 'Frozen Script Definition is empty.'.
    RETURN.
  ENDIF.

  LOOP AT it_map INTO ls_map.
    CLEAR: lv_source, lv_stage, lv_bdc, lv_logical.

    PERFORM normalize_mapping_source
      USING    ls_map-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL OR lv_source CP 'INPUT_*'.
      cv_message = |: invalid template source at Mapping row { sy-tabix }.|.
      RETURN.
    ENDIF.

    lv_stage = ls_map-staging_field.
    TRANSLATE lv_stage TO UPPER CASE.
    CONDENSE lv_stage NO-GAPS.
    IF lv_stage IS INITIAL.
      cv_message = |: { lv_source } has no staging binding.|.
      RETURN.
    ENDIF.

    INSERT lv_source INTO TABLE lt_source.
    IF sy-subrc <> 0.
      cv_message = |: SOURCE_COLUMN { lv_source } appears more than once.|.
      RETURN.
    ENDIF.

    INSERT lv_stage INTO TABLE lt_stage.
    IF sy-subrc <> 0.
      cv_message = |: STAGING_FIELD { lv_stage } is bound more than once.|.
      RETURN.
    ENDIF.

    IF lv_stage = 'FIELD01'.
      lv_key_count = lv_key_count + 1.
      IF ls_map-bdc_field IS NOT INITIAL.
        cv_message = 'BUSINESS_KEY/FIELD01 must not bind a BDC field.'.
        RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_map-bdc_field IS INITIAL.
      cv_message = |: { lv_source } has no BDC field binding.|.
      RETURN.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_map-bdc_field
      CHANGING lv_bdc.
    PERFORM logical_bdc_key
      USING    lv_bdc
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      cv_message = |: { lv_source } has an invalid logical BDC identity.|.
      RETURN.
    ENDIF.

    INSERT lv_logical INTO TABLE lt_logic.
    IF sy-subrc <> 0.
      cv_message = |: logical BDC field { lv_logical } is mapped more than once.|.
      RETURN.
    ENDIF.

    CLEAR: lv_match, lv_conflict.
    LOOP AT it_script INTO ls_scr
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.

      CLEAR lv_technical.
      PERFORM mapping_field_is_technical
        USING    ls_scr-field_name
        CHANGING lv_technical.
      IF lv_technical = abap_true.
        CONTINUE.
      ENDIF.

      CLEAR lv_scr_logical.
      PERFORM logical_bdc_key
        USING    ls_scr-field_name
        CHANGING lv_scr_logical.
      IF lv_scr_logical <> lv_logical.
        CONTINUE.
      ENDIF.

      IF ls_scr-value_type <> gc_vt_dynamic.
        CONTINUE.
      ENDIF.

      CLEAR lv_scr_source.
      PERFORM normalize_mapping_source
        USING    ls_scr-source_column
        CHANGING lv_scr_source.
      IF lv_scr_source = lv_source.
        lv_match = abap_true.
      ELSEIF lv_scr_source IS NOT INITIAL.
        lv_conflict = abap_true.
      ENDIF.
    ENDLOOP.

    IF lv_conflict = abap_true.
      cv_message = |: runtime Script source for { lv_logical } conflicts with Mapping source { lv_source }.|.
      RETURN.
    ENDIF.
    IF lv_match <> abap_true.
      cv_message = |: { lv_source } -> { lv_logical } has no matching DYNAMIC runtime Script binding.|.
      RETURN.
    ENDIF.

    lv_bus_count = lv_bus_count + 1.
  ENDLOOP.

  IF lv_key_count <> 1.
    cv_message = 'Exactly one BUSINESS_KEY/FIELD01 template control row is required.'.
    RETURN.
  ENDIF.
  IF lv_bus_count <= 0.
    cv_message = 'Mapping contains no business BDC input binding.'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

*& Exact Field Guide round-trip verifier

FORM verify_fguide_roundtrip
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_mapping_bup-profile_ver
           it_map     TYPE ty_t_mapping_db
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  TYPES: BEGIN OF ty_z483_bind,
           source    TYPE zbdc_mapping_bup-source_column,
           staging   TYPE zbdc_mapping_bup-staging_field,
           bdc       TYPE zbdc_mapping_bup-bdc_field,
         END OF ty_z483_bind.

  DATA: lt_expected TYPE SORTED TABLE OF ty_z483_bind
                      WITH UNIQUE KEY source staging bdc,
        lt_actual   TYPE SORTED TABLE OF ty_z483_bind
                      WITH UNIQUE KEY source staging bdc,
        lt_guide    TYPE ty_t_map_meta,
        ls_map      TYPE zbdc_mapping_bup,
        ls_guide    TYPE ty_map_meta,
        ls_bind     TYPE ty_z483_bind,
        lv_source   TYPE zbdc_mapping_bup-source_column,
        lv_bdc      TYPE zbdc_mapping_bup-bdc_field,
        lv_stage    TYPE zbdc_mapping_bup-staging_field.

  CLEAR: cv_ok, cv_message.

  LOOP AT it_map INTO ls_map.
    CLEAR: ls_bind, lv_source, lv_bdc, lv_stage.
    PERFORM normalize_mapping_source
      USING    ls_map-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL OR lv_source CP 'INPUT_*'.
      CONTINUE.
    ENDIF.
    lv_stage = ls_map-staging_field.
    TRANSLATE lv_stage TO UPPER CASE.
    CONDENSE lv_stage NO-GAPS.
    IF ls_map-bdc_field IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    ls_map-bdc_field
        CHANGING lv_bdc.
    ENDIF.
    ls_bind-source  = lv_source.
    ls_bind-staging = lv_stage.
    ls_bind-bdc     = lv_bdc.
    INSERT ls_bind INTO TABLE lt_expected.
    IF sy-subrc <> 0.
      cv_message = |: duplicate Mapping binding for { lv_source }.|.
      RETURN.
    ENDIF.
  ENDLOOP.

  REFRESH lt_guide.
  PERFORM read_mapping_metadata
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_guide.

  LOOP AT lt_guide INTO ls_guide
    WHERE metadata_origin = 'FIELD_GUIDE'.
    CLEAR: ls_bind, lv_source, lv_bdc, lv_stage.
    PERFORM normalize_mapping_source
      USING    ls_guide-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL OR lv_source CP 'INPUT_*'.
      CONTINUE.
    ENDIF.
    lv_stage = ls_guide-staging_field.
    TRANSLATE lv_stage TO UPPER CASE.
    CONDENSE lv_stage NO-GAPS.
    IF ls_guide-bdc_field IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    ls_guide-bdc_field
        CHANGING lv_bdc.
    ENDIF.
    ls_bind-source  = lv_source.
    ls_bind-staging = lv_stage.
    ls_bind-bdc     = lv_bdc.
    INSERT ls_bind INTO TABLE lt_actual.
    IF sy-subrc <> 0.
      cv_message = |: duplicate Field Guide binding for { lv_source }.|.
      RETURN.
    ENDIF.
  ENDLOOP.

  IF lt_expected IS INITIAL.
    cv_message = 'No Mapping bindings exist for Field Guide verification.'.
    RETURN.
  ENDIF.
  IF lt_expected <> lt_actual.
    cv_message = 'Field Guide round-trip differs from the exact Mapping projection; template generation is blocked.'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

*& Persist Field Guide rows from canonical business-input projection

FORM persist_field_guide
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
           it_map     TYPE ty_t_mapping_db
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  CONSTANTS lc_quote TYPE c LENGTH 1 VALUE ''''.

  DATA: lv_exists       TYPE abap_bool,
        lr_tab          TYPE REF TO data,
        lr_row          TYPE REF TO data,
        lr_probe        TYPE REF TO data,
        ls_map          TYPE zbdc_mapping_bup,
        lv_text         TYPE string,
        lv_src_guard    TYPE zbdc_mapping_bup-source_column,
        lv_order        TYPE i,
        lv_order_c      TYPE string,
        lv_active       TYPE string,
        lv_mand         TYPE string,
        lv_where        TYPE string,
        lv_col_tcode    TYPE fieldname,
        lv_col_profile  TYPE fieldname,
        lv_col_ver      TYPE fieldname,
        lv_tcode_sql    TYPE string,
        lv_profile_sql  TYPE string,
        lv_ver_sql      TYPE string,
        lv_double_quote TYPE string,
        lx_sql          TYPE REF TO cx_root.

  FIELD-SYMBOLS: <lt_any>   TYPE STANDARD TABLE,
                 <ls_any>   TYPE any,
                 <ls_probe> TYPE any,
                 <lv_probe> TYPE any.

  CLEAR: cv_ok, cv_message.

  PERFORM table_exists USING gc_z16_tab_fguide CHANGING lv_exists.
  IF lv_exists IS INITIAL.
    cv_ok = abap_true.
    cv_message =
      'LEGACY_FGUID_NO_EXACT_IDENTITY: optional Field Guide table is unavailable; exact Mapping contract remains template authority.'.
    RETURN.
  ENDIF.

  TRY.
      CREATE DATA lr_tab TYPE STANDARD TABLE OF (gc_z16_tab_fguide).
      ASSIGN lr_tab->* TO <lt_any>.
      CREATE DATA lr_probe TYPE (gc_z16_tab_fguide).
      ASSIGN lr_probe->* TO <ls_probe>.
    CATCH cx_root INTO lx_sql.
      cv_message = lx_sql->get_text( ).
      RETURN.
  ENDTRY.

  IF <lt_any> IS NOT ASSIGNED OR <ls_probe> IS NOT ASSIGNED.
    cv_message = 'Could not create dynamic Field Guide table buffer.'.
    RETURN.
  ENDIF.

 "Never hardcode a dynamic SQL column name. Resolve the real DDIC
 "identity columns; support PROFILE_NAME/PROFILE and PROFILE_VER/VERSION.
  UNASSIGN <lv_probe>.
  ASSIGN COMPONENT 'TCODE' OF STRUCTURE <ls_probe> TO <lv_probe>.
  IF sy-subrc = 0.
    lv_col_tcode = 'TCODE'.
  ELSE.
    UNASSIGN <lv_probe>.
    ASSIGN COMPONENT 'TRANSACTION' OF STRUCTURE <ls_probe> TO <lv_probe>.
    IF sy-subrc = 0.
      lv_col_tcode = 'TRANSACTION'.
    ENDIF.
  ENDIF.

  UNASSIGN <lv_probe>.
  ASSIGN COMPONENT 'PROFILE_NAME' OF STRUCTURE <ls_probe> TO <lv_probe>.
  IF sy-subrc = 0.
    lv_col_profile = 'PROFILE_NAME'.
  ELSE.
    UNASSIGN <lv_probe>.
    ASSIGN COMPONENT 'PROFILE' OF STRUCTURE <ls_probe> TO <lv_probe>.
    IF sy-subrc = 0.
      lv_col_profile = 'PROFILE'.
    ENDIF.
  ENDIF.

  UNASSIGN <lv_probe>.
  ASSIGN COMPONENT 'PROFILE_VER' OF STRUCTURE <ls_probe> TO <lv_probe>.
  IF sy-subrc = 0.
    lv_col_ver = 'PROFILE_VER'.
  ELSE.
    UNASSIGN <lv_probe>.
    ASSIGN COMPONENT 'VERSION' OF STRUCTURE <ls_probe> TO <lv_probe>.
    IF sy-subrc = 0.
      lv_col_ver = 'VERSION'.
    ENDIF.
  ENDIF.

 "Legacy TCODE-only Field Guide cannot safely own multiple profile versions.
 "Leave it untouched; exact ZBDC_MAPPING_BUP remains the template authority.
  IF lv_col_tcode IS INITIAL
     OR lv_col_profile IS INITIAL
     OR lv_col_ver IS INITIAL.
    cv_ok = abap_true.
    cv_message =
      'LEGACY_FGUID_NO_EXACT_IDENTITY: ZBDC_FGUID_BUP has no exact TCODE/Profile/Version identity; exact Mapping contract remains template authority.'.
    RETURN.
  ENDIF.

  LOOP AT it_map INTO ls_map.
    IF ls_map-source_column IS INITIAL.
      CONTINUE.
    ENDIF.

 "Field Guide is end-user authority; internal fallback aliases
 "must never be persisted even if they survive in historical Mapping.
    CLEAR lv_src_guard.
    PERFORM normalize_mapping_source
      USING    ls_map-source_column
      CHANGING lv_src_guard.
    IF lv_src_guard IS INITIAL OR lv_src_guard CP 'INPUT_*'.
      CONTINUE.
    ENDIF.

    lv_order = lv_order + 10.
    lv_order_c = lv_order.
    CONDENSE lv_order_c NO-GAPS.

    CREATE DATA lr_row TYPE (gc_z16_tab_fguide).
    ASSIGN lr_row->* TO <ls_any>.
    IF <ls_any> IS NOT ASSIGNED.
      CONTINUE.
    ENDIF.

    lv_text = sy-mandt.
    PERFORM set_optional_comp USING 'MANDT' lv_text CHANGING <ls_any>.
    lv_text = iv_tcode.
    PERFORM set_optional_comp USING 'TCODE' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'TRANSACTION' lv_text CHANGING <ls_any>.
    lv_text = iv_profile.
    PERFORM set_optional_comp USING 'PROFILE_NAME' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'PROFILE' lv_text CHANGING <ls_any>.
    lv_text = iv_ver.
    PERFORM set_optional_comp USING 'PROFILE_VER' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'VERSION' lv_text CHANGING <ls_any>.

    lv_text = ls_map-source_column.
    PERFORM set_optional_comp USING 'SOURCE_COLUMN' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'EXCEL_HEADER' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'HEADER_NAME' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'DISPLAY_LABEL' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'FIELD_LABEL' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'LABEL' lv_text CHANGING <ls_any>.

    lv_text = ls_map-staging_field.
    PERFORM set_optional_comp USING 'STAGING_FIELD' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'FIELDNAME' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'FIELD_NAME' lv_text CHANGING <ls_any>.

    lv_text = ls_map-bdc_field.
    PERFORM set_optional_comp USING 'BDC_FIELD' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'NORMALIZED_BDC_FIELD' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'SCREEN_FIELD' lv_text CHANGING <ls_any>.

    lv_mand = ls_map-mandatory.
    TRANSLATE lv_mand TO UPPER CASE.
    lv_active = 'X'.
    PERFORM set_optional_comp USING 'MANDATORY' lv_mand CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'IS_REQUIRED' lv_mand CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'REQUIRED' lv_mand CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'IS_ACTIVE' lv_active CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'ACTIVE' lv_active CHANGING <ls_any>.

    lv_text = gc_vt_dynamic.
    PERFORM set_optional_comp USING 'VALUE_TYPE' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'IS_DYNAMIC' lv_active CHANGING <ls_any>.
    lv_text = lv_order_c.
    PERFORM set_optional_comp USING 'DISPLAY_ORDER' lv_text CHANGING <ls_any>.
    lv_text = 'System-promoted Field Guide row from canonical business-input projection'.
    PERFORM set_optional_comp USING 'RULE_TEXT' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'DESCRIPTION' lv_text CHANGING <ls_any>.
    lv_text = sy-uname.
    PERFORM set_optional_comp USING 'CHANGED_BY' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'CREATED_BY' lv_text CHANGING <ls_any>.
    PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
    lv_text = gv_demo_date_837.
    PERFORM set_optional_comp USING 'CHANGED_ON' lv_text CHANGING <ls_any>.
    PERFORM set_optional_comp USING 'CREATED_ON' lv_text CHANGING <ls_any>.

    APPEND <ls_any> TO <lt_any>.
  ENDLOOP.

  IF <lt_any> IS INITIAL.
    cv_message = 'No Field Guide rows were produced from the confirmed Candidate Mapping.'.
    RETURN.
  ENDIF.

  lv_double_quote = lc_quote && lc_quote.
  lv_tcode_sql = iv_tcode.
  lv_profile_sql = iv_profile.
  lv_ver_sql = iv_ver.
  REPLACE ALL OCCURRENCES OF lc_quote IN lv_tcode_sql WITH lv_double_quote.
  REPLACE ALL OCCURRENCES OF lc_quote IN lv_profile_sql WITH lv_double_quote.
  REPLACE ALL OCCURRENCES OF lc_quote IN lv_ver_sql WITH lv_double_quote.

  lv_where =
    |{ lv_col_tcode } = '{ lv_tcode_sql }' AND { lv_col_profile } = '{ lv_profile_sql }' AND { lv_col_ver } = '{ lv_ver_sql }'|.

  TRY.
      DELETE FROM (gc_z16_tab_fguide) WHERE (lv_where).

      MODIFY (gc_z16_tab_fguide) FROM TABLE <lt_any>.
      IF sy-subrc <> 0.
        ROLLBACK WORK.
        cv_message = |Field Guide authority rows could not be saved; SY-SUBRC={ sy-subrc }.|.
        RETURN.
      ENDIF.
    CATCH cx_root INTO lx_sql.
      ROLLBACK WORK.
      cv_message = |Field Guide persistence failed safely: { lx_sql->get_text( ) }|.
      RETURN.
  ENDTRY.

  cv_ok = abap_true.
  cv_message = |Field Guide authority saved for { iv_profile } v{ iv_ver }.|.
ENDFORM.
FORM promote_cand_contract
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: ls_context    TYPE zbdc_mapping_bup,
        lt_map        TYPE ty_t_mapping_db,
        lt_script     TYPE ty_t_script,
        lv_tcode      TYPE zbdc_prof_bup-tcode,
        lv_profile    TYPE zbdc_prof_bup-profile_name,
        lv_ver        TYPE zbdc_prof_bup-profile_ver,
        lv_ans        TYPE c,
        lv_reg_ok     TYPE abap_bool,
        lv_reg_msg    TYPE string,
        lv_script_id  TYPE zbdc_script_bup-script_id,
        lv_hash       TYPE zbdc_script_bup-contract_hash,
        lv_save_ok    TYPE abap_bool,
        lv_save_msg   TYPE string,
        lv_valid      TYPE abap_bool,
        lv_valid_msg  TYPE string,
        lv_guide_ok   TYPE abap_bool,
        lv_guide_msg  TYPE string,
        lv_desc       TYPE zbdc_prof_bup-description,
        lv_fresh_acq  TYPE abap_bool,
        lv_schema_fp  TYPE zbdc_script_bup-contract_hash,
        lv_schema_ok  TYPE abap_bool,
        lv_schema_msg TYPE string,
        lv_selection_fp TYPE zbdc_script_bup-contract_hash,
        lv_selection_ok TYPE abap_bool,
        lv_selection_msg TYPE string,
        lv_version_fp TYPE zbdc_script_bup-contract_hash,
        lv_version_ok TYPE abap_bool,
        lv_version_msg TYPE string,
        lv_reservation_id TYPE zbdc_script_bup-script_id,
        lv_reserve_ok     TYPE abap_bool,
        lv_reserve_msg    TYPE string,
        lv_reserve_reused TYPE abap_bool,
        lv_reuse_id       TYPE zbdc_script_bup-script_id,
        lv_reuse_hash     TYPE zbdc_script_bup-contract_hash,
        lv_version_reserved TYPE abap_bool,
        lv_origin          TYPE zbdc_script_bup-recording_name,
        lt_raw_snapshot    TYPE ty_t_script,
        lv_raw_ok          TYPE abap_bool,
        lv_raw_msg         TYPE string,
        lv_plan_ok         TYPE abap_bool,
        lv_plan_msg        TYPE string,
        lv_raw_save_ok     TYPE abap_bool,
        lv_raw_save_msg    TYPE string,
        lv_cert_rebind_ok  TYPE abap_bool,
        lv_cert_rebind_msg TYPE string,
        lv_expected_map_n  TYPE i,
        lv_reloaded_map_n  TYPE i.

  FIELD-SYMBOLS <ls_map> TYPE zbdc_mapping_bup.

  CLEAR: cv_ok, cv_message.

  IF gv_z240_map_locked <> abap_true OR gt_mapping_screen IS INITIAL.
    cv_message = 'No evidence-only Candidate Mapping Review is open.'.
    RETURN.
  ENDIF.

 "GT_SCRIPT_DEF is a volatile screen buffer, not contract authority.
 "Resolve the exact candidate tuple first; if a repaint/navigation emptied the
 "buffer, reload its immutable script snapshot from the pinned tuple below.
  READ TABLE gt_mapping_screen INTO ls_context INDEX 1.
  IF sy-subrc <> 0.
    cv_message = 'Candidate Mapping context is missing.'.
    RETURN.
  ENDIF.

  lv_tcode = ls_context-tcode.
  IF lv_tcode IS INITIAL.
    lv_tcode = p_rec_tcode.
  ENDIF.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.

  lv_profile = ls_context-profile_name.
  IF lv_profile IS INITIAL.
    lv_profile = txtp_profile_name.
  ENDIF.
  CONDENSE lv_profile.

  lv_ver = ls_context-profile_ver.
  IF lv_ver IS INITIAL.
    lv_ver = gv_profile_ver.
  ENDIF.

 "Candidate Mapping may legitimately exist before a Template Version
 "has been reserved. TCODE + Profile are identity prerequisites here; an
 "unversioned fresh recording is versioned only after the visible Mapping and
 "its executable Script projection pass all generic validation below.
  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL.
    cv_message = 'Candidate Mapping lacks TCODE/Profile; rerun Start Recording or select My Import/All Import.'.
    RETURN.
  ENDIF.

 "a fresh acquisition owns the candidate Mapping/Template evidence.
 "Do not reload history merely because the resolver has an existing tuple.
 "Current raw acquisition is the membership authority.
 "GV_Z133_ORIGIN may later become LOCKED_CONTRACT when an exact persisted
 "tuple is pinned, so it cannot be the only freshness signal. The original
 "acquisition origin in GV_Z359_INPUT_ORIGIN plus the preserved raw evidence
 "must keep Import/Start projection fenced to the current file/recording.
  CLEAR: lv_fresh_acq, lv_origin.
  PERFORM get_projection_origin CHANGING lv_origin.
  IF gt_z333_rec_evidence IS NOT INITIAL
     AND ( lv_origin = 'GUIDED_RECORD'
        OR lv_origin = 'SHDB_TXT'
        OR lv_origin = 'SHDB_PROGRAM' ).
    lv_fresh_acq = abap_true.
  ENDIF.

 "outside a fresh acquisition, candidate promotion must survive PBO.
  IF lv_fresh_acq <> abap_true AND gt_script_def IS INITIAL.
    IF lv_ver IS INITIAL.
      cv_message =
        'Candidate Mapping has no pinned Profile Version and no fresh recording evidence; refresh/select the exact contract instead of allocating a guessed version.'.
      RETURN.
    ENDIF.
    CLEAR: lv_script_id, lv_hash, lv_save_ok, lv_save_msg.
    REFRESH lt_script.
    PERFORM resolve_map_tuple_script
      USING    lv_tcode lv_profile lv_ver
      CHANGING lt_script lv_script_id lv_hash lv_save_ok lv_save_msg.
    IF lv_save_ok <> abap_true OR lt_script IS INITIAL.
      cv_message = lv_save_msg.
      IF cv_message IS INITIAL.
        cv_message = 'Candidate immutable script snapshot could not be reloaded for Generate Template.'.
      ENDIF.
      RETURN.
    ENDIF.
    gt_script_def = lt_script.
    gv_runtime_script_id = lv_script_id.
    gv_runtime_contract_hash = lv_hash.
  ENDIF.

 "no end-user Lock popup. Candidate promotion is an internal
 "onboarding/template-generation step. The official template remains
 "Field-Guide-only; raw recording never becomes template authority.
  lv_ans = '1'.

  IF go_map_grid IS BOUND.
    go_map_grid->check_changed_data( ).
  ENDIF.

 "end users are never asked to rename an engine-generated INPUT_*
 "alias. Remove internal fallback rows from the candidate before the lock
 "validator. apply_map_to_script will then demote unmatched recorded
 "rows to STATIC when a recorded value exists, keeping SAP replay evidence
 "without making it a template column.
  PERFORM rebind_map_sources CHANGING gt_mapping_screen.

  CLEAR: lv_valid, lv_valid_msg.
  PERFORM validate_cand_map
    CHANGING lv_valid lv_valid_msg.
  IF lv_valid <> abap_true.
    cv_message = lv_valid_msg.
    RETURN.
  ENDIF.

  lt_map = gt_mapping_screen.
 "Business Input include/exclude is controlled by row presence.
 "MANDATORY keeps its original Required/Optional meaning. Rows removed in
 "Candidate Review are not in GT_MAPPING_SCREEN, therefore they are not
 "written to ZBDC_MAPPING_BUP or ZBDC_FGUID_BUP. Replay script evidence is
 "preserved separately by apply_map_to_script.
  LOOP AT lt_map ASSIGNING <ls_map>.
    <ls_map>-tcode        = lv_tcode.
    <ls_map>-profile_name = lv_profile.
    <ls_map>-profile_ver  = lv_ver.
    PERFORM normalize_mapping_source
      USING    <ls_map>-source_column
      CHANGING <ls_map>-source_column.
    TRANSLATE <ls_map>-staging_field TO UPPER CASE.
    CONDENSE <ls_map>-staging_field NO-GAPS.
    IF <ls_map>-bdc_field IS NOT INITIAL.
      PERFORM normalize_mapping_bdc_field
        USING    <ls_map>-bdc_field
        CHANGING <ls_map>-bdc_field.
    ENDIF.
    PERFORM NORM_MAP_REQUIRED CHANGING <ls_map>.
    PERFORM apply_fmt_contract CHANGING <ls_map>.
  ENDLOOP.

  REFRESH: lt_script, lt_raw_snapshot.
  IF lv_fresh_acq = abap_true.
    lt_raw_snapshot = gt_z333_rec_evidence.
  ELSE.
    CLEAR: lv_raw_ok, lv_raw_msg.
    PERFORM load_raw_snapshot
      USING    lv_tcode gv_runtime_script_id
      CHANGING lt_raw_snapshot lv_raw_ok lv_raw_msg.
    IF lv_raw_ok <> abap_true.
      cv_message = lv_raw_msg.
      RETURN.
    ENDIF.
  ENDIF.

  IF lt_raw_snapshot IS INITIAL.
    cv_message = 'Immutable raw acquisition evidence is empty; Generate Template stopped safely.'.
    RETURN.
  ENDIF.

 "compile from RAW every publication. Never compile an already
 "parameterized frozen contract a second time.
  lt_script = lt_raw_snapshot.
  PERFORM apply_map_to_script
    USING    lt_map
    CHANGING lt_script.
  PERFORM compile_raw_simple CHANGING lt_script.

  CLEAR: lv_plan_ok, lv_plan_msg.
  PERFORM compiled_plan_ok
    USING    lt_script
    CHANGING lv_plan_ok lv_plan_msg.
  IF lv_plan_ok <> abap_true.
    cv_message = lv_plan_msg.
    RETURN.
  ENDIF.

 "Candidate Mapping may become executable authority only when every
 "visible business row resolves to the same DYNAMIC source in the runtime
 "Script. No source/staging/logical alias may fan out.
  CLEAR: lv_valid, lv_valid_msg.
  PERFORM validate_map_script_1to1
    USING    lt_map lt_script
    CHANGING lv_valid lv_valid_msg.
  IF lv_valid <> abap_true.
    cv_message = lv_valid_msg.
    RETURN.
  ENDIF.

 "Generate Template is the publication boundary for a fresh Candidate
 "whose Mapping is already visible but PROFILE_VER is still blank. Reserve a
 "version only now, after the exact Mapping -> Script contract has passed.
 "This uses the same canonical schema reservation/reuse mechanism as normal
 "onboarding; no TCODE, field, table or transaction-specific branch is added.
  CLEAR lv_version_reserved.
  IF lv_ver IS INITIAL.
    IF lv_fresh_acq <> abap_true.
      cv_message =
        'Candidate Mapping has no Profile Version and is not backed by the current raw recording; template generation stopped safely.'.
      RETURN.
    ENDIF.

    CLEAR: lv_schema_fp, lv_schema_ok, lv_schema_msg.
    PERFORM script_schema_fp
      USING    lv_tcode lt_script
      CHANGING lv_schema_fp lv_schema_ok lv_schema_msg.
    IF lv_schema_ok <> abap_true OR lv_schema_fp IS INITIAL.
      cv_message = lv_schema_msg.
      IF cv_message IS INITIAL.
        cv_message = 'Candidate Template Schema identity could not be calculated; no version was allocated.'.
      ENDIF.
      RETURN.
    ENDIF.

    PERFORM selection_fp_map USING lv_tcode lt_map
      CHANGING lv_selection_fp lv_selection_ok lv_selection_msg.
    IF lv_selection_ok <> abap_true.
      cv_message = lv_selection_msg.
      RETURN.
    ENDIF.
    PERFORM version_identity_fp USING lv_tcode lt_raw_snapshot lv_selection_fp
      CHANGING lv_version_fp lv_version_ok lv_version_msg.
    IF lv_version_ok <> abap_true.
      cv_message = lv_version_msg.
      RETURN.
    ENDIF.

    PERFORM get_projection_origin CHANGING lv_origin.
    IF lv_origin IS INITIAL.
      lv_origin = 'CANDIDATE_LOCK'.
    ENDIF.

    CLEAR: lv_reservation_id, lv_reserve_ok, lv_reserve_msg,
           lv_reserve_reused, lv_reuse_id, lv_reuse_hash.
    PERFORM reserve_next_version
      USING    lv_tcode lv_profile lv_origin lv_version_fp
      CHANGING lv_ver lv_reservation_id lv_reserve_reused
               lv_reuse_id lv_reuse_hash lv_reserve_ok lv_reserve_msg.
    IF lv_reserve_ok <> abap_true OR lv_ver IS INITIAL.
      cv_message = lv_reserve_msg.
      IF cv_message IS INITIAL.
        cv_message = 'Candidate Profile Version could not be reserved; no Mapping or template was published.'.
      ENDIF.
      RETURN.
    ENDIF.

 "If the same schema was published already, reuse its immutable tuple. Do
 "not overwrite it with this fresh evidence-only candidate.
    IF lv_reserve_reused = abap_true.
      CLEAR: lv_reg_ok, lv_reg_msg.
      PERFORM apply_map_context
        USING    lv_tcode lv_profile lv_ver lv_reuse_id lv_reuse_hash
        CHANGING lv_reg_ok lv_reg_msg.
      IF lv_reg_ok <> abap_true.
        cv_message = lv_reg_msg.
        IF cv_message IS INITIAL.
          cv_message = 'Existing identical Template Schema was found, but its exact Mapping context could not be pinned.'.
        ENDIF.
        RETURN.
      ENDIF.

      "V17.9.3.3: same VERSION identity may reuse an existing immutable tuple,
      "but Generate Template must still preserve the exact row order the user
      "just reviewed on 0350. Restamp only the tuple identity; do not reload or
      "sort the Mapping repository here. Data/sample values never participate.
      LOOP AT lt_map ASSIGNING <ls_map>.
        <ls_map>-tcode        = lv_tcode.
        <ls_map>-profile_name = lv_profile.
        <ls_map>-profile_ver  = lv_ver.
      ENDLOOP.
      gt_mapping_screen = lt_map.

      PERFORM mark_schema_reuse.
      cv_ok = abap_true.
      cv_message = |Candidate schema already exists as { lv_profile } v{ lv_ver }; the immutable version was reused for Generate Template.|.
      RETURN.
    ENDIF.

    lv_version_reserved = abap_true.
    gv_profile_ver = lv_ver.

 "The candidate was validated while unversioned. Stamp the newly reserved
 "identity into every Mapping row before any repository write.
    LOOP AT lt_map ASSIGNING <ls_map>.
      <ls_map>-profile_ver = lv_ver.
    ENDLOOP.
  ENDIF.

  lv_desc = |Locked Mapping Contract { lv_profile } for { lv_tcode }|.
  PERFORM register_profile_tuple
    USING    lv_tcode lv_profile lv_ver gc_m2_prof_mapped lv_desc
    CHANGING lv_reg_ok lv_reg_msg.
  IF lv_reg_ok <> abap_true.
    IF lv_version_reserved = abap_true.
      PERFORM release_reservation USING lv_reservation_id.
    ENDIF.
    cv_message = lv_reg_msg.
    RETURN.
  ENDIF.

  DELETE FROM zbdc_mapping_bup
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.

  MODIFY zbdc_mapping_bup FROM TABLE lt_map.
  IF sy-subrc <> 0.
    ROLLBACK WORK.
    IF lv_version_reserved = abap_true.
      PERFORM release_reservation USING lv_reservation_id.
    ENDIF.
    cv_message = 'Candidate Mapping rows could not be saved as a locked contract.'.
    RETURN.
  ENDIF.

  CLEAR: lv_guide_ok, lv_guide_msg.
  PERFORM persist_field_guide
    USING    lv_tcode lv_profile lv_ver lt_map
    CHANGING lv_guide_ok lv_guide_msg.
  IF lv_guide_ok <> abap_true.
    ROLLBACK WORK.
    IF lv_version_reserved = abap_true.
      PERFORM release_reservation USING lv_reservation_id.
    ENDIF.
    cv_message = lv_guide_msg.
    RETURN.
  ENDIF.

 "exact-identity Field Guide must read back as the same Mapping
 "binding set. Legacy Field Guide shapes remain on the existing safe Mapping
 "fallback and therefore cannot be round-trip verified here.
  IF lv_guide_msg NP 'LEGACY_FGUID_NO_EXACT_IDENTITY*'.
    CLEAR: lv_guide_ok, lv_guide_msg.
    PERFORM verify_fguide_roundtrip
      USING    lv_tcode lv_profile lv_ver lt_map
      CHANGING lv_guide_ok lv_guide_msg.
    IF lv_guide_ok <> abap_true.
      ROLLBACK WORK.
      IF lv_version_reserved = abap_true.
        PERFORM release_reservation USING lv_reservation_id.
      ENDIF.
      cv_message = lv_guide_msg.
      RETURN.
    ENDIF.
  ENDIF.

 "promotion must preserve the acquisition source in
 "ZBDC_SCRIPT_BUP-RECORDING_NAME. Earlier code overwrote SHDB_TXT /
 "SHDB_PROGRAM with CANDIDATE_LOCK, so a real import disappeared from
 "My Import / All Import after Generate Template. Keep the exact acquisition
 "origin; only non-acquisition legacy flows use CANDIDATE_LOCK.
  CLEAR lv_origin.
  PERFORM get_projection_origin CHANGING lv_origin.
  IF lv_origin <> 'GUIDED_RECORD'
     AND lv_origin <> 'SHDB_TXT'
     AND lv_origin <> 'SHDB_PROGRAM'.
    lv_origin = 'CANDIDATE_LOCK'.
  ENDIF.

  CLEAR: lv_script_id, lv_hash, lv_save_ok, lv_save_msg.
  PERFORM persist_profile_script
    USING    lv_tcode lv_profile lv_ver
             lv_origin gc_m2_prof_mapped lt_script
    CHANGING lv_script_id lv_hash lv_save_ok lv_save_msg.
  IF lv_save_ok <> abap_true.
    ROLLBACK WORK.
    IF lv_version_reserved = abap_true.
      PERFORM release_reservation USING lv_reservation_id.
    ENDIF.
    cv_message = lv_save_msg.
    RETURN.
  ENDIF.

 "Candidate promotion creates a new immutable Script ID/Hash.
 "The user-action/name certificate was confirmed against the same current
 "RAW acquisition before promotion. Rebind that exact already-confirmed set
 "to the promoted Script identity BEFORE LOAD_MAPPING_SCREEN. Otherwise
 "filter_map_members reloads the new Script certificate, finds none,
 "clears GT_Z659_USER_ACTIONS and projects every business row away; the user
 "then sees an empty Mapping and Generate Template reports 'Mapping profile
 "is empty.'. No field/TCODE is inferred here: the exact confirmed set is
 "copied only after Z483 1:1 Mapping<->Script validation has already passed.
  CLEAR lv_origin.
  PERFORM get_projection_origin CHANGING lv_origin.
  IF lv_origin = 'GUIDED_RECORD'
     OR lv_origin = 'SHDB_TXT'
     OR lv_origin = 'SHDB_PROGRAM'.
    IF gv_z659_action_ready <> abap_true
       OR gv_z684_name_ready <> abap_true
       OR gt_z659_user_actions IS INITIAL
       OR gt_z684_names IS INITIAL.
      ROLLBACK WORK.
      IF lv_version_reserved = abap_true.
        PERFORM release_reservation USING lv_reservation_id.
      ENDIF.
      cv_message =
        'CERT_REBIND_BLOCK: exact confirmed user-action/name set was lost before Candidate promotion; Mapping was not published.'.
      RETURN.
    ENDIF.

    CLEAR: lv_cert_rebind_ok, lv_cert_rebind_msg.
    PERFORM save_action_cert
      USING    lv_script_id lv_hash
      CHANGING lv_cert_rebind_ok lv_cert_rebind_msg.
    IF lv_cert_rebind_ok <> abap_true.
      ROLLBACK WORK.
      IF lv_version_reserved = abap_true.
        PERFORM release_reservation USING lv_reservation_id.
      ENDIF.
      cv_message = lv_cert_rebind_msg.
      IF cv_message IS INITIAL.
        cv_message =
          'CERT_REBIND_BLOCK: promoted Script could not receive the exact confirmed user-action certificate.'.
      ENDIF.
      RETURN.
    ENDIF.
  ENDIF.

  CLEAR: lv_raw_save_ok, lv_raw_save_msg.
  PERFORM save_raw_snapshot
    USING    lv_script_id lt_raw_snapshot
    CHANGING lv_raw_save_ok lv_raw_save_msg.
  IF lv_raw_save_ok <> abap_true.
    ROLLBACK WORK.
    IF lv_version_reserved = abap_true.
      PERFORM release_reservation USING lv_reservation_id.
    ENDIF.
    cv_message = lv_raw_save_msg.
    RETURN.
  ENDIF.


  IF lv_schema_fp IS NOT INITIAL.
    PERFORM ensure_schema_fp USING lv_script_id lv_schema_fp
      CHANGING lv_schema_ok lv_schema_msg.
    IF lv_schema_ok <> abap_true.
      ROLLBACK WORK.
      IF lv_version_reserved = abap_true.
        PERFORM release_reservation USING lv_reservation_id.
      ENDIF.
      cv_message = lv_schema_msg.
      RETURN.
    ENDIF.
  ENDIF.
  IF lv_version_fp IS NOT INITIAL.
    PERFORM ensure_version_fp USING lv_script_id lv_version_fp
      CHANGING lv_version_ok lv_version_msg.
    IF lv_version_ok <> abap_true.
      ROLLBACK WORK.
      IF lv_version_reserved = abap_true.
        PERFORM release_reservation USING lv_reservation_id.
      ENDIF.
      cv_message = lv_version_msg.
      RETURN.
    ENDIF.
  ENDIF.

  PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  UPDATE zbdc_prof_bup
    SET status      = @gc_m2_prof_mapped,
        description = @lv_desc,
        changed_by  = @sy-uname,
        changed_on  = @gv_demo_date_837,
        changed_at  = @gv_demo_time_837
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  IF sy-subrc <> 0.
    ROLLBACK WORK.
    IF lv_version_reserved = abap_true.
      PERFORM release_reservation USING lv_reservation_id.
    ENDIF.
    cv_message = 'Profile status could not be updated to MAPPED after candidate lock.'.
    RETURN.
  ENDIF.

  COMMIT WORK AND WAIT.
  IF lv_version_reserved = abap_true.
    CLEAR gv_z133_reservation_id.
  ENDIF.

  p_rec_tcode              = lv_tcode.
  p_transaction            = lv_tcode.
  txtp_profile_name        = lv_profile.
  gv_profile_ver           = lv_ver.
  gv_runtime_script_id     = lv_script_id.
  gv_runtime_contract_hash = lv_hash.
  gv_z133_loaded_script_id = lv_script_id.
  gv_z133_loaded_hash      = lv_hash.
  gt_script_def            = lt_script.
  gt_mapping_screen        = lt_map.
  CLEAR gv_z240_map_locked.
  gv_z133_origin = 'LOCKED_CONTRACT'.
  gv_z340_lock_done = abap_true.

  CLEAR: lv_reg_ok, lv_reg_msg.
  PERFORM apply_map_context
    USING    lv_tcode lv_profile lv_ver lv_script_id lv_hash
    CHANGING lv_reg_ok lv_reg_msg.
  IF lv_reg_ok <> abap_true.
    cv_message = lv_reg_msg.
    IF cv_message IS INITIAL.
      cv_message =
        'POST_PROMOTION_CONTEXT_BLOCK: promoted Mapping context could not be pinned.'.
    ENDIF.
    RETURN.
  ENDIF.

 "reload is now expected to be set-preserving because the exact
 "confirmation certificate has been rebound to the promoted Script identity.
 "Keep a defensive invariant so Generate Template never proceeds from an
 "accidentally emptied projection. LT_MAP is the exact validated/persisted
 "Candidate set, not a guessed fallback.
  DESCRIBE TABLE lt_map LINES lv_expected_map_n.
  PERFORM load_mapping_screen.
  DESCRIBE TABLE gt_mapping_screen LINES lv_reloaded_map_n.

  "V17.9.3.3: LOAD_MAPPING_SCREEN intentionally reads the repository with
  "ORDER BY STAGING_FIELD, SOURCE_COLUMN for deterministic history browsing.
  "That repository order is NOT the user's current Mapping/template order.
  "After using the reload as a set/certificate sanity check, restore LT_MAP,
  "which is the exact validated 0350 projection in the exact visible order.
  "Generate Template and Field Guide persistence must consume this order.
  gt_mapping_screen = lt_map.

  IF lv_reloaded_map_n <> lv_expected_map_n OR lv_reloaded_map_n <= 0.
    cv_message =
      |POST_PROMOTION_SET_RESTORED: validated Mapping rows={ lv_expected_map_n }, reloaded rows={ lv_reloaded_map_n }; exact persisted Candidate set and order were restored in-memory for Generate Template.|.
  ENDIF.

  cv_ok = abap_true.
  IF cv_message IS INITIAL.
    cv_message = |Candidate Mapping locked as MAPPED contract { lv_profile } v{ lv_ver }. Generate Template may continue; execution still requires runtime/object-proof setup.|.
  ENDIF.
ENDFORM.

FORM prepare_template_ctx
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_tcode   TYPE zbdc_prof_bup-tcode,
        lv_profile TYPE zbdc_prof_bup-profile_name,
        lv_ver      TYPE zbdc_prof_bup-profile_ver,
        lv_ctx_ok   TYPE abap_bool,
        lv_status   TYPE zbdc_prof_bup-status,
        lv_valid    TYPE abap_bool,
        lv_test_ok  TYPE abap_bool,
        lv_test_msg TYPE string,
        lv_cand_ok      TYPE abap_bool,
        lv_cand_msg     TYPE string.

  CLEAR: cv_ok, cv_message.

 "Candidate Review promotion must happen before exact-template
 "context resolution. Screen 0350 calls this preparer first; if the
 "candidate gate stays here, Generate Template only shows the evidence-only
 "message and never reaches DOWNLOAD_CURR_PROF_TMPL, where originally
 "attempted to promote. Promote/lock the reviewed candidate at the command
 "boundary, then continue with the normal exact Mapping Contract flow.
  IF gv_z240_map_locked = abap_true
     AND gt_mapping_screen IS NOT INITIAL.
    CLEAR: lv_cand_ok, lv_cand_msg.
    PERFORM promote_cand_contract
      CHANGING lv_cand_ok lv_cand_msg.
    IF lv_cand_ok <> abap_true.
      cv_message = lv_cand_msg.
      IF cv_message IS INITIAL.
        cv_message = 'Candidate Mapping was not locked; template generation was cancelled.'.
      ENDIF.
      RETURN.
    ENDIF.
    CLEAR gv_z240_map_locked.
    gv_z133_origin = 'LOCKED_CONTRACT'.
    gv_z340_lock_done = abap_true.

    "V17.9.3.3: PROMOTE_CAND_CONTRACT already returns GT_MAPPING_SCREEN in
    "the exact current 0350 order. A second LOAD_MAPPING_SCREEN here would
    "re-sort the same rows by repository STAGING_FIELD/SOURCE_COLUMN and make
    "the generated template differ from the Mapping the user just confirmed.
  ENDIF.

  PERFORM resolve_mapping_config_context
    CHANGING lv_tcode lv_profile lv_ver lv_ctx_ok.
  IF lv_ctx_ok <> abap_true.
    cv_message = 'Exact Mapping context could not be resolved for template generation.'.
    RETURN.
  ENDIF.

  SELECT SINGLE status FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  IF sy-subrc <> 0.
    cv_message = 'Profile Registry is missing for the selected Mapping context.'.
    RETURN.
  ENDIF.

  IF lv_status = gc_m2_prof_draft.
 "Generate Template is an explicit action on the Mapping currently
 "open in 0350. Do not repoint GV_PROFILE_VER to an older stable version.
 "Historical stable contracts remain available for runtime/history reuse,
 "but template generation must either prepare this exact tuple or fail closed.
    CLEAR: lv_valid, lv_test_msg.
    PERFORM template_authority_ok
      USING    lv_tcode lv_profile lv_ver lv_status
      CHANGING lv_valid lv_test_msg.
    IF lv_valid <> abap_true.
      cv_message = lv_test_msg.
      RETURN.
    ENDIF.

    PERFORM save_mapping_screen.
    CLEAR lv_status.
    SELECT SINGLE status FROM zbdc_prof_bup
      INTO @lv_status
      WHERE tcode        = @lv_tcode
        AND profile_name = @lv_profile
        AND profile_ver  = @lv_ver.
  ENDIF.

  IF lv_status = gc_m2_prof_mapped.
    CLEAR: lv_valid, lv_test_ok, lv_test_msg.

    PERFORM validate_mapping_profile
      CHANGING lv_valid lv_test_msg.
    IF lv_valid <> abap_true.
      cv_message = lv_test_msg.
      RETURN.
    ENDIF.

    PERFORM prepare_test_contract
      USING    lv_tcode lv_profile lv_ver
      CHANGING lv_test_ok lv_test_msg.
    IF lv_test_ok <> abap_true.
      IF lv_test_msg CS 'Profile setup incomplete'
         OR lv_test_msg CS 'Object Proof Contract'.
 "Template download is a harmless mapping artifact. A
 "missing generic proof contract must still block Testing/Execution,
 "but it must not block template generation or force a new recording.
        cv_ok = abap_true.
        cv_message =
          'Template can be generated from this MAPPED profile; ' &&
          'execution remains blocked until profile setup is completed.'.
        RETURN.
      ENDIF.
      ROLLBACK WORK.
      cv_message = lv_test_msg.
      RETURN.
    ENDIF.

    PERFORM get_demo_now CHANGING gv_demo_date_837 gv_demo_time_837.
  UPDATE zbdc_prof_bup
      SET status     = 'TESTING',
          changed_by = @sy-uname,
          changed_on = @gv_demo_date_837,
          changed_at = @gv_demo_time_837
      WHERE tcode        = @lv_tcode
        AND profile_name = @lv_profile
        AND profile_ver  = @lv_ver.
    IF sy-subrc <> 0.
      ROLLBACK WORK.
      cv_message = 'Profile could not be moved from MAPPED to TESTING for template generation.'.
      RETURN.
    ENDIF.

    COMMIT WORK AND WAIT.
    lv_status = 'TESTING'.
  ENDIF.

  IF lv_status <> 'TESTING'
     AND lv_status <> gc_m2_prof_active
     AND lv_status <> gc_m2_prof_mapped
     AND lv_status <> gc_m2_prof_draft.
    cv_message = |Template contract was not prepared; current profile status is { lv_status }.|.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  IF lv_status = gc_m2_prof_mapped.
    cv_message = |Template context { lv_profile } v{ lv_ver } is MAPPED; runtime remains blocked until setup is complete.|.
  ELSEIF lv_status = gc_m2_prof_draft.
    cv_message = |Draft template { lv_profile } v{ lv_ver } can be generated; runtime remains blocked until Mapping/Profile setup is completed.|.
  ELSE.
    cv_message = |Template context { lv_profile } v{ lv_ver } is { lv_status }.|.
  ENDIF.
ENDFORM.

*& Auto-save internal Field Guide before template build

FORM ensure_tmpl_fguide
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_mapping_bup-profile_ver
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_guide TYPE ty_t_map_meta,
        lt_map   TYPE ty_t_mapping_db,
        ls_map   TYPE zbdc_mapping_bup,
        lv_src   TYPE zbdc_mapping_bup-source_column,
        lv_ok    TYPE abap_bool,
        lv_msg   TYPE string,
        lv_legacy_fguide TYPE abap_bool,
        lt_z483_script TYPE ty_t_script,
        lv_z483_script_id TYPE zbdc_script_bup-script_id,
        lv_z483_hash TYPE zbdc_script_bup-contract_hash,
        lv_z483_found TYPE abap_bool,
        lv_z483_ok TYPE abap_bool,
        lv_z483_msg TYPE string.

  CLEAR: cv_ok, cv_message.

  IF iv_tcode IS INITIAL OR iv_profile IS INITIAL OR iv_ver IS INITIAL.
    cv_message = 'Template Field Guide cannot be prepared because TCODE/Profile/Version is missing.'.
    RETURN.
  ENDIF.

 "do not trust a stale/incomplete Field Guide. The previous
 "version returned as soon as any FIELD_GUIDE row existed, so Generate
 "Template could still fail with "Mapping contract is incomplete" when
 "the screen projection had been cleaned but the persisted guide belonged
 "to an older/stale candidate. In the end-user-only flow, the current
 "Mapping screen projection is the authority and must replace the exact
 "tuple Field Guide before building the template.
  REFRESH lt_guide.

 "End-user-only flow: the Mapping screen already shows the canonical
 "business-input projection. Persist that projection as the internal Field
 "Guide automatically; no Remove/Restore/Lock action is exposed to the user.
  LOOP AT gt_mapping_screen INTO ls_map
    WHERE tcode        = iv_tcode
      AND profile_name = iv_profile
      AND profile_ver  = iv_ver.

    IF ls_map-mandatory = gc_m2_map_review.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_source
      USING    ls_map-source_column
      CHANGING lv_src.
    IF lv_src IS INITIAL.
      CONTINUE.
    ENDIF.
    ls_map-source_column = lv_src.
    APPEND ls_map TO lt_map.
  ENDLOOP.

  IF lt_map IS INITIAL.
    SELECT * FROM zbdc_mapping_bup
      INTO TABLE @lt_map
      WHERE tcode        = @iv_tcode
        AND profile_name = @iv_profile
        AND profile_ver  = @iv_ver
      ORDER BY staging_field, source_column.

    IF lt_map IS NOT INITIAL.
      PERFORM filter_map_bus_view
        USING    iv_tcode iv_profile iv_ver
        CHANGING lt_map.
      PERFORM filter_map_user_ev
        CHANGING lt_map.
    ENDIF.
  ENDIF.

  DELETE lt_map WHERE mandatory = gc_m2_map_review.

 "when GT_MAPPING_SCREEN supplied the rows, that set is already the
 "strict 0350 projection. Persist exactly it; do not reclassify during Generate.

  IF lt_map IS INITIAL.
    cv_message = 'Template Field Guide could not be built from the current Mapping projection.'.
    RETURN.
  ENDIF.

 "Generate Template is allowed only from Mapping rows that still
 "bind 1:1 to the exact frozen runtime Script. This prevents a stale 0350
 "projection from creating a valid-looking but non-executable template.
  REFRESH lt_z483_script.
  CLEAR: lv_z483_script_id, lv_z483_hash, lv_z483_found,
         lv_z483_ok, lv_z483_msg.
  PERFORM load_profile_script
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_z483_script lv_z483_script_id lv_z483_hash lv_z483_found.
  IF lv_z483_found <> abap_true.
    cv_message = 'Frozen Script could not be loaded for template binding verification.'.
    RETURN.
  ENDIF.
  PERFORM validate_map_script_1to1
    USING    lt_map lt_z483_script
    CHANGING lv_z483_ok lv_z483_msg.
  IF lv_z483_ok <> abap_true.
    cv_message = lv_z483_msg.
    RETURN.
  ENDIF.

  CLEAR: lv_ok, lv_msg.
  PERFORM persist_field_guide
    USING    iv_tcode iv_profile iv_ver lt_map
    CHANGING lv_ok lv_msg.
  IF lv_ok <> abap_true.
    cv_message = lv_msg.
    RETURN.
  ENDIF.

 "a legacy optional Field Guide may not carry Profile/Version.
 "Do not mutate that table; use the exact locked Mapping tuple instead.
  IF lv_msg CP 'LEGACY_FGUID_NO_EXACT_IDENTITY*'.
    lv_legacy_fguide = abap_true.
  ENDIF.

 "after the internal Field Guide is written, this exact tuple is a
 "template-ready Mapping contract. Runtime activation/testing remains
 "controlled by the existing profile/certification gates; this promotion is
 "only to let Generate Template use the saved Field Guide as authority.
  UPDATE zbdc_prof_bup
    SET status = @gc_m2_prof_mapped
    WHERE tcode        = @iv_tcode
      AND profile_name = @iv_profile
      AND profile_ver  = @iv_ver
      AND status       = @gc_m2_prof_draft.

  IF lv_legacy_fguide = abap_true.
    COMMIT WORK AND WAIT.
    cv_ok = abap_true.
    cv_message =
      'Template authority uses the exact locked Mapping contract; legacy Field Guide table was left untouched.'.
    RETURN.
  ENDIF.

 "exact Field Guide persistence and profile status stay in one LUW.
 "Verify first; only commit after the persisted manifest reads back exactly.
  CLEAR: lv_z483_ok, lv_z483_msg.
  PERFORM verify_fguide_roundtrip
    USING    iv_tcode iv_profile iv_ver lt_map
    CHANGING lv_z483_ok lv_z483_msg.
  IF lv_z483_ok <> abap_true.
    ROLLBACK WORK.
    cv_message = lv_z483_msg.
    RETURN.
  ENDIF.

  COMMIT WORK AND WAIT.
  cv_ok = abap_true.
  cv_message = lv_msg.
ENDFORM.

FORM download_curr_prof_tmpl.
  DATA: lt_fields      TYPE ty_t_xlsx_field,
        lt_binary      TYPE solix_tab,
        lt_csv         TYPE string_table,
        lv_contract_ok TYPE abap_bool,
        lv_package_ok  TYPE abap_bool,
        lv_xlsx        TYPE xstring,
        lv_size        TYPE i,
        lv_profile     TYPE zbdc_prof_bup-profile_name,
        lv_ver         TYPE zbdc_prof_bup-profile_ver,
        lv_tcode       TYPE zbdc_prof_bup-tcode,
        lv_ok          TYPE abap_bool,
        lv_status      TYPE zbdc_prof_bup-status,
        lv_default     TYPE string,
        lv_name        TYPE string,
        lv_path        TYPE string,
        lv_full        TYPE string,
        lv_message     TYPE string,
        lv_action      TYPE i,
        lv_format      TYPE c LENGTH 1,
        lv_delivery    TYPE c LENGTH 1,
        lv_guard_ok    TYPE abap_bool,
        lv_guard_msg   TYPE string,
        lv_csv_xstr    TYPE xstring,
        lv_csv_size    TYPE i,
        lv_csv_ok      TYPE abap_bool,
        lv_upload_ok   TYPE abap_bool,
        lv_mail_ok     TYPE abap_bool,
        lv_mime        TYPE string,
        lt_manifest_sources TYPE string_table,
        lv_manifest_ok TYPE abap_bool,
        lv_manifest_msg TYPE string,
        lv_manifest_source TYPE zbdc_mapping_bup-source_column.

 "One lifecycle owner. USER_COMMAND_0350 prepares the template context
 "before calling this FORM. Keep a defensive direct-call path, but delegate to
 "the same preparer instead of promoting the candidate a second time.
  IF gv_z240_map_locked = abap_true
     AND gt_mapping_screen IS NOT INITIAL.
    CLEAR: lv_guard_ok, lv_guard_msg.
    PERFORM prepare_template_ctx
      CHANGING lv_guard_ok lv_guard_msg.
    IF lv_guard_ok <> abap_true.
      IF lv_guard_msg IS INITIAL.
        MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '868' INTO lv_guard_msg.
      ENDIF.
      PERFORM userize_ui_message USING lv_guard_msg CHANGING gv_ui_message.
      MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.
  ENDIF.

  PERFORM guard_mapping_action
    USING 'GENERATE_TEMPLATE'
    CHANGING lv_guard_ok lv_guard_msg.
  IF lv_guard_ok <> abap_true.
    PERFORM userize_ui_message USING lv_guard_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF go_map_grid IS BOUND.
    go_map_grid->check_changed_data( ).
  ENDIF.

  PERFORM resolve_mapping_config_context
    CHANGING lv_tcode lv_profile lv_ver lv_ok.
  IF lv_ok <> abap_true.
    MESSAGE s302(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.

  IF sy-subrc <> 0.
    MESSAGE s303(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF lv_status <> gc_m2_prof_active
     AND lv_status <> 'TESTING'
     AND lv_status <> gc_m2_prof_mapped.
 "Generate Template is the explicit convenience boundary for
 "onboarding. A DRAFT mapping must be auto-saved/prepared here, just
 "like Import pins and persists its candidate context. Do not force the
 "user to know or press a separate Save Mapping button.
    CLEAR: lv_guard_ok, lv_guard_msg.
    PERFORM prepare_template_ctx
      CHANGING lv_guard_ok lv_guard_msg.
    IF lv_guard_ok <> abap_true.
      IF lv_guard_msg IS INITIAL.
        DATA(lv_zm869_24717_1) = |{ lv_status }|.
        MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '869'
          WITH lv_zm869_24717_1 INTO lv_guard_msg.
      ENDIF.
      PERFORM userize_ui_message USING lv_guard_msg CHANGING gv_ui_message.
      MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    CLEAR lv_status.
    SELECT SINGLE status
      FROM zbdc_prof_bup
      INTO @lv_status
      WHERE tcode        = @lv_tcode
        AND profile_name = @lv_profile
        AND profile_ver  = @lv_ver.
  ENDIF.

  CLEAR: lv_guard_ok, lv_guard_msg.
  PERFORM ensure_tmpl_fguide
    USING    lv_tcode lv_profile lv_ver
    CHANGING lv_guard_ok lv_guard_msg.
  IF lv_guard_ok <> abap_true.
    IF lv_guard_msg IS INITIAL.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '870' INTO lv_guard_msg.
    ENDIF.
    PERFORM userize_ui_message USING lv_guard_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  PERFORM build_xlsx_contract
    USING    lv_tcode lv_profile lv_ver
    CHANGING lt_fields lv_contract_ok.

  IF lv_contract_ok <> abap_true.
    MESSAGE s304(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "V17.9.3: Template-manifest metadata is never a Mapping/Generate gate.
 "Version routing has already been decided from the technical choreography +
 "the user-selected SAP field set. Generate Template therefore consumes the
 "current version-owned Mapping projection directly. The derivative ordered
 "manifest is repaired below, but it can never block this screen.
  CLEAR: lv_manifest_ok, lv_manifest_msg.

 "Freeze the exact ordered header that this version is about to emit.
 "Upload will read this manifest verbatim instead of rebuilding membership.
  REFRESH lt_manifest_sources.
  LOOP AT lt_fields INTO DATA(ls_manifest_field).
    CLEAR lv_manifest_source.
    PERFORM normalize_mapping_source
      USING    ls_manifest_field-source_column
      CHANGING lv_manifest_source.
    IF lv_manifest_source IS INITIAL.
      MESSAGE s740(zbdc) DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.
    APPEND lv_manifest_source TO lt_manifest_sources.
  ENDLOOP.

  CLEAR: lv_manifest_ok, lv_manifest_msg.
  PERFORM freeze_template_manifest
    USING    lv_tcode lv_profile lv_ver lt_manifest_sources
    CHANGING lv_manifest_ok lv_manifest_msg.
  IF lv_manifest_ok <> abap_true.
    IF lv_manifest_msg IS INITIAL.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '871' INTO lv_manifest_msg.
    ENDIF.
    PERFORM userize_ui_message USING lv_manifest_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "Restore the original unified Generate Template UX from the
 "stable multi-delivery flow. Start Recording and SHDB Import converge on
 "the same exact TCODE/Profile/Version Mapping contract; template delivery
 "must therefore never branch by acquisition origin.

 "Step 1: choose one delivery target.
 " L = Download Local
 " M = Gmail Data Entry Request (no physical template file)
 " G = Upload to Google Drive
  PERFORM choose_template_delivery CHANGING lv_delivery.
  IF lv_delivery IS INITIAL.
    RETURN.
  ENDIF.

 "Gmail is a separate no-file channel. SAP sends the exact contract schema
 "to n8n; there is intentionally no XLSX/CSV format choice in this branch.
  IF lv_delivery = 'M'.
    PERFORM send_gmail_form_request
      USING    lv_tcode lv_profile lv_ver lt_fields
      CHANGING lv_mail_ok.
    RETURN.
  ENDIF.

 "Step 2: Local and Google Drive both support the same two file formats.
 "The format choice is independent of whether the contract originated from
 "Start Recording or SHDB TXT Import.
  PERFORM choose_template_format CHANGING lv_format.
  IF lv_format IS INITIAL.
    RETURN.
  ENDIF.

  IF lv_format = 'C'.
    PERFORM build_csv_template_package
      USING    lt_fields
      CHANGING lt_csv.

    IF lt_csv IS INITIAL.
      MESSAGE s305(zbdc)
        DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    PERFORM template_name
      USING    lv_tcode lv_profile lv_ver 'csv'
      CHANGING lv_default.
    lv_mime = 'text/csv'.

    IF lv_delivery = 'G'.
      PERFORM csv_lines_to_xstring
        USING    lt_csv
        CHANGING lv_csv_xstr lv_csv_size lv_csv_ok.

      IF lv_csv_ok <> abap_true.
        MESSAGE s306(zbdc)
          DISPLAY LIKE 'E'.
        RETURN.
      ENDIF.

      PERFORM upload_template_to_gdrive
        USING    lv_tcode lv_profile lv_ver lv_default lv_mime lv_csv_xstr
        CHANGING lv_upload_ok.
      RETURN.
    ENDIF.

    cl_gui_frontend_services=>file_save_dialog(
      EXPORTING
        window_title      = 'Save Certified / TESTING CSV Template'
        default_extension = 'csv'
        default_file_name = lv_default
        file_filter       = 'CSV File (*.csv)|*.csv|'
      CHANGING
        filename          = lv_name
        path              = lv_path
        fullpath          = lv_full
        user_action       = lv_action
      EXCEPTIONS
        OTHERS            = 1 ).

    IF sy-subrc <> 0.
      MESSAGE s307(zbdc)
        WITH sy-subrc
        DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.
    IF lv_action <> cl_gui_frontend_services=>action_ok.
      MESSAGE s308(zbdc)
        DISPLAY LIKE 'I'.
      RETURN.
    ENDIF.

    cl_gui_frontend_services=>gui_download(
      EXPORTING
        filename = lv_full
        filetype = 'ASC'
      CHANGING
        data_tab = lt_csv
      EXCEPTIONS
        OTHERS   = 1 ).

    IF sy-subrc <> 0.
      MESSAGE s309(zbdc)
        DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    IF lv_status = gc_m2_prof_active.
      DATA(lv_zm872_24895_1) = |{ lv_profile }|.
      DATA(lv_zm872_24895_2) = |{ lv_ver }|.
      DATA(lv_zm872_24895_3) = |{ lv_tcode }|.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '872'
        WITH lv_zm872_24895_1 lv_zm872_24895_2 lv_zm872_24895_3
        INTO lv_message.
    ELSEIF lv_status = gc_m2_prof_mapped.
      DATA(lv_zm873_24897_1) = |{ lv_profile }|.
      DATA(lv_zm873_24897_2) = |{ lv_ver }|.
      DATA(lv_zm873_24897_3) = |{ lv_tcode }|.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '873'
        WITH lv_zm873_24897_1 lv_zm873_24897_2 lv_zm873_24897_3
        INTO lv_message.
    ELSE.
      DATA(lv_zm874_24899_1) = |{ lv_profile }|.
      DATA(lv_zm874_24899_2) = |{ lv_ver }|.
      DATA(lv_zm874_24899_3) = |{ lv_tcode }|.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '874'
        WITH lv_zm874_24899_1 lv_zm874_24899_2 lv_zm874_24899_3
        INTO lv_message.
    ENDIF.
    PERFORM userize_ui_message USING lv_message CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S'.
    RETURN.
  ENDIF.

  PERFORM build_safe_xlsx_package
    USING    lt_fields lv_tcode lv_profile lv_ver
    CHANGING lv_xlsx lv_package_ok.

  IF lv_package_ok <> abap_true OR lv_xlsx IS INITIAL.
    MESSAGE s310(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  PERFORM template_name
    USING    lv_tcode lv_profile lv_ver 'xlsx'
    CHANGING lv_default.
  lv_mime = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'.

  IF lv_delivery = 'G'.
    PERFORM upload_template_to_gdrive
      USING    lv_tcode lv_profile lv_ver lv_default lv_mime lv_xlsx
      CHANGING lv_upload_ok.
    RETURN.
  ENDIF.

  cl_gui_frontend_services=>file_save_dialog(
    EXPORTING
      window_title      = 'Save Certified / TESTING XLSX Template'
      default_extension = 'xlsx'
      default_file_name = lv_default
      file_filter       = 'Excel Workbook (*.xlsx)|*.xlsx|'
    CHANGING
      filename          = lv_name
      path              = lv_path
      fullpath          = lv_full
      user_action       = lv_action
    EXCEPTIONS
      OTHERS            = 1 ).

  IF sy-subrc <> 0.
    MESSAGE s311(zbdc)
      WITH sy-subrc
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.
  IF lv_action <> cl_gui_frontend_services=>action_ok.
    MESSAGE s308(zbdc)
      DISPLAY LIKE 'I'.
    RETURN.
  ENDIF.

  CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
    EXPORTING
      buffer        = lv_xlsx
    IMPORTING
      output_length = lv_size
    TABLES
      binary_tab    = lt_binary.

  cl_gui_frontend_services=>gui_download(
    EXPORTING
      bin_filesize = lv_size
      filename     = lv_full
      filetype     = 'BIN'
    CHANGING
      data_tab     = lt_binary
    EXCEPTIONS
      OTHERS       = 1 ).

  IF sy-subrc <> 0.
    MESSAGE s312(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF lv_status = gc_m2_prof_active.
    DATA(lv_zm875_24978_1) = |{ lv_profile }|.
    DATA(lv_zm875_24978_2) = |{ lv_ver }|.
    DATA(lv_zm875_24978_3) = |{ lv_tcode }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '875'
      WITH lv_zm875_24978_1 lv_zm875_24978_2 lv_zm875_24978_3
      INTO lv_message.
  ELSEIF lv_status = gc_m2_prof_mapped.
    DATA(lv_zm876_24980_1) = |{ lv_profile }|.
    DATA(lv_zm876_24980_2) = |{ lv_ver }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '876'
      WITH lv_zm876_24980_1 lv_zm876_24980_2 INTO lv_message.
  ELSE.
    DATA(lv_zm877_24982_1) = |{ lv_profile }|.
    DATA(lv_zm877_24982_2) = |{ lv_ver }|.
    MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '877'
      WITH lv_zm877_24982_1 lv_zm877_24982_2 INTO lv_message.
  ENDIF.
  PERFORM userize_ui_message USING lv_message CHANGING gv_ui_message.
  MESSAGE gv_ui_message TYPE 'S'.
ENDFORM.


*&---------------------------------------------------------------------*
*& Import Visual Replay - exact runtime screen proof
*&---------------------------------------------------------------------*
*& This helper does NOT infer a screen label from TXT, DDIC, field tokens
*& or AI. Before CALL TRANSACTION it starts a read-only SAP GUI Scripting
*& watcher. The watcher accepts evidence only when exactly one live GUI
*& session matches:
*&   current system/client/user + imported TCODE + exact PROGRAM/DYNPRO.
*& On that exact runtime screen it:
*&   1) saves a PNG hardcopy of wnd[0];
*&   2) walks live GUI controls;
*&   3) for exact imported technical controls, reads AccLabelCollection.
*& SAP GUI documents AccLabelCollection as the GuiLabel objects assigned to
*& that control in Screen Painter. Those labels are therefore SCREEN_PROVEN.
*& If the exact runtime screen cannot be matched uniquely, no label is added.
*& No replay field, Mapping membership, Version identity or business value
*& is modified by this helper.
*&---------------------------------------------------------------------*
*& Import capture - SAME acquisition path as Start Recording
*&---------------------------------------------------------------------*
*& Import does not own a second watcher. It uses START_GUI_LABEL_CAPTURE /
*& STOP_GUI_LABEL_CAPTURE exactly like Guided Start Recording. The only
*& import-only addition is one JPG hardcopy on every StartRequest, i.e. after
*& the current BDC screen has received its recorded values and immediately
*& before its recorded OKCODE leaves that screen. No Iconify/Restore, no
*& second SAP session, no per-screen replay and no custom attach protocol.
*&---------------------------------------------------------------------*
*& Import Visual Replay (DEV/TEST evidence helper)
*&---------------------------------------------------------------------*
*& Purpose:
*& - Let the user replay an imported SHDB stream to one exact recorded
*&   screen occurrence and visually inspect the values on the real SAP GUI.
*& - The target screen BDC_OKCODE is deliberately removed and CTU NOBIEND
*&   switches out of batch-input mode when the truncated data is exhausted,
*&   so the selected screen becomes interactive instead of being auto-submitted.
*& - Previous screen OKCODEs are still REAL transaction processing. Therefore
*&   this is an explicit DEV/TEST evidence action, never a dry-run guarantee.
*& - No Mapping, Version, script, Template or AI certificate is changed here.
*& - No TCODE/field-specific rule exists; everything comes from exact import rows.
* Screen 0500 - Execution Monitor

FORM load_script_editor.
  DATA: lv_tcode     TYPE zbdc_prof_bup-tcode,
        lv_profile   TYPE zbdc_prof_bup-profile_name,
        lv_ver       TYPE zbdc_prof_bup-profile_ver,
        lv_script_id TYPE zbdc_script_bup-script_id,
        lv_hash      TYPE zbdc_script_bup-contract_hash,
        lv_found     TYPE abap_bool,
        lv_msg_dummy TYPE string.

 "Screen 0800 is a neutral editor/search landing page. Opening or repainting
 "it must not resolve by stale Upload/Preview TCODE, ACTIVE version, or MAX
 "version. It only displays a script when Import Recording / My Import /
 "All Import / completed Guided Recording has already pinned an exact tuple.
  lv_tcode = p_rec_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.

  lv_profile = txtp_profile_name.
  CONDENSE lv_profile.
  lv_ver = gv_profile_ver.

  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL OR lv_ver IS INITIAL
     OR gv_runtime_script_id IS INITIAL
     OR gv_runtime_contract_hash IS INITIAL.
 "Start Recording / TXT-only import can legitimately be audit-only.
 "When the onboarding gate does not pin an executable runtime tuple, keep
 "the freshly captured rows visible from the dedicated evidence buffer.
    IF gt_script_def IS INITIAL AND gt_z333_rec_evidence IS NOT INITIAL.
      gt_script_def = gt_z333_rec_evidence.
    ENDIF.
    IF gt_script_def IS NOT INITIAL.
      RETURN.
    ENDIF.
    REFRESH gt_script_def.
    RETURN.
  ENDIF.

  PERFORM resolve_tuple_script
    USING    lv_tcode lv_profile lv_ver
    CHANGING gt_script_def lv_script_id lv_hash lv_found lv_msg_dummy.

  IF lv_found <> abap_true OR gt_script_def IS INITIAL
     OR lv_script_id <> gv_runtime_script_id
     OR lv_hash      <> gv_runtime_contract_hash.
 "direct post-recording repaint may not have a certified runtime
 "tuple yet. Restore audit-only evidence instead of showing an empty grid.
    IF gt_script_def IS INITIAL AND gt_z333_rec_evidence IS NOT INITIAL.
      gt_script_def = gt_z333_rec_evidence.
    ENDIF.
    IF gt_script_def IS NOT INITIAL.
      RETURN.
    ENDIF.
    REFRESH gt_script_def.
    RETURN.
  ENDIF.
ENDFORM.

* I_PROGRAM_NAME belongs to the classic REUSE ALV helper, but it is not in
* the LVC_FIELDCATALOG_MERGE interface on this SAP system. Build the catalog
* explicitly so Screen 0800 cannot dump on a dynamic function call.
FORM build_script_fcat CHANGING ct_fcat TYPE lvc_t_fcat.
  DATA ls_fcat TYPE lvc_s_fcat.

  REFRESH ct_fcat.

  DEFINE add_script_col.
    CLEAR ls_fcat.
    ls_fcat-fieldname = &1.
    ls_fcat-coltext   = &2.
    ls_fcat-scrtext_l = &2.
    ls_fcat-scrtext_m = &2.
    ls_fcat-scrtext_s = &3.
    ls_fcat-outputlen = &4.
    ls_fcat-edit      = &5.
    ls_fcat-no_out    = &6.
    ls_fcat-key       = &7.
    APPEND ls_fcat TO ct_fcat.
  END-OF-DEFINITION.

  "V17.9.3.12Y - fixed-fit RAW recording view.
  "This is display-only. GT_SCRIPT_DEF remains the immutable replay authority.
  "ACTIVE is intentionally not exposed: the editor is evidence, not a row-toggle UI.
  "Widths are balanced to fit Screen 0800 without requiring horizontal dragging.
  add_script_col 'SCREEN_NAME' 'Screen Name'       'Screen' 20 space space space.
  add_script_col 'BDC_FIELD'   'Field'             'Field'  28 space space space.
  add_script_col 'FIELD_DESC'  'Field Description' 'Desc.'  42 space space space.
  add_script_col 'MAP_VALUE'   'Map Value'         'Value'  24 space space space.
ENDFORM.

*&---------------------------------------------------------------------*
*& Build Process Runner style display projection from exact RAW rows
*&---------------------------------------------------------------------*
FORM build_script_runner_view.
  DATA: ls_scr       TYPE ty_script_def_compat,
        ls_view      TYPE ty_z12r_runner_row,
        lv_program   TYPE char40,
        lv_dynpro    TYPE char4,
        lv_desc      TYPE char80,
        lv_type      TYPE char20,
        lv_len       TYPE i,
        lv_ddic_ok   TYPE abap_bool,
        lv_field     TYPE zbdc_mapping_bup-bdc_field.

  REFRESH gt_z12r_runner_view.
  CLEAR: lv_program, lv_dynpro.

  LOOP AT gt_script_def INTO ls_scr.
    IF ls_scr-is_new_screen = 'X'.
      lv_program = ls_scr-program_name.
      lv_dynpro  = ls_scr-dynpro_no.

      CLEAR ls_view.
      ls_view-active      = abap_true.
      ls_view-row_kind    = 'S'.
      IF lv_program IS INITIAL AND lv_dynpro IS INITIAL.
        ls_view-screen_name = 'Screen'.
      ELSEIF lv_dynpro IS INITIAL.
        ls_view-screen_name = lv_program.
      ELSE.
        ls_view-screen_name = |{ lv_program } - { lv_dynpro }|.
      ENDIF.

      "V17.9.3.12U: exact repository screen short text, same PROGRAM/DYNPRO
      "and current logon language.  No TCODE mapping, memory or AI.
      CLEAR: lv_desc, lv_ddic_ok.
      PERFORM import_screen_description
        USING    lv_program lv_dynpro
        CHANGING lv_desc lv_ddic_ok.
      IF lv_ddic_ok = abap_true.
        ls_view-field_desc = lv_desc.
      ENDIF.

      APPEND ls_view TO gt_z12r_runner_view.
      CONTINUE.
    ENDIF.

    "Every non-screen row below is an exact row from the RAW BDC script.
    "Only FIELD_DESC is enrichment; FIELD/MAP_VALUE are copied byte-for-byte
    "from the parsed recording representation.
    CLEAR: ls_view, lv_desc, lv_type, lv_len, lv_ddic_ok, lv_field.
    ls_view-active    = abap_true.
    ls_view-row_kind  = 'F'.
    lv_field          = ls_scr-field_name.
    ls_view-bdc_field = lv_field.
    ls_view-map_value = ls_scr-static_value.

    CASE lv_field.
      WHEN 'BDC_CURSOR'.
        lv_desc = 'Cursor location'.
      WHEN 'BDC_OKCODE'.
        lv_desc = 'OK Code for this screen'.
      WHEN 'BDC_SUBSCR'.
        lv_desc = 'Subscreen reference'.
      WHEN OTHERS.
        IF lv_field CP 'BDC_*'.
          lv_desc = 'BDC technical control'.
        ELSE.
          PERFORM import_auth_field_desc
            USING    gt_script_def lv_field
            CHANGING lv_desc lv_type lv_len lv_ddic_ok.
          IF lv_ddic_ok <> abap_true OR lv_desc IS INITIAL.
            lv_desc = 'Description unavailable'.
          ENDIF.
        ENDIF.
    ENDCASE.

    ls_view-field_desc = lv_desc.
    APPEND ls_view TO gt_z12r_runner_view.
  ENDLOOP.
ENDFORM.

FORM display_script_editor.
  DATA: lt_fieldcat TYPE lvc_t_fcat,
        ls_layout   TYPE lvc_s_layo,
        ls_stable   TYPE lvc_s_stbl.

  PERFORM load_script_editor.
  PERFORM build_script_runner_view.

  IF go_rec_container IS INITIAL.
    CREATE OBJECT go_rec_container
      EXPORTING container_name = 'CC_REC_GRID'.
  ENDIF.

  IF go_rec_grid IS NOT BOUND.
    CREATE OBJECT go_rec_grid
      EXPORTING i_parent = go_rec_container.

    PERFORM build_script_fcat CHANGING lt_fieldcat.
    IF lt_fieldcat IS INITIAL.
      MESSAGE s313(zbdc)
        DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    ls_layout-zebra      = abap_true.
    "12Y: use the explicit widths from BUILD_SCRIPT_FCAT so all four columns
    "fit the fixed Screen 0800 container without horizontal dragging.
    ls_layout-cwidth_opt = abap_false.
    ls_layout-sel_mode   = 'A'.

    go_rec_grid->set_table_for_first_display(
      EXPORTING
        is_layout       = ls_layout
      CHANGING
        it_outtab       = gt_z12r_runner_view
        it_fieldcatalog = lt_fieldcat ).

    CREATE OBJECT go_recording_events.
    SET HANDLER go_recording_events->on_toolbar FOR go_rec_grid.
    SET HANDLER go_recording_events->on_user_command FOR go_rec_grid.
    go_rec_grid->set_toolbar_interactive( ).
  ELSE.
    ls_stable-row = abap_true.
    ls_stable-col = abap_true.
    go_rec_grid->refresh_table_display(
      EXPORTING is_stable = ls_stable ).
    go_rec_grid->set_toolbar_interactive( ).
  ENDIF.
ENDFORM.

*&=====================================================================*
*& USER-CENTRIC 16/16 RUNTIME INTEGRATION
*& Scope:
*& Use optional setup tables already created in SE11/SM30:
*& ZBDC_FGUID_BUP Field Guide / Template help
*& ZBDC_VRULE_BUP Dynamic validation rules
*& ZBDC_ERROR_BUP Structured error/fix-guide records
*& ZBDC_CHG_BUP Audit/change log
*& Keep legacy Dynpro flow and only GUI statuses for active screens.
*& All dynamic table usage is guarded so the core BDC still runs even
*& if one optional polish table is not transported yet.
*&=====================================================================*

*& Auto prepare mapping contract when Mapping Profile is opened
*& Purpose: I01 calls this FORM before CALL SCREEN 0350.
*& Layer : Mapping/Profile business logic belongs to M2_MAP, not I01.

*& 0800 My Import / All Import history picker
*& Purpose: I01 and the 0800 ALV toolbar call this FORM to select an
*& existing SHDB import/recording contract from ZBDC_SCRIPT_BUP.
*& Layer : Recording / mapping history belongs to M2_MAP, not I01.

FORM pick_import_history USING iv_scope TYPE csequence.

 "professional My Import / All Import picker
 "Reason: F4 popup showed DDIC technical columns (F0001/F0003/Count...)
 " and allowed checkbox-style multi selection.
 "Design: My Import/All Import read import-only script contracts, show
 " business columns only, force one row via ALV row selection, and pin
 " Generate Template to the selected TCode/Profile/Version.

  TYPES: BEGIN OF ty_z66_imp_pick,
           mark           TYPE c LENGTH 1,
           seq_no         TYPE c LENGTH 4,
           priority       TYPE i,
           script_id      TYPE zbdc_script_bup-script_id,
           script_short   TYPE c LENGTH 12,
           tcode          TYPE zbdc_script_bup-tcode,
           profile_name   TYPE zbdc_script_bup-profile_name,
           profile_ver    TYPE zbdc_script_bup-profile_ver,
           status         TYPE zbdc_script_bup-status,
           status_text    TYPE c LENGTH 24,
           recording_name TYPE zbdc_script_bup-recording_name,
           created_by     TYPE zbdc_script_bup-created_by,
           changed_by     TYPE zbdc_script_bup-changed_by,
           changed_at     TYPE zbdc_script_bup-changed_at,
           owner_text     TYPE c LENGTH 12,
           changed_text   TYPE c LENGTH 19,
           source_text    TYPE c LENGTH 16,
         END OF ty_z66_imp_pick.

  DATA: lv_scope      TYPE c LENGTH 1,
        lt_pick       TYPE STANDARD TABLE OF ty_z66_imp_pick,
        ls_pick       TYPE ty_z66_imp_pick,
        lt_fieldcat   TYPE slis_t_fieldcat_alv,
        ls_fieldcat   TYPE slis_fieldcat_alv,
        ls_selfield   TYPE slis_selfield,
        lv_exit       TYPE c,
        lv_title      TYPE c LENGTH 70,
        lv_changed_local_836 TYPE char19,
        lv_count      TYPE i,
        lv_script_id  TYPE zbdc_script_bup-script_id,
        lv_resolve_ok TYPE abap_bool,
        lv_resolve_msg TYPE string,
        lv_sel_ok      TYPE abap_bool,
        lv_sel_msg     TYPE string,
        lv_sel_count   TYPE i,
        ls_head       TYPE zbdc_script_bup.

  CLEAR: lv_scope, ls_pick, ls_head, lv_count,
         lv_script_id, lv_resolve_ok, lv_resolve_msg, lv_title,
         ls_selfield, lv_exit.
  REFRESH: lt_pick, lt_fieldcat.

  lv_scope = iv_scope.
  TRANSLATE lv_scope TO UPPER CASE.
  CONDENSE lv_scope NO-GAPS.

  IF lv_scope <> gc_file_scope_all.
    lv_scope = gc_file_scope_my.
  ENDIF.

 "My Import / All Import are IMPORT history only. Start Recording
 "(GUIDED_RECORD), schema-sync rows and other contract sources must never
 "appear here. Each button press performs a fresh database SELECT, so a
 "successfully committed Import Recording becomes visible immediately.
  IF lv_scope = gc_file_scope_my.
 "My Import = successful TXT/ABAP imports owned by the current SAP user.
    SELECT script_id, tcode, profile_name, profile_ver, status,
           recording_name, created_by, changed_by, changed_at
      FROM zbdc_script_bup
      INTO CORRESPONDING FIELDS OF TABLE @lt_pick
      WHERE ( recording_name = 'SHDB_TXT'
           OR recording_name = 'SHDB_PROGRAM' )
        AND status <> 'RESERVED'
        AND created_by = @sy-uname.
  ELSE.
 "All Import = successful TXT/ABAP imports from every SAP user.
    SELECT script_id, tcode, profile_name, profile_ver, status,
           recording_name, created_by, changed_by, changed_at
      FROM zbdc_script_bup
      INTO CORRESPONDING FIELDS OF TABLE @lt_pick
      WHERE ( recording_name = 'SHDB_TXT'
           OR recording_name = 'SHDB_PROGRAM' )
        AND status <> 'RESERVED'.
  ENDIF.

  IF lt_pick IS INITIAL.
    IF lv_scope = gc_file_scope_my.
      MESSAGE s206(zbdc)
        DISPLAY LIKE 'W'.
    ELSE.
      MESSAGE s207(zbdc)
        DISPLAY LIKE 'W'.
    ENDIF.
    RETURN.
  ENDIF.

  LOOP AT lt_pick INTO ls_pick.

 "Status priority: usable contracts first, audit/blocked rows last.
    CASE ls_pick-status.
      WHEN 'ACTIVE'.
        ls_pick-priority    = 1.
        ls_pick-status_text = 'ACTIVE - runnable'.
      WHEN 'TEST_READY'.
        ls_pick-priority    = 2.
        ls_pick-status_text = 'TEST_READY - test'.
      WHEN 'DRAFT'.
        ls_pick-priority    = 3.
        ls_pick-status_text = 'DRAFT - mapping'.
      WHEN 'INACTIVE'.
        ls_pick-priority    = 8.
        ls_pick-status_text = 'INACTIVE - history'.
      WHEN 'BLOCKED_IMPORT'.
        ls_pick-priority    = 9.
        ls_pick-status_text = 'BLOCKED - review'.
      WHEN OTHERS.
        ls_pick-priority    = 7.
        ls_pick-status_text = ls_pick-status.
    ENDCASE.

    IF ls_pick-created_by IS NOT INITIAL.
      ls_pick-owner_text = ls_pick-created_by.
    ELSEIF ls_pick-changed_by IS NOT INITIAL.
      ls_pick-owner_text = ls_pick-changed_by.
    ELSE.
      ls_pick-owner_text = 'UNKNOWN'.
    ENDIF.

    CASE ls_pick-recording_name.
      WHEN 'SHDB_TXT'.
        ls_pick-source_text = 'Import TXT'.
      WHEN 'SHDB_PROGRAM'.
        ls_pick-source_text = 'Import ABAP'.
      WHEN OTHERS.
 "Defense-in-depth: the SELECT above already excludes non-import rows.
        CONTINUE.
    ENDCASE.

    ls_pick-script_short = ls_pick-script_id.

    CLEAR lv_changed_local_836.
    PERFORM format_demo_ts USING ls_pick-changed_at CHANGING lv_changed_local_836.
    IF lv_changed_local_836 IS NOT INITIAL.
      ls_pick-changed_text = lv_changed_local_836.
    ELSE.
 "fail closed. Never expose a raw UTC/canonical timestamp as
 "user-facing Last Update when Vietnam rendering cannot be proven.
      ls_pick-changed_text = 'UNKNOWN'.
    ENDIF.

    MODIFY lt_pick FROM ls_pick.
  ENDLOOP.

  SORT lt_pick BY priority ASCENDING changed_at DESCENDING tcode ASCENDING profile_name ASCENDING profile_ver DESCENDING.

  CLEAR lv_count.
  LOOP AT lt_pick INTO ls_pick.
    lv_count = lv_count + 1.
    ls_pick-seq_no = lv_count.
    MODIFY lt_pick FROM ls_pick.
  ENDLOOP.

  IF lv_scope = gc_file_scope_my.
    lv_title = |My Import - current user ({ lv_count } import contract(s))|.
  ELSE.
    lv_title = |All Import - all users ({ lv_count } import contract(s))|.
  ENDIF.

  DEFINE add_z66_fcat.
    CLEAR ls_fieldcat.
    ls_fieldcat-fieldname = &1.
    ls_fieldcat-seltext_s = &2.
    ls_fieldcat-seltext_m = &3.
    ls_fieldcat-seltext_l = &3.
    ls_fieldcat-outputlen = &4.
    ls_fieldcat-no_out    = &5.
    APPEND ls_fieldcat TO lt_fieldcat.
  END-OF-DEFINITION.

  add_z66_fcat 'SEQ_NO'         'No'     'No'                 4  ''.
  add_z66_fcat 'TCODE'          'TCode'  'TCode'              8  ''.
  add_z66_fcat 'PROFILE_NAME'   'Profile' 'Mapping Profile'  26  ''.
  add_z66_fcat 'PROFILE_VER'    'Ver'    'Version'            7  ''.
  add_z66_fcat 'SOURCE_TEXT'    'Source' 'Import Source'     16  ''.
  add_z66_fcat 'RECORDING_NAME' 'Recording' 'Recording Name'  28  ''.
  add_z66_fcat 'OWNER_TEXT'     'Owner'  'Owner'             12  ''.
  add_z66_fcat 'CHANGED_TEXT'   'Updated' 'Last Update'      19  ''.
  add_z66_fcat 'SCRIPT_SHORT'   'ID'     'Contract ID'       12  ''.
  add_z66_fcat 'SCRIPT_ID'      'ID'     'Technical ID'      10  'X'.
  add_z66_fcat 'PRIORITY'       'P'      'Priority'           1  'X'.
  add_z66_fcat 'STATUS'         'S'      'Raw Status'        10  'X'.
  add_z66_fcat 'CREATED_BY'     'C'      'Created By'        10  'X'.
  add_z66_fcat 'CHANGED_BY'     'U'      'Changed By'        10  'X'.
  add_z66_fcat 'CHANGED_AT'     'T'      'Raw Timestamp'     14  'X'.

  CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
    EXPORTING
      i_title               = lv_title
      i_selection           = 'X'
      i_zebra               = 'X'
      i_tabname             = 'LT_PICK'
      it_fieldcat           = lt_fieldcat
      i_screen_start_column = 4
      i_screen_start_line   = 2
      i_screen_end_column   = 150
      i_screen_end_line     = 28
    IMPORTING
      es_selfield           = ls_selfield
      e_exit                = lv_exit
    TABLES
      t_outtab              = lt_pick
    EXCEPTIONS
      program_error         = 1
      OTHERS                = 2.

  IF lv_exit = 'X' OR sy-subrc <> 0.
    MESSAGE s314(zbdc).
    RETURN.
  ENDIF.

  CLEAR lv_script_id.

 "no checkbox field is passed to the ALV popup, so the user can
 "choose exactly one row only. The selected row becomes the mapping context.
  IF ls_selfield-tabindex <= 0.
    MESSAGE s315(zbdc)
      DISPLAY LIKE 'W'.
    RETURN.
  ENDIF.

  READ TABLE lt_pick INTO ls_pick INDEX ls_selfield-tabindex.
  IF sy-subrc <> 0 OR ls_pick-script_id IS INITIAL.
    MESSAGE s316(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lv_script_id = ls_pick-script_id.

  SELECT SINGLE *
    FROM zbdc_script_bup
    INTO @ls_head
    WHERE script_id = @lv_script_id.

  IF sy-subrc <> 0 OR ls_head-script_id IS INITIAL.
    MESSAGE s317(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  IF ls_head-status = 'BLOCKED_IMPORT'.
    MESSAGE s318(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "/history selection is not a fresh acquisition. Clear the
 "immutable current-acquisition origin together with the in-memory raw fence
 "so a previous Import/Start cannot contaminate persisted contract review.
  CLEAR: gv_z652_acq_origin,
         gv_z689_review_pending,
         gv_z689_review_tcode,
         gv_z689_review_origin.
  REFRESH: gt_z333_rec_evidence,
           gt_z360_rec_field_vals,
           gt_z369_guided_txt_lines,
           gt_z659_user_actions,
           gt_z684_names.
  CLEAR: gv_z659_action_script, gv_z659_action_hash,
         gv_z659_action_ready, gv_z684_name_script,
         gv_z684_name_hash, gv_z684_name_ready.

 "recover the exact evidence origin of the selected immutable script.
  gv_z359_input_origin = ls_head-recording_name.
  TRANSLATE gv_z359_input_origin TO UPPER CASE.
  CONDENSE gv_z359_input_origin NO-GAPS.

  CLEAR: lv_resolve_ok, lv_resolve_msg.
  PERFORM apply_map_context
    USING    ls_head-tcode ls_head-profile_name ls_head-profile_ver
             ls_head-script_id ls_head-contract_hash
    CHANGING lv_resolve_ok lv_resolve_msg.
  IF lv_resolve_ok <> abap_true.
    IF lv_resolve_msg IS INITIAL.
      MESSAGE ID 'ZBDC' TYPE 'S' NUMBER '878' INTO lv_resolve_msg.
    ENDIF.
    PERFORM userize_ui_message USING lv_resolve_msg CHANGING gv_ui_message.
    MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

 "History selection is now an exact immutable contract context. Set this
 "before restoring Mapping so LOAD_MAPPING_SCREEN can use the certificate
 "projection immediately instead of falling back to draft-rescue logic.
  gv_z133_origin = 'LOCKED_CONTRACT'.

 "My Import / All Import restore the exact field selection already stored
 "for the immutable Script/Hash. The certificate is contract-level, so All
 "Import also restores selections originally confirmed by another SAP user.
  CLEAR: lv_sel_ok, lv_sel_msg, lv_sel_count.
  PERFORM restore_action_cert
    USING    gt_script_def ls_head-script_id ls_head-contract_hash
    CHANGING lv_sel_ok lv_sel_msg.
  IF lv_sel_ok = abap_true.
    DATA: lv_view_ok TYPE abap_bool,
          lv_view_msg TYPE string.
    DESCRIBE TABLE gt_z659_user_actions LINES lv_sel_count.
    PERFORM load_mapping_screen.
    CLEAR: lv_view_ok, lv_view_msg.
    PERFORM build_cert_map_view
      USING    gt_script_def ls_head-tcode ls_head-profile_name ls_head-profile_ver
      CHANGING lv_view_ok lv_view_msg.
    IF lv_view_ok <> abap_true.
      PERFORM userize_ui_message USING lv_view_msg CHANGING gv_ui_message.
      MESSAGE gv_ui_message TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.
  ENDIF.

  DESCRIBE TABLE gt_script_def LINES lv_count.

  IF lv_sel_ok = abap_true.
    DATA(lv_zm741_25592_1) = |{ ls_head-tcode }|.
    DATA(lv_zm741_25592_2) = |{ ls_head-profile_name }|.
    DATA(lv_zm741_25592_3) = |{ ls_head-profile_ver }|.
    DATA(lv_zm741_25592_4) = |{ lv_sel_count }|.
    MESSAGE s741(zbdc) WITH lv_zm741_25592_1 lv_zm741_25592_2 lv_zm741_25592_3 lv_zm741_25592_4.
  ELSE.
    MESSAGE s319(zbdc)
      WITH ls_head-tcode ls_head-profile_name ls_head-profile_ver lv_count.
  ENDIF.

ENDFORM.

*& Evidence-only Candidate Mapping Review

*& TXT_ONLY/GUIDED_ONLY recordings are not allowed to become official
*& Mapping/Template/Execute authority. They are still useful for review.
*& This preview is intentionally in-memory only: no ZBDC_MAPPING_BUP write,
*& no profile activation, no template permission, and no execution context.

*& End-user-only user-action evidence projection

*& Purpose:
*& SHDB/BDC replay rows are not template authority. In an end-user-only
*& flow there is no manual Remove/Lock step, so Candidate Mapping must be
*& projected only from generic user-action evidence before Generate Template
*& internally writes Field Guide rows.

*& accepted evidence, without TCODE/field hardcode:
*& 1. Guided Recording / SHDB TXT: exact BDC_CURSOR target only.
*& 2. SHDB generated Program: exact parameterized RECORD-* input only.

*& Explicitly rejected:
*& indexed-field heuristic alone
*& same-structure / same-screen PAI heuristic
*& SAP default/server-populated values
*& technical/helper fields and INPUT_* aliases

*& Guided Recording recorder-native input evidence

*& FIELD_VALS is the native table returned by the SAP transaction recorder.
*& It does not contain a generic "keyboard event" flag, therefore we do NOT
*& pretend BDC_CURSOR proves every entered field. For Guided Recording an
*& automatic candidate is accepted only when the exact logical field:
*& exists in the raw recorder capture,
*& is entry-enabled (INPUT_OFF is initial),
*& is visible / not suppressed,
*& is present in the captured BDCDATA/script,
*& is not a technical/helper field.
*& This is the strongest generic evidence available from this recorder API.
*& SHDB Program RECORD-* remains the stronger explicit parameter authority.

*& Generic cardinality-aware business source naming

*& Mapping membership is still decided only by recorded user-entry evidence.
*& This layer names an already-approved logical field; it never promotes one.

*& Naming policy (generic, no TCODE / SAP-field / business-label branch):
*& Auto-derived DDIC labels become stable template identifiers.
*& Consecutive one-letter label tokens collapse to one acronym token.
*& If any physical alias of an approved logical field is indexed FIELD(nn),
*& its generated source uses ITEM_. This is cardinality, not TCODE meaning.
*& The rule is stable for one recorded row and N recorded rows because it
*& reads structural index shape, not the number of rows captured this time.
*& SHDB_PROGRAM keeps explicit RECORD-* parameter/source names unchanged.
*& Remaining same-cardinality collisions use the existing exact-BDC fallback.

FORM canon_auto_source
  USING    iv_source TYPE any
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column.

  DATA: lv_input   TYPE string,
        lv_norm    TYPE zbdc_mapping_bup-source_column,
        lv_part    TYPE string,
        lv_out     TYPE string,
        lv_acronym TYPE string,
        lv_len     TYPE i.
  DATA lt_parts TYPE string_table.

 "alias safety: callers are allowed to pass the same variable in
 "USING and CHANGING. Copy the input before clearing the output; otherwise
 "ABAP pass-by-reference erases the source and the canonical projection can
 "collapse to zero fields before Mapping/Template is built.
  lv_input = iv_source.
  CLEAR cv_source.
  PERFORM normalize_mapping_source
    USING    lv_input
    CHANGING lv_norm.
  IF lv_norm IS INITIAL.
    RETURN.
  ENDIF.

  SPLIT lv_norm AT '_' INTO TABLE lt_parts.
  LOOP AT lt_parts INTO lv_part.
    IF lv_part IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_len = strlen( lv_part ).
    IF lv_len = 1 AND lv_part CO 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.
      lv_acronym = lv_acronym && lv_part.
      CONTINUE.
    ENDIF.

    IF lv_acronym IS NOT INITIAL.
      IF lv_out IS INITIAL.
        lv_out = lv_acronym.
      ELSE.
        lv_out = lv_out && '_' && lv_acronym.
      ENDIF.
      CLEAR lv_acronym.
    ENDIF.

    IF lv_out IS INITIAL.
      lv_out = lv_part.
    ELSE.
      lv_out = lv_out && '_' && lv_part.
    ENDIF.
  ENDLOOP.

  IF lv_acronym IS NOT INITIAL.
    IF lv_out IS INITIAL.
      lv_out = lv_acronym.
    ELSE.
      lv_out = lv_out && '_' && lv_acronym.
    ENDIF.
  ENDIF.

  PERFORM normalize_mapping_source
    USING    lv_out
    CHANGING cv_source.
ENDFORM.

*& Binding-safe friendly Template names

*& Field membership is strict user-action projection; naming is separate.
*& Naming is a separate layer and may use ONLY evidence tied to the exact
*& captured interaction:
*& 1) the static label on the exact captured PROGRAM/DYNPRO or BDC_SUBSCR;
*& 2) the exact BDC_OKCODE recorded on the same captured screen, used only
*& to disambiguate duplicate friendly labels;
*& 3) structural LOW/HIGH pairing that is physically present in the same
*& capture, used only as FROM/TO collision disambiguation;
*& 4) exact translated DDIC text only when that semantic label is unique
*&    across the captured logical fields.
*& No TCODE, application table, business field, literal value or transaction
*& family is hardcoded. If neither exact screen evidence nor one-to-one DDIC
*& semantics can prove the name, the field stays unresolved for user review;
*& technical identity remains diagnostic-only and is never promoted as a
*& friendly Template name. Start Recording and SHDB TXT Import therefore use
*& the same evidence contract while preserving the exact BDC replay binding.

FORM range_source
  USING    pt_script TYPE ty_t_script
           iv_bdc    TYPE any
           iv_base   TYPE any
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column
           cv_found  TYPE abap_bool.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_input       TYPE string,
        lv_base        TYPE zbdc_mapping_bup-source_column,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_key         TYPE zbdc_mapping_bup-bdc_field,
        lv_peer_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_low_key     TYPE zbdc_mapping_bup-bdc_field,
        lv_prefix      TYPE string,
        lv_leaf        TYPE string,
        lv_low_label   TYPE zbdc_mapping_bup-source_column,
        lv_low_found   TYPE abap_bool,
        lv_low_raw     TYPE char80,
        lv_low_raw_ok  TYPE abap_bool,
        lv_base_len    TYPE i,
        lv_out         TYPE string.

 "Alias-safe even if a future caller passes the same variable in USING and
 "CHANGING.
  lv_input = iv_base.
  CLEAR: cv_source, cv_found.
  PERFORM normalize_mapping_source
    USING    lv_input
    CHANGING lv_base.
  PERFORM logical_bdc_key
    USING    iv_bdc
    CHANGING lv_target.
  IF lv_base IS INITIAL OR lv_target IS INITIAL OR lv_target NS '-'.
    RETURN.
  ENDIF.

  SPLIT lv_target AT '-' INTO lv_prefix lv_leaf.
  TRANSLATE lv_leaf TO UPPER CASE.
  CLEAR: lv_peer_key, lv_low_key.
  IF lv_leaf = 'LOW'.
    lv_low_key  = lv_target.
    lv_peer_key = lv_prefix && '-HIGH'.
  ELSEIF lv_leaf = 'HIGH'.
    lv_low_key  = lv_prefix && '-LOW'.
    lv_peer_key = lv_low_key.
  ELSE.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    CLEAR lv_key.
    PERFORM logical_bdc_key
      USING    ls_script-field_name
      CHANGING lv_key.
    IF lv_key <> lv_peer_key.
      CONTINUE.
    ENDIF.

 "range semantics are taken from the capture itself. When both
 "PREFIX-LOW and PREFIX-HIGH exist, the LOW control is the range's semantic
 "anchor; HIGH is its paired upper bound. Prefer the exact captured screen
 "label of LOW for BOTH headers. This avoids publishing a connector text
 "such as 'TO' as the business name of the HIGH field.
    CLEAR: lv_low_label, lv_low_found, lv_low_raw, lv_low_raw_ok.
    PERFORM screen_label_from_replay_ctx
      USING    pt_script lv_low_key
      CHANGING lv_low_raw lv_low_raw_ok.
    IF lv_low_raw_ok = abap_true AND lv_low_raw IS NOT INITIAL.
      PERFORM normalize_mapping_source
        USING    lv_low_raw
        CHANGING lv_low_label.
      IF lv_low_label IS NOT INITIAL.
        lv_low_found = abap_true.
      ENDIF.
    ENDIF.
    IF lv_low_label IS NOT INITIAL.
      PERFORM canon_auto_source
        USING    lv_low_label
        CHANGING lv_base.
    ENDIF.

    IF lv_base IS INITIAL.
      RETURN.
    ENDIF.

 "LOW/HIGH are structural SAP range component names. Remove only that
 "terminal structural token before publishing FROM/TO, avoiding names such
 "as *_LOW_FROM or *_HIGH_TO without inventing business meaning.
    IF lv_base CP '*_LOW'.
      lv_base_len = strlen( lv_base ) - 4.
      IF lv_base_len > 0.
        lv_base = lv_base(lv_base_len).
      ENDIF.
    ELSEIF lv_base CP '*_HIGH'.
      lv_base_len = strlen( lv_base ) - 5.
      IF lv_base_len > 0.
        lv_base = lv_base(lv_base_len).
      ENDIF.
    ENDIF.

    CLEAR lv_out.
    IF lv_leaf = 'LOW'.
      IF lv_base CP '*_FROM'.
        cv_source = lv_base.
      ELSE.
        lv_out = lv_base && '_FROM'.
      ENDIF.
    ELSE.
      IF lv_base CP '*_TO'.
        cv_source = lv_base.
      ELSE.
        lv_out = lv_base && '_TO'.
      ENDIF.
    ENDIF.

    IF cv_source IS INITIAL.
      PERFORM normalize_mapping_source
        USING    lv_out
        CHANGING cv_source.
    ENDIF.
    IF cv_source IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
    RETURN.
  ENDLOOP.
ENDFORM.

FORM shape_auto_source
  USING    pt_script TYPE ty_t_script
           iv_source TYPE any
           iv_bdc    TYPE any
           iv_origin TYPE any
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column.

  DATA: ls_script TYPE ty_script_def_compat,
        lv_input_source TYPE string,
        lv_input_bdc    TYPE string,
        lv_source TYPE zbdc_mapping_bup-source_column,
        lv_origin TYPE string,
        lv_target TYPE zbdc_mapping_bup-bdc_field,
        lv_key    TYPE zbdc_mapping_bup-bdc_field,
        lv_norm   TYPE zbdc_mapping_bup-bdc_field,
        lv_indexed TYPE abap_bool,
        lv_out    TYPE string,
        lv_screen_source TYPE zbdc_mapping_bup-source_column,
        lv_ddic_source   TYPE zbdc_mapping_bup-source_column,
        lv_ddic_tech     TYPE abap_bool,
        lv_range_source  TYPE zbdc_mapping_bup-source_column,
        lv_range_found   TYPE abap_bool,
        lv_z665_raw      TYPE char80,
        lv_z665_hit      TYPE abap_bool.

 "alias safety: Z447 schema fingerprint and Z334 Mapping builder call
 "this FORM as USING lv_source ... CHANGING lv_source. Copy all scalar
 "inputs first so CLEAR CV_SOURCE cannot erase IV_SOURCE by reference.
  lv_input_source = iv_source.
  lv_input_bdc    = iv_bdc.
  lv_origin       = iv_origin.
  CLEAR cv_source.
  TRANSLATE lv_origin TO UPPER CASE.
  CONDENSE lv_origin NO-GAPS.

 "Generated SHDB programs may define explicit RECORD-* business headers.
 "Preserve that source authority rather than renaming it automatically.
  IF lv_origin = 'SHDB_PROGRAM'.
    PERFORM normalize_mapping_source
      USING    lv_input_source
      CHANGING cv_source.
    RETURN.
  ENDIF.

 "naming authority: use literal SAP screen text only when it is
 "resolved from the exact captured dynpro/table-control in SY-LANGU. This
 "keeps the generated Template header aligned with what the user actually
 "sees. Exact SAP Technical Field remains the replay binding. If no exact
 "screen caption exists, fall back to DDIC/technical metadata without guess.
  IF lv_origin = 'GUIDED_RECORD' OR lv_origin = 'SHDB_TXT'.
    CLEAR: lv_z665_raw, lv_z665_hit, lv_screen_source.
    PERFORM screen_label_from_dynpro_ctx
      USING    pt_script lv_input_bdc
      CHANGING lv_z665_raw lv_z665_hit.
    IF lv_z665_hit = abap_true AND lv_z665_raw IS NOT INITIAL.
      PERFORM normalize_mapping_source
        USING    lv_z665_raw
        CHANGING lv_screen_source.
      IF lv_screen_source IS NOT INITIAL.
        lv_input_source = lv_screen_source.
      ENDIF.
    ENDIF.

    IF lv_screen_source IS INITIAL.
      CLEAR: lv_ddic_source, lv_ddic_tech.
      PERFORM source_from_bdc
        USING    lv_input_bdc
        CHANGING lv_ddic_source.
      IF lv_ddic_source IS NOT INITIAL.
        lv_input_source = lv_ddic_source.
      ENDIF.
    ENDIF.
  ENDIF.

  PERFORM canon_auto_source
    USING    lv_input_source
    CHANGING lv_source.
  IF lv_source IS INITIAL.
    RETURN.
  ENDIF.

 "when the exact capture contains a LOW/HIGH pair, expose the pair as
 "FROM/TO in the Template. This is not a business guess; the counterpart is
 "required to be physically present in the same recording/import.
  CLEAR: lv_range_source, lv_range_found.
  PERFORM range_source
    USING    pt_script lv_input_bdc lv_source
    CHANGING lv_range_source lv_range_found.
  IF lv_range_found = abap_true AND lv_range_source IS NOT INITIAL.
    lv_source = lv_range_source.
  ENDIF.

 "Cardinality is resolved over the whole logical field, not the first
 "physical occurrence. Therefore FIELD(01) in a one-row recording and
 "FIELD(01)/(02)/... in a multi-row recording publish the same header.
  PERFORM logical_bdc_key
    USING    lv_input_bdc
    CHANGING lv_target.
  IF lv_target IS NOT INITIAL.
    LOOP AT pt_script INTO ls_script
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.
      CLEAR: lv_key, lv_norm.
      PERFORM logical_bdc_key
        USING    ls_script-field_name
        CHANGING lv_key.
      IF lv_key <> lv_target.
        CONTINUE.
      ENDIF.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-field_name
        CHANGING lv_norm.
      IF lv_norm CS '(*)'.
        lv_indexed = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.
  ENDIF.

  IF lv_indexed = abap_true AND lv_source NP 'ITEM_*'.
    lv_out = |ITEM_{ lv_source }|.
    PERFORM normalize_mapping_source
      USING    lv_out
      CHANGING lv_source.
  ENDIF.

  cv_source = lv_source.
ENDFORM.

FORM source_from_bdc
  USING    iv_bdc    TYPE any
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column.

  DATA: lv_bdc         TYPE zbdc_mapping_bup-bdc_field,
        lv_ddic_source TYPE zbdc_mapping_bup-source_column,
        lv_leaf_source TYPE zbdc_mapping_bup-source_column,
        lv_ddic_found  TYPE abap_bool,
        lv_technical   TYPE abap_bool,
        lv_text        TYPE string.

  CLEAR cv_source.
  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc
    CHANGING lv_bdc.
  IF lv_bdc IS INITIAL.
    RETURN.
  ENDIF.

 "a raw SAP component name is not an end-user Template Field Name.
 "Resolve a semantic alias generically from DDIC field labels first. This
 "uses only captured BDC identity + DDIC metadata; no TCODE/table/field
 "business name is hardcoded. Existing trusted aliases are preserved by
 "rebind_map_sources and therefore are not overwritten here.
  CLEAR: lv_ddic_source, lv_ddic_found, lv_technical.
  PERFORM derive_ddic_source_column
    USING    lv_bdc
    CHANGING lv_ddic_source lv_ddic_found.
  IF lv_ddic_found = abap_true AND lv_ddic_source IS NOT INITIAL.
    PERFORM mapping_source_is_technical
      USING    lv_ddic_source lv_bdc
      CHANGING lv_technical.
    IF lv_technical <> abap_true.
      PERFORM canon_auto_source
        USING    lv_ddic_source
        CHANGING cv_source.
      RETURN.
    ENDIF.
  ENDIF.

 "Fallback 1: a long/semantic DDIC component can itself be acceptable.
 "Short raw SAP component codes remain technical and do not win.
  CLEAR: lv_leaf_source, lv_technical.
  PERFORM get_mapping_leaf_source
    USING    lv_bdc
    CHANGING lv_leaf_source.
  PERFORM mapping_source_is_technical
    USING    lv_leaf_source lv_bdc
    CHANGING lv_technical.
  IF lv_leaf_source IS NOT INITIAL AND lv_technical <> abap_true.
    cv_source = lv_leaf_source.
    RETURN.
  ENDIF.

 "Fallback 2: no semantic DDIC text exists. Keep a deterministic full SAP
 "identity rather than inventing business meaning or exposing a blank alias.
  lv_text = lv_bdc.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_text WITH ''.
  REPLACE ALL OCCURRENCES OF '-'   IN lv_text WITH '_'.
  REPLACE ALL OCCURRENCES OF '.'   IN lv_text WITH '_'.
  REPLACE ALL OCCURRENCES OF '/'   IN lv_text WITH '_'.
  REPLACE ALL OCCURRENCES OF '('   IN lv_text WITH '_'.
  REPLACE ALL OCCURRENCES OF ')'   IN lv_text WITH ''.
  REPLACE ALL OCCURRENCES OF '*'   IN lv_text WITH '_'.
  PERFORM normalize_mapping_source
    USING    lv_text
    CHANGING cv_source.
ENDFORM.

FORM rebind_map_sources
  CHANGING ct_map TYPE ty_t_mapping_db.

  DATA: lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_replacement TYPE zbdc_mapping_bup-source_column,
        lv_leaf_source TYPE zbdc_mapping_bup-source_column,
        lv_full_source TYPE zbdc_mapping_bup-source_column,
        lv_cert_source TYPE zbdc_mapping_bup-source_column,
        lv_cert_found  TYPE abap_bool,
        lv_technical   TYPE abap_bool,
        lv_text        TYPE string.

  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
               WITH UNIQUE KEY table_line.

  FIELD-SYMBOLS <ls_map> TYPE zbdc_mapping_bup.

 "one generic alias gate for Import, Start Recording, Field Guide
 "locking and Generate Template. Preserve maintained semantic aliases. Replace
 "only blank/internal/raw-technical aliases using DDIC field text.
  LOOP AT ct_map ASSIGNING <ls_map>.
    IF <ls_map>-bdc_field IS INITIAL.
      IF <ls_map>-source_column IS NOT INITIAL.
        CLEAR lv_source.
        PERFORM normalize_mapping_source
          USING    <ls_map>-source_column
          CHANGING lv_source.
        IF lv_source IS NOT INITIAL.
          <ls_map>-source_column = lv_source.
          INSERT lv_source INTO TABLE lt_seen.
        ENDIF.
      ENDIF.
      CONTINUE.
    ENDIF.

    CLEAR: lv_source, lv_replacement, lv_leaf_source, lv_full_source,
           lv_cert_source, lv_cert_found, lv_technical, lv_text.

 "An exact action/name certificate is the presentation authority for an
 "already confirmed Import/Guided contract. Restore it before any legacy
 "DDIC/technical alias repair so history never reintroduces RV45A_* names.
    PERFORM confirmed_name
      USING    <ls_map>-bdc_field
      CHANGING lv_cert_source lv_cert_found.
    IF lv_cert_found = abap_true AND lv_cert_source IS NOT INITIAL.
      <ls_map>-source_column = lv_cert_source.
      INSERT lv_cert_source INTO TABLE lt_seen.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_source
      USING    <ls_map>-source_column
      CHANGING lv_source.

 "Recognize historical/raw technical identities generically. A previous
 "version may have stored either the leaf component or STRUCTURE_FIELD.
 "Both should be upgraded to the DDIC semantic label when one exists.
    PERFORM get_mapping_leaf_source
      USING    <ls_map>-bdc_field
      CHANGING lv_leaf_source.
    lv_text = <ls_map>-bdc_field.
    REPLACE ALL OCCURRENCES OF '(*)' IN lv_text WITH ''.
    REPLACE ALL OCCURRENCES OF '-'   IN lv_text WITH '_'.
    REPLACE ALL OCCURRENCES OF '.'   IN lv_text WITH '_'.
    REPLACE ALL OCCURRENCES OF '/'   IN lv_text WITH '_'.
    REPLACE ALL OCCURRENCES OF '('   IN lv_text WITH '_'.
    REPLACE ALL OCCURRENCES OF ')'   IN lv_text WITH ''.
    REPLACE ALL OCCURRENCES OF '*'   IN lv_text WITH '_'.
    PERFORM normalize_mapping_source
      USING    lv_text
      CHANGING lv_full_source.

    IF lv_source IS NOT INITIAL AND lv_source NP 'INPUT_*'.
      PERFORM mapping_source_is_technical
        USING    lv_source <ls_map>-bdc_field
        CHANGING lv_technical.
      IF lv_source = lv_leaf_source OR lv_source = lv_full_source.
        lv_technical = abap_true.
      ENDIF.
    ELSE.
      lv_technical = abap_true.
    ENDIF.

    IF lv_source IS INITIAL
       OR lv_source CP 'INPUT_*'
       OR lv_technical = abap_true.
      PERFORM source_from_bdc
        USING    <ls_map>-bdc_field
        CHANGING lv_replacement.
      IF lv_replacement IS NOT INITIAL.
        lv_source = lv_replacement.
      ENDIF.
    ENDIF.

    IF lv_source IS INITIAL.
      CONTINUE.
    ENDIF.

 "If two DDIC labels normalize to the same header, do not drop either field
 "and do not invent meaning. Use the generic full SAP identity for the later
 "collision so the mapping/template remains lossless and deterministic.
    READ TABLE lt_seen
      WITH TABLE KEY table_line = lv_source
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      IF lv_full_source IS NOT INITIAL.
        lv_source = lv_full_source.
      ENDIF.
    ENDIF.

    <ls_map>-source_column = lv_source.
    INSERT lv_source INTO TABLE lt_seen.
  ENDLOOP.
ENDFORM.

FORM guided_rec_input_ok
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_ok     TYPE abap_bool
           cv_reason TYPE string.

  DATA: ls_script     TYPE ty_script_def_compat,
        lv_target     TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key TYPE zbdc_mapping_bup-bdc_field,
        lv_norm       TYPE zbdc_mapping_bup-bdc_field,
        lv_key        TYPE zbdc_mapping_bup-bdc_field,
        lv_technical  TYPE abap_bool,
        lv_replay_hit TYPE abap_bool,
        lv_selected   TYPE abap_bool.

  CLEAR: cv_ok, cv_reason.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target_key IS INITIAL.
    cv_reason = 'NO_LOGICAL_FIELD'.
    RETURN.
  ENDIF.

  "Universal BDC choreography can never become a Template input.
  CLEAR lv_technical.
  PERFORM mapping_field_is_technical
    USING    lv_target
    CHANGING lv_technical.
  IF lv_technical = abap_true.
    cv_reason = 'TECHNICAL_FIELD'.
    RETURN.
  ENDIF.

  "The final Guided set must still be replayable by the immutable SHDB script.
  "This is a technical-bind check only; it does not infer user intent.
  CLEAR lv_replay_hit.
  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    CLEAR: lv_norm, lv_key.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.

    IF lv_key = lv_target_key.
      lv_replay_hit = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF lv_replay_hit <> abap_true.
    cv_reason = 'NOT_IN_IMMUTABLE_SHDB_REPLAY'.
    RETURN.
  ENDIF.

  "After the deterministic CommandArray -> SHDB ledger has been certified,
  "GT_Z659_USER_ACTIONS is the sole membership authority for Guided Mapping.
  "Do NOT re-filter those exact proven actions through recorder FIELD_VALS:
  "FIELD_VALS is recorder/input-capability context and can be incomplete for
  "composite controls, while the action ledger already proved exact TECH,
  "USER_VALUE, PROGRAM/DYNPRO and replay binding one-to-one before OpenAI naming.
  IF gv_z659_action_ready <> abap_true.
    cv_reason = 'USER_ACTION_CERT_MISSING'.
    RETURN.
  ENDIF.

  CLEAR lv_selected.
  PERFORM action_selected
    USING    lv_target
    CHANGING lv_selected.

  IF lv_selected = abap_true.
    cv_ok = abap_true.
    cv_reason = 'CONFIRMED_COMMANDARRAY_ACTION'.
  ELSE.
    cv_reason = 'CONFIRMED_REPLAY_STATE'.
  ENDIF.
ENDFORM.

*& Coherent repeating business-input evidence

*& Plain SHDB TXT has no USER_TYPED flag. A field in another subscreen must
*& therefore not become a Template column merely because the dynpro has a
*& cursor elsewhere. One additional generic proof is safe enough to bridge
*& real multi-item entry without reopening whole-dynpro broadening:
*& the concrete dynpro occurrence has a real nontechnical user cursor;
*& the candidate belongs to an indexed FIELD(nn) group;
*& at least two physical row indices exist;
*& at least two distinct nontechnical/nonhelper logical fields exist per row;
*& two row indices carry the exact same logical-field signature;
*& the group is seen on the first occurrence of that concrete dynpro.

*& This distinguishes repeating business rows from one-logical-field indexed
*& selection sets such as view/radio/checkbox lists. No TCODE, SAP table,
*& application field or business label is hardcoded.

FORM repeat_group_user_ev
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_ok     TYPE abap_bool
           cv_reason TYPE string.

  TYPES: ty_t_z552_key TYPE SORTED TABLE OF string
                       WITH UNIQUE KEY table_line,
         ty_t_z552_scr TYPE SORTED TABLE OF i
                       WITH UNIQUE KEY table_line,
         BEGIN OF ty_z552_pair,
           screen_no TYPE i,
           scope_key TYPE string,
           idx       TYPE string,
           logical_key TYPE zbdc_mapping_bup-bdc_field,
         END OF ty_z552_pair,
         ty_t_z552_pair TYPE STANDARD TABLE OF ty_z552_pair
                         WITH DEFAULT KEY,
         BEGIN OF ty_z552_sig,
           screen_no TYPE i,
           scope_key TYPE string,
           idx       TYPE string,
           field_cnt TYPE i,
           signature TYPE string,
         END OF ty_z552_sig,
         ty_t_z552_sig TYPE STANDARD TABLE OF ty_z552_sig
                        WITH DEFAULT KEY.

  DATA: ls_script      TYPE ty_script_def_compat,
        ls_pair        TYPE ty_z552_pair,
        ls_sig         TYPE ty_z552_sig,
        ls_peer        TYPE ty_z552_sig,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_logical     TYPE zbdc_mapping_bup-bdc_field,
        lv_field_upper TYPE string,
        lv_cursor      TYPE zbdc_mapping_bup-bdc_field,
        lv_subscope    TYPE string,
        lv_scope       TYPE string,
        lv_dyn_key     TYPE string,
        lv_param       TYPE string,
        lv_idx         TYPE string,
        lv_indexed     TYPE abap_bool,
        lv_screen_no   TYPE i,
        lv_technical   TYPE abap_bool,
        lv_helper      TYPE abap_bool,
        lv_unsafe      TYPE abap_bool,
        lv_helper_msg  TYPE string,
        lv_target_here TYPE abap_bool.

  DATA: lt_pairs        TYPE ty_t_z552_pair,
        lt_sigs         TYPE ty_t_z552_sig,
        lt_user_screens TYPE ty_t_z552_scr,
        lt_first_scr    TYPE ty_t_z552_scr,
        lt_seen_dyn     TYPE ty_t_z552_key.

  FIELD-SYMBOLS <ls_sig> TYPE ty_z552_sig.

  CLEAR: cv_ok, cv_reason.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target_key IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_technical, lv_helper, lv_unsafe, lv_helper_msg.
  PERFORM mapping_field_is_technical
    USING    lv_target
    CHANGING lv_technical.
  IF lv_technical = abap_true.
    RETURN.
  ENDIF.
  PERFORM field_helper_role
    USING    pt_script lv_target
    CHANGING lv_helper lv_unsafe lv_helper_msg.
  IF lv_helper = abap_true.
    RETURN.
  ENDIF.

 "Pass 1: materialize indexed business rows and real interaction screens.
  CLEAR: lv_screen_no, lv_scope, lv_dyn_key.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_screen_no = lv_screen_no + 1.
      lv_scope = |{ lv_screen_no }#ROOT#{ ls_script-program_name }#{ ls_script-dynpro_no }|.
      lv_dyn_key = |{ ls_script-program_name }#{ ls_script-dynpro_no }|.
      READ TABLE lt_seen_dyn
        WITH TABLE KEY table_line = lv_dyn_key
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        INSERT lv_dyn_key INTO TABLE lt_seen_dyn.
        INSERT lv_screen_no INTO TABLE lt_first_scr.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_field_upper = ls_script-field_name.
    TRANSLATE lv_field_upper TO UPPER CASE.
    CONDENSE lv_field_upper NO-GAPS.

    IF lv_field_upper = 'BDC_SUBSCR'.
      lv_subscope = ls_script-static_value.
      CONDENSE lv_subscope.
      IF lv_subscope IS INITIAL.
        lv_scope = |{ lv_screen_no }#ROOT|.
      ELSE.
        lv_scope = |{ lv_screen_no }#SUB#{ lv_subscope }|.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF lv_field_upper = 'BDC_CURSOR'.
      CLEAR: lv_cursor, lv_technical, lv_helper, lv_unsafe, lv_helper_msg.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-static_value
        CHANGING lv_cursor.
      IF lv_cursor IS INITIAL.
        CONTINUE.
      ENDIF.
      PERFORM mapping_field_is_technical
        USING    lv_cursor
        CHANGING lv_technical.
      IF lv_technical = abap_true.
        CONTINUE.
      ENDIF.
      PERFORM field_helper_role
        USING    pt_script lv_cursor
        CHANGING lv_helper lv_unsafe lv_helper_msg.
      IF lv_helper <> abap_true.
        INSERT lv_screen_no INTO TABLE lt_user_screens.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF lv_field_upper = 'BDC_OKCODE'
       OR ls_script-static_value IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_norm, lv_logical, lv_param, lv_idx, lv_indexed,
           lv_technical, lv_helper, lv_unsafe, lv_helper_msg.
    PERFORM param_script_field_idx
      USING    ls_script-field_name
      CHANGING lv_param lv_idx lv_indexed.
    IF lv_indexed <> abap_true
       OR lv_idx IS INITIAL
       OR lv_idx = gc_ph_index
       OR lv_idx = '*'
       OR lv_idx CN '0123456789'.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    lv_param
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    lv_norm
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM field_helper_role
      USING    pt_script lv_norm
      CHANGING lv_helper lv_unsafe lv_helper_msg.
    IF lv_helper = abap_true.
      CONTINUE.
    ENDIF.

    IF lv_scope IS INITIAL.
      lv_scope = |{ lv_screen_no }#ROOT|.
    ENDIF.

    CLEAR ls_pair.
    ls_pair-screen_no = lv_screen_no.
    ls_pair-scope_key = lv_scope.
    ls_pair-idx       = lv_idx.
    ls_pair-logical_key = lv_logical.
    APPEND ls_pair TO lt_pairs.
  ENDLOOP.

  SORT lt_pairs BY screen_no scope_key idx logical_key.
  DELETE ADJACENT DUPLICATES FROM lt_pairs
    COMPARING screen_no scope_key idx logical_key.

  IF lt_pairs IS INITIAL.
    RETURN.
  ENDIF.

 "Pass 2: build a deterministic logical-field signature per physical row.
  LOOP AT lt_pairs INTO ls_pair.
    UNASSIGN <ls_sig>.
    READ TABLE lt_sigs ASSIGNING <ls_sig>
      WITH KEY screen_no = ls_pair-screen_no
               scope_key = ls_pair-scope_key
               idx       = ls_pair-idx.
    IF sy-subrc <> 0.
      CLEAR ls_sig.
      ls_sig-screen_no = ls_pair-screen_no.
      ls_sig-scope_key = ls_pair-scope_key.
      ls_sig-idx       = ls_pair-idx.
      APPEND ls_sig TO lt_sigs.
      READ TABLE lt_sigs ASSIGNING <ls_sig>
        WITH KEY screen_no = ls_pair-screen_no
                 scope_key = ls_pair-scope_key
                 idx       = ls_pair-idx.
    ENDIF.
    IF <ls_sig> IS ASSIGNED.
      <ls_sig>-field_cnt = <ls_sig>-field_cnt + 1.
      CONCATENATE <ls_sig>-signature '|' ls_pair-logical_key
        INTO <ls_sig>-signature.
    ENDIF.
  ENDLOOP.

 "Pass 3: require two rows with the same multi-field signature. The fallback
 "is allowed only on the first occurrence of an actually interacted dynpro.
  LOOP AT lt_sigs INTO ls_sig WHERE field_cnt >= 2.
    READ TABLE lt_user_screens
      WITH TABLE KEY table_line = ls_sig-screen_no
      TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.
    READ TABLE lt_first_scr
      WITH TABLE KEY table_line = ls_sig-screen_no
      TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    LOOP AT lt_sigs INTO ls_peer
      WHERE screen_no = ls_sig-screen_no
        AND scope_key = ls_sig-scope_key
        AND field_cnt >= 2.
      IF ls_peer-idx = ls_sig-idx
         OR ls_peer-signature <> ls_sig-signature.
        CONTINUE.
      ENDIF.

      CLEAR lv_target_here.
      LOOP AT lt_pairs INTO ls_pair
        WHERE screen_no = ls_sig-screen_no
          AND scope_key = ls_sig-scope_key
          AND idx       = ls_sig-idx
          AND logical_key = lv_target_key.
        lv_target_here = abap_true.
        EXIT.
      ENDLOOP.
      IF lv_target_here = abap_true.
        cv_ok = abap_true.
        cv_reason = 'USER_REPEAT_GROUP_FIRST_PAI'.
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDLOOP.
ENDFORM.

*& Evidence-role multi-TCODE projection authority (Phase 1)

*& Plain SHDB/BDCDATA has no USER_TYPED flag. Therefore the authority must
*& preserve uncertainty instead of forcing every captured field into YES/NO.

*& Roles returned here:
*& DYNAMIC_PROVEN - positive interaction/structural evidence survived all
*& independent negative-evidence checks;
*& AMBIGUOUS - recorded business-looking value exists but the current
*& single recording does not prove it is user supplied;
*& REPLAY_ONLY - true technical choreography or no capturable value.

*& DDIC remains metadata-only (labels/types/rules). Eligibility is derived
*& only from recording interaction evidence; no TCODE/table/field is hardcoded.

*& Logical-field occurrence / direct-cursor evidence statistics

FORM field_ev_stats
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_occurrences TYPE i
           cv_distinct    TYPE i
           cv_exact_cursor TYPE abap_bool
           cv_first_value TYPE string.

  TYPES ty_t_z557_values TYPE SORTED TABLE OF string
                         WITH UNIQUE KEY table_line.

  DATA: ls_script     TYPE ty_script_def_compat,
        lv_target     TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key TYPE zbdc_mapping_bup-bdc_field,
        lv_norm       TYPE zbdc_mapping_bup-bdc_field,
        lv_key        TYPE zbdc_mapping_bup-bdc_field,
        lv_upper      TYPE string,
        lv_value      TYPE string,
        lt_values     TYPE ty_t_z557_values.

  CLEAR: cv_occurrences, cv_distinct, cv_exact_cursor, cv_first_value.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target_key IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    lv_upper = ls_script-field_name.
    TRANSLATE lv_upper TO UPPER CASE.
    CONDENSE lv_upper NO-GAPS.

    IF lv_upper = 'BDC_CURSOR'.
      CLEAR: lv_norm, lv_key.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-static_value
        CHANGING lv_norm.
      PERFORM logical_bdc_key
        USING    lv_norm
        CHANGING lv_key.
      IF lv_key = lv_target_key.
        cv_exact_cursor = abap_true.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-value_type = gc_m2_vt_ignore
       OR ls_script-static_value IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_norm, lv_key.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key <> lv_target_key.
      CONTINUE.
    ENDIF.

    lv_value = ls_script-static_value.
    SHIFT lv_value LEFT  DELETING LEADING space.
    SHIFT lv_value RIGHT DELETING TRAILING space.

    cv_occurrences = cv_occurrences + 1.
    IF cv_first_value IS INITIAL.
      cv_first_value = lv_value.
    ENDIF.
    INSERT lv_value INTO TABLE lt_values.
  ENDLOOP.

  DESCRIBE TABLE lt_values LINES cv_distinct.
ENDFORM.

*& Pre-existing constant baseline echo evidence

*& Negative evidence is allowed to reduce confidence only when the recording
*& itself proves a baseline existed before later user data appeared in the same
*& concrete dynpro/scope. This protects legitimate initial-valued parameters
*& that are already part of the first complete input cohort.

FORM baseline_echo_ev
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_echo   TYPE abap_bool.

  TYPES: BEGIN OF ty_z557_val,
           group_key TYPE string,
           screen_no TYPE i,
           field_key TYPE string,
           value     TYPE string,
         END OF ty_z557_val,
         ty_t_z557_val TYPE STANDARD TABLE OF ty_z557_val
                       WITH DEFAULT KEY,
         BEGIN OF ty_z557_cur,
           group_key TYPE string,
           screen_no TYPE i,
           field_key TYPE string,
         END OF ty_z557_cur,
         ty_t_z557_cur TYPE STANDARD TABLE OF ty_z557_cur
                       WITH DEFAULT KEY,
         ty_t_z557_key TYPE SORTED TABLE OF string
                       WITH UNIQUE KEY table_line,
         ty_t_z557_scr TYPE SORTED TABLE OF i
                       WITH UNIQUE KEY table_line.

  DATA: ls_script      TYPE ty_script_def_compat,
        ls_val         TYPE ty_z557_val,
        ls_scan        TYPE ty_z557_val,
        ls_cur         TYPE ty_z557_cur,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_key         TYPE zbdc_mapping_bup-bdc_field,
        lv_upper       TYPE string,
        lv_program     TYPE string,
        lv_dynpro      TYPE string,
        lv_scope       TYPE string,
        lv_subscope    TYPE string,
        lv_group       TYPE string,
        lv_screen_no   TYPE i,
        lv_base_screen TYPE i,
        lv_base_value  TYPE string,
        lv_same        TYPE abap_bool,
        lv_new_field   TYPE abap_bool,
        lv_cursor_key  TYPE string,
        lv_cursor_has_value TYPE abap_bool,
        lv_technical   TYPE abap_bool.

  DATA: lt_vals        TYPE ty_t_z557_val,
        lt_cursors     TYPE ty_t_z557_cur,
        lt_groups_seen TYPE ty_t_z557_key,
        lt_base_fields TYPE ty_t_z557_key,
        lt_target_scr  TYPE ty_t_z557_scr.

  CLEAR cv_echo.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target_key IS INITIAL.
    RETURN.
  ENDIF.

 "Collect value-bearing nontechnical rows and cursor ownership by the exact
 "concrete dynpro/scope. Cross-subscreen cursor evidence must never demote a
 "field in a different scope.
  CLEAR: lv_screen_no, lv_program, lv_dynpro, lv_scope, lv_group.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_screen_no = lv_screen_no + 1.
      lv_program = ls_script-program_name.
      lv_dynpro  = ls_script-dynpro_no.
      lv_scope   = 'ROOT'.
      lv_group   = |{ lv_program }#{ lv_dynpro }#ROOT|.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_upper = ls_script-field_name.
    TRANSLATE lv_upper TO UPPER CASE.
    CONDENSE lv_upper NO-GAPS.

    IF lv_upper = 'BDC_SUBSCR'.
      lv_subscope = ls_script-static_value.
      CONDENSE lv_subscope.
      IF lv_subscope IS INITIAL.
        lv_scope = 'ROOT'.
      ELSE.
        lv_scope = lv_subscope.
      ENDIF.
      lv_group = |{ lv_program }#{ lv_dynpro }#{ lv_scope }|.
      CONTINUE.
    ENDIF.

    IF lv_upper = 'BDC_CURSOR'.
      CLEAR: lv_norm, lv_key, lv_technical.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-static_value
        CHANGING lv_norm.
      PERFORM mapping_field_is_technical
        USING    lv_norm
        CHANGING lv_technical.
      IF lv_technical = abap_true.
        CONTINUE.
      ENDIF.
      PERFORM logical_bdc_key
        USING    lv_norm
        CHANGING lv_key.
      IF lv_key IS INITIAL.
        CONTINUE.
      ENDIF.
      CLEAR ls_cur.
      ls_cur-group_key = lv_group.
      ls_cur-screen_no = lv_screen_no.
      ls_cur-field_key = lv_key.
      APPEND ls_cur TO lt_cursors.
      CONTINUE.
    ENDIF.

    IF lv_upper = 'BDC_OKCODE'
       OR ls_script-static_value IS INITIAL
       OR ls_script-value_type = gc_m2_vt_ignore.
      CONTINUE.
    ENDIF.

    CLEAR: lv_norm, lv_key, lv_technical.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM mapping_field_is_technical
      USING    lv_norm
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_val.
    ls_val-group_key = lv_group.
    ls_val-screen_no = lv_screen_no.
    ls_val-field_key = lv_key.
    ls_val-value     = ls_script-static_value.
    APPEND ls_val TO lt_vals.
  ENDLOOP.

 "Demotion requires a very specific timeline:
 " - target repeats unchanged on >=2 occurrences of one dynpro/scope;
 " - on the baseline occurrence, that SAME scope owns a cursor;
 " - the cursor target has no captured value yet on that occurrence;
 " - a later occurrence introduces a new value-bearing logical field.
 "This recognizes a pre-existing submitted baseline without treating every
 "constant or every popup field as SAP default.
  LOOP AT lt_vals INTO ls_val
    WHERE field_key = lv_target_key.

    READ TABLE lt_groups_seen
      WITH TABLE KEY table_line = ls_val-group_key
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT ls_val-group_key INTO TABLE lt_groups_seen.

    lv_group = ls_val-group_key.
    CLEAR: lv_base_screen, lv_base_value, lv_same, lv_new_field,
           lv_cursor_key, lv_cursor_has_value.
    REFRESH: lt_target_scr, lt_base_fields.
    lv_same = abap_true.

    LOOP AT lt_vals INTO ls_scan
      WHERE group_key = lv_group
        AND field_key = lv_target_key.
      INSERT ls_scan-screen_no INTO TABLE lt_target_scr.
      IF lv_base_screen IS INITIAL OR ls_scan-screen_no < lv_base_screen.
        lv_base_screen = ls_scan-screen_no.
        lv_base_value  = ls_scan-value.
      ENDIF.
    ENDLOOP.

    DATA(lv_z557_scr_count) = 0.
    DESCRIBE TABLE lt_target_scr LINES lv_z557_scr_count.
    IF lv_z557_scr_count < 2 OR lv_base_screen IS INITIAL.
      CONTINUE.
    ENDIF.

    LOOP AT lt_vals INTO ls_scan
      WHERE group_key = lv_group
        AND field_key = lv_target_key.
      IF ls_scan-value <> lv_base_value.
        CLEAR lv_same.
        EXIT.
      ENDIF.
    ENDLOOP.
    IF lv_same <> abap_true.
      CONTINUE.
    ENDIF.

    LOOP AT lt_vals INTO ls_scan
      WHERE group_key = lv_group
        AND screen_no = lv_base_screen.
      INSERT ls_scan-field_key INTO TABLE lt_base_fields.
    ENDLOOP.

 "Cursor must belong to this exact scope, not merely the same dynpro.
    READ TABLE lt_cursors INTO ls_cur
      WITH KEY group_key = lv_group
               screen_no = lv_base_screen.
    IF sy-subrc <> 0 OR ls_cur-field_key IS INITIAL.
      CONTINUE.
    ENDIF.
    lv_cursor_key = ls_cur-field_key.

    READ TABLE lt_base_fields
      WITH TABLE KEY table_line = lv_cursor_key
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      lv_cursor_has_value = abap_true.
    ENDIF.
    IF lv_cursor_has_value = abap_true.
      CONTINUE.
    ENDIF.

    LOOP AT lt_vals INTO ls_scan
      WHERE group_key = lv_group
        AND screen_no > lv_base_screen.
      READ TABLE lt_base_fields
        WITH TABLE KEY table_line = ls_scan-field_key
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        lv_new_field = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_new_field = abap_true.
      cv_echo = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Strong positive user-entry evidence, no TCODE/helper veto


FORM import_user_input_ok
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_ok     TYPE abap_bool
           cv_reason TYPE string.

  DATA: lv_ok     TYPE abap_bool,
        lv_reason TYPE string.

  CLEAR: cv_ok, cv_reason.

  "Plain SHDB TXT has no USER_CHANGED bit. For fresh Import, expose only
  "fields with direct exact user-interaction evidence. Do not let a stable
  "SAP replay/default field piggy-back on unrelated cursor scopes.
  CLEAR: lv_ok, lv_reason.
  PERFORM exact_pai_cursor_ev
    USING    pt_script iv_field
    CHANGING lv_ok lv_reason.
  IF lv_ok = abap_true.
    cv_ok = abap_true.
    cv_reason = lv_reason.
    RETURN.
  ENDIF.

  "Indexed multi-row input can contain valid peer columns even when one
  "physical row owns the cursor. Keep the existing coherent repeat proof.
  CLEAR: lv_ok, lv_reason.
  PERFORM repeat_group_user_ev
    USING    pt_script iv_field
    CHANGING lv_ok lv_reason.
  IF lv_ok = abap_true.
    cv_ok = abap_true.
    cv_reason = lv_reason.
    RETURN.
  ENDIF.

  cv_reason = 'IMPORT_REPLAY_STATE_NO_DIRECT_USER_EVIDENCE'.
ENDFORM.

FORM strong_user_ev
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_ok     TYPE abap_bool
           cv_reason TYPE string.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_logical     TYPE zbdc_mapping_bup-bdc_field,
        lv_technical   TYPE abap_bool,
        lv_has_value   TYPE abap_bool,
        lv_direct_ok   TYPE abap_bool,
        lv_direct_msg  TYPE string,
        lv_native_ok   TYPE abap_bool,
        lv_native_msg  TYPE string,
        lv_origin      TYPE c LENGTH 20.

  CLEAR: cv_ok, cv_reason.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target_key IS INITIAL.
    cv_reason = 'NO_LOGICAL_FIELD'.
    RETURN.
  ENDIF.

  CLEAR lv_technical.
  PERFORM mapping_field_is_technical
    USING    lv_target
    CHANGING lv_technical.
  IF lv_technical = abap_true.
    cv_reason = 'TECHNICAL_FIELD'.
    RETURN.
  ENDIF.

 "A literal recorded value proves replay data exists, but not who supplied
 "it. Verify that this logical field actually carries a non-empty capture;
 "then delegate user-entry proof to the strict authority Z376.
  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    IF ls_script-value_type = gc_m2_vt_ignore
       OR ls_script-static_value IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_norm, lv_logical.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_logical.
    IF lv_logical = lv_target_key.
      lv_has_value = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF lv_has_value <> abap_true.
    cv_reason = 'NO_FILLED_CAPTURE_EVIDENCE'.
    RETURN.
  ENDIF.

 "Guided Start Recording no longer guesses USER action from cursor,
 "repeat counts or cross-scope echoes. Use the FIELD_VALS captured at the
 "SBDR recorder boundary. If native provenance exists, it is authoritative
 "and fail-closed for this field; heuristic evidence is not allowed to
 "override it.
  PERFORM get_projection_origin CHANGING lv_origin.

  IF lv_origin = 'GUIDED_RECORD'.
    IF gt_z360_rec_field_vals IS INITIAL.
      cv_reason = 'RECORDER_NATIVE_PROVENANCE_MISSING'.
      RETURN.
    ENDIF.

    CLEAR: lv_native_ok, lv_native_msg.
    PERFORM guided_rec_input_ok
      USING    pt_script lv_target
      CHANGING lv_native_ok lv_native_msg.
    IF lv_native_ok = abap_true.
      cv_ok = abap_true.
      cv_reason = lv_native_msg.
      IF cv_reason IS INITIAL.
        cv_reason = 'RECORDER_NATIVE_INPUT_FIELD'.
      ENDIF.
    ELSE.
      cv_reason = lv_native_msg.
      IF cv_reason IS INITIAL.
        cv_reason = 'NOT_RECORDER_NATIVE_INPUT'.
      ENDIF.
    ENDIF.
    RETURN.
  ENDIF.

  CLEAR: lv_direct_ok, lv_direct_msg.
  PERFORM user_interaction_ev_ok
    USING    pt_script lv_target
    CHANGING lv_direct_ok lv_direct_msg.
  IF lv_direct_ok = abap_true.
    cv_ok = abap_true.
    cv_reason = lv_direct_msg.
    IF cv_reason IS INITIAL.
      cv_reason = 'DIRECT_OR_STRUCTURAL_USER_EVIDENCE'.
    ENDIF.
    RETURN.
  ENDIF.

 "do not promote same-scope peers, first-PAI singleton fields, or
 "late-bound repeated fields. SAP commonly submits defaults/derived values
 "through exactly those patterns. They remain replay state, not user data.
  IF lv_direct_msg IS NOT INITIAL.
    cv_reason = lv_direct_msg.
  ELSE.
    cv_reason = 'RECORDED_VALUE_WITHOUT_EXACT_USER_EVIDENCE'.
  ENDIF.
ENDFORM.

*& Final three-state projection role

*& Exact user-action certification

*& SAP SHDB TXT/BDCDATA and recorder FIELD_VALS contain replay values and
*& input-capability metadata, but no generic USER_TYPED/USER_CHANGED bit.
*& Therefore automatic inference can never distinguish every user edit from
*& every SAP default/derived/carry value. makes that uncertainty
*& explicit: one confirmation list is built from the exact current capture,
*& exact visible names are shown, cursor evidence is diagnostics only,
*& and the user's confirmation becomes the sole Mapping membership authority.
*& The raw script is never changed by this confirmation; unselected rows stay
*& STATIC and continue to replay exactly as recorded.

FORM load_action_cert
  USING    iv_script_id TYPE zbdc_script_bup-script_id
           iv_hash      TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ok        TYPE abap_bool.

  DATA: lv_ver   TYPE zbdc_config_bup-config_value,
        lv_hash  TYPE zbdc_config_bup-config_value,
        lv_count TYPE zbdc_config_bup-config_value,
        lv_value TYPE zbdc_config_bup-config_value,
        lv_kind  TYPE c LENGTH 7,
        lv_idx   TYPE n LENGTH 4,
        lv_n     TYPE i,
        lv_field TYPE zbdc_mapping_bup-bdc_field,
        lv_name_value TYPE zbdc_config_bup-config_value,
        lv_name_kind  TYPE c LENGTH 7,
        ls_name       TYPE ty_z684_name_cert,
        lv_loaded_actions TYPE i,
        lv_loaded_names   TYPE i.

  CLEAR cv_ok.
  REFRESH: gt_z659_user_actions, gt_z684_names.
  CLEAR: gv_z659_action_script, gv_z659_action_hash,
         gv_z659_action_ready, gv_z684_name_script,
         gv_z684_name_hash, gv_z684_name_ready.

  IF iv_script_id IS INITIAL OR iv_hash IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'ACTV'
    CHANGING lv_ver.
  CONDENSE lv_ver NO-GAPS.
  IF lv_ver <> 'A36'.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'ACTH'
    CHANGING lv_hash.
  CONDENSE lv_hash NO-GAPS.
  IF lv_hash IS INITIAL OR lv_hash <> iv_hash.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'ACTN'
    CHANGING lv_count.
  CONDENSE lv_count NO-GAPS.
  IF lv_count IS INITIAL OR lv_count CN '0123456789'.
    RETURN.
  ENDIF.

  lv_n = lv_count.
  DO lv_n TIMES.
    lv_idx = sy-index.
    CONCATENATE 'ACT' lv_idx INTO lv_kind.
    CLEAR: lv_value, lv_field.
    PERFORM get_script_cfg
      USING    iv_script_id lv_kind
      CHANGING lv_value.
    IF lv_value IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    lv_value
      CHANGING lv_field.
    IF lv_field IS NOT INITIAL.
      INSERT lv_field INTO TABLE gt_z659_user_actions.

      CONCATENATE 'ANM' lv_idx INTO lv_name_kind.
      CLEAR: lv_name_value, ls_name.
      PERFORM get_script_cfg
        USING    iv_script_id lv_name_kind
        CHANGING lv_name_value.
      IF lv_name_value IS INITIAL.
        REFRESH: gt_z659_user_actions, gt_z684_names.
        RETURN.
      ENDIF.
      ls_name-logical_key = lv_field.
      ls_name-source_name = lv_name_value.
      PERFORM normalize_mapping_source
        USING    ls_name-source_name
        CHANGING ls_name-source_name.
      IF ls_name-source_name IS INITIAL.
        REFRESH: gt_z659_user_actions, gt_z684_names.
        RETURN.
      ENDIF.
      INSERT ls_name INTO TABLE gt_z684_names.
    ENDIF.
  ENDDO.

 "certificate integrity: ACTN is the exact cardinality of the
 "confirmed logical set. Missing/blank/duplicate ACT or ANM rows must never
 "silently collapse to a smaller set and still become authority.
  DESCRIBE TABLE gt_z659_user_actions LINES lv_loaded_actions.
  DESCRIBE TABLE gt_z684_names LINES lv_loaded_names.
  IF lv_loaded_actions <> lv_n OR lv_loaded_names <> lv_n.
    REFRESH: gt_z659_user_actions, gt_z684_names.
    RETURN.
  ENDIF.

  gv_z659_action_script = iv_script_id.
  gv_z659_action_hash   = iv_hash.
  gv_z659_action_ready  = abap_true.
  gv_z684_name_script   = iv_script_id.
  gv_z684_name_hash     = iv_hash.
  gv_z684_name_ready    = abap_true.
  cv_ok = abap_true.
ENDFORM.

*& Restore historical field-selection certificates without asking the user again
*& A35 already contains the exact logical checkbox set. A36 keeps that exact
*& membership and recomputes only the presentation names from current exact
*& SAP screen/DDIC metadata. The selection belongs to Script/Hash, not user.

FORM load_action_members_a35
  USING    iv_script_id TYPE zbdc_script_bup-script_id
           iv_hash      TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ok        TYPE abap_bool.

  DATA: lv_ver    TYPE zbdc_config_bup-config_value,
        lv_hash   TYPE zbdc_config_bup-config_value,
        lv_count  TYPE zbdc_config_bup-config_value,
        lv_value  TYPE zbdc_config_bup-config_value,
        lv_kind   TYPE c LENGTH 7,
        lv_idx    TYPE n LENGTH 4,
        lv_n      TYPE i,
        lv_loaded TYPE i,
        lv_field  TYPE zbdc_mapping_bup-bdc_field.

  CLEAR cv_ok.
  REFRESH: gt_z659_user_actions, gt_z684_names.
  CLEAR: gv_z659_action_script, gv_z659_action_hash,
         gv_z659_action_ready, gv_z684_name_script,
         gv_z684_name_hash, gv_z684_name_ready.

  IF iv_script_id IS INITIAL OR iv_hash IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'ACTV'
    CHANGING lv_ver.
  CONDENSE lv_ver NO-GAPS.
  IF lv_ver <> 'A35'.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'ACTH'
    CHANGING lv_hash.
  CONDENSE lv_hash NO-GAPS.
  IF lv_hash IS INITIAL OR lv_hash <> iv_hash.
    RETURN.
  ENDIF.

  PERFORM get_script_cfg
    USING    iv_script_id 'ACTN'
    CHANGING lv_count.
  CONDENSE lv_count NO-GAPS.
  IF lv_count IS INITIAL OR lv_count CN '0123456789'.
    RETURN.
  ENDIF.

  lv_n = lv_count.
  IF lv_n <= 0.
    RETURN.
  ENDIF.

  DO lv_n TIMES.
    lv_idx = sy-index.
    CONCATENATE 'ACT' lv_idx INTO lv_kind.
    CLEAR: lv_value, lv_field.
    PERFORM get_script_cfg
      USING    iv_script_id lv_kind
      CHANGING lv_value.
    IF lv_value IS INITIAL.
      REFRESH gt_z659_user_actions.
      RETURN.
    ENDIF.
    PERFORM logical_bdc_key
      USING    lv_value
      CHANGING lv_field.
    IF lv_field IS INITIAL.
      REFRESH gt_z659_user_actions.
      RETURN.
    ENDIF.
    INSERT lv_field INTO TABLE gt_z659_user_actions.
  ENDDO.

  DESCRIBE TABLE gt_z659_user_actions LINES lv_loaded.
  IF lv_loaded <> lv_n.
    REFRESH gt_z659_user_actions.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

*& Restore historical Template selection from exact persisted Mapping repository
*&
*& A contract that has already been mapped/generated can predate the A35/A36
*& selection certificate. In that case the exact versioned ZBDC_MAPPING_BUP rows
*& are the strongest persisted selection evidence: SOURCE_COLUMN is the emitted
*& Template name, BDC_FIELD is the replay binding, and STAGING_FIELD is the
*& versioned generic slot. This is contract data, not a fresh inference.
*&
*& No TCODE or SAP business field is hardcoded. The restore is accepted only
*& when every persisted Mapping row binds back to the immutable Script and all
*& friendly names/logical identities remain one-to-one. The result is migrated
*& once into A36 so later My Import / All Import loads do not recompute it.

FORM restore_map_repo_cert
  USING    pt_script    TYPE ty_t_script
           iv_script_id TYPE zbdc_script_bup-script_id
           iv_hash      TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: ls_head      TYPE zbdc_script_bup,
        lv_status    TYPE zbdc_prof_bup-status,
        lt_map       TYPE STANDARD TABLE OF zbdc_mapping_bup,
        ls_map       TYPE zbdc_mapping_bup,
        lv_bdc       TYPE zbdc_mapping_bup-bdc_field,
        lv_logical   TYPE zbdc_mapping_bup-bdc_field,
        lv_source    TYPE zbdc_mapping_bup-source_column,
        lv_bound     TYPE abap_bool,
        lv_action_n  TYPE i,
        lv_name_n    TYPE i,
        lv_save_ok   TYPE abap_bool,
        lv_save_msg  TYPE string,
        ls_name      TYPE ty_z684_name_cert.

  DATA: lt_actions TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                   WITH UNIQUE KEY table_line,
        lt_names   TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                   WITH UNIQUE KEY table_line.

  CLEAR: cv_ok, cv_message.
  REFRESH: gt_z659_user_actions, gt_z684_names, lt_actions, lt_names.

  IF iv_script_id IS INITIAL OR iv_hash IS INITIAL OR pt_script IS INITIAL.
    RETURN.
  ENDIF.

  SELECT SINGLE *
    FROM zbdc_script_bup
    INTO @ls_head
    WHERE script_id     = @iv_script_id
      AND contract_hash = @iv_hash.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @ls_head-tcode
      AND profile_name = @ls_head-profile_name
      AND profile_ver  = @ls_head-profile_ver.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  IF lv_status <> gc_m2_prof_mapped
     AND lv_status <> 'TESTING'
     AND lv_status <> gc_m2_prof_active.
    RETURN.
  ENDIF.

  SELECT *
    FROM zbdc_mapping_bup
    INTO TABLE @lt_map
    WHERE tcode        = @ls_head-tcode
      AND profile_name = @ls_head-profile_name
      AND profile_ver  = @ls_head-profile_ver
    ORDER BY staging_field, source_column.
  IF lt_map IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_map INTO ls_map.
    CLEAR: lv_source, lv_bdc, lv_logical, lv_bound, ls_name.

    PERFORM normalize_mapping_source
      USING    ls_map-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL OR lv_source = 'BUSINESS_KEY'.
      CONTINUE.
    ENDIF.

    IF ls_map-staging_field IS INITIAL OR ls_map-bdc_field IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_map-bdc_field
      CHANGING lv_bdc.
    IF lv_bdc IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key
      USING    lv_bdc
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      lv_logical = lv_bdc.
    ENDIF.

    "Repository row must still bind to the immutable Script. A stale Mapping
    "row is not allowed to become restored selection authority.
    PERFORM raw_replay_bound
      USING    pt_script lv_bdc
      CHANGING lv_bound.
    IF lv_bound <> abap_true.
      REFRESH: gt_z659_user_actions, gt_z684_names.
      cv_message = |MAPPING_RESTORE_BIND_BLOCK: persisted field { lv_logical } is not bound in the immutable Script.|.
      RETURN.
    ENDIF.

    READ TABLE lt_actions
      WITH TABLE KEY table_line = lv_logical
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      "The same logical field may have physical aliases, but one exact
      "Template selection must resolve to one persisted friendly name.
      READ TABLE gt_z684_names INTO ls_name
        WITH TABLE KEY logical_key = lv_logical.
      IF sy-subrc = 0 AND ls_name-source_name <> lv_source.
        REFRESH: gt_z659_user_actions, gt_z684_names.
        cv_message = |MAPPING_RESTORE_CONFLICT: field { lv_logical } has multiple persisted Template names.|.
        RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.

    READ TABLE lt_names
      WITH TABLE KEY table_line = lv_source
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      REFRESH: gt_z659_user_actions, gt_z684_names.
      cv_message = |MAPPING_RESTORE_NAME_COLLISION: persisted Template name { lv_source } is not unique.|.
      RETURN.
    ENDIF.

    INSERT lv_logical INTO TABLE lt_actions.
    INSERT lv_source  INTO TABLE lt_names.
    INSERT lv_logical INTO TABLE gt_z659_user_actions.

    CLEAR ls_name.
    ls_name-logical_key = lv_logical.
    ls_name-source_name = lv_source.
    INSERT ls_name INTO TABLE gt_z684_names.
  ENDLOOP.

  DESCRIBE TABLE gt_z659_user_actions LINES lv_action_n.
  DESCRIBE TABLE gt_z684_names LINES lv_name_n.
  IF lv_action_n <= 0 OR lv_action_n <> lv_name_n.
    REFRESH: gt_z659_user_actions, gt_z684_names.
    RETURN.
  ENDIF.

  gv_z659_action_script = iv_script_id.
  gv_z659_action_hash   = iv_hash.
  gv_z659_action_ready  = abap_true.
  gv_z684_name_script   = iv_script_id.
  gv_z684_name_hash     = iv_hash.
  gv_z684_name_ready    = abap_true.

  CLEAR: lv_save_ok, lv_save_msg.
  PERFORM save_action_cert
    USING    iv_script_id iv_hash
    CHANGING lv_save_ok lv_save_msg.
  IF lv_save_ok <> abap_true.
    REFRESH: gt_z659_user_actions, gt_z684_names.
    CLEAR: gv_z659_action_script, gv_z659_action_hash,
           gv_z659_action_ready, gv_z684_name_script,
           gv_z684_name_hash, gv_z684_name_ready.
    cv_message = lv_save_msg.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message = |Restored { lv_action_n } Template field(s) from the exact persisted Mapping version and upgraded the selection certificate.|.
ENDFORM.

*& Restore legacy executable selection from immutable Script projection
*& Older MAPPED/TESTING/ACTIVE contracts can predate the A35/A36 checkbox
*& certificate while still carrying exact executable Template membership in
*& the frozen Script: DYNAMIC rows with a persisted SOURCE_COLUMN. This is
*& contract evidence, not a new heuristic. Migrate it once into A36 so My
*& Import / All Import never asks the user to remember the same fields again.

FORM restore_script_proj_cert
  USING    pt_script    TYPE ty_t_script
           iv_script_id TYPE zbdc_script_bup-script_id
           iv_hash      TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: ls_head       TYPE zbdc_script_bup,
        lv_status     TYPE zbdc_prof_bup-status,
        ls_script     TYPE ty_script_def_compat,
        lv_exact      TYPE zbdc_mapping_bup-bdc_field,
        lv_logical    TYPE zbdc_mapping_bup-bdc_field,
        lv_source     TYPE zbdc_mapping_bup-source_column,
        lv_name       TYPE zbdc_mapping_bup-source_column,
        lv_technical  TYPE abap_bool,
        lv_bound      TYPE abap_bool,
        lv_type       TYPE zbdc_sct_ver_bup-value_type,
        lv_action_n   TYPE i,
        lv_name_n     TYPE i,
        lv_save_ok    TYPE abap_bool,
        lv_save_msg   TYPE string,
        ls_name       TYPE ty_z684_name_cert.

  TYPES: BEGIN OF ty_proj_pair,
           logical_key TYPE zbdc_mapping_bup-bdc_field,
           source_name TYPE zbdc_mapping_bup-source_column,
         END OF ty_proj_pair.
  DATA: lt_pairs TYPE SORTED TABLE OF ty_proj_pair
                 WITH UNIQUE KEY logical_key,
        ls_pair  TYPE ty_proj_pair,
        lt_names TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                 WITH UNIQUE KEY table_line.

  CLEAR: cv_ok, cv_message.
  REFRESH: gt_z659_user_actions, gt_z684_names, lt_pairs, lt_names.

  IF iv_script_id IS INITIAL OR iv_hash IS INITIAL OR pt_script IS INITIAL.
    RETURN.
  ENDIF.

  SELECT SINGLE *
    FROM zbdc_script_bup
    INTO @ls_head
    WHERE script_id     = @iv_script_id
      AND contract_hash = @iv_hash.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @ls_head-tcode
      AND profile_name = @ls_head-profile_name
      AND profile_ver  = @ls_head-profile_ver.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  IF lv_status <> gc_m2_prof_mapped
     AND lv_status <> 'TESTING'
     AND lv_status <> gc_m2_prof_active.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL
      AND source_column IS NOT INITIAL.

    lv_type = ls_script-value_type.
    TRANSLATE lv_type TO UPPER CASE.
    CONDENSE lv_type NO-GAPS.
    IF lv_type <> gc_vt_dynamic.
      CONTINUE.
    ENDIF.

    CLEAR lv_technical.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR: lv_exact, lv_logical, lv_source.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_exact.
    PERFORM logical_bdc_key
      USING    lv_exact
      CHANGING lv_logical.
    PERFORM normalize_mapping_source
      USING    ls_script-source_column
      CHANGING lv_source.
    IF lv_logical IS INITIAL OR lv_source IS INITIAL.
      CONTINUE.
    ENDIF.

    READ TABLE lt_pairs INTO ls_pair
      WITH TABLE KEY logical_key = lv_logical.
    IF sy-subrc = 0.
      IF ls_pair-source_name <> lv_source.
        REFRESH: gt_z659_user_actions, gt_z684_names.
        cv_message = |LEGACY_SELECTION_CONFLICT: saved field { lv_logical } has conflicting persisted Template names.|.
        RETURN.
      ENDIF.
      CONTINUE.
    ENDIF.

    CLEAR lv_bound.
    PERFORM raw_replay_bound
      USING    pt_script lv_exact
      CHANGING lv_bound.
    IF lv_bound <> abap_true.
      REFRESH: gt_z659_user_actions, gt_z684_names.
      cv_message = |LEGACY_SELECTION_BIND_BLOCK: saved field { lv_logical } has no replay binding.|.
      RETURN.
    ENDIF.

    CLEAR lv_name.
    PERFORM base_tpl_name
      USING    pt_script lv_exact
      CHANGING lv_name.
    PERFORM normalize_mapping_source
      USING    lv_name
      CHANGING lv_name.
    IF lv_name IS INITIAL.
      lv_name = lv_source.
      PERFORM normalize_mapping_source
        USING    lv_name
        CHANGING lv_name.
    ENDIF.
    IF lv_name IS INITIAL.
      REFRESH: gt_z659_user_actions, gt_z684_names.
      cv_message = |LEGACY_SELECTION_NAME_BLOCK: saved field { lv_logical } has no proven Template name.|.
      RETURN.
    ENDIF.

    READ TABLE lt_names WITH TABLE KEY table_line = lv_name
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      REFRESH: gt_z659_user_actions, gt_z684_names.
      cv_message = |LEGACY_SELECTION_NAME_COLLISION: Template name { lv_name } is not unique.|.
      RETURN.
    ENDIF.

    CLEAR ls_pair.
    ls_pair-logical_key = lv_logical.
    ls_pair-source_name = lv_name.
    INSERT ls_pair INTO TABLE lt_pairs.
    INSERT lv_name INTO TABLE lt_names.
  ENDLOOP.

  IF lt_pairs IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_pairs INTO ls_pair.
    INSERT ls_pair-logical_key INTO TABLE gt_z659_user_actions.
    CLEAR ls_name.
    ls_name-logical_key = ls_pair-logical_key.
    ls_name-source_name = ls_pair-source_name.
    INSERT ls_name INTO TABLE gt_z684_names.
  ENDLOOP.

  DESCRIBE TABLE gt_z659_user_actions LINES lv_action_n.
  DESCRIBE TABLE gt_z684_names LINES lv_name_n.
  IF lv_action_n <= 0 OR lv_action_n <> lv_name_n.
    REFRESH: gt_z659_user_actions, gt_z684_names.
    RETURN.
  ENDIF.

  gv_z659_action_script = iv_script_id.
  gv_z659_action_hash   = iv_hash.
  gv_z659_action_ready  = abap_true.
  gv_z684_name_script   = iv_script_id.
  gv_z684_name_hash     = iv_hash.
  gv_z684_name_ready    = abap_true.

  CLEAR: lv_save_ok, lv_save_msg.
  PERFORM save_action_cert
    USING    iv_script_id iv_hash
    CHANGING lv_save_ok lv_save_msg.
  IF lv_save_ok <> abap_true.
    REFRESH: gt_z659_user_actions, gt_z684_names.
    CLEAR: gv_z659_action_script, gv_z659_action_hash,
           gv_z659_action_ready, gv_z684_name_script,
           gv_z684_name_hash, gv_z684_name_ready.
    cv_message = lv_save_msg.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message = |Restored { lv_action_n } saved Template field(s) from the immutable executable Script and upgraded the contract certificate.|.
ENDFORM.

FORM restore_action_cert
  USING    pt_script    TYPE ty_t_script
           iv_script_id TYPE zbdc_script_bup-script_id
           iv_hash      TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_loaded    TYPE abap_bool,
        lv_legacy    TYPE abap_bool,
        lv_field     TYPE zbdc_mapping_bup-bdc_field,
        lv_exact     TYPE zbdc_mapping_bup-bdc_field,
        lv_logical   TYPE zbdc_mapping_bup-bdc_field,
        lv_physical  TYPE zbdc_mapping_bup-bdc_field,
        lv_name      TYPE zbdc_mapping_bup-source_column,
        lv_save_ok   TYPE abap_bool,
        lv_save_msg  TYPE string,
        lv_action_n  TYPE i,
        lv_name_n    TYPE i,
        ls_script    TYPE ty_script_def_compat,
        ls_name      TYPE ty_z684_name_cert.

  DATA lt_names TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                WITH UNIQUE KEY table_line.

  CLEAR: cv_ok, cv_message, lv_loaded, lv_legacy.

  PERFORM load_action_cert
    USING    iv_script_id iv_hash
    CHANGING lv_loaded.
  IF lv_loaded = abap_true.
    cv_ok = abap_true.
    cv_message = 'Previously confirmed Template fields restored for this exact contract.'.
    RETURN.
  ENDIF.

 "A35 migration preserves only the user's exact selected logical set.
 "Friendly names are rebuilt from the same captured technical fields using
 "the current strict naming contract. If one selected field is not provable,
 "migration fails closed and normal confirmation remains available.
  PERFORM load_action_members_a35
    USING    iv_script_id iv_hash
    CHANGING lv_legacy.
  IF lv_legacy <> abap_true OR gt_z659_user_actions IS INITIAL.
    "Historical mapped contracts are restored from their exact persisted
    "Mapping version before falling back to Script projection. This preserves
    "what the user already mapped/generated instead of asking them to choose
    "the same fields again.
    CLEAR: lv_loaded, cv_message.
    PERFORM restore_map_repo_cert
      USING    pt_script iv_script_id iv_hash
      CHANGING lv_loaded cv_message.
    IF lv_loaded = abap_true.
      cv_ok = abap_true.
      RETURN.
    ENDIF.

    CLEAR: lv_loaded, cv_message.
    PERFORM restore_script_proj_cert
      USING    pt_script iv_script_id iv_hash
      CHANGING lv_loaded cv_message.
    IF lv_loaded = abap_true.
      cv_ok = abap_true.
    ENDIF.
    RETURN.
  ENDIF.

  REFRESH: gt_z684_names, lt_names.
  LOOP AT gt_z659_user_actions INTO lv_field.
    CLEAR: lv_physical, lv_name.

    LOOP AT pt_script INTO ls_script
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.
      CLEAR: lv_exact, lv_logical.
      PERFORM exact_field_key
        USING    ls_script-field_name
        CHANGING lv_exact.
      PERFORM logical_bdc_key
        USING    lv_exact
        CHANGING lv_logical.
      IF lv_logical = lv_field.
        lv_physical = lv_exact.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_physical IS INITIAL.
      REFRESH gt_z684_names.
      cv_message = 'Previous exact field selection was found, but one recorded field no longer has a replay identity; selection is preserved for review.' .
      RETURN.
    ENDIF.

    PERFORM base_tpl_name
      USING    pt_script lv_physical
      CHANGING lv_name.
    PERFORM normalize_mapping_source
      USING    lv_name
      CHANGING lv_name.
    IF lv_name IS INITIAL.
      REFRESH gt_z684_names.
      cv_message = 'Previous exact field selection was found; one selected field needs a proven screen/DDIC friendly name before the contract can be upgraded.' .
      RETURN.
    ENDIF.

    READ TABLE lt_names
      WITH TABLE KEY table_line = lv_name
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      REFRESH gt_z684_names.
      cv_message = 'Previous exact field selection was found; duplicate friendly names need screen-evidence review before the contract can be upgraded.' .
      RETURN.
    ENDIF.
    INSERT lv_name INTO TABLE lt_names.

    CLEAR ls_name.
    ls_name-logical_key = lv_field.
    ls_name-source_name = lv_name.
    INSERT ls_name INTO TABLE gt_z684_names.
  ENDLOOP.

  DESCRIBE TABLE gt_z659_user_actions LINES lv_action_n.
  DESCRIBE TABLE gt_z684_names LINES lv_name_n.
  IF lv_action_n <= 0 OR lv_name_n <> lv_action_n.
    REFRESH gt_z684_names.
    cv_message = 'Previous exact field selection was found, but its friendly-name certificate is incomplete; selection is preserved for review.' .
    RETURN.
  ENDIF.

  gv_z659_action_script = iv_script_id.
  gv_z659_action_hash   = iv_hash.
  gv_z659_action_ready  = abap_true.
  gv_z684_name_script   = iv_script_id.
  gv_z684_name_hash     = iv_hash.
  gv_z684_name_ready    = abap_true.

  CLEAR: lv_save_ok, lv_save_msg.
  PERFORM save_action_cert
    USING    iv_script_id iv_hash
    CHANGING lv_save_ok lv_save_msg.
  IF lv_save_ok <> abap_true.
    REFRESH gt_z684_names.
    CLEAR: gv_z659_action_script, gv_z659_action_hash,
           gv_z659_action_ready, gv_z684_name_script,
           gv_z684_name_hash, gv_z684_name_ready.
    cv_message = lv_save_msg.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_message = 'Previously selected Template fields restored and naming certificate upgraded.'.
ENDFORM.

FORM save_action_cert
  USING    iv_script_id TYPE zbdc_script_bup-script_id
           iv_hash      TYPE zbdc_script_bup-contract_hash
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lv_ok      TYPE abap_bool,
        lv_msg     TYPE string,
        lv_count   TYPE i,
        lv_count_c TYPE zbdc_config_bup-config_value,
        lv_hash_c  TYPE zbdc_config_bup-config_value,
        lv_kind    TYPE c LENGTH 7,
        lv_idx     TYPE n LENGTH 4,
        lv_field   TYPE zbdc_mapping_bup-bdc_field,
        lv_name_kind TYPE c LENGTH 7,
        lv_name_value TYPE zbdc_config_bup-config_value,
        ls_name      TYPE ty_z684_name_cert,
        lv_name_count TYPE i.

  CLEAR: cv_ok, cv_message.
  IF iv_script_id IS INITIAL OR iv_hash IS INITIAL.
    cv_message = 'Exact user-action certification requires Script ID and Contract Hash.'.
    RETURN.
  ENDIF.

  lv_hash_c = iv_hash.
  DESCRIBE TABLE gt_z659_user_actions LINES lv_count.
  DESCRIBE TABLE gt_z684_names LINES lv_name_count.
  IF lv_count <= 0 OR lv_name_count <> lv_count.
    cv_message =
      |CERT_SET_BLOCK: confirmed actions={ lv_count }, confirmed names={ lv_name_count }; exact selected-set certificate was not saved.|.
    RETURN.
  ENDIF.
  lv_count_c = lv_count.

  CLEAR: lv_ok, lv_msg.
  PERFORM set_script_cfg
    USING    iv_script_id 'ACTV' 'A36'
    CHANGING lv_ok lv_msg.
  IF lv_ok <> abap_true.
    cv_message = lv_msg.
    RETURN.
  ENDIF.

  CLEAR: lv_ok, lv_msg.
  PERFORM set_script_cfg
    USING    iv_script_id 'ACTH' lv_hash_c
    CHANGING lv_ok lv_msg.
  IF lv_ok <> abap_true.
    cv_message = lv_msg.
    RETURN.
  ENDIF.

  CLEAR: lv_ok, lv_msg.
  PERFORM set_script_cfg
    USING    iv_script_id 'ACTN' lv_count_c
    CHANGING lv_ok lv_msg.
  IF lv_ok <> abap_true.
    cv_message = lv_msg.
    RETURN.
  ENDIF.

  LOOP AT gt_z659_user_actions INTO lv_field.
    lv_idx = sy-tabix.
    CONCATENATE 'ACT' lv_idx INTO lv_kind.
    CLEAR: lv_ok, lv_msg.
    PERFORM set_script_cfg
      USING    iv_script_id lv_kind lv_field
      CHANGING lv_ok lv_msg.
    IF lv_ok <> abap_true.
      cv_message = lv_msg.
      RETURN.
    ENDIF.

    READ TABLE gt_z684_names INTO ls_name
      WITH TABLE KEY logical_key = lv_field.
    IF sy-subrc <> 0 OR ls_name-source_name IS INITIAL.
      cv_message = |NAME_CERT_MISSING: confirmed field { lv_field } has no exact visible Template name.|.
      RETURN.
    ENDIF.
    CONCATENATE 'ANM' lv_idx INTO lv_name_kind.
    lv_name_value = ls_name-source_name.
    CLEAR: lv_ok, lv_msg.
    PERFORM set_script_cfg
      USING    iv_script_id lv_name_kind lv_name_value
      CHANGING lv_ok lv_msg.
    IF lv_ok <> abap_true.
      cv_message = lv_msg.
      RETURN.
    ENDIF.
  ENDLOOP.

  COMMIT WORK AND WAIT.
  gv_z659_action_script = iv_script_id.
  gv_z659_action_hash   = iv_hash.
  gv_z659_action_ready  = abap_true.
  gv_z684_name_script   = iv_script_id.
  gv_z684_name_hash     = iv_hash.
  gv_z684_name_ready    = abap_true.
  cv_ok = abap_true.
  cv_message = 'Exact user-action and visible-name certification saved for the current Script/Hash.'.
ENDFORM.

FORM action_selected
  USING    iv_field TYPE any
  CHANGING cv_ok    TYPE abap_bool.

  DATA lv_key TYPE zbdc_mapping_bup-bdc_field.

  CLEAR cv_ok.
  IF gv_z659_action_ready <> abap_true.
    RETURN.
  ENDIF.

  PERFORM logical_bdc_key
    USING    iv_field
    CHANGING lv_key.
  IF lv_key IS INITIAL.
    RETURN.
  ENDIF.

  READ TABLE gt_z659_user_actions
    WITH TABLE KEY table_line = lv_key
    TRANSPORTING NO FIELDS.
  IF sy-subrc = 0.
    cv_ok = abap_true.
  ENDIF.
ENDFORM.

*& Lossless confirmation + final friendly invariants

*& Before confirmation, recall wins: every business-capable field physically
*& present in the raw recording is offered, even when its value is blank, a
*& helper heuristic would dislike it, or it has a concrete table-control index.
*& Only universal BDC/DYN choreography is excluded. Guided recording additionally
*& unions visible/input-capable native FIELD_VALS so a blank native input cannot
*& disappear during BDCDATA flattening. After confirmation, only the selected
*& logical fields can become Mapping/Template inputs; raw replay stays immutable.

FORM exact_field_key
  USING    iv_field TYPE any
  CHANGING cv_key   TYPE zbdc_mapping_bup-bdc_field.

  DATA lv_text TYPE string.

  lv_text = iv_field.
  CLEAR cv_key.
  TRANSLATE lv_text TO UPPER CASE.
  CONDENSE lv_text NO-GAPS.
  IF lv_text IS INITIAL.
    RETURN.
  ENDIF.
  cv_key = lv_text.
ENDFORM.

FORM field_choreo_only
  USING    iv_field TYPE any
  CHANGING cv_tech  TYPE abap_bool.

  DATA lv_text TYPE string.

  CLEAR cv_tech.
  lv_text = iv_field.
  TRANSLATE lv_text TO UPPER CASE.
  CONDENSE lv_text NO-GAPS.
  IF lv_text IS INITIAL.
    cv_tech = abap_true.
    RETURN.
  ENDIF.

  IF lv_text = 'BDC_CURSOR'
     OR lv_text = 'BDC_OKCODE'
     OR lv_text = 'BDC_SUBSCR'
     OR lv_text CP 'BDC_*'
     OR lv_text CP 'DYN_*'.
    cv_tech = abap_true.
  ENDIF.
ENDFORM.

FORM raw_replay_bound
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_ok     TYPE abap_bool.

  DATA: ls_script  TYPE ty_script_def_compat,
        lv_target  TYPE zbdc_mapping_bup-bdc_field,
        lv_tkey    TYPE zbdc_mapping_bup-bdc_field,
        lv_norm    TYPE zbdc_mapping_bup-bdc_field,
        lv_key     TYPE zbdc_mapping_bup-bdc_field,
        lv_tech    TYPE abap_bool.

  CLEAR cv_ok.
  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_tkey.
  IF lv_tkey IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    CLEAR lv_tech.
    PERFORM field_choreo_only
      USING    ls_script-field_name
      CHANGING lv_tech.
    IF lv_tech = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR: lv_norm, lv_key.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key = lv_tkey.
      cv_ok = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Simple two-column confirmation + bound screen labels

*& User-facing confirmation shows text SAP exposes on the exact captured
*& dynpro/subscreen, not an invented semantic alias. Authority:
*& 1) screen-specific keyword text from exact D021T dynpro metadata;
*& 2) exact Screen Painter element text with the same field binding;
*& 3) CHECK/RADIO control text on the exact field;
*& 4) documented LABELLEFT/LABELRIGHT binding from RPY_DYNPRO_READ.
*& No nearest-text guessing is used. If SAP does not statically expose a label,
*& the popup says so explicitly; DDIC/technical naming stays only as the
*& separate unique Template Column fallback.

FORM raw_text_ok
  USING    iv_text TYPE any
  CHANGING cv_text TYPE char80
           cv_ok   TYPE abap_bool.

  DATA: lv_text  TYPE string,
        lv_probe TYPE string.

  CLEAR: cv_text, cv_ok.
  lv_text = iv_text.
  CONDENSE lv_text.
  IF lv_text IS INITIAL.
    RETURN.
  ENDIF.

  lv_probe = lv_text.
  REPLACE ALL OCCURRENCES OF '_' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF '-' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF '.' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF '/' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF '\' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF ':' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF '(' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF ')' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF '[' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF ']' IN lv_probe WITH ''.
  REPLACE ALL OCCURRENCES OF '|' IN lv_probe WITH ''.
  CONDENSE lv_probe NO-GAPS.
  IF lv_probe IS INITIAL.
    RETURN.
  ENDIF.

  cv_text = lv_text.
  cv_ok = abap_true.
ENDFORM.

FORM lang_element_text
  USING    iv_prog TYPE any
           iv_dyn  TYPE any
           iv_name TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  DATA: lv_prog TYPE d020s-prog,
        lv_dyn  TYPE d020s-dnum,
        lv_name TYPE d021t-fldn,
        ls_txt  TYPE d021t,
        ls_head TYPE d020s,
        ls_fld  TYPE d021s,
        lv_raw  TYPE char80,
        lv_ok   TYPE abap_bool,
        lv_count TYPE i.

  DATA: lt_txt TYPE STANDARD TABLE OF d021t,
        lt_fld TYPE STANDARD TABLE OF d021s,
        lt_flow TYPE STANDARD TABLE OF d022s,
        lt_labels TYPE SORTED TABLE OF char80
                  WITH UNIQUE KEY table_line.

  CLEAR: cv_text, cv_found.
  lv_prog = iv_prog.
  lv_dyn  = iv_dyn.
  lv_name = iv_name.
  CONDENSE lv_prog NO-GAPS.
  CONDENSE lv_dyn NO-GAPS.
  CONDENSE lv_name.
  IF lv_prog IS INITIAL OR lv_dyn IS INITIAL OR lv_name IS INITIAL.
    RETURN.
  ENDIF.

 "First authority: translated screen-keyword text in the CURRENT ABAP
 "logon language. Never read another language as if the user saw it.
  SELECT *
    FROM d021t
    INTO TABLE lt_txt
    WHERE prog = lv_prog
      AND dynr = lv_dyn
      AND lang = sy-langu
      AND fldn = lv_name.

  LOOP AT lt_txt INTO ls_txt.
    CLEAR: lv_raw, lv_ok.
    PERFORM raw_text_ok
      USING    ls_txt-dtxt
      CHANGING lv_raw lv_ok.
    IF lv_ok = abap_true.
      INSERT lv_raw INTO TABLE lt_labels.
    ENDIF.
  ENDLOOP.

 "Second authority: import the exact dynpro explicitly in SY-LANGU. This is
 "the translated Screen Painter representation for the active logon language.
  CLEAR ls_head.
  REFRESH: lt_fld, lt_flow.
  CALL FUNCTION 'RS_IMPORT_DYNPRO'
    EXPORTING
      dylang          = sy-langu
      dyname          = lv_prog
      dynumb          = lv_dyn
      request         = space
      suppress_checks = space
    IMPORTING
      header           = ls_head
    TABLES
      ftab             = lt_fld
      pltab            = lt_flow
    EXCEPTIONS
      OTHERS           = 1.

  IF sy-subrc = 0.
    LOOP AT lt_fld INTO ls_fld.
      IF ls_fld-fnam <> lv_name.
        CONTINUE.
      ENDIF.
      CLEAR: lv_raw, lv_ok.
      PERFORM raw_text_ok
        USING    ls_fld-stxt
        CHANGING lv_raw lv_ok.
      IF lv_ok = abap_true.
        INSERT lv_raw INTO TABLE lt_labels.
      ENDIF.
    ENDLOOP.
  ENDIF.

  DESCRIBE TABLE lt_labels LINES lv_count.
  IF lv_count = 1.
    READ TABLE lt_labels INTO cv_text INDEX 1.
    IF sy-subrc = 0 AND cv_text IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
  ENDIF.
ENDFORM.

FORM ddic_label_raw
  USING    iv_bdc TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  DATA: lv_bdc    TYPE zbdc_mapping_bup-bdc_field,
        lv_left   TYPE string,
        lv_right  TYPE string,
        lv_tab    TYPE tabname,
        lv_field  TYPE fieldname,
        lv_label  TYPE string,
        lt_dfies  TYPE STANDARD TABLE OF dfies,
        ls_dfies  TYPE dfies,
        ls_dtel   TYPE dd04v,
        lv_raw    TYPE char80,
        lv_ok     TYPE abap_bool.

  CLEAR: cv_text, cv_found.
  PERFORM normalize_mapping_bdc_field
    USING    iv_bdc
    CHANGING lv_bdc.
  IF lv_bdc IS INITIAL OR lv_bdc NS '-'.
    RETURN.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '(*)' IN lv_bdc WITH ''.
  SPLIT lv_bdc AT '-' INTO lv_left lv_right.
  IF lv_left IS INITIAL OR lv_right IS INITIAL.
    RETURN.
  ENDIF.

  lv_tab = lv_left.
  lv_field = lv_right.
  REFRESH lt_dfies.
  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_tab
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_dfies
    EXCEPTIONS
      not_found      = 1
      internal_error = 2
      OTHERS         = 3.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  READ TABLE lt_dfies INTO ls_dfies WITH KEY fieldname = lv_field.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

 "Range LOW/HIGH fields often carry a generic Lower/Upper text. Prefer the
 "underlying data-element text in the same logon language when available.
  IF ( lv_field = 'LOW' OR lv_field = 'HIGH' )
     AND ls_dfies-rollname IS NOT INITIAL.
    CLEAR ls_dtel.
    CALL FUNCTION 'DDIF_DTEL_GET'
      EXPORTING
        name          = ls_dfies-rollname
        state         = 'A'
        langu         = sy-langu
      IMPORTING
        dd04v_wa      = ls_dtel
      EXCEPTIONS
        illegal_input = 1
        OTHERS        = 2.
    IF sy-subrc = 0.
      lv_label = ls_dtel-scrtext_l.
      IF lv_label IS INITIAL.
        lv_label = ls_dtel-ddtext.
      ENDIF.
      IF lv_label IS INITIAL.
        lv_label = ls_dtel-reptext.
      ENDIF.
      IF lv_label IS INITIAL.
        lv_label = ls_dtel-scrtext_m.
      ENDIF.
    ENDIF.
  ENDIF.

 "For quantity/amount/unit/currency controls, the long screen text can be
 "shared with an adjacent reference field. FIELDText describes this exact
 "DDIC component and prevents Quantity and Unit from borrowing each other.
  IF lv_label IS INITIAL
     AND ( ls_dfies-datatype = 'QUAN' OR ls_dfies-datatype = 'CURR'
        OR ls_dfies-datatype = 'UNIT' OR ls_dfies-datatype = 'CUKY' ).
    lv_label = ls_dfies-fieldtext.
  ENDIF.
  IF lv_label IS INITIAL.
    lv_label = ls_dfies-scrtext_l.
  ENDIF.
  IF lv_label IS INITIAL.
    lv_label = ls_dfies-fieldtext.
  ENDIF.
  IF lv_label IS INITIAL.
    lv_label = ls_dfies-reptext.
  ENDIF.
  IF lv_label IS INITIAL.
    lv_label = ls_dfies-scrtext_m.
  ENDIF.

  CLEAR: lv_raw, lv_ok.
  PERFORM raw_text_ok
    USING    lv_label
    CHANGING lv_raw lv_ok.
  IF lv_ok = abap_true.
    cv_text = lv_raw.
    cv_found = abap_true.
  ENDIF.
ENDFORM.

FORM rpy_label_raw
  USING    iv_prog TYPE any
           iv_dyn  TYPE any
           iv_bdc  TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  DATA: lv_prog       TYPE d020s-prog,
        lv_dyn        TYPE d020s-dnum,
        lv_target     TYPE zbdc_mapping_bup-bdc_field,
        lv_target_log TYPE zbdc_mapping_bup-bdc_field,
        lv_name       TYPE zbdc_mapping_bup-bdc_field,
        lv_name_log   TYPE zbdc_mapping_bup-bdc_field,
        ls_head       TYPE rpy_dyhead,
        ls_ext        TYPE rpy_dyfatc,
        ls_hdr        TYPE rpy_dyfatc,
        ls_scan       TYPE rpy_dyfatc,
        lv_raw        TYPE char80,
        lv_hit        TYPE abap_bool,
        lv_count      TYPE i,
        lv_tcol       TYPE i,
        lv_hcol       TYPE i,
        lv_hlen       TYPE i,
        lv_hend       TYPE i,
        lv_target_hit TYPE abap_bool,
        lv_tline      TYPE i,
        lv_lline      TYPE i,
        lv_lcol       TYPE i,
        lv_sline      TYPE i,
        lv_scol       TYPE i,
        lv_best_col   TYPE i,
        lv_best_name  TYPE zbdc_mapping_bup-bdc_field.

  DATA: lt_ext TYPE dyfatc_tab,
        lt_labels TYPE SORTED TABLE OF char80
                  WITH UNIQUE KEY table_line.

  CLEAR: cv_text, cv_found.
  lv_prog = iv_prog.
  lv_dyn  = iv_dyn.
  CONDENSE lv_prog NO-GAPS.
  CONDENSE lv_dyn NO-GAPS.
  IF lv_prog IS INITIAL OR lv_dyn IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM exact_field_key
    USING    iv_bdc
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_log.
  IF lv_target_log IS INITIAL.
    RETURN.
  ENDIF.

 "LOW/HIGH fields created by ABAP SELECT-OPTIONS are generated
 "selection-screen controls. Their user-visible caption belongs to the
 "program selection text (TEXTPOOL ID 'S'), not necessarily to D021S/D021T.
 "Resolve that native selection-text authority BEFORE static dynpro lookup.
  CLEAR: lv_raw, lv_hit.
  PERFORM range_seltext_cap
    USING    lv_prog lv_target
    CHANGING lv_raw lv_hit.
  IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
    cv_text = lv_raw.
    cv_found = abap_true.
    RETURN.
  ENDIF.

  REFRESH lt_ext.
  CLEAR ls_head.
  CALL FUNCTION 'RPY_DYNPRO_READ'
    EXPORTING
      progname             = lv_prog
      dynnr                = lv_dyn
      suppress_corr_checks = 'X'
    IMPORTING
      header               = ls_head
    TABLES
      fields_to_containers = lt_ext
    EXCEPTIONS
      cancelled            = 1
      not_found            = 2
      permission_error     = 3
      OTHERS               = 4.
  IF sy-subrc <> 0 OR lt_ext IS INITIAL.
 "some standard subscreens expose program RANGE fields only in
 "the native D021S/D021T representation. Do not fall back to RNG_* merely
 "because the external RPY container projection omitted those elements.
    CLEAR: lv_raw, lv_hit.
    PERFORM native_range_cap
      USING    lv_prog lv_dyn lv_target
      CHANGING lv_raw lv_hit.
    IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
      cv_text = lv_raw.
      cv_found = abap_true.
    ENDIF.
    RETURN.
  ENDIF.

 "RPY_DYNPRO_READ is structural authority only. Every accepted caption is
 "re-read from the exact element in SY-LANGU by lang_element_text.
  CLEAR: lv_target_hit, lv_tline, lv_tcol.
  LOOP AT lt_ext INTO ls_ext.
    CLEAR: lv_name, lv_name_log.
    PERFORM exact_field_key
      USING    ls_ext-name
      CHANGING lv_name.
    PERFORM logical_bdc_key
      USING    lv_name
      CHANGING lv_name_log.
    IF lv_name_log <> lv_target_log.
      CONTINUE.
    ENDIF.

    IF lv_target_hit IS INITIAL.
      lv_target_hit = abap_true.
      lv_tline = ls_ext-line.
      lv_tcol  = ls_ext-column.
    ENDIF.

 "Normal field/check/radio: exact element text in current logon language.
    IF ls_ext-cont_type <> 'TABLE_CTRL'.
      CLEAR: lv_raw, lv_hit.
      PERFORM lang_element_text
        USING    lv_prog lv_dyn ls_ext-name
        CHANGING lv_raw lv_hit.
      IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
        INSERT lv_raw INTO TABLE lt_labels.
      ENDIF.
    ENDIF.

 "Table-control field: bind structurally to its TC_HEADING in same container.
    IF ls_ext-cont_type = 'TABLE_CTRL'
       AND ls_ext-cont_name IS NOT INITIAL
       AND ls_ext-tc_heading IS INITIAL.
      lv_tcol = ls_ext-column.
      LOOP AT lt_ext INTO ls_hdr.
        IF ls_hdr-cont_type <> 'TABLE_CTRL'
           OR ls_hdr-cont_name <> ls_ext-cont_name
           OR ls_hdr-tc_heading <> 'X'.
          CONTINUE.
        ENDIF.
        lv_hcol = ls_hdr-column.
        lv_hlen = ls_hdr-vislength.
        IF lv_hlen <= 0.
          lv_hlen = ls_hdr-length.
        ENDIF.
        IF lv_hlen <= 0.
          lv_hlen = 1.
        ENDIF.
        lv_hend = lv_hcol + lv_hlen - 1.
        IF lv_tcol < lv_hcol OR lv_tcol > lv_hend.
          CONTINUE.
        ENDIF.
        CLEAR: lv_raw, lv_hit.
        PERFORM lang_element_text
          USING    lv_prog lv_dyn ls_hdr-name
          CHANGING lv_raw lv_hit.
        IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
          INSERT lv_raw INTO TABLE lt_labels.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDLOOP.

 "Selection/range and ordinary labelled input controls can expose an explicit
 "LABELLEFT/LABELRIGHT relationship in Screen Painter metadata. This is a
 "structural binding, not arbitrary nearest-text guessing: only a label whose
 "declared direction resolves back to the exact target field is accepted.
  IF lv_target_hit = abap_true.
    LOOP AT lt_ext INTO ls_ext WHERE type = 'TEXT'.
      IF ls_ext-labelleft IS INITIAL AND ls_ext-labelright IS INITIAL.
        CONTINUE.
      ENDIF.
      lv_lline = ls_ext-line.
      lv_lcol  = ls_ext-column.
      IF lv_lline <> lv_tline.
        CONTINUE.
      ENDIF.

      CLEAR: lv_best_col, lv_best_name.
      IF ls_ext-labelleft = 'X'.
        LOOP AT lt_ext INTO ls_scan.
          lv_sline = ls_scan-line.
          lv_scol  = ls_scan-column.
          IF lv_sline <> lv_tline OR lv_scol <= lv_lcol.
            CONTINUE.
          ENDIF.
          IF ls_scan-type = 'FRAME' OR ls_scan-type = 'TEXT'.
            CONTINUE.
          ENDIF.
          IF lv_best_col = 0 OR lv_scol < lv_best_col.
            lv_best_col = lv_scol.
            lv_best_name = ls_scan-name.
          ENDIF.
        ENDLOOP.
      ELSEIF ls_ext-labelright = 'X'.
        LOOP AT lt_ext INTO ls_scan.
          lv_sline = ls_scan-line.
          lv_scol  = ls_scan-column.
          IF lv_sline <> lv_tline OR lv_scol >= lv_lcol.
            CONTINUE.
          ENDIF.
          IF ls_scan-type = 'FRAME' OR ls_scan-type = 'TEXT'.
            CONTINUE.
          ENDIF.
          IF lv_best_col = 0 OR lv_scol > lv_best_col.
            lv_best_col = lv_scol.
            lv_best_name = ls_scan-name.
          ENDIF.
        ENDLOOP.
      ENDIF.

      CLEAR: lv_name, lv_name_log.
      PERFORM exact_field_key
        USING    lv_best_name
        CHANGING lv_name.
      PERFORM logical_bdc_key
        USING    lv_name
        CHANGING lv_name_log.
      IF lv_name_log <> lv_target_log.
        CONTINUE.
      ENDIF.

      CLEAR: lv_raw, lv_hit.
      PERFORM lang_element_text
        USING    lv_prog lv_dyn ls_ext-name
        CHANGING lv_raw lv_hit.
      IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
        INSERT lv_raw INTO TABLE lt_labels.
      ENDIF.
    ENDLOOP.
  ENDIF.

 "range/select-option caption fallback. Only LOW/HIGH-style
 "selection rows use this layout binding, and only when one unambiguous
 "caption exists to the left of the LOW field on the exact captured screen.
  IF lt_labels IS INITIAL.
    CLEAR: lv_raw, lv_hit.
    PERFORM range_caption
      USING    lv_prog lv_dyn lv_target
      CHANGING lv_raw lv_hit.
    IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
      INSERT lv_raw INTO TABLE lt_labels.
    ENDIF.
  ENDIF.

 "final screen-text authority for program RANGE fields. The native
 "dynpro import contains the actual translated D021 screen texts even when
 "RPY_DYNPRO_READ does not publish the generated range row as a container.
  IF lt_labels IS INITIAL.
    CLEAR: lv_raw, lv_hit.
    PERFORM native_range_cap
      USING    lv_prog lv_dyn lv_target
      CHANGING lv_raw lv_hit.
    IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
      INSERT lv_raw INTO TABLE lt_labels.
    ENDIF.
  ENDIF.

  DESCRIBE TABLE lt_labels LINES lv_count.
  IF lv_count = 1.
    READ TABLE lt_labels INTO cv_text INDEX 1.
    IF sy-subrc = 0 AND cv_text IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
  ENDIF.
ENDFORM.

FORM range_caption
  USING    iv_prog TYPE any
           iv_dyn  TYPE any
           iv_bdc  TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  DATA: lv_prog       TYPE d020s-prog,
        lv_dyn        TYPE d020s-dnum,
        lv_target     TYPE zbdc_mapping_bup-bdc_field,
        lv_target_log TYPE zbdc_mapping_bup-bdc_field,
        lv_left       TYPE string,
        lv_right      TYPE string,
        lv_low_name   TYPE zbdc_mapping_bup-bdc_field,
        lv_low_log    TYPE zbdc_mapping_bup-bdc_field,
        lv_name       TYPE zbdc_mapping_bup-bdc_field,
        lv_name_log   TYPE zbdc_mapping_bup-bdc_field,
        lv_line       TYPE i,
        lv_low_col    TYPE i,
        lv_txt_col    TYPE i,
        lv_txt_end    TYPE i,
        lv_txt_len    TYPE i,
        lv_txt_line   TYPE i,
        lv_scan_col   TYPE i,
        lv_blocked    TYPE abap_bool,
        lv_raw        TYPE char80,
        lv_hit        TYPE abap_bool,
        lv_count      TYPE i,
        lv_gap        TYPE i,
        lv_line_gap   TYPE i,
        lv_score      TYPE i,
        lv_best_score TYPE i,
        lv_best_raw   TYPE char80,
        lv_tie        TYPE abap_bool,
        ls_head       TYPE rpy_dyhead,
        ls_ext        TYPE rpy_dyfatc,
        ls_txt        TYPE rpy_dyfatc,
        ls_scan       TYPE rpy_dyfatc.

  DATA: lt_ext TYPE dyfatc_tab,
        lt_labels TYPE SORTED TABLE OF char80
                  WITH UNIQUE KEY table_line.

  CLEAR: cv_text, cv_found.
  lv_prog = iv_prog.
  lv_dyn  = iv_dyn.
  CONDENSE lv_prog NO-GAPS.
  CONDENSE lv_dyn NO-GAPS.
  IF lv_prog IS INITIAL OR lv_dyn IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM exact_field_key
    USING    iv_bdc
    CHANGING lv_target.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_target WITH ''.
  IF lv_target NS '-'.
    RETURN.
  ENDIF.
  SPLIT lv_target AT '-' INTO lv_left lv_right.
  TRANSLATE lv_right TO UPPER CASE.
  IF lv_right <> 'LOW' AND lv_right <> 'HIGH'.
    RETURN.
  ENDIF.

  CONCATENATE lv_left '-LOW' INTO lv_low_name.
  PERFORM logical_bdc_key
    USING    lv_low_name
    CHANGING lv_low_log.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_log.
  IF lv_target_log IS INITIAL OR lv_low_log IS INITIAL.
    RETURN.
  ENDIF.

  REFRESH lt_ext.
  CLEAR ls_head.
  CALL FUNCTION 'RPY_DYNPRO_READ'
    EXPORTING
      progname             = lv_prog
      dynnr                = lv_dyn
      suppress_corr_checks = 'X'
    IMPORTING
      header               = ls_head
    TABLES
      fields_to_containers = lt_ext
    EXCEPTIONS
      cancelled            = 1
      not_found            = 2
      permission_error     = 3
      OTHERS               = 4.
  IF sy-subrc <> 0 OR lt_ext IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_line, lv_low_col.
  LOOP AT lt_ext INTO ls_ext.
    CLEAR: lv_name, lv_name_log.
    PERFORM exact_field_key
      USING    ls_ext-name
      CHANGING lv_name.
    PERFORM logical_bdc_key
      USING    lv_name
      CHANGING lv_name_log.
    IF lv_name_log = lv_low_log.
      lv_line    = ls_ext-line.
      lv_low_col = ls_ext-column.
      EXIT.
    ENDIF.
  ENDLOOP.
  IF lv_line = 0 OR lv_low_col = 0.
    RETURN.
  ENDIF.

 "program RANGES/LOW/HIGH fields may not have their own DDIC table
 "identity, while the exact SAP caption is still painted beside the control.
 "Resolve only from the captured owner dynpro geometry; never translate the
 "technical RNG_* identifier into invented business meaning.

 "First authority: nearest meaningful static text on the SAME line left of
 "LOW. Using the nearest right edge avoids collecting section headings that
 "happen to share the row.
  CLEAR: lv_best_score, lv_best_raw, lv_tie.
  LOOP AT lt_ext INTO ls_txt.
    IF ls_txt-type <> 'TEXT'.
      CONTINUE.
    ENDIF.
    lv_txt_line = ls_txt-line.
    lv_txt_col  = ls_txt-column.
    IF lv_txt_line <> lv_line OR lv_txt_col >= lv_low_col.
      CONTINUE.
    ENDIF.

    lv_txt_len = ls_txt-vislength.
    IF lv_txt_len <= 0.
      lv_txt_len = ls_txt-length.
    ENDIF.
    IF lv_txt_len <= 0.
      lv_txt_len = 1.
    ENDIF.
    lv_txt_end = lv_txt_col + lv_txt_len - 1.
    IF lv_txt_end >= lv_low_col.
      CONTINUE.
    ENDIF.

    CLEAR lv_blocked.
    LOOP AT lt_ext INTO ls_scan.
      IF ls_scan-line <> lv_line.
        CONTINUE.
      ENDIF.
      lv_scan_col = ls_scan-column.
      IF lv_scan_col <= lv_txt_end OR lv_scan_col >= lv_low_col.
        CONTINUE.
      ENDIF.
      IF ls_scan-type = 'TEMPLATE'
         OR ls_scan-type = 'CHECK'
         OR ls_scan-type = 'RADIO'.
        lv_blocked = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.
    IF lv_blocked = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR: lv_raw, lv_hit.
    PERFORM lang_element_text
      USING    lv_prog lv_dyn ls_txt-name
      CHANGING lv_raw lv_hit.
    IF lv_hit <> abap_true OR lv_raw IS INITIAL.
 "Auto-generated text element names are not always addressable through
 "D021T. RPY_DYNPRO_READ still returns the literal Screen Painter text.
      CLEAR: lv_raw, lv_hit.
      PERFORM raw_text_ok
        USING    ls_txt-text
        CHANGING lv_raw lv_hit.
    ENDIF.
    IF lv_hit <> abap_true OR lv_raw IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_gap = lv_low_col - lv_txt_end.
    IF lv_best_score = 0 OR lv_gap < lv_best_score.
      lv_best_score = lv_gap.
      lv_best_raw = lv_raw.
      CLEAR lv_tie.
    ELSEIF lv_gap = lv_best_score AND lv_raw <> lv_best_raw.
      lv_tie = abap_true.
    ENDIF.
  ENDLOOP.

  IF lv_best_raw IS NOT INITIAL AND lv_tie <> abap_true.
    INSERT lv_best_raw INTO TABLE lt_labels.
  ENDIF.

 "Second authority: a compact SAP subscreen can paint the caption one or two
 "rows above the range input. Accept only the nearest unique literal text or
 "fixed frame title in that small window.
  IF lt_labels IS INITIAL.
    CLEAR: lv_best_score, lv_best_raw, lv_tie.
    LOOP AT lt_ext INTO ls_txt.
      IF ls_txt-type <> 'TEXT' AND ls_txt-type <> 'FRAME'.
        CONTINUE.
      ENDIF.
      lv_txt_line = ls_txt-line.
      lv_txt_col  = ls_txt-column.
      IF lv_txt_line >= lv_line OR lv_txt_line < lv_line - 2.
        CONTINUE.
      ENDIF.
      IF lv_txt_col > lv_low_col.
        CONTINUE.
      ENDIF.

      CLEAR: lv_raw, lv_hit.
      PERFORM lang_element_text
        USING    lv_prog lv_dyn ls_txt-name
        CHANGING lv_raw lv_hit.
      IF lv_hit <> abap_true OR lv_raw IS INITIAL.
        CLEAR: lv_raw, lv_hit.
        PERFORM raw_text_ok
          USING    ls_txt-text
          CHANGING lv_raw lv_hit.
      ENDIF.
      IF lv_hit <> abap_true OR lv_raw IS INITIAL.
        CONTINUE.
      ENDIF.

      lv_line_gap = lv_line - lv_txt_line.
      lv_gap = lv_low_col - lv_txt_col.
      IF lv_gap < 0.
        lv_gap = 0.
      ENDIF.
      lv_score = lv_line_gap * 1000 + lv_gap.
      IF lv_best_score = 0 OR lv_score < lv_best_score.
        lv_best_score = lv_score.
        lv_best_raw = lv_raw.
        CLEAR lv_tie.
      ELSEIF lv_score = lv_best_score AND lv_raw <> lv_best_raw.
        lv_tie = abap_true.
      ENDIF.
    ENDLOOP.

    IF lv_best_raw IS NOT INITIAL AND lv_tie <> abap_true.
      INSERT lv_best_raw INTO TABLE lt_labels.
    ENDIF.
  ENDIF.

  DESCRIBE TABLE lt_labels LINES lv_count.
  IF lv_count = 1.
    READ TABLE lt_labels INTO cv_text INDEX 1.
    IF sy-subrc = 0 AND cv_text IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
  ENDIF.
ENDFORM.

*& /Selection-screen text authority for LOW/HIGH range fields

*& ABAP SELECT-OPTIONS generates <name>-LOW / <name>-HIGH controls at runtime.
*& The caption the user sees is maintained as the program's Selection Text
*& (TEXTPOOL ID 'S', KEY = selection criterion name). Such captions can be
*& absent from ordinary/static dynpro repository geometry, which is why a
*& D021S/D021T-only resolver leaves technical RNG_* names behind.

*& This resolver is fully generic:
*& exact owner program + exact LOW/HIGH prefix -> Selection Text in SY-LANGU.
*& No TCODE, SAP program, RNG_* variable, or business label is hardcoded.
*& RS_TEXTPOOL_READ is used because it also resolves Selection Texts that use
*& the Dictionary indicator; READ TEXTPOOL alone cannot reliably expose those.

FORM range_seltext_cap
  USING    iv_prog TYPE any
           iv_bdc  TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  DATA: lv_prog    TYPE rs38m-programm,
        lv_target  TYPE zbdc_mapping_bup-bdc_field,
        lv_left    TYPE string,
        lv_leaf    TYPE string,
        lv_key     TYPE c LENGTH 8,
        lv_raw     TYPE char80,
        lv_ok      TYPE abap_bool,
        lv_probe   TYPE zbdc_mapping_bup-source_column,
        ls_pool    TYPE textpool.

  DATA lt_pool TYPE STANDARD TABLE OF textpool.

  CLEAR: cv_text, cv_found.
  lv_prog = iv_prog.
  CONDENSE lv_prog NO-GAPS.
  IF lv_prog IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM exact_field_key
    USING    iv_bdc
    CHANGING lv_target.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_target WITH ''.
  IF lv_target NS '-'.
    RETURN.
  ENDIF.

  SPLIT lv_target AT '-' INTO lv_left lv_leaf.
  TRANSLATE lv_leaf TO UPPER CASE.
  CONDENSE lv_left NO-GAPS.
  CONDENSE lv_leaf NO-GAPS.
  IF lv_leaf <> 'LOW' AND lv_leaf <> 'HIGH'.
    RETURN.
  ENDIF.
  IF lv_left IS INITIAL OR strlen( lv_left ) > 8.
    RETURN.
  ENDIF.

  lv_key = lv_left.
  TRANSLATE lv_key TO UPPER CASE.
  REFRESH lt_pool.
  CALL FUNCTION 'RS_TEXTPOOL_READ'
    EXPORTING
      objectname           = lv_prog
      action               = 'SHOW'
      authority_check      = space
      language             = sy-langu
    TABLES
      tpool                = lt_pool
    EXCEPTIONS
      object_not_found     = 1
      permission_failure   = 2
      invalid_program_type = 3
      error_occured        = 4
      action_cancelled     = 5
      OTHERS               = 6.
  IF sy-subrc <> 0 OR lt_pool IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_pool INTO ls_pool WHERE id = 'S'.
    IF ls_pool-key <> lv_key.
      CONTINUE.
    ENDIF.

    CLEAR: lv_raw, lv_ok, lv_probe.
    lv_raw = ls_pool-entry.

 "TEXTPOOL ID 'S' has repository framing that is NOT part of the
 "caption. For DDIC-derived selection texts SAP places marker 'D' in the
 "first position; for maintained texts the payload is left-padded.
 "Strip only that documented transport framing before normalization.
 "Without this, 'D Company Code' becomes the bogus Template name
 "D_COMPANY_CODE. This is generic for every selection criterion.
    IF lv_raw IS NOT INITIAL AND lv_raw(1) = 'D'.
      IF strlen( lv_raw ) = 1 OR lv_raw+1(1) = space.
        SHIFT lv_raw BY 1 PLACES LEFT.
      ENDIF.
    ENDIF.
    SHIFT lv_raw LEFT DELETING LEADING space.

    PERFORM raw_text_ok
      USING    lv_raw
      CHANGING lv_raw lv_ok.
    IF lv_ok <> abap_true OR lv_raw IS INITIAL.
      CONTINUE.
    ENDIF.

 "Reject connector-only captions; the business caption must name the
 "selection criterion itself. LOW/HIGH shaping is handled later by Z655.
    PERFORM normalize_mapping_source
      USING    lv_raw
      CHANGING lv_probe.
    IF lv_probe = 'FROM' OR lv_probe = 'TO'
       OR lv_probe = 'LOW' OR lv_probe = 'HIGH'
       OR lv_probe = 'LOWER_LIMIT' OR lv_probe = 'UPPER_LIMIT'
       OR lv_probe = 'LOW_VALUE' OR lv_probe = 'HIGH_VALUE'.
      CONTINUE.
    ENDIF.

    cv_text = lv_raw.
    cv_found = abap_true.
    RETURN.
  ENDLOOP.
ENDFORM.

*& Native dynpro range caption resolver

*& RPY_DYNPRO_READ is an external/container representation. Some standard
*& program RANGE fields are present in the native screen field list but are
*& not emitted there with their painted caption. RS_IMPORT_DYNPRO imports the
*& exact screen in SY-LANGU as D021S, while D021T carries screen-specific
*& translated texts. This resolver binds only by exact owner dynpro geometry:
*& the caption must be a translated/static text on the same row to the LEFT of
*& PREFIX-LOW. If the translated text table is sparse, the translated native
*& D021S-STXT is used. Structural connector words (FROM/TO/LOW/HIGH) are never
*& accepted as the business caption. No TCODE/program/field business mapping.

FORM native_range_cap
  USING    iv_prog TYPE any
           iv_dyn  TYPE any
           iv_bdc  TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  DATA: lv_prog       TYPE d020s-prog,
        lv_dyn        TYPE d020s-dnum,
        lv_target     TYPE zbdc_mapping_bup-bdc_field,
        lv_target_log TYPE zbdc_mapping_bup-bdc_field,
        lv_left       TYPE string,
        lv_leaf       TYPE string,
        lv_low_name   TYPE zbdc_mapping_bup-bdc_field,
        lv_low_log    TYPE zbdc_mapping_bup-bdc_field,
        lv_name       TYPE zbdc_mapping_bup-bdc_field,
        lv_name_log   TYPE zbdc_mapping_bup-bdc_field,
        lv_raw        TYPE char80,
        lv_ok         TYPE abap_bool,
        lv_probe      TYPE zbdc_mapping_bup-source_column,
        lv_best_raw   TYPE char80,
        lv_best_col   TYPE d021s-coln,
        lv_best_set   TYPE abap_bool,
        lv_tie        TYPE abap_bool,
        lv_count      TYPE i,
        ls_head       TYPE d020s,
        ls_low        TYPE d021s,
        ls_pos        TYPE d021s,
        ls_txt        TYPE d021t.

  DATA: lt_fld TYPE STANDARD TABLE OF d021s,
        lt_flow TYPE STANDARD TABLE OF d022s,
        lt_txt TYPE STANDARD TABLE OF d021t,
        lt_labels TYPE SORTED TABLE OF char80
                  WITH UNIQUE KEY table_line.

  CLEAR: cv_text, cv_found.
  lv_prog = iv_prog.
  lv_dyn  = iv_dyn.
  CONDENSE lv_prog NO-GAPS.
  CONDENSE lv_dyn NO-GAPS.
  IF lv_prog IS INITIAL OR lv_dyn IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM exact_field_key
    USING    iv_bdc
    CHANGING lv_target.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_target WITH ''.
  IF lv_target NS '-'.
    RETURN.
  ENDIF.
  SPLIT lv_target AT '-' INTO lv_left lv_leaf.
  TRANSLATE lv_leaf TO UPPER CASE.
  IF lv_leaf <> 'LOW' AND lv_leaf <> 'HIGH'.
    RETURN.
  ENDIF.

  CONCATENATE lv_left '-LOW' INTO lv_low_name.
  PERFORM logical_bdc_key
    USING    lv_low_name
    CHANGING lv_low_log.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_log.
  IF lv_low_log IS INITIAL OR lv_target_log IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR ls_head.
  REFRESH: lt_fld, lt_flow.
  CALL FUNCTION 'RS_IMPORT_DYNPRO'
    EXPORTING
      dylang          = sy-langu
      dyname          = lv_prog
      dynumb          = lv_dyn
      request         = space
      suppress_checks = space
    IMPORTING
      header           = ls_head
    TABLES
      ftab             = lt_fld
      pltab            = lt_flow
    EXCEPTIONS
      OTHERS           = 1.
  IF sy-subrc <> 0 OR lt_fld IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR ls_low.
  LOOP AT lt_fld INTO ls_pos.
    CLEAR: lv_name, lv_name_log.
    PERFORM exact_field_key
      USING    ls_pos-fnam
      CHANGING lv_name.
    PERFORM logical_bdc_key
      USING    lv_name
      CHANGING lv_name_log.
    IF lv_name_log = lv_low_log.
      ls_low = ls_pos.
      EXIT.
    ENDIF.
  ENDLOOP.
  IF ls_low-fnam IS INITIAL.
    RETURN.
  ENDIF.

  REFRESH lt_txt.
  SELECT *
    FROM d021t
    INTO TABLE lt_txt
    WHERE prog = lv_prog
      AND dynr = lv_dyn
      AND lang = sy-langu.

 "Authority 1: D021T translated text, same physical row, nearest on the left.
  CLEAR: lv_best_raw, lv_best_col, lv_best_set, lv_tie.
  LOOP AT lt_txt INTO ls_txt.
    READ TABLE lt_fld INTO ls_pos WITH KEY fnam = ls_txt-fldn.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.
    IF ls_pos-line <> ls_low-line OR ls_pos-coln >= ls_low-coln.
      CONTINUE.
    ENDIF.

    CLEAR: lv_raw, lv_ok, lv_probe.
    PERFORM raw_text_ok
      USING    ls_txt-dtxt
      CHANGING lv_raw lv_ok.
    IF lv_ok <> abap_true OR lv_raw IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_source
      USING    lv_raw
      CHANGING lv_probe.
    IF lv_probe = 'FROM' OR lv_probe = 'TO'
       OR lv_probe = 'LOW' OR lv_probe = 'HIGH'
       OR lv_probe = 'LOWER_LIMIT' OR lv_probe = 'UPPER_LIMIT'
       OR lv_probe = 'LOW_VALUE' OR lv_probe = 'HIGH_VALUE'.
      CONTINUE.
    ENDIF.

    IF lv_best_set <> abap_true OR ls_pos-coln > lv_best_col.
      lv_best_col = ls_pos-coln.
      lv_best_raw = lv_raw.
      lv_best_set = abap_true.
      CLEAR lv_tie.
    ELSEIF ls_pos-coln = lv_best_col AND lv_raw <> lv_best_raw.
      lv_tie = abap_true.
    ENDIF.
  ENDLOOP.

  IF lv_best_set = abap_true AND lv_tie <> abap_true.
    cv_text = lv_best_raw.
    cv_found = abap_true.
    RETURN.
  ENDIF.

 "Authority 2: translated native STXT from the same row. This covers static
 "texts whose generated name has no separate D021T row on this release.
  CLEAR: lv_best_raw, lv_best_col, lv_best_set, lv_tie.
  LOOP AT lt_fld INTO ls_pos.
    IF ls_pos-line <> ls_low-line OR ls_pos-coln >= ls_low-coln.
      CONTINUE.
    ENDIF.
    IF ls_pos-fnam = ls_low-fnam OR ls_pos-stxt IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_raw, lv_ok, lv_probe.
    PERFORM raw_text_ok
      USING    ls_pos-stxt
      CHANGING lv_raw lv_ok.
    IF lv_ok <> abap_true OR lv_raw IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_source
      USING    lv_raw
      CHANGING lv_probe.
    IF lv_probe = 'FROM' OR lv_probe = 'TO'
       OR lv_probe = 'LOW' OR lv_probe = 'HIGH'
       OR lv_probe = 'LOWER_LIMIT' OR lv_probe = 'UPPER_LIMIT'
       OR lv_probe = 'LOW_VALUE' OR lv_probe = 'HIGH_VALUE'.
      CONTINUE.
    ENDIF.

    IF lv_best_set <> abap_true OR ls_pos-coln > lv_best_col.
      lv_best_col = ls_pos-coln.
      lv_best_raw = lv_raw.
      lv_best_set = abap_true.
      CLEAR lv_tie.
    ELSEIF ls_pos-coln = lv_best_col AND lv_raw <> lv_best_raw.
      lv_tie = abap_true.
    ENDIF.
  ENDLOOP.

  IF lv_best_set = abap_true AND lv_tie <> abap_true.
    cv_text = lv_best_raw.
    cv_found = abap_true.
    RETURN.
  ENDIF.

 "Authority 3: if the exact owner subscreen contains only one meaningful
 "translated static caption after structural connector words are removed,
 "that caption is unambiguous even when generated screen coordinates differ.
  REFRESH lt_labels.
  LOOP AT lt_txt INTO ls_txt.
    CLEAR: lv_raw, lv_ok, lv_probe.
    PERFORM raw_text_ok
      USING    ls_txt-dtxt
      CHANGING lv_raw lv_ok.
    IF lv_ok <> abap_true OR lv_raw IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM normalize_mapping_source
      USING    lv_raw
      CHANGING lv_probe.
    IF lv_probe = 'FROM' OR lv_probe = 'TO'
       OR lv_probe = 'LOW' OR lv_probe = 'HIGH'
       OR lv_probe = 'LOWER_LIMIT' OR lv_probe = 'UPPER_LIMIT'
       OR lv_probe = 'LOW_VALUE' OR lv_probe = 'HIGH_VALUE'.
      CONTINUE.
    ENDIF.
    INSERT lv_raw INTO TABLE lt_labels.
  ENDLOOP.

  DESCRIBE TABLE lt_labels LINES lv_count.
  IF lv_count = 1.
    READ TABLE lt_labels INTO cv_text INDEX 1.
    IF sy-subrc = 0 AND cv_text IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
  ENDIF.
ENDFORM.

*& Context-bound selection/range caption resolver

*& Imported SHDB TXT can serialize generated RANGE fields such as PREFIX-LOW
*& / PREFIX-HIGH while the visible caption belongs to a generated subscreen.
*& The technical RANGE variable name is not always the Selection Text key.
*& Resolve only from evidence carried by the same recording:
*& 1) exact BDC_SUBSCR owner program + subscreen role suffix;
*& 2) exact RANGE prefix with generic structural prefix removed;
*& 3) exact RANGE prefix when it fits the 8-char selection-text key.
*& Every candidate is looked up as TEXTPOOL ID 'S' in SY-LANGU. No TCODE,
*& program, field, or business caption is hardcoded.

FORM seltext_key
  USING    iv_prog TYPE any
           iv_key  TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  DATA: lv_prog TYPE rs38m-programm,
        lv_key  TYPE textpool-key,
        lv_raw  TYPE char80,
        lv_ok   TYPE abap_bool,
        ls_pool TYPE textpool.
  DATA lt_pool TYPE STANDARD TABLE OF textpool.

  CLEAR: cv_text, cv_found.
  lv_prog = iv_prog.
  lv_key  = iv_key.
  CONDENSE lv_prog NO-GAPS.
  CONDENSE lv_key  NO-GAPS.
  TRANSLATE lv_key TO UPPER CASE.
  IF lv_prog IS INITIAL OR lv_key IS INITIAL.
    RETURN.
  ENDIF.

  REFRESH lt_pool.
  CALL FUNCTION 'RS_TEXTPOOL_READ'
    EXPORTING
      objectname           = lv_prog
      action               = 'SHOW'
      authority_check      = space
      language             = sy-langu
    TABLES
      tpool                = lt_pool
    EXCEPTIONS
      object_not_found     = 1
      permission_failure   = 2
      invalid_program_type = 3
      error_occured        = 4
      action_cancelled     = 5
      OTHERS               = 6.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  LOOP AT lt_pool INTO ls_pool WHERE id = 'S'.
    IF ls_pool-key <> lv_key.
      CONTINUE.
    ENDIF.

    lv_raw = ls_pool-entry.
 "Maintained selection texts can be left padded. RS_TEXTPOOL_READ resolves
 "Dictionary-backed texts, so a real caption beginning with 'D' must remain.
    SHIFT lv_raw LEFT DELETING LEADING space.
    CLEAR lv_ok.
    PERFORM raw_text_ok
      USING    lv_raw
      CHANGING lv_raw lv_ok.
    IF lv_ok = abap_true AND lv_raw IS NOT INITIAL.
      cv_text = lv_raw.
      cv_found = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

FORM dtel_key_label
  USING    iv_key TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  DATA: lv_name TYPE rollname,
        ls_dtel TYPE dd04v,
        lv_raw  TYPE char80,
        lv_ok   TYPE abap_bool.

  CLEAR: cv_text, cv_found.
  lv_name = iv_key.
  CONDENSE lv_name NO-GAPS.
  TRANSLATE lv_name TO UPPER CASE.
  IF lv_name IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR ls_dtel.
  CALL FUNCTION 'DDIF_DTEL_GET'
    EXPORTING
      name          = lv_name
      state         = 'A'
      langu         = sy-langu
    IMPORTING
      dd04v_wa      = ls_dtel
    EXCEPTIONS
      illegal_input = 1
      OTHERS        = 2.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  lv_raw = ls_dtel-scrtext_l.
  IF lv_raw IS INITIAL.
    lv_raw = ls_dtel-ddtext.
  ENDIF.
  IF lv_raw IS INITIAL.
    lv_raw = ls_dtel-reptext.
  ENDIF.
  IF lv_raw IS INITIAL.
    lv_raw = ls_dtel-scrtext_m.
  ENDIF.

  CLEAR lv_ok.
  PERFORM raw_text_ok
    USING    lv_raw
    CHANGING lv_raw lv_ok.
  IF lv_ok = abap_true AND lv_raw IS NOT INITIAL.
    cv_text = lv_raw.
    cv_found = abap_true.
  ENDIF.
ENDFORM.

FORM range_ctx_cap
  USING    pt_script TYPE ty_t_script
           iv_bdc    TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  TYPES: BEGIN OF ty_z682_ctx,
           prog TYPE d020s-prog,
           key1 TYPE textpool-key,
           key2 TYPE textpool-key,
           key3 TYPE textpool-key,
         END OF ty_z682_ctx.

  DATA: ls_script     TYPE ty_script_def_compat,
        ls_ctx        TYPE ty_z682_ctx,
        lv_target     TYPE zbdc_mapping_bup-bdc_field,
        lv_target_log TYPE zbdc_mapping_bup-bdc_field,
        lv_name       TYPE zbdc_mapping_bup-bdc_field,
        lv_name_log   TYPE zbdc_mapping_bup-bdc_field,
        lv_left       TYPE string,
        lv_leaf       TYPE string,
        lv_tail       TYPE string,
        lv_short      TYPE string,
        lv_main_prog  TYPE d020s-prog,
        lv_sub_raw    TYPE string,
        lv_sub_prog   TYPE d020s-prog,
        lv_sub_dyn    TYPE d020s-dnum,
        lv_sub_len    TYPE i,
        lv_raw        TYPE char80,
        lv_hit        TYPE abap_bool,
        lv_probe      TYPE zbdc_mapping_bup-source_column,
        lv_count      TYPE i.

  DATA: lt_ctx TYPE SORTED TABLE OF ty_z682_ctx
               WITH UNIQUE KEY prog key1 key2 key3,
        lt_labels TYPE SORTED TABLE OF char80
                  WITH UNIQUE KEY table_line,
        lt_clean TYPE SORTED TABLE OF char80
                 WITH UNIQUE KEY table_line.

  CLEAR: cv_text, cv_found.
  PERFORM exact_field_key
    USING    iv_bdc
    CHANGING lv_target.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_target WITH ''.
  IF lv_target NS '-'.
    RETURN.
  ENDIF.
  SPLIT lv_target AT '-' INTO lv_left lv_leaf.
  TRANSLATE lv_leaf TO UPPER CASE.
  CONDENSE lv_left NO-GAPS.
  CONDENSE lv_leaf NO-GAPS.
  IF lv_leaf <> 'LOW' AND lv_leaf <> 'HIGH'.
    RETURN.
  ENDIF.

  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_log.
  IF lv_target_log IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_main_prog, lv_sub_raw, lv_sub_prog, lv_sub_dyn.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_main_prog = ls_script-program_name.
      CLEAR: lv_sub_raw, lv_sub_prog, lv_sub_dyn.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name = 'BDC_SUBSCR'
       AND ls_script-static_value IS NOT INITIAL.
      lv_sub_raw = ls_script-static_value.
      lv_sub_len = strlen( lv_sub_raw ).
      CLEAR: lv_sub_prog, lv_sub_dyn.
      IF lv_sub_len >= 44.
        lv_sub_prog = lv_sub_raw(40).
        lv_sub_dyn  = lv_sub_raw+40(4).
        CONDENSE lv_sub_prog NO-GAPS.
        CONDENSE lv_sub_dyn  NO-GAPS.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name IS INITIAL
       OR ls_script-field_name CP 'BDC_*'
       OR ls_script-field_name CP 'DYN_*'.
      CONTINUE.
    ENDIF.

    CLEAR: lv_name, lv_name_log.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_name.
    PERFORM logical_bdc_key
      USING    lv_name
      CHANGING lv_name_log.
    IF lv_name_log <> lv_target_log.
      CONTINUE.
    ENDIF.

    CLEAR ls_ctx.
    IF lv_sub_prog IS NOT INITIAL.
      ls_ctx-prog = lv_sub_prog.
    ELSE.
      ls_ctx-prog = lv_main_prog.
    ENDIF.
    IF ls_ctx-prog IS INITIAL.
      CONTINUE.
    ENDIF.

 "Strongest key: generated subscreen role after 40-char program + 4-char
 "dynpro, e.g. SUBS_BUKRS / SUBS_ACCOUNTS.
    CLEAR lv_tail.
    lv_sub_len = strlen( lv_sub_raw ).
    IF lv_sub_len > 44.
      lv_tail = lv_sub_raw+44.
      TRANSLATE lv_tail TO UPPER CASE.
      CONDENSE lv_tail NO-GAPS.
      IF lv_tail CP 'SUBSCREEN_*'.
        lv_tail = lv_tail+10.
      ELSEIF lv_tail CP 'SUBS_*'.
        lv_tail = lv_tail+5.
      ELSEIF lv_tail CP 'SUB_*'.
        lv_tail = lv_tail+4.
      ENDIF.
      REPLACE ALL OCCURRENCES OF '-' IN lv_tail WITH '_'.
      IF lv_tail IS NOT INITIAL AND strlen( lv_tail ) <= 8.
        ls_ctx-key1 = lv_tail.
      ENDIF.
    ENDIF.

 "Second key: strip only generic RANGE/selection structural prefixes.
    lv_short = lv_left.
    TRANSLATE lv_short TO UPPER CASE.
    IF lv_short CP 'RNG_*'.
      lv_short = lv_short+4.
    ELSEIF lv_short CP 'RANGE_*'.
      lv_short = lv_short+6.
    ELSEIF lv_short CP 'SEL_*'.
      lv_short = lv_short+4.
    ELSEIF lv_short CP 'S_*'.
      lv_short = lv_short+2.
    ENDIF.
    CONDENSE lv_short NO-GAPS.
    IF lv_short IS NOT INITIAL AND strlen( lv_short ) <= 8.
      ls_ctx-key2 = lv_short.
    ENDIF.

    IF lv_left IS NOT INITIAL AND strlen( lv_left ) <= 8.
      ls_ctx-key3 = lv_left.
      TRANSLATE ls_ctx-key3 TO UPPER CASE.
    ENDIF.
    INSERT ls_ctx INTO TABLE lt_ctx.
  ENDLOOP.

  LOOP AT lt_ctx INTO ls_ctx.
    IF ls_ctx-key1 IS NOT INITIAL.
      CLEAR: lv_raw, lv_hit.
      PERFORM seltext_key
        USING    ls_ctx-prog ls_ctx-key1
        CHANGING lv_raw lv_hit.
      IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
        INSERT lv_raw INTO TABLE lt_labels.
      ELSE.
        CLEAR: lv_raw, lv_hit.
        PERFORM dtel_key_label
          USING    ls_ctx-key1
          CHANGING lv_raw lv_hit.
        IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
          INSERT lv_raw INTO TABLE lt_labels.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lt_labels IS INITIAL AND ls_ctx-key2 IS NOT INITIAL.
      CLEAR: lv_raw, lv_hit.
      PERFORM seltext_key
        USING    ls_ctx-prog ls_ctx-key2
        CHANGING lv_raw lv_hit.
      IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
        INSERT lv_raw INTO TABLE lt_labels.
      ELSE.
        CLEAR: lv_raw, lv_hit.
        PERFORM dtel_key_label
          USING    ls_ctx-key2
          CHANGING lv_raw lv_hit.
        IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
          INSERT lv_raw INTO TABLE lt_labels.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lt_labels IS INITIAL AND ls_ctx-key3 IS NOT INITIAL.
      CLEAR: lv_raw, lv_hit.
      PERFORM seltext_key
        USING    ls_ctx-prog ls_ctx-key3
        CHANGING lv_raw lv_hit.
      IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
        INSERT lv_raw INTO TABLE lt_labels.
      ENDIF.
    ENDIF.
  ENDLOOP.

 "never publish a BDC_SUBSCR role token as a business caption.
 "The role suffix remains a LOOKUP KEY only. If SAP does not provide a
 "translated Selection Text/DDIC/screen caption, leave the label unresolved
 "and let the confirmation path fail closed instead of showing BUKRS,
 "ACCOUNTS, RNG_* or another technical surrogate.

  REFRESH lt_clean.
  LOOP AT lt_labels INTO lv_raw.
    CLEAR lv_probe.
    PERFORM normalize_mapping_source
      USING    lv_raw
      CHANGING lv_probe.
    IF lv_probe = 'FROM' OR lv_probe = 'TO'
       OR lv_probe = 'LOW' OR lv_probe = 'HIGH'
       OR lv_probe = 'LOWER_LIMIT' OR lv_probe = 'UPPER_LIMIT'.
      CONTINUE.
    ENDIF.
    INSERT lv_raw INTO TABLE lt_clean.
  ENDLOOP.

  DESCRIBE TABLE lt_clean LINES lv_count.
  IF lv_count = 1.
    READ TABLE lt_clean INTO cv_text INDEX 1.
    IF sy-subrc = 0 AND cv_text IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
  ENDIF.
ENDFORM.

FORM screen_label_from_dynpro_ctx
  USING    pt_script TYPE ty_t_script
           iv_bdc    TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  TYPES: BEGIN OF ty_z665_ctx,
           prog TYPE d020s-prog,
           dyn  TYPE d020s-dnum,
         END OF ty_z665_ctx.

  DATA: ls_script      TYPE ty_script_def_compat,
        ls_ctx         TYPE ty_z665_ctx,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_target_log  TYPE zbdc_mapping_bup-bdc_field,
        lv_name        TYPE zbdc_mapping_bup-bdc_field,
        lv_name_log    TYPE zbdc_mapping_bup-bdc_field,
        lv_main_prog   TYPE d020s-prog,
        lv_main_dyn    TYPE d020s-dnum,
        lv_sub_raw     TYPE string,
        lv_sub_prog    TYPE d020s-prog,
        lv_sub_dyn     TYPE d020s-dnum,
        lv_sub_len     TYPE i,
        lv_raw         TYPE char80,
        lv_hit         TYPE abap_bool,
        lv_count       TYPE i.

  DATA: lt_ctx TYPE SORTED TABLE OF ty_z665_ctx
               WITH UNIQUE KEY prog dyn,
        lt_labels TYPE SORTED TABLE OF char80
                  WITH UNIQUE KEY table_line.

  CLEAR: cv_text, cv_found.
  PERFORM exact_field_key
    USING    iv_bdc
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_log.
  IF lv_target_log IS INITIAL OR pt_script IS INITIAL.
    RETURN.
  ENDIF.

 "generated LOW/HIGH controls need the exact BDC_SUBSCR context;
 "their visible caption may not be keyed by the RANGE variable itself.
  CLEAR: lv_raw, lv_hit.
  PERFORM range_ctx_cap
    USING    pt_script lv_target
    CHANGING lv_raw lv_hit.
  IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
    cv_text = lv_raw.
    cv_found = abap_true.
    RETURN.
  ENDIF.

  CLEAR: lv_main_prog, lv_main_dyn, lv_sub_prog, lv_sub_dyn.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_main_prog = ls_script-program_name.
      lv_main_dyn  = ls_script-dynpro_no.
      CLEAR: lv_sub_prog, lv_sub_dyn.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name = 'BDC_SUBSCR'
       AND ls_script-static_value IS NOT INITIAL.
      lv_sub_raw = ls_script-static_value.
      lv_sub_len = strlen( lv_sub_raw ).
      IF lv_sub_len >= 44.
        lv_sub_prog = lv_sub_raw(40).
        lv_sub_dyn  = lv_sub_raw+40(4).
        CONDENSE lv_sub_prog NO-GAPS.
        CONDENSE lv_sub_dyn NO-GAPS.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name IS INITIAL
       OR ls_script-field_name CP 'BDC_*'
       OR ls_script-field_name CP 'DYN_*'.
      CONTINUE.
    ENDIF.

    CLEAR: lv_name, lv_name_log.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_name.
    PERFORM logical_bdc_key
      USING    lv_name
      CHANGING lv_name_log.
    IF lv_name_log <> lv_target_log.
      CONTINUE.
    ENDIF.

    IF lv_sub_prog IS NOT INITIAL AND lv_sub_dyn IS NOT INITIAL.
 "When BDC_SUBSCR immediately precedes the field sequence, it is the
 "replay-declared owner screen. Do not mix an outer-screen label into it.
      CLEAR ls_ctx.
      ls_ctx-prog = lv_sub_prog.
      ls_ctx-dyn  = lv_sub_dyn.
      INSERT ls_ctx INTO TABLE lt_ctx.
    ELSEIF lv_main_prog IS NOT INITIAL AND lv_main_dyn IS NOT INITIAL.
      CLEAR ls_ctx.
      ls_ctx-prog = lv_main_prog.
      ls_ctx-dyn  = lv_main_dyn.
      INSERT ls_ctx INTO TABLE lt_ctx.
    ENDIF.
  ENDLOOP.

  LOOP AT lt_ctx INTO ls_ctx.
    CLEAR: lv_raw, lv_hit.
    PERFORM rpy_label_raw
      USING    ls_ctx-prog ls_ctx-dyn lv_target
      CHANGING lv_raw lv_hit.
    IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
      INSERT lv_raw INTO TABLE lt_labels.
    ENDIF.
  ENDLOOP.

  DESCRIBE TABLE lt_labels LINES lv_count.
  IF lv_count = 1.
    READ TABLE lt_labels INTO cv_text INDEX 1.
    IF sy-subrc = 0 AND cv_text IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
  ENDIF.
ENDFORM.

FORM pick_friendly
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column.

 "this routine is retained for existing callers but no longer
 "manufactures a friendly alias from DDIC/technical/action tokens.
  CLEAR cv_source.
  PERFORM base_tpl_name
    USING    pt_script iv_field
    CHANGING cv_source.
ENDFORM.

*& Generic replay-controller-state guard

*& Static Screen Painter INPUT is necessary but not sufficient: SAP can keep
*& hidden/current-row controller fields technically editable so BDCDATA replay
*& can restore UI state. This guard removes only a narrow, structurally proven
*& controller-state class and never uses TCODE/application-specific knowledge.

*& A field is replay-only controller state only when ALL are true:
*& no direct cursor interaction exists for the exact field;
*& the technical leaf carries a generic controller/navigation compound
*& (current/detail row/line/index/tab/page/scroll semantics);
*& the same exact field is serialized at least twice;
*& all nonblank serialized values are the same small numeric selector.

*& This deliberately does NOT classify ordinary DATE/QUANTITY/UNIT/business
*& controls by absence of cursor. Those remain confirmable when SAP metadata
*& proves they are visible/editable on the captured screen.

FORM controller_state
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_state  TYPE abap_bool.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_exact       TYPE zbdc_mapping_bup-bdc_field,
        lv_direct      TYPE abap_bool,
        lv_direct_msg  TYPE string,
        lv_leaf        TYPE string,
        lv_left        TYPE string,
        lv_dummy       TYPE string,
        lv_value       TYPE string,
        lv_probe       TYPE string,
        lv_token       TYPE abap_bool,
        lv_all_small   TYPE abap_bool VALUE abap_true,
        lv_occ         TYPE i,
        lv_nonblank    TYPE i,
        lv_distinct    TYPE i,
        lv_int         TYPE i.

  DATA lt_values TYPE SORTED TABLE OF string WITH UNIQUE KEY table_line.

  CLEAR cv_state.
  PERFORM exact_field_key
    USING    iv_field
    CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_direct, lv_direct_msg.
  PERFORM exact_pai_cursor_ev
    USING    pt_script lv_target
    CHANGING lv_direct lv_direct_msg.
  IF lv_direct = abap_true.
    RETURN.
  ENDIF.

  lv_leaf = lv_target.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_leaf WITH ''.
  IF lv_leaf CS '-'.
    SPLIT lv_leaf AT '-' INTO lv_left lv_leaf.
  ENDIF.
  IF lv_leaf CS '('.
    SPLIT lv_leaf AT '(' INTO lv_leaf lv_dummy.
  ENDIF.
  TRANSLATE lv_leaf TO UPPER CASE.
  CONDENSE lv_leaf NO-GAPS.

 "Generic controller/navigation compounds only. A plain LINE/ROW business
 "label is intentionally NOT sufficient by itself.
  IF lv_leaf CS 'DETAIL_ZEILE'
     OR lv_leaf CS 'DETAIL_LINE'
     OR lv_leaf CS 'DETAIL_ROW'
     OR lv_leaf CS 'CURRENT_ZEILE'
     OR lv_leaf CS 'CURRENT_LINE'
     OR lv_leaf CS 'CURRENT_ROW'
     OR lv_leaf CS 'CURR_ZEILE'
     OR lv_leaf CS 'CURR_LINE'
     OR lv_leaf CS 'CURR_ROW'
     OR lv_leaf CS 'ROW_INDEX'
     OR lv_leaf CS 'LINE_INDEX'
     OR lv_leaf CS 'ROW_IDX'
     OR lv_leaf CS 'LINE_IDX'
     OR lv_leaf CS 'SEL_ROW'
     OR lv_leaf CS 'SEL_LINE'
     OR lv_leaf CS 'SELECTED_ROW'
     OR lv_leaf CS 'SELECTED_LINE'
     OR lv_leaf CS 'TABIX'
     OR lv_leaf CS 'ACTIVE_TAB'
     OR lv_leaf CS 'TAB_PAGE'
     OR lv_leaf CS 'TAB_INDEX'
     OR lv_leaf CS 'TAB_IDX'
     OR lv_leaf CS 'SCROLL_POS'
     OR lv_leaf CS 'SCROLL_POSITION'
     OR lv_leaf CS 'PAGE_INDEX'.
    lv_token = abap_true.
  ENDIF.
  IF lv_token <> abap_true.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    CLEAR lv_exact.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_exact.
    IF lv_exact <> lv_target.
      CONTINUE.
    ENDIF.

    lv_occ = lv_occ + 1.
    lv_value = ls_script-static_value.
    CONDENSE lv_value NO-GAPS.
    IF lv_value IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_nonblank = lv_nonblank + 1.
    INSERT lv_value INTO TABLE lt_values.

    lv_probe = lv_value.
    IF strlen( lv_probe ) > 9 OR lv_probe CN '0123456789'.
      lv_all_small = abap_false.
      CONTINUE.
    ENDIF.
    lv_int = lv_probe.
    IF lv_int < 0 OR lv_int > 9999.
      lv_all_small = abap_false.
    ENDIF.
  ENDLOOP.

  DESCRIBE TABLE lt_values LINES lv_distinct.
  IF lv_occ >= 2
     AND lv_nonblank >= 1
     AND lv_distinct = 1
     AND lv_all_small = abap_true.
    cv_state = abap_true.
  ENDIF.
ENDFORM.

*& Static input-capability authority for recorded SAP fields

*& Plain SHDB BDCDATA contains both user-enterable controls and screen state
*& that SAP serializes only so replay can restore the current UI context. A
*& non-BDC field therefore is not automatically a Template candidate.

*& This resolver is deliberately fail-open for completeness:
*& when exact Screen Painter metadata proves ANY occurrence is enterable,
*& the field is input-capable;
*& when metadata resolves the field but EVERY occurrence is non-input /
*& output-only, the field is replay-only screen state;
*& when metadata cannot resolve the field, KNOWN remains blank so the caller
*& keeps it in the confirmation inventory rather than risk a false omission.

*& No TCODE, program family, application field, sample value or field-name
*& pattern is used as business knowledge.

FORM static_input_cap
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_known  TYPE abap_bool
           cv_input  TYPE abap_bool.

  TYPES: BEGIN OF ty_z673_ctx,
           prog TYPE d020s-prog,
           dyn  TYPE d020s-dnum,
         END OF ty_z673_ctx.

  DATA: ls_script      TYPE ty_script_def_compat,
        ls_ctx         TYPE ty_z673_ctx,
        ls_head        TYPE rpy_dyhead,
        ls_ext         TYPE rpy_dyfatc,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_target_log  TYPE zbdc_mapping_bup-bdc_field,
        lv_name        TYPE zbdc_mapping_bup-bdc_field,
        lv_name_log    TYPE zbdc_mapping_bup-bdc_field,
        lv_main_prog   TYPE d020s-prog,
        lv_main_dyn    TYPE d020s-dnum,
        lv_sub_raw     TYPE string,
        lv_sub_prog    TYPE d020s-prog,
        lv_sub_dyn     TYPE d020s-dnum,
        lv_sub_len     TYPE i,
        lv_block_hit   TYPE abap_bool,
        lv_direct      TYPE abap_bool,
        lv_direct_msg  TYPE string,
        lv_ctrl_state  TYPE abap_bool.

  DATA: lt_ctx TYPE SORTED TABLE OF ty_z673_ctx
               WITH UNIQUE KEY prog dyn,
        lt_block_ctx TYPE SORTED TABLE OF ty_z673_ctx
                     WITH UNIQUE KEY prog dyn,
        lt_ext TYPE dyfatc_tab.

  FIELD-SYMBOLS: <lv_input_fld>  TYPE any,
                 <lv_outputonly> TYPE any,
                 <lv_requ_entry> TYPE any,
                 <lv_invisible>  TYPE any.

  CLEAR: cv_known, cv_input.
  PERFORM exact_field_key
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_log.
  IF lv_target_log IS INITIAL OR pt_script IS INITIAL.
    RETURN.
  ENDIF.

 "cursor is interaction evidence only. It is a final fallback when
 "repository metadata cannot resolve the exact control at all; cursor never
 "supplies a business label and never rewrites the raw BDCDATA stream.
  CLEAR: lv_direct, lv_direct_msg.
  PERFORM exact_pai_cursor_ev
    USING    pt_script lv_target
    CHANGING lv_direct lv_direct_msg.

 "owner authority: BDC_SUBSCR is replay choreography, not a proof that
 "every later field belongs to one latest subscreen. For each recorded dynpro
 "block collect the exact host PROGRAM/DYNPRO plus every exact BDC_SUBSCR
 "PROGRAM/DYNPRO in that same block. Only blocks that actually serialize the
 "target logical field contribute candidate owners. RPY_DYNPRO_READ then proves
 "which owner really contains the field and whether it is enterable/visible.
  CLEAR: lv_main_prog, lv_main_dyn, lv_sub_prog, lv_sub_dyn,
         lv_block_hit.
  REFRESH lt_block_ctx.

  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      IF lv_block_hit = abap_true.
        LOOP AT lt_block_ctx INTO ls_ctx.
          INSERT ls_ctx INTO TABLE lt_ctx.
        ENDLOOP.
      ENDIF.

      REFRESH lt_block_ctx.
      CLEAR: lv_block_hit, lv_sub_prog, lv_sub_dyn, lv_sub_raw.
      lv_main_prog = ls_script-program_name.
      lv_main_dyn  = ls_script-dynpro_no.
      CONDENSE lv_main_prog NO-GAPS.
      CONDENSE lv_main_dyn  NO-GAPS.
      IF lv_main_prog IS NOT INITIAL AND lv_main_dyn IS NOT INITIAL.
        CLEAR ls_ctx.
        ls_ctx-prog = lv_main_prog.
        ls_ctx-dyn  = lv_main_dyn.
        INSERT ls_ctx INTO TABLE lt_block_ctx.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name = 'BDC_SUBSCR'
       AND ls_script-static_value IS NOT INITIAL.
      lv_sub_raw = ls_script-static_value.
      lv_sub_len = strlen( lv_sub_raw ).
      CLEAR: lv_sub_prog, lv_sub_dyn.
      IF lv_sub_len >= 44.
        lv_sub_prog = lv_sub_raw(40).
        lv_sub_dyn  = lv_sub_raw+40(4).
        CONDENSE lv_sub_prog NO-GAPS.
        CONDENSE lv_sub_dyn  NO-GAPS.
        IF lv_sub_prog IS NOT INITIAL AND lv_sub_dyn IS NOT INITIAL.
          CLEAR ls_ctx.
          ls_ctx-prog = lv_sub_prog.
          ls_ctx-dyn  = lv_sub_dyn.
          INSERT ls_ctx INTO TABLE lt_block_ctx.
        ENDIF.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name IS INITIAL
       OR ls_script-field_name CP 'BDC_*'
       OR ls_script-field_name CP 'DYN_*'.
      CONTINUE.
    ENDIF.

    CLEAR: lv_name, lv_name_log.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_name.
    PERFORM logical_bdc_key
      USING    lv_name
      CHANGING lv_name_log.
    IF lv_name_log = lv_target_log.
      lv_block_hit = abap_true.
    ENDIF.
  ENDLOOP.

  IF lv_block_hit = abap_true.
    LOOP AT lt_block_ctx INTO ls_ctx.
      INSERT ls_ctx INTO TABLE lt_ctx.
    ENDLOOP.
  ENDIF.

  LOOP AT lt_ctx INTO ls_ctx.
    REFRESH lt_ext.
    CLEAR ls_head.
    CALL FUNCTION 'RPY_DYNPRO_READ'
      EXPORTING
        progname             = ls_ctx-prog
        dynnr                = ls_ctx-dyn
        suppress_corr_checks = 'X'
      IMPORTING
        header               = ls_head
      TABLES
        fields_to_containers = lt_ext
      EXCEPTIONS
        cancelled            = 1
        not_found            = 2
        permission_error     = 3
        OTHERS               = 4.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    LOOP AT lt_ext INTO ls_ext.
      CLEAR: lv_name, lv_name_log.
      PERFORM exact_field_key
        USING    ls_ext-name
        CHANGING lv_name.
      PERFORM logical_bdc_key
        USING    lv_name
        CHANGING lv_name_log.
      IF lv_name_log <> lv_target_log.
        CONTINUE.
      ENDIF.

      cv_known = abap_true.
      IF ls_ext-type = 'TEXT'
         OR ls_ext-type = 'FRAME'
         OR ls_ext-type = 'FRAME_TMPL'
         OR ls_ext-type = 'PUSH'
         OR ls_ext-type = 'PUSH_TMPL'
         OR ls_ext-type = 'INFOBUTTON'
         OR ls_ext-type = 'OKCODE'.
        CONTINUE.
      ENDIF.

      UNASSIGN: <lv_input_fld>, <lv_outputonly>, <lv_requ_entry>,
                <lv_invisible>.
      ASSIGN COMPONENT 'INPUT_FLD' OF STRUCTURE ls_ext TO <lv_input_fld>.
      ASSIGN COMPONENT 'OUTPUTONLY' OF STRUCTURE ls_ext TO <lv_outputonly>.
      ASSIGN COMPONENT 'REQU_ENTRY' OF STRUCTURE ls_ext TO <lv_requ_entry>.
      ASSIGN COMPONENT 'INVISIBLE' OF STRUCTURE ls_ext TO <lv_invisible>.

      IF <lv_invisible> IS ASSIGNED AND <lv_invisible> IS NOT INITIAL.
        CONTINUE.
      ENDIF.
      IF <lv_input_fld> IS ASSIGNED AND <lv_input_fld> IS INITIAL.
        CONTINUE.
      ENDIF.
      IF <lv_outputonly> IS ASSIGNED AND <lv_outputonly> IS NOT INITIAL.
        CONTINUE.
      ENDIF.
      IF <lv_requ_entry> IS ASSIGNED AND <lv_requ_entry> = 'N'.
        CONTINUE.
      ENDIF.
      IF ls_ext-vislength <= 0 AND ls_ext-length <= 0.
        CONTINUE.
      ENDIF.

      CLEAR lv_ctrl_state.
      PERFORM controller_state
        USING    pt_script lv_target
        CHANGING lv_ctrl_state.
      IF lv_ctrl_state = abap_true.
        CONTINUE.
      ENDIF.

      cv_input = abap_true.
      RETURN.
    ENDLOOP.
  ENDLOOP.

  IF cv_input <> abap_true AND lv_direct = abap_true.
    cv_known = abap_true.
    cv_input = abap_true.
  ENDIF.
ENDFORM.

*& Exact captured-screen input inventory

*& Purpose:
*& Read exact SAP repository metadata for host PROGRAM/DYNPRO and exact
*& BDC_SUBSCR screens present in the current recording. From this
*& metadata is descriptive evidence only: it may label/validate a candidate
*& already proven by raw/native executable evidence, but it cannot create a
*& selectable Template candidate by itself.

*& Safety / no-guess rules:
*& no TCODE/application/field-name hardcode;
*& no value-based inference and no AI;
*& TEXT/FRAME/PUSH/OKCODE and invisible/output-only/non-input controls are
*& excluded only when RPY_DYNPRO_READ proves that status;
*& exact labels come from the exact owner screen; conflicting screen labels
*& are not guessed, and exact DDIC label is the only semantic fallback;
*& a screen-only candidate still cannot become executable unless the later
*& raw replay-binding invariant proves a real BDC binding.

FORM collect_screen_inputs
  USING    pt_script TYPE ty_t_script
  CHANGING ct_screen TYPE ty_t_z691_screen_candidate.

  TYPES: BEGIN OF ty_z691_ctx,
           prog TYPE d020s-prog,
           dyn  TYPE d020s-dnum,
         END OF ty_z691_ctx.

  DATA: ls_script      TYPE ty_script_def_compat,
        ls_ctx         TYPE ty_z691_ctx,
        ls_head        TYPE rpy_dyhead,
        ls_ext         TYPE rpy_dyfatc,
        ls_cand        TYPE ty_z691_screen_candidate,
        lv_main_prog   TYPE d020s-prog,
        lv_main_dyn    TYPE d020s-dnum,
        lv_sub_raw     TYPE string,
        lv_sub_prog    TYPE d020s-prog,
        lv_sub_dyn     TYPE d020s-dnum,
        lv_sub_len     TYPE i,
        lv_exact       TYPE zbdc_mapping_bup-bdc_field,
        lv_technical   TYPE abap_bool,
        lv_ctrl_state  TYPE abap_bool,
        lv_raw_label   TYPE char80,
        lv_label_hit   TYPE abap_bool,
        lv_label       TYPE zbdc_mapping_bup-source_column,
        lv_ddic_hit    TYPE abap_bool,
        lv_ddic_name   TYPE zbdc_mapping_bup-source_column,
        lv_context     TYPE string.

  DATA: lt_ctx TYPE SORTED TABLE OF ty_z691_ctx
               WITH UNIQUE KEY prog dyn,
        lt_ext TYPE dyfatc_tab.

  FIELD-SYMBOLS: <ls_cand>       TYPE ty_z691_screen_candidate,
                 <lv_input_fld>  TYPE any,
                 <lv_outputonly> TYPE any,
                 <lv_requ_entry> TYPE any,
                 <lv_invisible>  TYPE any.

  REFRESH ct_screen.
  IF pt_script IS INITIAL.
    RETURN.
  ENDIF.

 "Collect only screen identities literally present in the current capture.
  CLEAR: lv_main_prog, lv_main_dyn, lv_sub_prog, lv_sub_dyn.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_main_prog = ls_script-program_name.
      lv_main_dyn  = ls_script-dynpro_no.
      CONDENSE lv_main_prog NO-GAPS.
      CONDENSE lv_main_dyn  NO-GAPS.
      IF lv_main_prog IS NOT INITIAL AND lv_main_dyn IS NOT INITIAL.
        CLEAR ls_ctx.
        ls_ctx-prog = lv_main_prog.
        ls_ctx-dyn  = lv_main_dyn.
        INSERT ls_ctx INTO TABLE lt_ctx.
      ENDIF.
      CLEAR: lv_sub_prog, lv_sub_dyn.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name = 'BDC_SUBSCR'
       AND ls_script-static_value IS NOT INITIAL.
      lv_sub_raw = ls_script-static_value.
      lv_sub_len = strlen( lv_sub_raw ).
      CLEAR: lv_sub_prog, lv_sub_dyn.
      IF lv_sub_len >= 44.
        lv_sub_prog = lv_sub_raw(40).
        lv_sub_dyn  = lv_sub_raw+40(4).
        CONDENSE lv_sub_prog NO-GAPS.
        CONDENSE lv_sub_dyn  NO-GAPS.
        IF lv_sub_prog IS NOT INITIAL AND lv_sub_dyn IS NOT INITIAL.
          CLEAR ls_ctx.
          ls_ctx-prog = lv_sub_prog.
          ls_ctx-dyn  = lv_sub_dyn.
          INSERT ls_ctx INTO TABLE lt_ctx.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDLOOP.

  LOOP AT lt_ctx INTO ls_ctx.
    REFRESH lt_ext.
    CLEAR ls_head.
    CALL FUNCTION 'RPY_DYNPRO_READ'
      EXPORTING
        progname             = ls_ctx-prog
        dynnr                = ls_ctx-dyn
        suppress_corr_checks = 'X'
      IMPORTING
        header               = ls_head
      TABLES
        fields_to_containers = lt_ext
      EXCEPTIONS
        cancelled            = 1
        not_found            = 2
        permission_error     = 3
        OTHERS               = 4.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    LOOP AT lt_ext INTO ls_ext.
      IF ls_ext-name IS INITIAL
         OR ls_ext-type = 'TEXT'
         OR ls_ext-type = 'FRAME'
         OR ls_ext-type = 'FRAME_TMPL'
         OR ls_ext-type = 'PUSH'
         OR ls_ext-type = 'PUSH_TMPL'
         OR ls_ext-type = 'INFOBUTTON'
         OR ls_ext-type = 'OKCODE'.
        CONTINUE.
      ENDIF.

      UNASSIGN: <lv_input_fld>, <lv_outputonly>, <lv_requ_entry>,
                <lv_invisible>.
      ASSIGN COMPONENT 'INPUT_FLD' OF STRUCTURE ls_ext TO <lv_input_fld>.
      ASSIGN COMPONENT 'OUTPUTONLY' OF STRUCTURE ls_ext TO <lv_outputonly>.
      ASSIGN COMPONENT 'REQU_ENTRY' OF STRUCTURE ls_ext TO <lv_requ_entry>.
      ASSIGN COMPONENT 'INVISIBLE' OF STRUCTURE ls_ext TO <lv_invisible>.

      IF <lv_invisible> IS ASSIGNED AND <lv_invisible> IS NOT INITIAL.
        CONTINUE.
      ENDIF.
      IF <lv_input_fld> IS ASSIGNED AND <lv_input_fld> IS INITIAL.
        CONTINUE.
      ENDIF.
      IF <lv_outputonly> IS ASSIGNED AND <lv_outputonly> IS NOT INITIAL.
        CONTINUE.
      ENDIF.
      IF <lv_requ_entry> IS ASSIGNED AND <lv_requ_entry> = 'N'.
        CONTINUE.
      ENDIF.
      IF ls_ext-vislength <= 0 AND ls_ext-length <= 0.
        CONTINUE.
      ENDIF.

      CLEAR lv_exact.
      PERFORM exact_field_key
        USING    ls_ext-name
        CHANGING lv_exact.
      IF lv_exact IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR lv_technical.
      PERFORM field_choreo_only
        USING    lv_exact
        CHANGING lv_technical.
      IF lv_technical = abap_true.
        CONTINUE.
      ENDIF.

 "Do not re-introduce a narrowly proven replay controller state.
      CLEAR lv_ctrl_state.
      PERFORM controller_state
        USING    pt_script lv_exact
        CHANGING lv_ctrl_state.
      IF lv_ctrl_state = abap_true.
        CONTINUE.
      ENDIF.

      READ TABLE ct_screen ASSIGNING <ls_cand>
        WITH TABLE KEY bdc_field = lv_exact.
      IF sy-subrc <> 0.
        CLEAR ls_cand.
        ls_cand-bdc_field = lv_exact.
        lv_context = |{ ls_ctx-prog }/{ ls_ctx-dyn }|.
        IF strlen( lv_context ) > 60.
          lv_context = lv_context(60).
        ENDIF.
        ls_cand-context = lv_context.
        INSERT ls_cand INTO TABLE ct_screen.
        READ TABLE ct_screen ASSIGNING <ls_cand>
          WITH TABLE KEY bdc_field = lv_exact.
        IF sy-subrc <> 0.
          CONTINUE.
        ENDIF.
      ENDIF.

 "Exact owner-screen label only; conflicting exact labels remain unresolved.
      CLEAR: lv_raw_label, lv_label_hit, lv_label.
      PERFORM rpy_label_strict
        USING    ls_ctx-prog ls_ctx-dyn lv_exact
        CHANGING lv_raw_label lv_label_hit.
      IF lv_label_hit = abap_true AND lv_raw_label IS NOT INITIAL.
        lv_label = lv_raw_label.
        PERFORM normalize_mapping_source
          USING    lv_label
          CHANGING lv_label.
        IF lv_label IS NOT INITIAL.
          IF <ls_cand>-label_ambig = abap_true.
            CONTINUE.
          ELSEIF <ls_cand>-friendly IS INITIAL.
            <ls_cand>-friendly = lv_label.
          ELSEIF <ls_cand>-friendly <> lv_label.
            CLEAR <ls_cand>-friendly.
            <ls_cand>-label_ambig = abap_true.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDLOOP.

 "Exact DDIC label is the only fallback when exact captured screens do not
 "yield one unique label. It is keyed by the exact STRUCTURE-FIELD identity.
  LOOP AT ct_screen ASSIGNING <ls_cand>.
    IF <ls_cand>-friendly IS NOT INITIAL.
      CONTINUE.
    ENDIF.
    CLEAR: lv_ddic_hit, lv_ddic_name.
    PERFORM unique_ddic_name
      USING    pt_script <ls_cand>-bdc_field
      CHANGING lv_ddic_name lv_ddic_hit.
    IF lv_ddic_hit = abap_true AND lv_ddic_name IS NOT INITIAL.
      <ls_cand>-friendly = lv_ddic_name.
    ENDIF.
  ENDLOOP.
ENDFORM.

*& Reference-unit/currency naming safeguard

*& A UNIT/CUKY control is frequently rendered immediately beside its QUAN/CURR
*& partner and has no independent on-screen caption. Structural screen-label
*& discovery can otherwise borrow the partner caption and make two different
*& Template fields look the same. DDIC is authoritative for these reference
*& key types because it identifies the value's own semantic role (for example
*& Unit of Entry) without inventing application meaning.

*& exact host/subscreen owner + strict visual authority

*& A user-facing Template name is accepted only when SAP repository metadata
*& binds a visible label to the exact captured control. Accepted authorities:
*& 1) exact selection text for an exact <name>-LOW/HIGH selection control;
*& 2) exact RPY/translated element text of the captured control;
*& 3) exact table-control heading structurally containing that control;
*& 4) explicit Screen Painter LABELLEFT/LABELRIGHT relationship.

*& Deliberately NOT accepted here:
*& DDIC field/data-element labels as a substitute for what the user saw;
*& nearest-text / one-caption / subscreen-role heuristics;
*& technical BDC field names;
*& function-code/action tokens;
*& numeric suffixes used to hide an unresolved collision.
*& If no exact visible label is provable, the caller must block publication.

FORM rpy_label_strict
  USING    iv_prog TYPE any
           iv_dyn  TYPE any
           iv_bdc  TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  DATA: lv_prog       TYPE d020s-prog,
        lv_dyn        TYPE d020s-dnum,
        lv_target     TYPE zbdc_mapping_bup-bdc_field,
        lv_target_log TYPE zbdc_mapping_bup-bdc_field,
        lv_name       TYPE zbdc_mapping_bup-bdc_field,
        lv_name_log   TYPE zbdc_mapping_bup-bdc_field,
        ls_head       TYPE rpy_dyhead,
        ls_ext        TYPE rpy_dyfatc,
        ls_hdr        TYPE rpy_dyfatc,
        ls_scan       TYPE rpy_dyfatc,
        lv_raw        TYPE char80,
        lv_hit        TYPE abap_bool,
        lv_count      TYPE i,
        lv_tcol       TYPE i,
        lv_hcol       TYPE i,
        lv_hlen       TYPE i,
        lv_hend       TYPE i,
        lv_target_hit TYPE abap_bool,
        lv_tline      TYPE i,
        lv_lline      TYPE i,
        lv_lcol       TYPE i,
        lv_sline      TYPE i,
        lv_scol       TYPE i,
        lv_best_col   TYPE i,
        lv_best_name  TYPE zbdc_mapping_bup-bdc_field.

  DATA: lt_ext TYPE dyfatc_tab,
        lt_labels TYPE SORTED TABLE OF char80
                  WITH UNIQUE KEY table_line.

  CLEAR: cv_text, cv_found.
  lv_prog = iv_prog.
  lv_dyn  = iv_dyn.
  CONDENSE lv_prog NO-GAPS.
  CONDENSE lv_dyn NO-GAPS.
  IF lv_prog IS INITIAL OR lv_dyn IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM exact_field_key
    USING    iv_bdc
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_log.
  IF lv_target_log IS INITIAL.
    RETURN.
  ENDIF.

 "Exact generated selection control: Z680 uses the literal prefix before
 "-LOW/-HIGH as the exact TEXTPOOL selection key. It does not strip RNG_/SEL_
 "or derive a different business key in this strict path.
  CLEAR: lv_raw, lv_hit.
  PERFORM range_seltext_cap
    USING    lv_prog lv_target
    CHANGING lv_raw lv_hit.
  IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
    INSERT lv_raw INTO TABLE lt_labels.
  ENDIF.

  REFRESH lt_ext.
  CLEAR ls_head.
  CALL FUNCTION 'RPY_DYNPRO_READ'
    EXPORTING
      progname             = lv_prog
      dynnr                = lv_dyn
      suppress_corr_checks = 'X'
    IMPORTING
      header               = ls_head
    TABLES
      fields_to_containers = lt_ext
    EXCEPTIONS
      cancelled            = 1
      not_found            = 2
      permission_error     = 3
      OTHERS               = 4.
  IF sy-subrc <> 0 OR lt_ext IS INITIAL.
    DESCRIBE TABLE lt_labels LINES lv_count.
    IF lv_count = 1.
      READ TABLE lt_labels INTO cv_text INDEX 1.
      IF sy-subrc = 0 AND cv_text IS NOT INITIAL.
        cv_found = abap_true.
      ENDIF.
    ENDIF.
    RETURN.
  ENDIF.

  CLEAR: lv_target_hit, lv_tline, lv_tcol.
  LOOP AT lt_ext INTO ls_ext.
    CLEAR: lv_name, lv_name_log.
    PERFORM exact_field_key
      USING    ls_ext-name
      CHANGING lv_name.
    PERFORM logical_bdc_key
      USING    lv_name
      CHANGING lv_name_log.
    IF lv_name_log <> lv_target_log.
      CONTINUE.
    ENDIF.

    IF lv_target_hit IS INITIAL.
      lv_target_hit = abap_true.
      lv_tline = ls_ext-line.
      lv_tcol  = ls_ext-column.
    ENDIF.

 "consume exact RPY screen text only for element types whose TEXT
 "attribute is itself visible wording. TEMPLATE masks are excluded. The
 "language-table reader is fallback only, avoiding two formatting variants
 "of the same real caption being mistaken for a collision.
    IF ls_ext-cont_type <> 'TABLE_CTRL'.
      CLEAR: lv_raw, lv_hit.
 "strict visible-text proof: an arbitrary I/O element may have a
 "repository text-symbol/internal identifier even though that string is
 "not the caption shown to the user. Only element classes whose TEXT is
 "itself a visible control are allowed to contribute here. For them,
 "resolve the translated Screen Painter text in SY-LANGU; do not consume
 "an unqualified I/O-field text as a business label.
      IF ls_ext-type = 'TEXT' OR ls_ext-type = 'CHECK'
         OR ls_ext-type = 'RADIO'.
        PERFORM lang_element_text
          USING    lv_prog lv_dyn ls_ext-name
          CHANGING lv_raw lv_hit.
      ENDIF.
      IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
        INSERT lv_raw INTO TABLE lt_labels.
      ENDIF.
    ENDIF.

 "Exact table-control heading whose horizontal span contains this field.
    IF ls_ext-cont_type = 'TABLE_CTRL'
       AND ls_ext-cont_name IS NOT INITIAL
       AND ls_ext-tc_heading IS INITIAL.
      lv_tcol = ls_ext-column.
      LOOP AT lt_ext INTO ls_hdr.
        IF ls_hdr-cont_type <> 'TABLE_CTRL'
           OR ls_hdr-cont_name <> ls_ext-cont_name
           OR ls_hdr-tc_heading <> 'X'.
          CONTINUE.
        ENDIF.
        lv_hcol = ls_hdr-column.
        lv_hlen = ls_hdr-vislength.
        IF lv_hlen <= 0.
          lv_hlen = ls_hdr-length.
        ENDIF.
        IF lv_hlen <= 0.
          CONTINUE.
        ENDIF.
        lv_hend = lv_hcol + lv_hlen - 1.
        IF lv_tcol < lv_hcol OR lv_tcol > lv_hend.
          CONTINUE.
        ENDIF.
        CLEAR: lv_raw, lv_hit.
 "Exact translated table heading only. Raw RPY TEXT can be a symbol
 "identifier on generated dynpros and is therefore not publication
 "authority under the no-guess contract.
        PERFORM lang_element_text
          USING    lv_prog lv_dyn ls_hdr-name
          CHANGING lv_raw lv_hit.
        IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
          INSERT lv_raw INTO TABLE lt_labels.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDLOOP.

 "Only an explicit LABELLEFT/LABELRIGHT declaration may bind a separate text
 "element to the captured field. No nearest-text geometry fallback is used.
  IF lv_target_hit = abap_true.
    LOOP AT lt_ext INTO ls_ext WHERE type = 'TEXT'.
      IF ls_ext-labelleft IS INITIAL AND ls_ext-labelright IS INITIAL.
        CONTINUE.
      ENDIF.
      lv_lline = ls_ext-line.
      lv_lcol  = ls_ext-column.
      IF lv_lline <> lv_tline.
        CONTINUE.
      ENDIF.

      CLEAR: lv_best_col, lv_best_name.
      IF ls_ext-labelleft = 'X'.
        LOOP AT lt_ext INTO ls_scan.
          lv_sline = ls_scan-line.
          lv_scol  = ls_scan-column.
          IF lv_sline <> lv_tline OR lv_scol <= lv_lcol.
            CONTINUE.
          ENDIF.
          IF ls_scan-type = 'FRAME' OR ls_scan-type = 'TEXT'.
            CONTINUE.
          ENDIF.
          IF lv_best_col = 0 OR lv_scol < lv_best_col.
            lv_best_col = lv_scol.
            lv_best_name = ls_scan-name.
          ENDIF.
        ENDLOOP.
      ELSEIF ls_ext-labelright = 'X'.
        LOOP AT lt_ext INTO ls_scan.
          lv_sline = ls_scan-line.
          lv_scol  = ls_scan-column.
          IF lv_sline <> lv_tline OR lv_scol >= lv_lcol.
            CONTINUE.
          ENDIF.
          IF ls_scan-type = 'FRAME' OR ls_scan-type = 'TEXT'.
            CONTINUE.
          ENDIF.
          IF lv_best_col = 0 OR lv_scol > lv_best_col.
            lv_best_col = lv_scol.
            lv_best_name = ls_scan-name.
          ENDIF.
        ENDLOOP.
      ENDIF.

      CLEAR: lv_name, lv_name_log.
      PERFORM exact_field_key
        USING    lv_best_name
        CHANGING lv_name.
      PERFORM logical_bdc_key
        USING    lv_name
        CHANGING lv_name_log.
      IF lv_name_log <> lv_target_log.
        CONTINUE.
      ENDIF.

 "The explicit LABELLEFT/LABELRIGHT relation already proves that this
 "TEXT element labels the target. Its RPY text is exact visible evidence.
      CLEAR: lv_raw, lv_hit.
 "The LABELLEFT/LABELRIGHT relationship proves ownership; the wording
 "must still come from the translated Screen Painter representation.
      PERFORM lang_element_text
        USING    lv_prog lv_dyn ls_ext-name
        CHANGING lv_raw lv_hit.
      IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
        INSERT lv_raw INTO TABLE lt_labels.
      ENDIF.
    ENDLOOP.
  ENDIF.

  DESCRIBE TABLE lt_labels LINES lv_count.
  IF lv_count = 1.
    READ TABLE lt_labels INTO cv_text INDEX 1.
    IF sy-subrc = 0 AND cv_text IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
  ENDIF.
ENDFORM.

*& Exact full-screen vision label resolver
*& Only Guided Start Recording can produce this evidence. SHDB TXT/ABAP imports
*& do not contain historical screenshots and never masquerade as GUI vision.
*& A label is accepted only when all full-screen analyses for one logical SAP
*& field agree on exactly one visible label and cross-field collisions are absent.

FORM runtime_gui_label
  USING    iv_bdc    TYPE any
  CHANGING cv_text   TYPE char80
           cv_found  TYPE abap_bool.

  DATA: lv_key       TYPE zbdc_mapping_bup-bdc_field,
        ls_ev        TYPE ty_z865_gui_label,
        lv_count     TYPE i,
        lv_norm      TYPE zbdc_mapping_bup-source_column,
        lv_only_norm TYPE zbdc_mapping_bup-source_column.
  DATA lt_labels TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                 WITH UNIQUE KEY table_line.

  CLEAR: cv_text, cv_found.
  PERFORM logical_bdc_key
    USING    iv_bdc
    CHANGING lv_key.
  IF lv_key IS INITIAL OR gt_z865_gui_labels IS INITIAL.
    RETURN.
  ENDIF.

  "FIX882: visually identical captions may differ only by punctuation/case
  "across interaction snapshots (for example Supplier vs Supplier:). Compare
  "their existing Template normalization, but return an actually observed raw
  "caption. Distinct semantic captions still fail closed.
  LOOP AT gt_z865_gui_labels INTO ls_ev
    WHERE logical_key = lv_key.
    IF ls_ev-label IS INITIAL.
      CONTINUE.
    ENDIF.
    lv_norm = ls_ev-label.
    PERFORM normalize_mapping_source
      USING    lv_norm
      CHANGING lv_norm.
    IF lv_norm IS NOT INITIAL.
      INSERT lv_norm INTO TABLE lt_labels.
    ENDIF.
  ENDLOOP.

  DESCRIBE TABLE lt_labels LINES lv_count.
  IF lv_count <> 1.
    RETURN.
  ENDIF.

  READ TABLE lt_labels INTO lv_only_norm INDEX 1.
  IF sy-subrc <> 0 OR lv_only_norm IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT gt_z865_gui_labels INTO ls_ev
    WHERE logical_key = lv_key.
    lv_norm = ls_ev-label.
    PERFORM normalize_mapping_source
      USING    lv_norm
      CHANGING lv_norm.
    IF lv_norm = lv_only_norm AND ls_ev-label IS NOT INITIAL.
      cv_text = ls_ev-label.
      cv_found = abap_true.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

FORM screen_label_from_replay_ctx
  USING    pt_script TYPE ty_t_script
           iv_bdc    TYPE any
  CHANGING cv_text  TYPE char80
           cv_found TYPE abap_bool.

  TYPES: BEGIN OF ty_z684_ctx,
           prog TYPE d020s-prog,
           dyn  TYPE d020s-dnum,
         END OF ty_z684_ctx.

  DATA: ls_script      TYPE ty_script_def_compat,
        ls_ctx         TYPE ty_z684_ctx,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_target_log  TYPE zbdc_mapping_bup-bdc_field,
        lv_name        TYPE zbdc_mapping_bup-bdc_field,
        lv_name_log    TYPE zbdc_mapping_bup-bdc_field,
        lv_main_prog   TYPE d020s-prog,
        lv_main_dyn    TYPE d020s-dnum,
        lv_sub_raw     TYPE string,
        lv_sub_prog    TYPE d020s-prog,
        lv_sub_dyn     TYPE d020s-dnum,
        lv_sub_len     TYPE i,
        lv_block_hit   TYPE abap_bool,
        lv_raw         TYPE char80,
        lv_hit         TYPE abap_bool,
        lv_count       TYPE i.

  DATA: lt_ctx TYPE SORTED TABLE OF ty_z684_ctx
               WITH UNIQUE KEY prog dyn,
        lt_block_ctx TYPE SORTED TABLE OF ty_z684_ctx
               WITH UNIQUE KEY prog dyn,
        lt_labels TYPE SORTED TABLE OF char80
                  WITH UNIQUE KEY table_line.

  CLEAR: cv_text, cv_found.
  PERFORM exact_field_key
    USING    iv_bdc
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_log.
  IF lv_target_log IS INITIAL OR pt_script IS INITIAL.
    RETURN.
  ENDIF.

 "BDC_SUBSCR is replay choreography; it is not proof that every
 "following field physically belongs to the latest subscreen. Composite
 "dynpros can serialize host-screen fields while subscreens are active.
 "For every recorded dynpro block, keep the exact host PROGRAM/DYNPRO plus
 "every exact BDC_SUBSCR PROGRAM/DYNPRO recorded in that same block. Only a
 "block that actually contains the target logical field contributes owners.
 "rpy_label_strict must then prove the field exists in an owner before
 "a caption can be accepted. No DDIC, technical-name, role-token or AI guess.
  CLEAR: lv_main_prog, lv_main_dyn, lv_sub_prog, lv_sub_dyn,
         lv_block_hit.
  REFRESH lt_block_ctx.

  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      IF lv_block_hit = abap_true.
        LOOP AT lt_block_ctx INTO ls_ctx.
          INSERT ls_ctx INTO TABLE lt_ctx.
        ENDLOOP.
      ENDIF.

      REFRESH lt_block_ctx.
      CLEAR: lv_block_hit, lv_sub_prog, lv_sub_dyn, lv_sub_raw.
      lv_main_prog = ls_script-program_name.
      lv_main_dyn  = ls_script-dynpro_no.
      CONDENSE lv_main_prog NO-GAPS.
      CONDENSE lv_main_dyn  NO-GAPS.
      IF lv_main_prog IS NOT INITIAL AND lv_main_dyn IS NOT INITIAL.
        CLEAR ls_ctx.
        ls_ctx-prog = lv_main_prog.
        ls_ctx-dyn  = lv_main_dyn.
        INSERT ls_ctx INTO TABLE lt_block_ctx.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name = 'BDC_SUBSCR'
       AND ls_script-static_value IS NOT INITIAL.
      lv_sub_raw = ls_script-static_value.
      lv_sub_len = strlen( lv_sub_raw ).
      CLEAR: lv_sub_prog, lv_sub_dyn.
      IF lv_sub_len >= 44.
        lv_sub_prog = lv_sub_raw(40).
        lv_sub_dyn  = lv_sub_raw+40(4).
        CONDENSE lv_sub_prog NO-GAPS.
        CONDENSE lv_sub_dyn  NO-GAPS.
        IF lv_sub_prog IS NOT INITIAL AND lv_sub_dyn IS NOT INITIAL.
          CLEAR ls_ctx.
          ls_ctx-prog = lv_sub_prog.
          ls_ctx-dyn  = lv_sub_dyn.
          INSERT ls_ctx INTO TABLE lt_block_ctx.
        ENDIF.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name IS INITIAL
       OR ls_script-field_name CP 'BDC_*'
       OR ls_script-field_name CP 'DYN_*'.
      CONTINUE.
    ENDIF.

    CLEAR: lv_name, lv_name_log.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_name.
    PERFORM logical_bdc_key
      USING    lv_name
      CHANGING lv_name_log.
    IF lv_name_log = lv_target_log.
      lv_block_hit = abap_true.
    ENDIF.
  ENDLOOP.

  IF lv_block_hit = abap_true.
    LOOP AT lt_block_ctx INTO ls_ctx.
      INSERT ls_ctx INTO TABLE lt_ctx.
    ENDLOOP.
  ENDIF.

  LOOP AT lt_ctx INTO ls_ctx.
    CLEAR: lv_raw, lv_hit.
    PERFORM rpy_label_strict
      USING    ls_ctx-prog ls_ctx-dyn lv_target
      CHANGING lv_raw lv_hit.
    IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
      INSERT lv_raw INTO TABLE lt_labels.
    ENDIF.
  ENDLOOP.

  DESCRIBE TABLE lt_labels LINES lv_count.
  IF lv_count = 1.
    READ TABLE lt_labels INTO cv_text INDEX 1.
    IF sy-subrc = 0 AND cv_text IS NOT INITIAL.
      cv_found = abap_true.
    ENDIF.
  ENDIF.
ENDFORM.

FORM exact_sample
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_found  TYPE abap_bool
           cv_value  TYPE string.

  DATA: ls_script TYPE ty_script_def_compat,
        lv_target TYPE zbdc_mapping_bup-bdc_field,
        lv_exact  TYPE zbdc_mapping_bup-bdc_field,
        lv_piece  TYPE string,
        lv_join   TYPE string.
  DATA lt_seen TYPE SORTED TABLE OF string WITH UNIQUE KEY table_line.

  CLEAR: cv_found, cv_value.
  PERFORM exact_field_key
    USING    iv_field
    CHANGING lv_target.
  IF lv_target IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    CLEAR lv_exact.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_exact.
    IF lv_exact <> lv_target.
      CONTINUE.
    ENDIF.

    IF ls_script-static_value IS INITIAL.
      lv_piece = '<blank>'.
    ELSE.
      lv_piece = ls_script-static_value.
    ENDIF.

    READ TABLE lt_seen WITH TABLE KEY table_line = lv_piece
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT lv_piece INTO TABLE lt_seen.

    IF lv_join IS INITIAL.
      lv_join = lv_piece.
    ELSE.
      CONCATENATE lv_join lv_piece INTO lv_join SEPARATED BY ' -> '.
    ENDIF.
  ENDLOOP.

  IF lv_join IS NOT INITIAL.
    cv_found = abap_true.
    cv_value = lv_join.
  ENDIF.
ENDFORM.

FORM confirmed_name
  USING    iv_field TYPE any
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column
           cv_found  TYPE abap_bool.

  DATA: lv_key TYPE zbdc_mapping_bup-bdc_field,
        ls_name TYPE ty_z684_name_cert.

  CLEAR: cv_source, cv_found.
  IF gv_z684_name_ready <> abap_true.
    RETURN.
  ENDIF.

  PERFORM logical_bdc_key
    USING    iv_field
    CHANGING lv_key.
  IF lv_key IS INITIAL.
    RETURN.
  ENDIF.

  READ TABLE gt_z684_names INTO ls_name
    WITH TABLE KEY logical_key = lv_key.
  IF sy-subrc = 0 AND ls_name-source_name IS NOT INITIAL.
    cv_source = ls_name-source_name.
    cv_found = abap_true.
  ENDIF.
ENDFORM.

*& Exact DDIC fallback must be unique inside the captured contract
*& Screen caption remains first authority. DDIC is accepted only when the
*& translated label identifies one logical captured field unambiguously.

FORM unique_ddic_name
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_name   TYPE zbdc_mapping_bup-source_column
           cv_ok     TYPE abap_bool.

  DATA: ls_script     TYPE ty_script_def_compat,
        lv_target     TYPE zbdc_mapping_bup-bdc_field,
        lv_target_log TYPE zbdc_mapping_bup-bdc_field,
        lv_exact      TYPE zbdc_mapping_bup-bdc_field,
        lv_logical    TYPE zbdc_mapping_bup-bdc_field,
        lv_raw        TYPE char80,
        lv_hit        TYPE abap_bool,
        lv_probe      TYPE zbdc_mapping_bup-source_column,
        lv_technical  TYPE abap_bool.

  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
               WITH UNIQUE KEY table_line.

  CLEAR: cv_name, cv_ok.
  PERFORM exact_field_key
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_log.
  IF lv_target_log IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_raw, lv_hit.
  PERFORM ddic_label_raw
    USING    lv_target
    CHANGING lv_raw lv_hit.
  IF lv_hit <> abap_true OR lv_raw IS INITIAL.
    RETURN.
  ENDIF.
  cv_name = lv_raw.
  PERFORM normalize_mapping_source
    USING    cv_name
    CHANGING cv_name.
  IF cv_name IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.
    CLEAR: lv_exact, lv_logical, lv_technical.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_exact.
    PERFORM field_choreo_only
      USING    lv_exact
      CHANGING lv_technical.
    IF lv_exact IS INITIAL OR lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    lv_exact
      CHANGING lv_logical.
    IF lv_logical IS INITIAL OR lv_logical = lv_target_log.
      CONTINUE.
    ENDIF.

    READ TABLE lt_seen
      WITH TABLE KEY table_line = lv_logical
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT lv_logical INTO TABLE lt_seen.

    CLEAR: lv_raw, lv_hit, lv_probe.
    PERFORM ddic_label_raw
      USING    lv_exact
      CHANGING lv_raw lv_hit.
    IF lv_hit <> abap_true OR lv_raw IS INITIAL.
      CONTINUE.
    ENDIF.
    lv_probe = lv_raw.
    PERFORM normalize_mapping_source
      USING    lv_probe
      CHANGING lv_probe.
    IF lv_probe = cv_name.
      CLEAR cv_name.
      RETURN.
    ENDIF.
  ENDLOOP.

  cv_ok = abap_true.
ENDFORM.

FORM base_tpl_name
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column.

  DATA: lv_gui_raw     TYPE char80,
        lv_gui_hit     TYPE abap_bool,
        lv_gui_name    TYPE zbdc_mapping_bup-source_column,
        lv_screen_raw  TYPE char80,
        lv_screen_hit  TYPE abap_bool,
        lv_screen_name TYPE zbdc_mapping_bup-source_column,
        lv_ddic_hit    TYPE abap_bool,
        lv_ddic_name   TYPE zbdc_mapping_bup-source_column,
        lv_ddic_auth_name TYPE zbdc_mapping_bup-source_column,
        lv_ddic_auth_ok TYPE abap_bool,
        lv_ddic_technical TYPE abap_bool,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_field       TYPE zbdc_mapping_bup-bdc_field,
        lv_range       TYPE zbdc_mapping_bup-source_column,
        lv_range_ok    TYPE abap_bool.

  CLEAR cv_source.
  PERFORM exact_field_key
    USING    iv_field
    CHANGING lv_field.
  IF lv_field IS INITIAL.
    RETURN.
  ENDIF.

 "separates two authorities that must not be conflated:
 " - USER SELECTION decides whether a recorded control becomes dynamic.
 " - SAP metadata only supplies a readable name for that exact control.
 "For naming, prefer an exact bound screen caption. If the dynpro does not
 "publish one (common in composite/EnjoySAP subscreens), use the translated
 "unique translated DDIC label of the exact STRUCTURE-FIELD identity only
 "when that label names one logical captured field unambiguously. No TCODE,
 "value or AI rule is involved. Technical identity remains diagnostic-only.

  CLEAR: lv_gui_raw, lv_gui_hit, lv_gui_name,
         lv_screen_raw, lv_screen_hit, lv_screen_name,
         lv_ddic_hit, lv_ddic_name.

 "Highest authority for Guided Recording: exact label exposed by SAP GUI
 "accessibility for the component the user actually changed in Record mode.
 "This is client-side runtime evidence, not Screen Painter reconstruction.
  PERFORM runtime_gui_label
    USING    lv_field
    CHANGING lv_gui_raw lv_gui_hit.
  IF lv_gui_hit = abap_true AND lv_gui_raw IS NOT INITIAL.
    lv_gui_name = lv_gui_raw.
    PERFORM normalize_mapping_source
      USING    lv_gui_name
      CHANGING lv_gui_name.
  ENDIF.

 "For every Guided Recording, full-screen AI evidence is the only
 "naming authority for the whole acquisition. A
 "recorded field that did not expose an accessibility caption is left
 "unresolved instead of being silently relabelled from repository/DDIC text.
 "This prevents a fallback label from masquerading as what the user saw.
  IF ( gv_z652_acq_origin = 'GUIDED_RECORD'
       OR gv_z866_vision_required = abap_true )
     AND lv_gui_name IS INITIAL.
    RETURN.
  ENDIF.

 "Imports have no historical GUI screenshot stream and may use repository/DDIC
 "metadata. Fresh Guided Recording never reaches this fallback when AI Vision
 "is required; an unproven field stays unresolved.
  IF lv_gui_name IS INITIAL.
    PERFORM screen_label_from_replay_ctx
      USING    pt_script lv_field
      CHANGING lv_screen_raw lv_screen_hit.
    IF lv_screen_hit = abap_true AND lv_screen_raw IS NOT INITIAL.
      lv_screen_name = lv_screen_raw.
      PERFORM normalize_mapping_source
        USING    lv_screen_name
        CHANGING lv_screen_name.
    ENDIF.
  ENDIF.

  IF lv_gui_name IS INITIAL AND lv_screen_name IS INITIAL.
    "For SHDB Import, accuracy has priority over brevity.  When the exact
    "STRUCTURE-FIELD carries a Data Element, use that Data Element's own
    "active-language description as the canonical SAP semantic name.  This
    "is stronger than a short component token and is not an AI paraphrase.
    "Example-specific mappings are deliberately forbidden here: the decision
    "is driven only by the exact field's ROLLNAME/DD04V metadata.
    CLEAR: lv_ddic_auth_name, lv_ddic_auth_ok.
    PERFORM import_ddic_auth_name
      USING    lv_field
      CHANGING lv_ddic_auth_name lv_ddic_auth_ok.

    IF lv_ddic_auth_ok = abap_true AND lv_ddic_auth_name IS NOT INITIAL.
      lv_ddic_name = lv_ddic_auth_name.
      lv_ddic_hit  = abap_true.
    ELSE.
      PERFORM unique_ddic_name
        USING    pt_script lv_field
        CHANGING lv_ddic_name lv_ddic_hit.
    ENDIF.

    "A DDIC text that is only the short raw SAP component token is not a
    "business-facing label. Keep it unresolved so the Import semantic
    "resolver can use stronger same-recording evidence instead of publishing
    "an internal abbreviation such as a five-character component name.
    IF lv_ddic_hit = abap_true AND lv_ddic_name IS NOT INITIAL.
      CLEAR lv_ddic_technical.
      PERFORM mapping_source_is_technical
        USING    lv_ddic_name lv_field
        CHANGING lv_ddic_technical.
      IF lv_ddic_technical = abap_true.
        CLEAR: lv_ddic_name, lv_ddic_hit.
      ENDIF.
    ENDIF.
  ENDIF.

  IF lv_gui_name IS NOT INITIAL.
    lv_source = lv_gui_name.
  ELSEIF lv_screen_name IS NOT INITIAL.
    lv_source = lv_screen_name.
  ELSEIF lv_ddic_name IS NOT INITIAL.
    lv_source = lv_ddic_name.
  ELSE.
    RETURN.
  ENDIF.

  IF lv_source IS INITIAL.
    RETURN.
  ENDIF.

 "LOW/HIGH -> FROM/TO is allowed only after a semantic base name has been
 "proven by exact screen binding or exact DDIC identity. The qualifier is
 "structural SAP evidence, not transaction-specific business logic.
  CLEAR: lv_range, lv_range_ok.
  PERFORM range_source
    USING    pt_script lv_field lv_source
    CHANGING lv_range lv_range_ok.
  IF lv_range_ok = abap_true AND lv_range IS NOT INITIAL.
    lv_source = lv_range.
  ENDIF.

  cv_source = lv_source.
ENDFORM.



*& Legacy collision disambiguation outside confirmed Template contracts

*& Action codes (ENTR/UPDA/MESAVE/RW/...) are replay choreography and stay
*& in the Context column only. This helper is retained only for legacy/non-
*& confirmed internal projections. Fresh Guided/TXT Template contracts never
*& use a technical leaf to invent a friendly name; their confirmed screen/DDIC
*& naming path fails closed on ambiguity.

FORM safe_disambig
  USING    pt_script TYPE ty_t_script
           iv_bdc    TYPE any
           iv_base   TYPE any
  CHANGING cv_source TYPE zbdc_mapping_bup-source_column.

  DATA: lv_input       TYPE string,
        lv_base        TYPE zbdc_mapping_bup-source_column,
        lv_range       TYPE zbdc_mapping_bup-source_column,
        lv_range_found TYPE abap_bool,
        lv_field       TYPE string,
        lv_left        TYPE string,
        lv_leaf        TYPE string,
        lv_out         TYPE string.

  lv_input = iv_base.
  CLEAR cv_source.
  PERFORM normalize_mapping_source
    USING    lv_input
    CHANGING lv_base.
  IF lv_base IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_range, lv_range_found.
  PERFORM range_source
    USING    pt_script iv_bdc lv_base
    CHANGING lv_range lv_range_found.
  IF lv_range_found = abap_true
     AND lv_range IS NOT INITIAL
     AND lv_range <> lv_base.
    cv_source = lv_range.
    RETURN.
  ENDIF.

  lv_field = iv_bdc.
  TRANSLATE lv_field TO UPPER CASE.
  CONDENSE lv_field NO-GAPS.
  REPLACE ALL OCCURRENCES OF '(*)' IN lv_field WITH ''.
  IF lv_field CS '-'.
    SPLIT lv_field AT '-' INTO lv_left lv_leaf.
  ELSE.
    lv_leaf = lv_field.
  ENDIF.
  REPLACE ALL OCCURRENCES OF '(' IN lv_leaf WITH '_'.
  REPLACE ALL OCCURRENCES OF ')' IN lv_leaf WITH ''.
  REPLACE ALL OCCURRENCES OF '.' IN lv_leaf WITH '_'.
  REPLACE ALL OCCURRENCES OF '/' IN lv_leaf WITH '_'.
  CONDENSE lv_leaf NO-GAPS.

  IF lv_leaf IS NOT INITIAL.
    lv_out = lv_base && '_' && lv_leaf.
    PERFORM normalize_mapping_source
      USING    lv_out
      CHANGING cv_source.
  ENDIF.

  IF cv_source IS INITIAL.
    cv_source = lv_base.
  ENDIF.
ENDFORM.


*& V16 - Text-only OpenAI naming for independent SHDB Import
*& Membership is fixed locally before AI runs. AI can name, never add/remove.
*&---------------------------------------------------------------------*
*& Exact DD03T field text for one DDIC TABLE/STRUCTURE-FIELD
*&---------------------------------------------------------------------*
*& DD03T is field-context text authority: TABNAME + FIELDNAME + language.
*& It is intentionally checked before Data Element text because the same Data
*& Element may be reused by several components with different field semantics.
*& Only active/current-language text is accepted; no English fallback, alias,
*& sample-value inference, TCODE branch, memory or AI is used.
*&---------------------------------------------------------------------*
*& Exact DDIC mapper metadata for one imported SHDB field
*&---------------------------------------------------------------------*
*& This is the same principle used by generic SHDB mapping tools:
*& the imported recording supplies exact STRUCTURE-FIELD identity and SAP
*& Dictionary supplies the field description/type/length.  No transaction
*& replay, TCODE CASE, sample-value inference, memory or AI is involved.
FORM import_ddic_mapper_meta
  USING    iv_field TYPE any
  CHANGING cv_desc  TYPE char80
           cv_type  TYPE char20
           cv_len   TYPE i
           cv_ok    TYPE abap_bool.

  DATA: lv_exact    TYPE zbdc_mapping_bup-bdc_field,
        lv_left     TYPE string,
        lv_right    TYPE string,
        lv_tab      TYPE dd03l-tabname,
        lv_fld      TYPE dd03l-fieldname,
        lv_paren    TYPE i,
        lv_rollname TYPE dd03l-rollname,
        lv_datatype TYPE dd03l-datatype,
        lv_leng     TYPE dd03l-leng,
        lv_text     TYPE dd03t-ddtext,
        ls_dtel     TYPE dd04v,
        lv_raw      TYPE char80,
        lv_hit      TYPE abap_bool.

  CLEAR: cv_desc, cv_type, cv_len, cv_ok.

  PERFORM exact_field_key USING iv_field CHANGING lv_exact.
  IF lv_exact IS INITIAL OR lv_exact NS '-'.
    RETURN.
  ENDIF.

  "Occurrence suffix belongs to BDC table-control identity, not DDIC.
  FIND FIRST OCCURRENCE OF '(' IN lv_exact MATCH OFFSET lv_paren.
  IF sy-subrc = 0 AND lv_paren > 0.
    lv_exact = lv_exact(lv_paren).
  ENDIF.

  SPLIT lv_exact AT '-' INTO lv_left lv_right.
  IF lv_left IS INITIAL OR lv_right IS INITIAL.
    RETURN.
  ENDIF.

  lv_tab = lv_left.
  lv_fld = lv_right.
  TRANSLATE: lv_tab TO UPPER CASE, lv_fld TO UPPER CASE.
  CONDENSE: lv_tab NO-GAPS, lv_fld NO-GAPS.

  "12V simple Import rule: a Mapper row exists only when the exact active
  "TABLE/STRUCTURE-FIELD exists in DD03L. No cursor/helper classifier,
  "sample-value inference, runtime replay, screen-label guess or AI is used.
  CLEAR: lv_rollname, lv_datatype, lv_leng.
  SELECT SINGLE rollname datatype leng
    FROM dd03l
    INTO (lv_rollname, lv_datatype, lv_leng)
    WHERE tabname   = lv_tab
      AND fieldname = lv_fld
      AND as4local  = 'A'
      AND as4vers   = '0000'.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  cv_type = lv_datatype.
  cv_len  = lv_leng.

  "Field Description is kept separate from Field Label.
  "If the proven component uses a Data Element, its DDTEXT is the canonical
  "semantic description.  DD03T is used only as exact field-context fallback
  "(especially for directly typed Dictionary components).
  CLEAR: lv_raw, lv_hit.
  IF lv_rollname IS NOT INITIAL.
    CLEAR ls_dtel.
    CALL FUNCTION 'DDIF_DTEL_GET'
      EXPORTING
        name          = lv_rollname
        state         = 'A'
        langu         = sy-langu
      IMPORTING
        dd04v_wa      = ls_dtel
      EXCEPTIONS
        illegal_input = 1
        OTHERS        = 2.
    IF sy-subrc = 0 AND ls_dtel-ddtext IS NOT INITIAL.
      lv_raw = ls_dtel-ddtext.
      PERFORM raw_text_ok USING lv_raw CHANGING cv_desc lv_hit.
      IF lv_hit = abap_true AND cv_desc IS NOT INITIAL.
        cv_ok = abap_true.
        RETURN.
      ENDIF.
    ENDIF.
  ENDIF.

  "Fallback: exact field-context text on the proven DD03L component.
  CLEAR lv_text.
  SELECT SINGLE ddtext
    FROM dd03t
    INTO lv_text
    WHERE tabname    = lv_tab
      AND ddlanguage = sy-langu
      AND as4local   = 'A'
      AND fieldname  = lv_fld.

  IF lv_text IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_raw, lv_hit.
  PERFORM raw_text_ok USING lv_text CHANGING lv_raw lv_hit.
  IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
    cv_desc = lv_raw.
    cv_ok   = abap_true.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Exact SAP DDIC Field Label for one imported SHDB field
*&---------------------------------------------------------------------*
*& Import-only display metadata.  The BDC field must first exist as the
*& exact active DD03L TABLE/STRUCTURE-FIELD.  The visible value returned here
*& is NOT a guessed screen caption: it is SAP Dictionary Field Label metadata
*& (Long -> Medium -> Short) in the current logon language.
*& No TCODE/field hardcode, AI, screen replay or value inference is used.
FORM import_ddic_field_label
  USING    iv_field TYPE any
  CHANGING cv_label TYPE char80
           cv_ok    TYPE abap_bool.

  DATA: lv_exact    TYPE zbdc_mapping_bup-bdc_field,
        lv_left     TYPE string,
        lv_right    TYPE string,
        lv_tab      TYPE dd03l-tabname,
        lv_fld      TYPE dd03l-fieldname,
        lv_paren    TYPE i,
        lv_rollname TYPE dd03l-rollname,
        lt_dfies    TYPE STANDARD TABLE OF dfies,
        ls_dfies    TYPE dfies,
        ls_dtel     TYPE dd04v,
        lv_raw      TYPE char80,
        lv_hit      TYPE abap_bool.

  CLEAR: cv_label, cv_ok.

  PERFORM exact_field_key USING iv_field CHANGING lv_exact.
  IF lv_exact IS INITIAL OR lv_exact NS '-'.
    RETURN.
  ENDIF.

  "BDC table-control occurrence is not part of the DDIC component name.
  FIND FIRST OCCURRENCE OF '(' IN lv_exact MATCH OFFSET lv_paren.
  IF sy-subrc = 0 AND lv_paren > 0.
    lv_exact = lv_exact(lv_paren).
  ENDIF.

  SPLIT lv_exact AT '-' INTO lv_left lv_right.
  IF lv_left IS INITIAL OR lv_right IS INITIAL.
    RETURN.
  ENDIF.

  lv_tab = lv_left.
  lv_fld = lv_right.
  TRANSLATE: lv_tab TO UPPER CASE, lv_fld TO UPPER CASE.
  CONDENSE: lv_tab NO-GAPS, lv_fld NO-GAPS.

  "Use the same exact-field authority as the Import Field Description gate.
  CLEAR lv_rollname.
  SELECT SINGLE rollname
    FROM dd03l
    INTO lv_rollname
    WHERE tabname   = lv_tab
      AND fieldname = lv_fld
      AND as4local  = 'A'
      AND as4vers   = '0000'.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  "Primary source: resolved Dictionary component metadata in SY-LANGU.
  REFRESH lt_dfies.
  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_tab
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_dfies
    EXCEPTIONS
      not_found      = 1
      internal_error = 2
      OTHERS         = 3.
  IF sy-subrc = 0.
    READ TABLE lt_dfies INTO ls_dfies WITH KEY fieldname = lv_fld.
    IF sy-subrc = 0.
      lv_raw = ls_dfies-scrtext_l.
      IF lv_raw IS INITIAL. lv_raw = ls_dfies-scrtext_m. ENDIF.
      IF lv_raw IS INITIAL. lv_raw = ls_dfies-scrtext_s. ENDIF.

      CLEAR lv_hit.
      IF lv_raw IS NOT INITIAL.
        PERFORM raw_text_ok USING lv_raw CHANGING cv_label lv_hit.
        IF lv_hit = abap_true AND cv_label IS NOT INITIAL.
          cv_ok = abap_true.
          RETURN.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

  "Fallback only to the exact Data Element behind the proven component.
  "DDTEXT/REPTEXT are deliberately NOT used because this column is Field Label.
  IF lv_rollname IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR ls_dtel.
  CALL FUNCTION 'DDIF_DTEL_GET'
    EXPORTING
      name          = lv_rollname
      state         = 'A'
      langu         = sy-langu
    IMPORTING
      dd04v_wa      = ls_dtel
    EXCEPTIONS
      illegal_input = 1
      OTHERS        = 2.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  CLEAR lv_raw.
  lv_raw = ls_dtel-scrtext_l.
  IF lv_raw IS INITIAL. lv_raw = ls_dtel-scrtext_m. ENDIF.
  IF lv_raw IS INITIAL. lv_raw = ls_dtel-scrtext_s. ENDIF.
  IF lv_raw IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR lv_hit.
  PERFORM raw_text_ok USING lv_raw CHANGING cv_label lv_hit.
  IF lv_hit = abap_true AND cv_label IS NOT INITIAL.
    cv_ok = abap_true.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Exact SAP screen short description for one PROGRAM/DYNPRO
*&---------------------------------------------------------------------*
*& D020T is SAP repository authority for the translated screen short text.
*& Only the current logon language is accepted.  Missing text stays missing;
*& no English fallback, TCODE lookup, hardcoded title, memory or AI is used.
FORM import_screen_description
  USING    iv_prog TYPE any
           iv_dyn  TYPE any
  CHANGING cv_desc TYPE char80
           cv_ok   TYPE abap_bool.

  DATA: lv_prog TYPE d020t-prog,
        lv_dyn  TYPE d020t-dynr,
        lv_text TYPE d020t-dtxt,
        lv_raw  TYPE char80,
        lv_hit  TYPE abap_bool.

  CLEAR: cv_desc, cv_ok.
  lv_prog = iv_prog.
  lv_dyn  = iv_dyn.
  CONDENSE lv_prog NO-GAPS.
  CONDENSE lv_dyn  NO-GAPS.
  IF lv_prog IS INITIAL OR lv_dyn IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR lv_text.
  SELECT SINGLE dtxt
    FROM d020t
    INTO lv_text
    WHERE prog = lv_prog
      AND dynr = lv_dyn
      AND lang = sy-langu.
  IF sy-subrc <> 0 OR lv_text IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR: lv_raw, lv_hit.
  PERFORM raw_text_ok
    USING    lv_text
    CHANGING lv_raw lv_hit.
  IF lv_hit = abap_true AND lv_raw IS NOT INITIAL.
    cv_desc = lv_raw.
    cv_ok   = abap_true.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Authoritative Import description: DDIC semantic -> exact dynpro label
*&---------------------------------------------------------------------*
*& Process-Runner-style rule for imported SHDB fields:
*& 1) DD03T exact TABLE/STRUCTURE-FIELD text wins;
*& 2) DFIES exact component metadata, then Data Element text/labels;
*& 3) when Dictionary identity/text is unavailable, use
*&    only an exact visible label proven from the recorded PROGRAM/DYNPRO and
*&    BDC_SUBSCR repository context;
*& 4) if SAP proves neither source, fail closed as Description unavailable.
*& The resolver never uses sample values, TCODE CASEs, aliases, memory or AI.
FORM import_auth_field_desc
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_desc   TYPE char80
           cv_type   TYPE char20
           cv_len    TYPE i
           cv_ok     TYPE abap_bool.

  "12V Import uses only exact SAP Dictionary FIELD -> DESCRIPTION authority.
  "PT_SCRIPT remains in the interface only to keep existing callers stable.
  CLEAR: cv_desc, cv_type, cv_len, cv_ok.
  PERFORM import_ddic_mapper_meta
    USING    iv_field
    CHANGING cv_desc cv_type cv_len cv_ok.
ENDFORM.

*&---------------------------------------------------------------------*
*& Exact authoritative DDIC name for one imported BDC field
*&---------------------------------------------------------------------*
*& Accuracy-first naming rule.  The exact STRUCTURE-FIELD is resolved through
*& DDIF_FIELDINFO_GET, then its exact Data Element (ROLLNAME) is read through
*& DDIF_DTEL_GET.  The Data Element short description DDTEXT is preferred
*& because it is SAP's semantic description and is not limited to a short
*& screen caption.  No TCODE, field-name dictionary or AI paraphrase is used.
*& If SAP does not expose a non-technical authoritative text, this helper
*& fails closed and lets the existing evidence/AI fallback continue.
FORM import_ddic_auth_name
  USING    iv_field TYPE any
  CHANGING cv_name  TYPE zbdc_mapping_bup-source_column
           cv_ok    TYPE abap_bool.

  DATA: lv_exact     TYPE zbdc_mapping_bup-bdc_field,
        lv_left      TYPE string,
        lv_right     TYPE string,
        lv_tab       TYPE tabname,
        lv_fld       TYPE fieldname,
        lt_dfies     TYPE STANDARD TABLE OF dfies,
        ls_dfies     TYPE dfies,
        ls_dtel      TYPE dd04v,
        lv_text      TYPE string,
        lv_raw       TYPE char80,
        lv_raw_ok    TYPE abap_bool,
        lv_candidate TYPE zbdc_mapping_bup-source_column,
        lv_technical TYPE abap_bool.

  CLEAR: cv_name, cv_ok.

  PERFORM exact_field_key USING iv_field CHANGING lv_exact.
  IF lv_exact IS INITIAL OR lv_exact NS '-'.
    RETURN.
  ENDIF.

  REPLACE ALL OCCURRENCES OF '(*)' IN lv_exact WITH ''.
  SPLIT lv_exact AT '-' INTO lv_left lv_right.
  IF lv_left IS INITIAL OR lv_right IS INITIAL.
    RETURN.
  ENDIF.

  lv_tab = lv_left.
  lv_fld = lv_right.

  REFRESH lt_dfies.
  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = lv_tab
      langu          = sy-langu
      all_types      = abap_true
    TABLES
      dfies_tab      = lt_dfies
    EXCEPTIONS
      not_found      = 1
      internal_error = 2
      OTHERS         = 3.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  READ TABLE lt_dfies INTO ls_dfies WITH KEY fieldname = lv_fld.
  IF sy-subrc <> 0 OR ls_dfies-rollname IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR ls_dtel.
  CALL FUNCTION 'DDIF_DTEL_GET'
    EXPORTING
      name          = ls_dfies-rollname
      state         = 'A'
      langu         = sy-langu
    IMPORTING
      dd04v_wa      = ls_dtel
    EXCEPTIONS
      illegal_input = 1
      OTHERS        = 2.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  "Prefer the exact Data Element semantic description.  Only when it is blank
  "do we fall back to SAP-maintained Data Element field labels.  This avoids
  "shortening a precise semantic such as an 'individual capacities' concept
  "into a broader phrase merely because a shorter screen label exists.
  CLEAR: lv_text, lv_raw.
  lv_text = ls_dtel-ddtext.
  IF lv_text IS INITIAL.
    lv_text = ls_dtel-scrtext_l.
  ENDIF.
  IF lv_text IS INITIAL.
    lv_text = ls_dtel-reptext.
  ENDIF.
  IF lv_text IS INITIAL.
    lv_text = ls_dtel-scrtext_m.
  ENDIF.
  IF lv_text IS INITIAL.
    lv_text = ls_dtel-scrtext_s.
  ENDIF.

  CLEAR lv_raw_ok.
  PERFORM raw_text_ok USING lv_text CHANGING lv_raw lv_raw_ok.
  IF lv_raw_ok <> abap_true OR lv_raw IS INITIAL.
    RETURN.
  ENDIF.

  lv_candidate = lv_raw.
  PERFORM normalize_mapping_source
    USING    lv_candidate
    CHANGING lv_candidate.
  IF lv_candidate IS INITIAL.
    RETURN.
  ENDIF.

  CLEAR lv_technical.
  PERFORM mapping_source_is_technical
    USING    lv_candidate lv_exact
    CHANGING lv_technical.
  IF lv_technical = abap_true.
    RETURN.
  ENDIF.

  cv_name = lv_candidate.
  cv_ok   = abap_true.
ENDFORM.

*&---------------------------------------------------------------------*
*& Exact DDIC semantic signature for one imported BDC field
*&---------------------------------------------------------------------*
*& This is intentionally generic.  It does not map business fields by name.
*& ROLLNAME is the strongest reusable SAP Dictionary semantic identity for two
*& structure components.  A short technical component name is never promoted
*& by this routine; the signature is evidence only.
*&---------------------------------------------------------------------*
*& Reuse proven label through exact DDIC Data Element identity
*&---------------------------------------------------------------------*
*& Some SAP runtime structures rename the physical component while retaining
*& the same Data Element as a field already present elsewhere in the imported
*& recording.  Same-leaf matching cannot resolve that case.  Reuse is allowed
*& only when the target and peer have the exact same nonblank ROLLNAME and all
*& matching peers prove one and the same non-technical SAP label.  Any conflict
*& fails closed and leaves the field for AI/technical fallback.
*&---------------------------------------------------------------------*
*& Reuse one exact proven SAP semantic label for the same technical leaf
*&---------------------------------------------------------------------*
*& SHDB TXT can contain the same SAP semantic field under different runtime
*& structures.  Example patterns are intentionally NOT hardcoded here.  If
*& another exact captured field in this same recording has the same terminal
*& technical leaf and base_tpl_name can prove exactly one SAP label for that
*& leaf, reuse that label.  Do not manufacture a structure-derived qualifier
*& merely to make names unique.  Duplicate semantic labels are allowed in the
*& chooser; the final selected Template set still blocks duplicate headers.
*&---------------------------------------------------------------------*
*& Import live-screen OpenAI naming
*&---------------------------------------------------------------------*
*& Membership is already fixed in GT_Z659_USER_ACTIONS by the local chooser
*& inventory. This routine names only those logical fields that were observed
*& as real controls on automatically replayed exact SAP screens. Every AI
*& candidate is bound to one captured PNG and immutable technical identity.
*& First meaningful user sample, never SAP echo/history

*& The confirmation sample is only a memory aid for the user. SHDB may keep
*& BDC_CURSOR on the same field while SAP resolves a code to a description,
*& enriches, defaults or resubmits the field on later PAI blocks. Therefore
*& repeated cursor ownership is NOT proof of repeated user edits. For one exact
*& physical field this resolver uses:
*& 1) the FIRST NON-BLANK value from a dynpro block whose BDC_CURSOR points
*& to that exact field;
*& 2) if direct cursor blocks exist but all are blank, BLANK; otherwise
*& 3) the FIRST serialized value for that exact field in the recording.
*& This keeps initial empty screen state from becoming "<blank> -> value" and
*& prevents later SAP-resolved text from becoming "code -> description".
*& Mapping membership is unchanged and still requires explicit confirmation.

FORM confirm_actions
  USING    pt_script    TYPE ty_t_script
           iv_script_id TYPE zbdc_script_bup-script_id
           iv_hash      TYPE zbdc_script_bup-contract_hash
           iv_origin    TYPE csequence
  CHANGING cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  TYPES: BEGIN OF ty_z659_pick,
           mark         TYPE c LENGTH 1,
           friendly     TYPE char40,
           bdc_field   TYPE zbdc_mapping_bup-bdc_field,
           example     TYPE c LENGTH 255,
           evidence    TYPE char30,
           context     TYPE char60,
         END OF ty_z659_pick,
         BEGIN OF ty_z669_ui,
           mark         TYPE c LENGTH 1,
           logic_key    TYPE zbdc_mapping_bup-bdc_field,
           first_bdc    TYPE zbdc_mapping_bup-bdc_field,
           screen_ref   TYPE char60,
           base_name    TYPE zbdc_mapping_bup-source_column,
           display_name TYPE char80,
           ddic_type    TYPE char20,
           ddic_len     TYPE i,
           example      TYPE c LENGTH 255,
         END OF ty_z669_ui,
         BEGIN OF ty_z669_popup,
           mark         TYPE c LENGTH 1,
           row_kind     TYPE c LENGTH 1,
           logic_key    TYPE zbdc_mapping_bup-bdc_field,
           first_bdc    TYPE zbdc_mapping_bup-bdc_field,
           display_name TYPE char80,
           field_label  TYPE char80,
           example      TYPE c LENGTH 255,
         END OF ty_z669_popup.

  DATA: lt_pick       TYPE STANDARD TABLE OF ty_z659_pick,
        lt_ui         TYPE STANDARD TABLE OF ty_z669_ui,
        ls_ui         TYPE ty_z669_ui,
        lt_popup      TYPE STANDARD TABLE OF ty_z669_popup,
        ls_popup      TYPE ty_z669_popup,
        ls_pick       TYPE ty_z659_pick,
        ls_script     TYPE ty_script_def_compat,
        lt_fieldcat   TYPE slis_t_fieldcat_alv,
        ls_fieldcat   TYPE slis_fieldcat_alv,
        ls_selfield   TYPE slis_selfield,
        lv_exit       TYPE c,
        lv_loaded     TYPE abap_bool,
        lv_exact      TYPE zbdc_mapping_bup-bdc_field,
        lv_key        TYPE zbdc_mapping_bup-bdc_field,
        lv_source     TYPE zbdc_mapping_bup-source_column,
        lv_origin     TYPE c LENGTH 20,
        lv_confirm_origin TYPE c LENGTH 20,
        lv_technical  TYPE abap_bool,
        lv_type       TYPE zbdc_sct_ver_bup-value_type,
        lv_direct     TYPE abap_bool,
        lv_direct_msg TYPE string,
        lv_save_ok    TYPE abap_bool,
        lv_save_msg   TYPE string,
        lv_prog       TYPE d020s-prog,
        lv_dyn        TYPE d020s-dnum,
        lv_action     TYPE zbdc_mapping_bup-source_column,
        lv_sub_raw    TYPE string,
        lv_sub_prog   TYPE d020s-prog,
        lv_sub_dyn    TYPE d020s-dnum,
        lv_sub_len    TYPE i,
        lv_context    TYPE string,
        lv_selected   TYPE i,
        lv_indexed    TYPE abap_bool,
        lv_param      TYPE string,
        lv_idx        TYPE string,
        lv_dup_count  TYPE i,
        lv_name       TYPE zbdc_mapping_bup-source_column,
        lv_bound      TYPE abap_bool,
        lv_expected_n TYPE i,
        lv_candidate_n TYPE i,
        lv_sample_found TYPE abap_bool,
        lv_sample_value TYPE string,
        lv_ui_key       TYPE zbdc_mapping_bup-bdc_field,
        lv_ui_key2      TYPE zbdc_mapping_bup-bdc_field,
        lv_piece        TYPE string,
        lv_join         TYPE string,
        lv_group_count  TYPE i,
        lv_meta_known   TYPE abap_bool,
        lv_meta_input   TYPE abap_bool,
        lv_cert_action_n TYPE i,
        lv_cert_name_n   TYPE i,
        lv_popup_title   TYPE c LENGTH 70,
        lv_guided_entry  TYPE abap_bool,
        lv_guided_ok     TYPE abap_bool,
        lv_guided_msg    TYPE string,
        lv_fresh_import  TYPE abap_bool,
        lv_import_ai_ok  TYPE abap_bool,
        lv_import_ai_msg TYPE string,
        lv_import_live_ok TYPE abap_bool,
        lv_import_live_msg TYPE string,
        lv_import_tcode TYPE sy-tcode,
        lv_ddic_desc TYPE char80,
        lv_ddic_type TYPE char20,
        lv_ddic_len TYPE i,
        lv_ddic_meta_ok TYPE abap_bool,
        lv_ddic_label TYPE char80,
        lv_ddic_label_ok TYPE abap_bool,
        lv_popup_rc TYPE sy-subrc,
        lt_guided_actions TYPE ty_t_z920_gui_action,
        ls_guided_action  TYPE ty_z920_gui_action,
        lv_guided_skipped TYPE i,
        lv_guided_ledger_ok TYPE abap_bool,
        lv_guided_ledger_msg TYPE string.

  DATA: lt_expected TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                    WITH UNIQUE KEY table_line,
        lt_candidate TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                     WITH UNIQUE KEY table_line,
        lt_name_used TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                     WITH UNIQUE KEY table_line,
        lt_sample_used TYPE SORTED TABLE OF string
                       WITH UNIQUE KEY table_line,
        lt_prior_actions TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                         WITH UNIQUE KEY table_line,
        lt_guided_keys TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                       WITH UNIQUE KEY table_line,
        lt_screen_inputs TYPE ty_t_z691_screen_candidate,
        ls_screen_input  TYPE ty_z691_screen_candidate.

  FIELD-SYMBOLS: <ls_pick> TYPE ty_z659_pick,
                 <ls_ui>   TYPE ty_z669_ui.

  CLEAR: cv_ok, cv_message.

 "Fresh Guided provenance is reconstructed from RAW/native/capture evidence.
 "Capture proves WHICH fields the user changed; SAP DDIC supplies the names.
  CLEAR: lv_guided_entry, lv_guided_ok, lv_guided_msg.
  PERFORM ensure_guided_vision
    USING    iv_origin pt_script
    CHANGING lv_guided_entry lv_guided_ok lv_guided_msg.
  IF lv_guided_entry = abap_true.
    IF lv_guided_ok <> abap_true.
      cv_message = lv_guided_msg.
      RETURN.
    ENDIF.
    lv_confirm_origin = 'GUIDED_RECORD'.
    lv_origin         = 'GUIDED_RECORD'.
    gv_z652_acq_origin   = 'GUIDED_RECORD'.
    gv_z359_input_origin = 'GUIDED_RECORD'.
    gv_z133_origin       = 'GUIDED_RECORD'.

    "Build exact user-modified field membership from retained SAP GUI
    "Modified/modal-return evidence reconciled to immutable RAW BDC.
    REFRESH: lt_guided_actions, lt_guided_keys.
    CLEAR: lv_guided_skipped, lv_guided_ledger_ok, lv_guided_ledger_msg.
    PERFORM build_gui_action_ledger
      USING    pt_script
      CHANGING lt_guided_actions lv_guided_skipped
               lv_guided_ledger_ok lv_guided_ledger_msg.
    IF lv_guided_ledger_ok <> abap_true.
      cv_message = lv_guided_ledger_msg.
      RETURN.
    ENDIF.

    LOOP AT lt_guided_actions INTO ls_guided_action.
      IF ls_guided_action-logical_key IS NOT INITIAL.
        INSERT ls_guided_action-logical_key INTO TABLE lt_guided_keys.
      ENDIF.
    ENDLOOP.
    IF lt_guided_keys IS INITIAL.
      cv_message =
        'GUIDED_ACTION_SET_EMPTY: capture found no exact user-modified SHDB-bound field.'.
      RETURN.
    ENDIF.
  ELSE.
    lv_confirm_origin = iv_origin.
    TRANSLATE lv_confirm_origin TO UPPER CASE.
    CONDENSE lv_confirm_origin NO-GAPS.
    lv_origin = lv_confirm_origin.
  ENDIF.

  "Fresh SHDB Import is one-click Mapping. Exact imported technical identity
  "is resolved against SAP DDIC before the chooser opens.  Import naming does
  "not replay the transaction and does not call AI; checkbox selection remains
  "the sole Template membership authority.

  IF gv_z659_action_ready = abap_true
     AND gv_z684_name_ready = abap_true
     AND gt_z333_rec_evidence IS NOT INITIAL
     AND ( gv_z659_action_script IS INITIAL
        OR gv_z659_action_script = iv_script_id ).
    IF iv_script_id IS NOT INITIAL AND iv_hash IS NOT INITIAL
       AND gv_z659_action_script IS INITIAL.
      CLEAR: lv_save_ok, lv_save_msg.
      PERFORM save_action_cert
        USING    iv_script_id iv_hash
        CHANGING lv_save_ok lv_save_msg.
      IF lv_save_ok <> abap_true.
        cv_message = lv_save_msg.
        RETURN.
      ENDIF.
    ENDIF.
    cv_ok = abap_true.
    cv_message = 'Current acquisition already has confirmed user-action membership.'.
    RETURN.
  ENDIF.


 "Fresh Import keeps manual confirmation because TXT has no USER_CHANGED bit.
 "Fresh Start Recording uses deterministic capture/action membership instead.
 "Both paths use exact SAP DDIC naming; no AI or TCODE hardcode is used.

 "A36 is the current confirmation contract for persisted My Import / All Import
 "history. A fresh acquisition must never inherit an older checkbox set for the
 "same Script/Hash, because a previous version may have over-promoted replay state.
 "Fresh RAW evidence therefore forces a new confirmation; persisted review keeps
 "the historical restore path unchanged.
  CLEAR: lv_loaded, lv_save_msg, lv_fresh_import.
  IF lv_guided_entry <> abap_true
     AND gt_z333_rec_evidence IS NOT INITIAL
     AND ( lv_origin = 'SHDB_TXT' OR lv_origin = 'SHDB_PROGRAM' ).
    lv_fresh_import = abap_true.
  ENDIF.

  "V17.9.3.12O - SHDB Import Mapper uses the recording as metadata, not as a
  "transaction replay.  PROGRAM/DYNPRO/FIELD come from TXT and DDIC resolves
  "description/type/length.  This avoids duplicate-create/date/state failures
  "such as FI01 while remaining completely generic.
  CLEAR: lv_import_live_ok, lv_import_live_msg, lv_import_tcode.
  REFRESH: gt_z935_import_live, gt_z865_gui_labels.
  IF lv_fresh_import = abap_true.
    REFRESH gt_z866_screen_caps.
    lv_import_live_ok  = abap_false.
    lv_import_live_msg =
      'IMPORT_DDIC_MAPPER: no CALL TRANSACTION; exact SHDB field identity is resolved through SAP DDIC.'.
  ENDIF.

  IF lv_guided_entry <> abap_true AND lv_fresh_import <> abap_true.
    PERFORM restore_action_cert
      USING    pt_script iv_script_id iv_hash
      CHANGING lv_loaded lv_save_msg.
    IF lv_loaded = abap_true.
      cv_ok = abap_true.
      cv_message = lv_save_msg.
      RETURN.
    ENDIF.
  ENDIF.

 "If an older exact certificate remembered membership but its presentation
 "names cannot be upgraded automatically, preserve that exact checkbox set
 "locally. The popup may need a naming review, but the user must not have to
 "remember and re-select the same business fields from scratch.
  lt_prior_actions = gt_z659_user_actions.

  REFRESH: gt_z659_user_actions, gt_z684_names, lt_pick.
  CLEAR: gv_z659_action_script, gv_z659_action_hash,
         gv_z659_action_ready, gv_z684_name_script,
         gv_z684_name_hash, gv_z684_name_ready.
  PERFORM get_projection_origin CHANGING lv_origin.
  IF lv_guided_entry = abap_true.
    lv_origin = 'GUIDED_RECORD'.
  ENDIF.

 "PASS 1: exact physical raw inventory. No nonblank requirement, no helper
 "filter and no FIELD(nn)->FIELD(*) collapse before the user sees the row.
  CLEAR: lv_prog, lv_dyn, lv_action, lv_sub_prog, lv_sub_dyn.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_prog = ls_script-program_name.
      lv_dyn  = ls_script-dynpro_no.
      CLEAR: lv_action, lv_sub_prog, lv_sub_dyn.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name = 'BDC_OKCODE'.
      CLEAR lv_action.
      PERFORM normalize_mapping_source
        USING    ls_script-static_value
        CHANGING lv_action.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name = 'BDC_SUBSCR'.
      CLEAR: lv_sub_raw, lv_sub_prog, lv_sub_dyn.
      lv_sub_raw = ls_script-static_value.
      lv_sub_len = strlen( lv_sub_raw ).
      IF lv_sub_len >= 44.
        lv_sub_prog = lv_sub_raw(40).
        lv_sub_dyn  = lv_sub_raw+40(4).
        CONDENSE lv_sub_prog NO-GAPS.
        CONDENSE lv_sub_dyn  NO-GAPS.
      ENDIF.
      CONTINUE.
    ENDIF.

    CLEAR lv_technical.
    PERFORM field_choreo_only
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    "Generated SHDB programs carry an explicit RECORD/dynamic marker.
    "For that source, do not broaden the chooser with static replay rows.
    IF lv_origin = 'SHDB_PROGRAM'.
      lv_type = ls_script-value_type.
      TRANSLATE lv_type TO UPPER CASE.
      CONDENSE lv_type NO-GAPS.
      IF lv_type <> gc_vt_dynamic.
        CONTINUE.
      ENDIF.
    ENDIF.

    CLEAR lv_exact.
    PERFORM exact_field_key
      USING    ls_script-field_name
      CHANGING lv_exact.
    IF lv_exact IS INITIAL.
      CONTINUE.
    ENDIF.

    "Start Recording membership authority: only exact fields proven by the
    "deterministic SAP GUI action ledger survive. RAW replay/default/helper
    "rows remain intact but never become Template fields.
    IF lv_guided_entry = abap_true.
      CLEAR lv_key.
      PERFORM logical_bdc_key USING lv_exact CHANGING lv_key.
      IF lv_key IS INITIAL.
        lv_key = lv_exact.
      ENDIF.
      READ TABLE lt_guided_keys
        WITH TABLE KEY table_line = lv_key
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.
    ENDIF.

 "offer exact visible/editable screen controls; cursor is not a membership gate.
 "Only structurally proven replay-controller state is removed; unknown metadata
 "still fails open so a real user field is never silently lost.
    IF lv_guided_entry <> abap_true
       AND lv_origin <> 'SHDB_TXT'
       AND lv_origin <> 'SHDB_PROGRAM'.
      CLEAR: lv_meta_known, lv_meta_input.
      PERFORM static_input_cap
        USING    pt_script lv_exact
        CHANGING lv_meta_known lv_meta_input.
      IF lv_meta_known = abap_true AND lv_meta_input <> abap_true.
        CONTINUE.
      ENDIF.
    ENDIF.

    "When automatic replay completed every recorded screen, only controls that
    "were physically observed on those exact live screens remain Template
    "candidates. This removes replay/default/helper fields without any TCODE or
    "field-name hardcode. If capture was partial we deliberately skip this filter.
    IF lv_fresh_import = abap_true AND lv_import_live_ok = abap_true.
      CLEAR lv_key.
      PERFORM logical_bdc_key USING lv_exact CHANGING lv_key.
      IF lv_key IS INITIAL.
        lv_key = lv_exact.
      ENDIF.
      READ TABLE gt_z935_import_live TRANSPORTING NO FIELDS
        WITH KEY logical_key = lv_key.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.
    ENDIF.

    "Fresh Import must not expose SAP replay/default state just because a
    "real DD03L field exists. RAW replay is preserved; popup membership is
    "limited to direct cursor/repeat user-interaction proof.
    IF lv_fresh_import = abap_true
       AND ( lv_origin = 'SHDB_TXT' OR lv_origin = 'SHDB_PROGRAM' ).
      CLEAR: lv_direct, lv_direct_msg.
      PERFORM import_user_input_ok
        USING    pt_script lv_exact
        CHANGING lv_direct lv_direct_msg.
      IF lv_direct <> abap_true.
        CONTINUE.
      ENDIF.
    ENDIF.

    "Exact SAP DDIC gate shared by Import and Start Recording.
    IF lv_origin = 'SHDB_TXT'
       OR lv_origin = 'SHDB_PROGRAM'
       OR lv_guided_entry = abap_true.
      CLEAR: lv_ddic_desc, lv_ddic_type, lv_ddic_len, lv_ddic_meta_ok.
      PERFORM import_ddic_mapper_meta
        USING    lv_exact
        CHANGING lv_ddic_desc lv_ddic_type lv_ddic_len lv_ddic_meta_ok.
      IF lv_ddic_meta_ok <> abap_true OR lv_ddic_desc IS INITIAL.
        IF lv_guided_entry = abap_true.
          cv_message =
            |GUIDED_DDIC_BLOCK: user-modified field { lv_exact } has no exact active SAP DDIC Field/Description; nothing was guessed or published.|.
          RETURN.
        ENDIF.
        CONTINUE.
      ENDIF.
    ENDIF.

    INSERT lv_exact INTO TABLE lt_expected.

    READ TABLE lt_pick ASSIGNING <ls_pick>
      WITH KEY bdc_field = lv_exact.
    IF sy-subrc <> 0.
      CLEAR: ls_pick, lv_source, lv_context.
      ls_pick-bdc_field = lv_exact.

      "Import and Start Recording use the same exact SAP DDIC description.
      "Capture decides Start membership only; it never names fields.
      IF lv_origin = 'SHDB_TXT'
         OR lv_origin = 'SHDB_PROGRAM'
         OR lv_guided_entry = abap_true.
        lv_source = lv_ddic_desc.
      ELSE.
        PERFORM pick_friendly
          USING    pt_script lv_exact
          CHANGING lv_source.
      ENDIF.
      ls_pick-friendly = lv_source.

      IF ls_script-static_value IS INITIAL.
        ls_pick-example  = '<blank>'.
        ls_pick-evidence = 'RECORDED_BLANK'.
      ELSE.
        ls_pick-example  = ls_script-static_value.
        ls_pick-evidence = 'RECORDED_CANDIDATE'.
      ENDIF.

      lv_context = |{ lv_prog }/{ lv_dyn }|.
      IF lv_sub_prog IS NOT INITIAL AND lv_sub_dyn IS NOT INITIAL.
        lv_context = |{ lv_context } SUB { lv_sub_prog }/{ lv_sub_dyn }|.
      ENDIF.
      IF lv_action IS NOT INITIAL.
        lv_context = |{ lv_context } ACT { lv_action }|.
      ENDIF.
      ls_pick-context = lv_context.

      IF lv_origin <> 'SHDB_TXT'
         AND lv_origin <> 'SHDB_PROGRAM'
         AND lv_guided_entry <> abap_true.
        CLEAR: lv_direct, lv_direct_msg.
        PERFORM exact_pai_cursor_ev
          USING    pt_script lv_exact
          CHANGING lv_direct lv_direct_msg.
        IF lv_direct = abap_true.
 "cursor proves focus/submission context, not USER_CHANGED.
 "Never pre-check a Template field from cursor alone.
          ls_pick-evidence = 'CURSOR_EVIDENCE_ONLY'.
        ENDIF.
      ENDIF.
      APPEND ls_pick TO lt_pick.
    ELSE.
      IF ls_script-static_value IS INITIAL.
        IF <ls_pick>-example IS INITIAL.
          <ls_pick>-example = '<blank>'.
        ENDIF.
      ELSE.
        <ls_pick>-example = ls_script-static_value.
      ENDIF.
      IF lv_origin <> 'SHDB_TXT'
         AND lv_origin <> 'SHDB_PROGRAM'
         AND lv_guided_entry <> abap_true.
        CLEAR: lv_direct, lv_direct_msg.
        PERFORM exact_pai_cursor_ev
          USING    pt_script lv_exact
          CHANGING lv_direct lv_direct_msg.
        IF lv_direct = abap_true.
          <ls_pick>-evidence = 'CURSOR_EVIDENCE_ONLY'.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDLOOP.

 "PASS 2: Start Recording does not union every FIELD_VALS entry.
 "FIELD_VALS is provenance only. Membership is the deterministic user-action
 "ledger already reconciled to immutable RAW replay above.

 "PASS 3 exact SAP screen metadata is LABEL/VALIDATION evidence only.
 "Do not expand candidate membership with controls that were never serialized
 "in the imported recording and were never captured by native FIELD_VALS.
 "Such a control has no exact executable replay binding, so offering it as a
 "selectable Template field would be misleading and would later fail binding.
  REFRESH lt_screen_inputs.
  IF lv_guided_entry <> abap_true.
    PERFORM collect_screen_inputs
      USING    pt_script
      CHANGING lt_screen_inputs.

    LOOP AT lt_screen_inputs INTO ls_screen_input.
      IF ls_screen_input-bdc_field IS INITIAL.
        CONTINUE.
      ENDIF.

      READ TABLE lt_pick ASSIGNING <ls_pick>
        WITH KEY bdc_field = ls_screen_input-bdc_field.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      IF <ls_pick>-friendly IS INITIAL
         AND ls_screen_input-friendly IS NOT INITIAL.
        <ls_pick>-friendly = ls_screen_input-friendly.
      ENDIF.
    ENDLOOP.
  ENDIF.

 "sample authority. Rebuild the visible example after the complete
 "candidate inventory exists. Later SAP-enriched/default/carry values must not
 "overwrite the earlier value aligned to the user's interaction. Native-only
 "rows keep their FIELD_VALS sample when no raw occurrence exists.
  LOOP AT lt_pick ASSIGNING <ls_pick>.
    CLEAR: lv_sample_found, lv_sample_value.
    PERFORM exact_sample
      USING    pt_script <ls_pick>-bdc_field
      CHANGING lv_sample_found lv_sample_value.
    IF lv_sample_found = abap_true.
      IF strlen( lv_sample_value ) > 255.
        cv_message =
          |SAMPLE_BLOCK: exact recorded history for { <ls_pick>-bdc_field } exceeds 255 characters; nothing was truncated or published.|.
        RETURN.
      ENDIF.
      <ls_pick>-example = lv_sample_value.
      IF <ls_pick>-evidence <> 'CURSOR_EVIDENCE_ONLY'.
        <ls_pick>-evidence = 'EXACT_RECORDED_HISTORY'.
      ENDIF.
    ENDIF.
  ENDLOOP.

 "inventory invariant: every eligible exact raw field and every eligible
 "native recorder field must be represented in the confirmation inventory
 "before the user is asked to decide. Screen-only repository controls are not
 "membership evidence and therefore are intentionally absent from this set.
 "If one executable-evidence field disappears here, fail closed rather than
 "publishing an incomplete chooser.
  REFRESH lt_candidate.
  LOOP AT lt_pick INTO ls_pick.
    IF ls_pick-bdc_field IS NOT INITIAL.
      INSERT ls_pick-bdc_field INTO TABLE lt_candidate.
    ENDIF.
  ENDLOOP.

  DESCRIBE TABLE lt_expected LINES lv_expected_n.
  DESCRIBE TABLE lt_candidate LINES lv_candidate_n.
  LOOP AT lt_expected INTO lv_exact.
    READ TABLE lt_candidate
      WITH TABLE KEY table_line = lv_exact
      TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      cv_message =
        |LOSSLESS_BLOCK: eligible field { lv_exact } disappeared before confirmation. Mapping/Template was not published.|.
      RETURN.
    ENDIF.
  ENDLOOP.
  IF lv_candidate_n < lv_expected_n.
    cv_message =
      |LOSSLESS_BLOCK: candidate inventory { lv_candidate_n } is smaller than eligible evidence { lv_expected_n }. Mapping/Template was not published.|.
    RETURN.
  ENDIF.

  IF lt_pick IS INITIAL.
    cv_message = 'No business-capable recorded/native field exists to confirm.'.
    RETURN.
  ENDIF.

 "Membership authority:
 "Import starts unchecked because TXT has no USER_CHANGED bit.
 "Start Recording rows are already proven by capture/action evidence, so every
 "surviving DDIC row is selected automatically; no manual ticking is needed.
  LOOP AT lt_pick ASSIGNING <ls_pick>.
    CLEAR <ls_pick>-mark.
    IF lv_guided_entry = abap_true.
      <ls_pick>-mark = 'X'.
    ENDIF.
  ENDLOOP.

 "An exact historical checkbox set is stronger than replay heuristics. When
 "present, it replaces the default preselection one-for-one. This path is used
 "only for review/migration; it does not become runtime authority until names
 "are proven and the A36 certificate is successfully saved.
  IF lt_prior_actions IS NOT INITIAL
     AND lv_guided_entry <> abap_true.
    LOOP AT lt_pick ASSIGNING <ls_pick>.
      CLEAR: <ls_pick>-mark, lv_ui_key.
      PERFORM logical_bdc_key
        USING    <ls_pick>-bdc_field
        CHANGING lv_ui_key.
      IF lv_ui_key IS INITIAL.
        lv_ui_key = <ls_pick>-bdc_field.
      ENDIF.
      READ TABLE lt_prior_actions
        WITH TABLE KEY table_line = lv_ui_key
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        <ls_pick>-mark = 'X'.
      ENDIF.
    ENDLOOP.
  ENDIF.

 "user-facing authority. The raw physical inventory stays intact for
 "lossless proof, but the chooser is grouped by the SAME logical field that
 "will become one Template column. Therefore the popup cannot show fake
 "FIELD(03)/FIELD(04) columns when runtime Mapping is FIELD(*).
  REFRESH lt_ui.
  LOOP AT lt_pick ASSIGNING <ls_pick>.
    CLEAR lv_ui_key.
    PERFORM logical_bdc_key
      USING    <ls_pick>-bdc_field
      CHANGING lv_ui_key.
    IF lv_ui_key IS INITIAL.
      lv_ui_key = <ls_pick>-bdc_field.
    ENDIF.

    READ TABLE lt_ui ASSIGNING <ls_ui>
      WITH KEY logic_key = lv_ui_key.
    IF sy-subrc <> 0.
      CLEAR: ls_ui, lv_source.
      ls_ui-logic_key = lv_ui_key.
      ls_ui-first_bdc = <ls_pick>-bdc_field.
      ls_ui-screen_ref = <ls_pick>-context.
      IF lv_origin = 'SHDB_TXT'
         OR lv_origin = 'SHDB_PROGRAM'
         OR lv_guided_entry = abap_true.
        "Exact SAP DDIC description already proven in PASS 1.
        lv_source = <ls_pick>-friendly.
      ELSE.
        PERFORM base_tpl_name
          USING    pt_script <ls_pick>-bdc_field
          CHANGING lv_source.
      ENDIF.
 "screen-only candidates may be absent from raw BDCDATA, so the
 "raw-block name resolver cannot always locate their owner. Reuse only the
 "exact screen/DDIC name already proven by collect_screen_inputs.
      IF lv_source IS INITIAL AND <ls_pick>-friendly IS NOT INITIAL.
        lv_source = <ls_pick>-friendly.
      ENDIF.
 "naming is no longer allowed to abort the complete confirmation
 "inventory. Plain SHDB TXT contains replay state as well as business input.
 "An unlabeled candidate remains available for user confirmation, but its
 "BASE_NAME stays blank. It can therefore be left unselected and replayed
 "STATIC. If the user explicitly selects it, validation after the popup
 "blocks publication because an exact friendly visible name is still absent.
      ls_ui-base_name = lv_source.
      ls_ui-mark      = <ls_pick>-mark.
      APPEND ls_ui TO lt_ui.
    ELSE.
      IF <ls_ui>-base_name IS INITIAL
         AND <ls_pick>-friendly IS NOT INITIAL.
        <ls_ui>-base_name = <ls_pick>-friendly.
      ENDIF.
      IF <ls_pick>-mark = 'X'.
        <ls_ui>-mark = 'X'.
      ENDIF.
    ENDIF.
  ENDLOOP.

 "Every physical candidate must belong to one logical chooser row. This is
 "the second lossless invariant: raw recall is preserved while UX is one row
 "per final Template field.
  LOOP AT lt_pick INTO ls_pick.
    CLEAR lv_ui_key.
    PERFORM logical_bdc_key
      USING    ls_pick-bdc_field
      CHANGING lv_ui_key.
    IF lv_ui_key IS INITIAL.
      lv_ui_key = ls_pick-bdc_field.
    ENDIF.
    READ TABLE lt_ui WITH KEY logic_key = lv_ui_key
      TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      cv_message =
        |UI_BLOCK: recorded field { ls_pick-bdc_field } has no logical Template row.|.
      RETURN.
    ENDIF.
  ENDLOOP.

 "Build the visible sample from ALL exact physical occurrences belonging to
 "one logical Template field. Indexed groups show row=value so the user can
 "remember every recorded entry while still confirming only one final column.
  LOOP AT lt_ui ASSIGNING <ls_ui>.
    CLEAR: lv_group_count, lv_join.
    REFRESH lt_sample_used.

    LOOP AT lt_pick INTO ls_pick.
      CLEAR lv_ui_key2.
      PERFORM logical_bdc_key
        USING    ls_pick-bdc_field
        CHANGING lv_ui_key2.
      IF lv_ui_key2 IS INITIAL.
        lv_ui_key2 = ls_pick-bdc_field.
      ENDIF.
      IF lv_ui_key2 = <ls_ui>-logic_key.
        lv_group_count = lv_group_count + 1.
      ENDIF.
    ENDLOOP.

    LOOP AT lt_pick INTO ls_pick.
      CLEAR lv_ui_key2.
      PERFORM logical_bdc_key
        USING    ls_pick-bdc_field
        CHANGING lv_ui_key2.
      IF lv_ui_key2 IS INITIAL.
        lv_ui_key2 = ls_pick-bdc_field.
      ENDIF.
      IF lv_ui_key2 <> <ls_ui>-logic_key.
        CONTINUE.
      ENDIF.

      lv_piece = ls_pick-example.
      CLEAR: lv_param, lv_idx, lv_indexed.
      PERFORM param_script_field_idx
        USING    ls_pick-bdc_field
        CHANGING lv_param lv_idx lv_indexed.
      IF lv_group_count > 1
         AND lv_indexed = abap_true
         AND lv_idx IS NOT INITIAL.
        lv_piece = |{ lv_idx }={ ls_pick-example }|.
      ENDIF.

      READ TABLE lt_sample_used
        WITH TABLE KEY table_line = lv_piece
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        CONTINUE.
      ENDIF.
      INSERT lv_piece INTO TABLE lt_sample_used.

      IF lv_join IS INITIAL.
        lv_join = lv_piece.
      ELSE.
        CONCATENATE lv_join lv_piece INTO lv_join SEPARATED BY '; '.
      ENDIF.
    ENDLOOP.

    IF lv_join IS INITIAL.
      lv_join = '<blank>'.
    ENDIF.
    IF strlen( lv_join ) > 255.
      cv_message =
        |SAMPLE_BLOCK: combined recorded sample for { <ls_ui>-logic_key } exceeds 255 characters; nothing was truncated or published.|.
      RETURN.
    ENDIF.
    <ls_ui>-example = lv_join.
  ENDLOOP.

 "V17.9.3.12W confirmation UX.
 "For SHDB Import, behave like a technical Process Runner mapper: exact
 "PROGRAM/DYNPRO/FIELD comes from the recording and description/type/length
 "comes from authoritative SAP DDIC or exact dynpro repository metadata. No runtime replay or AI.
  IF lv_origin = 'SHDB_TXT'
     OR lv_origin = 'SHDB_PROGRAM'
     OR lv_guided_entry = abap_true.
    LOOP AT lt_ui ASSIGNING <ls_ui>.
      CLEAR: lv_ddic_desc, lv_ddic_type, lv_ddic_len, lv_ddic_meta_ok,
             lv_ddic_label, lv_ddic_label_ok, lv_name.
      PERFORM import_auth_field_desc
        USING    pt_script <ls_ui>-first_bdc
        CHANGING lv_ddic_desc lv_ddic_type lv_ddic_len lv_ddic_meta_ok.
      PERFORM import_ddic_field_label
        USING    <ls_ui>-first_bdc
        CHANGING lv_ddic_label lv_ddic_label_ok.

      <ls_ui>-ddic_type = lv_ddic_type.
      <ls_ui>-ddic_len  = lv_ddic_len.

      "Field Description is display evidence only. The immutable Template
      "Field Name must come from SAP DDIC Field Label metadata.
      IF lv_ddic_meta_ok = abap_true AND lv_ddic_desc IS NOT INITIAL.
        <ls_ui>-display_name = lv_ddic_desc.
      ELSE.
        <ls_ui>-display_name = 'Description unavailable'.
      ENDIF.

      IF lv_ddic_label_ok = abap_true AND lv_ddic_label IS NOT INITIAL.
        lv_name = lv_ddic_label.
        PERFORM normalize_mapping_source USING lv_name CHANGING lv_name.
        <ls_ui>-base_name = lv_name.
      ELSE.
        CLEAR: <ls_ui>-base_name, <ls_ui>-mark.
      ENDIF.
    ENDLOOP.

    "SAP metadata naming is complete locally. No AI request is required.
    lv_import_ai_ok  = abap_true.
    IF lv_guided_entry = abap_true.
      lv_import_ai_msg =
        'GUIDED_SAP_METADATA_OK: user-action fields resolved through exact SAP DDIC; no AI.'.
    ELSE.
      lv_import_ai_msg =
        'IMPORT_SAP_METADATA_OK: exact DD03L fields with DD03T/DD04T descriptions only.'.
    ENDIF.
    REFRESH: gt_z659_user_actions, gt_z684_names.
    CLEAR: gv_z659_action_script, gv_z659_action_hash,
           gv_z659_action_ready, gv_z684_name_script,
           gv_z684_name_hash, gv_z684_name_ready.
  ELSE.
    "Legacy/non-acquisition path keeps its existing naming behavior.
    LOOP AT lt_ui ASSIGNING <ls_ui>.
      CLEAR lv_name.
      lv_name = <ls_ui>-base_name.
      PERFORM normalize_mapping_source
        USING    lv_name
        CHANGING lv_name.
      IF lv_name IS INITIAL.
        <ls_ui>-display_name = 'Label unavailable (recorded field)'.
        CLEAR <ls_ui>-mark.
      ELSE.
        <ls_ui>-display_name = lv_name.
      ENDIF.
    ENDLOOP.

    "Keep strict duplicate handling for Guided Recording only.
    LOOP AT lt_ui ASSIGNING <ls_ui> WHERE base_name IS NOT INITIAL.
      CLEAR lv_dup_count.
      LOOP AT lt_ui INTO ls_ui WHERE base_name = <ls_ui>-base_name.
        lv_dup_count = lv_dup_count + 1.
      ENDLOOP.
      IF lv_dup_count > 1.
        CLEAR: <ls_ui>-base_name, <ls_ui>-mark.
        <ls_ui>-display_name = 'Label ambiguous (recorded field)'.
      ENDIF.
    ENDLOOP.
  ENDIF.

  DEFINE add_z659_fcat.
    CLEAR ls_fieldcat.
    ls_fieldcat-fieldname = &1.
    ls_fieldcat-seltext_s = &2.
    ls_fieldcat-seltext_m = &3.
    ls_fieldcat-seltext_l = &3.
    ls_fieldcat-outputlen = &4.
    ls_fieldcat-no_out    = &5.
    APPEND ls_fieldcat TO lt_fieldcat.
  END-OF-DEFINITION.

  IF lv_origin = 'SHDB_TXT'
     OR lv_origin = 'SHDB_PROGRAM'
     OR lv_guided_entry = abap_true.
    "Exact SAP DDIC three-column view only.
    "The Import confirmation popup contains ONLY real DD03L-proven fields.
    "PROGRAM/DYNPRO screen rows and BDC choreography remain in RAW evidence
    "but are not rendered as fake SAP BDC Field rows in the mapper.
    REFRESH lt_popup.

    LOOP AT lt_ui INTO ls_ui.
      CLEAR ls_popup.
      ls_popup-row_kind     = 'F'.
      ls_popup-mark         = ls_ui-mark.
      ls_popup-logic_key    = ls_ui-logic_key.
      ls_popup-first_bdc    = ls_ui-first_bdc.
      ls_popup-display_name = ls_ui-display_name.

      CLEAR: lv_ddic_label, lv_ddic_label_ok.
      PERFORM import_ddic_field_label
        USING    ls_ui-first_bdc
        CHANGING lv_ddic_label lv_ddic_label_ok.
      IF lv_ddic_label_ok = abap_true AND lv_ddic_label IS NOT INITIAL.
        ls_popup-field_label = lv_ddic_label.
      ELSE.
        ls_popup-field_label = '-'.
      ENDIF.

      ls_popup-example      = ls_ui-example.
      APPEND ls_popup TO lt_popup.
    ENDLOOP.

    add_z659_fcat 'ROW_KIND' '' '' 1 'X'.
    add_z659_fcat 'LOGIC_KEY' '' '' 1 'X'.
    "12Y: the popup cannot be resized by the user, so reserve enough width
    "for the full authoritative SAP description instead of clipping it.
    add_z659_fcat 'FIRST_BDC' 'Field' 'SAP BDC Field' 34 ''.
    add_z659_fcat 'DISPLAY_NAME' 'Description' 'Field Description' 80 ''.
    add_z659_fcat 'FIELD_LABEL' 'Field Label' 'SAP Field Label' 50 ''.
    add_z659_fcat 'EXAMPLE' '' '' 1 'X'.
  ELSE.
    add_z659_fcat 'DISPLAY_NAME' 'Field' 'Template Field Name / status' 46 ''.
    add_z659_fcat 'EXAMPLE' 'Sample' 'What you entered / selected' 42 ''.
    add_z659_fcat 'FIRST_BDC' 'SAP ref' 'SAP field reference (diagnostic only)' 28 ''.
  ENDIF.

  lv_popup_title = 'Confirm Template fields and your recorded input'.
  IF lv_guided_entry = abap_true.
    lv_popup_title = 'Start Recording - SAP BDC Field / Description / Field Label'.
  ELSEIF lv_origin = 'SHDB_TXT' OR lv_origin = 'SHDB_PROGRAM'.
    lv_popup_title = 'Import SHDB - SAP BDC Field / Description / Field Label'.
  ENDIF.

  IF lv_guided_entry = abap_true.
    "Review-only: capture/action evidence already decided membership.
    "No checkbox/tick is exposed; green OK accepts the automatic set.
    CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
      EXPORTING
        i_title               = lv_popup_title
        i_selection           = space
        i_zebra               = 'X'
        i_tabname             = 'LT_POPUP'
        it_fieldcat           = lt_fieldcat
        i_screen_start_column = 1
        i_screen_start_line   = 2
        i_screen_end_column   = 190
        i_screen_end_line     = 29
      IMPORTING
        es_selfield           = ls_selfield
        e_exit                = lv_exit
      TABLES
        t_outtab              = lt_popup
      EXCEPTIONS
        program_error         = 1
        OTHERS                = 2.
    lv_popup_rc = sy-subrc.
  ELSEIF lv_origin = 'SHDB_TXT' OR lv_origin = 'SHDB_PROGRAM'.
    CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
      EXPORTING
        i_title               = lv_popup_title
        i_selection           = 'X'
        i_zebra               = 'X'
        i_checkbox_fieldname  = 'MARK'
        i_tabname             = 'LT_POPUP'
        it_fieldcat           = lt_fieldcat
        i_screen_start_column = 1
        i_screen_start_line   = 2
        i_screen_end_column   = 190
        i_screen_end_line     = 29
      IMPORTING
        es_selfield           = ls_selfield
        e_exit                = lv_exit
      TABLES
        t_outtab              = lt_popup
      EXCEPTIONS
        program_error         = 1
        OTHERS                = 2.
    lv_popup_rc = sy-subrc.

    LOOP AT lt_popup INTO ls_popup WHERE row_kind = 'F'.
      READ TABLE lt_ui ASSIGNING <ls_ui>
        WITH KEY logic_key = ls_popup-logic_key.
      IF sy-subrc = 0.
        <ls_ui>-mark = ls_popup-mark.
      ENDIF.
    ENDLOOP.
  ELSE.
    CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
      EXPORTING
        i_title               = lv_popup_title
        i_selection           = 'X'
        i_zebra               = 'X'
        i_checkbox_fieldname  = 'MARK'
        i_tabname             = 'LT_UI'
        it_fieldcat           = lt_fieldcat
        i_screen_start_column = 2
        i_screen_start_line   = 2
        i_screen_end_column   = 98
        i_screen_end_line     = 27
      IMPORTING
        es_selfield           = ls_selfield
        e_exit                = lv_exit
      TABLES
        t_outtab              = lt_ui
      EXCEPTIONS
        program_error         = 1
        OTHERS                = 2.
    lv_popup_rc = sy-subrc.
  ENDIF.

  IF lv_exit = 'X' OR lv_popup_rc <> 0.
    cv_message = 'User confirmation was cancelled; Mapping/Template was not published.'.
    RETURN.
  ENDIF.

 "USER SELECTION remains the sole membership authority. Naming and
 "collision checks apply only to selected rows. A selected row must have an
 "authoritative exact screen/DDIC semantic name; replay-only rows never poison
 "the Mapping simply because their label is unavailable.
  CLEAR lv_selected.
  REFRESH lt_name_used.
  LOOP AT lt_ui ASSIGNING <ls_ui> WHERE mark = 'X'.
    lv_selected = lv_selected + 1.

    "Guided Recording already owns full-screen visual naming evidence.
    "SHDB Import was pre-named from exact TXT/SAP context before this popup;
    "the checkbox state here still decides membership and AI never does.
    IF lv_origin <> 'SHDB_TXT'
       AND lv_origin <> 'SHDB_PROGRAM'
       AND lv_guided_entry <> abap_true.
      IF <ls_ui>-base_name IS INITIAL.
        cv_message =
          |SELECTED_NAME_REQUIRED: selected SAP field { <ls_ui>-first_bdc } has no uniquely proven full-screen visible label | &&
          |for this Guided Recording. Nothing was guessed; leave it unselected or re-record with the field/value visibly present.|.
        RETURN.
      ENDIF.

      CLEAR lv_name.
      lv_name = <ls_ui>-display_name.
      PERFORM normalize_mapping_source
        USING    lv_name
        CHANGING lv_name.
      IF lv_name IS INITIAL.
        cv_message =
          |SELECTED_NAME_REQUIRED: exact Template name for selected field { <ls_ui>-first_bdc } is empty after normalization.|.
        RETURN.
      ENDIF.

      READ TABLE lt_name_used
        WITH TABLE KEY table_line = lv_name
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        cv_message =
          |SELECTED_LABEL_COLLISION: more than one selected logical control resolves to semantic label { lv_name }. Nothing was published; no _2/_3 or technical guess was added.|.
        RETURN.
      ENDIF.
      INSERT lv_name INTO TABLE lt_name_used.
      <ls_ui>-display_name = lv_name.
    ENDIF.
  ENDLOOP.

  IF lv_selected = 0.
    IF lv_guided_entry = abap_true.
      cv_message =
        'GUIDED_ACTION_SET_EMPTY: no DDIC-proven user-modified field remains after deterministic capture reconciliation.'.
    ELSE.
      cv_message =
        'Select at least one field that you actually entered or changed; replay-only rows may remain unselected.'.
    ENDIF.
    RETURN.
  ENDIF.

 "Executable-binding invariant at the logical Template-row level.
  LOOP AT lt_ui INTO ls_ui WHERE mark = 'X'.
    CLEAR lv_bound.
    PERFORM raw_replay_bound
      USING    pt_script ls_ui-first_bdc
      CHANGING lv_bound.
    IF lv_bound <> abap_true.
      cv_message =
        |REPLAY_BIND_BLOCK: selected Template field { ls_ui-display_name } has no raw BDC replay binding.|.
      RETURN.
    ENDIF.
  ENDLOOP.

 "The chooser already represents FIELD(nn) occurrences as one logical
 "Template row, so partial indexed selection is impossible by construction.
 "Lock only the user-selected membership; Import naming was a prior display
 "assist and never participates in selected-field or Version identity.
  REFRESH: gt_z659_user_actions, gt_z684_names.
  LOOP AT lt_ui INTO ls_ui WHERE mark = 'X'.
    IF ls_ui-logic_key IS NOT INITIAL.
      INSERT ls_ui-logic_key INTO TABLE gt_z659_user_actions.
    ENDIF.
  ENDLOOP.

  IF lv_origin = 'SHDB_TXT'
     OR lv_origin = 'SHDB_PROGRAM'
     OR lv_guided_entry = abap_true.
 "Exact SAP DDIC metadata already named the immutable candidate inventory.
 "Only the user's selected subset is promoted now; no second paid request and
 "no AI decision about membership occurs after confirmation.
    REFRESH: gt_z684_names, lt_name_used.
    LOOP AT lt_ui INTO ls_ui WHERE mark = 'X'.
      CLEAR lv_name.
      "Persist the normalized SAP Field Label, never the Field Description.
      lv_name = ls_ui-base_name.
      PERFORM normalize_mapping_source
        USING    lv_name
        CHANGING lv_name.
      IF lv_name IS INITIAL.
        REFRESH: gt_z659_user_actions, gt_z684_names.
        cv_message =
          |DDIC_FIELD_LABEL_BLOCK: selected field { ls_ui-first_bdc } has no exact SAP DDIC Field Label for Template naming.|.
        RETURN.
      ENDIF.

      READ TABLE lt_name_used
        WITH TABLE KEY table_line = lv_name
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        REFRESH: gt_z659_user_actions, gt_z684_names.
        cv_message =
          |DDIC_NAME_COLLISION: selected Template name { lv_name } is not unique.|.
        RETURN.
      ENDIF.
      INSERT lv_name INTO TABLE lt_name_used.

      IF ls_ui-logic_key IS NOT INITIAL.
        DATA(ls_z684_import_name) = VALUE ty_z684_name_cert(
          logical_key = ls_ui-logic_key
          source_name = lv_name ).
        INSERT ls_z684_import_name INTO TABLE gt_z684_names.
      ENDIF.
    ENDLOOP.
  ELSE.
    LOOP AT lt_ui INTO ls_ui WHERE mark = 'X'.
      IF ls_ui-logic_key IS NOT INITIAL.
        DATA(ls_z684_name) = VALUE ty_z684_name_cert(
          logical_key = ls_ui-logic_key
          source_name = ls_ui-display_name ).
        INSERT ls_z684_name INTO TABLE gt_z684_names.
      ENDIF.
    ENDLOOP.
  ENDIF.

 "post-selection set invariant. The popup contains one row per logical
 "field, therefore selected row count, action-set cardinality and name-set
 "cardinality must be identical before any in-memory/persisted authority is set.
  DESCRIBE TABLE gt_z659_user_actions LINES lv_cert_action_n.
  DESCRIBE TABLE gt_z684_names LINES lv_cert_name_n.
  IF lv_cert_action_n <> lv_selected OR lv_cert_name_n <> lv_selected.
    REFRESH: gt_z659_user_actions, gt_z684_names.
    cv_message =
      |SELECTION_SET_BLOCK: selected={ lv_selected }, actions={ lv_cert_action_n }, names={ lv_cert_name_n }. Nothing was published.|.
    RETURN.
  ENDIF.

  gv_z659_action_script = iv_script_id.
  gv_z659_action_hash   = iv_hash.
  gv_z659_action_ready  = abap_true.
  gv_z684_name_script   = iv_script_id.
  gv_z684_name_hash     = iv_hash.
  gv_z684_name_ready    = abap_true.

  IF iv_script_id IS NOT INITIAL AND iv_hash IS NOT INITIAL.
    CLEAR: lv_save_ok, lv_save_msg.
    PERFORM save_action_cert
      USING    iv_script_id iv_hash
      CHANGING lv_save_ok lv_save_msg.
    IF lv_save_ok <> abap_true.
      cv_message = lv_save_msg.
      RETURN.
    ENDIF.
  ENDIF.

  IF lv_guided_entry = abap_true.
    "Keep GT_Z866_SCREEN_CAPS alive until the current Mapping Profile has consumed
    "the same acquisition. START_GUI_LABEL_CAPTURE cleans the prior capture at
    "the beginning of the next recording, so no previous acquisition can leak.
    cv_message =
      'Confirmed Start Recording Mapping: deterministic user-action capture selected the fields; SAP BDC Field, Field Description and SAP Field Label came from exact SAP DDIC. No AI used.'.
  ELSE.
    cv_message =
      'Confirmed Import Mapping: exact user-selected SAP BDC fields + authoritative SAP DDIC description/field-label metadata; no AI used.'.
  ENDIF.
  cv_ok = abap_true.
ENDFORM.

*& Strict same-PAI cursor ownership evidence

*& Plain SHDB TXT contains the frozen BDCDATA replay stream, not a literal
*& USER_TYPED/USER_CHANGED bit. Therefore Mapping must fail closed:
*& the candidate must have a value-bearing occurrence in one exact dynpro;
*& BDC_CURSOR in THAT SAME dynpro occurrence must point to the same logical
*& field (FIELD(01) and FIELD(*) are normalized to one logical identity);
*& same-screen peers, first appearance, changed value, cross-scope echo,
*& repeat-shape and "field present on a user screen" are NOT user proof.
*& This deliberately prefers false negatives over false positives. Any field
*& not proven here remains intact in the raw replay script but is not exposed
*& as an upload/template column.

FORM exact_pai_cursor_ev
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_ok     TYPE abap_bool
           cv_reason TYPE string.

  DATA: ls_script       TYPE ty_script_def_compat,
        lv_target       TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key   TYPE zbdc_mapping_bup-bdc_field,
        lv_norm         TYPE zbdc_mapping_bup-bdc_field,
        lv_key          TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor       TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor_key   TYPE zbdc_mapping_bup-bdc_field,
        lv_upper        TYPE string,
        lv_target_value TYPE abap_bool,
        lv_cursor_match TYPE abap_bool,
        lv_technical    TYPE abap_bool.

  CLEAR: cv_ok, cv_reason.
  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target_key IS INITIAL.
    cv_reason = 'NO_LOGICAL_FIELD'.
    RETURN.
  ENDIF.

  CLEAR: lv_target_value, lv_cursor_match.
  LOOP AT pt_script INTO ls_script.

    IF ls_script-is_new_screen = 'X'.
      IF lv_target_value = abap_true
         AND lv_cursor_match = abap_true.
        cv_ok = abap_true.
        cv_reason = 'EXACT_SAME_PAI_CURSOR_INPUT'.
        RETURN.
      ENDIF.
      CLEAR: lv_target_value, lv_cursor_match.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_upper = ls_script-field_name.
    TRANSLATE lv_upper TO UPPER CASE.
    CONDENSE lv_upper NO-GAPS.

    IF lv_upper = 'BDC_CURSOR'.
      CLEAR: lv_cursor, lv_cursor_key, lv_technical.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-static_value
        CHANGING lv_cursor.
      IF lv_cursor IS INITIAL.
        CONTINUE.
      ENDIF.
      PERFORM mapping_field_is_technical
        USING    lv_cursor
        CHANGING lv_technical.
      IF lv_technical = abap_true.
        CONTINUE.
      ENDIF.
      PERFORM logical_bdc_key
        USING    lv_cursor
        CHANGING lv_cursor_key.
      IF lv_cursor_key = lv_target_key.
        lv_cursor_match = abap_true.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF lv_upper = 'BDC_OKCODE'
       OR lv_upper = 'BDC_SUBSCR'
       OR ls_script-value_type = gc_m2_vt_ignore.
      CONTINUE.
    ENDIF.

    CLEAR: lv_norm, lv_key, lv_technical.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM mapping_field_is_technical
      USING    lv_norm
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key = lv_target_key
       AND ls_script-static_value IS NOT INITIAL.
      lv_target_value = abap_true.
    ENDIF.

  ENDLOOP.

  IF lv_target_value = abap_true
     AND lv_cursor_match = abap_true.
    cv_ok = abap_true.
    cv_reason = 'EXACT_SAME_PAI_CURSOR_INPUT'.
    RETURN.
  ENDIF.

  cv_reason = 'REPLAY_STATE_NO_EXACT_USER_ACTION'.
ENDFORM.

*& Strict SHDB Process user-action projection for TXT import

*& Plain SHDB TXT remains the complete immutable replay stream. Mapping is a
*& narrower fail-closed projection: only a value-bearing field whose logical
*& identity owns BDC_CURSOR in that SAME submitted dynpro is exposed. Same-screen
*& peers, first/changed values, cross-scope/repeat heuristics, carry-forward state,
*& helper choreography and fixed indexed process selections stay replay-only.
*& No TCODE, SAP application field/table, business label or literal value is
*& hardcoded. Start Recording uses the same strict same-PAI cursor gate after native
*& input-capability proof, so both acquisition paths fail closed the same way.

FORM import_bdc_role
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_role   TYPE string
           cv_reason TYPE string.

  DATA: lv_target    TYPE zbdc_mapping_bup-bdc_field,
        lv_technical TYPE abap_bool,
        lv_selected  TYPE abap_bool.

  CLEAR: cv_role, cv_reason.
  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  IF lv_target IS INITIAL.
    cv_role = 'REPLAY_ONLY'.
    cv_reason = 'IMPORT_NO_LOGICAL_FIELD'.
    RETURN.
  ENDIF.

  CLEAR lv_technical.
  PERFORM mapping_field_is_technical
    USING    lv_target
    CHANGING lv_technical.
  IF lv_technical = abap_true.
    cv_role = 'REPLAY_ONLY'.
    cv_reason = 'TECHNICAL_FIELD'.
    RETURN.
  ENDIF.

 "plain SHDB TXT is replay truth, not user-intent truth. After the
 "confirmation dialog, the immutable confirmed set is the ONLY Mapping /
 "Template membership authority. Unselected fields stay present in raw BDC
 "and continue to replay exactly as imported.
  IF gv_z659_action_ready <> abap_true.
    cv_role = 'AMBIGUOUS'.
    cv_reason = 'USER_ACTION_CERT_MISSING'.
    RETURN.
  ENDIF.

  CLEAR lv_selected.
  PERFORM action_selected
    USING    lv_target
    CHANGING lv_selected.
  IF lv_selected = abap_true.
    cv_role = 'DYNAMIC_PROVEN'.
    cv_reason = 'CONFIRMED_USER_ACTION'.
  ELSE.
    cv_role = 'REPLAY_ONLY'.
    cv_reason = 'CONFIRMED_REPLAY_STATE'.
  ENDIF.
ENDFORM.

FORM projection_role
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_role   TYPE string
           cv_reason TYPE string.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_key         TYPE zbdc_mapping_bup-bdc_field,
        lv_type        TYPE zbdc_sct_ver_bup-value_type,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_technical   TYPE abap_bool,
        lv_has_capture TYPE abap_bool,
        lv_parameterized TYPE abap_bool,
        lv_strong_ok   TYPE abap_bool,
        lv_strong_reason TYPE string,
        lv_occurrences TYPE i,
        lv_distinct    TYPE i,
        lv_exact_cursor TYPE abap_bool,
        lv_first_value TYPE string,
        lv_baseline_echo TYPE abap_bool,
        lv_origin TYPE c LENGTH 20,
        lv_native_ok TYPE abap_bool,
        lv_native_reason TYPE string.

  CLEAR: cv_role, cv_reason.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target_key IS INITIAL.
    cv_role = 'REPLAY_ONLY'.
    cv_reason = 'NO_LOGICAL_FIELD'.
    RETURN.
  ENDIF.

  CLEAR lv_technical.
  PERFORM mapping_field_is_technical
    USING    lv_target
    CHANGING lv_technical.
  IF lv_technical = abap_true.
    cv_role = 'REPLAY_ONLY'.
    cv_reason = 'TECHNICAL_FIELD'.
    RETURN.
  ENDIF.

 "Guided Recording is a separate provenance contract. The immutable
 "current acquisition origin decides this branch even if UI context later
 "becomes SCHEMA_REUSE/LOCKED_CONTRACT. Once the deterministic native-action
 "certificate exists, that exact CommandArray->SHDB set is final membership
 "authority. Do not reclassify it through FIELD_VALS or legacy heuristics.
  PERFORM get_projection_origin CHANGING lv_origin.

 "both supported SHDB import representations use the same exact
 "user-confirmed membership authority. TXT and generated SHDB programs are
 "only transport formats for replay evidence; neither may silently reclassify
 "a confirmed field through cursor/repeat/legacy heuristics after confirmation.
  IF lv_origin = 'SHDB_TXT' OR lv_origin = 'SHDB_PROGRAM'.
    PERFORM import_bdc_role
      USING    pt_script lv_target
      CHANGING cv_role cv_reason.
    RETURN.
  ENDIF.

  IF lv_origin = 'GUIDED_RECORD'.
    CLEAR: lv_native_ok, lv_native_reason.
    PERFORM guided_rec_input_ok
      USING    pt_script lv_target
      CHANGING lv_native_ok lv_native_reason.

    IF lv_native_ok = abap_true.
      cv_role = 'DYNAMIC_PROVEN'.
      cv_reason = lv_native_reason.
      IF cv_reason IS INITIAL.
        cv_reason = 'RECORDER_NATIVE_INPUT_FIELD'.
      ENDIF.
    ELSE.
 "Native provenance exists and says this recorded field is not an external
 "input. That is deterministic REPLAY_ONLY, not ambiguity.
      cv_role = 'REPLAY_ONLY'.
      cv_reason = lv_native_reason.
      IF cv_reason IS INITIAL.
        cv_reason = 'NOT_RECORDER_NATIVE_INPUT'.
      ENDIF.
    ENDIF.
    RETURN.
  ENDIF.

 "Prove that the logical field has captured data or an explicit dynamic
 "source contract. No helper/program family is an absolute exclusion.
  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    CLEAR: lv_norm, lv_key.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key <> lv_target_key.
      CONTINUE.
    ENDIF.

    IF ls_script-value_type = gc_m2_vt_ignore.
      CONTINUE.
    ENDIF.

    IF ls_script-static_value IS NOT INITIAL.
      lv_has_capture = abap_true.
    ENDIF.

    lv_type = ls_script-value_type.
    TRANSLATE lv_type TO UPPER CASE.
    CONDENSE lv_type NO-GAPS.
    IF lv_type = gc_vt_dynamic.
      CLEAR lv_source.
      PERFORM normalize_mapping_source
        USING    ls_script-source_column
        CHANGING lv_source.
      IF lv_source IS NOT INITIAL.
        lv_parameterized = abap_true.
      ENDIF.
    ENDIF.
  ENDLOOP.

  IF lv_has_capture <> abap_true.
    IF lv_parameterized = abap_true.
      cv_role = 'DYNAMIC_PROVEN'.
      cv_reason = 'PARAMETERIZED_CAPTURE_FIELD'.
    ELSE.
      cv_role = 'REPLAY_ONLY'.
      cv_reason = 'NO_FILLED_CAPTURE_EVIDENCE'.
    ENDIF.
    RETURN.
  ENDIF.

  CLEAR: lv_strong_ok, lv_strong_reason.
  PERFORM strong_user_ev
    USING    pt_script lv_target
    CHANGING lv_strong_ok lv_strong_reason.
  IF lv_strong_ok <> abap_true.
    cv_role = 'AMBIGUOUS'.
    cv_reason = lv_strong_reason.
    IF cv_reason IS INITIAL.
      cv_reason = 'RECORDED_VALUE_WITHOUT_STRONG_USER_EVIDENCE'.
    ENDIF.
    RETURN.
  ENDIF.

  cv_role = 'DYNAMIC_PROVEN'.
  cv_reason = lv_strong_reason.

 "Independent negative evidence. Constant value alone never demotes a field.
 "A helper/popup owner never demotes a field. Demotion requires a recording
 "timeline proving a pre-existing constant baseline in the SAME scope before
 "the cursor target receives data and before later value-bearing fields appear.
  CLEAR: lv_occurrences, lv_distinct, lv_exact_cursor, lv_first_value.
  PERFORM field_ev_stats
    USING    pt_script lv_target
    CHANGING lv_occurrences lv_distinct lv_exact_cursor lv_first_value.

  IF lv_exact_cursor <> abap_true
     AND lv_occurrences >= 2
     AND lv_distinct = 1.
    CLEAR lv_baseline_echo.
    PERFORM baseline_echo_ev
      USING    pt_script lv_target
      CHANGING lv_baseline_echo.
    IF lv_baseline_echo = abap_true.
      cv_role = 'AMBIGUOUS'.
      cv_reason = 'PREEXISTING_BASELINE_BEFORE_CURSOR_VALUE'.
    ENDIF.
  ENDIF.
ENDFORM.

*& Lossless canonical multi-TCODE projection membership

*& SHDB/BDCDATA does not carry a trustworthy USER_TYPED flag. Therefore
*& Mapping membership must not be inferred from cursor position, subscreen
*& program, PAI count, table-control row number or a TCODE.

*& Membership authority for a captured logical field is intentionally small:
*& 1. the field is not BDC/DYN technical choreography;
*& 2. at least one physical alias carries a recorded non-empty value and is
*& not explicitly IGNORE.

*& No program-family/helper heuristic is allowed to delete membership: a
*& generic popup shell may host a real business subscreen. DDIC is used only
*& after membership for labels/types/validation; DDIC cannot delete a field.

*& Physical table-control aliases are collapsed only for Mapping identity:
*& FIELD(01), FIELD(03), FIELD(04) -> FIELD(*). The frozen replay Script keeps
*& the exact physical FNAM/index captured by SHDB.

*& Z376 remains available as evidence/confidence for audit, but it is no
*& longer a membership gate. No TCODE, SAP application field/table, business
*& label, screen index pattern or recorded example value is hardcoded here.

*& Cross-scope user-edit persistence evidence

*& Plain SHDB TXT has no USER_TYPED flag. Exact BDC_CURSOR remains the
*& strongest single-field proof, but a user may edit several fields before
*& one PAI, so only one of them owns the final cursor. A second generic proof
*& is therefore allowed when the recording itself shows all of the following:
*& the logical field carries one stable non-empty value;
*& it appears in at least two DISTINCT concrete dynpro/subscreen scopes;
*& at least one of those exact scopes contains a real nontechnical cursor;
*& the candidate is neither BDC choreography nor a helper field.
*& This is recording-structure evidence only. No TCODE/table/field/value is
*& hardcoded, and one-scope defaults/derived peers remain replay-only.

FORM cross_scope_user_ev
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_ok     TYPE abap_bool
           cv_reason TYPE string.

  TYPES ty_t_z649_str TYPE SORTED TABLE OF string
                      WITH UNIQUE KEY table_line.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_key         TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor      TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_upper       TYPE string,
        lv_program     TYPE string,
        lv_dynpro      TYPE string,
        lv_scope       TYPE string,
        lv_subscope    TYPE string,
        lv_group       TYPE string,
        lv_value       TYPE string,
        lv_technical   TYPE abap_bool,
        lv_helper      TYPE abap_bool,
        lv_unsafe      TYPE abap_bool,
        lv_helper_msg  TYPE string,
        lv_scope_count TYPE i,
        lv_value_count TYPE i,
        lv_cursor_scope TYPE abap_bool.

  DATA: lt_target_scopes TYPE ty_t_z649_str,
        lt_cursor_scopes TYPE ty_t_z649_str,
        lt_values        TYPE ty_t_z649_str.

  CLEAR: cv_ok, cv_reason.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target IS INITIAL OR lv_target_key IS INITIAL.
    cv_reason = 'NO_LOGICAL_FIELD'.
    RETURN.
  ENDIF.

  CLEAR: lv_technical, lv_helper, lv_unsafe, lv_helper_msg.
  PERFORM mapping_field_is_technical
    USING    lv_target
    CHANGING lv_technical.
  IF lv_technical = abap_true.
    cv_reason = 'TECHNICAL_FIELD'.
    RETURN.
  ENDIF.
  PERFORM field_helper_role
    USING    pt_script lv_target
    CHANGING lv_helper lv_unsafe lv_helper_msg.
  IF lv_helper = abap_true.
    cv_reason = 'HELPER_FIELD'.
    RETURN.
  ENDIF.

  CLEAR: lv_program, lv_dynpro, lv_scope, lv_group.
  LOOP AT pt_script INTO ls_script.
    IF ls_script-is_new_screen = 'X'.
      lv_program = ls_script-program_name.
      lv_dynpro  = ls_script-dynpro_no.
      lv_scope   = 'ROOT'.
      lv_group   = |{ lv_program }#{ lv_dynpro }#ROOT|.
      CONTINUE.
    ENDIF.

    IF ls_script-field_name IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_upper = ls_script-field_name.
    TRANSLATE lv_upper TO UPPER CASE.
    CONDENSE lv_upper NO-GAPS.

    IF lv_upper = 'BDC_SUBSCR'.
      lv_subscope = ls_script-static_value.
      CONDENSE lv_subscope.
      IF lv_subscope IS INITIAL.
        lv_scope = 'ROOT'.
      ELSE.
        lv_scope = lv_subscope.
      ENDIF.
      lv_group = |{ lv_program }#{ lv_dynpro }#{ lv_scope }|.
      CONTINUE.
    ENDIF.

    IF lv_upper = 'BDC_CURSOR'.
      CLEAR: lv_cursor, lv_cursor_key, lv_technical,
             lv_helper, lv_unsafe, lv_helper_msg.
      PERFORM normalize_mapping_bdc_field
        USING    ls_script-static_value
        CHANGING lv_cursor.
      IF lv_cursor IS INITIAL.
        CONTINUE.
      ENDIF.
      PERFORM mapping_field_is_technical
        USING    lv_cursor
        CHANGING lv_technical.
      IF lv_technical = abap_true.
        CONTINUE.
      ENDIF.
      PERFORM field_helper_role
        USING    pt_script lv_cursor
        CHANGING lv_helper lv_unsafe lv_helper_msg.
      IF lv_helper = abap_true.
        CONTINUE.
      ENDIF.
      PERFORM logical_bdc_key
        USING    lv_cursor
        CHANGING lv_cursor_key.
      IF lv_cursor_key IS NOT INITIAL AND lv_group IS NOT INITIAL.
        INSERT lv_group INTO TABLE lt_cursor_scopes.
      ENDIF.
      CONTINUE.
    ENDIF.

    IF lv_upper = 'BDC_OKCODE'
       OR ls_script-value_type = gc_m2_vt_ignore
       OR ls_script-static_value IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR: lv_norm, lv_key, lv_technical.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    IF lv_norm IS INITIAL.
      CONTINUE.
    ENDIF.
    PERFORM mapping_field_is_technical
      USING    lv_norm
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_key.
    IF lv_key <> lv_target_key.
      CONTINUE.
    ENDIF.

    lv_value = ls_script-static_value.
    SHIFT lv_value LEFT  DELETING LEADING space.
    SHIFT lv_value RIGHT DELETING TRAILING space.
    IF lv_value IS INITIAL OR lv_group IS INITIAL.
      CONTINUE.
    ENDIF.

    INSERT lv_group INTO TABLE lt_target_scopes.
    INSERT lv_value INTO TABLE lt_values.
  ENDLOOP.

  DESCRIBE TABLE lt_target_scopes LINES lv_scope_count.
  DESCRIBE TABLE lt_values        LINES lv_value_count.
  IF lv_scope_count < 2 OR lv_value_count <> 1.
    cv_reason = 'NO_STABLE_CROSS_SCOPE_USER_EVIDENCE'.
    RETURN.
  ENDIF.

  CLEAR lv_cursor_scope.
  LOOP AT lt_target_scopes INTO lv_group.
    READ TABLE lt_cursor_scopes
      WITH TABLE KEY table_line = lv_group
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      lv_cursor_scope = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.
  IF lv_cursor_scope <> abap_true.
    cv_reason = 'CROSS_SCOPE_VALUE_WITHOUT_INTERACTION_SCOPE'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  cv_reason = 'STABLE_VALUE_ACROSS_USER_INTERACTION_SCOPES'.
ENDFORM.

*& Materialize provenance-approved user fields for Mapping compilation

*& EXEC_RAW remains immutable. This helper annotates a working copy used for
*& Mapping membership so downstream generic Mapping code can reuse its normal
*& DYNAMIC path. Only fields already present in the current acquisition can be
*& promoted. Source names come from existing recording metadata or generic
*& DDIC semantic labels; DDIC is used only after interaction proof.

FORM project_user_members
  CHANGING ct_script TYPE ty_t_script.

  DATA: lt_raw         TYPE ty_t_script,
        ls_script      TYPE ty_script_def_compat,
        lv_norm        TYPE zbdc_mapping_bup-bdc_field,
        lv_logical     TYPE zbdc_mapping_bup-bdc_field,
        lv_scr_norm    TYPE zbdc_mapping_bup-bdc_field,
        lv_scr_logical TYPE zbdc_mapping_bup-bdc_field,
        lv_role        TYPE string,
        lv_reason      TYPE string,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_source_tech TYPE abap_bool,
        lv_technical   TYPE abap_bool.

  DATA lt_seen TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
               WITH UNIQUE KEY table_line.

  FIELD-SYMBOLS <ls_script> TYPE ty_script_def_compat.

  IF ct_script IS INITIAL.
    RETURN.
  ENDIF.
  lt_raw = ct_script.

  LOOP AT lt_raw INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    CLEAR lv_technical.
    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    CLEAR: lv_norm, lv_logical.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_norm.
    PERFORM logical_bdc_key
      USING    lv_norm
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      CONTINUE.
    ENDIF.

    READ TABLE lt_seen
      WITH TABLE KEY table_line = lv_logical
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT lv_logical INTO TABLE lt_seen.

    CLEAR: lv_role, lv_reason.
    PERFORM projection_role
      USING    lt_raw lv_norm
      CHANGING lv_role lv_reason.
    IF lv_role <> 'DYNAMIC_PROVEN'.
      CONTINUE.
    ENDIF.

    CLEAR lv_source.
    LOOP AT lt_raw INTO DATA(ls_source_row)
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL
        AND source_column IS NOT INITIAL.
      CLEAR: lv_scr_norm, lv_scr_logical.
      PERFORM normalize_mapping_bdc_field
        USING    ls_source_row-field_name
        CHANGING lv_scr_norm.
      PERFORM logical_bdc_key
        USING    lv_scr_norm
        CHANGING lv_scr_logical.
      IF lv_scr_logical = lv_logical.
        lv_source = ls_source_row-source_column.
        EXIT.
      ENDIF.
    ENDLOOP.

    PERFORM normalize_mapping_source
      USING    lv_source
      CHANGING lv_source.
    CLEAR lv_source_tech.
    PERFORM mapping_source_is_technical
      USING    lv_source lv_norm
      CHANGING lv_source_tech.
    IF lv_source IS INITIAL OR lv_source_tech = abap_true.
      CLEAR lv_source.
      PERFORM source_from_bdc
        USING    lv_norm
        CHANGING lv_source.
    ENDIF.
    PERFORM normalize_mapping_source
      USING    lv_source
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      CONTINUE.
    ENDIF.

    LOOP AT ct_script ASSIGNING <ls_script>
      WHERE is_new_screen IS INITIAL
        AND field_name IS NOT INITIAL.
      CLEAR: lv_scr_norm, lv_scr_logical.
      PERFORM normalize_mapping_bdc_field
        USING    <ls_script>-field_name
        CHANGING lv_scr_norm.
      PERFORM logical_bdc_key
        USING    lv_scr_norm
        CHANGING lv_scr_logical.
      IF lv_scr_logical <> lv_logical.
        CONTINUE.
      ENDIF.
      <ls_script>-value_type = gc_vt_dynamic.
      <ls_script>-source_column = lv_source.
    ENDLOOP.
  ENDLOOP.
ENDFORM.

*& strict USER-ENTERED-ONLY recording evidence filter

*& Truth boundary:
*& Plain SHDB/BDCDATA has no trustworthy USER_TYPED flag.
*& Exact cursor ownership is positive evidence only for that logical field.
*& Coherent indexed repeating rows may bridge true multi-row data entry.
*& Same-scope peers, singleton subscreens and repeated SAP echoes are NOT
*& promoted to Mapping/Template; their recorded values remain replay state.
*& Start Recording and Import call the same classifier; no TCODE/field/table
*& branch is used.

FORM user_interaction_ev_ok
  USING    pt_script TYPE ty_t_script
           iv_field  TYPE any
  CHANGING cv_ok     TYPE abap_bool
           cv_reason TYPE string.

  DATA: ls_script      TYPE ty_script_def_compat,
        lv_target      TYPE zbdc_mapping_bup-bdc_field,
        lv_target_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor      TYPE zbdc_mapping_bup-bdc_field,
        lv_cursor_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_field_upper TYPE string,
        lv_technical   TYPE abap_bool,
        lv_repeat_ok   TYPE abap_bool,
        lv_repeat_msg  TYPE string,
        lv_cross_ok    TYPE abap_bool,
        lv_cross_msg   TYPE string.

  CLEAR: cv_ok, cv_reason.

  PERFORM normalize_mapping_bdc_field
    USING    iv_field
    CHANGING lv_target.
  PERFORM logical_bdc_key
    USING    lv_target
    CHANGING lv_target_key.
  IF lv_target IS INITIAL OR lv_target_key IS INITIAL.
    cv_reason = 'NO_LOGICAL_FIELD'.
    RETURN.
  ENDIF.

  PERFORM mapping_field_is_technical
    USING    lv_target
    CHANGING lv_technical.
  IF lv_technical = abap_true.
    cv_reason = 'TECHNICAL_FIELD'.
    RETURN.
  ENDIF.

 "USER-ENTERED-ONLY projection.
 "Plain SHDB TXT/BDCDATA has no trustworthy USER_TYPED bit. Therefore a
 "cursor on one field must never authorize every other filled field on the
 "same screen/subscreen, and repeated SAP echoes must never authorize a
 "Template column. Positive evidence is deliberately narrow:
 " 1) exact BDC_CURSOR target for this logical field; or
 " 2) Z552 coherent indexed repeating-row evidence for true multi-row input.
 "Everything else remains replay state and keeps its recorded value STATIC.
 "Generated SHDB Program record parameters are handled separately by Z557.

  CLEAR: lv_repeat_ok, lv_repeat_msg.
  PERFORM repeat_group_user_ev
    USING    pt_script lv_target
    CHANGING lv_repeat_ok lv_repeat_msg.
  IF lv_repeat_ok = abap_true.
    cv_ok = abap_true.
    cv_reason = lv_repeat_msg.
    IF cv_reason IS INITIAL.
      cv_reason = 'USER_REPEAT_GROUP_FIRST_PAI'.
    ENDIF.
    RETURN.
  ENDIF.

  LOOP AT pt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    lv_field_upper = ls_script-field_name.
    TRANSLATE lv_field_upper TO UPPER CASE.
    CONDENSE lv_field_upper NO-GAPS.
    IF lv_field_upper <> 'BDC_CURSOR'.
      CONTINUE.
    ENDIF.

    CLEAR: lv_cursor, lv_cursor_key, lv_technical.
    PERFORM normalize_mapping_bdc_field
      USING    ls_script-static_value
      CHANGING lv_cursor.
    IF lv_cursor IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    lv_cursor
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key
      USING    lv_cursor
      CHANGING lv_cursor_key.
    IF lv_cursor_key = lv_target_key.
      cv_ok = abap_true.
      cv_reason = 'EXACT_BDC_CURSOR_USER_EVIDENCE'.
      RETURN.
    ENDIF.
  ENDLOOP.

 "one cursor can represent a multi-field edit cohort. Accept a
 "non-cursor peer only when the raw recording itself proves the same stable
 "value across distinct concrete scopes and one of those scopes is an actual
 "user-interaction scope. One-scope defaults remain replay-only.
  CLEAR: lv_cross_ok, lv_cross_msg.
  PERFORM cross_scope_user_ev
    USING    pt_script lv_target
    CHANGING lv_cross_ok lv_cross_msg.
  IF lv_cross_ok = abap_true.
    cv_ok = abap_true.
    cv_reason = lv_cross_msg.
    RETURN.
  ENDIF.

  IF lv_cross_msg IS NOT INITIAL.
    cv_reason = lv_cross_msg.
  ELSE.
    cv_reason = 'RECORDED_VALUE_WITHOUT_EXACT_USER_EVIDENCE'.
  ENDIF.
ENDFORM.

*& Internal fallback alias projection guard

*& INPUT_* is generated only as technical evidence when no stable business
*& source exists. It may remain in historical replay/audit repositories, but
*& it must never be shown, locked, persisted to Field Guide, or emitted as a
*& CSV/XLSX/Gmail/Drive input column. The rule is namespace-based and generic;
*& no TCODE, SAP table, or business field is encoded.

*& Frozen generated-template manifest
*& The generated file header itself is the immutable public schema artifact.
*& Persist the exact ordered SOURCE_COLUMN list on the immutable SCRIPT_ID so
*& upload never has to reconstruct a versioned template from current Mapping,
*& Field Guide, acquisition context, or TCODE-specific knowledge.

FORM template_manifest_kind
  USING    iv_index TYPE i
  CHANGING cv_kind  TYPE string.

  DATA lv_idx TYPE n LENGTH 4.

  CLEAR cv_kind.
  IF iv_index <= 0 OR iv_index > 9999.
    RETURN.
  ENDIF.

  lv_idx = iv_index.
  CONCATENATE 'TMPL' lv_idx INTO cv_kind.
ENDFORM.

FORM resolve_template_script_id
  USING    iv_tcode     TYPE zbdc_prof_bup-tcode
           iv_profile   TYPE zbdc_prof_bup-profile_name
           iv_ver       TYPE zbdc_prof_bup-profile_ver
  CHANGING cv_script_id TYPE zbdc_script_bup-script_id
           cv_ok        TYPE abap_bool
           cv_message   TYPE string.

  DATA: lt_script TYPE ty_t_script,
        lv_hash   TYPE zbdc_script_bup-contract_hash,
        lv_found  TYPE abap_bool.

  CLEAR: cv_script_id, cv_ok, cv_message.
  REFRESH lt_script.

  PERFORM load_profile_script
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_script cv_script_id lv_hash lv_found.

  IF lv_found <> abap_true OR cv_script_id IS INITIAL.
    cv_message = |Exact immutable Script ID could not be resolved for { iv_tcode }/{ iv_profile } v{ iv_ver }.|.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

FORM load_template_manifest
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
  CHANGING ct_sources TYPE string_table
           cv_found   TYPE abap_bool
           cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_script_id   TYPE zbdc_script_bup-script_id,
        lv_resolve_ok  TYPE abap_bool,
        lv_count_cfg   TYPE zbdc_config_bup-config_value,
        lv_count_text  TYPE string,
        lv_value       TYPE zbdc_config_bup-config_value,
        lv_kind        TYPE string,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_count       TYPE i,
        lv_index       TYPE i,
        lv_count_valid TYPE abap_bool,
        lv_cfg_exists  TYPE abap_bool.

  CLEAR: cv_found, cv_ok, cv_message.
  REFRESH ct_sources.

  PERFORM resolve_template_script_id
    USING    iv_tcode iv_profile iv_ver
    CHANGING lv_script_id lv_resolve_ok cv_message.
  IF lv_resolve_ok <> abap_true.
    RETURN.
  ENDIF.

  "TMPLCNT is metadata only. The ordered TMPL0001..TMPLnnnn rows are the
  "actual frozen manifest. Older/current profiles must remain readable even
  "if the cached count was written in a representation this loader dislikes.
  CLEAR lv_count_cfg.
  PERFORM get_script_cfg
    USING    lv_script_id 'TMPLCNT'
    CHANGING lv_count_cfg.

  lv_count_text = lv_count_cfg.
  CONDENSE lv_count_text NO-GAPS.
  IF lv_count_text IS NOT INITIAL.
    lv_cfg_exists = abap_true.

    IF lv_count_text CO '0123456789'.
      TRY.
          lv_count = CONV i( lv_count_text ).
          IF lv_count > 0 AND lv_count <= 9999.
            lv_count_valid = abap_true.
          ENDIF.
        CATCH cx_root.
          CLEAR lv_count_valid.
      ENDTRY.
    ENDIF.
  ENDIF.

  "Fast path for a valid cached count.
  IF lv_count_valid = abap_true.
    cv_found = abap_true.

    DO lv_count TIMES.
      lv_index = sy-index.
      CLEAR: lv_kind, lv_value, lv_source.

      PERFORM template_manifest_kind
        USING    lv_index
        CHANGING lv_kind.
      IF lv_kind IS INITIAL.
        cv_message =
          |Frozen Template manifest contains an invalid column index { lv_index }.|.
        RETURN.
      ENDIF.

      PERFORM get_script_cfg
        USING    lv_script_id lv_kind
        CHANGING lv_value.
      IF lv_value IS INITIAL.
        cv_message =
          |Frozen Template manifest is incomplete at column { lv_index }.|.
        RETURN.
      ENDIF.

      PERFORM normalize_mapping_source
        USING    lv_value
        CHANGING lv_source.
      IF lv_source IS INITIAL.
        cv_message =
          |Frozen Template manifest contains an invalid source at column { lv_index }.|.
        RETURN.
      ENDIF.

      APPEND lv_source TO ct_sources.
    ENDDO.

    cv_ok = abap_true.
    RETURN.
  ENDIF.

  "Recovery path:
  "Do not reject a generated/uploaded template just because TMPLCNT metadata is
  "stale/corrupt. Recover the immutable ordered manifest directly from the
  "contiguous TMPL0001.. rows. This is still exact-version data; no Mapping
  "rebuild, TCODE branch or uploaded-header trust is involved.
  CLEAR lv_index.
  DO 9999 TIMES.
    lv_index = sy-index.
    CLEAR: lv_kind, lv_value, lv_source.

    PERFORM template_manifest_kind
      USING    lv_index
      CHANGING lv_kind.
    IF lv_kind IS INITIAL.
      EXIT.
    ENDIF.

    PERFORM get_script_cfg
      USING    lv_script_id lv_kind
      CHANGING lv_value.
    IF lv_value IS INITIAL.
      EXIT.
    ENDIF.

    PERFORM normalize_mapping_source
      USING    lv_value
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      cv_found = abap_true.
      cv_message =
        |Frozen Template manifest contains an invalid source at recovered column { lv_index }.|.
      REFRESH ct_sources.
      RETURN.
    ENDIF.

    APPEND lv_source TO ct_sources.
  ENDDO.

  IF ct_sources IS INITIAL.
    IF lv_cfg_exists = abap_true.
      cv_found = abap_true.
      cv_message =
        'Frozen Template manifest metadata exists, but no ordered manifest columns can be recovered.'.
      RETURN.
    ENDIF.

    "No frozen manifest at all: keep legacy migration behavior.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  cv_found = abap_true.
  cv_ok = abap_true.
ENDFORM.

*& Align generated artifact order with the immutable version manifest
*&
*& PROFILE_VER identity is intentionally order-insensitive (SCRIPT_SCHEMA_FP
*& uses a sorted canonical token set). Therefore a repeated Import/Recording
*& with the exact same selected business fields/names must reuse the version
*& even if the current Mapping rows arrive in a different display/order path.
*& If this version already owns an ordered generated-header manifest, that
*& manifest is the canonical artifact order. Reorder the current field list to
*& it only when membership is exactly identical; never hide a real field-set
*& change and never overwrite the immutable manifest.
FORM freeze_template_manifest
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
           it_sources TYPE string_table
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_script_id TYPE zbdc_script_bup-script_id,
        lv_resolve_ok TYPE abap_bool,
        lt_norm      TYPE string_table,
        lt_existing  TYPE string_table,
        lt_seen      TYPE SORTED TABLE OF zbdc_mapping_bup-source_column WITH UNIQUE KEY table_line,
        lv_source    TYPE zbdc_mapping_bup-source_column,
        lv_existing_found TYPE abap_bool,
        lv_existing_ok TYPE abap_bool,
        lv_kind      TYPE string,
        lv_value     TYPE string,
        lv_set_ok    TYPE abap_bool,
        lv_set_msg   TYPE string,
        lv_index     TYPE i,
        lv_count     TYPE i,
        lv_count_txt TYPE string.

  CLEAR: cv_ok, cv_message.

  LOOP AT it_sources INTO lv_value.
    CLEAR lv_source.
    PERFORM normalize_mapping_source
      USING    lv_value
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      cv_message = 'Generated Template contains an empty/invalid source column.' .
      RETURN.
    ENDIF.
    INSERT lv_source INTO TABLE lt_seen.
    IF sy-subrc <> 0.
      cv_message = |Generated Template contains duplicate normalized source column { lv_source }.|.
      RETURN.
    ENDIF.
    APPEND lv_source TO lt_norm.
  ENDLOOP.

  IF lt_norm IS INITIAL.
    cv_message = 'Generated Template contains no schema columns to freeze.' .
    RETURN.
  ENDIF.

  CLEAR: lv_existing_found, lv_existing_ok, lv_set_msg.
  PERFORM load_template_manifest
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_existing lv_existing_found lv_existing_ok lv_set_msg.

  "V17.9.2: the ordered Template manifest is a derivative artifact, never a
  "second Version gate. VERSIONFP has already routed SAME -> reuse and
  "DIFFERENT -> new version from selected SAP fields + technical choreography.
  "If a legacy/stale manifest differs, repair it from the current version-owned
  "Mapping projection instead of blocking Generate Template.
  IF lv_existing_found = abap_true
     AND lv_existing_ok = abap_true
     AND lt_existing = lt_norm.
    cv_ok = abap_true.
    RETURN.
  ENDIF.
  CLEAR lv_set_msg.

  CLEAR: lv_script_id, lv_resolve_ok, lv_set_msg.
  PERFORM resolve_template_script_id
    USING    iv_tcode iv_profile iv_ver
    CHANGING lv_script_id lv_resolve_ok lv_set_msg.
  IF lv_resolve_ok <> abap_true.
    cv_message = lv_set_msg.
    RETURN.
  ENDIF.

  lv_index = 0.
  LOOP AT lt_norm INTO lv_source.
    lv_index = lv_index + 1.
    CLEAR: lv_kind, lv_set_ok, lv_set_msg.
    PERFORM template_manifest_kind
      USING    lv_index
      CHANGING lv_kind.
    PERFORM set_script_cfg
      USING    lv_script_id lv_kind lv_source
      CHANGING lv_set_ok lv_set_msg.
    IF lv_set_ok <> abap_true.
      ROLLBACK WORK.
      cv_message = lv_set_msg.
      IF cv_message IS INITIAL.
        cv_message = |Generated Template manifest could not save column { lv_index }.|.
      ENDIF.
      RETURN.
    ENDIF.
  ENDLOOP.

  lv_count = lines( lt_norm ).
  lv_count_txt = lv_count.
  CONDENSE lv_count_txt NO-GAPS.
  CLEAR: lv_set_ok, lv_set_msg.
  PERFORM set_script_cfg
    USING    lv_script_id 'TMPLCNT' lv_count_txt
    CHANGING lv_set_ok lv_set_msg.
  IF lv_set_ok <> abap_true.
    ROLLBACK WORK.
    cv_message = lv_set_msg.
    IF cv_message IS INITIAL.
      cv_message = 'Generated Template manifest count could not be frozen.' .
    ENDIF.
    RETURN.
  ENDIF.

  COMMIT WORK AND WAIT.
  cv_ok = abap_true.
ENDFORM.

FORM prove_template_header_schema
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
           it_sources TYPE string_table
  CHANGING cv_proven  TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_fields       TYPE ty_t_xlsx_field,
        lt_expected     TYPE string_table,
        lt_seen         TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                        WITH UNIQUE KEY table_line,
        lv_contract_ok  TYPE abap_bool,
        lv_source       TYPE zbdc_mapping_bup-source_column,
        lv_expected     TYPE string,
        lv_actual       TYPE string,
        lv_index        TYPE i,
        lv_count        TYPE i.

  CLEAR: cv_proven, cv_message.

  IF it_sources IS INITIAL.
    cv_message = 'Uploaded Template header is empty.'.
    RETURN.
  ENDIF.

 "Legacy migration must replay the same generic generator that emitted the
 "template, not hash the broader raw Mapping repository. BUILD_XLSX_CONTRACT
 "is the single CSV/XLSX schema authority used by Generate Template. Running
 "it in-memory for the exact TCODE/Profile/Version therefore reproduces the
 "canonical emitted header without trusting the uploaded file or introducing
 "TCODE/business-field branches.
  CLEAR lv_contract_ok.
  REFRESH: lt_fields, lt_expected.
  PERFORM build_xlsx_contract
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_fields lv_contract_ok.

  IF lv_contract_ok <> abap_true OR lt_fields IS INITIAL.
    cv_message = 'Legacy generated Template schema could not be replayed from the exact versioned contract.'.
    RETURN.
  ENDIF.

  LOOP AT lt_fields INTO DATA(ls_field).
    CLEAR lv_source.
    PERFORM normalize_mapping_source
      USING    ls_field-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      cv_message = 'Replayed generated Template contains an invalid source column.'.
      RETURN.
    ENDIF.

    INSERT lv_source INTO TABLE lt_seen.
    IF sy-subrc <> 0.
      cv_message = |Replayed generated Template contains duplicate source column { lv_source }.|.
      RETURN.
    ENDIF.

    APPEND lv_source TO lt_expected.
  ENDLOOP.

  lv_count = lines( lt_expected ).
  IF lv_count <> lines( it_sources ).
    cv_message = |TEMPLATE_SCHEMA_MISMATCH: generated contract has { lv_count } columns but upload has { lines( it_sources ) } for v{ iv_ver }.|.
    RETURN.
  ENDIF.

  DO lv_count TIMES.
    lv_index = sy-index.
    READ TABLE lt_expected INTO lv_expected INDEX lv_index.
    READ TABLE it_sources  INTO lv_actual   INDEX lv_index.

    IF lv_expected <> lv_actual.
      cv_message = |TEMPLATE_SCHEMA_MISMATCH: generated column { lv_index } must be { lv_expected }, not { lv_actual }, for v{ iv_ver }.|.
      RETURN.
    ENDIF.
  ENDDO.

  cv_proven = abap_true.
ENDFORM.

FORM validate_tmpl_header_manifest
  USING    iv_tcode   TYPE zbdc_prof_bup-tcode
           iv_profile TYPE zbdc_prof_bup-profile_name
           iv_ver     TYPE zbdc_prof_bup-profile_ver
           it_sources TYPE string_table
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lt_manifest TYPE string_table,
        lv_found    TYPE abap_bool,
        lv_load_ok  TYPE abap_bool,
        lv_proven   TYPE abap_bool,
        lv_freeze_ok TYPE abap_bool,
        lv_index    TYPE i,
        lv_count    TYPE i,
        lv_expected TYPE string,
        lv_actual   TYPE string.

  CLEAR: cv_ok, cv_message.

  PERFORM load_template_manifest
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_manifest lv_found lv_load_ok cv_message.
  IF lv_load_ok <> abap_true.
    RETURN.
  ENDIF.

  IF lv_found = abap_true.
    lv_count = lines( lt_manifest ).
    IF lv_count <> lines( it_sources ).
      cv_message = |TEMPLATE_SCHEMA_MISMATCH: expected { lv_count } columns but upload has { lines( it_sources ) } for v{ iv_ver }.|.
      RETURN.
    ENDIF.

    DO lv_count TIMES.
      lv_index = sy-index.
      READ TABLE lt_manifest INTO lv_expected INDEX lv_index.
      READ TABLE it_sources INTO lv_actual INDEX lv_index.
      IF lv_expected <> lv_actual.
        cv_message = |TEMPLATE_SCHEMA_MISMATCH: column { lv_index } must be { lv_expected }, not { lv_actual }, for v{ iv_ver }.|.
        RETURN.
      ENDIF.
    ENDDO.

    cv_ok = abap_true.
    RETURN.
  ENDIF.

 "Migration path for templates generated before the ordered manifest existed.
 "The uploaded header is adopted only when its Mapping-derived SHA-256 identity
 "matches the already-frozen SCHEMAFP on the exact immutable Script ID.
  CLEAR lv_proven.
  PERFORM prove_template_header_schema
    USING    iv_tcode iv_profile iv_ver it_sources
    CHANGING lv_proven cv_message.
  IF lv_proven <> abap_true.
    RETURN.
  ENDIF.

  CLEAR: lv_freeze_ok, cv_message.
  PERFORM freeze_template_manifest
    USING    iv_tcode iv_profile iv_ver it_sources
    CHANGING lv_freeze_ok cv_message.
  IF lv_freeze_ok <> abap_true.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

*& Exact emitted-template schema projection

*& Generate Template persists the current 0350 business-input projection as
*& an exact Field Guide for TCODE/Profile/Version. Upload must validate and
*& parse against that same emitted projection, never the broader raw Mapping
*& repository. If no exact Field Guide exists (legacy/direct-call path), use
*& the same generic Mapping/Template filters as screen 0350.

FORM project_template_schema
  USING    iv_tcode   TYPE any
           iv_profile TYPE any
           iv_ver     TYPE any
  CHANGING ct_map     TYPE ty_t_mapping_db.

  DATA: lt_raw       TYPE ty_t_mapping_db,
        lt_out       TYPE ty_t_mapping_db,
        lt_guide     TYPE ty_t_map_meta,
        lt_used      TYPE ty_t_source_used,
        ls_raw       TYPE zbdc_mapping_bup,
        ls_out       TYPE zbdc_mapping_bup,
        ls_guide     TYPE ty_map_meta,
        lv_src_raw   TYPE zbdc_mapping_bup-source_column,
        lv_src_guide TYPE zbdc_mapping_bup-source_column,
        lv_found     TYPE abap_bool,
        lv_has_exact TYPE abap_bool.

  IF ct_map IS INITIAL.
    RETURN.
  ENDIF.

  lt_raw = ct_map.
  REFRESH lt_guide.
  PERFORM read_mapping_metadata
    USING    iv_tcode iv_profile iv_ver
    CHANGING lt_guide.

  LOOP AT lt_guide INTO ls_guide
    WHERE metadata_origin = 'FIELD_GUIDE'.
    PERFORM normalize_mapping_source
      USING    ls_guide-source_column
      CHANGING lv_src_guide.
    IF lv_src_guide IS NOT INITIAL.
      lv_has_exact = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF lv_has_exact = abap_true.
    SORT lt_guide BY display_order bdc_field staging_field source_column.
    REFRESH: lt_out, lt_used.

    LOOP AT lt_guide INTO ls_guide
      WHERE metadata_origin = 'FIELD_GUIDE'.
      CLEAR lv_src_guide.
      PERFORM normalize_mapping_source
        USING    ls_guide-source_column
        CHANGING lv_src_guide.
      IF lv_src_guide IS INITIAL OR lv_src_guide CP 'INPUT_*'.
        CONTINUE.
      ENDIF.

      READ TABLE lt_used WITH TABLE KEY table_line = lv_src_guide
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        CONTINUE.
      ENDIF.

      CLEAR: ls_out, lv_found.

 "Prefer the exact staging slot frozen into the emitted Field Guide.
      IF ls_guide-staging_field IS NOT INITIAL.
        LOOP AT lt_raw INTO ls_raw
          WHERE staging_field = ls_guide-staging_field.
          CLEAR lv_src_raw.
          PERFORM normalize_mapping_source
            USING    ls_raw-source_column
            CHANGING lv_src_raw.
          IF lv_src_raw = lv_src_guide.
            ls_out = ls_raw.
            lv_found = abap_true.
            EXIT.
          ENDIF.
        ENDLOOP.
      ENDIF.

 "Then prefer the exact BDC field if the legacy slot was renamed.
      IF lv_found <> abap_true AND ls_guide-bdc_field IS NOT INITIAL.
        LOOP AT lt_raw INTO ls_raw
          WHERE bdc_field = ls_guide-bdc_field.
          CLEAR lv_src_raw.
          PERFORM normalize_mapping_source
            USING    ls_raw-source_column
            CHANGING lv_src_raw.
          IF lv_src_raw = lv_src_guide.
            ls_out = ls_raw.
            lv_found = abap_true.
            EXIT.
          ENDIF.
        ENDLOOP.
      ENDIF.

 "Last exact-source fallback keeps old Mapping DDIC shapes compatible.
      IF lv_found <> abap_true.
        LOOP AT lt_raw INTO ls_raw.
          CLEAR lv_src_raw.
          PERFORM normalize_mapping_source
            USING    ls_raw-source_column
            CHANGING lv_src_raw.
          IF lv_src_raw = lv_src_guide.
            ls_out = ls_raw.
            lv_found = abap_true.
            EXIT.
          ENDIF.
        ENDLOOP.
      ENDIF.

 "The exact Field Guide is the emitted template manifest. A minimal row
 "is safe for Preview Data even on an older DDIC shape; runtime execution
 "still uses the existing frozen contract/certification gates.
      IF lv_found <> abap_true.
        CLEAR ls_out.
        ls_out-tcode        = iv_tcode.
        ls_out-profile_name = iv_profile.
        ls_out-profile_ver  = iv_ver.
        ls_out-source_column = lv_src_guide.
        ls_out-staging_field = ls_guide-staging_field.
        ls_out-bdc_field     = ls_guide-bdc_field.
      ENDIF.

      ls_out-source_column = lv_src_guide.
      IF ls_guide-staging_field IS NOT INITIAL.
        ls_out-staging_field = ls_guide-staging_field.
      ENDIF.
      IF ls_guide-bdc_field IS NOT INITIAL.
        ls_out-bdc_field = ls_guide-bdc_field.
      ENDIF.
      IF ls_guide-mandatory_defined = abap_true.
        ls_out-mandatory = ls_guide-mandatory.
      ENDIF.

      APPEND ls_out TO lt_out.
      INSERT lv_src_guide INTO TABLE lt_used.
    ENDLOOP.

    ct_map = lt_out.

 "A versioned generated template is an immutable public-schema snapshot.
 "FIELD_GUIDE for the exact TCODE/Profile/Version is the manifest that was
 "persisted at Generate Template time after the Mapping->Script 1:1 proof
 "and Field Guide round-trip verification. Upload/Preview must consume that
 "same manifest verbatim. Re-running membership classification here would
 "make schema validation depend on the current acquisition/session context
 "and could reject a template that this exact version generated itself.
 "Integrity of the frozen contract is enforced at publication/runtime gates;
 "schema projection must not add/drop/reclassify versioned file columns.
    RETURN.
  ENDIF.

 "Legacy/direct-call fallback: reproduce the same generic projection that
 "Mapping/Generate Template use. No TCODE/field list is introduced here.
  PERFORM filter_map_bus_view
    USING    iv_tcode iv_profile iv_ver
    CHANGING ct_map.
  PERFORM filter_map_user_ev
    CHANGING ct_map.
  DELETE ct_map WHERE mandatory = gc_m2_map_review.
ENDFORM.

*& Canonical strict user-interaction projection for Mapping/Template

FORM filter_map_user_ev
  CHANGING ct_map TYPE ty_t_mapping_db.

  DATA: lt_script    TYPE ty_t_script,
        lt_keep      TYPE ty_t_mapping_db,
        lt_guide     TYPE ty_t_map_meta,
        ls_guide     TYPE ty_map_meta,
        ls_map       TYPE zbdc_mapping_bup,
        ls_ctx       TYPE zbdc_mapping_bup,
        lv_role      TYPE string,
        lv_reason    TYPE string,
        lv_script_id TYPE zbdc_script_bup-script_id,
        lv_hash      TYPE zbdc_script_bup-contract_hash,
        lv_found     TYPE abap_bool,
        lv_msg       TYPE string,
        lv_has_guide TYPE abap_bool,
        lv_fresh_acq TYPE abap_bool,
        lv_origin    TYPE c LENGTH 20.

  PERFORM rebind_map_sources CHANGING ct_map.
  IF ct_map IS INITIAL.
    RETURN.
  ENDIF.

  READ TABLE ct_map INTO ls_ctx INDEX 1.

 "fresh acquisition survives exact-context pinning. Use the
 "preserved input origin as a second freshness signal so repository/history
 "cannot broaden the current raw TXT/recording field membership.
  CLEAR: lv_fresh_acq, lv_origin.
  PERFORM get_projection_origin CHANGING lv_origin.
  IF gt_z333_rec_evidence IS NOT INITIAL
     AND ( lv_origin = 'GUIDED_RECORD'
        OR lv_origin = 'SHDB_TXT'
        OR lv_origin = 'SHDB_PROGRAM' ).
    lv_fresh_acq = abap_true.
  ENDIF.

 "Field Guide/history cannot define membership for a fresh real
 "recording/import. It is consulted only outside a current acquisition.
  IF lv_fresh_acq <> abap_true
     AND sy-subrc = 0
     AND ls_ctx-tcode IS NOT INITIAL
     AND ls_ctx-profile_name IS NOT INITIAL
     AND ls_ctx-profile_ver IS NOT INITIAL.
    REFRESH lt_guide.
    PERFORM read_mapping_metadata
      USING    ls_ctx-tcode ls_ctx-profile_name ls_ctx-profile_ver
      CHANGING lt_guide.
    LOOP AT lt_guide INTO ls_guide
      WHERE metadata_origin = 'FIELD_GUIDE'.
      lv_has_guide = abap_true.
      EXIT.
    ENDLOOP.
    IF lv_has_guide = abap_true.
      RETURN.
    ENDIF.
  ENDIF.

  REFRESH lt_script.
  IF lv_fresh_acq = abap_true.
    lt_script = gt_z333_rec_evidence.
  ELSEIF gt_script_def IS NOT INITIAL.
    lt_script = gt_script_def.
  ELSEIF gt_z333_rec_evidence IS NOT INITIAL.
    lt_script = gt_z333_rec_evidence.
  ENDIF.

  IF lt_script IS INITIAL
     AND ls_ctx-tcode IS NOT INITIAL
     AND ls_ctx-profile_name IS NOT INITIAL
     AND ls_ctx-profile_ver IS NOT INITIAL.
    CLEAR: lv_script_id, lv_hash, lv_found, lv_msg.
    PERFORM resolve_map_tuple_script
      USING    ls_ctx-tcode ls_ctx-profile_name ls_ctx-profile_ver
      CHANGING lt_script lv_script_id lv_hash lv_found lv_msg.
  ENDIF.

  IF lt_script IS INITIAL.
    REFRESH lt_keep.
    LOOP AT ct_map INTO ls_map.
      IF ls_map-bdc_field IS INITIAL.
        APPEND ls_map TO lt_keep.
      ENDIF.
    ENDLOOP.
    ct_map = lt_keep.
    RETURN.
  ENDIF.

  REFRESH lt_keep.
  LOOP AT ct_map INTO ls_map.
    IF ls_map-bdc_field IS INITIAL.
      APPEND ls_map TO lt_keep.
      CONTINUE.
    ENDIF.

    CLEAR: lv_role, lv_reason.
    PERFORM projection_role
      USING    lt_script ls_map-bdc_field
      CHANGING lv_role lv_reason.
    IF lv_role = 'DYNAMIC_PROVEN'.
      APPEND ls_map TO lt_keep.
    ENDIF.
  ENDLOOP.

  ct_map = lt_keep.
  PERFORM rebind_map_sources CHANGING ct_map.
ENDFORM.

FORM build_evid_map_view
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  CLEAR gv_z340_lock_done.

  DATA: ls_script      TYPE ty_script_def_compat,
        ls_map         TYPE zbdc_mapping_bup,
        lv_tcode       TYPE zbdc_mapping_bup-tcode,
        lv_profile     TYPE zbdc_mapping_bup-profile_name,
        lv_ver         TYPE zbdc_mapping_bup-profile_ver,
        lv_type        TYPE zbdc_sct_ver_bup-value_type,
        lv_bdc         TYPE zbdc_mapping_bup-bdc_field,
        lv_logical     TYPE zbdc_mapping_bup-bdc_field,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_full_source TYPE zbdc_mapping_bup-source_column,
        lv_technical   TYPE abap_bool,
        lv_capture_ok  TYPE abap_bool,
        lv_role        TYPE string,
        lv_reason      TYPE string,
        lv_origin      TYPE c LENGTH 20,
        lv_count       TYPE i,
        lv_dynamic     TYPE i,
        lv_ambiguous   TYPE i,
        lv_dropped     TYPE i,
        lv_expected_dynamic TYPE i,
        lv_slot        TYPE zbdc_mapping_bup-staging_field,
        lv_base_source TYPE zbdc_mapping_bup-source_column,
        lv_action_key  TYPE zbdc_mapping_bup-bdc_field,
        lv_map_key     TYPE zbdc_mapping_bup-bdc_field,
        lv_cert_source TYPE zbdc_mapping_bup-source_column,
        lv_map_source_norm TYPE zbdc_mapping_bup-source_column,
        lv_cert_found  TYPE abap_bool,
        lv_actual_dynamic TYPE i,
        lv_name_set_bad TYPE abap_bool,
        lv_global_tcode TYPE zbdc_mapping_bup-tcode,
        lv_evidence_tcode TYPE zbdc_mapping_bup-tcode.

  DATA: lt_seen_logical TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                         WITH UNIQUE KEY table_line,
        lt_seen_eval    TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                         WITH UNIQUE KEY table_line,
        lt_seen_source  TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                         WITH UNIQUE KEY table_line,
        lt_slots        TYPE ty_t_map_staging_slot,
        lt_used_slots   TYPE SORTED TABLE OF zbdc_mapping_bup-staging_field
                         WITH UNIQUE KEY table_line,
        lt_expected_actions TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                         WITH UNIQUE KEY table_line,
        lt_actual_actions TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                         WITH UNIQUE KEY table_line,
        lt_evidence     TYPE ty_t_script,
        lv_fresh_acq    TYPE abap_bool.

  CLEAR: cv_ok, cv_message, lv_fresh_acq, lv_origin.
  PERFORM get_projection_origin CHANGING lv_origin.

 "invariant: Guided Recording is never allowed to enter the Mapping
 "builder without native provenance. Do not downgrade this to AMBIGUOUS.
  IF lv_origin = 'GUIDED_RECORD'
     AND gt_z360_rec_field_vals IS INITIAL.
    REFRESH gt_mapping_screen.
    cv_message =
      'RECORDER_NATIVE_PROVENANCE_MISSING: Guided Mapping blocked before classification; no legacy/cursor fallback was used.'.
    RETURN.
  ENDIF.

 "Build Mapping membership from the immutable raw evidence of the
 "current acquisition. Exact-contract resolution may legitimately load a
 "persisted script into GT_SCRIPT_DEF for metadata/runtime context, but that
 "persisted script must never broaden the field set shown for a fresh TXT or
 "Start Recording. No field is added here; the authority is current raw data.
  IF gt_z333_rec_evidence IS NOT INITIAL
     AND ( lv_origin = 'GUIDED_RECORD'
        OR lv_origin = 'SHDB_TXT'
        OR lv_origin = 'SHDB_PROGRAM' ).
    lt_evidence  = gt_z333_rec_evidence.
    lv_fresh_acq = abap_true.
  ELSE.
    lt_evidence = gt_script_def.
  ENDIF.

  IF lt_evidence IS INITIAL.
    cv_message = 'No captured recording rows are available for Template Mapping.'.
    RETURN.
  ENDIF.

 "imported SHDB replay evidence has no exact USER_CHANGED flag. Before
 "a fresh TXT/Program or Guided capture can become Template authority, confirm the actual user
 "actions once for the immutable Script/Hash. Cursor is not membership authority and does not pre-check a row.
  IF lv_origin = 'GUIDED_RECORD'
     OR lv_origin = 'SHDB_TXT'
     OR lv_origin = 'SHDB_PROGRAM'.
    DATA: lv_z659_ok  TYPE abap_bool,
          lv_z659_msg TYPE string.
    CLEAR: lv_z659_ok, lv_z659_msg.
    PERFORM confirm_actions
      USING    lt_evidence gv_runtime_script_id gv_runtime_contract_hash lv_origin
      CHANGING lv_z659_ok lv_z659_msg.
    IF lv_z659_ok <> abap_true.
      REFRESH gt_mapping_screen.
      cv_message = lv_z659_msg.
      IF cv_message IS INITIAL.
        cv_message = 'Exact user-action confirmation is required before Mapping/Template can be published.'.
      ENDIF.
      RETURN.
    ENDIF.
  ENDIF.

 "current RAW evidence, not a previous screen/global context, owns
 "the Candidate Mapping TCODE. Every nonblank recorded TCODE must agree.
  CLEAR: lv_tcode, lv_evidence_tcode.
  LOOP AT lt_evidence INTO ls_script WHERE tcode IS NOT INITIAL.
    lv_evidence_tcode = ls_script-tcode.
    TRANSLATE lv_evidence_tcode TO UPPER CASE.
    CONDENSE lv_evidence_tcode NO-GAPS.
    IF lv_tcode IS INITIAL.
      lv_tcode = lv_evidence_tcode.
    ELSEIF lv_tcode <> lv_evidence_tcode.
      REFRESH gt_mapping_screen.
      cv_message =
        'FRESH_MAPPING_CONTEXT_MISMATCH: current RAW evidence contains more than one TCODE after block selection.'.
      RETURN.
    ENDIF.
  ENDLOOP.

  lv_global_tcode = p_rec_tcode.
  TRANSLATE lv_global_tcode TO UPPER CASE.
  CONDENSE lv_global_tcode NO-GAPS.
  IF lv_tcode IS INITIAL.
    lv_tcode = lv_global_tcode.
  ELSEIF lv_global_tcode IS NOT INITIAL AND lv_global_tcode <> lv_tcode.
 "The RAW acquisition wins; realign the UI holders instead of leaking the
 "previous transaction into this Mapping candidate.
    p_rec_tcode   = lv_tcode.
    p_transaction = lv_tcode.
  ENDIF.

  IF lv_tcode IS INITIAL.
    cv_message = 'Current RAW evidence has no TCODE for Candidate Mapping.'.
    RETURN.
  ENDIF.
  p_rec_tcode   = lv_tcode.
  p_transaction = lv_tcode.

  lv_profile = txtp_profile_name.
  CONDENSE lv_profile.
  IF lv_profile IS INITIAL.
    lv_profile = 'EVIDENCE_ONLY'.
  ENDIF.
  lv_ver = gv_profile_ver.

  REFRESH: lt_slots, lt_used_slots.
  PERFORM get_mapping_staging_slots CHANGING lt_slots.
  IF lt_slots IS INITIAL.
    cv_message = 'No generic staging FIELDnn slots exist for Mapping.'.
    RETURN.
  ENDIF.
  READ TABLE lt_slots WITH TABLE KEY table_line = 'FIELD01'
    TRANSPORTING NO FIELDS.
  IF sy-subrc <> 0.
    cv_message = 'ZBDC_STAGING_BUP must contain FIELD01 for the business key.'.
    RETURN.
  ENDIF.

  REFRESH gt_mapping_screen.
  REFRESH gt_z343_removed_map.

  CLEAR ls_map.
  ls_map-tcode         = lv_tcode.
  ls_map-profile_name  = lv_profile.
  ls_map-profile_ver   = lv_ver.
  ls_map-source_column = 'BUSINESS_KEY'.
  ls_map-staging_field = 'FIELD01'.
  ls_map-mandatory     = 'X'.
  APPEND ls_map TO gt_mapping_screen.
  INSERT ls_map-source_column INTO TABLE lt_seen_source.
  INSERT ls_map-staging_field INTO TABLE lt_used_slots.

 "Mapping publishes only DYNAMIC_PROVEN logical fields. AMBIGUOUS
 "evidence stays out of the executable Template without being misclassified
 "as technical replay, and physical Script choreography remains untouched.
  LOOP AT lt_evidence INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    CLEAR: lv_type, lv_bdc, lv_logical, lv_source, lv_full_source,
           lv_technical, lv_capture_ok, lv_reason.

    lv_type = ls_script-value_type.
    TRANSLATE lv_type TO UPPER CASE.
    CONDENSE lv_type NO-GAPS.
    IF lv_type = gc_m2_vt_ignore.
      CONTINUE.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_bdc.
    IF lv_bdc IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key
      USING    lv_bdc
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      lv_logical = lv_bdc.
    ENDIF.

 "classify each logical field once. The role authority scans the
 "whole raw recording, so physical (nn) aliases cannot change membership.
    READ TABLE lt_seen_eval
      WITH TABLE KEY table_line = lv_logical
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    INSERT lv_logical INTO TABLE lt_seen_eval.

    CLEAR: lv_role, lv_reason.
    PERFORM projection_role
      USING    lt_evidence lv_bdc
      CHANGING lv_role lv_reason.
    IF lv_role = 'AMBIGUOUS'.
      lv_ambiguous = lv_ambiguous + 1.
      CONTINUE.
    ELSEIF lv_role <> 'DYNAMIC_PROVEN'.
      lv_dropped = lv_dropped + 1.
      CONTINUE.
    ENDIF.

    READ TABLE lt_seen_logical
      WITH TABLE KEY table_line = lv_logical
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.

 "final Mapping never recomputes a different user-facing name after
 "confirmation. GUIDED_RECORD/SHDB_TXT/SHDB_PROGRAM read the immutable visible-name cert;
 "other paths still use the same strict screen authority. No DDIC/technical
 "fallback and no neutral suffix are permitted.
    CLEAR: lv_source, lv_base_source.
    IF lv_origin = 'GUIDED_RECORD'
       OR lv_origin = 'SHDB_TXT'
       OR lv_origin = 'SHDB_PROGRAM'.
      DATA(lv_z684_name_found) = abap_false.
      PERFORM confirmed_name
        USING    lv_bdc
        CHANGING lv_source lv_z684_name_found.
      IF lv_z684_name_found <> abap_true OR lv_source IS INITIAL.
        REFRESH gt_mapping_screen.
        cv_message =
          |NAME_CERT_MISSING: selected field { lv_bdc } has no confirmed visible Template name.|.
        RETURN.
      ENDIF.
    ELSE.
      PERFORM base_tpl_name
        USING    lt_evidence lv_bdc
        CHANGING lv_source.
      IF lv_source IS INITIAL.
        REFRESH gt_mapping_screen.
        cv_message =
          |VISUAL_LABEL_REQUIRED: exact visible SAP label could not be proven for { lv_bdc }.|.
        RETURN.
      ENDIF.
    ENDIF.

    READ TABLE lt_seen_source
      WITH TABLE KEY table_line = lv_source
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      REFRESH gt_mapping_screen.
      cv_message =
        |LABEL_COLLISION: Template name { lv_source } is bound to more than one distinct logical control. Nothing was published.|.
      RETURN.
    ENDIF.

    CLEAR lv_slot.
    LOOP AT lt_slots INTO lv_slot.
      IF lv_slot = 'FIELD01'.
        CONTINUE.
      ENDIF.
      READ TABLE lt_used_slots
        WITH TABLE KEY table_line = lv_slot
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        EXIT.
      ENDIF.
      CLEAR lv_slot.
    ENDLOOP.
    IF lv_slot IS INITIAL.
      REFRESH gt_mapping_screen.
      cv_message = 'Not enough generic staging FIELDnn slots for the visible/filled recording projection.'.
      RETURN.
    ENDIF.

    CLEAR ls_map.
    ls_map-tcode         = lv_tcode.
    ls_map-profile_name  = lv_profile.
    ls_map-profile_ver   = lv_ver.
    ls_map-source_column = lv_source.
    ls_map-staging_field = lv_slot.
    ls_map-bdc_field     = lv_bdc.
    CLEAR ls_map-mandatory.
    PERFORM NORM_MAP_REQUIRED CHANGING ls_map.
    PERFORM apply_fmt_contract CHANGING ls_map.
    APPEND ls_map TO gt_mapping_screen.

    INSERT lv_logical INTO TABLE lt_seen_logical.
    INSERT lv_source  INTO TABLE lt_seen_source.
    INSERT lv_slot    INTO TABLE lt_used_slots.
  ENDLOOP.

  DESCRIBE TABLE gt_mapping_screen LINES lv_count.
  IF lv_count <= 1.
    REFRESH gt_mapping_screen.
    cv_message = 'No business input fields were found. Review the recording and Mapping.'.
    RETURN.
  ENDIF.

  lv_dynamic = lv_count - 1.

 "exact publication invariant. Count equality is not enough: one
 "selected field could be missing while one unselected field is accidentally
 "added and the counts would still match. For every confirmed import/native capture,
 "the FINAL Mapping logical-key set must equal the USER-CONFIRMED set in both
 "directions, and each Mapping source must equal that field's confirmed name.
  IF ( lv_origin = 'GUIDED_RECORD'
       OR lv_origin = 'SHDB_TXT'
       OR lv_origin = 'SHDB_PROGRAM' )
     AND gv_z659_action_ready = abap_true.
    REFRESH: lt_expected_actions, lt_actual_actions.

    LOOP AT gt_z659_user_actions INTO lv_action_key.
      PERFORM logical_bdc_key
        USING    lv_action_key
        CHANGING lv_map_key.
      IF lv_map_key IS INITIAL.
        lv_map_key = lv_action_key.
      ENDIF.
      IF lv_map_key IS NOT INITIAL.
        INSERT lv_map_key INTO TABLE lt_expected_actions.
      ENDIF.
    ENDLOOP.

    CLEAR lv_name_set_bad.
    LOOP AT gt_mapping_screen INTO ls_map
      WHERE staging_field <> 'FIELD01'
        AND bdc_field IS NOT INITIAL.
      CLEAR lv_map_key.
      PERFORM logical_bdc_key
        USING    ls_map-bdc_field
        CHANGING lv_map_key.
      IF lv_map_key IS INITIAL.
        lv_map_key = ls_map-bdc_field.
      ENDIF.
      IF lv_map_key IS NOT INITIAL.
        INSERT lv_map_key INTO TABLE lt_actual_actions.
      ENDIF.

      CLEAR: lv_cert_source, lv_cert_found, lv_map_source_norm.
      PERFORM confirmed_name
        USING    ls_map-bdc_field
        CHANGING lv_cert_source lv_cert_found.
      lv_map_source_norm = ls_map-source_column.
      PERFORM normalize_mapping_source
        USING    lv_map_source_norm
        CHANGING lv_map_source_norm.
      IF lv_cert_found <> abap_true
         OR lv_cert_source IS INITIAL
         OR lv_map_source_norm <> lv_cert_source.
        lv_name_set_bad = abap_true.
        cv_message =
          |NAME_SET_BLOCK: Mapping source for logical field { lv_map_key } differs from its confirmed exact-evidence name. Nothing was published.|.
        EXIT.
      ENDIF.
    ENDLOOP.

 "Never clear/overwrite GT_MAPPING_SCREEN while LOOP AT GT_MAPPING_SCREEN is
 "active. This removes the SAP extended-check warning and keeps the same
 "fail-closed behavior after the loop has ended.
    IF lv_name_set_bad = abap_true.
      REFRESH gt_mapping_screen.
      RETURN.
    ENDIF.

    DESCRIBE TABLE lt_expected_actions LINES lv_expected_dynamic.
    DESCRIBE TABLE lt_actual_actions LINES lv_actual_dynamic.
    IF lv_expected_dynamic <> lv_actual_dynamic.
      REFRESH gt_mapping_screen.
      cv_message =
        |MAPPING_SET_BLOCK: confirmed logical fields={ lv_expected_dynamic }, final Mapping logical fields={ lv_actual_dynamic }. Nothing was published.|.
      RETURN.
    ENDIF.

    LOOP AT lt_expected_actions INTO lv_action_key.
      READ TABLE lt_actual_actions
        WITH TABLE KEY table_line = lv_action_key
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        REFRESH gt_mapping_screen.
        cv_message =
          |MAPPING_SET_BLOCK: confirmed logical field { lv_action_key } is missing from final Mapping. Nothing was published.|.
        RETURN.
      ENDIF.
    ENDLOOP.

    LOOP AT lt_actual_actions INTO lv_map_key.
      READ TABLE lt_expected_actions
        WITH TABLE KEY table_line = lv_map_key
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        REFRESH gt_mapping_screen.
        cv_message =
          |MAPPING_SET_BLOCK: unconfirmed logical field { lv_map_key } appeared in final Mapping. Nothing was published.|.
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDIF.

  IF lv_origin = 'GUIDED_RECORD' AND lv_ambiguous > 0.
    REFRESH gt_mapping_screen.
    cv_message =
      |INVARIANT_BLOCK: Guided Recording produced { lv_ambiguous } ambiguous field(s). Native provenance must resolve every recorded logical field as DYNAMIC_PROVEN or REPLAY_ONLY; Mapping was not published.|.
    RETURN.
  ENDIF.

 "invariant for imported SHDB TXT/Program: every recorded nontechnical
 "logical FNAM must resolve deterministically. Ambiguous means the import
 "projection contract was bypassed, so fail closed instead of publishing.
  IF ( lv_origin = 'SHDB_TXT' OR lv_origin = 'SHDB_PROGRAM' )
     AND lv_ambiguous > 0.
    REFRESH gt_mapping_screen.
    cv_message =
      |IMPORT_INVARIANT_BLOCK: imported SHDB produced { lv_ambiguous } ambiguous field(s). Confirmed replay projection must resolve every recorded logical field deterministically; Mapping was not published.|.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
  IF lv_origin = 'GUIDED_RECORD'.
    cv_message = |Mapping ready: { lv_dynamic } input field(s) found. Press Generate Template.|.
  ELSEIF lv_origin = 'SHDB_TXT' OR lv_origin = 'SHDB_PROGRAM'.
    cv_message = |Mapping ready: { lv_dynamic } input field(s) found. Press Generate Template.|.
  ELSE.
    cv_message = |Mapping found { lv_dynamic } input field(s); { lv_ambiguous } need review. Review Mapping before generating the template.|.
  ENDIF.
ENDFORM.

*& Guided Mapping entry-point authority
*& Reconstruct current Guided provenance from RAW/native/vision evidence before
*& any Mapping popup or legacy name resolver can run.
*& Fresh Guided Recording AI authority
*& Evidence, not one mutable origin string, decides whether the current RAW
*& acquisition is Guided. Historical My/All Import contracts are deliberately
*& excluded unless fresh native/vision evidence is still present.
*& If a prior API attempt failed but PNG snapshots are still available, Mapping
*& Profile retries OpenAI vision before failing closed. Repository/DDIC naming is never
*& a fallback for a fresh Guided acquisition.

FORM ensure_guided_vision
  USING    iv_origin TYPE csequence
           pt_script TYPE ty_t_script
  CHANGING cv_guided TYPE abap_bool
           cv_ok     TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_explicit_origin TYPE c LENGTH 20,
        lv_review_origin   TYPE c LENGTH 20,
        lv_acq_origin      TYPE c LENGTH 20.

  CLEAR: cv_guided, cv_ok, cv_message.
  lv_explicit_origin = iv_origin.
  lv_review_origin   = gv_z689_review_origin.
  lv_acq_origin      = gv_z652_acq_origin.

  TRANSLATE: lv_explicit_origin TO UPPER CASE,
             lv_review_origin   TO UPPER CASE,
             lv_acq_origin      TO UPPER CASE.
  CONDENSE: lv_explicit_origin NO-GAPS,
            lv_review_origin   NO-GAPS,
            lv_acq_origin      NO-GAPS.

  IF gv_z689_review_pending = abap_true
     AND lv_review_origin IS NOT INITIAL.
    IF lv_review_origin <> 'GUIDED_RECORD'.
      cv_ok = abap_true.
      RETURN.
    ENDIF.
    cv_guided = abap_true.
  ELSEIF lv_explicit_origin = 'SHDB_TXT'
      OR lv_explicit_origin = 'SHDB_PROGRAM'.
    cv_ok = abap_true.
    RETURN.
  ELSEIF gt_z360_rec_field_vals IS NOT INITIAL
     OR gt_z866_screen_caps IS NOT INITIAL.
    cv_guided = abap_true.
  ELSEIF gv_z689_review_pending = abap_true
     AND lv_review_origin = 'GUIDED_RECORD'.
    cv_guided = abap_true.
  ELSEIF lv_acq_origin = 'GUIDED_RECORD'
     AND gt_z333_rec_evidence IS NOT INITIAL.
    cv_guided = abap_true.
  ELSEIF lv_explicit_origin = 'GUIDED_RECORD'
     AND ( gv_z689_review_pending = abap_true
        OR gt_z333_rec_evidence IS NOT INITIAL ).
    cv_guided = abap_true.
  ENDIF.

  IF cv_guided <> abap_true.
    cv_ok = abap_true.
    RETURN.
  ENDIF.

  gv_z652_acq_origin   = 'GUIDED_RECORD'.
  gv_z359_input_origin = 'GUIDED_RECORD'.
  gv_z133_origin       = 'GUIDED_RECORD'.
  IF gv_z689_review_pending = abap_true.
    gv_z689_review_origin = 'GUIDED_RECORD'.
  ENDIF.

  IF gt_z866_screen_caps IS INITIAL.
    IF gv_z877_cap_diag IS NOT INITIAL.
      cv_message = |GUIDED_CAPTURE_REQUIRED: { gv_z877_cap_diag }|.
    ELSE.
      cv_message =
        'GUIDED_CAPTURE_REQUIRED: fresh Start Recording has no retained SAP GUI action/capture evidence.'.
    ENDIF.
    RETURN.
  ENDIF.

  CLEAR: gv_z866_vision_required, gv_z866_vision_analyzed.
  cv_ok = abap_true.
  cv_message =
    'GUIDED_CAPTURE_READY: action/capture evidence retained; exact SAP DDIC mapping will run with no AI.'.
ENDFORM.

FORM guard_guided_ai_entry
  USING    iv_origin  TYPE csequence
  CHANGING cv_guided  TYPE abap_bool
           cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA lt_current TYPE ty_t_script.

  CLEAR: cv_guided, cv_ok, cv_message.
  IF gt_z333_rec_evidence IS NOT INITIAL.
    lt_current = gt_z333_rec_evidence.
  ELSE.
    lt_current = gt_script_def.
  ENDIF.

  PERFORM ensure_guided_vision
    USING    iv_origin lt_current
    CHANGING cv_guided cv_ok cv_message.
ENDFORM.

FORM auto_prep_map_on_open
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_resolve_ok TYPE abap_bool,
        lv_resolve_msg TYPE string,
        lv_tcode       TYPE zbdc_prof_bup-tcode,
        lv_profile     TYPE zbdc_prof_bup-profile_name,
        lv_ver         TYPE zbdc_prof_bup-profile_ver,
        lv_status      TYPE zbdc_prof_bup-status,
        lv_map_count   TYPE i,
        lv_origin      TYPE c LENGTH 20,
        lt_z689_pending TYPE ty_t_script,
        lv_z689_ok      TYPE abap_bool,
        lv_z689_msg     TYPE string,
        lv_z872_guided  TYPE abap_bool,
        lv_z872_ai_ok   TYPE abap_bool,
        lv_z872_ai_msg  TYPE string,
        lv_z872_origin  TYPE c LENGTH 20.

  CLEAR: cv_ok, cv_message.

 "Hard gate at Mapping Profile entry; Start Recording validates capture/action evidence only, no AI.
  CLEAR: lv_z872_guided, lv_z872_ai_ok, lv_z872_ai_msg, lv_z872_origin.
  lv_z872_origin = gv_z689_review_origin.
  IF lv_z872_origin IS INITIAL.
    PERFORM get_projection_origin CHANGING lv_z872_origin.
  ENDIF.
  "Fresh SHDB Import no longer requires a user-operated Visual Replay gate.
  "The Mapping pipeline automatically derives exact screen metadata from the
  "imported PROGRAM/DYNPRO contract and then invokes AI only for unresolved
  "Template aliases. User checkbox selection remains the sole membership gate.

  PERFORM guard_guided_ai_entry
    USING    lv_z872_origin
    CHANGING lv_z872_guided lv_z872_ai_ok lv_z872_ai_msg.
  IF lv_z872_guided = abap_true AND lv_z872_ai_ok <> abap_true.
    cv_message = lv_z872_ai_msg.
    RETURN.
  ENDIF.

 "explicit Mapping Profile is the resume boundary for a fresh RAW
 "Import/Guided acquisition. Only now may the existing strict onboarding
 "pipeline ask for user-action membership and calculate Template Schema.
  IF gv_z689_review_pending = abap_true.
    IF gt_z333_rec_evidence IS INITIAL
       OR gv_z689_review_tcode IS INITIAL
       OR gv_z689_review_origin IS INITIAL.
      cv_message =
        'Pending recording review lost its exact RAW evidence; import/record again before Mapping Profile.'.
      RETURN.
    ENDIF.

    lt_z689_pending = gt_z333_rec_evidence.
    CLEAR: lv_z689_ok, lv_z689_msg.
    PERFORM onboard_parsed_script
      USING    gv_z689_review_tcode gv_z689_review_origin
      CHANGING lt_z689_pending lv_z689_ok lv_z689_msg.

    IF lv_z689_ok <> abap_true.
      cv_message = lv_z689_msg.
      IF cv_message IS INITIAL.
        cv_message =
          'Recording review was not confirmed; RAW evidence remains loaded and nothing was published.'.
      ENDIF.
      RETURN.
    ENDIF.

    gt_script_def = lt_z689_pending.
    CLEAR: gv_z689_review_pending,
           gv_z689_review_tcode,
           gv_z689_review_origin.
  ENDIF.

  IF gv_z340_lock_done = abap_true.
    CLEAR gv_z240_map_locked.
    gv_z133_origin = 'LOCKED_CONTRACT'.
  ENDIF.

 "a fresh Import/Start must stay pinned to its preserved raw
 "evidence even when exact-contract resolution has already loaded a persisted
 "Profile/Version and changed the runtime context. This prevents repository
 "rows that are absent from the current TXT/recording from appearing on 0350.
  PERFORM get_projection_origin CHANGING lv_origin.
  IF gt_z333_rec_evidence IS NOT INITIAL
     AND ( lv_origin = 'GUIDED_RECORD'
        OR lv_origin = 'SHDB_TXT'
        OR lv_origin = 'SHDB_PROGRAM' ).
    gv_z240_map_locked = abap_true.
    PERFORM build_evid_map_view
      CHANGING cv_ok cv_message.
    RETURN.
  ENDIF.

  IF gv_z240_map_locked = abap_true.
 "A TXT_ONLY/GUIDED_ONLY acquisition cannot open an official
 "mapping context, but it may still open a read-only Candidate Mapping
 "Review from the rows currently visible in the Recording Manager.
    IF gt_script_def IS NOT INITIAL.
      PERFORM build_evid_map_view
        CHANGING cv_ok cv_message.
      RETURN.
    ENDIF.
    cv_message =
      'Latest acquisition did not pin an exact Mapping context. Select one contract with My Import or All Import first.'.
    RETURN.
  ENDIF.

  PERFORM resolve_exact_map_ctx
    CHANGING lv_resolve_ok lv_resolve_msg.
  IF lv_resolve_ok <> abap_true.
    cv_message = lv_resolve_msg.
    IF cv_message IS INITIAL.
      cv_message = 'Mapping context is not resolved. Import, record or select one exact contract first.'.
    ENDIF.
    RETURN.
  ENDIF.

  lv_tcode = p_rec_tcode.
  lv_profile = txtp_profile_name.
  lv_ver     = gv_profile_ver.

  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  IF sy-subrc <> 0.
    cv_message = |Profile registry is missing for { lv_profile } v{ lv_ver }.|.
    RETURN.
  ENDIF.

  SELECT COUNT(*)
    FROM zbdc_mapping_bup
    INTO @lv_map_count
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.

 "The Mapping toolbar command explicitly prepares a first draft when the
 "immutable tuple has none. It never invokes SAVE_MAPPING or ACTIVATE.
  IF lv_map_count = 0.
    IF lv_status <> gc_m2_prof_draft.
      cv_message =
        |Profile { lv_profile } v{ lv_ver } has status { lv_status } but no Mapping rows; automatic repair is blocked.|.
      RETURN.
    ENDIF.
    PERFORM create_mapping_draft.
  ENDIF.

  PERFORM load_mapping_screen.

 "My Import / All Import must restore the immutable saved field set before
 "any draft-rescue path is considered. Executable contracts are not drafts.
  IF gt_mapping_screen IS INITIAL
     AND gv_z133_origin = 'LOCKED_CONTRACT'.
    CLEAR: lv_resolve_ok, lv_resolve_msg.
    PERFORM restore_action_cert
      USING    gt_script_def gv_runtime_script_id gv_runtime_contract_hash
      CHANGING lv_resolve_ok lv_resolve_msg.
    IF lv_resolve_ok = abap_true.
      CLEAR: lv_resolve_ok, lv_resolve_msg.
      PERFORM build_cert_map_view
        USING    gt_script_def lv_tcode lv_profile lv_ver
        CHANGING lv_resolve_ok lv_resolve_msg.
    ENDIF.
  ENDIF.

  IF gt_mapping_screen IS INITIAL
     AND lv_status = gc_m2_prof_draft.
    CLEAR: lv_resolve_ok, lv_resolve_msg.
    PERFORM rescue_draft_from_script
      USING    lv_tcode lv_profile lv_ver
      CHANGING lv_resolve_ok lv_resolve_msg.
    IF lv_resolve_ok = abap_true.
      PERFORM load_mapping_screen.
    ENDIF.
  ENDIF.

  IF gt_mapping_screen IS INITIAL.
    cv_message = |Mapping rows are unavailable for { lv_profile } v{ lv_ver }.|.
    IF lv_resolve_msg IS NOT INITIAL.
      cv_message = lv_resolve_msg.
    ENDIF.
    RETURN.
  ENDIF.

  CLEAR lv_status.
  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  IF sy-subrc <> 0.
    cv_message = 'Profile status cannot be reloaded after Mapping preparation.'.
    RETURN.
  ENDIF.

  cv_ok = abap_true.

 "a partial Start Recording / Import must not be explained as a
 "generated Mapping. This branch is reached only after an exact contract was
 "selected deliberately; the message stays explicit.
  IF gv_z133_outcome = gc_m2_z133_blocked AND gv_z133_origin IS NOT INITIAL.
    cv_message = |Existing Mapping { lv_profile } v{ lv_ver } loaded from a selected contract; the latest partial capture did not generate Mapping.|.
    RETURN.
  ENDIF.

  CASE lv_status.
    WHEN gc_m2_prof_draft.
      cv_message = |DRAFT Mapping { lv_profile } v{ lv_ver } loaded for review. Generate Template will create a template; runtime setup remains gated.|.
    WHEN gc_m2_prof_mapped.
      cv_message = |MAPPED contract { lv_profile } v{ lv_ver } loaded. Generate Template can download the user template; runtime setup remains gated.|.
    WHEN 'TESTING'.
      cv_message = |TESTING Mapping contract { lv_profile } v{ lv_ver } loaded.|.
    WHEN gc_m2_prof_active.
      cv_message = |ACTIVE immutable Mapping contract { lv_profile } v{ lv_ver } loaded read-only.|.
    WHEN OTHERS.
      cv_message = |Mapping contract { lv_profile } v{ lv_ver } loaded with status { lv_status }.|.
  ENDCASE.
ENDFORM.

*& Generic first-draft rescue from current SHDB script

*& If a new TCODE/profile has versioned SHDB rows with Generated Column
*& values but no visible Mapping rows, build a minimal business-input draft
*& from the exact current script. The rule is generic: DYNAMIC + source
*& column + non-technical BDC field. No TCODE/SAP field/source label is
*& hardcoded.

FORM rescue_draft_from_script
  USING    iv_tcode   TYPE any
           iv_profile TYPE any
           iv_ver     TYPE any
  CHANGING cv_ok      TYPE abap_bool
           cv_message TYPE string.

  DATA: lv_tcode       TYPE zbdc_mapping_bup-tcode,
        lv_profile     TYPE zbdc_mapping_bup-profile_name,
        lv_ver         TYPE zbdc_mapping_bup-profile_ver,
        lv_status      TYPE zbdc_prof_bup-status,
        lt_script      TYPE ty_t_script,
        ls_script      TYPE ty_script_def_compat,
        lt_draft       TYPE STANDARD TABLE OF zbdc_mapping_bup,
        ls_map         TYPE zbdc_mapping_bup,
        lt_slots       TYPE ty_t_map_staging_slot,
        lv_slot        TYPE zbdc_mapping_bup-staging_field,
        lv_bdc         TYPE zbdc_mapping_bup-bdc_field,
        lv_logical     TYPE zbdc_mapping_bup-bdc_field,
        lv_source      TYPE zbdc_mapping_bup-source_column,
        lv_type        TYPE zbdc_sct_ver_bup-value_type,
        lv_technical   TYPE abap_bool,
        lv_role        TYPE string,
        lv_reason      TYPE string,
        lv_source_tech TYPE abap_bool,
        lv_script_id   TYPE zbdc_script_bup-script_id,
        lv_hash        TYPE zbdc_script_bup-contract_hash,
        lv_found       TYPE abap_bool,
        lv_count       TYPE i,
        lv_origin      TYPE c LENGTH 20.

  DATA: lt_seen_logical TYPE SORTED TABLE OF zbdc_mapping_bup-bdc_field
                         WITH UNIQUE KEY table_line,
        lt_seen_source  TYPE SORTED TABLE OF zbdc_mapping_bup-source_column
                         WITH UNIQUE KEY table_line,
        lt_used_slots   TYPE SORTED TABLE OF zbdc_mapping_bup-staging_field
                         WITH UNIQUE KEY table_line.

  CLEAR: cv_ok, cv_message.

  lv_tcode = iv_tcode.
  TRANSLATE lv_tcode TO UPPER CASE.
  CONDENSE lv_tcode NO-GAPS.
  lv_profile = iv_profile.
  CONDENSE lv_profile.
  lv_ver = iv_ver.

  IF lv_tcode IS INITIAL OR lv_profile IS INITIAL OR lv_ver IS INITIAL.
    cv_message = 'Mapping context is incomplete; cannot build first draft.'.
    RETURN.
  ENDIF.

  SELECT SINGLE status
    FROM zbdc_prof_bup
    INTO @lv_status
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  IF sy-subrc <> 0.
    cv_message = |Profile registry is missing for { lv_profile } v{ lv_ver }.|.
    RETURN.
  ENDIF.
  IF lv_status = gc_m2_prof_active OR lv_status = 'TESTING'.
    cv_message = |Profile { lv_profile } v{ lv_ver } has status { lv_status }; first-draft rescue is blocked for executable contracts.|.
    RETURN.
  ENDIF.

  PERFORM load_profile_script
    USING    lv_tcode lv_profile lv_ver
    CHANGING lt_script lv_script_id lv_hash lv_found.
  IF lv_found <> abap_true OR lt_script IS INITIAL.
    lt_script = gt_script_def.
  ENDIF.
  IF lt_script IS INITIAL.
    cv_message = 'No current SHDB script rows are available to build Mapping.' .
    RETURN.
  ENDIF.

  CLEAR lv_origin.
  PERFORM get_projection_origin CHANGING lv_origin.

  PERFORM get_mapping_staging_slots CHANGING lt_slots.
  IF lt_slots IS INITIAL.
    cv_message = 'No generic staging FIELDnn slots exist for Mapping.' .
    RETURN.
  ENDIF.

  CLEAR ls_map.
  ls_map-tcode         = lv_tcode.
  ls_map-profile_name  = lv_profile.
  ls_map-profile_ver   = lv_ver.
  ls_map-source_column = 'BUSINESS_KEY'.
  ls_map-staging_field = 'FIELD01'.
  ls_map-mandatory     = 'X'.
  APPEND ls_map TO lt_draft.
  INSERT ls_map-source_column INTO TABLE lt_seen_source.
  INSERT ls_map-staging_field INTO TABLE lt_used_slots.

  LOOP AT lt_script INTO ls_script
    WHERE is_new_screen IS INITIAL
      AND field_name IS NOT INITIAL.

    CLEAR: lv_technical, lv_source_tech, lv_bdc, lv_logical, lv_source,
           lv_type, lv_role, lv_reason.
    lv_type = ls_script-value_type.
    TRANSLATE lv_type TO UPPER CASE.
    CONDENSE lv_type NO-GAPS.
    IF lv_type = gc_m2_vt_ignore.
      CONTINUE.
    ENDIF.

    PERFORM mapping_field_is_technical
      USING    ls_script-field_name
      CHANGING lv_technical.
    IF lv_technical = abap_true.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_bdc_field
      USING    ls_script-field_name
      CHANGING lv_bdc.
    IF lv_bdc IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM projection_role
      USING    lt_script lv_bdc
      CHANGING lv_role lv_reason.
    IF lv_role <> 'DYNAMIC_PROVEN'.
      CONTINUE.
    ENDIF.

    PERFORM logical_bdc_key
      USING    lv_bdc
      CHANGING lv_logical.
    IF lv_logical IS INITIAL.
      lv_logical = lv_bdc.
    ENDIF.

    READ TABLE lt_seen_logical
      WITH TABLE KEY table_line = lv_logical
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.

    PERFORM normalize_mapping_source
      USING    ls_script-source_column
      CHANGING lv_source.
    IF lv_source IS INITIAL OR lv_source CP 'INPUT_*'.
      CLEAR lv_source.
      PERFORM source_from_bdc
        USING    lv_bdc
        CHANGING lv_source.
    ENDIF.
    IF lv_source IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM shape_auto_source
      USING    lt_script lv_source lv_bdc lv_origin
      CHANGING lv_source.
    IF lv_source IS INITIAL.
      CONTINUE.
    ENDIF.

    PERFORM mapping_source_is_technical
      USING    lv_source lv_bdc
      CHANGING lv_source_tech.
    IF lv_source_tech = abap_true.
      CONTINUE.
    ENDIF.

    READ TABLE lt_seen_source
      WITH TABLE KEY table_line = lv_source
      TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      PERFORM safe_disambig
        USING    lt_script lv_bdc lv_source
        CHANGING lv_source.
      READ TABLE lt_seen_source
        WITH TABLE KEY table_line = lv_source
        TRANSPORTING NO FIELDS.
      IF sy-subrc = 0 OR lv_source IS INITIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    CLEAR lv_slot.
    LOOP AT lt_slots INTO lv_slot.
      IF lv_slot = 'FIELD01'.
        CONTINUE.
      ENDIF.
      READ TABLE lt_used_slots
        WITH TABLE KEY table_line = lv_slot
        TRANSPORTING NO FIELDS.
      IF sy-subrc <> 0.
        EXIT.
      ENDIF.
      CLEAR lv_slot.
    ENDLOOP.
    IF lv_slot IS INITIAL.
      EXIT.
    ENDIF.

    CLEAR ls_map.
    ls_map-tcode         = lv_tcode.
    ls_map-profile_name  = lv_profile.
    ls_map-profile_ver   = lv_ver.
    ls_map-source_column = lv_source.
    ls_map-staging_field = lv_slot.
    ls_map-bdc_field     = lv_bdc.
    CLEAR ls_map-mandatory.
    PERFORM NORM_MAP_REQUIRED CHANGING ls_map.
    PERFORM apply_fmt_contract CHANGING ls_map.
    APPEND ls_map TO lt_draft.

    INSERT lv_logical INTO TABLE lt_seen_logical.
    INSERT lv_source  INTO TABLE lt_seen_source.
    INSERT lv_slot    INTO TABLE lt_used_slots.
  ENDLOOP.

  DESCRIBE TABLE lt_draft LINES lv_count.
  IF lv_count <= 1.
    cv_message = 'Current SHDB script has no DYNAMIC_PROVEN business fields for Mapping.' .
    RETURN.
  ENDIF.

  DELETE FROM zbdc_mapping_bup
    WHERE tcode        = @lv_tcode
      AND profile_name = @lv_profile
      AND profile_ver  = @lv_ver.
  MODIFY zbdc_mapping_bup FROM TABLE lt_draft.
  IF sy-subrc <> 0.
    ROLLBACK WORK.
    cv_message = 'First-draft Mapping rescue could not persist rows.' .
    RETURN.
  ENDIF.

  COMMIT WORK AND WAIT.
  cv_ok = abap_true.
  cv_message = |Mapping draft rebuilt from current DYNAMIC_PROVEN contract for { lv_profile } v{ lv_ver }.|.
ENDFORM.

*& Gmail Dynamic Data Entry Request
*& Merged into existing M2 mapping include; total include count remains 14.

*& Runtime:
*& SAP selected TCODE/Profile/Version + dynamic mapping schema
*& -> n8n Gmail request workflow
*& -> recipient receives secure form link.

*& This branch intentionally does NOT use:
*& XLSX/CSV download, Google Drive, Apps Script, OAuth 6-digit code,
*& accessToken, fileId, editUrl, attachment or Base64.

FORM get_n8n_gmail_webhook
  CHANGING cv_url TYPE string.

  CLEAR cv_url.

  PERFORM get_required_config
    USING    'N8N_GMAIL_REQUEST_URL'
    CHANGING cv_url.

  CONDENSE cv_url NO-GAPS.

  IF cv_url IS NOT INITIAL AND cv_url NP 'https://*'.
    CLEAR cv_url.
    MESSAGE s320(zbdc)
      DISPLAY LIKE 'E'.
  ENDIF.
ENDFORM.
FORM get_gmail_header
  CHANGING cv_name  TYPE string
           cv_value TYPE string
           cv_ok    TYPE abap_bool.

  DATA lv_allowed TYPE string.

  CLEAR: cv_name, cv_value, cv_ok.

  PERFORM get_required_config
    USING    'N8N_GMAIL_HEADER_NAME'
    CHANGING cv_name.
  IF cv_name IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM get_required_config
    USING    'N8N_GMAIL_HEADER_VALUE'
    CHANGING cv_value.
  IF cv_value IS INITIAL.
    RETURN.
  ENDIF.

  CONDENSE cv_name NO-GAPS.
  CONDENSE cv_value NO-GAPS.

 "RFC-compatible HTTP field-name token characters; no POSIX regex.
  lv_allowed =
    'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&''*+-.^_`|~'.

  IF cv_name IS INITIAL OR cv_name CN lv_allowed.
    MESSAGE s321(zbdc)
      DISPLAY LIKE 'E'.
    CLEAR: cv_name, cv_value.
    RETURN.
  ENDIF.

  IF cv_value CS cl_abap_char_utilities=>newline
  OR cv_value CS cl_abap_char_utilities=>cr_lf
  OR cv_value CS cl_abap_char_utilities=>horizontal_tab.
    MESSAGE s322(zbdc)
      DISPLAY LIKE 'E'.
    CLEAR: cv_name, cv_value.
    RETURN.
  ENDIF.

  cv_ok = abap_true.
ENDFORM.

FORM get_gmail_action
  CHANGING cv_action TYPE string.

  CLEAR cv_action.

  PERFORM get_required_config
    USING    'N8N_GMAIL_REQUEST_ACTION'
    CHANGING cv_action.

  CONDENSE cv_action NO-GAPS.
ENDFORM.

FORM get_gmail_timeout
  CHANGING cv_timeout TYPE i
           cv_ok      TYPE abap_bool.

  DATA: lv_timeout_text TYPE string,
        lv_timeout      TYPE i.

  CLEAR: cv_timeout, cv_ok.

  PERFORM get_required_config
    USING    'N8N_GMAIL_TIMEOUT_SEC'
    CHANGING lv_timeout_text.
  IF lv_timeout_text IS INITIAL.
    RETURN.
  ENDIF.

  CONDENSE lv_timeout_text NO-GAPS.

  TRY.
      lv_timeout = CONV i( lv_timeout_text ).
    CATCH cx_sy_conversion_no_number.
      MESSAGE s323(zbdc)
        DISPLAY LIKE 'E'.
      RETURN.
  ENDTRY.

  IF lv_timeout < 1 OR lv_timeout > 600.
    MESSAGE s324(zbdc)
      DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  cv_timeout = lv_timeout.
  cv_ok      = abap_true.
ENDFORM.

FORM get_form_ttl_hours
  CHANGING cv_hours TYPE i
           cv_ok    TYPE abap_bool.

  DATA: lv_text  TYPE string,
        lv_hours TYPE i.

  CLEAR: cv_hours, cv_ok.

  PERFORM get_required_config
